{
  "name": "brightai-monorepo",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "dependencies": {
    "@sentry/react": "^10.38.0",
    "dotenv": "^16.5.0",
    "esbuild": "^0.21.5",
    "glob": "^13.0.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "aos": "^2.3.4",
    "cheerio": "^1.2.0",
    "fast-check": "^3.15.0",
    "gsap": "^3.14.2",
    "jsdom": "^23.0.0",
    "swiper": "^12.1.0",
    "vitest": "^1.0.0"
  },
  "scripts": {
    "build": "npm run assets:minify && npm run assets:replace-refs && npm run production:fixes && npm run sitemap:all && npm run performance:budget",
    "assets:minify": "node scripts/minify-seo-assets.mjs",
    "assets:replace-refs": "node scripts/replace-unminified-refs.mjs",
    "production:fixes": "node scripts/apply-production-audit-fixes.mjs",
    "build:minify-all": "node scripts/minify-seo-assets.mjs && node scripts/replace-unminified-refs.mjs",
    "dev:frontend": "npm run start --workspace frontend",
    "dev:backend": "npm run start --workspace backend",

    "test:setup:backend": "npm --prefix backend ci --include=dev --no-audit --no-fund",

    "test:all": "node scripts/run-monorepo-tests.mjs",
    "test:frontend": "npm run test --workspace frontend",
    "test:backend": "npm run test --workspace backend",

    "performance:budget": "node scripts/check-performance-budget.js",
    "validate:production": "node scripts/validate-production.js",
    "sitemap:all": "node scripts/generate-sitemap-all-pages.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "seo:ping": "node scripts/ping-search-engines.mjs",
    "seo:check": "node scripts/seo-health-check.mjs",
    "seo:qa": "node scripts/seo-indexability-qa.mjs",
    "seo:gate": "node scripts/seo-ci-check.mjs",
    "seo:html:check": "node scripts/html-seo-governor.mjs",
    "seo:html:fix": "node scripts/html-seo-governor.mjs --fix",
    "seo:headings": "node scripts/seo-intent-headings-qa.mjs",
    "clarity:check": "node scripts/verify-clarity.mjs",
    "blog:related:auto": "node scripts/generate-related-articles.mjs",
    "internal-links:audit": "node scripts/internal-links-audit.mjs && node scripts/internal-linking-architecture.mjs",
    "internal-links:inventory": "node scripts/internal-linking-architecture.mjs",
    "internal-links:architecture:fix": "node scripts/internal-linking-architecture.mjs --fix",
    "analytics:qa": "node scripts/analytics-qa.mjs",
    "internal-links:fix": "node scripts/fix-internal-links.mjs",
    "smoke-test:config": "node scripts/check-api-base-consistency.mjs",
    "ui:audit": "node scripts/ui-audit.mjs",
    "resource:audit:before": "node scripts/resource-paths-audit.mjs before",
    "resource:audit:after": "node scripts/resource-paths-audit.mjs after",
    "resource:fix": "node scripts/fix-resource-paths.mjs",
    "smoke-test": "node scripts/smoke-test.js",
    "smoke-test:api": "node scripts/smoke-test-api.mjs",
    "smoke-test:api:prod": "node scripts/smoke-test-api.mjs https://brightai.site",
    "test": "node scripts/run-monorepo-tests.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "server": "npm run dev:backend",
    "server:dev": "npm run dev:backend"
  }
}
