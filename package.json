{
  "name": "brightai-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run image-sitemap && astro build && npm run sync:dist:flat && npm run schema:solutions:sync && npm run schema:docs:sync",
    "sync:dist:flat": "node scripts/sync-dist-flat.mjs",
    "build:verify": "npm run verify:all",
    "lint": "echo 'Linting skipped for static site'",
    "lint:fix": "echo 'Linting skipped for static site'",
    "typecheck": "echo 'TypeScript check skipped'",
    "seo:all": "npm run seo:check && npm run seo:schema && npm run seo:gate",
    "seo:check": "node scripts/seo-health-check.mjs && npm run seo:legacy && npm run seo:content",
    "seo:schema": "npm run schema:solutions:check && npm run schema:docs:check && node scripts/seo-schema-audit.mjs && node scripts/check-speakable-schema.mjs",
    "seo:gate": "node scripts/seo-ci-check.mjs",
    "seo:legacy": "node --test scripts/legacy-seo-surface.test.mjs",
    "seo:content": "node --test scripts/content-acceptance.test.mjs",
    "seo:legacy-paths": "node scripts/legacy-paths-audit.mjs --strict",
    "seo:link-graph": "node scripts/link-graph-validator.mjs --strict",
    "seo:word-count": "node scripts/check-word-count.mjs",
    "redirects:check": "node scripts/check-redirect-destinations.mjs && node scripts/check-render-route-hygiene.mjs",
    "sitemap:generate": "node scripts/generate-sitemap-all-pages.mjs",
    "sitemap:all": "npm run sitemap:generate",
    "postbuild:indexnow": "node scripts/trigger-indexnow.mjs --soft-fail",
    "image-sitemap": "node scripts/generate-image-sitemap.mjs",
    "indexnow:trigger": "node scripts/trigger-indexnow.mjs",
    "indexnow:check": "node scripts/trigger-indexnow.mjs --dry-run",
    "indexnow:deploy": "node scripts/trigger-indexnow.mjs --soft-fail",
    "schema:solutions:sync": "node scripts/sync-solution-faq-schema.mjs",
    "schema:solutions:check": "node scripts/sync-solution-faq-schema.mjs --check",
    "schema:docs:sync": "node scripts/sync-docs-howto-schema.mjs",
    "schema:docs:check": "node scripts/sync-docs-howto-schema.mjs --check",
    "verify:all": "node scripts/verify-all.mjs && npm run sitemap:generate && npm run seo:schema && npm run seo:gate",
    "preview": "astro preview",
    "clean": "rm -rf .next .render-static reports/ dist/ .vercel/",
    "performance:budget": "node scripts/check-performance-budget.js",
    "links:dist": "linkinator ./dist --recurse --skip 'https?://(?!brightai.site)'",
    "internal-links:audit": "node scripts/internal-links-audit.mjs && node scripts/internal-linking-architecture.mjs",
    "internal-links:inventory": "node scripts/internal-linking-architecture.mjs",
    "internal-links:architecture:fix": "node scripts/internal-linking-architecture.mjs --fix",
    "internal-links:fix": "node scripts/fix-internal-links.mjs",
    "resource:audit:before": "node scripts/resource-paths-audit.mjs before",
    "resource:audit:after": "node scripts/resource-paths-audit.mjs after",
    "resource:fix": "node scripts/fix-resource-paths.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.21.5",
    "glob": "^13.0.6",
    "postcss": "^8.5.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@astrojs/vercel": "^10.0.8",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "astro": "^6.4.6",
    "eslint": "^9.17.0",
    "jsdom": "^23.0.0",
    "linkinator": "^7.6.1",
    "playwright": "^1.61.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^1.0.0"
  }
}
