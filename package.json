{
  "name": "brightai-monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.5",
    "npm": "10.9.7"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./scripts/server.mjs",
    "start:local": "node --env-file=.env ./scripts/server.mjs",
    "start:trial": "node --env-file=.env ./scripts/local-trial.mjs",
    "test:auth:e2e": "node tests/auth-browser.e2e.mjs",
    "test:accessibility:smoke": "node tests/accessibility-performance-smoke.mjs",
    "test:seo": "npm run build && node --test tests/sitemap-regression.test.mjs tests/seo-build.test.mjs tests/seo-redirects.test.mjs tests/editorial-schema.test.mjs",
    "test:healthz": "node --test tests/healthz.test.mjs tests/healthz-integration.test.mjs",
    "smoke:healthz": "node ./scripts/smoke-healthz.mjs",
    "test:security:smoke": "node tests/security-headers-smoke.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.14",
    "@astrojs/sitemap": "^3.7.4",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@neon/neon-js": "^0.10.2",
    "astro": "7.4.13",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "react-useanimations": "^3.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "playwright": "^1.65.1"
  }
}
