{
  "name": "brightai-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "echo 'Static site - open index.html in browser'",
    "dev:frontend": "npm run dev:frontend --workspace brightai-frontend",
    "dev:backend": "npm run dev --workspace brightai-frontend",
    "build": "npm run build:assets",
    "build:frontend": "echo 'Static HTML site - no build needed'",
    "build:assets": "node scripts/build-tailwind-purged.mjs && node scripts/minify-seo-assets.mjs && node scripts/replace-unminified-refs.mjs && node scripts/apply-production-audit-fixes.mjs",
    "build:sitemap": "node scripts/generate-sitemap-all-pages.mjs",
    "build:verify": "npm run verify:all",
    "lint": "echo 'Linting skipped for static site'",
    "lint:fix": "echo 'Linting skipped for static site'",
    "typecheck": "echo 'TypeScript check skipped'",
    "seo:all": "npm run seo:check && npm run seo:gate",
    "seo:check": "node scripts/seo-health-check.mjs",
    "seo:gate": "node scripts/seo-ci-check.mjs",
    "seo:production-guard": "npm run seo:check && npm run seo:gate",
    "sitemap:generate": "node scripts/generate-sitemap-all-pages.mjs",
    "sitemap:all": "npm run sitemap:generate",
    "verify:all": "node scripts/verify-all.mjs && node scripts/check-render-readiness.mjs && npm run sitemap:generate && npm run seo:gate",
    "clean": "rm -rf .next .render-static reports/",
    "tailwind:build": "node scripts/build-tailwind-purged.mjs",
    "assets:minify": "node scripts/minify-seo-assets.mjs",
    "assets:replace-refs": "node scripts/replace-unminified-refs.mjs",
    "production:fixes": "node scripts/apply-production-audit-fixes.mjs",
    "build:minify-all": "node scripts/minify-seo-assets.mjs && node scripts/replace-unminified-refs.mjs",
    "test:setup:backend": "npm --prefix frontend ci --include=dev --no-audit --no-fund",
    "performance:budget": "node scripts/check-performance-budget.js",
    "internal-links:audit": "node scripts/internal-links-audit.mjs && node scripts/internal-linking-architecture.mjs",
    "internal-links:inventory": "node scripts/internal-linking-architecture.mjs",
    "internal-links:architecture:fix": "node scripts/internal-linking-architecture.mjs --fix",
    "internal-links:fix": "node scripts/fix-internal-links.mjs",
    "resource:audit:before": "node scripts/resource-paths-audit.mjs before",
    "resource:audit:after": "node scripts/resource-paths-audit.mjs after",
    "resource:fix": "node scripts/fix-resource-paths.mjs",
    "server": "npm run dev:backend",
    "server:dev": "npm run dev:backend"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/react": "^10.38.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.6",
    "autoprefixer": "^10.5.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "esbuild": "^0.21.5",
    "framer-motion": "^12.23.24",
    "glob": "^13.0.6",
    "lucide-react": "^0.468.0",
    "postcss": "^8.5.15",
    "purgecss": "^8.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.5.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.1",
    "ws": "^8.18.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "aos": "^2.3.4",
    "cssnano": "^8.0.1",
    "docx": "^9.6.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^3.15.0",
    "gsap": "^3.14.2",
    "jsdom": "^23.0.0",
    "prettier": "^3.4.2",
    "swiper": "^12.1.0",
    "typescript": "^5.7.2",
    "vitest": "^1.0.0"
  }
}
