{
  "name": "brightai-monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "db:setup": "pnpm --filter @brightai/db db:setup",
    "db:generate": "pnpm --filter @brightai/db db:generate",
    "db:migrate": "pnpm --filter @brightai/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @brightai/db db:migrate:deploy",
    "db:seed": "pnpm --filter @brightai/db db:seed",
    "db:studio": "pnpm --filter @brightai/db db:studio",
    "db:reset": "pnpm --filter @brightai/db db:reset",
    "db:rls:test": "pnpm --filter @brightai/db db:rls:test",
    "//_reproducible_prisma": "CRITICAL — clean-checkout guard. Runs `prisma generate` from packages/db/prisma/schema.prisma before any typecheck/test/verify that depends on @prisma/client types. Without this step, downstream type errors would look like missing exports (models, LeadQueueStatus) or implicit-any fallbacks in packages/db/src/client.ts. Idempotent: regenerating from an unchanged schema is a no-op on the file system.",
    "pretypecheck": "pnpm db:generate",
    "typecheck": "pnpm -r --parallel typecheck",
    "pretest:chat-session": "pnpm db:generate",
    "preverify:all": "pnpm db:generate",
    "lint": "pnpm -r --parallel lint",
    "dashboard:dev": "pnpm --filter @brightai/dashboard dev",
    "dashboard:build": "pnpm --filter @brightai/dashboard build",
    "//_note": "Legacy Astro scripts below — DO NOT REMOVE until apps/marketing/ refactor lands.",
    "dev": "astro dev",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "avif:generate": "node scripts/generate-avif-variants.mjs",
    "prebuild": "npm run fonts:subset && node scripts/generate-all-redirects.mjs",
    "build": "npm run image-sitemap && astro build && npm run avif:generate && npm run sitemap:generate && npm run sync:dist:flat && npm run schema:solutions:sync && npm run schema:docs:sync && npm run purge:css",
    "sync:dist:flat": "node scripts/sync-dist-flat.mjs",
    "build:verify": "npm run verify:all",
    "lint:legacy": "echo 'Linting skipped for static site'",
    "lint:fix": "echo 'Linting skipped for static site'",
    "seo:all": "npm run seo:check && npm run seo:schema && npm run seo:gate",
    "seo:check": "node scripts/seo-health-check.mjs && npm run seo:legacy && npm run seo:content",
    "seo:schema": "npm run schema:solutions:check && npm run schema:docs:check && node scripts/seo-schema-audit.mjs && node scripts/check-speakable-schema.mjs",
    "seo:gate": "node scripts/seo-ci-check.mjs",
    "seo:hreflang": "node scripts/hreflang-bidirectional-audit.mjs",
    "seo:legacy": "node --test scripts/legacy-seo-surface.test.mjs",
    "seo:content": "node --test scripts/content-acceptance.test.mjs",
    "seo:legacy-paths": "node scripts/legacy-paths-audit.mjs --strict",
    "seo:link-graph": "node scripts/link-graph-validator.mjs --strict",
    "seo:word-count": "node scripts/check-word-count.mjs",
    "redirects:check": "node scripts/check-redirect-destinations.mjs && node scripts/check-render-route-hygiene.mjs",
    "sitemap:generate": "node scripts/generate-sitemap-all-pages.mjs",
    "sitemap:all": "npm run sitemap:generate",
    "postbuild:indexnow": "node scripts/trigger-indexnow.mjs --soft-fail",
    "image-sitemap": "node scripts/generate-image-sitemap.mjs",
    "indexnow:trigger": "node scripts/trigger-indexnow.mjs",
    "indexnow:check": "node scripts/trigger-indexnow.mjs --dry-run",
    "indexnow:deploy": "node scripts/trigger-indexnow.mjs --soft-fail",
    "schema:solutions:sync": "node scripts/sync-solution-faq-schema.mjs",
    "schema:solutions:check": "node scripts/sync-solution-faq-schema.mjs --check",
    "schema:docs:sync": "node scripts/sync-docs-howto-schema.mjs",
    "schema:docs:check": "node scripts/sync-docs-howto-schema.mjs --check",
    "verify:all": "node scripts/verify-all.mjs && npm run test:chat-session && npm run sitemap:generate && npm run seo:schema && npm run seo:gate",
    "preview": "astro preview",
    "clean": "rm -rf .next .render-static reports/ dist/ .vercel/",
    "performance:budget": "node scripts/check-performance-budget.js",
    "purge:css": "node scripts/purge-css.mjs",
    "verify:no-legacy-sw": "node scripts/verify-no-legacy-sw.mjs",
    "verify:no-legacy-mock": "node scripts/verify-no-legacy-mock.mjs",
    "verify:set-html": "node scripts/verify-set-html-sanitized.mjs",
    "test:chat-session": "node --import ./scripts/test-ts-loader.mjs --experimental-strip-types --test scripts/test-chat-session.mjs",
    "test:csrf": "node --import ./scripts/test-ts-loader.mjs --experimental-strip-types --test scripts/test-csrf.mjs",
    "links:dist": "linkinator ./dist --recurse --directory-listing --skip 'twitter.com' --skip 'github.com' --skip 'x.com' --skip 'linkedin.com' --skip 'youtube.com' --skip 'tiktok.com' --skip 'facebook.com' --skip 'instagram.com' --skip 'crunchbase.com' --skip 'wa.me' --skip 'googleapis.com' --skip 'gstatic.com' --skip 'schema.org' --skip 'wikidata.org' --skip 'sdaia.gov.sa' --skip 'nca.gov.sa' --skip 'sama.gov.sa' --skip 'sfda.gov.sa'",
    "internal-links:audit": "node scripts/internal-links-audit.mjs && node scripts/internal-linking-architecture.mjs",
    "internal-links:inventory": "node scripts/internal-linking-architecture.mjs",
    "internal-links:architecture:fix": "node scripts/internal-linking-architecture.mjs --fix",
    "internal-links:fix": "node scripts/fix-internal-links.mjs",
    "resource:audit:before": "node scripts/resource-paths-audit.mjs before",
    "resource:audit:after": "node scripts/resource-paths-audit.mjs after",
    "resource:fix": "node scripts/fix-resource-paths.mjs",
    "a11y:scan": "node scripts/axe-scan.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@brightai/config": "workspace:*",
    "@brightai/db": "workspace:*",
    "@brightai/lead-queue": "workspace:*",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.21.5",
    "glob": "^13.0.6",
    "ioredis": "^5.4.1",
    "isomorphic-dompurify": "^2.16.0",
    "postcss": "^8.5.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@astrojs/node": "^11.0.2",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "astro": "^6.4.6",
    "axe-core": "^4.12.1",
    "eslint": "^9.17.0",
    "jsdom": "^23.0.0",
    "linkinator": "^7.6.1",
    "playwright": "^1.61.1",
    "prettier": "^3.4.2",
    "purgecss": "^8.0.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.2",
    "vitest": "^1.0.0"
  },
  "pnpm": {
    "overrides": {
      "js-cookie": ">=3.0.7"
    }
  }
}
