{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/client",
      "url": [
        "/",
        "/about/",
        "/services/",
        "/solutions/",
        "/contact/",
        "/pricing/",
        "/trust/",
        "/blog/",
        "/docs/",
        "/kernel/",
        "/kernel/approvals/",
        "/kernel/audit/",
        "/kernel/chat/",
        "/kernel/compliance/",
        "/kernel/connectors/",
        "/kernel/evidence/",
        "/kernel/policies/",
        "/kernel/reports/",
        "/kernel/scenarios/",
        "/kernel/stats/",
        "/kernel/offline/"
      ],
      "settings": {
        "preset": "desktop",
        "formFactor": "desktop",
        "throttlingMethod": "simulate",
        "skipAudits": [
          "canonical",
          "is-crawlable",
          "robots-txt",
          "screenshot-thumbnails",
          "full-page-screenshot",
          "render-blocking-resources"
        ],
        "budgets": [
          {
            "path": "/*",
            "resourceSizes": [
              {
                "resourceType": "script",
                "budget": 300
              },
              {
                "resourceType": "total",
                "budget": 1500
              }
            ],
            "timings": [
              {
                "metric": "largest-contentful-paint",
                "budget": 2500
              },
              {
                "metric": "interaction-to-next-paint",
                "budget": 200
              },
              {
                "metric": "cumulative-layout-shift",
                "budget": 0.1
              }
            ]
          }
        ]
      },
      "psiCollect": {
        "url": [
          "https://brightai.site/",
          "https://brightai.site/kernel/"
        ],
        "strategy": "mobile",
        "threshold": {
          "performance": 0.8,
          "accessibility": 0.9,
          "seo": 0.9
        }
      },
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "interaction-to-next-paint": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 300
          }
        ],
        "speed-index": [
          "warn",
          {
            "maxNumericValue": 3500
          }
        ],
        "font-display": "warn",
        "offscreen-images": "warn",
        "uses-responsive-images": "warn",
        "non-composited-animations": "warn"
      },
      "matchingUrlTemplate": [
        {
          "matchingUrlPattern": "^.*/kernel/.*$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "interaction-to-next-paint": [
              "warn",
              {
                "maxNumericValue": 200
              }
            ],
            "cumulative-layout-shift": [
              "warn",
              {
                "maxNumericValue": 0.1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^/(about|services|solutions|contact|pricing|trust)/$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "interaction-to-next-paint": [
              "warn",
              {
                "maxNumericValue": 200
              }
            ],
            "cumulative-layout-shift": [
              "warn",
              {
                "maxNumericValue": 0.1
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./reports/lighthouse",
      "reportFilenamePattern": "lh-report-%%URLNAME%%-%%DATETIME%%.%%EXTENSION%%"
    }
  }
}