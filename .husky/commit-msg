#!/usr/bin/env sh
# .husky/commit-msg — BAI-PROC-12 (2026-07-25)
#
# Enforces the [BAI-XXX-NN] commit-message format introduced by
# BAI-PROC-12. The format ties every commit back to a tracked ticket
# ID so future agents (and the reports-gate CI) can trace code changes
# to their source task.
#
# Format (subject line):
#   [<PREFIX>-<CATEGORY>-<NUMBER>] <description>
#
# Recognized prefixes (any one of):
#   BAI  — BrightAI ticket (b/prompt.md) — REQUIRED for all new work
#   FIX  — Hotfix (e.g. FIX-SEC-01, FIX-IDX-02)
#   DEC  — Decision-only (e.g. DEC-2026-07-25-001)
#
# Recognized categories (any one of):
#   PROC, SEC, IDX, PERF, SEO, A11Y, CONTENT, DEP, BUILD
#   Plus the legacy category "IDX" (used in BAI-IDX-* tickets).
#
# Numbering: 2-digit zero-padded (BAI-PROC-12, BAI-SEC-10, etc.)
#
# Recognized formats (all equivalent, picked the first match):
#   [BAI-PROC-12] description
#   [BAI-PROC-12] description\n\nbody...
#   [BAI-SEC-10] description
#   [DEC-2026-07-25-001] description
#
# Bypass:
#   - Commits whose subject starts with "Merge" (auto-generated merges)
#   - Commits whose subject starts with "Revert" (auto-generated reverts)
#   - Commits whose subject starts with "WIP:" (work-in-progress, blocked)
#   - Any commit whose subject starts with "[skip-ci]" or "[ci-skip]"
#
# Exit code:
#   0  — accepted
#   1  — rejected (commit aborted, message printed to stderr)
#
# Wired into:
#   - pnpm install (via the "prepare" script)
#   - .github/workflows/ci-build-guard.yml (also runs in CI as a backup)
#
# Related: BAI-PROC-12, DEC-PROC-12-2026-07-25-002, brain.md Section 0.6.

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
SUBJECT=$(printf '%s' "$COMMIT_MSG" | head -n 1 | tr -d '\r')

# --- bypass: merges, reverts, WIP, skip-ci ---
case "$SUBJECT" in
  Merge*|Revert*|WIP:*|"[skip-ci]"*|"[ci-skip]"*)
    exit 0 ;;
esac

# --- required format: [PREFIX-CATEGORY-NUMBER] description ---
PATTERN='^\[(BAI|FIX|DEC)-(PROC|SEC|IDX|PERF|SEO|A11Y|CONTENT|DEP|BUILD)-[0-9]+(-[0-9]+)?\] .+$'

if printf '%s' "$SUBJECT" | grep -qE "$PATTERN"; then
  exit 0
fi

# --- reject with clear message ---
cat >&2 <<EOF
❌ Commit message rejected by BAI-PROC-12 commit-msg hook.

Required format:
  [<PREFIX>-<CATEGORY>-<NUMBER>] <description>

Examples:
  [BAI-PROC-12] enforce verified_production field on every report
  [BAI-SEC-10] close /frontend/ leak via deny-list injection
  [FIX-IDX-02] revert stale canonical on /en/
  [DEC-2026-07-25-001] document trailingSlash policy

Your subject:
  $SUBJECT

Bypasses (no check):
  Merge ...   Revert ...   WIP: ...   [skip-ci] ...

Related: DEC-PROC-12-2026-07-25-002.
EOF
exit 1
