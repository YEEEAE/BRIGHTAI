{
  "name": "@brightai/qc-task-manager",
  "version": "0.1.0",
  "private": true,
  "description": "QC Department internal task-tracking application.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "db:init": "node --experimental-strip-types scripts/init-db.mjs",
    "db:reset": "node --experimental-strip-types scripts/init-db.mjs --reset",
    "db:seed": "node scripts/init-db.mjs",
    "db:backup": "node --experimental-strip-types scripts/backup-db.mjs",
    "db:restore": "node --experimental-strip-types scripts/restore-db.mjs",
    "test:migrations": "node --import ../../scripts/test-ts-loader.mjs --experimental-strip-types scripts/test-migrations.mjs",
    "test:architecture": "node scripts/architecture-guard.mjs",
    "test:domain": "node --import ../../scripts/test-ts-loader.mjs --experimental-strip-types scripts/test.mjs",
    "test:sla": "node --import ../../scripts/test-ts-loader.mjs --experimental-strip-types scripts/test-sla.mjs",
    "test:workflow": "node --import ../../scripts/test-ts-loader.mjs --experimental-strip-types scripts/test-workflow.mjs",
    "test:qc-operations": "node --import ../../scripts/test-ts-loader.mjs --experimental-strip-types scripts/test-qc-operations.mjs",
    "test:templates": "node --import ../../scripts/test-ts-loader.mjs --experimental-strip-types scripts/test-templates.mjs",
    "test:db-rules": "node --import ../../scripts/test-ts-loader.mjs --experimental-strip-types scripts/test-db-rules.mjs",
    "test": "pnpm test:migrations && pnpm test:architecture && pnpm test:qc-operations && pnpm test:templates && pnpm test:domain && pnpm test:sla && pnpm test:workflow && pnpm test:db-rules",
    "e2e:acceptance": "NODE_ENV=production pnpm build && node scripts/e2e-acceptance.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/tailwind": "^6.0.0",
    "astro": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.7.0",
    "exceljs": "^4.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
