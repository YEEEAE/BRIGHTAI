{
  "name": "@brightai/qc-task-manager",
  "version": "0.1.0",
  "private": true,
  "description": "QC Department internal task-tracking application.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "db:init": "node scripts/init-db.mjs",
    "db:reset": "node scripts/init-db.mjs --reset",
    "db:seed": "node scripts/init-db.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "test": "node --import ../../scripts/test-ts-loader.mjs --experimental-strip-types scripts/test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/tailwind": "^6.0.0",
    "astro": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.7.0",
    "exceljs": "^4.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
