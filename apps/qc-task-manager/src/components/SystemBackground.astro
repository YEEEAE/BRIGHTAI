---
// Decorative, app-wide video atmosphere. The source is intentionally local so
// it remains compatible with the application's strict same-origin CSP.
---

<div class="qc-system-background" aria-hidden="true">
  <video
    class="qc-system-background__video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="/media/qc-system-background-poster.jpg"
    tabindex="-1"
    disablepictureinpicture
  >
    <source src="/media/qc-system-background.mp4" type="video/mp4" />
  </video>
</div>

<style is:global>
  .qc-system-background {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background: #0b0b0b url('/media/qc-system-background-poster.jpg') center / 1600px 1200px no-repeat;
  }

  .qc-system-background__video {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: 1600px;
    height: 1200px;
    max-width: none;
    object-fit: contain;
    object-position: center;
    opacity: 1;
    filter: none;
    transform: translate(-50%, -50%);
  }

  .qc-app-layer {
    position: relative;
    z-index: 1;
    min-height: 100vh;
  }

  @media (prefers-reduced-motion: reduce) {
    .qc-system-background__video {
      display: none;
    }
  }

  @media print {
    .qc-system-background {
      display: none !important;
    }

    .qc-app-layer {
      min-height: 0;
    }
  }
</style>
