---
// Decorative, app-wide DotLottie atmosphere. The renderer and WASM stay local
// so the application's strict same-origin CSP remains unchanged.
---

<div class="qc-system-background" aria-hidden="true">
  <canvas class="qc-system-background__canvas" tabindex="-1"></canvas>
</div>

<style is:global>
  .qc-system-background {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background: #0b0b0b;
  }

  .qc-system-background__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
  }

  .qc-app-layer {
    position: relative;
    z-index: 1;
    min-height: 100vh;
  }

  @media (prefers-reduced-motion: reduce) {
    .qc-system-background__canvas {
      display: none;
    }
  }

  @media print {
    .qc-system-background {
      display: none !important;
    }

    .qc-app-layer {
      min-height: 0;
    }
  }
</style>

<script>
  import { DotLottie } from '@lottiefiles/dotlottie-web';

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const canvas = document.querySelector('.qc-system-background__canvas');
    if (canvas instanceof HTMLCanvasElement) {
      DotLottie.setWasmUrl('/media/dotlottie-player.wasm');
      new DotLottie({
        canvas,
        src: '/media/bubble-sticky.lottie',
        autoplay: true,
        loop: true,
        layout: { fit: 'contain', align: [0.5, 0.5] },
        renderConfig: {
          autoResize: true,
          devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
          freezeOnOffscreen: false,
        },
      });
    }
  }
</script>
