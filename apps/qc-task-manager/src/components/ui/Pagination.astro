---
// Pagination — the single pagination implementation (docs/UI-DESIGN-SYSTEM.md
// §3.4). Numbered window (up to 7 pages) + Prev/Next; Prev/Next render as
// inert spans at the bounds so the link set stays honest. E2E relies on:
// nav[aria-label] anchors, hrefs containing page=N, and the literal
// Prev/Next text being present (suite e2e-lab-documents scenario G).
interface Props {
  page: number;
  totalPages: number;
  /** Builds the href for a page number (caller owns the query string). */
  hrefFor: (page: number) => string;
  /** Accessible name for the nav landmark (e.g. "Test register pagination"). */
  label?: string;
  /** Optional layout classes (e.g. card-footer padding on lab search). */
  class?: string;
}

const { page, totalPages, hrefFor, label = 'Pagination', class: className = '' } = Astro.props;

// Window logic identical to the historical per-page implementations so
// existing URLs/expectations are preserved (up to 7 pages around current).
const pageNumbers: number[] = [];
if (totalPages > 1) {
  let start = Math.max(1, page - 3);
  let end = Math.min(totalPages, page + 3);
  if (end - start < 6) {
    if (start === 1) end = Math.min(totalPages, start + 6);
    else start = Math.max(1, end - 6);
  }
  for (let p = start; p <= end; p++) pageNumbers.push(p);
}
---

{
  totalPages > 1 && (
    <nav aria-label={label} class:list={['flex flex-wrap items-center justify-center gap-2', className]}>
      {page > 1 ? (
        <a
          href={hrefFor(page - 1)}
          class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
        >
          ← Prev
        </a>
      ) : (
        <span class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-400">
          ← Prev
        </span>
      )}
      {pageNumbers.map((p) => (
        <a
          href={hrefFor(p)}
          aria-current={p === page ? 'page' : undefined}
          class:list={[
            'rounded-md px-3 py-1.5 text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600',
            p === page
              ? 'bg-brand-600 text-white'
              : 'border border-slate-300 bg-white text-slate-700 hover:bg-slate-50',
          ]}
        >
          {p}
        </a>
      ))}
      {page < totalPages ? (
        <a
          href={hrefFor(page + 1)}
          class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
        >
          Next →
        </a>
      ) : (
        <span class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-400">
          Next →
        </span>
      )}
    </nav>
  )
}
