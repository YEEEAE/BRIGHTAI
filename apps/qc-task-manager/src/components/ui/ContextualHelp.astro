---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="rounded-qc-md border border-info-border bg-info-soft px-4 py-3 text-sm text-info">
  <summary class="qc-focus cursor-pointer font-semibold text-info">
    {title}
  </summary>
  <div class="mt-2 leading-6 text-sky-900"><slot /></div>
</details>
