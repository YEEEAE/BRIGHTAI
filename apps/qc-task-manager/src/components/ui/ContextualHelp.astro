---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-950">
  <summary class="cursor-pointer font-semibold text-sky-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">
    {title}
  </summary>
  <div class="mt-2 leading-6 text-sky-900"><slot /></div>
</details>
