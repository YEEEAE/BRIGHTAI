---
interface RelatedLink {
  label: string;
  href: string;
  meta?: string;
}

interface Props {
  stage: string;
  stageTone?: 'neutral' | 'info' | 'pending' | 'warning' | 'success' | 'danger' | 'blocked';
  owner?: string;
  nextRole?: string;
  nextAction?: string;
  nextActionHref?: string;
  blocker?: string;
  related?: RelatedLink[];
}

const {
  stage,
  stageTone = 'info',
  owner = 'Not assigned',
  nextRole = '—',
  nextAction,
  nextActionHref,
  blocker,
  related = [],
} = Astro.props;

const toneClasses: Record<NonNullable<Props['stageTone']>, string> = {
  neutral: 'border-border bg-surface-muted text-content',
  info: 'border-info-border bg-info-soft text-info',
  pending: 'border-warning-border bg-warning-soft text-warning',
  warning: 'border-warning-border bg-warning-soft text-warning',
  success: 'border-success-border bg-success-soft text-success',
  danger: 'border-danger-border bg-danger-soft text-danger',
  blocked: 'border-border-strong bg-surface-muted text-content-secondary',
};
---

<section aria-labelledby="workflow-context-title" class={`rounded-xl border p-5 shadow-sm ${toneClasses[stageTone]}`}>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="type-metadata font-semibold uppercase tracking-wide">Continue this work</p>
      <h2 id="workflow-context-title" class="mt-1 text-base font-semibold">Current stage: {stage}</h2>
    </div>
    {nextAction && nextActionHref && (
    <a href={nextActionHref} class="inline-flex min-h-11 items-center rounded-qc-md bg-accent px-4 py-2 text-sm font-semibold text-content-inverse shadow-sm hover:bg-accent-hover qc-focus">
        {nextAction}
      </a>
    )}
  </div>

  <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-3">
    <div><dt class="type-metadata font-medium">Current owner</dt><dd class="mt-1 font-medium">{owner}</dd></div>
    <div><dt class="type-metadata font-medium">Next responsible role</dt><dd class="mt-1 font-medium">{nextRole}</dd></div>
    <div><dt class="type-metadata font-medium">Blocker</dt><dd class="mt-1 font-medium">{blocker ?? 'None recorded'}</dd></div>
  </dl>

  {related.length > 0 && (
    <div class="mt-4 border-t border-current/10 pt-4">
      <h3 class="type-metadata font-semibold uppercase tracking-wide">Related records</h3>
      <ul class="mt-2 flex flex-wrap gap-2">
        {related.map((link) => (
          <li><a href={link.href} class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-current/15 bg-white/70 px-3 py-2 text-sm font-medium underline decoration-current/30 underline-offset-2 hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"><span>{link.label}</span>{link.meta && <span class="type-metadata">{link.meta}</span>}</a></li>
        ))}
      </ul>
    </div>
  )}
</section>
