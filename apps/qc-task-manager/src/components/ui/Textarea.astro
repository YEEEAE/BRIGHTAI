---
import { CONTROL_TEXTAREA } from './controls';
interface Props { id?: string; name?: string; value?: string; placeholder?: string; required?: boolean; disabled?: boolean; invalid?: boolean; describedBy?: string; rows?: number; class?: string; }
const { id, name, value, placeholder, required, disabled, invalid, describedBy, rows = 4, class: className = '' } = Astro.props;
---
<textarea id={id} name={name} placeholder={placeholder} required={required} disabled={disabled} aria-invalid={invalid ? 'true' : undefined} aria-describedby={describedBy} rows={rows} class:list={[CONTROL_TEXTAREA, className]}>{value}</textarea>
