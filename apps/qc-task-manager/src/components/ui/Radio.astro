---
import { CONTROL_CHECKABLE } from './controls';
interface Props { id: string; name: string; value: string; checked?: boolean; disabled?: boolean; label: string; class?: string; }
const { id, name, value, checked, disabled, label, class: className = '' } = Astro.props;
---
<label class:list={['inline-flex min-h-11 items-center gap-2 text-sm text-content', className]}><input id={id} name={name} type="radio" value={value} checked={checked} disabled={disabled} class={CONTROL_CHECKABLE} /><span>{label}</span></label>
