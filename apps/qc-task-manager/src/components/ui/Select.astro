---
import { CONTROL_SELECT } from './controls';
interface Props { id?: string; name?: string; required?: boolean; disabled?: boolean; invalid?: boolean; describedBy?: string; class?: string; }
const { id, name, required, disabled, invalid, describedBy, class: className = '' } = Astro.props;
---
<select id={id} name={name} required={required} disabled={disabled} aria-invalid={invalid ? 'true' : undefined} aria-describedby={describedBy} class:list={[CONTROL_SELECT, className]}><slot /></select>
