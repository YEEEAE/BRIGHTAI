---
import { FIELD_ERROR, FIELD_HINT, FIELD_LABEL } from './controls';
interface Props { label: string; forId: string; hint?: string; error?: string; required?: boolean; class?: string; }
const { label, forId, hint, error, required = false, class: className = '' } = Astro.props;
---
<div class:list={['min-w-0', className]}>
  <label for={forId} class={FIELD_LABEL}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  <slot />
  {hint && <p id={`${forId}-hint`} class={FIELD_HINT}>{hint}</p>}
  {error && <p id={`${forId}-error`} class={FIELD_ERROR}>{error}</p>}
</div>
