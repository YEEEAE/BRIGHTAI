---
// StatusPill — the one status pill for every visible status presentation.
// Text is always rendered; the dot is decorative so status never relies on
// color alone. Domain adapters are resolved before this component is called.
import { statusPresentation, TONE_PILL_CLASSES, type StatusTone } from './statusTones';

interface Props {
  /** Central status code (DRAFT, APPROVED, PASS, active, OVERDUE…). */
  status?: string;
  /** Explicit override when a page needs a one-off tone + label. */
  tone?: StatusTone;
  label?: string;
  /** Decorative leading dot; always paired with the visible text label. */
  dot?: boolean;
  class?: string;
}

const { status, tone, label, dot = false, class: className = '' } = Astro.props;

let resolvedTone: StatusTone;
let resolvedLabel: string;
if (tone && label) {
  resolvedTone = tone;
  resolvedLabel = label;
} else if (status) {
  const preset = statusPresentation(status);
  resolvedTone = preset.tone;
  resolvedLabel = preset.label;
} else {
  resolvedTone = 'neutral';
  resolvedLabel = label ?? '—';
}
---
<span
  class:list={[
    'inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset',
    TONE_PILL_CLASSES[resolvedTone],
    className,
  ]}
>
  {dot && <span class="h-1.5 w-1.5 rounded-full bg-current opacity-70" aria-hidden="true" />}
  {resolvedLabel}
</span>
