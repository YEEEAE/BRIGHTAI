---
import { CONTROL_SWITCH } from './controls';
interface Props { id: string; name?: string; checked?: boolean; disabled?: boolean; label: string; class?: string; }
const { id, name, checked, disabled, label, class: className = '' } = Astro.props;
---
<label class:list={['inline-flex min-h-11 items-center gap-2 text-sm text-content', className]}><input id={id} name={name} type="checkbox" role="switch" checked={checked} disabled={disabled} class={CONTROL_SWITCH} /><span>{label}</span></label>
