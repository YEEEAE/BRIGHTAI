---
// AppButton — the one button primitive (docs/UI-DESIGN-SYSTEM.md §3.2).
// Renders an <a> when href is set (and not disabled), otherwise a <button>.
// Variants: primary (one per view) / secondary / tertiary / destructive.
// Destructive actions never sit beside a primary in the same group.
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'tertiary' | 'destructive';
  size?: 'md' | 'sm';
  type?: 'button' | 'submit';
  name?: string;
  value?: string;
  disabled?: boolean;
  loading?: boolean;
  ariaLabel?: string;
  title?: string;
  class?: string;
}

const {
  href,
  variant = 'secondary',
  size = 'md',
  type = 'button',
  name,
  value,
  disabled = false,
  loading = false,
  ariaLabel,
  title,
  class: className = '',
} = Astro.props;

const variantClasses = {
  primary: 'bg-accent text-content-inverse shadow-sm hover:bg-accent-hover focus-visible:outline-focus',
  secondary:
    'border border-border-strong bg-surface text-content-secondary shadow-sm hover:bg-surface-muted focus-visible:outline-focus',
  tertiary:
    'text-accent-hover hover:underline focus-visible:outline-focus shadow-none',
  destructive:
    'bg-danger text-content-inverse shadow-sm hover:bg-danger-hover focus-visible:outline-danger',
};

const sizeClasses = {
  md: 'px-4 py-2 text-sm min-h-11',
  sm: 'px-2.5 py-1.5 text-xs min-h-7',
};

const isDisabled = disabled || loading;
const classes = [
  'inline-flex items-center justify-center gap-1.5 rounded-qc-md font-semibold transition-colors duration-qc-standard ease-qc-standard',
  'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2',
  variantClasses[variant],
  sizeClasses[size],
  isDisabled ? 'cursor-not-allowed opacity-50' : '',
  className,
]
  .filter(Boolean)
  .join(' ');
---

{
  href && !isDisabled ? (
    <a href={href} class={classes} aria-label={ariaLabel} title={title}>
      <slot />
    </a>
  ) : (
    <button
      type={type}
      name={name}
      value={value}
      class={classes}
      disabled={isDisabled}
      aria-disabled={isDisabled ? 'true' : undefined}
      aria-label={ariaLabel}
      title={title}
    >
      <slot />
    </button>
  )
}
