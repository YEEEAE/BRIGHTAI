---
// PageHeader — the single page-skeleton header (docs/UI-DESIGN-SYSTEM.md §3.1/§4).
// Eyebrow (section context) + one H1 + optional description + right-aligned
// action row. Primary actions belong here; destructive actions belong in a
// separated danger zone instead.
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
}

const { eyebrow, title, description, class: className = '' } = Astro.props;
---
<header class:list={['media-reading-surface flex flex-wrap items-end justify-between gap-4', className]}>
  <div class="min-w-0">
    {eyebrow && (
      <p class="type-page-eyebrow">{eyebrow}</p>
    )}
    <h1 class:list={['type-page-title', eyebrow ? 'mt-1' : '']}>
      {title}
    </h1>
    {description && <p class="type-page-subtitle">{description}</p>}
  </div>
  <slot name="actions" />
</header>
