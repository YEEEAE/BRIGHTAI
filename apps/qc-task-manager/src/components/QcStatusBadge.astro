---
const { status } = Astro.props;
const tone = status === 'CLOSED' || status === 'EFFECTIVE' ? 'bg-emerald-100 text-emerald-800' : status === 'REOPENED' || status === 'ACTION_REQUIRED' ? 'bg-amber-100 text-amber-800' : status === 'CRITICAL' ? 'bg-red-100 text-red-800' : 'bg-slate-100 text-slate-700';
---
<span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${tone}`}>{status}</span>
