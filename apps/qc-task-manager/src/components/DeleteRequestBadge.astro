---
// DeleteRequestBadge — single shared badge for the delete-request workflow
// (CORE BUSINESS RULE #4). Rendered server-side on task rows in /employee,
// /manager, /supervisor and on the task-detail header, so the "Deletion
// requested" / "Deletion rejected" state looks identical everywhere.
//
//   status 'pending'  → red badge "🗑️ Deletion requested"
//   status 'rejected' → red badge "🗑️ Deletion rejected" with the reviewer's
//                       rejection reason (review_note) as a hover tooltip when
//                       one was recorded
//   anything else     → nothing
//
// The badge is deliberately a plain <span title=…>: it is non-interactive, so
// the tooltip is progressive enhancement for mouse users while the visible
// text ("Deletion rejected") carries the meaning for keyboard/screen readers.
interface Props {
  /** Most recent delete-request status for the task, or null. */
  status?: 'pending' | 'rejected' | string | null;
  /** Rejection reason (task_delete_requests.review_note), surfaced as a tooltip. */
  reason?: string | null;
}

const { status, reason } = Astro.props;
const isPending = status === 'pending';
const isRejected = status === 'rejected';
const shown = isPending || isRejected;
const tooltip = isPending
  ? 'Deletion requested — a manager is reviewing this task'
  : isRejected
    ? reason?.trim()
      ? `Deletion rejected: ${reason.trim()}`
      : 'Deletion rejected'
    : '';
---

{shown && (
  <span
    class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-red-100 px-2.5 py-1 text-xs font-medium text-red-700"
    title={tooltip}
  >
    🗑️ {isPending ? 'Deletion requested' : 'Deletion rejected'}
  </span>
)}
