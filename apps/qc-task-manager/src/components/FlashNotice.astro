---
/**
 * FlashNotice — One-shot banner for messages carried across a redirect
 * (login success, role-guard denial, form feedback). Reads the `qc_flash`
 * cookie once, renders it, and clears the cookie on the outgoing response.
 */
import { consumeFlash } from '../lib/flash';

const flash = consumeFlash(Astro);

const tones = {
  success: 'border-emerald-200 bg-emerald-50 text-emerald-800',
  error: 'border-red-200 bg-red-50 text-red-800',
  info: 'border-sky-200 bg-sky-50 text-sky-800',
  warning: 'border-amber-200 bg-amber-50 text-amber-900',
};
---

{
  flash && (
    <div class={`mt-4 rounded-md border px-4 py-3 text-sm ${tones[flash.type]}`} role="alert">
      {flash.message}
    </div>
  )
}
