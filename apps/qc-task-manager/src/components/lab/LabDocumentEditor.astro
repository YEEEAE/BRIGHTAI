---
// LabDocumentEditor — the shared SOP/WI Document editor (PROMPT 41, page
// reference §40), rendered server-side for BOTH /lab/documents/new and
// /lab/documents/[id]/edit.
//
// A plain Astro form (no island): every input is a native control and there is
// no client JS to load, so the strict CSP (src/middleware.ts) stays intact.
// Submission is a native POST to the same URL; the middleware short-circuits
// it and the shared Zod schema (labDocumentSchema) re-validates everything
// server-side. The "Related Equipment" checkboxes repeat the `equipment_ids`
// key — the handler collects them from the raw FormData.
//
// CONTENT: the author writes the document body in a small Markdown subset
// (headings, numbered procedures, bullets, tables, warnings, notes,
// checklists, safe links — see documentContent.ts). The live preview is
// SERVER-RENDERED sanitized HTML: on create the field is empty (no preview),
// on edit it renders the current version's content_md through the same
// escape-only renderer stored in content_html_sanitized. Content is never
// rendered client-side.
//
// Catalog-only identities may be saved without content; editing one with content
// creates version 1. APPROVED documents are immutable (contract §41/§42/§44): editing one shows a
// banner and REQUIRES a change summary — the save creates a NEW DRAFT version
// while the approved version stays untouched. The document code is immutable
// on edit (identity referenced by historical snapshots) — read-only here.
import type { LabDocument, LabDocumentVersion } from '../../lib/types';
import { LAB_DOCUMENT_CODE_MAX, LAB_DOCUMENT_CONTENT_MAX, LAB_DOCUMENT_DESCRIPTION_MAX, LAB_DOCUMENT_TITLE_MAX } from '../../lib/lab/policy';
import { LAB_DOCUMENT_STATUS_LABELS } from '../../lib/lab/documents';

interface Props {
  mode: 'create' | 'edit';
  document?: LabDocument | null;
  version?: LabDocumentVersion | null;
  currentContentMd?: string;
  equipmentOptions: Array<{ id: number; name: string; code: string }>;
  selectedEquipmentIds: number[];
  productOptions: Array<{ id: number; name: string; code: string }>;
  userOptions: Array<{ id: number; full_name: string }>;
  canReview?: boolean;
}

const { mode, document = null, version = null, currentContentMd = '', equipmentOptions, selectedEquipmentIds = [], productOptions, userOptions, canReview = false } = Astro.props;

const actionUrl = mode === 'create' ? '/lab/documents/new' : `/lab/documents/${document!.id}/edit`;
const submitLabel = mode === 'create' ? 'Create Document' : 'Save Changes';

const isRevisingApproved = mode === 'edit' && version?.status === 'APPROVED';

const inputCls =
  'mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500';
const labelCls = 'block text-sm font-medium text-slate-700';
const sectionCls = 'rounded-xl border border-slate-200 bg-white p-5 shadow-sm';
const sectionTitleCls = 'text-base font-semibold text-slate-900';
---

<form method="POST" action={actionUrl} data-qc-form>
  <div class="space-y-6">
    {isRevisingApproved && (
      <div role="status" class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        You are revising an <strong>approved</strong> document — saving creates a <strong>new draft version</strong>.
        The approved version stays immutable. A change summary is required.
      </div>
    )}

    <section aria-labelledby="sec-doc-identity" class={sectionCls}>
      <h2 id="sec-doc-identity" class={sectionTitleCls}>Document Identity</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="type" class={labelCls}>Document Type <span class="text-red-600" aria-hidden="true">*</span></label>
          <select id="type" name="type" required class={inputCls}>
            <option value="SOP" selected={document?.type === 'SOP'}>SOP — Standard Operating Procedure</option>
            <option value="WI" selected={document?.type === 'WI'}>WI — Work Instruction</option>
          </select>
        </div>
        <div>
          <label for="code" class={labelCls}>Document Code <span class="text-red-600" aria-hidden="true">*</span></label>
          <input
            id="code"
            name="code"
            type="text"
            required
            maxlength={LAB_DOCUMENT_CODE_MAX}
            pattern="[A-Za-z0-9][A-Za-z0-9._-]*"
            value={document?.code ?? ''}
            dir="ltr"
            readonly={mode === 'edit'}
            aria-describedby="code-hint"
            class={`${inputCls} ${mode === 'edit' ? 'bg-slate-50 text-slate-500' : ''}`}
          />
          <p id="code-hint" class="mt-1 text-xs text-slate-500">
            {mode === 'edit'
              ? 'The code is immutable after creation — it is referenced by historical versions and records.'
              : 'Unique. Letters, numbers, _ . and - only. Cannot be changed later.'}
          </p>
        </div>
        <div class="sm:col-span-2">
          <label for="title" class={labelCls}>Document Title <span class="text-red-600" aria-hidden="true">*</span></label>
          <input
            id="title"
            name="title"
            type="text"
            required
            maxlength={LAB_DOCUMENT_TITLE_MAX}
            value={document?.title ?? ''}
            class={inputCls}
          />
        </div>
        <div class="sm:col-span-2">
          <label for="description" class={labelCls}>Description</label>
          <textarea id="description" name="description" rows="2" maxlength={LAB_DOCUMENT_DESCRIPTION_MAX} class={inputCls}>
            {document?.description ?? ''}
          </textarea>
        </div>
      </div>
    </section>

    <section aria-labelledby="sec-doc-reference" class={sectionCls}>
      <h2 id="sec-doc-reference" class={sectionTitleCls}>References &amp; Dates</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="product_id" class={labelCls}>Product Reference</label>
          <select id="product_id" name="product_id" class={inputCls}>
            <option value="">Not specified</option>
            {productOptions.map((p) => (
              <option value={p.id} selected={document?.product_id === p.id}>{p.code} — {p.name}</option>
            ))}
          </select>
          {productOptions.length === 0 && <p class="mt-1 text-xs text-slate-500">No active products registered yet.</p>}
        </div>
        <div>
          <label for="owner_id" class={labelCls}>Owner</label>
          <select id="owner_id" name="owner_id" class={inputCls}>
            <option value="">Not specified</option>
            {userOptions.map((u) => (
              <option value={u.id} selected={document?.owner_id === u.id}>{u.full_name}</option>
            ))}
          </select>
          {userOptions.length === 0 && <p class="mt-1 text-xs text-slate-500">No active users registered yet.</p>}
        </div>
        <div>
          <label for="effective_date" class={labelCls}>Effective Date</label>
          <input id="effective_date" name="effective_date" type="date" value={document?.effective_date ?? ''} class={inputCls} dir="ltr" />
        </div>
        <div>
          <label for="review_due_date" class={labelCls}>Review Due Date</label>
          <input id="review_due_date" name="review_due_date" type="date" value={document?.review_due_date ?? ''} class={inputCls} dir="ltr" />
        </div>
      </div>
    </section>

    <section aria-labelledby="sec-doc-equipment" class={sectionCls}>
      <h2 id="sec-doc-equipment" class={sectionTitleCls}>Related Equipment</h2>
      <p class="mt-1 text-xs text-slate-500">Linked by canonical equipment id — shown as context on the register and detail views.</p>
      {equipmentOptions.length === 0 ? (
        <p class="mt-3 text-sm text-slate-600">No equipment registered yet — equipment can be linked later.</p>
      ) : (
        <fieldset class="mt-3">
          <legend class="sr-only">Related equipment</legend>
          <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {equipmentOptions.map((e) => (
              <li>
                <label class="flex items-center gap-2 rounded-md border border-slate-200 px-3 py-2 text-sm text-slate-700">
                  <input
                    type="checkbox"
                    name="equipment_ids"
                    value={e.id}
                    checked={selectedEquipmentIds.includes(e.id)}
                    class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"
                  />
                  <span class="font-medium">{e.name}</span>
                  <span class="text-slate-500" dir="ltr">({e.code})</span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      )}
    </section>

    <section aria-labelledby="sec-doc-content" class={sectionCls}>
      <h2 id="sec-doc-content" class={sectionTitleCls}>Document Content</h2>
      <p class="mt-1 text-xs text-slate-500">
        Write the body in a small safe Markdown subset: <code># / ## headings</code>, numbered steps <code>1.</code>,
        bullets <code>-</code>, tables (<code>| a | b |</code>), <code>- [ ] / - [x]</code> checklists,
        <code>&gt; [!WARNING]</code> and <code>&gt; [!NOTE]</code> callouts, and links <code>[label](https://…)</code>.
        HTML is not allowed — it is escaped and shown as plain text.
      </p>
      <div class="mt-3">
        <label for="content" class={labelCls}>Content</label>
        <textarea
          id="content"
          name="content"
          rows="16"
          maxlength={LAB_DOCUMENT_CONTENT_MAX}
          class={`${inputCls} font-mono text-xs leading-relaxed`}
          dir="ltr"
        >{currentContentMd}</textarea>
        <p class="mt-1 text-xs text-slate-500">
          {LAB_DOCUMENT_CONTENT_MAX.toLocaleString('en-US')} characters max. Leave empty to save a catalog-only identity; the first
          non-empty save creates version 1. The preview below is rendered server-side and sanitized.
        </p>
      </div>

      {currentContentMd.trim() !== '' && (
        <div class="mt-4">
          <h3 class="text-sm font-semibold text-slate-900">Live preview (server-rendered, sanitized)</h3>
          <div class="mt-2 rounded-lg border border-slate-200 bg-slate-50 p-4">
            <div class="doc-content" dir="ltr">{currentContentMd}</div>
          </div>
        </div>
      )}
    </section>

    <section aria-labelledby="sec-doc-workflow" class={sectionCls}>
      <h2 id="sec-doc-workflow" class={sectionTitleCls}>Change Summary &amp; Status</h2>
      <p class="mt-1 text-xs text-slate-500">
        {isRevisingApproved
          ? 'Required when revising an approved version — this summary is attached to the new draft version and appears in the version history.'
          : 'Optional on draft saves. A change summary is required the moment you revise an approved version.'}
      </p>
      <div class="mt-3">
        <label for="change_summary" class={labelCls}>Change Summary {isRevisingApproved && <span class="text-red-600" aria-hidden="true">*</span>}</label>
        <textarea
          id="change_summary"
          name="change_summary"
          rows="2"
          maxlength="2000"
          required={isRevisingApproved}
          class={inputCls}
        >{version?.change_summary ?? ''}</textarea>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-slate-600">
        <span>
          Current status: <strong>{version?.status === 'APPROVED' ? 'Approved (v' + version.version + ')' : version ? LAB_DOCUMENT_STATUS_LABELS[version.status] + ' (v' + version.version + ')' : 'Draft'}</strong>
        </span>
        {canReview && (
          <span class="text-slate-500">Review / approval actions appear on the workflow toolbar (coming with the review module).</span>
        )}
      </div>
    </section>

    <div class="sticky bottom-0 z-20 -mx-4 flex flex-wrap items-center justify-end gap-3 border-t border-slate-200 bg-white/95 px-4 py-3 shadow-[0_-4px_12px_rgba(15,23,42,0.08)] backdrop-blur" data-qc-actions>
      <a
        href={mode === 'create' ? '/lab/documents' : `/lab/documents/${document!.id}`}
        class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
      >
        Cancel
      </a>
      <button
        type="submit"
        class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
      >
        {submitLabel}
      </button>
    </div>
  </div>
</form>
