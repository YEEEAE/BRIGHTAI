---
// LabTemplateForm — the shared Test Template form (PROMPT 10), rendered
// server-side for BOTH /lab/templates/new and /lab/templates/[id]/edit.
//
// A plain Astro form (no island): the field set is fixed and every input is a
// native control, so there is no client JS to load. Submission is a native
// POST to the same URL; the middleware short-circuits it and the shared Zod
// schema (labTemplateSchema) re-validates everything server-side. Repeated
// checkbox keys (`equipment_ids`, `connector_choices`) are collected by the
// handler from the raw FormData.
//
// Reference parameter fields are prefilled with the printed-form values from
// lab/policy.ts but remain free-form display text — nothing is invented (§78).
const {
  mode,
  template = null,
  version = null,
  parameters = null,
  selectedEquipmentIds = [],
  selectedConnectorChoices = [],
  products,
  sops,
  wis,
  equipmentOptions,
  connectorTypes,
} = Astro.props;

const actionUrl = mode === 'create' ? '/lab/templates/new' : `/lab/templates/${template!.id}/edit`;
const submitLabel = mode === 'create' ? 'Create Template' : 'Save Changes';

const inputCls =
  'mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500';
const labelCls = 'block text-sm font-medium text-slate-700';
const sectionCls = 'rounded-xl border border-slate-200 bg-white p-5 shadow-sm';
const sectionTitleCls = 'text-base font-semibold text-slate-900';
---

<form method="POST" action={actionUrl}>
  {mode === 'edit' && <input type="hidden" name="form_action" value="save" />}
  <div class="space-y-6">
    <section aria-labelledby="sec-template-identity" class={sectionCls}>
      <h2 id="sec-template-identity" class={sectionTitleCls}>Template Identity</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="name" class={labelCls}>Template Name <span class="text-red-600" aria-hidden="true">*</span></label>
          <input
            id="name"
            name="name"
            type="text"
            required
            maxlength="200"
            value={template?.name ?? ''}
            class={inputCls}
          />
        </div>
        <div>
          <label for="effective_date" class={labelCls}>Effective Date</label>
          <input id="effective_date" name="effective_date" type="date" value={version?.effective_date ?? ''} class={inputCls} />
        </div>
        <div>
          <label for="code" class={labelCls}>Template Code <span class="text-red-600" aria-hidden="true">*</span></label>
          <input
            id="code"
            name="code"
            type="text"
            required
            maxlength="60"
            pattern="[A-Za-z0-9][A-Za-z0-9._-]*"
            value={template?.code ?? ''}
            dir="ltr"
            class={inputCls}
          />
          <p class="mt-1 text-xs text-slate-500">Unique and stable across versions (e.g. AIR-TEMPLATE-001).</p>
        </div>
        <div>
          <label for="test_type" class={labelCls}>Test Type <span class="text-red-600" aria-hidden="true">*</span></label>
          <select id="test_type" name="test_type" required class={inputCls}>
            <option value="air" selected={template?.test_type !== 'vacuum'}>AIR</option>
            <option value="vacuum" selected={template?.test_type === 'vacuum'}>VACUUM</option>
          </select>
        </div>
        <div>
          <label for="default_sample_count" class={labelCls}>Default Sample Count</label>
          <input
            id="default_sample_count"
            name="default_sample_count"
            type="number"
            min="1"
            max="20"
            step="1"
            value={version?.default_sample_count ?? 5}
            class={inputCls}
          />
          <p class="mt-1 text-xs text-slate-500">Prefills the sample grid on the test form (1–20).</p>
        </div>
        <label class="flex items-start gap-2 text-sm text-slate-700 sm:col-span-2">
          <input id="requires_approved_template_for_submission" name="requires_approved_template_for_submission" type="checkbox" value="1" checked={version?.requires_approved_template_for_submission === 1} class="mt-1 h-4 w-4" />
          <span><span class="font-medium">Require approved template for submission</span><span class="block text-xs text-slate-500">Off by default. Drafts can still save without a template; when enabled, submission requires this compatible approved version.</span></span>
        </label>
      </div>
    </section>

    <section aria-labelledby="sec-template-parameters" class={sectionCls}>
      <h2 id="sec-template-parameters" class={sectionTitleCls}>Reference Parameters</h2>
      <p class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500">
        Display reference values — shown on the test form and snapshotted onto approved tests. Never validated against measurements.
      </p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="standard_parameter" class={labelCls}>Standard Parameter</label>
          <input
            id="standard_parameter"
            name="standard_parameter"
            type="text"
            maxlength="200"
            value={parameters?.standard_parameter ?? ''}
            dir="ltr"
            class={inputCls}
          />
        </div>
        <div>
          <label for="acceptance_criteria" class={labelCls}>Acceptance Criteria</label>
          <input
            id="acceptance_criteria"
            name="acceptance_criteria"
            type="text"
            maxlength="200"
            value={parameters?.acceptance_criteria ?? ''}
            dir="ltr"
            class={inputCls}
          />
        </div>
        <div>
          <label for="holding_time" class={labelCls}>Holding Time</label>
          <input
            id="holding_time"
            name="holding_time"
            type="text"
            maxlength="200"
            value={parameters?.holding_time ?? ''}
            dir="ltr"
            class={inputCls}
          />
        </div>
        <div>
          <label for="actual_pressure_reference" class={labelCls}>Actual Pressure Reference</label>
          <input
            id="actual_pressure_reference"
            name="actual_pressure_reference"
            type="text"
            maxlength="200"
            value={parameters?.actual_pressure_reference ?? ''}
            dir="ltr"
            class={inputCls}
          />
        </div>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ['medium_name', 'Medium name'],
          ['actual_force_reference', 'Actual Force reference'],
          ['torque_reference', 'Torque reference'],
          ['time_reference', 'Time reference'],
          ['angle_reference', 'Angle reference'],
          ['temperature_reference', 'Temperature reference'],
          ['humidity_reference', 'Humidity reference'],
          ['standard_condition', 'Standard condition'],
          ['leakage_reference', 'Leakage reference'],
          ['holding_time_reference', 'Holding time reference'],
        ].map(([key, label]) => (
          <div>
            <label for={key} class={labelCls}>{label}</label>
            <input id={key} name={key} type="text" maxlength="200" value={parameters?.[key] ?? ''} dir="ltr" class={inputCls} />
          </div>
        ))}
      </div>
      <fieldset class="mt-4">
        <legend class={labelCls}>Connector Options</legend>
        <p class="mt-1 text-xs text-slate-500">Printed connector choices offered by this template (subset of the approved form).</p>
        <ul class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {connectorTypes.map((c: string) => (
            <li>
              <label class="flex items-center gap-2 rounded-md border border-slate-200 px-3 py-2 text-sm text-slate-700">
                <input
                  type="checkbox"
                  name="connector_choices"
                  value={c}
                  checked={selectedConnectorChoices.includes(c)}
                  class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"
                />
                <span>{c}</span>
              </label>
            </li>
          ))}
        </ul>
      </fieldset>
    </section>

    <section aria-labelledby="sec-template-associations" class={sectionCls}>
      <h2 id="sec-template-associations" class={sectionTitleCls}>Associations</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="applicable_product_id" class={labelCls}>Applicable Product</label>
          <select id="applicable_product_id" name="applicable_product_id" class={inputCls}>
            <option value="">Not specified</option>
            {products.map((p: { id: number; name: string; code: string }) => (
              <option value={p.id} selected={version?.applicable_product_id === p.id}>{p.name} ({p.code})</option>
            ))}
          </select>
          {products.length === 0 && <p class="mt-1 text-xs text-slate-500">No active products registered yet.</p>}
        </div>
        <div>
          <label for="applicable_equipment_id" class={labelCls}>Primary Equipment</label>
          <select id="applicable_equipment_id" name="applicable_equipment_id" class={inputCls}>
            <option value="">Not specified</option>
            {equipmentOptions.map((e: { id: number; name: string; code: string }) => (
              <option value={e.id} selected={version?.applicable_equipment_id === e.id}>{e.name} ({e.code})</option>
            ))}
          </select>
          {equipmentOptions.length === 0 && <p class="mt-1 text-xs text-slate-500">No equipment registered yet.</p>}
        </div>
        <div>
          <label for="sop_id" class={labelCls}>Applicable SOP</label>
          <select id="sop_id" name="sop_id" class={inputCls}>
            <option value="">Not specified</option>
            {sops.map((d: { id: number; title: string; code: string }) => (
              <option value={d.id} selected={version?.sop_id === d.id}>{d.code} — {d.title}</option>
            ))}
          </select>
          {sops.length === 0 && <p class="mt-1 text-xs text-slate-500">No approved SOP documents yet.</p>}
        </div>
        <div>
          <label for="wi_id" class={labelCls}>Applicable WI</label>
          <select id="wi_id" name="wi_id" class={inputCls}>
            <option value="">Not specified</option>
            {wis.map((d: { id: number; title: string; code: string }) => (
              <option value={d.id} selected={version?.wi_id === d.id}>{d.code} — {d.title}</option>
            ))}
          </select>
          {wis.length === 0 && <p class="mt-1 text-xs text-slate-500">No approved WI documents yet.</p>}
        </div>
      </div>
    </section>

    <section aria-labelledby="sec-template-equipment" class={sectionCls}>
      <h2 id="sec-template-equipment" class={sectionTitleCls}>Equipment Compatibility</h2>
      <p class="mt-1 text-xs text-slate-500">Linked by canonical equipment id — shown as suggestions on the test form.</p>
      {equipmentOptions.length === 0 ? (
        <p class="mt-3 text-sm text-slate-600">No equipment registered yet — equipment can be linked later.</p>
      ) : (
        <fieldset class="mt-3">
          <legend class="sr-only">Compatible equipment</legend>
          <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {equipmentOptions.map((e: { id: number; name: string; code: string }) => (
              <li>
                <label class="flex items-center gap-2 rounded-md border border-slate-200 px-3 py-2 text-sm text-slate-700">
                  <input
                    type="checkbox"
                    name="equipment_ids"
                    value={e.id}
                    checked={selectedEquipmentIds.includes(e.id)}
                    class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"
                  />
                  <span class="font-medium">{e.name}</span>
                  <span class="text-slate-500" dir="ltr">({e.code})</span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      )}
    </section>

    <div class="flex flex-wrap items-center justify-end gap-3">
      <a
        href={mode === 'create' ? '/lab/templates' : `/lab/templates/${template!.id}`}
        class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
      >
        Cancel
      </a>
      <button
        type="submit"
        class="rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
      >
        {submitLabel}
      </button>
    </div>
  </div>
</form>
