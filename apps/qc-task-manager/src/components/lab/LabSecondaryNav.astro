---
// LabSecondaryNav — renders the QC Laboratory secondary navigation.
// Receives ALREADY-FILTERED entries from the page (computed via
// labNavForRole in src/lib/lab/navigation.ts). This component owns no
// authorization decisions — architecture-guard forbids UI components from
// importing lib/permissions.
import { LAB_NAV_GROUPS, type LabNavItem } from '../../lib/lab/navigation';

interface Props {
  items: LabNavItem[];
  currentPath?: string;
}

const { items, currentPath = '' } = Astro.props;
const groupEntries = (group: string) => items.filter((item) => item.group === group);
---
{
  items.length > 0 && (
    <nav aria-label="Laboratory sections" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        {LAB_NAV_GROUPS.map((group) => {
          const entries = groupEntries(group);
          return entries.length > 0 ? (
            <li class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-semibold uppercase tracking-wide text-slate-500" aria-hidden="true">{group}</span>
              {entries.map((entry) => (
                <a
                  href={entry.href}
                  aria-current={currentPath === entry.href ? 'page' : undefined}
                  class:list={[
                    'rounded-md px-2.5 py-1.5 text-sm font-medium',
                    currentPath === entry.href
                      ? 'bg-brand-50 text-brand-700'
                      : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900',
                  ]}
                >
                  {entry.label}
                </a>
              ))}
            </li>
          ) : null;
        })}
      </ul>
    </nav>
  )
}
