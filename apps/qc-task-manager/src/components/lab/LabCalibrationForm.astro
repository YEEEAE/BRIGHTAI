---
// Shared Calibration Register form — used by BOTH /lab/calibration/new and
// /lab/calibration/[id]/edit. The equipment id comes from the matched path
// for edits (never the body); this component posts to the page URL itself and
// the middleware short-circuits the POST (same pattern as LabEquipmentForm).
// Only `equipment_id` is required — every other field is nullable on purpose
// (missing data stays missing, rendered as "—").
import type { LabEquipmentCalibration } from '../../lib/types';

interface Props {
  mode: 'create' | 'edit';
  calibration?: LabEquipmentCalibration | null;
  equipmentOptions: Array<{ id: number; code: string; name: string }>;
}

const { mode, calibration = null, equipmentOptions } = Astro.props;
const actionUrl = mode === 'create' ? '/lab/calibration/new' : `/lab/calibration/${calibration!.id}/edit`;

const inputCls =
  'mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500';
const labelCls = 'block text-sm font-medium text-slate-700';
const sectionCls = 'rounded-xl border border-slate-200 bg-white p-5 shadow-sm';
const sectionTitleCls = 'text-base font-semibold text-slate-900';
---

<section aria-labelledby="sec-calibration-form" class={sectionCls}>
  <h2 id="sec-calibration-form" class={sectionTitleCls}>{mode === 'create' ? 'Calibration Details' : 'Edit Calibration Record'}</h2>
  <p class="mt-1 text-sm text-slate-600">
    Dates are YYYY-MM-DD. All fields except the equipment are optional — leave them empty when the data is not yet available.
    Every save is written to the audit log.
  </p>
  <form method="POST" action={actionUrl} class="mt-4">
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <label for="equipment_id" class={labelCls}>Equipment <span class="text-red-600" aria-hidden="true">*</span></label>
        <select id="equipment_id" name="equipment_id" required class={inputCls}>
          <option value="">Select equipment…</option>
          {equipmentOptions.map((e) => (
            <option value={e.id} selected={calibration?.equipment_id === e.id}>
              {e.name} ({e.code})
            </option>
          ))}
        </select>
        <p class="mt-1 text-xs text-slate-500">Only active (non-archived) equipment can receive calibration records.</p>
      </div>
      <div>
        <label for="last_calibrated_at" class={labelCls}>Last Calibration Date</label>
        <input id="last_calibrated_at" name="last_calibrated_at" type="date" value={calibration?.last_calibrated_at ?? ''} class={inputCls} />
      </div>
      <div>
        <label for="calibration_due_at" class={labelCls}>Calibration Due Date</label>
        <input id="calibration_due_at" name="calibration_due_at" type="date" value={calibration?.calibration_due_at ?? ''} class={inputCls} />
      </div>
      <div>
        <label for="next_due_at" class={labelCls}>Next Due Date</label>
        <input id="next_due_at" name="next_due_at" type="date" value={calibration?.next_due_at ?? ''} class={inputCls} />
        <p class="mt-1 text-xs text-slate-500">Takes precedence over the due date when both are present.</p>
      </div>
      <div>
        <label for="provider" class={labelCls}>Calibration Provider</label>
        <input id="provider" name="provider" type="text" maxlength="200" value={calibration?.provider ?? ''} class={inputCls} />
      </div>
      <div>
        <label for="certificate_reference" class={labelCls}>Certificate Reference</label>
        <input id="certificate_reference" name="certificate_reference" type="text" maxlength="200" value={calibration?.certificate_reference ?? ''} class={inputCls} dir="ltr" />
      </div>
      <div>
        <label for="result" class={labelCls}>Calibration Result</label>
        <input id="result" name="result" type="text" maxlength="200" value={calibration?.result ?? ''} class={inputCls} />
        <p class="mt-1 text-xs text-slate-500">Free text stored verbatim. Values like "fail" / "not compliant" mark the record Not Compliant.</p>
      </div>
      <div class="sm:col-span-2">
        <label for="notes" class={labelCls}>Notes</label>
        <textarea id="notes" name="notes" rows="3" maxlength="5000" class={inputCls}>{calibration?.notes ?? ''}</textarea>
      </div>
    </div>
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <button
        type="submit"
        class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
      >
        {mode === 'create' ? 'Add Calibration Record' : 'Save Changes'}
      </button>
      <a
        href={mode === 'create' ? '/lab/calibration' : `/lab/calibration/${calibration!.id}`}
        class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
      >
        Cancel
      </a>
    </div>
  </form>
</section>