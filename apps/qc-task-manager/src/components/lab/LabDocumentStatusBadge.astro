---
import type { LabDocumentStatus } from '../../lib/types';
import StatusPill from '../ui/StatusPill.astro';
import { statusAdapters } from '../ui/statusTones';

interface Props {
  status: LabDocumentStatus;
  missingContent?: boolean;
}

const { status, missingContent = false } = Astro.props;
const presentation = missingContent
  ? { tone: 'warning' as const, label: 'Missing Content' }
  : statusAdapters.document(status);
---
<StatusPill tone={presentation.tone} label={presentation.label} dot />
