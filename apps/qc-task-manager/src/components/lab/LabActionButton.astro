---
// LabActionButton — lab-flavored alias over the canonical AppButton primitive
// (docs/UI-DESIGN-SYSTEM.md §3.2). Kept as a thin wrapper so existing lab
// pages keep their import; all styling now comes from AppButton only
// (md size, min-height 44px for touch).
import AppButton from '../ui/AppButton.astro';

interface Props {
  href?: string;
  kind?: 'primary' | 'secondary' | 'destructive';
  disabled?: boolean;
  ariaLabel?: string;
  type?: 'button' | 'submit';
  name?: string;
  value?: string;
}

const { href, kind = 'secondary', disabled = false, ariaLabel, type = 'button', name, value } = Astro.props;
---

<AppButton
  href={href}
  variant={kind}
  size="md"
  type={type}
  name={name}
  value={value}
  disabled={disabled}
  ariaLabel={ariaLabel}
>
  <slot />
</AppButton>
