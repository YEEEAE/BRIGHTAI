---
// Inline "Save view" affordance for lab list pages (PROMPT 24).
//
// Renders a small POST form that saves the CURRENT filter state of the page
// as a user-scoped saved view. The filter_json payload is built server-side
// from the allowlisted params only — never arbitrary SQL or query strings.
// The POST returns to the exact filtered state via the `next` field.
import { LAB_SAVED_VIEW_NAME_MAX, buildLabViewFilterJson } from '../../lib/lab/savedViews';

interface Props {
  /** The list page path this form sits on (must be a known view target). */
  path: string;
}

const { path } = Astro.props;
const filterJson = buildLabViewFilterJson(path, Astro.url);
const next = Astro.url.pathname + Astro.url.search;
---

{filterJson && (
  <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 px-4 py-3">
    <form method="post" action="/api/lab/saved-views" class="flex flex-wrap items-end gap-2">
      <input type="hidden" name="action" value="save" />
      <input type="hidden" name="filter_json" value={filterJson} />
      <input type="hidden" name="next" value={next} />
      <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
        Save this view
        <input
          type="text"
          name="name"
          required
          maxlength={LAB_SAVED_VIEW_NAME_MAX}
          placeholder="e.g. My Air Tests"
          class="mt-0.5 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        />
      </label>
      <button
        type="submit"
        class="rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700"
      >
        Save view
      </button>
      <span class="text-xs text-slate-500">
        Private to you — reuse it anytime from <a href="/lab/saved-views" class="underline hover:text-slate-700">Saved Views</a>.
      </span>
    </form>
  </div>
)}
