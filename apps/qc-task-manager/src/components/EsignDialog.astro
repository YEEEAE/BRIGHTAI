---
// Accessible e-signature confirmation dialog (password re-verification step)
// shared by the highest-authority laboratory actions: test APPROVE (Review
// Center), test VOID, and document APPROVE. One <dialog> per page is enough —
// the external controller (public/scripts/esign-confirm.js) wires any
// [data-esign-trigger] submit button on the page to this single instance.
// Native <dialog> provides focus containment and Escape handling; the
// controller adds cancel/backdrop/empty-value behavior. No inline styles
// (CSP style-src 'self') and no inline scripts.
---

<dialog
  id="esign-dialog"
  role="dialog"
  aria-modal="true"
  class="w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-xl backdrop:bg-slate-900/50"
  aria-labelledby="esign-title"
  aria-describedby="esign-description"
>
  <form method="dialog" novalidate>
    <h2 id="esign-title" class="text-base font-semibold text-slate-900">تأكيد الهوية</h2>
    <p id="esign-description" class="mt-1 text-sm text-slate-600">
      هذا الإجراء من الإجراءات عالية الصلاحية ولا يمكن التراجع عنه. أدخل كلمة مرورك الحالية لتأكيد التنفيذ.
    </p>
    <label class="mt-4 block text-sm font-medium text-slate-700" for="esign-reason">
      سبب التوقيع الإلكتروني (Signature Reason) <span class="text-rose-600">*</span>
    </label>
    <input
      type="text"
      id="esign-reason"
      name="signature_reason_input"
      value="I approve this test result for release"
      required
      class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
    />
    <label class="mt-4 block text-sm font-medium text-slate-700" for="esign-password">
      كلمة المرور الحالية <span class="text-rose-600">*</span>
    </label>
    <input
      type="password"
      id="esign-password"
      name="esign_password_input"
      required
      autocomplete="current-password"
      autofocus
      dir="ltr"
      class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
    />
    <p id="esign-error" role="alert" hidden class="mt-2 text-sm font-medium text-rose-700"></p>
    <div class="mt-5 flex flex-wrap items-center justify-end gap-2">
      <button
        type="button"
        id="esign-cancel"
        class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
      >
        إلغاء
      </button>
      <button
        type="button"
        id="esign-confirm"
        class="min-h-[44px] rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
      >
        تأكيد وتنفيذ
      </button>
    </div>
  </form>
</dialog>
<script is:inline type="module" src="/scripts/esign-confirm.js"></script>
