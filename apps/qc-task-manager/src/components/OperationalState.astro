---
// Shared operational state language. Every state includes an available next action.
interface Props { state: 'no-records' | 'no-results' | 'forbidden' | 'system-error' | 'conflict' | 'stale-record' | 'success' | 'warning'; title?: string; detail?: string; actionHref?: string; actionLabel?: string; }
const { state, title, detail, actionHref, actionLabel } = Astro.props;
const copy = {
  'no-records': ['No records yet', 'There are no records in this area. Create the first record to get started.', 'Create the first record'],
  'no-results': ['No matching records', 'No records match these filters. Broaden your search or clear the filters.', 'Clear filters'],
  forbidden: ['Access not available', 'You do not have permission to view this page. Return to your home page or contact an administrator. No data was changed.', 'Go to home'],
  'system-error': ['We couldn’t complete that request', 'A temporary problem prevented the request. No changes were saved. Check your connection and try again; retrying is safe.', 'Try again'],
  conflict: ['This record changed', 'Someone changed this record before you saved it. Your changes were not saved. Review the latest record, then try again.', 'Review the latest record'],
  'stale-record': ['This page is out of date', 'This page may show older information. Your last change was not submitted. Reload the page before making another change.', 'Reload the page'],
  success: ['Change saved', 'Your change was saved successfully. You can continue working.', 'Continue working'],
  warning: ['Review needed', 'Review the highlighted issue before continuing. Nothing has been changed yet.', 'Review the issue'],
} as const;
const [defaultTitle, defaultDetail, defaultAction] = copy[state];
---
<section class="rounded-xl border border-slate-200 bg-white p-6" aria-live={state === 'system-error' || state === 'conflict' ? 'assertive' : 'polite'}>
  <h2 class="text-base font-semibold text-slate-900">{title ?? defaultTitle}</h2>
  <p class="mt-1 text-sm text-slate-600">{detail ?? defaultDetail}</p>
  {actionHref && <a href={actionHref} class="mt-4 inline-flex min-h-11 items-center rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">{actionLabel ?? defaultAction}</a>}
  {!actionHref && <p class="mt-4 text-sm font-medium text-slate-700">Next step: {defaultAction}.</p>}
</section>
