---
// Breadcrumbs — shared navigation trail for internal pages. No breadcrumb
// component existed before the lab workspace; this is the smallest shared
// implementation, rendered server-side (crawlable, keyboard-accessible).
// Last item is the current page (aria-current="page").
interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const trail = items.slice(0, -1);
const current = items[items.length - 1];
---
{
  items.length > 0 && (
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-1.5">
        {trail.map((crumb) => (
          <li class="flex items-center gap-1.5">
            <a href={crumb.href} class="text-brand-700 hover:underline">{crumb.label}</a>
            <span aria-hidden="true" class="text-slate-300">/</span>
          </li>
        ))}
        <li aria-current="page" class="font-medium text-slate-700">{current.label}</li>
      </ol>
    </nav>
  )
}
