---
// StatusBadge — reusable status pill (emoji + label) using the app-wide
// 🔴🟡🟠🟢 scheme from src/lib/format.ts. Use on every task list + details page
// so the colors never drift between pages.
import StatusPill from './ui/StatusPill.astro';
import { statusAdapters } from './ui/statusTones';

interface Props {
  status: string;
}

const { status } = Astro.props;
const presentation = statusAdapters.task(status);
---
<StatusPill tone={presentation.tone} label={presentation.label} dot />
