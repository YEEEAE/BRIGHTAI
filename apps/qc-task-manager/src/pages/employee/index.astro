---
// Employee landing page. Lists tasks assigned to or created by the user.
// No dashboard link (CORE BUSINESS RULE #1).
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlashNotice from '../../components/FlashNotice.astro';
import { getDb } from '../../lib/db';
import { canCreateTasks } from '../../lib/permissions';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const db = getDb();

const tasks = db
  .prepare(
    `SELECT id, title, status, priority, progress_percent, due_date
     FROM tasks
     WHERE assigned_to = ? OR created_by = ?
     ORDER BY updated_at DESC
     LIMIT 50`,
  )
  .all(user.userId, user.userId) as {
    id: number;
    title: string;
    status: string;
    priority: string;
    progress_percent: number;
    due_date: string | null;
  }[];

const allowCreate = canCreateTasks({ role: user.role, can_create_tasks: true });
---
<BaseLayout title="My Tasks">
  <FlashNotice />
  <header class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">My tasks</h1>
      <p class="text-sm text-slate-600">Tasks assigned to you or created by you.</p>
    </div>
    {allowCreate && (
      <a href="/employee/new" class="rounded-md bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700">
        New task
      </a>
    )}
  </header>

  {tasks.length === 0 ? (
    <p class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
      No tasks assigned yet.
    </p>
  ) : (
    <ul class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      {tasks.map((t) => (
        <li class="flex items-center justify-between p-4">
          <div>
            <a href={`/tasks/${t.id}`} class="font-medium text-slate-900 hover:underline">{t.title}</a>
            <div class="mt-0.5 text-xs text-slate-500">
              #{t.id} · {t.priority} · {t.progress_percent}%
            </div>
          </div>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{t.status}</span>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
