---
// Employee landing page. Lists tasks assigned to or created by the user.
// No dashboard link (CORE BUSINESS RULE #1).
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getDb } from '../../lib/db';
import { getUserById } from '../../lib/auth';
import { PERMISSIONS } from '../../lib/permissions';
import {
  formatDueDate,
  isOverdue,
  isUrgent,
  priorityLabel,
  priorityBadgeClass,
  URGENT_ROW_CLASS,
} from '../../lib/format';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const db = getDb();

// Session payload has no can_create_tasks, so load the real user row
// (CORE BUSINESS RULE #1: employees create tasks only if can_create_tasks = 1).
const fullUser = getUserById(user.userId);
const allowCreate = fullUser ? PERMISSIONS.canCreateTask(fullUser) : false;

const tasks = db
  .prepare(
    `SELECT id, title, status, priority, progress_percent, due_date, recurrence,
            (SELECT COUNT(*) FROM task_checklists c WHERE c.task_id = t.id) AS checklist_total,
            (SELECT COUNT(*) FROM task_checklists c WHERE c.task_id = t.id AND c.is_completed = 1) AS checklist_completed,
            (SELECT 1 FROM task_delete_requests r
              WHERE r.task_id = t.id AND r.status = 'pending' LIMIT 1) AS delete_pending
     FROM tasks t
     WHERE t.assigned_to = ? OR t.created_by = ?
     ORDER BY t.updated_at DESC
     LIMIT 50`,
  )
  .all(user.userId, user.userId) as {
    id: number;
    title: string;
    status: string;
    priority: string;
    progress_percent: number;
    due_date: string | null;
    recurrence: string;
    checklist_total: number;
    checklist_completed: number;
    delete_pending: number;
  }[];

---
<BaseLayout title="My Tasks">
  <header class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">My tasks</h1>
      <p class="text-sm text-slate-600">Tasks assigned to you or created by you. Signed in as {user.fullName} ({user.role}).</p>
    </div>
    {allowCreate && (
      <a href="/employee/new" class="rounded-md bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700">
        New task
      </a>
    )}
  </header>

  {tasks.length === 0 ? (
    <EmptyState
      title="No tasks yet"
      hint="Tasks assigned to you or created by you will appear here."
      ctaHref={allowCreate ? '/employee/new' : undefined}
      ctaLabel="Create your first task"
    />
  ) : (
    <ul class="divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white shadow-sm">
      {tasks.map((t) => {
        const overdue = isOverdue(t.due_date, t.status);
        const urgent = isUrgent(t.priority);
        return (
          <li class={`flex flex-wrap items-center justify-between gap-3 p-4 ${urgent ? URGENT_ROW_CLASS : 'transition-colors hover:bg-slate-50'}`}>
            <div class="min-w-0">
              <a href={`/tasks/${t.id}`} class="font-medium text-slate-900 hover:underline">{t.title}</a>
              {t.recurrence !== 'none' && <span title="Recurring task" aria-label="Recurring task"> 🔁</span>}
              <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
                <span>#{t.id}</span>
                <span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium ${priorityBadgeClass(t.priority)}`}>
                  {priorityLabel(t.priority)}
                </span>
                {t.due_date && (
                  <span class={overdue ? 'font-semibold text-red-600' : ''}>
                    Due {formatDueDate(t.due_date)}
                    {overdue && ' ⚠️'}
                  </span>
                )}
                <span>
                  <span class="inline-block h-1.5 w-24 overflow-hidden rounded-full bg-slate-200 align-middle">
                    <span class="block h-full rounded-full bg-brand-500" style={`width: ${t.progress_percent}%`}></span>
                  </span>
                  <span class="ml-1 tabular-nums">{t.progress_percent}% <small class="text-slate-400">QC {t.checklist_completed}/{t.checklist_total}</small></span>
                </span>
              </div>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              {t.delete_pending === 1 && (
                <span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">
                  🗑️ Deletion requested
                </span>
              )}
              <StatusBadge status={t.status} />
            </div>
          </li>
        );
      })}
    </ul>
  )}
</BaseLayout>
