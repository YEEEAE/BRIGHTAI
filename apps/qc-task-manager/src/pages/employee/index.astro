---
// Employee landing page. Lists tasks assigned to or created by the user.
// No dashboard link (CORE BUSINESS RULE #1).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import DeleteRequestBadge from '../../components/DeleteRequestBadge.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getDb } from '../../lib/db';
import { getUserById } from '../../lib/auth';
import { PERMISSIONS } from '../../lib/permissions';
import {
  formatDueDate,
  isOverdue,
  isUrgent,
  localDateStr,
  priorityLabel,
  priorityBadgeClass,
  URGENT_ROW_CLASS,
} from '../../lib/format';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const db = getDb();

// Session payload has no can_create_tasks, so load the real user row
// (CORE BUSINESS RULE #1: employees create tasks only if can_create_tasks = 1).
const fullUser = getUserById(user.userId);
const allowCreate = fullUser ? PERMISSIONS.canCreateTask(fullUser) : false;

const tasks = db
  .prepare(
    `SELECT id, title, status, priority, progress_percent, due_date, recurrence,
            (SELECT COUNT(*) FROM task_checklists c WHERE c.task_id = t.id) AS checklist_total,
            (SELECT COUNT(*) FROM task_checklists c WHERE c.task_id = t.id AND c.is_completed = 1) AS checklist_completed,
            (SELECT r.status FROM task_delete_requests r
              WHERE r.task_id = t.id ORDER BY r.id DESC LIMIT 1) AS delete_request_status,
            (SELECT r.review_note FROM task_delete_requests r
              WHERE r.task_id = t.id ORDER BY r.id DESC LIMIT 1) AS delete_request_note
     FROM tasks t
     WHERE t.assigned_to = ? OR t.created_by = ?
     ORDER BY t.updated_at DESC
     LIMIT 50`,
  )
  .all(user.userId, user.userId) as {
    id: number;
    title: string;
    status: string;
    priority: string;
    progress_percent: number;
    due_date: string | null;
    recurrence: string;
    checklist_total: number;
    checklist_completed: number;
    delete_request_status: 'pending' | 'rejected' | string | null;
    delete_request_note: string | null;
  }[];

// "What needs my attention" — personal work signals above the list.
const openTasks = tasks.filter((t) => t.status === 'not_started' || t.status === 'in_progress');
const overdueMine = openTasks.filter((t) => isOverdue(t.due_date, t.status)).length;
const dueTodayMine = openTasks.filter((t) => t.due_date === localDateStr()).length;
const myDraftLabTests = db.prepare(
  'SELECT COUNT(*) AS n FROM lab_test_records WHERE created_by = ? AND status = ?',
).get(user.userId, 'DRAFT') as { n: number };
const myReturnedLabTests = db.prepare(
  'SELECT COUNT(*) AS n FROM lab_test_records WHERE created_by = ? AND status = ?',
).get(user.userId, 'REJECTED') as { n: number };
const myPendingChangeRequests = db.prepare(
  'SELECT COUNT(*) AS n FROM lab_change_requests WHERE requested_by = ? AND status = ?',
).get(user.userId, 'PENDING') as { n: number };

const attention = [
  { label: 'Overdue', n: overdueMine, href: null, tone: overdueMine > 0 ? 'danger' : 'neutral' },
  { label: 'Due today', n: dueTodayMine, href: null, tone: 'neutral' },
  { label: 'Open tasks', n: openTasks.length, href: null, tone: 'neutral' },
  { label: 'My draft tests', n: myDraftLabTests.n, href: '/lab/tests?status=DRAFT', tone: myDraftLabTests.n > 0 ? 'info' : 'neutral' },
  { label: 'Returned for changes', n: myReturnedLabTests.n, href: '/lab/tests?status=REJECTED', tone: myReturnedLabTests.n > 0 ? 'warning' : 'neutral' },
  { label: 'Pending change requests', n: myPendingChangeRequests.n, href: '/lab/change-requests', tone: myPendingChangeRequests.n > 0 ? 'info' : 'neutral' },
] as const;
const attentionTone: Record<string, string> = {
  danger: 'border-red-200 bg-red-50 text-red-700',
  warning: 'border-orange-200 bg-orange-50 text-orange-700',
  info: 'border-sky-200 bg-sky-50 text-sky-700',
  neutral: 'border-slate-200 bg-white text-slate-700',
};
---
<BaseLayout title="My Tasks">
  <div class="space-y-6">
    <PageHeader
      title="My tasks"
      description={`Tasks assigned to you or created by you. Signed in as ${user.fullName} (${user.role}).`}
    >
      <fragment slot="actions">
        {allowCreate && (
          <a href="/employee/new" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">
            New task
          </a>
        )}
      </fragment>
    </PageHeader>

    <section aria-label="Needs my attention" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {attention.map((item) => (
        item.href ? (
          <a
            href={item.href}
            class:list={[
              'rounded-xl border p-4 shadow-sm transition-colors hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600',
              attentionTone[item.tone],
            ]}
          >
            <p class="text-2xl font-semibold tabular-nums">{item.n}</p>
            <p class="mt-0.5 text-sm font-medium">{item.label}</p>
          </a>
        ) : (
          <div class:list={['rounded-xl border p-4 shadow-sm', attentionTone[item.tone]]}>
            <p class="text-2xl font-semibold tabular-nums">{item.n}</p>
            <p class="mt-0.5 text-sm font-medium">{item.label}</p>
          </div>
        )
      ))}
    </section>

    {tasks.length === 0 ? (
      <EmptyState
        title="No tasks yet"
        hint="Tasks assigned to you or created by you will appear here."
        ctaHref={allowCreate ? '/employee/new' : undefined}
        ctaLabel="Create your first task"
      />
    ) : (
      <ul class="divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white shadow-sm">
        {tasks.map((t) => {
          const overdue = isOverdue(t.due_date, t.status);
          const urgent = isUrgent(t.priority);
          return (
            <li class={`flex flex-wrap items-center justify-between gap-3 p-4 ${urgent ? URGENT_ROW_CLASS : 'transition-colors hover:bg-slate-50/75'}`}>
              <div class="min-w-0">
                <a href={`/tasks/${t.id}`} class="font-medium text-slate-900 hover:underline">{t.title}</a>
                {t.recurrence !== 'none' && <span title="Recurring task" aria-label="Recurring task"> 🔁</span>}
                <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
                  <span class="tabular-nums">#{t.id}</span>
                  <span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium ${priorityBadgeClass(t.priority)}`}>
                    {priorityLabel(t.priority)}
                  </span>
                  {t.due_date && (
                    <span class={overdue ? 'font-semibold text-red-600' : ''}>
                      Due {formatDueDate(t.due_date)}
                      {overdue && ' ⚠️'}
                    </span>
                  )}
                  <span>
                    <span class="inline-block h-1.5 w-24 overflow-hidden rounded-full bg-slate-200 align-middle">
                      {/* SVG width attribute instead of inline style (CSP style-src 'self'). */}
                      <svg class="block h-full w-full" aria-hidden="true">
                        <rect x="0" y="0" width={`${t.progress_percent}%`} height="100%" fill="#3b82f6" rx="9999" />
                      </svg>
                    </span>
                    <span class="ml-1 tabular-nums">{t.progress_percent}% <small class="text-slate-500">QC {t.checklist_completed}/{t.checklist_total}</small></span>
                  </span>
                </div>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                <DeleteRequestBadge status={t.delete_request_status} reason={t.delete_request_note} />
                <StatusBadge status={t.status} />
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</BaseLayout>
