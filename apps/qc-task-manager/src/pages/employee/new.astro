---
// New task form (employee). Employees may only assign the task to themselves
// or leave it unassigned (product decision #1), and may NOT manage
// dependencies. Business fields the employee sets here become LOCKED after
// creation (they cannot edit title/description/assignee/due/priority/etc.
// later — canEditLockedField). The page itself is gated by canCreateTask so
// an employee without the flag is bounced away.
//
// GET renders the form; POST is short-circuited in src/middleware.ts which
// calls handleCreateTaskPost with assignmentScope 'self'.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewTaskForm from '../../components/NewTaskForm.astro';
import { getUserById } from '../../lib/auth';
import { PERMISSIONS } from '../../lib/permissions';
import { listTemplates } from '../../lib/templatesStore';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const fullUser = getUserById(user.userId);
const templates = listTemplates({ status: 'ACTIVE' }).map((t) => ({ id: t.id, title: t.title, code: t.code }));

// Gate: employees create tasks only if can_create_tasks = 1 (CORE BUSINESS RULE #1).
// Non-employees posting here are bounced by the middleware; keep the GET
// consistent so a manager/admin/supervisor lands on their own new-task page.
if (!fullUser || !PERMISSIONS.canCreateTask(fullUser)) {
  return Astro.redirect(roleHome(user.role));
}
if (user.role !== 'employee') {
  return Astro.redirect(user.role === 'admin' || user.role === 'manager' ? '/manager/new' : '/supervisor/new');
}
---

<BaseLayout title="New task">
  <div class="mx-auto max-w-2xl">
    <header class="mb-6">
      <a href="/employee" class="text-sm font-medium text-brand-600 hover:underline">&larr; Back to my tasks</a>
      <h1 class="mt-2 text-2xl font-semibold text-slate-900">New task</h1>
      <p class="text-sm text-slate-600">Create a task as {user.fullName} ({user.role}).</p>
    </header>

    <NewTaskForm
      action="/employee/new"
      users={[{ id: user.userId, full_name: user.fullName, role: user.role }]}
      selfAssignOnly={true}
      templates={templates}
    />
  </div>
</BaseLayout>
