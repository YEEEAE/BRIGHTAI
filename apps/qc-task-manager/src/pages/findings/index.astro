---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QcStatusBadge from '../../components/QcStatusBadge.astro';
import { listFindings } from '../../lib/qc-operations';
import { getDb } from '../../lib/db';
import { canManageFinding } from '../../lib/permissions';
import { FINDING_CLASSIFICATIONS, FINDING_STATUSES } from '../../lib/findings';

const user = Astro.locals.user!;
const status = Astro.url.searchParams.get('status') || undefined;
const classification = Astro.url.searchParams.get('classification') || undefined;
// Pre-fill hooks (e.g. the lab repeated-failures notification deep-link):
// only these three whitelisted fields are read, trimmed and length-capped —
// never trusted beyond pre-filling the form; submission still goes through
// findingCreateSchema server-side.
const prefill = {
  inspection_type: (Astro.url.searchParams.get('inspection_type') || '').slice(0, 200),
  requirement_reference: (Astro.url.searchParams.get('requirement_reference') || '').slice(0, 300),
  risk_description: (Astro.url.searchParams.get('risk_description') || '').slice(0, 2000),
};
const findings = listFindings({ status, classification, owner: user.role === 'employee' ? user.userId : undefined }).filter((finding) => canManageFinding({ id: user.userId, role: user.role }, finding));
const tasks = getDb().prepare('SELECT id, title FROM tasks ORDER BY id DESC LIMIT 200').all() as { id: number; title: string }[];
const owners = getDb().prepare("SELECT id, full_name FROM users WHERE is_active=1 ORDER BY full_name").all() as { id: number; full_name: string }[];
---
<BaseLayout title="QC Findings">
  <div class="space-y-6">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div><p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Operations</p><h1 class="mt-1 text-3xl font-semibold text-slate-900">Findings</h1><p class="mt-1 text-sm text-slate-600">Track observations, nonconformities, corrective actions, and closure gates.</p></div>
      <a href="#new-finding" class="rounded-md bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">New Finding</a>
    </header>

    <form method="get" class="flex flex-wrap items-end gap-3 rounded-xl border border-slate-200 bg-white p-4">
      <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">Status<select name="status" class="rounded-md border border-slate-300 px-3 py-2 text-sm"><option value="">All</option>{FINDING_STATUSES.map((value) => <option value={value} selected={status === value}>{value}</option>)}</select></label>
      <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">Classification<select name="classification" class="rounded-md border border-slate-300 px-3 py-2 text-sm"><option value="">All</option>{FINDING_CLASSIFICATIONS.map((value) => <option value={value} selected={classification === value}>{value}</option>)}</select></label>
      <button class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium hover:bg-slate-50">Filter</button>
    </form>

    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" aria-label="Findings list">
      {findings.length === 0 ? <div class="p-10 text-center text-sm text-slate-500">No Findings match these filters.</div> : <div class="overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-3">Number</th><th class="px-4 py-3">Task</th><th class="px-4 py-3">Classification</th><th class="px-4 py-3">Severity</th><th class="px-4 py-3">Owner</th><th class="px-4 py-3">Due</th><th class="px-4 py-3">Status</th></tr></thead><tbody class="divide-y divide-slate-100">{findings.map((finding) => <tr class="hover:bg-slate-50"><td class="px-4 py-3 font-semibold"><a class="text-brand-700 hover:underline" href={`/findings/${finding.id}`}>{String(finding.finding_number)}</a></td><td class="px-4 py-3">{String(finding.task_title)}</td><td class="px-4 py-3 capitalize">{String(finding.classification)}</td><td class="px-4 py-3 capitalize">{String(finding.severity)}</td><td class="px-4 py-3">{String(finding.owner_name)}</td><td class="px-4 py-3">{String(finding.due_date ?? '—')}</td><td class="px-4 py-3"><QcStatusBadge status={String(finding.status)} /></td></tr>)}</tbody></table></div>}
    </section>

    <section id="new-finding" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold text-slate-900">Create QC Finding</h2><form method="post" action="/api/findings" class="mt-4 grid gap-4 md:grid-cols-2">
      <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Finding number<input required name="finding_number" placeholder="F-2026-0001" class="rounded-md border border-slate-300 px-3 py-2" /></label>
      <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Task<select required name="task_id" class="rounded-md border border-slate-300 px-3 py-2">{tasks.map((task) => <option value={task.id}>#{task.id} — {task.title}</option>)}</select></label>
      <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Inspection type<input required name="inspection_type" value={prefill.inspection_type} placeholder="Internal audit" class="rounded-md border border-slate-300 px-3 py-2" /></label>
      <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Owner<select name="owner" required class="rounded-md border border-slate-300 px-3 py-2">{owners.map((owner) => <option value={owner.id} selected={owner.id === user.userId}>{owner.full_name}</option>)}</select></label>
      <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Classification<select name="classification" class="rounded-md border border-slate-300 px-3 py-2">{FINDING_CLASSIFICATIONS.map((value) => <option value={value}>{value}</option>)}</select></label>
      <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Severity<select name="severity" class="rounded-md border border-slate-300 px-3 py-2"><option>low</option><option>medium</option><option>high</option><option>critical</option></select></label>
      <label class="flex flex-col gap-1 text-sm font-medium text-slate-700 md:col-span-2">Risk description<textarea required name="risk_description" rows="3" class="rounded-md border border-slate-300 px-3 py-2">{prefill.risk_description}</textarea></label>
      <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Requirement reference<input name="requirement_reference" value={prefill.requirement_reference} class="rounded-md border border-slate-300 px-3 py-2" /></label>
      <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Due date<input type="date" name="due_date" class="rounded-md border border-slate-300 px-3 py-2" /></label>
      <button class="md:col-span-2 rounded-md bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">Create Finding</button>
    </form></section>
  </div>
</BaseLayout>
