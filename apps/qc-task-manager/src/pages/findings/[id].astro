---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QcStatusBadge from '../../components/QcStatusBadge.astro';
import { getFinding } from '../../lib/qc-operations';
import { canManageFinding, canApproveFinding } from '../../lib/permissions';
import { RCA_METHODS, FISHBONE_CATEGORIES } from '../../lib/findings';
import { CAPA_STATUSES } from '../../lib/capa';
import AiReviewPanel from '../../components/AiReviewPanel';
const user = Astro.locals.user!;
const id = Number(Astro.params.id); const finding = Number.isInteger(id) && id > 0 ? getFinding(id) : undefined;
if (!finding) Astro.response.status = 404;
const permitted = !!finding && canManageFinding({ id: user.userId, role: user.role }, finding);
if (finding && !permitted) Astro.response.status = 403;
const capa = finding?.capa;
const criticalGates = finding?.classification === 'critical' ? [!!capa, !!capa?.corrective_action, !!capa?.evidence, !!capa?.effectiveness_check, !!capa?.approval, ['EFFECTIVE','CLOSED'].includes(String(capa?.status))] : [];
---
{!finding ? <BaseLayout title="Finding not found"><section class="py-16 text-center"><h1 class="text-3xl font-semibold">404 — Finding not found</h1><a href="/findings" class="mt-6 inline-block text-brand-700 hover:underline">Back to Findings</a></section></BaseLayout> : !permitted ? <BaseLayout title="Forbidden"><section class="py-16 text-center"><h1 class="text-3xl font-semibold">403 — Forbidden</h1><p class="mt-2 text-slate-600">Employees can access assigned Findings only.</p></section></BaseLayout> : <BaseLayout title={`${finding.finding_number} · QC Finding`}>
  <div class="space-y-6">
    <Breadcrumbs items={[{ label: 'QC Tasks' }, { label: 'Findings', href: '/findings' }, { label: String(finding.finding_number) }]} />
    <header class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><a href="/findings" class="text-sm text-brand-700 hover:underline">← All Findings</a><div class="mt-3 flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Finding</p><h1 class="mt-1 text-3xl font-semibold">{String(finding.finding_number)}</h1><p class="mt-1 text-sm text-slate-600">Task #{String(finding.task_id)} — {String(finding.task_title)}</p></div><div class="flex gap-2"><QcStatusBadge status={String(finding.status)} /><span class="rounded-full bg-red-50 px-3 py-1 text-xs font-semibold capitalize text-red-700">{String(finding.classification)} / {String(finding.severity)}</span></div></div><dl class="mt-5 grid gap-4 text-sm sm:grid-cols-3"><div><dt class="text-slate-500">Inspection type</dt><dd class="font-medium">{String(finding.inspection_type)}</dd></div><div><dt class="text-slate-500">Owner</dt><dd class="font-medium">{String(finding.owner_name)}</dd></div><div><dt class="text-slate-500">Due date</dt><dd class="font-medium">{String(finding.due_date ?? '—')}</dd></div><div class="sm:col-span-3"><dt class="text-slate-500">Risk description</dt><dd class="mt-1 whitespace-pre-wrap font-medium">{String(finding.risk_description)}</dd></div></dl></header>
    <AiReviewPanel feature="finding-analysis" requestBody={{ id: finding.id }} title="Finding Analysis" client:visible />
    <AiReviewPanel feature="rca-assistance" requestBody={{ id: finding.id }} title="RCA Assistance" client:visible />
    <AiReviewPanel feature="capa-assistance" requestBody={{ id: finding.id }} title="CAPA Assistance" client:visible />

    {finding.classification === 'critical' && <section class="rounded-xl border border-red-200 bg-red-50 p-5"><h2 class="font-semibold text-red-900">Critical closure gate</h2><p class="mt-1 text-sm text-red-800">Critical Findings cannot close directly. Corrective action, evidence, verification, and approval are required.</p><div class="mt-4 grid gap-2 text-sm sm:grid-cols-3">{['CAPA exists','Action complete','Evidence','Effectiveness review','Approval','CAPA effective'].map((label, index) => <span class={`rounded-md px-3 py-2 ${criticalGates[index] ? 'bg-emerald-100 text-emerald-800' : 'bg-white text-red-800'}`}>{criticalGates[index] ? '✓' : '○'} {label}</span>)}</div></section>}

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold">Status & Approval</h2><div class="mt-4 flex flex-wrap gap-2"><form method="post" action={`/api/findings/${finding.id}`}><input type="hidden" name="action" value="status" /><input type="hidden" name="status" value="UNDER_REVIEW" /><button class="rounded-md border px-3 py-2 text-sm hover:bg-slate-50">Under review</button></form><form method="post" action={`/api/findings/${finding.id}`}><input type="hidden" name="action" value="status" /><input type="hidden" name="status" value="ACTION_REQUIRED" /><button class="rounded-md border px-3 py-2 text-sm hover:bg-slate-50">Action required</button></form>{canApproveFinding(user.role) && <form method="post" action={`/api/findings/${finding.id}`}><input type="hidden" name="action" value="approve" /><button class="rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white">Approve verification</button></form>}<form class="flex gap-2" method="post" action={`/api/findings/${finding.id}`}><input type="hidden" name="action" value="close" /><input required name="closure_evidence" placeholder="Closure evidence" class="rounded-md border px-3 py-2 text-sm" /><button class="rounded-md bg-emerald-600 px-3 py-2 text-sm font-semibold text-white">Close Finding</button></form><form method="post" action={`/api/findings/${finding.id}`}><input type="hidden" name="action" value="reopen" /><button class="rounded-md border border-amber-300 px-3 py-2 text-sm text-amber-800">Reopen</button></form></div></section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold">Timeline</h2>{finding.audit.length === 0 ? <p class="mt-3 text-sm text-slate-500">No timeline entries yet.</p> : <ol class="mt-4 space-y-3">{finding.audit.map((event) => <li class="border-l-2 border-slate-200 pl-4 text-sm"><div class="font-medium">{String(event.action)} <span class="font-normal text-slate-500">by {String(event.actor_name)}</span></div><time class="text-xs text-slate-500">{String(event.created_at)}</time></li>)}</ol>}</section>

    <section class="grid gap-6 lg:grid-cols-2"><div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold">RCA</h2><p class="mt-1 text-sm text-slate-500">Use 5 Whys, Fishbone, or free-form analysis.</p><form method="post" action={`/api/findings/${finding.id}/rca`} class="mt-4 space-y-3"><select name="method" class="w-full rounded-md border px-3 py-2">{RCA_METHODS.map((method) => <option value={method} selected={finding.rca?.method === method}>{method}</option>)}</select><textarea name="free_form" rows="4" placeholder="Root cause analysis" class="w-full rounded-md border px-3 py-2">{String(finding.rca?.free_form ?? '')}</textarea><details><summary class="cursor-pointer text-sm font-medium">Fishbone categories</summary><div class="mt-2 grid grid-cols-2 gap-2 text-xs">{FISHBONE_CATEGORIES.map((category) => <label class="rounded bg-slate-50 p-2"><input type="checkbox" name="fishbone_json" value={category} /> {category}</label>)}</div></details><button class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Save RCA</button></form></div>
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold">CAPA</h2>{capa && <div class="mb-3"><QcStatusBadge status={String(capa.status)} /><p class="mt-2 text-sm text-slate-600">Owner: {String(capa.owner_name)}</p></div>}<form method="post" action={`/api/findings/${finding.id}/capa`} class="space-y-3"><input required name="problem_statement" value={String(capa?.problem_statement ?? finding.risk_description)} placeholder="Problem statement" class="w-full rounded-md border px-3 py-2" /><input required name="root_cause" value={String(capa?.root_cause ?? '')} placeholder="Root cause" class="w-full rounded-md border px-3 py-2" /><textarea required name="corrective_action" rows="2" placeholder="Corrective action" class="w-full rounded-md border px-3 py-2">{String(capa?.corrective_action ?? '')}</textarea><textarea required name="preventive_action" rows="2" placeholder="Preventive action" class="w-full rounded-md border px-3 py-2">{String(capa?.preventive_action ?? '')}</textarea><input name="owner" type="number" required value={String(capa?.owner ?? finding.owner)} class="w-full rounded-md border px-3 py-2" /><input name="due_date" type="date" value={String(capa?.due_date ?? '')} class="w-full rounded-md border px-3 py-2" /><textarea name="evidence" rows="2" placeholder="Evidence" class="w-full rounded-md border px-3 py-2">{String(capa?.evidence ?? '')}</textarea><textarea name="effectiveness_check" rows="2" placeholder="Effectiveness review" class="w-full rounded-md border px-3 py-2">{String(capa?.effectiveness_check ?? '')}</textarea><button class="rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Save CAPA</button></form>{capa && <div class="mt-4 flex flex-wrap gap-2">{CAPA_STATUSES.filter((status) => status !== 'DRAFT').map((status) => <form method="post" action={`/api/findings/${finding.id}/capa`}><input type="hidden" name="status" value={status} /><input type="hidden" name="decision" value={status === 'EFFECTIVE' || status === 'CLOSED' ? 'Approved' : ''} /><button class="rounded-md border px-2 py-1 text-xs hover:bg-slate-50">{status}</button></form>)}</div>}</div></section>

    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold">Evidence</h2><ul class="mt-3 space-y-2 text-sm">{finding.evidence.map((item) => <li class="rounded-md bg-slate-50 p-3"><strong>{String(item.description)}</strong><span class="ml-2 text-slate-500">{String(item.reference ?? '')}</span></li>)}</ul><form method="post" action={`/api/findings/${finding.id}/evidence`} class="mt-4 flex flex-wrap gap-2"><input required name="description" placeholder="Evidence description" class="min-w-[240px] flex-1 rounded-md border px-3 py-2 text-sm" /><input name="reference" placeholder="Reference / link" class="rounded-md border px-3 py-2 text-sm" /><button class="rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white">Add evidence</button></form></section>
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-semibold">Audit</h2><p class="mt-1 text-sm text-slate-500">Every create, update, status transition, approval, rejection, closure, and reopen is recorded.</p><div class="mt-4 overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="text-xs uppercase text-slate-500"><tr><th class="py-2 pr-4">Action</th><th class="py-2 pr-4">Actor</th><th class="py-2">Time</th></tr></thead><tbody>{finding.audit.map((event) => <tr class="border-t"><td class="py-2 pr-4 font-medium">{String(event.action)}</td><td class="py-2 pr-4">{String(event.actor_name)}</td><td class="py-2 text-slate-500">{String(event.created_at)}</td></tr>)}</tbody></table></div></section>
  </div>
</BaseLayout>}
