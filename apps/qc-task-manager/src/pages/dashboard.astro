---
// Dashboard — manager/supervisor/admin ONLY (employees are redirected by the
// middleware with a flash message; CORE BUSINESS RULE #1).
//
// All numbers come from src/lib/dashboard.ts — read-only, fully parameterized
// SELECT queries. Filters (?range&from&to&assignee&priority&status&overdue)
// are validated in parseDashboardFilters and scoped over the same WHERE clause
// for every widget (KPI cards, charts, tables).
//
// Loading state: the filter <form> submission shows a full-screen overlay via
// a CSP-safe Astro <script> (compiled to an external module — no inline JS).
// Error state: a top-level try/catch renders a friendly banner instead of a
// 500, keeping the shell (navbar + filters) usable.
import BaseLayout from '../layouts/BaseLayout.astro';
import DashboardCharts from '../components/DashboardCharts';
import LabDashboardCharts from '../components/LabDashboardCharts';
import EmptyState from '../components/EmptyState.astro';
import { formatDbDate, formatDueDate, statusLabel, priorityLabel } from '../lib/format';
import { describeAction } from '../lib/taskDetails';
import * as dash from '../lib/dashboard';
import { getLabDashboardData, LAB_DASHBOARD_DRILLDOWNS, type LabDashboardData } from '../lib/lab/dashboard';
import { buildKpiHref, type DashboardKpiKey } from '../lib/reporting/drilldown';
import { emptyReportFilters, parseReportFilters } from '../lib/reporting/filters';
import { FINDING_CLASSIFICATIONS, RISK_LEVELS } from '../lib/task-policy';
import { SLA_STATUSES } from '../lib/sla';
import { getUserById } from '../lib/auth';
import { getKpiSnapshot } from '../lib/reporting/queries';
import { resolveReportScope } from '../lib/reporting/scope';
import AiReviewPanel from '../components/AiReviewPanel';

const user = Astro.locals.user!; // protected route — middleware guarantees a session + role

// Pretty-print an "average completion time" in seconds as e.g. "2d 6h".
function formatDuration(seconds: number | null): string {
  if (seconds === null || !Number.isFinite(seconds)) return '—';
  if (seconds < 60) return '< 1m';
  const minutes = Math.round(seconds / 60);
  if (minutes < 60) return `${minutes}m`;
  const hours = Math.round(minutes / 60);
  if (hours < 24) return `${hours}h`;
  const days = Math.floor(hours / 24);
  const remHours = hours % 24;
  return remHours === 0 ? `${days}d` : `${days}d ${remHours}h`;
}

function formatPercent(value: number | null): string {
  return value === null || !Number.isFinite(value) ? '—' : `${value.toFixed(1)}%`;
}

const filters = dash.parseDashboardFilters(Astro.url, Astro);
const filtered = dash.hasActiveFilters(filters);

// Every query is wrapped so a transient DB hiccup renders a banner rather than
// a raw 500 — the shell stays usable and the user can adjust filters / retry.
let dataError: string | null = null;
let kpis: ReturnType<typeof dash.getKpis> | null = null;
let donut: ReturnType<typeof dash.getStatusDistribution> = [];
let priorityDist: ReturnType<typeof dash.getPriorityDistribution> = [];
let bar: ReturnType<typeof dash.getPerEmployee> = [];
let overdueByEmployee: ReturnType<typeof dash.getOverdueByEmployee> = [];
let line: ReturnType<typeof dash.getCompletedPerWeek> = [];
let completionRate: ReturnType<typeof dash.getCompletionRate> | null = null;
let checklistCompletion = { completed: 0, total: 0, percent: 0 };
let overdue: ReturnType<typeof dash.getOverdueTasks> = [];
let recent: ReturnType<typeof dash.getRecentlyCompleted> = [];
let withoutEvidence: ReturnType<typeof dash.getCompletedWithoutEvidence> = [];
let blockers: ReturnType<typeof dash.getCurrentBlockers> = [];
let activity: ReturnType<typeof dash.getLatestActivity> = [];
let reportKpis: ReturnType<typeof getKpiSnapshot> | null = null;
let lab: LabDashboardData | null = null;

try {
  kpis = dash.getKpis(filters);
  donut = dash.getStatusDistribution(filters);
  priorityDist = dash.getPriorityDistribution(filters);
  bar = dash.getPerEmployee(filters);
  overdueByEmployee = dash.getOverdueByEmployee(filters);
  line = dash.getCompletedPerWeek(filters);
  completionRate = dash.getCompletionRate(filters);
  checklistCompletion = dash.getChecklistCompletion(filters);
  overdue = dash.getOverdueTasks(filters);
  recent = dash.getRecentlyCompleted(filters);
  withoutEvidence = dash.getCompletedWithoutEvidence(filters);
  blockers = dash.getCurrentBlockers(filters);
  activity = dash.getLatestActivity(filters);
} catch (err) {
  console.error('[dashboard] query failure', err);
  dataError =
    'Could not load the dashboard data. Try clearing filters or reloading — if the problem persists, contact an administrator.';
}

// Laboratory integration (PROMPT 28) — separate try/catch: a lab query failure
// must NOT take down the core dashboard; each side degrades independently.
let labError: string | null = null;
try {
  lab = getLabDashboardData();
} catch (err) {
  console.error('[dashboard] lab query failure', err);
  labError =
    'Could not load the laboratory metrics. The Laboratory section is temporarily unavailable — the rest of the dashboard is unaffected.';
}

const assignees = dash.listActiveUsers();
const supervisors = assignees.filter((person) => person.role === 'supervisor');
let reportFilters = emptyReportFilters;
try {
  reportFilters = parseReportFilters(Astro.url.searchParams);
} catch {
  // The legacy dashboard parser owns the flash message; keep the page usable
  // when a report-only filter is invalid.
}
const reportActor = getUserById(user.userId);
if (reportActor) {
  try {
    reportKpis = getKpiSnapshot(reportFilters, resolveReportScope({ id: reportActor.id, role: reportActor.role, department: reportActor.department }, reportFilters));
  } catch (err) {
    console.error('[dashboard] reporting KPI query failure', err);
  }
}
const kpiParams = new URLSearchParams(Astro.url.searchParams);
const kpiHref = (key: DashboardKpiKey) => buildKpiHref(key, kpiParams);
const kpiCards = kpis
  ? [
      { id: 'total', key: 'total' as DashboardKpiKey, label: 'Total Tasks', value: kpis.total, tone: 'border-slate-200 bg-white text-slate-900', icon: '📋' },
      { id: 'not_started', key: 'total' as DashboardKpiKey, label: 'Not Started', value: kpis.not_started, tone: 'border-red-200 bg-red-50/60 text-red-700', icon: '🔴' },
      { id: 'in_progress', key: 'total' as DashboardKpiKey, label: 'In Progress', value: kpis.in_progress, tone: 'border-amber-200 bg-amber-50/70 text-amber-700', icon: '🟡' },
      { id: 'on_hold', key: 'on_hold' as DashboardKpiKey, label: 'On Hold', value: kpis.on_hold, tone: 'border-orange-200 bg-orange-50/70 text-orange-700', icon: '🟠' },
      { id: 'completed', key: 'completion_rate' as DashboardKpiKey, label: 'Completed', value: kpis.completed, tone: 'border-green-200 bg-green-50/70 text-green-700', icon: '🟢' },
      { id: 'overdue', key: 'overdue' as DashboardKpiKey, label: 'Overdue', value: kpis.overdue, tone: 'border-rose-200 bg-rose-50 text-rose-700', icon: '⚠️' },
      { id: 'urgent_open', key: 'total' as DashboardKpiKey, label: 'Urgent Open', value: kpis.urgent_open, tone: 'border-red-300 bg-red-100 text-red-800', icon: '🚨' },
      { id: 'completed_without_evidence', key: 'evidence_compliance' as DashboardKpiKey, label: 'Completed Without Evidence', value: kpis.completed_without_evidence, tone: 'border-slate-200 bg-white text-slate-900', icon: '📎' },
      { id: 'avg_completion_time', key: 'average_resolution' as DashboardKpiKey, label: 'Average Completion Time', value: formatDuration(kpis.avg_completion_seconds), tone: 'border-slate-200 bg-white text-slate-900', icon: '⏱️' },
      { id: 'sla_compliance', key: 'sla_compliance' as DashboardKpiKey, label: 'SLA Compliance', value: formatPercent(kpis.sla_compliance_percent), tone: 'border-emerald-200 bg-emerald-50 text-emerald-700', icon: '✅' },
      { id: 'sla_at_risk', key: 'sla_compliance' as DashboardKpiKey, label: 'At Risk', value: kpis.sla_at_risk, tone: 'border-amber-200 bg-amber-50 text-amber-700', icon: '⚠️' },
      { id: 'sla_critical', key: 'critical_findings' as DashboardKpiKey, label: 'Critical', value: kpis.sla_critical, tone: 'border-orange-200 bg-orange-50 text-orange-700', icon: '🔥' },
      { id: 'sla_breached', key: 'sla_breached' as DashboardKpiKey, label: 'SLA Breached', value: kpis.sla_breached, tone: 'border-rose-200 bg-rose-50 text-rose-700', icon: '🚨' },
      { id: 'avg_resolution', key: 'average_resolution' as DashboardKpiKey, label: 'Average Resolution', value: formatDuration(kpis.avg_completion_seconds), tone: 'border-slate-200 bg-white text-slate-900', icon: '⏱️' },
      { id: 'avg_sla_consumption', key: 'sla_compliance' as DashboardKpiKey, label: 'Average SLA Consumption', value: formatPercent(kpis.avg_sla_consumption_percent), tone: 'border-violet-200 bg-violet-50 text-violet-700', icon: '📊' },
      ...(reportKpis ? [
        { id: 'completion_rate', key: 'completion_rate' as DashboardKpiKey, label: 'Completion Rate', value: formatPercent(reportKpis.completion_rate), tone: 'border-green-200 bg-green-50 text-green-700', icon: '📈' },
        { id: 'critical_findings', key: 'critical_findings' as DashboardKpiKey, label: 'Critical Findings', value: reportKpis.critical_findings, tone: 'border-red-200 bg-red-50 text-red-700', icon: '🔎' },
        { id: 'open_capa', key: 'open_capa' as DashboardKpiKey, label: 'Open CAPA', value: reportKpis.open_capa, tone: 'border-violet-200 bg-violet-50 text-violet-700', icon: '🧩' },
        { id: 'evidence_compliance', key: 'evidence_compliance' as DashboardKpiKey, label: 'Evidence Compliance', value: formatPercent(reportKpis.evidence_compliance), tone: 'border-cyan-200 bg-cyan-50 text-cyan-700', icon: '📎' },
      ] : []),
    ]
  : [];

// ───────────── Laboratory KPI groups (PROMPT 28) ─────────────
// Every card is a drill-down link into the matching filtered /lab/* register
// (LAB_DASHBOARD_DRILLDOWNS). Values come from the read-only lab query module;
// the section degrades to an error banner if the lab queries fail.
interface LabCard {
  id: string;
  label: string;
  value: number;
  tone: string;
  icon: string;
}
interface LabGroup {
  title: string;
  cards: LabCard[];
}

const labHref = (id: string) => LAB_DASHBOARD_DRILLDOWNS[id] ?? '/lab';

const labGroups: LabGroup[] = lab
  ? [
      {
        title: 'Tests',
        cards: [
          { id: 'lab_total_tests', label: 'Total Tests', value: lab.tests.total, tone: 'border-slate-200 bg-white text-slate-900', icon: '🧪' },
          { id: 'lab_tests_air', label: 'AIR', value: lab.tests.air, tone: 'border-sky-200 bg-sky-50/70 text-sky-700', icon: '💨' },
          { id: 'lab_tests_vacuum', label: 'VACUUM', value: lab.tests.vacuum, tone: 'border-indigo-200 bg-indigo-50/70 text-indigo-700', icon: '🌑' },
          { id: 'lab_tests_draft', label: 'Draft', value: lab.tests.draft, tone: 'border-slate-200 bg-white text-slate-900', icon: '✏️' },
          { id: 'lab_tests_submitted', label: 'Submitted', value: lab.tests.submitted, tone: 'border-blue-200 bg-blue-50/70 text-blue-700', icon: '📤' },
          { id: 'lab_tests_under_review', label: 'Under Review', value: lab.tests.under_review, tone: 'border-amber-200 bg-amber-50/70 text-amber-700', icon: '🔎' },
          { id: 'lab_tests_approved', label: 'Approved', value: lab.tests.approved, tone: 'border-green-200 bg-green-50/70 text-green-700', icon: '✅' },
          { id: 'lab_tests_rejected', label: 'Rejected', value: lab.tests.rejected, tone: 'border-rose-200 bg-rose-50 text-rose-700', icon: '❌' },
          { id: 'lab_tests_void', label: 'Void', value: lab.tests.void, tone: 'border-slate-200 bg-white text-slate-900', icon: '🚫' },
        ],
      },
      {
        title: 'Results',
        cards: [
          { id: 'lab_result_pass', label: 'PASS', value: lab.results.pass, tone: 'border-green-200 bg-green-50/70 text-green-700', icon: '🟢' },
          { id: 'lab_result_fail', label: 'FAIL', value: lab.results.fail, tone: 'border-red-200 bg-red-50/60 text-red-700', icon: '🔴' },
          { id: 'lab_result_hold', label: 'HOLD', value: lab.results.hold, tone: 'border-amber-200 bg-amber-50/70 text-amber-700', icon: '🟠' },
        ],
      },
      {
        title: 'Equipment',
        cards: [
          { id: 'lab_equipment_active', label: 'In Use', value: lab.equipment.active, tone: 'border-green-200 bg-green-50/70 text-green-700', icon: '🟢' },
          { id: 'lab_equipment_new', label: 'New', value: lab.equipment.fresh, tone: 'border-sky-200 bg-sky-50/70 text-sky-700', icon: '🆕' },
          { id: 'lab_equipment_maintenance', label: 'Under Maintenance', value: lab.equipment.maintenance, tone: 'border-amber-200 bg-amber-50/70 text-amber-700', icon: '🔧' },
          { id: 'lab_equipment_unused', label: 'Not In Use', value: lab.equipment.unused, tone: 'border-slate-200 bg-white text-slate-900', icon: '📦' },
          { id: 'lab_calibration_attention', label: 'Calibration Attention', value: lab.equipment.calibration_attention, tone: 'border-rose-200 bg-rose-50 text-rose-700', icon: '⚠️' },
          { id: 'lab_calibration_compliant', label: 'Cal. Compliant', value: lab.equipment.calibration_compliant, tone: 'border-emerald-200 bg-emerald-50 text-emerald-700', icon: '✅' },
        ],
      },
      {
        title: 'Documents',
        cards: [
          { id: 'lab_doc_sop', label: 'SOP', value: lab.documents.sop, tone: 'border-blue-200 bg-blue-50/70 text-blue-700', icon: '📕' },
          { id: 'lab_doc_wi', label: 'WI', value: lab.documents.wi, tone: 'border-cyan-200 bg-cyan-50 text-cyan-700', icon: '📙' },
          { id: 'lab_doc_draft', label: 'Draft', value: lab.documents.draft, tone: 'border-slate-200 bg-white text-slate-900', icon: '✏️' },
          { id: 'lab_doc_review', label: 'In Review', value: lab.documents.in_review, tone: 'border-amber-200 bg-amber-50/70 text-amber-700', icon: '🔎' },
          { id: 'lab_doc_approved', label: 'Approved', value: lab.documents.approved, tone: 'border-green-200 bg-green-50/70 text-green-700', icon: '✅' },
          { id: 'lab_doc_superseded', label: 'Superseded', value: lab.documents.superseded, tone: 'border-violet-200 bg-violet-50 text-violet-700', icon: '🔁' },
          { id: 'lab_doc_archived', label: 'Archived', value: lab.documents.archived, tone: 'border-slate-200 bg-white text-slate-900', icon: '🗄️' },
          { id: 'lab_doc_review_due', label: 'Review Due', value: lab.documents.review_due, tone: 'border-rose-200 bg-rose-50 text-rose-700', icon: '⏰' },
          { id: 'lab_ack_pending', label: 'Ack Pending', value: lab.documents.ack_pending, tone: 'border-amber-200 bg-amber-50/70 text-amber-700', icon: '🖊️' },
        ],
      },
      {
        title: 'Retests',
        cards: [
          { id: 'lab_retests_total', label: 'Total Retests', value: lab.retests.total, tone: 'border-slate-200 bg-white text-slate-900', icon: '🔁' },
          { id: 'lab_retests_open', label: 'Open', value: lab.retests.open, tone: 'border-amber-200 bg-amber-50/70 text-amber-700', icon: '🟠' },
          { id: 'lab_retests_completed', label: 'Completed', value: lab.retests.completed, tone: 'border-green-200 bg-green-50/70 text-green-700', icon: '✅' },
          ...lab.retests.by_reason.map((r) => ({
            id: `lab_retests_reason_${r.key}`,
            label: r.label,
            value: r.count,
            tone: 'border-slate-200 bg-white text-slate-900',
            icon: '📝',
          })),
        ],
      },
      {
        title: 'Data Quality',
        cards: [
          { id: 'lab_data_quality', label: 'Open Issues', value: lab.data_quality_open, tone: lab.data_quality_open > 0 ? 'border-rose-200 bg-rose-50 text-rose-700' : 'border-emerald-200 bg-emerald-50 text-emerald-700', icon: '🧹' },
        ],
      },
    ]
  : [];
---

<BaseLayout title="Dashboard">
  <header class="mb-6">
    <h1 class="text-2xl font-semibold text-slate-900">Dashboard</h1>
    <p class="text-sm text-slate-600">
      Live overview of all QC tasks. Signed in as {user.fullName} ({user.role}).
    </p>
  </header>

  {/* ───────────── Filters (GET — server-side, every query stays parameterized) ───────────── */}
  <form
    method="get"
    action="/dashboard"
    data-dashboard-filters
    class="mb-6 rounded-xl border border-slate-200 bg-white p-4"
  >
    <div class="flex flex-wrap items-end gap-3">
      <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">
        Range
        <select
          name="range"
          data-range-select
          class="rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        >
          <option value="" selected={!filters.range}>All time</option>
          <option value="today" selected={filters.range === 'today'}>Today</option>
          <option value="week" selected={filters.range === 'week'}>This week</option>
          <option value="month" selected={filters.range === 'month'}>This month</option>
          <option value="custom" selected={filters.range === 'custom'}>Custom range…</option>
        </select>
      </label>

      <label class="hidden flex-col gap-1 text-xs font-medium text-slate-600 [&.show]:flex" data-custom-range>
        Created from
        <input
          type="date"
          name="from"
          value={filters.from ?? ''}
          class="rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        />
      </label>
      <label class="hidden flex-col gap-1 text-xs font-medium text-slate-600 [&.show]:flex" data-custom-range>
        Created to
        <input
          type="date"
          name="to"
          value={filters.to ?? ''}
          class="rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        />
      </label>

      <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">
        Employee
        <select
          name="employee"
          class="rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        >
          <option value="">All employees</option>
          {assignees.map((a) => (
            <option value={a.id} selected={filters.assignee === a.id}>
              {a.full_name}
            </option>
          ))}
        </select>
      </label>

      <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">
        Department
        <input
          name="department"
          value={reportFilters.department ?? ''}
          placeholder="e.g. QC"
          maxlength="50"
          class="w-28 rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        />
      </label>

      <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">
        Supervisor
        <select name="supervisor" class="rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
          <option value="">All supervisors</option>
          {supervisors.map((person) => <option value={person.id} selected={reportFilters.supervisor === person.id}>{person.full_name}</option>)}
        </select>
      </label>

      <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">
        Priority
        <select
          name="priority"
          class="rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        >
          <option value="">All priorities</option>
          {dash.PRIORITIES.map((p) => (
            <option value={p} selected={filters.priority === p}>
              {priorityLabel(p)}
            </option>
          ))}
        </select>
      </label>

      <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">
        Status
        <select
          name="status"
          class="rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        >
          <option value="">All statuses</option>
          {dash.STATUSES.map((s) => (
            <option value={s} selected={filters.status === s}>
              {statusLabel(s)}
            </option>
          ))}
        </select>
      </label>

      <label class="flex items-center gap-2 text-xs font-medium text-slate-600">
        <input
          type="checkbox"
          name="overdue"
          value="1"
          checked={filters.overdue_only}
          class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"
        />
        Overdue only
      </label>

      <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">
        Risk
        <select name="risk" class="rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
          <option value="">All risk levels</option>
          {RISK_LEVELS.map((risk) => <option value={risk} selected={reportFilters.risk === risk}>{risk}</option>)}
        </select>
      </label>

      <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">
        Finding Classification
        <select name="finding_classification" class="rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
          <option value="">All classifications</option>
          {FINDING_CLASSIFICATIONS.map((classification) => <option value={classification} selected={reportFilters.finding_classification === classification}>{classification}</option>)}
        </select>
      </label>

      <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">
        SLA Status
        <select name="sla_status" class="rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
          <option value="">All SLA statuses</option>
          {SLA_STATUSES.map((status) => <option value={status} selected={reportFilters.sla_status === status}>{status}</option>)}
        </select>
      </label>

      <button
        type="submit"
        class="rounded-md bg-brand-600 px-4 py-1.5 text-sm font-medium text-white hover:bg-brand-700"
      >
        Apply filters
      </button>
      {filtered && (
        <a
          href="/dashboard"
          class="rounded-md border border-slate-300 bg-white px-4 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
        >
          Clear
        </a>
      )}
    </div>
    {filtered && (
      <p class="mt-3 text-xs text-slate-500">
        Filters applied — every number below is scoped to the selected tasks.
      </p>
    )}
  </form>

  <nav aria-label="Dashboard sections" class="mb-6 overflow-x-auto rounded-xl border border-slate-200 bg-white p-2">
    <div class="flex min-w-max gap-2 text-sm font-medium">
      {['Operations', 'Laboratory', 'SLA', 'Findings', 'CAPA', 'Workforce', 'Evidence', 'Audit'].map((section) => (
