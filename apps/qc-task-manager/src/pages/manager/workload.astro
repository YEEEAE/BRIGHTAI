---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCurrentUser } from '../../lib/session';
import { canViewTeamWorkload } from '../../lib/permissions';
import { listEmployeeWorkloads } from '../../lib/workload';

const user = await getCurrentUser(Astro);
if (!user || !canViewTeamWorkload(user.role)) return Astro.redirect('/employee');
const rows = listEmployeeWorkloads();
---
<BaseLayout title="Team workload">
  <main class="mx-auto max-w-7xl space-y-6 px-4 py-8">
    <div><p class="text-sm text-slate-500">Operational view</p><h1 class="text-3xl font-bold">Team workload</h1><p class="mt-2 text-slate-600">مقارنة الموظفين متاحة للمشرفين والمدراء فقط.</p></div>
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
      <table class="min-w-full text-left text-sm"><caption class="sr-only">Employee workload comparison</caption><thead class="bg-slate-50"><tr>{['Employee','Active','Overdue','At risk','Critical','On hold','Completion rate','Avg resolution','Score'].map((label) => <th scope="col" class="px-4 py-3 font-semibold">{label}</th>)}</tr></thead><tbody>{rows.map((row) => <tr class="border-t border-slate-100"><th scope="row" class="px-4 py-3 font-medium">{row.full_name}</th><td class="px-4 py-3">{row.active_tasks}</td><td class="px-4 py-3">{row.overdue}</td><td class="px-4 py-3">{row.at_risk}</td><td class="px-4 py-3">{row.critical}</td><td class="px-4 py-3">{row.on_hold}</td><td class="px-4 py-3">{row.completion_rate}%</td><td class="px-4 py-3">{row.average_resolution_seconds == null ? '—' : `${Math.round(row.average_resolution_seconds / 3600)}h`}</td><td class="px-4 py-3 font-semibold">{row.workload_score}</td></tr>)}</tbody></table>
    </div>
  </main>
</BaseLayout>
