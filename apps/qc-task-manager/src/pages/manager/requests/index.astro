---
// Delete Requests review page (manager + admin). Access is guarded by the
// middleware /manager/* rule; the page lists pending requests with Approve /
// Reject actions and a history of reviewed requests below.
//
// Approving deletes the task (cascade) and the request row goes with it;
// task titles are joined live from the tasks table (rejected requests keep
// their task alive, so the JOIN always resolves).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  listPendingDeleteRequests,
  listReviewedDeleteRequests,
} from '../../../lib/deleteRequests';
import { formatDbDate } from '../../../lib/format';

const user = Astro.locals.user!; // protected route — middleware guarantees a session

const pending = listPendingDeleteRequests();
const history = listReviewedDeleteRequests(20);

function statusTone(status: string): string {
  if (status === 'approved') return 'bg-emerald-100 text-emerald-800';
  if (status === 'rejected') return 'bg-slate-100 text-slate-600';
  return 'bg-amber-100 text-amber-800';
}
---

<BaseLayout title="Delete Requests">
  <header class="mb-6">
    <a href="/manager" class="text-sm font-medium text-brand-600 hover:underline">&larr; Back to tasks</a>
    <h1 class="mt-2 text-2xl font-semibold text-slate-900">Delete requests</h1>
    <p class="text-sm text-slate-600">
      Employees request deletion — approve to remove the task, or reject to keep it.
      Signed in as {user.fullName} ({user.role}).
    </p>
  </header>

  <section class="rounded-lg border border-slate-200 bg-white">
    <header class="flex items-center justify-between border-b border-slate-200 px-5 py-3">
      <h2 class="text-sm font-semibold uppercase text-slate-500">Pending ({pending.length})</h2>
    </header>

    {pending.length === 0 ? (
      <p class="border-b border-slate-100 p-8 text-center text-sm text-slate-500">
        No pending delete requests.
      </p>
    ) : (
      <ul class="divide-y divide-slate-100">
        {pending.map((r) => (
          <li class="flex flex-wrap items-center justify-between gap-4 px-5 py-4">
            <div class="min-w-0 flex-1">
              <p class="font-medium text-slate-900">
                <a href={`/tasks/${r.task_id}`} class="hover:underline">{r.task_title}</a>
                <span class="ml-2 text-xs font-normal text-slate-400">#{r.task_id}</span>
              </p>
              <p class="mt-0.5 text-xs text-slate-500">
                Requested by <span class="font-medium text-slate-700">{r.requester_name}</span> · {formatDbDate(r.created_at)}
              </p>
              {r.reason && (
                <p class="mt-1.5 rounded-md bg-slate-50 px-3 py-2 text-sm text-slate-600">
                  <span class="text-xs font-semibold uppercase text-slate-400">Reason: </span>
                  {r.reason}
                </p>
              )}
            </div>
            <div class="flex shrink-0 gap-2">
              <form action="/manager/requests/api" method="POST">
                <input type="hidden" name="action" value="approve" />
                <input type="hidden" name="request_id" value={r.id} />
                <button
                  type="submit"
                  class="rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700"
                  title="Delete the task and approve this request"
                >
                  Approve
                </button>
              </form>
              <form action="/manager/requests/api" method="POST">
                <input type="hidden" name="action" value="reject" />
                <input type="hidden" name="request_id" value={r.id} />
                <button
                  type="submit"
                  class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
                  title="Keep the task and reject this request"
                >
                  Reject
                </button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="mt-8 rounded-lg border border-slate-200 bg-white">
    <header class="border-b border-slate-200 px-5 py-3">
      <h2 class="text-sm font-semibold uppercase text-slate-500">History</h2>
    </header>
    {history.length === 0 ? (
      <p class="p-8 text-center text-sm text-slate-500">No reviewed requests yet.</p>
    ) : (
      <ul class="divide-y divide-slate-100">
        {history.map((r) => (
          <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-3">
            <div class="min-w-0">
              <p class="text-sm font-medium text-slate-900">
                <a href={`/tasks/${r.task_id}`} class="hover:underline">{r.task_title}</a>
              </p>
              <p class="mt-0.5 text-xs text-slate-500">
                by {r.requester_name}
                {r.reviewer_name && <> · reviewed by {r.reviewer_name} · {formatDbDate(r.reviewed_at)}</>}
              </p>
              {r.reason && <p class="mt-1 truncate text-xs text-slate-400">“{r.reason}”</p>}
            </div>
            <span class={`shrink-0 rounded-full px-2.5 py-1 text-xs font-medium ${statusTone(r.status)}`}>
              {r.status}
            </span>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
