---
// New task form (manager + admin). Full create scope: title, description,
// department, assignee (any active user), priority, due date, recurrence,
// checklist items, and dependencies.
//
// GET renders the form; POST is short-circuited in src/middleware.ts which
// calls handleCreateTaskPost (Astro 6 pages have no named request handlers).
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewTaskForm from '../../components/NewTaskForm.astro';
import { listActiveUsers, listTasksForDependency } from '../../lib/tasks';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const users = listActiveUsers();
const dependencyTasks = listTasksForDependency();
---

<BaseLayout title="New task">
  <div class="mx-auto max-w-2xl">
    <header class="mb-6">
      <a href="/manager" class="text-sm font-medium text-brand-600 hover:underline">&larr; Back to tasks</a>
      <h1 class="mt-2 text-2xl font-semibold text-slate-900">New task</h1>
      <p class="text-sm text-slate-600">Create a task as {user.fullName} ({user.role}).</p>
    </header>

    <NewTaskForm
      action="/manager/new"
      users={users}
      includeDependencies={true}
      dependencyTasks={dependencyTasks}
    />
  </div>
</BaseLayout>
