---
// Manager task list (manager + admin). Full create/edit/delete scope.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../lib/db';

const db = getDb();

const tasks = db
  .prepare(
    `SELECT t.id, t.title, t.status, t.priority, t.progress_percent,
            u.full_name AS assignee
     FROM tasks t
     LEFT JOIN users u ON u.id = t.assigned_to
     ORDER BY t.updated_at DESC
     LIMIT 100`,
  )
  .all() as {
    id: number;
    title: string;
    status: string;
    priority: string;
    progress_percent: number;
    assignee: string | null;
  }[];
---
<BaseLayout title="Tasks">
  <header class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Tasks</h1>
      <p class="text-sm text-slate-600">All tasks. Manager view (create, edit, delete).</p>
    </div>
    <div class="flex gap-2">
      <a href="/manager/requests" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
        Delete requests
      </a>
      <a href="/manager/new" class="rounded-md bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700">
        New task
      </a>
    </div>
  </header>

  {tasks.length === 0 ? (
    <p class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
      No tasks yet.
    </p>
  ) : (
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
          <tr>
            <th class="px-4 py-2">#</th>
            <th class="px-4 py-2">Title</th>
            <th class="px-4 py-2">Assignee</th>
            <th class="px-4 py-2">Priority</th>
            <th class="px-4 py-2">Progress</th>
            <th class="px-4 py-2">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          {tasks.map((t) => (
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2 text-slate-500">{t.id}</td>
              <td class="px-4 py-2">
                <a href={`/tasks/${t.id}`} class="font-medium text-slate-900 hover:underline">{t.title}</a>
              </td>
              <td class="px-4 py-2 text-slate-600">{t.assignee ?? '—'}</td>
              <td class="px-4 py-2 text-slate-600">{t.priority}</td>
              <td class="px-4 py-2 text-slate-600">{t.progress_percent}%</td>
              <td class="px-4 py-2">
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{t.status}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</BaseLayout>
