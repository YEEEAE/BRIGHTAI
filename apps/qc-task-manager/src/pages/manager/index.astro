---
// Manager task list (manager + admin). Full create/edit/delete scope.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import DeleteRequestBadge from '../../components/DeleteRequestBadge.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getDb } from '../../lib/db';
import {
  formatDueDate,
  isOverdue,
  isUrgent,
  priorityLabel,
  priorityBadgeClass,
  URGENT_ROW_CLASS,
} from '../../lib/format';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const db = getDb();

const tasks = db
  .prepare(
    `SELECT t.id, t.title, t.status, t.priority, t.progress_percent, t.due_date, t.recurrence,
            (SELECT COUNT(*) FROM task_checklists c WHERE c.task_id = t.id) AS checklist_total,
            (SELECT COUNT(*) FROM task_checklists c WHERE c.task_id = t.id AND c.is_completed = 1) AS checklist_completed,
            u.full_name AS assignee,
            (SELECT r.status FROM task_delete_requests r
              WHERE r.task_id = t.id ORDER BY r.id DESC LIMIT 1) AS delete_request_status,
            (SELECT r.review_note FROM task_delete_requests r
              WHERE r.task_id = t.id ORDER BY r.id DESC LIMIT 1) AS delete_request_note
     FROM tasks t
     LEFT JOIN users u ON u.id = t.assigned_to
     ORDER BY t.updated_at DESC
     LIMIT 100`,
  )
  .all() as {
    id: number;
    title: string;
    status: string;
    priority: string;
    progress_percent: number;
    due_date: string | null;
    recurrence: string;
    assignee: string | null;
    delete_request_status: 'pending' | 'rejected' | string | null;
    delete_request_note: string | null;
    checklist_total: number;
    checklist_completed: number;
  }[];

// "Needs my attention" strip (Phase: role home — answer first, list below).
// Counts mirror the operational definitions; links lead to the existing
// authoritative lists (drilldown KPI, search filter, review registers).
const overdueOpen = db.prepare(
  "SELECT COUNT(*) AS n FROM tasks WHERE status IN ('not_started','in_progress') AND due_date IS NOT NULL AND due_date < date('now')",
).get() as { n: number };
const urgentOpen = db.prepare(
  "SELECT COUNT(*) AS n FROM tasks WHERE status IN ('not_started','in_progress') AND priority = 'urgent'",
).get() as { n: number };
const pendingDeleteRequests = db.prepare(
  "SELECT COUNT(*) AS n FROM task_delete_requests WHERE status = 'pending'",
).get() as { n: number };
const openFindings = db.prepare(
  "SELECT COUNT(*) AS n FROM qc_findings WHERE status NOT IN ('CLOSED','CANCELLED')",
).get() as { n: number };

const attention = [
  { label: 'Overdue tasks', n: overdueOpen.n, href: '/dashboard/drilldown?kpi=overdue', tone: overdueOpen.n > 0 ? 'danger' : 'neutral' },
  { label: 'Urgent open tasks', n: urgentOpen.n, href: '/search?priority=urgent', tone: urgentOpen.n > 0 ? 'warning' : 'neutral' },
  { label: 'Pending delete requests', n: pendingDeleteRequests.n, href: '/manager/requests', tone: pendingDeleteRequests.n > 0 ? 'warning' : 'neutral' },
  { label: 'Open findings', n: openFindings.n, href: '/findings', tone: openFindings.n > 0 ? 'info' : 'neutral' },
] as const;
const attentionTone: Record<string, string> = {
  danger: 'border-red-200 bg-red-50 text-red-700',
  warning: 'border-orange-200 bg-orange-50 text-orange-700',
  info: 'border-sky-200 bg-sky-50 text-sky-700',
  neutral: 'border-slate-200 bg-white text-slate-700',
};
---
<BaseLayout title="Tasks">
  <div class="space-y-6">
    <PageHeader
      title="Tasks"
      description={`All tasks. Manager view (create, edit, delete). Signed in as ${user.fullName} (${user.role}).`}
    >
      <fragment slot="actions">
        <a href="/manager/requests" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">
          Delete requests
        </a>
        <a href="/manager/new" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">
          New task
        </a>
      </fragment>
    </PageHeader>

    <section aria-label="Needs attention" class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      {attention.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-xl border p-4 shadow-sm transition-colors hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600',
            attentionTone[item.tone],
          ]}
        >
          <p class="text-2xl font-semibold tabular-nums">{item.n}</p>
          <p class="mt-0.5 text-sm font-medium">{item.label}</p>
        </a>
      ))}
    </section>

    {tasks.length === 0 ? (
      <EmptyState
        title="No tasks yet"
        hint="Create the first task for your team to get started."
        ctaHref="/manager/new"
        ctaLabel="Create your first task"
      />
    ) : (
      <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full min-w-max text-sm">
          <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
            <tr>
              <th scope="col" class="px-4 py-2.5">#</th>
              <th scope="col" class="px-4 py-2.5">Title</th>
              <th scope="col" class="px-4 py-2.5">Assignee</th>
              <th scope="col" class="px-4 py-2.5">Due</th>
              <th scope="col" class="px-4 py-2.5">Priority</th>
              <th scope="col" class="px-4 py-2.5">Progress</th>
              <th scope="col" class="px-4 py-2.5">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {tasks.map((t) => {
              const overdue = isOverdue(t.due_date, t.status);
              const urgent = isUrgent(t.priority);
              return (
                <tr class={urgent ? URGENT_ROW_CLASS : 'transition-colors hover:bg-slate-50/75'}>
                  <td class="px-4 py-2.5 text-slate-500 tabular-nums">{t.id}</td>
                  <td class="px-4 py-2.5">
                    <a href={`/tasks/${t.id}`} class="font-medium text-slate-900 hover:underline">{t.title}</a>
                    {t.recurrence !== 'none' && <span title="Recurring task" aria-label="Recurring task"> 🔁</span>}
                  </td>
                  <td class="px-4 py-2.5 text-slate-600">{t.assignee ?? '—'}</td>
                  <td class={`whitespace-nowrap px-4 py-2.5 ${overdue ? 'font-semibold text-red-600' : 'text-slate-600'}`}>
                    {formatDueDate(t.due_date)}
                    {overdue && ' ⚠️'}
                  </td>
                  <td class="whitespace-nowrap px-4 py-2.5">
                    <span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium ${priorityBadgeClass(t.priority)}`}>
                      {priorityLabel(t.priority)}
                    </span>
                  </td>
                  <td class="whitespace-nowrap px-4 py-2.5 text-slate-600 tabular-nums">{t.progress_percent}%<span class="block text-xs text-slate-500">QC {t.checklist_completed}/{t.checklist_total} ({t.checklist_total ? Math.round((t.checklist_completed / t.checklist_total) * 100) : 0}%)</span></td>
                  <td class="px-4 py-2.5">
                    <div class="flex items-center gap-2">
                      <DeleteRequestBadge status={t.delete_request_status} reason={t.delete_request_note} />
                      <StatusBadge status={t.status} />
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </div>
</BaseLayout>
