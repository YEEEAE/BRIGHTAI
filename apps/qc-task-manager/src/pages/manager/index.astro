---
// Manager task list (manager + admin). Full create/edit/delete scope.
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getDb } from '../../lib/db';
import {
  formatDueDate,
  isOverdue,
  isUrgent,
  priorityLabel,
  priorityBadgeClass,
  URGENT_ROW_CLASS,
} from '../../lib/format';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const db = getDb();

const tasks = db
  .prepare(
    `SELECT t.id, t.title, t.status, t.priority, t.progress_percent, t.due_date, t.recurrence,
            (SELECT COUNT(*) FROM task_checklists c WHERE c.task_id = t.id) AS checklist_total,
            (SELECT COUNT(*) FROM task_checklists c WHERE c.task_id = t.id AND c.is_completed = 1) AS checklist_completed,
            u.full_name AS assignee,
            (SELECT 1 FROM task_delete_requests r
              WHERE r.task_id = t.id AND r.status = 'pending' LIMIT 1) AS delete_pending
     FROM tasks t
     LEFT JOIN users u ON u.id = t.assigned_to
     ORDER BY t.updated_at DESC
     LIMIT 100`,
  )
  .all() as {
    id: number;
    title: string;
    status: string;
    priority: string;
    progress_percent: number;
    due_date: string | null;
    recurrence: string;
    assignee: string | null;
    delete_pending: number;
    checklist_total: number;
    checklist_completed: number;
  }[];
---
<BaseLayout title="Tasks">
  <header class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Tasks</h1>
      <p class="text-sm text-slate-600">All tasks. Manager view (create, edit, delete). Signed in as {user.fullName} ({user.role}).</p>
    </div>
    <div class="flex gap-2">
      <a href="/manager/requests" class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
        Delete requests
      </a>
      <a href="/manager/new" class="rounded-md bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700">
        New task
      </a>
    </div>
  </header>

  {tasks.length === 0 ? (
    <EmptyState
      title="No tasks yet"
      hint="Create the first task for your team to get started."
      ctaHref="/manager/new"
      ctaLabel="Create your first task"
    />
  ) : (
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="w-full min-w-max text-sm">
        <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
          <tr>
            <th class="px-4 py-2.5">#</th>
            <th class="px-4 py-2.5">Title</th>
            <th class="px-4 py-2.5">Assignee</th>
            <th class="px-4 py-2.5">Due</th>
            <th class="px-4 py-2.5">Priority</th>
            <th class="px-4 py-2.5">Progress</th>
            <th class="px-4 py-2.5">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          {tasks.map((t) => {
            const overdue = isOverdue(t.due_date, t.status);
            const urgent = isUrgent(t.priority);
            return (
              <tr class={urgent ? URGENT_ROW_CLASS : 'transition-colors hover:bg-slate-50'}>
                <td class="px-4 py-2.5 text-slate-500">{t.id}</td>
                <td class="px-4 py-2.5">
                  <a href={`/tasks/${t.id}`} class="font-medium text-slate-900 hover:underline">{t.title}</a>
                  {t.recurrence !== 'none' && <span title="Recurring task" aria-label="Recurring task"> 🔁</span>}
                </td>
                <td class="px-4 py-2.5 text-slate-600">{t.assignee ?? '—'}</td>
                <td class={`whitespace-nowrap px-4 py-2.5 ${overdue ? 'font-semibold text-red-600' : 'text-slate-600'}`}>
                  {formatDueDate(t.due_date)}
                  {overdue && ' ⚠️'}
                </td>
                <td class="whitespace-nowrap px-4 py-2.5">
                  <span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium ${priorityBadgeClass(t.priority)}`}>
                    {priorityLabel(t.priority)}
                  </span>
                </td>
                <td class="whitespace-nowrap px-4 py-2.5 text-slate-600 tabular-nums">{t.progress_percent}%<span class="block text-xs text-slate-400">QC {t.checklist_completed}/{t.checklist_total} ({t.checklist_total ? Math.round((t.checklist_completed / t.checklist_total) * 100) : 0}%)</span></td>
                <td class="px-4 py-2.5">
                  <div class="flex items-center gap-2">
                    {t.delete_pending === 1 && (
                      <span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700" title="Pending deletion request">
                        🗑️
                      </span>
                    )}
                    <StatusBadge status={t.status} />
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</BaseLayout>
