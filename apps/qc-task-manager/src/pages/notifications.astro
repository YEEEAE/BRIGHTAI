---
// Notifications page — derived in-app alerts for the signed-in user.
// Accessible to every role (the middleware already requires a session).
// Data comes from src/lib/notifications.ts, which computes everything from
// existing task/comment/delete-request data (no separate table).
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import MarkAllReadButton from '../components/MarkAllReadButton';
import MarkReadButton from '../components/MarkReadButton';
import { getNotificationsForUser, type AppNotification, type NotificationKind } from '../lib/notifications';
import { roleHome } from '../lib/permissions';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const notifications = getNotificationsForUser({ id: user.userId, role: user.role });

// Presentation maps — kept local to the page.
const KIND_ICON: Record<NotificationKind, string> = {
  overdue: '🚨',
  due_soon: '📅',
  unstarted: '⏳',
  assigned: '👤',
  due_date_changed: '🗓️',
  priority_changed: '🚦',
  recurring_created: '🔁',
  task_completed: '✅',
  comment_added: '💬',
  blocker_added: '🚧',
  delete_requested: '🗑️',
  delete_approved: '✅',
  delete_rejected: '⛔',
  task_reopened: '🔄',
  sla_escalation: '🚨',
  lab_document_review_due: '📋',
  lab_test_review_started: '🔬',
  lab_test_rejected: '⛔',
  lab_test_changes_requested: '✏️',
  lab_test_approved: '✅',
  lab_document_acknowledgement: '📖',
  lab_document_acknowledged: '👍',
  lab_document_review_started: '📄',
  lab_document_changes_requested: '📝',
  lab_document_approved: '✅',
  lab_document_archived: '📦',
  lab_calibration_due: '⚖️',
  lab_calibration_overdue: '⚠️',
  lab_maintenance_event: '🔧',
  lab_retest_update: '🔁',
};

const KIND_LABEL: Record<NotificationKind, string> = {
  overdue: 'Overdue',
  due_soon: 'Due soon',
  unstarted: 'Not started',
  assigned: 'Assigned to you',
  due_date_changed: 'Due date changes',
  priority_changed: 'Priority changes',
  recurring_created: 'Recurring tasks',
  task_completed: 'Completed tasks',
  comment_added: 'New comments',
  blocker_added: 'Blockers',
  delete_requested: 'Deletion requests',
  delete_approved: 'Deletion approved',
  delete_rejected: 'Deletion rejected',
  task_reopened: 'Reopened tasks',
  sla_escalation: 'SLA escalations',
  lab_document_review_due: 'Document reviews',
  lab_test_review_started: 'Lab tests under review',
  lab_test_rejected: 'Lab tests rejected',
  lab_test_changes_requested: 'Lab test changes requested',
  lab_test_approved: 'Lab tests approved',
  lab_document_acknowledgement: 'Document acknowledgements required',
  lab_document_acknowledged: 'Document acknowledgements',
  lab_document_review_started: 'Document review started',
  lab_document_changes_requested: 'Document changes requested',
  lab_document_approved: 'Document approved',
  lab_document_archived: 'Document archived',
  lab_calibration_due: 'Calibration due',
  lab_calibration_overdue: 'Calibration overdue',
  lab_maintenance_event: 'Equipment maintenance',
  lab_retest_update: 'Retest updates',
};

const SEVERITY_CARD: Record<AppNotification['severity'], string> = {
  danger: 'border-l-red-400 bg-red-50/60',
  warning: 'border-l-amber-400 bg-amber-50/60',
  info: 'border-l-sky-400 bg-white',
  success: 'border-l-emerald-400 bg-emerald-50/60',
};

// Section order: danger → warning → info → success.
const SECTIONS: { key: NotificationKind; order: number }[] = [
  { key: 'overdue', order: 0 },
  { key: 'delete_rejected', order: 0 },
  { key: 'due_soon', order: 1 },
  { key: 'due_date_changed', order: 1 },
  { key: 'priority_changed', order: 1 },
  { key: 'blocker_added', order: 1 },
  { key: 'delete_requested', order: 1 },
  { key: 'assigned', order: 2 },
  { key: 'unstarted', order: 2 },
  { key: 'comment_added', order: 2 },
  { key: 'recurring_created', order: 3 },
  { key: 'task_completed', order: 3 },
  { key: 'task_reopened', order: 3 },
  { key: 'delete_approved', order: 3 },
  { key: 'lab_document_review_due', order: 1 },
  { key: 'lab_test_rejected', order: 0 },
  { key: 'lab_calibration_overdue', order: 0 },
  { key: 'lab_test_review_started', order: 1 },
  { key: 'lab_test_changes_requested', order: 1 },
  { key: 'lab_document_acknowledgement', order: 1 },
  { key: 'lab_calibration_due', order: 1 },
  { key: 'lab_maintenance_event', order: 1 },
  { key: 'lab_retest_update', order: 2 },
  { key: 'lab_test_approved', order: 3 },
  { key: 'lab_document_acknowledged', order: 3 },
];

function sectionOrder(kind: NotificationKind): number {
  return SECTIONS.find((s) => s.key === kind)?.order ?? 3;
}

const grouped = new Map<NotificationKind, AppNotification[]>();
for (const n of notifications) {
  const list = grouped.get(n.kind) ?? [];
  list.push(n);
  grouped.set(n.kind, list);
}
const orderedKinds = [...grouped.keys()].sort(
  (a, b) => sectionOrder(a) - sectionOrder(b),
);

const total = notifications.length;
const overdueCount = notifications.filter((n) => n.kind === 'overdue').length;
const dueSoonCount = notifications.filter((n) => n.kind === 'due_soon').length;
---

<BaseLayout title="Notifications">
  <header class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Notifications</h1>
      <p class="text-sm text-slate-600">
        Alerts about your tasks and team activity. Signed in as {user.fullName} ({user.role}).
      </p>
    </div>
    {total > 0 && <MarkAllReadButton client:visible />}
  </header>

  {total === 0 ? (
    <EmptyState
      title="You're all caught up 🎉"
      hint="No overdue tasks, upcoming due dates, or recent activity need your attention right now."
      ctaHref={roleHome(user.role)}
      ctaLabel="Back to my home"
    />
  ) : (
    <>
      <div class="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <p class="text-2xl font-semibold text-slate-900">{total}</p>
          <p class="text-sm text-slate-500">Total alerts</p>
        </div>
        <div class="rounded-xl border border-red-100 bg-red-50 p-4">
          <p class="text-2xl font-semibold text-red-700">{overdueCount}</p>
          <p class="text-sm text-red-600">Overdue</p>
        </div>
        <div class="rounded-xl border border-amber-100 bg-amber-50 p-4">
          <p class="text-2xl font-semibold text-amber-700">{dueSoonCount}</p>
          <p class="text-sm text-amber-600">Due within 3 days</p>
        </div>
      </div>

      {orderedKinds.map((kind) => (
        <section class="mb-8" aria-labelledby={`section-${kind}`}>
          <h2 id={`section-${kind}`} class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-slate-500">
            <span aria-hidden="true">{KIND_ICON[kind]}</span>
            {KIND_LABEL[kind]}
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">
              {grouped.get(kind)!.length}
            </span>
          </h2>
          <ul class="space-y-2">
            {grouped.get(kind)!.map((n) => (
              <li>
                <div
                  class={`rounded-lg border border-slate-200 border-l-4 p-4 transition hover:shadow-sm ${SEVERITY_CARD[n.severity]} ${
                    n.isRead === false ? 'ring-1 ring-sky-200' : ''
                  }`}
                >
                  <div class="flex items-start justify-between gap-3">
                    <a href={n.href} class="min-w-0 flex-1">
                      <div class="flex items-start justify-between gap-3">
                        <p class="flex items-center gap-2 font-medium text-slate-900">
                          {n.isRead === false && (
                            <span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full bg-sky-500" />
                          )}
                          {n.title}
                        </p>
                        <span class="shrink-0 text-xs text-slate-400">
                          {n.createdAt.slice(0, 10)}
                        </span>
                      </div>
                      <p class="mt-1 text-sm text-slate-600">{n.message}</p>
                    </a>
                    {n.notificationId != null && n.isRead === false && (
                      <MarkReadButton client:visible notificationId={n.notificationId} />
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </>
  )}
</BaseLayout>
