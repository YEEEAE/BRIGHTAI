---
// Task details page — accessible to every role.
//
// Access rule (CORE): employees may view only tasks assigned to them or created
// by them; every other role sees any task. Unauthorized employees get 403 and
// missing tasks get 404.
//
// Sections (top to bottom):
//   1. Header: title, status + priority badges, progress bar, due date,
//      assignee, creator, created date. Lock banner when completed.
//   2. Blocker note callout (when set).
//   3. Comments thread (chronological) + CommentBox island; completion comment
//      is pinned at the top when present.
//   4. Attachments list with download links.
//   5. Activity history timeline rendered from task_activity_log.
//   6. Closure info panel (only when completed).
//
// All formatting/action text lives in lib/{format,taskDetails}.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommentBox from '../../components/CommentBox';
import DeleteRequestDialog from '../../components/DeleteRequestDialog';
import { hasPendingDeleteRequest } from '../../lib/deleteRequests';
import {
  canViewTask,
  getTaskDetail,
  listComments,
  listAttachmentMeta,
  listActivity,
  getEvidenceInfo,
  getClosureComment,
  describeAction,
  actionCategory,
  type CommentWithAuthor,
  type AttachmentMeta,
  type ActivityEntry,
  type EvidenceInfo,
} from '../../lib/taskDetails';
import { taskListFor } from '../../lib/tasks';
import {
  formatDbDate,
  formatDueDate,
  humanFileSize,
  statusLabel,
  priorityLabel,
} from '../../lib/format';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const rawId = Number(Astro.params.id);
const idValid = Number.isInteger(rawId) && rawId > 0;

const detail = idValid ? getTaskDetail(rawId) : null;
const task = detail;
const notFound = !detail;
const forbidden = !notFound && !canViewTask({ id: user.userId, role: user.role }, task!);

// Correct HTTP semantics: 404 for a missing task, 403 for a forbidden one.
// The body is still rendered so the user gets a styled page, not a bare code.
if (notFound) Astro.response.status = 404;
if (forbidden) Astro.response.status = 403;

// Only pull the rich data when we will actually render the page.
let comments: CommentWithAuthor[] = [];
let attachments: AttachmentMeta[] = [];
let activity: ActivityEntry[] = [];
let evidence: EvidenceInfo = null;
let closureComment: CommentWithAuthor | null = null;
if (!notFound && !forbidden) {
  comments = listComments(rawId);
  attachments = listAttachmentMeta(rawId);
  activity = listActivity(rawId);
  evidence = getEvidenceInfo(rawId);
  closureComment = getClosureComment(rawId);
}

const completed = task?.status === 'completed';
const regularComments = comments.filter((c) => c.id !== closureComment?.id);

// Delete-request workflow (CORE BUSINESS RULE #4): employees request deletion of
// their own tasks that are not started or in progress. Completed tasks are never
// requestable (CORE BUSINESS RULE #3); manager/admin delete directly instead.
const canRequestDeletion =
  !notFound &&
  !forbidden &&
  user.role === 'employee' &&
  !!task &&
  (task.status === 'not_started' || task.status === 'in_progress') &&
  canViewTask({ id: user.userId, role: user.role }, task);
const deleteRequestPending =
  !notFound && !forbidden && !!task ? hasPendingDeleteRequest(rawId) : false;

const backHref = taskListFor(user.role);

const STATUS_TONES: Record<string, string> = {
  not_started: 'bg-slate-100 text-slate-700',
  in_progress: 'bg-blue-100 text-blue-800',
  on_hold: 'bg-amber-100 text-amber-800',
  completed: 'bg-emerald-100 text-emerald-800',
};
const PRIORITY_TONES: Record<string, string> = {
  low: 'bg-sky-100 text-sky-800',
  medium: 'bg-amber-100 text-amber-800',
  high: 'bg-red-100 text-red-800',
};
function progressTone(p: number): string {
  if (p >= 100) return 'bg-emerald-500';
  if (p >= 60) return 'bg-blue-500';
  if (p >= 30) return 'bg-amber-500';
  return 'bg-slate-400';
}

// Timeline icons + tones per action category (inline SVGs keep this server-rendered).
const ICON_TONE: Record<string, string> = {
  created: 'bg-emerald-100 text-emerald-700',
  status: 'bg-blue-100 text-blue-700',
  progress: 'bg-sky-100 text-sky-700',
  field: 'bg-slate-100 text-slate-600',
  blocker: 'bg-amber-100 text-amber-700',
  comment: 'bg-indigo-100 text-indigo-700',
  evidence: 'bg-violet-100 text-violet-700',
  delete: 'bg-red-100 text-red-700',
  other: 'bg-slate-100 text-slate-500',
};
const ICON_SVG: Record<string, string> = {
  created: '<circle cx="12" cy="12" r="10"/><path d="M8 12h8M12 8v8"/>',
  status: '<path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/>',
  progress: '<line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>',
  field: '<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>',
  blocker: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  comment: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  evidence: '<path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/>',
  delete: '<path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
  other: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="1"/>',
};
/** Build a full inline SVG from inner content (avoids SVGAttributes spread typing). */
function svgIcon(inner: string, cls = ''): string {
  const classAttr = cls ? ` class="${cls}"` : '';
  return `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"${classAttr}>${inner}</svg>`;
}
---

{notFound ? (
  <BaseLayout title="Task not found">
    <section class="py-16 text-center">
      <h1 class="text-3xl font-semibold text-slate-900">404 — Task not found</h1>
      <p class="mt-2 text-slate-600">That task doesn&rsquo;t exist or may have been deleted.</p>
      <a href={backHref} class="mt-6 inline-block rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
        Back to tasks
      </a>
    </section>
  </BaseLayout>
) : forbidden ? (
  <BaseLayout title="Forbidden">
    <section class="py-16 text-center">
      <h1 class="text-3xl font-semibold text-slate-900">403 — Forbidden</h1>
      <p class="mt-2 text-slate-600">You can only view tasks assigned to you or created by you.</p>
      <a href={backHref} class="mt-6 inline-block rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
        Back to tasks
      </a>
    </section>
  </BaseLayout>
) : task ? (
  <BaseLayout title={`${task.title} · Task #${task.id}`}>
    <div class="space-y-6">
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <header class="mb-4 flex flex-wrap items-start justify-between gap-3">
          <div>
            <a href={backHref} class="text-sm font-medium text-brand-600 hover:underline">&larr; Back to tasks</a>
            <h1 class="mt-1 text-2xl font-semibold text-slate-900">{task.title}</h1>
            <p class="mt-0.5 text-sm text-slate-500">Task #{task.id}</p>
          </div>
          <div class="flex flex-col items-end gap-2">
            <div class="flex gap-2">
              <span class={`rounded-full px-2.5 py-1 text-xs font-medium ${STATUS_TONES[task.status] ?? 'bg-slate-100 text-slate-600'}`}>
                {statusLabel(task.status)}
              </span>
              <span class={`rounded-full px-2.5 py-1 text-xs font-medium ${PRIORITY_TONES[task.priority] ?? 'bg-slate-100 text-slate-600'}`}>
                {priorityLabel(task.priority)}
              </span>
            </div>
            <DeleteRequestDialog
              taskId={task.id}
              canRequest={canRequestDeletion}
              hasPendingRequest={deleteRequestPending}
              client:visible
            />
          </div>
        </header>

        {completed && (
          <div class="mb-4 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status">
            This task is completed and is read-only for everyone.
          </div>
        )}

        <div class="space-y-1">
          <div class="flex items-center justify-between text-sm">
            <span class="font-medium text-slate-700">Progress</span>
            <span class="text-slate-600">{task.progress_percent}%</span>
          </div>
          <div class="h-2 w-full overflow-hidden rounded-full bg-slate-200">
            <div class={`h-full rounded-full ${progressTone(task.progress_percent)}`} style={`width: ${task.progress_percent}%`}></div>
          </div>
        </div>

        <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3 text-sm sm:grid-cols-3">
          <div>
            <dt class="text-xs uppercase text-slate-500">Due date</dt>
            <dd class="mt-0.5 font-medium text-slate-900">{formatDueDate(task.due_date)}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase text-slate-500">Assignee</dt>
            <dd class="mt-0.5 font-medium text-slate-900">{task.assignee_name ?? 'Unassigned'}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase text-slate-500">Created by</dt>
            <dd class="mt-0.5 font-medium text-slate-900">{task.creator_name ?? 'Unknown'}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase text-slate-500">Created</dt>
            <dd class="mt-0.5 text-slate-700">{formatDbDate(task.created_at)}</dd>
          </div>
          {task.updated_at && (
            <div>
              <dt class="text-xs uppercase text-slate-500">Last updated</dt>
              <dd class="mt-0.5 text-slate-700">{formatDbDate(task.updated_at)}</dd>
            </div>
          )}
          {completed && (
            <div>
              <dt class="text-xs uppercase text-slate-500">Completed</dt>
              <dd class="mt-0.5 font-medium text-slate-900">{formatDbDate(task.completed_at)}</dd>
            </div>
          )}
        </dl>

        {task.description && (
          <div class="mt-5 border-t border-slate-100 pt-4">
            <h2 class="text-sm font-semibold text-slate-900">Description</h2>
            <p class="mt-1 whitespace-pre-wrap text-sm text-slate-700">{task.description}</p>
          </div>
        )}
      </div>

      {/* 2. Blocker note */}
      {task.blocker_note && (
        <div class="rounded-lg border border-amber-200 bg-amber-50 p-4" role="alert">
          <div class="flex items-start gap-2">
            <span set:html={svgIcon(ICON_SVG.blocker, 'mt-0.5 shrink-0 text-amber-600')} />
            <div>
              <h2 class="text-sm font-semibold text-amber-900">Blocker note</h2>
              <p class="mt-1 whitespace-pre-wrap text-sm text-amber-800">{task.blocker_note}</p>
            </div>
          </div>
        </div>
      )}

      {/* 3. Comments */}
      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="mb-4 text-lg font-medium text-slate-900">Comments</h2>
        {closureComment && (
          <div class="mb-4 rounded-md border border-indigo-200 bg-indigo-50 px-4 py-3">
            <p class="text-xs font-semibold uppercase text-indigo-600">Completion comment</p>
            <p class="mt-1 whitespace-pre-wrap text-sm text-slate-800">{closureComment.comment}</p>
            <p class="mt-1 text-xs text-indigo-500">{closureComment.full_name} · {formatDbDate(closureComment.created_at)}</p>
          </div>
        )}
        <CommentBox
          taskId={task.id}
          taskStatus={task.status}
          comments={regularComments}
          client:visible
        />
      </section>

      {/* 4. Attachments */}
      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="mb-4 text-lg font-medium text-slate-900">Attachments</h2>
        {attachments.length === 0 ? (
          <p class="rounded-md border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-500">
            No attachments yet.
          </p>
        ) : (
          <ul class="divide-y divide-slate-100">
            {attachments.map((a) => (
              <li class="flex flex-wrap items-center justify-between gap-3 py-3">
                <div class="flex min-w-0 items-center gap-3">
                  <span set:html={svgIcon(ICON_SVG.evidence, 'shrink-0 text-slate-400')} />
                  <div class="min-w-0">
                    <p class="truncate text-sm font-medium text-slate-900" title={a.file_name}>{a.file_name}</p>
                    <p class="text-xs text-slate-500">
                      {humanFileSize(a.file_size)} · uploaded by {a.uploader} on {formatDbDate(a.uploaded_at)}
                    </p>
                  </div>
                </div>
                <a
                  href={`/api/tasks/${task.id}/attachments/${a.id}`}
                  class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
                >
                  Download
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>

      {/* 5. Activity history */}
      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="mb-4 text-lg font-medium text-slate-900">Activity history</h2>
        {activity.length === 0 ? (
          <p class="rounded-md border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-500">
            No activity recorded yet.
          </p>
        ) : (
          <ol class="relative space-y-5">
            {activity.map((a) => {
              const cat = actionCategory(a.action);
              return (
                <li class="flex gap-3">
                  <span class={`mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full ${ICON_TONE[cat] ?? 'bg-slate-100 text-slate-500'}`} set:html={svgIcon(ICON_SVG[cat] ?? ICON_SVG.other)} />
                  <div class="min-w-0">
                    <p class="text-sm text-slate-800">
                      <span class="font-semibold text-slate-900">{a.user_name}</span>{' '}
                      {describeAction(a.action, a.old_value, a.new_value)}
                    </p>
                    <p class="text-xs text-slate-500">{formatDbDate(a.created_at)}</p>
                  </div>
                </li>
              );
            })}
          </ol>
        )}
      </section>

      {/* 6. Closure info */}
      {completed && (
        <section class="rounded-lg border border-emerald-200 bg-emerald-50 p-6">
          <h2 class="text-lg font-medium text-emerald-900">Task completed</h2>
          <p class="mt-1 text-sm text-emerald-800">
            ✅ Completed by <span class="font-semibold">{task.completed_by_name ?? 'Unknown'}</span> on{' '}
            {formatDbDate(task.completed_at)}
          </p>
          <div class="mt-3 rounded-md border border-emerald-200 bg-white px-4 py-3 text-sm text-slate-700">
            {evidence?.kind === 'uploaded' ? (
              <div class="flex flex-wrap items-center gap-2">
                <span set:html={svgIcon(ICON_SVG.evidence, 'text-emerald-600')} />
                <span class="font-medium">Evidence file:</span>
                {evidence.attachmentId ? (
                  <a
                    href={`/api/tasks/${task.id}/attachments/${evidence.attachmentId}`}
                    class="font-medium text-brand-600 hover:underline"
                  >
                    {evidence.fileName}
                  </a>
                ) : (
                  <span>{evidence.fileName ?? 'unknown'}</span>
                )}
              </div>
            ) : evidence?.kind === 'skipped' ? (
              <span class="font-medium text-amber-700">Evidence skipped</span>
            ) : (
              <span>No evidence recorded.</span>
            )}
          </div>
        </section>
      )}
    </div>
  </BaseLayout>
) : null}
