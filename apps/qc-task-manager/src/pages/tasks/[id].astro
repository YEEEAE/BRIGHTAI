---
// Task details page — accessible to every role.
//
// Access rule (CORE): employees may view only tasks assigned to them or created
// by them; every other role sees any task. Unauthorized employees get 403 and
// missing tasks get 404.
//
// Sections (top to bottom):
//   1. Header: title, status + priority badges, progress bar, due date,
//      assignee, creator, created date. Lock banner when completed.
//   2. Blocker note callout (when set).
//   3. Comments thread (chronological) + CommentBox island; completion comment
//      is pinned at the top when present.
//   4. Attachments list with download links.
//   5. Activity history timeline rendered from task_activity_log.
//   6. Closure info panel (only when completed).
//
// All formatting/action text lives in lib/{format,taskDetails}.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommentBox from '../../components/CommentBox';
import DeleteRequestDialog from '../../components/DeleteRequestDialog';
import StatusBadge from '../../components/StatusBadge.astro';
import EmptyState from '../../components/EmptyState.astro';
import TaskUpdatePanel from '../../components/TaskUpdatePanel';
import AttachmentUploader from '../../components/AttachmentUploader';
import TaskLifecycle from '../../components/TaskLifecycle';
import { hasPendingDeleteRequest } from '../../lib/deleteRequests';
import {
  canViewTask,
  getTaskDetail,
  listComments,
  listAttachmentMeta,
  listActivity,
  getEvidenceInfo,
  getClosureComment,
  listEvidenceFiles,
  describeAction,
  actionCategory,
  listChecklist,
  listDependencies,
  getRecurringParent,
  type CommentWithAuthor,
  type AttachmentMeta,
  type ActivityEntry,
  type EvidenceInfo,
  type DependencyInfo,
} from '../../lib/taskDetails';
import { listBlockingDependencies } from '../../lib/taskUpdates';
import { taskListFor, listActiveUsers, listTasksForDependency } from '../../lib/tasks';
import { canEditTask, canEditLockedField, canEditChecklistStructure, hasRankAtLeast, canOverrideEvidenceGate } from '../../lib/permissions';
import { EMPLOYEE_LOCKED_FIELDS } from '../../lib/task-policy';
import { getTaskTemplateSnapshot } from '../../lib/templatesStore';
import { normalizeEvidenceRequirements } from '../../lib/evidence';
import {
  formatDbDate,
  formatDueDate,
  humanFileSize,
  priorityLabel,
  priorityBadgeClass,
  recurrenceLabel,
  isOverdue,
} from '../../lib/format';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const rawId = Number(Astro.params.id);
const idValid = Number.isInteger(rawId) && rawId > 0;

const detail = idValid ? getTaskDetail(rawId) : null;
const task = detail;
const notFound = !detail;
const forbidden = !notFound && !canViewTask({ id: user.userId, role: user.role }, task!);

// Correct HTTP semantics: 404 for a missing task, 403 for a forbidden one.
// The body is still rendered so the user gets a styled page, not a bare code.
if (notFound) Astro.response.status = 404;
if (forbidden) Astro.response.status = 403;

// Only pull the rich data when we will actually render the page.
let comments: CommentWithAuthor[] = [];
let attachments: AttachmentMeta[] = [];
let activity: ActivityEntry[] = [];
let evidence: EvidenceInfo = null;
let evidenceFiles: Awaited<ReturnType<typeof listEvidenceFiles>> = [];
let closureComment: CommentWithAuthor | null = null;
let checklist: Awaited<ReturnType<typeof listChecklist>> = [];
let dependencies: DependencyInfo[] = [];
let blockingDependencies: Awaited<ReturnType<typeof listBlockingDependencies>> = [];
let recurringParent: { id: number; title: string } | null = null;
if (!notFound && !forbidden) {
  comments = listComments(rawId);
  attachments = listAttachmentMeta(rawId);
  activity = listActivity(rawId);
  evidence = getEvidenceInfo(rawId);
  evidenceFiles = listEvidenceFiles(rawId);
  closureComment = getClosureComment(rawId);
  checklist = listChecklist(rawId);
  dependencies = listDependencies(rawId);
  blockingDependencies = listBlockingDependencies(rawId);
  recurringParent = getRecurringParent(rawId);
}

const completed = task?.status === 'completed';
const cancelled = task?.status === 'cancelled';
// The completion comment is flagged is_completion_comment = 1 (wizard flow);
// it is pinned at the top and excluded from the regular thread.
const regularComments = comments.filter((c) => Number(c.is_completion_comment) !== 1);

// Editing + lifecycle UI (CORE BUSINESS RULES #2/#3): visible when the task is
// active (not completed/cancelled) and the actor may edit it. Locked fields
// additionally require supervisor/manager/admin (canEditLockedField).
const canEdit =
  !notFound && !forbidden && !!task && !completed && !cancelled && canEditTask({ id: user.userId, role: user.role }, task);
// Cancel = manager/admin approval (spec); Reopen of completed = admin/manager only.
const canCancel = canEdit && hasRankAtLeast(user.role, 'manager');
const canReopen = !notFound && !forbidden && !!task && completed && hasRankAtLeast(user.role, 'manager');
const canEditLocked = canEdit && canEditLockedField(user.role);
const canEditChecklistStructureForTask = !!task && canEditChecklistStructure({ id: user.userId, role: user.role }, task);
const incompleteChecklist = checklist.filter((item) => !item.is_completed).length;
const canOverrideChecklist = hasRankAtLeast(user.role, 'manager');
const usersForAssignee = canEditLocked ? listActiveUsers() : [];
const dependencyTasks = canEditLocked ? listTasksForDependency() : [];
const canOverrideDependencies = canEditLocked && hasRankAtLeast(user.role, 'manager');
const overdue = !!task && isOverdue(task.due_date, task.status);

// Template snapshot + evidence requirements (frozen on the task at instantiation).
// Tasks without a template have no requirements and the gate is inert for them.
const templateSnapshot = task ? getTaskTemplateSnapshot(task.id) : null;
const evidenceRequirements = templateSnapshot
  ? normalizeEvidenceRequirements(templateSnapshot.evidenceRequirements).map((r) => ({
      type: r.type,
      label: r.label,
      requirement: r.requirement,
      ...(r.description ? { description: r.description } : {}),
      ...(r.allowedExtensions ? { allowedExtensions: r.allowedExtensions } : {}),
    }))
  : [];
const existingEvidenceTypes = evidenceFiles
  .filter((file) => file.verification_status !== 'REJECTED' && file.evidence_type)
  .map((file) => file.evidence_type as string);
const coveredEvidenceTypes = new Set(existingEvidenceTypes);
const canOverrideEvidence = canOverrideEvidenceGate(user.role);


// Delete-request workflow (CORE BUSINESS RULE #4): employees request deletion of
// their own tasks that are not started or in progress. Completed tasks are never
// requestable (CORE BUSINESS RULE #3); manager/admin delete directly instead.
const canRequestDeletion =
  !notFound &&
  !forbidden &&
  user.role === 'employee' &&
  !!task &&
  (task.status === 'not_started' || task.status === 'in_progress') &&
  canViewTask({ id: user.userId, role: user.role }, task);
const deleteRequestPending =
  !notFound && !forbidden && !!task ? hasPendingDeleteRequest(rawId) : false;

const backHref = taskListFor(user.role);

// Locked-field summary (section #2): the business fields an EMPLOYEE cannot
// edit after creation (EMPLOYEE_LOCKED_FIELDS). Supervisors/managers/admins can.
// Shown only to employees on tasks they may edit, so they understand why parts
// of the update panel are disabled.
const LOCKED_FIELD_LABELS: Record<string, string> = {
  title: 'Title',
  description: 'Description',
  department: 'Department',
  assigned_to: 'Assignee',
  due_date: 'Due date',
  priority: 'Priority',
  recurrence: 'Recurrence',
  recurrence_end_date: 'Recurrence end date',
  checklist: 'Checklist items',
  dependencies: 'Dependencies',
};
const showLockedSummary = user.role === 'employee' && canEdit;
const lockedFieldLabels = EMPLOYEE_LOCKED_FIELDS.map((f) => LOCKED_FIELD_LABELS[f] ?? f);

function progressTone(p: number): string {
  if (p >= 100) return 'bg-emerald-500';
  if (p >= 60) return 'bg-blue-500';
  if (p >= 30) return 'bg-amber-500';
  return 'bg-slate-400';
}

// Timeline icons + tones per action category (inline SVGs keep this server-rendered).
const ICON_TONE: Record<string, string> = {
  created: 'bg-emerald-100 text-emerald-700',
  status: 'bg-blue-100 text-blue-700',
  progress: 'bg-sky-100 text-sky-700',
  field: 'bg-slate-100 text-slate-600',
  blocker: 'bg-amber-100 text-amber-700',
  comment: 'bg-indigo-100 text-indigo-700',
  evidence: 'bg-violet-100 text-violet-700',
  delete: 'bg-red-100 text-red-700',
  other: 'bg-slate-100 text-slate-500',
};
const ICON_SVG: Record<string, string> = {
  created: '<circle cx="12" cy="12" r="10"/><path d="M8 12h8M12 8v8"/>',
  status: '<path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/>',
  progress: '<line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>',
  field: '<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>',
  blocker: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  comment: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  evidence: '<path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/>',
  delete: '<path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
  other: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="1"/>',
};
/** Build a full inline SVG from inner content (avoids SVGAttributes spread typing). */
function svgIcon(inner: string, cls = ''): string {
  const classAttr = cls ? ` class="${cls}"` : '';
  return `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"${classAttr}>${inner}</svg>`;
}
---

{notFound ? (
  <BaseLayout title="Task not found">
    <section class="py-16 text-center">
      <h1 class="text-3xl font-semibold text-slate-900">404 — Task not found</h1>
      <p class="mt-2 text-slate-600">That task doesn&rsquo;t exist or may have been deleted.</p>
      <a href={backHref} class="mt-6 inline-block rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
        Back to tasks
      </a>
    </section>
  </BaseLayout>
) : forbidden ? (
  <BaseLayout title="Forbidden">
    <section class="py-16 text-center">
      <h1 class="text-3xl font-semibold text-slate-900">403 — Forbidden</h1>
      <p class="mt-2 text-slate-600">You can only view tasks assigned to you or created by you.</p>
      <a href={backHref} class="mt-6 inline-block rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
        Back to tasks
      </a>
    </section>
  </BaseLayout>
) : task ? (
  <BaseLayout title={`${task.title} · Task #${task.id}`}>
    <div class="space-y-6">
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <header class="mb-4 flex flex-wrap items-start justify-between gap-3">
          <div>
            <a href={backHref} class="text-sm font-medium text-brand-600 hover:underline">&larr; Back to tasks</a>
            <h1 class="mt-1 text-2xl font-semibold text-slate-900">{task.title}</h1>
            <p class="mt-0.5 text-sm text-slate-500">Task #{task.id}</p>
          </div>
          <div class="flex flex-col items-end gap-2">
            <div class="flex flex-wrap justify-end gap-2">
              <StatusBadge status={task.status} />
              <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium ${priorityBadgeClass(task.priority)}`}>
                {priorityLabel(task.priority)}
              </span>
              <a
                href={`/api/export/tasks/pdf/${task.id}`}
                class="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50"
                title="Download PDF report"
              >
                PDF report
              </a>
            </div>
            <DeleteRequestDialog
              taskId={task.id}
              canRequest={canRequestDeletion}
              hasPendingRequest={deleteRequestPending}
              client:load
            />
          </div>
        </header>

        {completed && (
          <div class="mb-4 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status">
            This task is completed and is read-only for everyone.
          </div>
        )}
        {cancelled && (
          <div class="mb-4 rounded-md border border-slate-300 bg-slate-100 px-4 py-3 text-sm text-slate-700" role="status">
            This task is cancelled and is read-only for everyone.
          </div>
        )}

        <div class="space-y-1">
          <div class="flex items-center justify-between text-sm">
            <span class="font-medium text-slate-700">Progress</span>
            <span class="text-slate-600">{task.progress_percent}%</span>
          </div>
          <div class="h-2 w-full overflow-hidden rounded-full bg-slate-200">
            <div class={`h-full rounded-full ${progressTone(task.progress_percent)}`} style={`width: ${task.progress_percent}%`}></div>
          </div>
        </div>

        <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3 text-sm sm:grid-cols-3">
          <div>
            <dt class="text-xs uppercase text-slate-500">Due date</dt>
            <dd class={`mt-0.5 font-medium ${overdue ? 'text-red-600' : 'text-slate-900'}`}>
              {formatDueDate(task.due_date)}
              {overdue && (
                <span class="ml-2 inline-flex items-center gap-1 rounded-full bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-700">
                  ⚠️ Overdue
                </span>
              )}
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase text-slate-500">Assignee</dt>
            <dd class="mt-0.5 font-medium text-slate-900">{task.assignee_name ?? 'Unassigned'}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase text-slate-500">Department</dt>
            <dd class="mt-0.5 font-medium text-slate-900">{task.department}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase text-slate-500">Created by</dt>
            <dd class="mt-0.5 font-medium text-slate-900">{task.creator_name ?? 'Unknown'}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase text-slate-500">Created</dt>
            <dd class="mt-0.5 text-slate-700">{formatDbDate(task.created_at)}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase text-slate-500">Recurrence</dt>
            <dd class="mt-0.5 font-medium text-slate-900">
              {task.recurrence !== 'none' ? (
                <span class="inline-flex items-center gap-1">
                  🔁 {recurrenceLabel(task.recurrence)}
                  {task.recurrence_end_date && (
                    <span class="text-xs font-normal text-slate-500">until {formatDueDate(task.recurrence_end_date)}</span>
                  )}
                </span>
              ) : (
                <span class="text-slate-500">None</span>
              )}
              {recurringParent && (
                <span class="block text-xs font-normal text-slate-500">
                  Part of a recurring series — parent:{' '}
                  <a href={`/tasks/${recurringParent.id}`} class="font-medium text-brand-600 hover:underline">
                    #{recurringParent.id} {recurringParent.title}
                  </a>
                </span>
              )}
            </dd>
          </div>
          {task.updated_at && (
            <div>
              <dt class="text-xs uppercase text-slate-500">Last updated</dt>
              <dd class="mt-0.5 text-slate-700">{formatDbDate(task.updated_at)}</dd>
            </div>
          )}
          {completed && (
            <div>
              <dt class="text-xs uppercase text-slate-500">Completed</dt>
              <dd class="mt-0.5 font-medium text-slate-900">
                {formatDbDate(task.completed_at)}
                {task.completed_by_name && (
                  <span class="block text-xs font-normal text-slate-500">by {task.completed_by_name}</span>
                )}
              </dd>
            </div>
          )}
          {cancelled && (
            <div>
              <dt class="text-xs uppercase text-slate-500">Cancelled</dt>
              <dd class="mt-0.5 font-medium text-slate-900">
                {formatDbDate(task.cancelled_at)}
                {task.cancelled_by_name && (
                  <span class="block text-xs font-normal text-slate-500">by {task.cancelled_by_name}</span>
                )}
              </dd>
            </div>
          )}
        </dl>

        {task.description && (
          <div class="mt-5 border-t border-slate-100 pt-4">
            <h2 class="text-sm font-semibold text-slate-900">Description</h2>
            <p class="mt-1 whitespace-pre-wrap text-sm text-slate-700">{task.description}</p>
          </div>
        )}
      </div>

      {/* 1a. Locked field summary — employees only (CORE BUSINESS RULE #2). */}
      {showLockedSummary && (
        <section
          class="rounded-lg border border-slate-200 bg-slate-50 p-5"
          aria-label="Locked fields"
          data-locked-field-summary
        >
          <div class="flex items-start gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="mt-0.5 shrink-0 text-slate-500">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <div class="min-w-0 flex-1">
              <h2 class="text-sm font-semibold text-slate-900">Locked fields</h2>
              <p class="mt-0.5 text-xs text-slate-600">
                These fields are managed by a supervisor or manager. You can still update the status, progress, and blocker note below.
              </p>
              <ul class="mt-2 flex flex-wrap gap-1.5">
                {lockedFieldLabels.map((label) => (
                  <li class="inline-flex items-center rounded-full border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-600">
                    {label}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )}

      {/* 1b. Required evidence (from the task's frozen template snapshot). */}
      {evidenceRequirements.length > 0 && (
        <section aria-label="Required evidence" class="rounded-lg border border-slate-200 bg-white p-6">
          <h2 class="text-lg font-semibold text-slate-900">Required evidence</h2>
          <p class="mt-1 text-sm text-slate-500">
            {templateSnapshot && (
              <span>From template <span class="font-mono text-xs">{templateSnapshot.templateCode}</span> (snapshot v{templateSnapshot.snapshotVersion}). </span>
            )}
            Required items block task completion until uploaded.
          </p>
          <ul class="mt-3 space-y-1.5 text-sm">
            {evidenceRequirements.map((r) => (
              <li class={`flex items-center gap-2 ${coveredEvidenceTypes.has(r.type) ? 'text-emerald-700' : ''}`}>
                <span aria-hidden="true">{coveredEvidenceTypes.has(r.type) ? '✅' : r.requirement === 'REQUIRED' ? '⛔' : '➖'}</span>
                <span class="font-medium text-slate-800">{r.label}</span>
                <span class={`rounded px-1.5 py-0.5 text-xs font-medium ${r.requirement === 'REQUIRED' ? 'bg-rose-100 text-rose-700' : 'bg-slate-200 text-slate-600'}`}>
                  {r.requirement === 'REQUIRED' ? 'Required' : 'Optional'}
                </span>
                <span class="text-xs font-medium">{coveredEvidenceTypes.has(r.type) ? 'Collected' : 'Missing'}</span>
                {r.allowedExtensions && r.allowedExtensions.length > 0 && (
                  <span class="text-xs text-slate-400">.{r.allowedExtensions.join(', .')}</span>
                )}
                {r.description && <span class="text-xs text-slate-500">— {r.description}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* 1c. Lifecycle actions: complete wizard / cancel / reopen */}
      {(canEdit || canReopen) && (
        <section aria-label="Task actions">
          <TaskLifecycle
            taskId={task.id}
            title={task.title}
            status={task.status}
            canComplete={canEdit}
            canCancel={canCancel}
            canReopen={canReopen}
            incompleteChecklist={incompleteChecklist}
            canOverrideChecklist={canOverrideChecklist}
            evidenceRequirements={evidenceRequirements}
            existingEvidenceTypes={existingEvidenceTypes}
            canOverrideEvidence={canOverrideEvidence}
            client:visible
          />
        </section>
      )}

      {/* 1c. Update panel */}
      {canEdit && (
        <section aria-label="Edit task">
          <TaskUpdatePanel
            client:visible
            task={{
              id: task.id,
              title: task.title,
              description: task.description,
              department: task.department,
              status: task.status,
              priority: task.priority,
              progress_percent: task.progress_percent,
              assigned_to: task.assigned_to,
              due_date: task.due_date,
              recurrence: task.recurrence,
              recurrence_end_date: task.recurrence_end_date,
              blocker_note: task.blocker_note,
              inspection_type: task.inspection_type,
              finding_classification: task.finding_classification,
              risk_level: task.risk_level,
              corrective_action_required: task.corrective_action_required,
              reference_number: task.reference_number,
              audit_batch_or_work_order: task.audit_batch_or_work_order,
            }}
            canEditLocked={canEditLocked}
            canEditChecklistStructure={canEditChecklistStructureForTask}
            users={usersForAssignee}
            checklist={checklist.map((c) => ({
              id: c.id,
              title: c.title,
              is_completed: c.is_completed,
            }))}
            dependencies={dependencies}
            dependencyTasks={dependencyTasks.map((d) => ({
              task_id: d.id,
              title: d.title,
              status: d.status,
            }))}
            blockingDependencies={blockingDependencies.map((b) => ({
              task_id: b.task_id,
              title: b.title,
              status: b.status,
            }))}
            canOverrideDependencies={canOverrideDependencies}
          />
        </section>
      )}

      {/* 1c. Blocking dependencies callout (always visible — spec: show clearly) */}
      {blockingDependencies.length > 0 && (
        <div class="rounded-lg border-2 border-red-300 bg-red-50 p-4" role="alert" data-blocking-dependencies>
          <div class="flex items-start gap-2">
            <span class="mt-0.5 shrink-0 text-lg" aria-hidden="true">⛔</span>
            <div class="min-w-0 flex-1">
              <h2 class="text-sm font-semibold text-red-900">
                Blocked by {blockingDependencies.length} incomplete dependenc{blockingDependencies.length === 1 ? 'y' : 'ies'}
              </h2>
              <p class="mt-0.5 text-xs text-red-700">
                This task cannot move to In Progress until these are completed:
              </p>
              <ul class="mt-2 space-y-1">
                {blockingDependencies.map((b) => (
                  <li class="text-sm text-red-800">
                    <a href={`/tasks/${b.task_id}`} class="font-medium underline decoration-red-300 hover:text-red-900">
                      #{b.task_id} {b.title}
                    </a>{' '}
                    <span class="text-xs uppercase text-red-500">({b.status.replace(/_/g, ' ')})</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      )}

      {/* 2. Blocker note */}
      {task.blocker_note && (
        <div class="rounded-lg border border-amber-200 bg-amber-50 p-4" role="alert">
          <div class="flex items-start gap-2">
            <span set:html={svgIcon(ICON_SVG.blocker, 'mt-0.5 shrink-0 text-amber-600')} />
            <div>
              <h2 class="text-sm font-semibold text-amber-900">Blocker note</h2>
              <p class="mt-1 whitespace-pre-wrap text-sm text-amber-800">{task.blocker_note}</p>
            </div>
          </div>
        </div>
      )}

      {(task.inspection_type || task.finding_classification || task.risk_level || task.corrective_action_required !== null || task.reference_number || task.audit_batch_or_work_order) && (
        <section class="rounded-lg border border-slate-200 bg-white p-6" aria-label="QC metadata">
          <h2 class="mb-3 text-lg font-medium text-slate-900">QC metadata</h2>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm sm:grid-cols-3">
            <div><dt class="text-xs uppercase text-slate-500">Inspection type</dt><dd class="mt-0.5 text-slate-900">{task.inspection_type ?? '—'}</dd></div>
            <div><dt class="text-xs uppercase text-slate-500">Finding</dt><dd class="mt-0.5 text-slate-900">{task.finding_classification ?? '—'}</dd></div>
            <div><dt class="text-xs uppercase text-slate-500">Risk</dt><dd class="mt-0.5 text-slate-900">{task.risk_level ?? '—'}</dd></div>
            <div><dt class="text-xs uppercase text-slate-500">Corrective action</dt><dd class="mt-0.5 text-slate-900">{task.corrective_action_required === null ? '—' : task.corrective_action_required ? 'Required' : 'Not required'}</dd></div>
            <div><dt class="text-xs uppercase text-slate-500">Reference</dt><dd class="mt-0.5 text-slate-900">{task.reference_number ?? '—'}</dd></div>
            <div><dt class="text-xs uppercase text-slate-500">Audit batch / work order</dt><dd class="mt-0.5 text-slate-900">{task.audit_batch_or_work_order ?? '—'}</dd></div>
          </dl>
        </section>
      )}

      {/* 2b. Checklist (static display when the edit panel is hidden) */}
      {!canEdit && (
        <section class="rounded-lg border border-slate-200 bg-white p-6">
          <h2 class="mb-1 text-lg font-medium text-slate-900">Checklist</h2>
          <p class="mb-3 text-sm text-slate-600">{checklist.filter((c) => c.is_completed).length}/{checklist.length} complete · {checklist.length ? Math.round((checklist.filter((c) => c.is_completed).length / checklist.length) * 100) : 0}%</p>
          <ul class="space-y-1.5" data-checklist>
            {checklist.map((c) => (
              <li class="flex items-center gap-2 text-sm">
                <input
                  type="checkbox"
                  checked={c.is_completed}
                  disabled
                  class="h-4 w-4 rounded border-slate-300 text-emerald-600"
                  aria-label={c.title}
                />
                <span class={c.is_completed ? 'text-slate-400 line-through' : 'text-slate-800'}>{c.title}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* 2c. Dependencies (static display when the edit panel is hidden) */}
      {dependencies.length > 0 && !canEditLocked && (
        <section class="rounded-lg border border-slate-200 bg-white p-6">
          <h2 class="mb-3 text-lg font-medium text-slate-900">Dependencies</h2>
          <ul class="space-y-1.5" data-dependencies>
            {dependencies.map((d) => {
              const blocked = d.status !== 'completed' && d.status !== 'cancelled';
              return (
                <li class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-slate-200 px-3 py-2 text-sm">
                  <a href={`/tasks/${d.task_id}`} class="font-medium text-slate-800 hover:underline">
                    #{d.task_id} {d.title}
                  </a>
                  <span
                    class={`text-xs uppercase ${
                      blocked ? 'font-semibold text-red-600' : 'text-emerald-600'
                    }`}
                  >
                    {d.status.replace(/_/g, ' ')}
                  </span>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {/* 3. Comments */}
      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="mb-4 text-lg font-medium text-slate-900">Comments</h2>
        {regularComments.length === 0 && !closureComment && (
          <EmptyState title="No comments yet" hint="Start the conversation — post the first comment below." />
        )}
        {closureComment && (
          <div class="mb-4 rounded-md border border-indigo-200 bg-indigo-50 px-4 py-3">
            <p class="text-xs font-semibold uppercase text-indigo-600">Completion comment</p>
            <p class="mt-1 whitespace-pre-wrap text-sm text-slate-800">{closureComment.comment}</p>
            <p class="mt-1 text-xs text-indigo-500">{closureComment.full_name} · {formatDbDate(closureComment.created_at)}</p>
          </div>
        )}
        <CommentBox
          taskId={task.id}
          taskStatus={task.status}
          comments={regularComments}
          client:visible
        />
      </section>

      {/* 4. Attachments */}
      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="mb-4 text-lg font-medium text-slate-900">Attachments</h2>
        {attachments.length === 0 ? (
          <EmptyState title="No attachments yet" hint="Upload evidence or supporting files for this task." />
        ) : (
          <ul class="divide-y divide-slate-100">
            {attachments.map((a) => (
              <li class="flex flex-wrap items-center justify-between gap-3 py-3">
                <div class="flex min-w-0 items-center gap-3">
                  <span set:html={svgIcon(ICON_SVG.evidence, 'shrink-0 text-slate-400')} />
                  <div class="min-w-0">
                    <p class="truncate text-sm font-medium text-slate-900" title={a.file_name}>{a.file_name}</p>
                    <p class="text-xs text-slate-500">
                      {humanFileSize(a.file_size)} · uploaded by {a.uploader} on {formatDbDate(a.uploaded_at)}
                    </p>
                    {a.file_hash && (
                      <p class="mt-0.5 font-mono text-[11px] text-slate-400" title={`SHA-256: ${a.file_hash}`}>
                        sha256:{a.file_hash.slice(0, 12)}…
                      </p>
                    )}
                  </div>
                </div>
                <a
                  href={`/api/tasks/${task.id}/attachments/${a.id}`}
                  class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
                >
                  Download
                </a>
              </li>
            ))}
          </ul>
        )}
        {canEdit && <AttachmentUploader taskId={task.id} client:visible />}
      </section>

      {/* 5. Activity history */}
      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="mb-4 text-lg font-medium text-slate-900">Activity history</h2>
        {activity.length === 0 ? (
          <p class="rounded-md border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-500">
            No activity recorded yet.
          </p>
        ) : (
          <ol class="relative space-y-5">
            {activity.map((a) => {
              const cat = actionCategory(a.action);
              return (
                <li class="flex gap-3">
                  <span class={`mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full ${ICON_TONE[cat] ?? 'bg-slate-100 text-slate-500'}`} set:html={svgIcon(ICON_SVG[cat] ?? ICON_SVG.other)} />
                  <div class="min-w-0">
                    <p class="text-sm text-slate-800">
                      <span class="font-semibold text-slate-900">{a.user_name}</span>{' '}
                      {describeAction(a.action, a.old_value, a.new_value)}
                    </p>
                    <p class="text-xs text-slate-500">{formatDbDate(a.created_at)}</p>
                  </div>
                </li>
              );
            })}
          </ol>
        )}
      </section>

      {/* 6. Closure info */}
      {completed && (
        <section class="rounded-lg border border-emerald-200 bg-emerald-50 p-6">
          <h2 class="text-lg font-medium text-emerald-900">Task completed</h2>
          <p class="mt-1 text-sm text-emerald-800">
            ✅ Completed by <span class="font-semibold">{task.completed_by_name ?? 'Unknown'}</span> on{' '}
            {formatDbDate(task.completed_at)}
          </p>
          <div class="mt-3 rounded-md border border-emerald-200 bg-white px-4 py-3 text-sm text-slate-700">
            {evidenceFiles.length > 0 ? (
              <div class="space-y-1">
                <span class="font-medium">Evidence files:</span>
                <ul class="mt-1 space-y-1" data-evidence-files>
                  {evidenceFiles.map((ef) => (
                    <li class="flex flex-wrap items-center gap-2">
                      <span set:html={svgIcon(ICON_SVG.evidence, 'shrink-0 text-emerald-600')} />
                      <a
                        href={`/api/tasks/${task.id}/attachments/${ef.id}`}
                        class="font-medium text-brand-600 hover:underline"
                      >
                        {ef.file_name}
                      </a>
                      <span class="text-xs text-slate-500">({humanFileSize(ef.file_size)} · {ef.uploader})</span>
                      {ef.file_hash && (
                        <span class="font-mono text-[11px] text-slate-400" title={`SHA-256: ${ef.file_hash}`}>
                          sha256:{ef.file_hash.slice(0, 12)}…
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ) : evidence?.kind === 'skipped' ? (
              <span class="font-medium text-amber-700">Evidence skipped</span>
            ) : (
              <span>No evidence recorded.</span>
            )}
          </div>
        </section>
      )}
    </div>
  </BaseLayout>
) : null}
