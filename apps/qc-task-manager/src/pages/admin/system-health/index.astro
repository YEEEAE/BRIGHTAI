---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getSystemHealth } from '../../../lib/systemHealth';

const health = getSystemHealth();
const formatDate = (value: string | null | undefined) => value ? new Date(value).toLocaleString('en-GB', { timeZone: 'Asia/Riyadh' }) : 'Never';
const formatBytes = (value: number | null) => value === null ? 'Unavailable' : value < 1024 ? `${value} B` : value < 1024 ** 2 ? `${(value / 1024).toFixed(1)} KB` : `${(value / 1024 ** 2).toFixed(2)} MB`;
const backupAge = health.backup.status.lastSuccessAt ? Math.max(0, Date.now() - new Date(health.backup.status.lastSuccessAt).getTime()) : null;
const statusClass = (ok: boolean) => ok ? 'text-emerald-700' : 'text-red-700';
---

<BaseLayout title="System health">
  <header class="mb-6 flex flex-wrap items-start justify-between gap-4"><div><h1 class="text-2xl font-semibold text-slate-900">System health</h1><p class="mt-1 text-sm text-slate-600">Admin-only operational diagnostics for SQLite, backups, and audit integrity.</p></div><a href="/admin/settings" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Backup settings</a></header>
  {health.disk.warning && <p class="mb-6 rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900" role="alert">Disk usage warning: the database, WAL, and retained backups are approaching disk capacity.</p>}
  <div class="grid gap-6 lg:grid-cols-2">
    <section class="rounded-lg border border-slate-200 bg-white p-6"><h2 class="text-lg font-semibold text-slate-900">Runtime</h2><dl class="mt-4 grid gap-3 text-sm"><div><dt class="text-slate-500">App version</dt><dd class="font-mono text-slate-900">{health.identity.version}</dd></div><div><dt class="text-slate-500">Commit</dt><dd class="break-all font-mono text-slate-900">{health.identity.commit}</dd></div><div><dt class="text-slate-500">DB path</dt><dd class="font-mono text-slate-900">{health.dbPath}</dd></div><div><dt class="text-slate-500">DB file size</dt><dd>{formatBytes(health.dbSize)}</dd></div><div><dt class="text-slate-500">WAL size</dt><dd>{formatBytes(health.walSize)}</dd></div></dl></section>
    <section class="rounded-lg border border-slate-200 bg-white p-6"><h2 class="text-lg font-semibold text-slate-900">Schema and SQLite</h2><dl class="mt-4 grid gap-3 text-sm"><div><dt class="text-slate-500">Schema version</dt><dd>{health.schemaVersion}</dd></div><div><dt class="text-slate-500">Latest migration</dt><dd class="font-mono">{health.latestMigration ? `${health.latestMigration.version} — ${health.latestMigration.name}` : 'None'}</dd></div><div><dt class="text-slate-500">Migration failures</dt><dd class={statusClass(health.migrationFailureCount === 0)}>{health.migrationFailureCount}</dd></div><div><dt class="text-slate-500">Foreign keys</dt><dd class={statusClass(health.foreignKeys.enabled && health.foreignKeys.violations === 0)}>{health.foreignKeys.enabled ? 'Enabled' : 'Disabled'} / {health.foreignKeys.violations} violations</dd></div><div><dt class="text-slate-500">Integrity</dt><dd class={statusClass(health.integrity.status === 'PASS')}>{health.integrity.status}</dd></div></dl></section>
    <section class="rounded-lg border border-slate-200 bg-white p-6"><h2 class="text-lg font-semibold text-slate-900">Backup health</h2><dl class="mt-4 grid gap-3 text-sm"><div><dt class="text-slate-500">Last successful backup</dt><dd>{formatDate(health.backup.status.lastSuccessAt)}</dd></div><div><dt class="text-slate-500">Backup age</dt><dd>{backupAge === null ? 'Never' : `${Math.floor(backupAge / 3600000)}h ${Math.floor(backupAge / 60000) % 60}m`}</dd></div><div><dt class="text-slate-500">Last backup size</dt><dd>{formatBytes(health.backup.status.lastBackupSize)}</dd></div><div><dt class="text-slate-500">Last verification</dt><dd class={statusClass(health.backup.status.lastVerificationResult === 'PASS')}>{health.backup.status.lastVerificationResult ?? 'Never'} ({formatDate(health.backup.status.lastVerificationAt)})</dd></div><div><dt class="text-slate-500">Latest file</dt><dd class="break-all font-mono">{health.backup.latest?.name ?? 'None'}</dd></div></dl></section>
    <section class="rounded-lg border border-slate-200 bg-white p-6"><h2 class="text-lg font-semibold text-slate-900">Audit and disk</h2><dl class="mt-4 grid gap-3 text-sm"><div><dt class="text-slate-500">Task audit chain</dt><dd class={statusClass(health.audit.task.status === 'PASS')}>{health.audit.task.status}</dd></div><div><dt class="text-slate-500">QC/Lab audit chain</dt><dd class={statusClass(health.audit.qcLab.status === 'PASS')}>{health.audit.qcLab.status}</dd></div><div><dt class="text-slate-500">Disk free</dt><dd>{formatBytes(health.disk.availableBytes)}</dd></div><div><dt class="text-slate-500">DB + WAL + backups</dt><dd>{formatBytes(health.disk.appBytes)}</dd></div><div><dt class="text-slate-500">Disk warning</dt><dd class={statusClass(!health.disk.warning)}>{health.disk.warning ? 'WARN' : 'OK'}</dd></div></dl></section>
  </div>
</BaseLayout>
