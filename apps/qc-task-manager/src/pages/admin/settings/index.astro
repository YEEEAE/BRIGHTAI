---
// Admin settings — backup status and manual backup control.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { BACKUP_DIR } from '../../../lib/db';
import { getBackupStatus, listBackups, verifyBackup } from '../../../lib/backup';

const status = getBackupStatus(BACKUP_DIR);
const backups = listBackups(BACKUP_DIR);
const latest = backups[0];
const verification = latest ? await verifyBackup({ file: latest.file, metadataFile: latest.metadataFile }) : null;

function formatDate(value: string | null): string {
  if (!value) return 'Never';
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? value : date.toLocaleString('en-GB', { timeZone: 'Asia/Riyadh' });
}

function formatBytes(value: number | null): string {
  if (value === null) return '—';
  if (value < 1024) return `${value} B`;
  if (value < 1024 * 1024) return `${(value / 1024).toFixed(1)} KB`;
  return `${(value / (1024 * 1024)).toFixed(2)} MB`;
}

const stateLabel = status.state === 'success' ? 'Healthy' : status.state === 'failure' ? 'Failed' : 'Not started';
const stateClass = status.state === 'success' ? 'bg-emerald-100 text-emerald-700' : status.state === 'failure' ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-600';
---

<BaseLayout title="Admin settings">
  <header class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Admin settings</h1>
      <p class="mt-1 text-sm text-slate-600">Server-side settings and database backup health.</p>
    </div>
    <div class="flex flex-wrap gap-2"><a href="/admin/system-health" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">System health</a><a href="/admin/users" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Users</a></div>
  </header>

  <section class="rounded-lg border border-slate-200 bg-white p-6" aria-labelledby="backup-heading">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 id="backup-heading" class="text-lg font-semibold text-slate-900">Database backups</h2>
        <p class="mt-1 text-sm text-slate-500">Automatic backup runs daily at 02:00 Riyadh time. The latest 14 backups are retained.</p>
      </div>
      <span data-backup-state class={`rounded-full px-3 py-1 text-xs font-semibold ${stateClass}`}>{stateLabel}</span>
    </div>

    <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-md bg-slate-50 p-4"><dt class="text-xs font-medium uppercase text-slate-500">Last backup</dt><dd class="mt-1 text-sm font-semibold text-slate-900">{formatDate(status.lastSuccessAt)}</dd></div>
      <div class="rounded-md bg-slate-50 p-4"><dt class="text-xs font-medium uppercase text-slate-500">Backup size</dt><dd class="mt-1 text-sm font-semibold text-slate-900">{formatBytes(status.lastBackupSize)}</dd></div>
      <div class="rounded-md bg-slate-50 p-4"><dt class="text-xs font-medium uppercase text-slate-500">Last attempt</dt><dd class="mt-1 text-sm font-semibold text-slate-900">{formatDate(status.lastAttemptAt)}</dd></div>
      <div class="rounded-md bg-slate-50 p-4"><dt class="text-xs font-medium uppercase text-slate-500">Last verification</dt><dd class={`mt-1 text-sm font-semibold ${verification?.result === 'PASS' ? 'text-emerald-700' : verification ? 'text-red-700' : 'text-slate-900'}`}>{verification?.result ?? status.lastVerificationResult ?? 'Never'}</dd></div>
      <div class="rounded-md bg-slate-50 p-4"><dt class="text-xs font-medium uppercase text-slate-500">Latest file</dt><dd class="mt-1 break-all text-sm font-semibold text-slate-900">{status.lastBackupName ?? '—'}</dd></div>
      <div class="rounded-md bg-slate-50 p-4"><dt class="text-xs font-medium uppercase text-slate-500">Stored backups</dt><dd class="mt-1 text-sm font-semibold text-slate-900">{backups.length} / {Number(import.meta.env.QC_BACKUP_RETENTION ?? 14)}</dd></div>
    </dl>

    {status.state === 'failure' && <p class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert">Last backup failed: {status.lastError ?? 'Unknown error.'}</p>}

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <form action="/api/admin/backup" method="POST">
        <button type="submit" class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">Create backup now</button>
      </form>
      <p class="text-xs text-slate-500">Manual backups use a consistent SQLite snapshot and are verified before being marked PASS.</p>
    </div>
  </section>

  <section class="mt-6 overflow-x-auto rounded-lg border border-slate-200 bg-white" aria-labelledby="backup-list-heading">
    <div class="border-b border-slate-200 px-6 py-4"><h2 id="backup-list-heading" class="text-lg font-semibold text-slate-900">Recent backups</h2></div>
    <table class="w-full min-w-[620px] text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500"><tr><th class="px-6 py-3">File</th><th class="px-6 py-3">Created</th><th class="px-6 py-3">Size</th></tr></thead>
      <tbody class="divide-y divide-slate-200">
        {backups.length === 0 ? <tr><td colspan="3" class="px-6 py-8 text-center text-slate-500">No backups have been created yet.</td></tr> : backups.map((backup) => <tr><td class="px-6 py-3 font-mono text-xs text-slate-700">{backup.name}</td><td class="px-6 py-3 text-slate-600">{formatDate(backup.modifiedAt)}</td><td class="px-6 py-3 text-slate-600">{formatBytes(backup.size)}</td></tr>)}
      </tbody>
    </table>
  </section>
</BaseLayout>
