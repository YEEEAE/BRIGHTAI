---
// Create a new task template (admin only). New templates start in DRAFT and
// must be activated before they can be instantiated into tasks.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EvidenceRequirementsInput from '../../../components/EvidenceRequirementsInput.tsx';

const user = Astro.locals.user!;

const inputCls =
  'mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500';
const labelCls = 'block text-sm font-medium text-slate-700';
---

<BaseLayout title="New Template">
  <header class="mb-6">
    <h1 class="text-2xl font-semibold text-slate-900">New template</h1>
    <p class="text-sm text-slate-600">Define a reusable task configuration. Signed in as {user.fullName}.</p>
  </header>

  <form action="/admin/templates/api" method="POST" class="space-y-6">
    <input type="hidden" name="action" value="create" />

    <section class="rounded-lg border border-slate-200 bg-white p-6">
      <h2 class="text-lg font-semibold text-slate-900">Basics</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="code" class={labelCls}>Code (unique slug)</label>
          <input id="code" name="code" type="text" required placeholder="daily-inspection" pattern="[a-z0-9-]+" class={inputCls} />
          <p class="mt-1 text-xs text-slate-400">Lowercase letters, digits, hyphens. Used as a stable identifier.</p>
        </div>
        <div>
          <label for="title" class={labelCls}>Title</label>
          <input id="title" name="title" type="text" required placeholder="Daily Inspection" class={inputCls} />
        </div>
        <div class="sm:col-span-2">
          <label for="description" class={labelCls}>Description</label>
          <textarea id="description" name="description" rows="3" class={inputCls}></textarea>
        </div>
        <div>
          <label for="department" class={labelCls}>Department</label>
          <input id="department" name="department" type="text" required value="QC" class={inputCls} />
        </div>
        <div>
          <label for="priority" class={labelCls}>Priority</label>
          <select id="priority" name="priority" class={inputCls}>
            <option value="low">Low</option>
            <option value="medium" selected>Medium</option>
            <option value="high">High</option>
            <option value="urgent">Urgent</option>
          </select>
        </div>
        <div>
          <label for="task_type" class={labelCls}>Task type (optional)</label>
          <input id="task_type" name="task_type" type="text" placeholder="inspection / audit / review" class={inputCls} />
        </div>
        <div>
          <label for="recurrence" class={labelCls}>Recurrence</label>
          <select id="recurrence" name="recurrence" class={inputCls}>
            <option value="none" selected>None</option>
            <option value="daily">Daily</option>
            <option value="weekly">Weekly</option>
            <option value="monthly">Monthly</option>
          </select>
        </div>
      </div>
    </section>

    <section class="rounded-lg border border-slate-200 bg-white p-6">
      <h2 class="text-lg font-semibold text-slate-900">Checklist</h2>
      <p class="mt-1 text-sm text-slate-500">One item per line. Copied (unchecked) onto each task created from this template.</p>
      <textarea id="checklist_text" name="checklist_text" rows="4" placeholder={"Check gauges&#10;Sign report&#10;Submit to supervisor"} class={`mt-3 ${inputCls}`}></textarea>
    </section>

    <section class="rounded-lg border border-slate-200 bg-white p-6">
      <h2 class="text-lg font-semibold text-slate-900">Required evidence</h2>
      <p class="mt-1 text-sm text-slate-500">Declare the evidence files a task must collect. Required items block completion until uploaded.</p>
      <div class="mt-4">
        <EvidenceRequirementsInput client:visible />
      </div>
    </section>

    <section class="rounded-lg border border-slate-200 bg-white p-6">
      <h2 class="text-lg font-semibold text-slate-900">Finding defaults (optional)</h2>
      <p class="mt-1 text-sm text-slate-500">Pre-filled QC metadata on tasks created from this template. JSON object.</p>
      <textarea id="finding_defaults_json" name="finding_defaults_json" rows="3" placeholder={'{"inspectionType":"daily_walkdown","severity":"low"}'} class={`mt-3 ${inputCls}`}></textarea>
    </section>

    <div class="flex items-center justify-end gap-3">
      <a href="/admin/templates" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</a>
      <button type="submit" class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2">Create template</button>
    </div>
  </form>
</BaseLayout>
