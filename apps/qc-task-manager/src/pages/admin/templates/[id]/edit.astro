---
// Edit / view a task template (admin only). Shows the lifecycle banner and
// disables the form when ARCHIVED (read-only). Instantiating an ACTIVE template
// is available via a separate action.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import EvidenceRequirementsInput from '../../../../components/EvidenceRequirementsInput.tsx';
import { getTemplate } from '../../../../lib/templatesStore';
import { TEMPLATE_LIFECYCLE_LABELS } from '../../../../lib/templates';

const user = Astro.locals.user!;
const id = Number(Astro.params.id);
const template = Number.isInteger(id) && id > 0 ? getTemplate(id) : undefined;
if (!template) {
  return Astro.redirect('/admin/templates');
}

const isArchived = template.lifecycle_status === 'ARCHIVED';
const checklistText = template.checklist.map((c) => c.title).join('\n');
const findingDefaultsJson = JSON.stringify(template.findingDefaults, null, 2);

const inputCls =
  'mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500';
const labelCls = 'block text-sm font-medium text-slate-700';
const STATUS_BADGE: Record<string, string> = {
  DRAFT: 'bg-slate-100 text-slate-700',
  ACTIVE: 'bg-emerald-100 text-emerald-700',
  ARCHIVED: 'bg-rose-100 text-rose-700',
};
---

<BaseLayout title={`Edit: ${template.title}`}>
  <header class="mb-6">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-2xl font-semibold text-slate-900">{template.title}</h1>
      <span class={`inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium ${STATUS_BADGE[template.lifecycle_status]}`}>
        {TEMPLATE_LIFECYCLE_LABELS[template.lifecycle_status]}
      </span>
      <span class="font-mono text-xs text-slate-400">{template.code} · v{template.version}</span>
    </div>
    <p class="text-sm text-slate-600">Edit the template configuration. Signed in as {user.fullName}.</p>
  </header>

  {isArchived && (
    <div class="mb-6 rounded-md border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
      This template is archived and read-only. Unarchive it to make changes.
    </div>
  )}

  {template.lifecycle_status === 'ACTIVE' && (
    <section class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 p-4">
      <h2 class="text-sm font-semibold text-emerald-800">Create a task from this template</h2>
      <form action="/admin/templates/api" method="POST" class="mt-3 grid gap-3 sm:grid-cols-3">
        <input type="hidden" name="action" value="instantiate" />
        <input type="hidden" name="template_id" value={template.id} />
        <input type="text" name="title" placeholder={`Override title (default: ${template.title})`} class={inputCls} />
        <input type="date" name="due_date" class={inputCls} />
        <button type="submit" class="rounded-md border border-emerald-300 bg-white px-4 py-2 text-sm font-medium text-emerald-700 hover:bg-emerald-100">New task</button>
      </form>
    </section>
  )}

  <form action="/admin/templates/api" method="POST" class={`space-y-6 ${isArchived ? 'opacity-60' : ''}`}>
    <input type="hidden" name="action" value="edit" />
    <input type="hidden" name="template_id" value={template.id} />
    <fieldset disabled={isArchived} class="space-y-6">

      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-900">Basics</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <label for="code" class={labelCls}>Code (immutable)</label>
            <input id="code" type="text" value={template.code} disabled class={`${inputCls} bg-slate-100 text-slate-500`} />
          </div>
          <div>
            <label for="title" class={labelCls}>Title</label>
            <input id="title" name="title" type="text" required value={template.title} class={inputCls} />
          </div>
          <div class="sm:col-span-2">
            <label for="description" class={labelCls}>Description</label>
            <textarea id="description" name="description" rows="3" class={inputCls}>{template.description ?? ''}</textarea>
          </div>
          <div>
            <label for="department" class={labelCls}>Department</label>
            <input id="department" name="department" type="text" required value={template.department} class={inputCls} />
          </div>
          <div>
            <label for="priority" class={labelCls}>Priority</label>
            <select id="priority" name="priority" class={inputCls}>
              <option value="low" selected={template.priority === 'low'}>Low</option>
              <option value="medium" selected={template.priority === 'medium'}>Medium</option>
              <option value="high" selected={template.priority === 'high'}>High</option>
              <option value="urgent" selected={template.priority === 'urgent'}>Urgent</option>
            </select>
          </div>
          <div>
            <label for="task_type" class={labelCls}>Task type</label>
            <input id="task_type" name="task_type" type="text" value={template.task_type ?? ''} class={inputCls} />
          </div>
          <div>
            <label for="recurrence" class={labelCls}>Recurrence</label>
            <select id="recurrence" name="recurrence" class={inputCls}>
              <option value="none" selected={template.recurrence === 'none'}>None</option>
              <option value="daily" selected={template.recurrence === 'daily'}>Daily</option>
              <option value="weekly" selected={template.recurrence === 'weekly'}>Weekly</option>
              <option value="monthly" selected={template.recurrence === 'monthly'}>Monthly</option>
            </select>
          </div>
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-900">Checklist</h2>
        <p class="mt-1 text-sm text-slate-500">One item per line. Copied (unchecked) onto each task.</p>
        <textarea id="checklist_text" name="checklist_text" rows="4" class={`mt-3 ${inputCls}`}>{checklistText}</textarea>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-900">Required evidence</h2>
        <p class="mt-1 text-sm text-slate-500">Required items block task completion until uploaded.</p>
        <div class="mt-4">
          <EvidenceRequirementsInput client:visible initial={template.evidenceRequirements} />
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-900">Finding defaults</h2>
        <p class="mt-1 text-sm text-slate-500">Pre-filled QC metadata. JSON object.</p>
        <textarea id="finding_defaults_json" name="finding_defaults_json" rows="3" class={`mt-3 ${inputCls}`}>{findingDefaultsJson}</textarea>
      </section>
    </fieldset>

    <div class="flex items-center justify-between gap-3">
      <a href="/admin/templates" class="text-sm font-medium text-slate-600 hover:text-slate-900">← Back to templates</a>
      {!isArchived && (
        <button type="submit" class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2">Save changes</button>
      )}
    </div>
  </form>
</BaseLayout>
