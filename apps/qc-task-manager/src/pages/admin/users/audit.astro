---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PERMISSIONS } from '../../../lib/permissions';
import {
  listUserAuditActors,
  listUserAuditTargets,
  parseUserAuditFilters,
  searchUserAuditTimeline,
  USER_AUDIT_ACTIONS,
  USER_AUDIT_ACTION_LABELS,
} from '../../../lib/audit/userTimeline';

const user = Astro.locals.user!;
if (!PERMISSIONS.canViewUserAudit(user.role)) return Astro.redirect('/');
const filters = parseUserAuditFilters(Astro.url.searchParams);
const entries = searchUserAuditTimeline(filters);
const actors = listUserAuditActors();
const targets = listUserAuditTargets();
const hasFilters = Boolean(filters.action || filters.actor || filters.target || filters.from || filters.to);
---

<BaseLayout title="User Audit Log">
  <header class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-sm font-medium text-brand-700">Administration</p>
      <h1 class="mt-1 text-2xl font-semibold text-slate-900">User audit log</h1>
      <p class="mt-1 text-sm text-slate-600">Durable, hash-chained administration events from the shared audit log.</p>
    </div>
    <a href="/admin/users" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Back to users</a>
  </header>

  <form method="GET" class="mb-6 grid gap-3 rounded-lg border border-slate-200 bg-white p-4 sm:grid-cols-2 lg:grid-cols-5">
    <label class="text-sm font-medium text-slate-700">Action
      <select name="action" class="mt-1 block w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm">
        <option value="">All actions</option>
        {USER_AUDIT_ACTIONS.map((action) => <option value={action} selected={filters.action === action}>{USER_AUDIT_ACTION_LABELS[action]}</option>)}
      </select>
    </label>
    <label class="text-sm font-medium text-slate-700">Actor
      <select name="actor" class="mt-1 block w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm">
        <option value="">All actors</option>
        {actors.map((actor) => <option value={actor.id} selected={filters.actor === actor.id}>{actor.full_name}</option>)}
      </select>
    </label>
    <label class="text-sm font-medium text-slate-700">Target user
      <select name="target" class="mt-1 block w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm">
        <option value="">All users</option>
        {targets.map((target) => <option value={target.id} selected={filters.target === target.id}>{target.full_name} ({target.username})</option>)}
      </select>
    </label>
    <label class="text-sm font-medium text-slate-700">From <input type="date" name="from" value={filters.from ?? ''} class="mt-1 block w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm" /></label>
    <label class="text-sm font-medium text-slate-700">To <input type="date" name="to" value={filters.to ?? ''} class="mt-1 block w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm" /></label>
    <div class="flex items-end gap-2 sm:col-span-2 lg:col-span-5">
      <button type="submit" class="rounded-md bg-brand-600 px-3 py-2 text-sm font-medium text-white hover:bg-brand-700">Apply filters</button>
      {hasFilters && <a href="/admin/users/audit" class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Clear</a>}
    </div>
  </form>

  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="w-full min-w-[900px] text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500"><tr><th class="px-4 py-2.5">When</th><th class="px-4 py-2.5">Actor</th><th class="px-4 py-2.5">Target</th><th class="px-4 py-2.5">Action</th><th class="px-4 py-2.5">Before / after</th><th class="px-4 py-2.5">Reason</th></tr></thead>
      <tbody class="divide-y divide-slate-200">
        {entries.map((entry) => <tr class="align-top hover:bg-slate-50">
          <td class="whitespace-nowrap px-4 py-3 text-slate-600">{entry.created_at}</td>
          <td class="px-4 py-3"><span class="font-medium text-slate-900">{entry.actor_name}</span><span class="block text-xs text-slate-500">{entry.actor_username}</span></td>
          <td class="px-4 py-3"><span class="font-medium text-slate-900">{entry.target_name}</span><span class="block text-xs text-slate-500">{entry.target_username}</span></td>
          <td class="px-4 py-3 font-medium text-slate-800">{USER_AUDIT_ACTION_LABELS[entry.action]}</td>
          <td class="max-w-md px-4 py-3 text-xs text-slate-600"><details><summary class="cursor-pointer text-brand-700">View changes</summary><pre class="mt-2 whitespace-pre-wrap rounded bg-slate-50 p-2">{JSON.stringify({ before: entry.old_value ? JSON.parse(entry.old_value) : null, after: entry.new_value ? JSON.parse(entry.new_value) : null }, null, 2)}</pre></details></td>
          <td class="px-4 py-3 text-slate-600">{entry.note ?? '—'}</td>
        </tr>)}
        {entries.length === 0 && <tr><td colspan="6" class="px-4 py-10 text-center text-slate-500">No user audit events match these filters.</td></tr>}
      </tbody>
    </table>
  </div>
</BaseLayout>
