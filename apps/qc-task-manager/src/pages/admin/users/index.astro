---
// Admin user management (admin only). Lands here after login as admin.
//
// Sections:
//   1. "Create user" form → POST /admin/users/api (action=create).
//   2. Users table: username, full name, role badge, department,
//      can_create_tasks, active status, created date, per-row actions
//      (deactivate/activate, reset password, can-create toggle for employees).
//
// Safety rules (enforced in the UI AND in src/lib/users.ts):
//   - The admin's own row cannot be deactivated.
//   - Username is never editable.
//   - Password hashes are never selected or displayed.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatusPill from '../../../components/ui/StatusPill.astro';
import { getDb, toBool } from '../../../lib/db';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const db = getDb();
const users = db
  .prepare(
    `SELECT id, username, full_name, department, role, can_create_tasks, is_active, created_at, last_login_at
     FROM users ORDER BY id`,
  )
  .all() as {
    id: number;
    username: string;
    full_name: string;
    department: string;
    role: string;
    can_create_tasks: number;
    is_active: number;
    created_at: string;
    last_login_at: string | null;
  }[];

const ROLE_BADGE: Record<string, string> = {
  admin: 'bg-purple-100 text-purple-700',
  manager: 'bg-blue-100 text-blue-700',
  supervisor: 'bg-amber-100 text-amber-700',
  employee: 'bg-slate-100 text-slate-600',
};

/** SQLite datetime('now') is "YYYY-MM-DD HH:MM:SS" (UTC) — render as a short date. */
function formatDate(value: string): string {
  const iso = value.includes('T') ? value : `${value.replace(' ', 'T')}Z`;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return value;
  return d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
}

const inputCls =
  'mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500';
const labelCls = 'block text-sm font-medium text-slate-700';
---

<BaseLayout title="Users">
  <header class="mb-6">
    <h1 class="text-2xl font-semibold text-slate-900">Users</h1>
    <p class="text-sm text-slate-600">Admin user management. Signed in as {user.fullName} ({user.role}).</p>
  </header>

  <!-- 1. Create user -->
  <section class="mb-8 rounded-lg border border-slate-200 bg-white p-6">
    <h2 class="text-lg font-semibold text-slate-900">Create user</h2>
    <p class="mt-1 text-sm text-slate-500">The account is active immediately and can sign in right away.</p>

    <form action="/admin/users/api" method="POST" class="mt-4 grid gap-4 sm:grid-cols-2">
      <input type="hidden" name="action" value="create" />

      <div>
        <label for="username" class={labelCls}>Username</label>
        <input id="username" name="username" type="text" required autocomplete="off" class={inputCls} />
      </div>

      <div>
        <label for="full_name" class={labelCls}>Full name</label>
        <input id="full_name" name="full_name" type="text" required autocomplete="off" class={inputCls} />
      </div>

      <div>
        <label for="password" class={labelCls}>Password</label>
        <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" class={inputCls} />
        <p class="mt-1 text-xs text-slate-400">At least 8 characters.</p>
      </div>

      <div>
        <label for="role" class={labelCls}>Role</label>
        <select id="role" name="role" required class={inputCls}>
          <option value="employee">Employee</option>
          <option value="supervisor">Supervisor</option>
          <option value="manager">Manager</option>
          <option value="admin">Admin</option>
        </select>
      </div>

      <div>
        <label for="department" class={labelCls}>Department</label>
        <input id="department" name="department" type="text" value="QC" required class={inputCls} />
        <p class="mt-1 text-xs text-slate-400">Defaults to QC.</p>
      </div>

      <label class="flex items-start gap-2 pt-5 text-sm text-slate-700 sm:col-span-2">
        <input type="checkbox" name="can_create_tasks" value="1" class="mt-0.5 h-4 w-4 rounded border-slate-300 text-brand-600" />
        <span>
          Allow this user to create tasks
          <span class="block text-xs text-slate-400">Only applies to employee accounts.</span>
        </span>
      </label>

      <div class="sm:col-span-2">
        <button
          type="submit"
          class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"
        >
          Create user
        </button>
      </div>
    </form>
  </section>

  <!-- 2. Users table -->
  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="w-full min-w-max text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
        <tr>
          <th class="px-4 py-2">#</th>
          <th class="px-4 py-2">Username</th>
          <th class="px-4 py-2">Name</th>
          <th class="px-4 py-2">Role</th>
          <th class="px-4 py-2">Department</th>
          <th class="px-4 py-2">Can create</th>
          <th class="px-4 py-2">Active</th>
          <th class="px-4 py-2">Created</th>
          <th class="px-4 py-2">Last login</th>
          <th class="px-4 py-2">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        {users.map((u) => {
          const isSelf = u.id === user.userId;
          return (
            <tr class="align-top hover:bg-slate-50">
              <td class="px-4 py-2 text-slate-500">{u.id}</td>
              <td class="px-4 py-2 font-medium text-slate-900">{u.username}</td>
              <td class="px-4 py-2 text-slate-600">{u.full_name}</td>
              <td class="px-4 py-2">
                <span class={`rounded px-1.5 py-0.5 text-xs uppercase ${ROLE_BADGE[u.role] ?? 'bg-slate-100 text-slate-500'}`}>
                  {u.role}
                </span>
              </td>
              <td class="px-4 py-2 text-slate-600">{u.department}</td>
              <td class="px-4 py-2 text-slate-600">{toBool(u.can_create_tasks) ? 'Yes' : 'No'}</td>
              <td class="px-4 py-2">
                <StatusPill status={toBool(u.is_active) ? 'active' : 'disabled'} dot />
              </td>
              <td class="px-4 py-2 whitespace-nowrap text-slate-500">{formatDate(u.created_at)}</td>
              <td class="px-4 py-2 whitespace-nowrap text-slate-500">{u.last_login_at ? formatDate(u.last_login_at) : '—'}</td>
              <td class="px-4 py-2">
                <div class="flex flex-col items-start gap-2">
                  <div class="flex items-center gap-2">
                    {isSelf ? (
                      <span
                        class="rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-400"
                        title="You cannot deactivate your own account."
                      >
                        Deactivate
                      </span>
                    ) : (
                      <form action="/admin/users/api" method="POST" class="inline">
                        <input type="hidden" name="action" value="toggle_active" />
                        <input type="hidden" name="user_id" value={u.id} />
                        <input type="hidden" name="value" value={toBool(u.is_active) ? 0 : 1} />
                        <button
                          type="submit"
                          class={`rounded-md px-2 py-1 text-xs font-medium ${
                            toBool(u.is_active)
                              ? 'bg-red-50 text-red-700 hover:bg-red-100'
                              : 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100'
                          }`}
                        >
                          {toBool(u.is_active) ? 'Deactivate' : 'Activate'}
                        </button>
                      </form>
                    )}

                    {u.role === 'employee' && (
                      <form action="/admin/users/api" method="POST" class="inline">
                        <input type="hidden" name="action" value="toggle_create" />
                        <input type="hidden" name="user_id" value={u.id} />
                        <input type="hidden" name="value" value={toBool(u.can_create_tasks) ? 0 : 1} />
                        <button
                          type="submit"
                          title="Toggle can_create_tasks"
                          class="rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700 hover:bg-slate-200"
                        >
                          {toBool(u.can_create_tasks) ? 'Revoke create' : 'Grant create'}
                        </button>
                      </form>
                    )}
                  </div>

                  <details class="group">
                    <summary class="cursor-pointer text-xs font-medium text-brand-600 hover:underline">Edit</summary>
                    <form action="/admin/users/api" method="POST" class="mt-2 grid gap-2 rounded-md border border-slate-200 bg-slate-50 p-3 sm:min-w-72">
                      <input type="hidden" name="action" value="edit" />
                      <input type="hidden" name="user_id" value={u.id} />

                      <div>
                        <label for={`edit-full-${u.id}`} class="block text-xs font-medium text-slate-600">Full name</label>
                        <input
                          id={`edit-full-${u.id}`}
                          name="full_name"
                          type="text"
                          required
                          value={u.full_name}
                          class="mt-0.5 block w-full rounded-md border border-slate-300 px-2 py-1 text-xs focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
                        />
                      </div>

                      <div>
                        <label for={`edit-role-${u.id}`} class="block text-xs font-medium text-slate-600">Role</label>
                        {isSelf ? (
                          <>
                            <input type="hidden" name="role" value={u.role} />
                            <p class="mt-1 text-xs text-slate-500">
                              {u.role} — you cannot change your own role.
                            </p>
                          </>
                        ) : (
                          <select
                            id={`edit-role-${u.id}`}
                            name="role"
                            class="mt-0.5 block w-full rounded-md border border-slate-300 px-2 py-1 text-xs focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
                          >
                            <option value="employee" selected={u.role === 'employee'}>Employee</option>
                            <option value="supervisor" selected={u.role === 'supervisor'}>Supervisor</option>
                            <option value="manager" selected={u.role === 'manager'}>Manager</option>
                            <option value="admin" selected={u.role === 'admin'}>Admin</option>
                          </select>
                        )}
                      </div>

                      <div>
                        <label for={`edit-dept-${u.id}`} class="block text-xs font-medium text-slate-600">Department</label>
                        <input
                          id={`edit-dept-${u.id}`}
                          name="department"
                          type="text"
                          required
                          value={u.department}
                          class="mt-0.5 block w-full rounded-md border border-slate-300 px-2 py-1 text-xs focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
                        />
                      </div>

                      <label class="flex items-start gap-2 text-xs text-slate-700">
                        <input
                          type="checkbox"
                          name="can_create_tasks"
                          value="1"
                          checked={toBool(u.can_create_tasks)}
                          class="mt-0.5 h-3.5 w-3.5 rounded border-slate-300 text-brand-600"
                        />
                        <span>
                          Can create tasks
                          <span class="block text-[10px] text-slate-400">Only applies to employee accounts.</span>
                        </span>
                      </label>

                      {isSelf ? (
                        <>
                          <input type="hidden" name="is_active" value="1" />
                          <p class="text-xs text-slate-500">Active — you cannot deactivate your own account.</p>
                        </>
                      ) : (
                        <label class="flex items-center gap-2 text-xs text-slate-700">
                          <input
                            type="checkbox"
                            name="is_active"
                            value="1"
                            checked={toBool(u.is_active)}
                            class="h-3.5 w-3.5 rounded border-slate-300 text-brand-600"
                          />
                          Active account
                        </label>
                      )}

                      <button
                        type="submit"
                        class="rounded-md bg-brand-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-brand-700"
                      >
                        Save changes
                      </button>
                    </form>
                  </details>

                  <details class="group">
                    <summary class="cursor-pointer text-xs font-medium text-brand-600 hover:underline">Reset password</summary>
                    <form action="/admin/users/api" method="POST" class="mt-2 flex items-center gap-2">
                      <input type="hidden" name="action" value="reset_password" />
                      <input type="hidden" name="user_id" value={u.id} />
                      <input
                        type="password"
                        name="password"
                        required
                        minlength="8"
                        placeholder="New password"
                        class="w-40 rounded-md border border-slate-300 px-2 py-1 text-xs focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
                      />
                      <button
                        type="submit"
                        class="rounded-md bg-slate-900 px-2 py-1 text-xs font-medium text-white hover:bg-slate-700"
                      >
                        Save
                      </button>
                    </form>
                  </details>
                </div>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</BaseLayout>
