---
// Admin user management home (admin only).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb, toBool } from '../../lib/db';

const db = getDb();
const users = db
  .prepare(`SELECT id, username, full_name, email, role, can_create_tasks, is_active FROM users ORDER BY id`)
  .all() as {
    id: number;
    username: string;
    full_name: string;
    email: string | null;
    role: string;
    can_create_tasks: number;
    is_active: number;
  }[];
---
<BaseLayout title="Users">
  <header class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Users</h1>
      <p class="text-sm text-slate-600">Admin user management.</p>
    </div>
    <a href="/admin/users/new" class="rounded-md bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700">
      New user
    </a>
  </header>

  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs uppercase text-slate-500">
        <tr>
          <th class="px-4 py-2">#</th>
          <th class="px-4 py-2">Username</th>
          <th class="px-4 py-2">Name</th>
          <th class="px-4 py-2">Email</th>
          <th class="px-4 py-2">Role</th>
          <th class="px-4 py-2">Can create</th>
          <th class="px-4 py-2">Active</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        {users.map((u) => (
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-2 text-slate-500">{u.id}</td>
            <td class="px-4 py-2 font-medium text-slate-900">{u.username}</td>
            <td class="px-4 py-2 text-slate-600">{u.full_name}</td>
            <td class="px-4 py-2 text-slate-600">{u.email ?? '—'}</td>
            <td class="px-4 py-2">
              <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs uppercase text-slate-500">{u.role}</span>
            </td>
            <td class="px-4 py-2 text-slate-600">{toBool(u.can_create_tasks) ? 'Yes' : 'No'}</td>
            <td class="px-4 py-2 text-slate-600">{toBool(u.is_active) ? 'Yes' : 'No'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</BaseLayout>
