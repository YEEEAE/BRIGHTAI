---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import AppButton from '../components/ui/AppButton.astro';
import { REPORT_CATALOG } from '../lib/reporting/catalog';
import { listActiveUsers } from '../lib/tasks';
import { FINDING_CLASSIFICATIONS, RISK_LEVELS, TASK_PRIORITIES } from '../lib/task-policy';
import { SLA_STATUSES } from '../lib/sla';
import { TASK_REPORT_TYPES } from '../lib/reporting/types';
import { parseReportFilters, parseReportScope } from '../lib/reporting/filters';
import { resolveReportPreview } from '../lib/reporting/preview';
import { getUserById } from '../lib/auth';

const user = Astro.locals.user!;
const selectedType = Astro.url.searchParams.get('report_type') ?? 'monthly-qc';
const activeUsers = listActiveUsers();
const currentUser = getUserById(user.userId);
const supervisors = activeUsers.filter((person) => person.role === 'supervisor');
const filters = new URLSearchParams(Astro.url.searchParams);
filters.delete('report_type');
filters.delete('format');
const query = filters.toString();
const canChooseOrganization = user.role === 'admin' || user.role === 'manager';
const inputClass = 'rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500';
const scopeLabel = user.role === 'employee' ? 'Your tasks only' : user.role === 'supervisor' ? 'Your department' : 'Organization';
let preview: Awaited<ReturnType<typeof resolveReportPreview>> | null = null;
try {
  const parsedFilters = parseReportFilters(Astro.url.searchParams);
  preview = await resolveReportPreview({
    actor: { id: user.userId, role: user.role, department: currentUser?.department ?? null },
    reportType: selectedType as typeof TASK_REPORT_TYPES[number],
    filters: parsedFilters,
    comprehensive: parseReportScope(Astro.url.searchParams),
  });
} catch {
  preview = null;
}
const previewFilters = preview && preview.allowed
  ? Object.entries(preview.filters).filter(([, value]) => value !== null && value !== '').map(([key, value]) => `${key.replaceAll('_', ' ')}: ${String(value)}`)
  : [];
---

<BaseLayout title="Reports">
  <div class="space-y-6">
    <PageHeader
      eyebrow="Reporting"
      title="Reports"
      description="Generate English QC reports with a visible, server-enforced data scope. Choose a report, set the period, then download."
    >
      <fragment slot="actions">
        <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">Scope: {scopeLabel}</span>
      </fragment>
    </PageHeader>

    <form method="get" action="/reports" class="space-y-4">
      {/* Step 1 — report type */}
      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm" aria-labelledby="report-type-heading">
        <h2 id="report-type-heading" class="text-base font-semibold text-slate-900">1 · Report type</h2>
        <label class="mt-3 flex max-w-md flex-col gap-1 text-sm font-medium text-slate-700">Report
          <select name="report_type" class={inputClass}>
            {TASK_REPORT_TYPES.map((key) => REPORT_CATALOG[key]).map((report) => <option value={report.key} selected={selectedType === report.key}>{report.label}</option>)}
          </select>
        </label>
      </section>

      {/* Step 2 — basic filters */}
      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm" aria-labelledby="basic-filters-heading">
        <h2 id="basic-filters-heading" class="text-base font-semibold text-slate-900">2 · Period &amp; scope</h2>
        <div class="mt-3 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">From date<input type="date" name="from" value={Astro.url.searchParams.get('from') ?? ''} class={inputClass} /></label>
          <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">To date<input type="date" name="to" value={Astro.url.searchParams.get('to') ?? ''} class={inputClass} /></label>
          <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Department<input name="department" maxlength="50" value={Astro.url.searchParams.get('department') ?? ''} class={inputClass} /></label>
          {canChooseOrganization && <label class="flex items-center gap-2 self-end text-sm font-medium text-slate-700"><input type="checkbox" name="scope" value="organization" checked={Astro.url.searchParams.get('scope') === 'organization'} class="h-4 w-4 rounded border-slate-300" /> Organization-wide scope</label>}
        </div>
      </section>

      {/* Step 3 — advanced filters (collapsible) */}
      <details class="rounded-xl border border-slate-200 bg-white shadow-sm" open={false}>
        <summary class="cursor-pointer select-none px-5 py-3 text-sm font-semibold text-slate-700 hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">
          3 · Advanced filters <span class="ml-1 font-normal text-slate-500">(employee, supervisor, priority, risk, finding classification, SLA)</span>
        </summary>
        <div class="grid gap-4 border-t border-slate-100 p-5 md:grid-cols-2 lg:grid-cols-4">
          <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Employee
            <select name="employee" class={inputClass}><option value="">All employees</option>{activeUsers.map((person) => <option value={person.id} selected={Astro.url.searchParams.get('employee') === String(person.id)}>{person.full_name}</option>)}</select>
          </label>
          <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Supervisor
            <select name="supervisor" class={inputClass}><option value="">All supervisors</option>{supervisors.map((person) => <option value={person.id} selected={Astro.url.searchParams.get('supervisor') === String(person.id)}>{person.full_name}</option>)}</select>
          </label>
          <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Priority
            <select name="priority" class={inputClass}><option value="">All priorities</option>{TASK_PRIORITIES.map((value) => <option value={value} selected={Astro.url.searchParams.get('priority') === value}>{value}</option>)}</select>
          </label>
          <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Risk
            <select name="risk" class={inputClass}><option value="">All risk levels</option>{RISK_LEVELS.map((value) => <option value={value} selected={Astro.url.searchParams.get('risk') === value}>{value}</option>)}</select>
          </label>
          <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Finding Classification
            <select name="finding_classification" class={inputClass}><option value="">All classifications</option>{FINDING_CLASSIFICATIONS.map((value) => <option value={value} selected={Astro.url.searchParams.get('finding_classification') === value}>{value}</option>)}</select>
          </label>
          <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">SLA Status
            <select name="sla_status" class={inputClass}><option value="">All SLA statuses</option>{SLA_STATUSES.map((value) => <option value={value} selected={Astro.url.searchParams.get('sla_status') === value}>{value}</option>)}</select>
          </label>
        </div>
      </details>

      {/* Step 4 — resolve scope */}
      <div class="flex flex-wrap items-center gap-3">
        <AppButton type="submit" variant="primary">Preview scope</AppButton>
        <span class="text-sm text-slate-600">Signed in as {user.fullName} ({user.role}).</span>
      </div>
    </form>

    {/* Step 5 — preview and downloads */}
    {preview?.allowed && (
      <section class="rounded-xl border border-slate-300 bg-white p-5 shadow-sm" aria-labelledby="report-preview-heading">
        <h2 id="report-preview-heading" class="text-base font-semibold text-slate-900">Report preview</h2>
        <dl class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Report type</dt><dd class="mt-1 font-medium text-slate-900">{REPORT_CATALOG[selectedType as keyof typeof REPORT_CATALOG]?.label ?? selectedType}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Resolved data scope</dt><dd class="mt-1 font-medium text-slate-900">{preview.scope.kind === 'own_tasks' ? 'Assigned and created tasks' : preview.scope.kind === 'department' ? `Department: ${preview.scope.department}` : 'Organization'}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Date range</dt><dd class="mt-1 font-medium text-slate-900" dir="ltr">{preview.filters.from ?? 'Any'} → {preview.filters.to ?? 'Any'}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Filters</dt><dd class="mt-1 font-medium text-slate-900">{previewFilters.length ? previewFilters.join(' · ') : 'None'}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Matching rows</dt><dd class="mt-1 font-medium text-slate-900">{preview.matchingRowCount === null ? 'Not calculated for large result' : preview.matchingRowCount}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Generated as</dt><dd class="mt-1 font-medium text-slate-900">{user.fullName} · {user.role}</dd></div>
        </dl>
        <p class="mt-4 text-xs text-slate-600">This preview uses the same server authorization and scope resolution as the final download. Unauthorized counts are never shown.</p>
      </section>
    )}
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm" aria-labelledby="report-downloads-heading">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 id="report-downloads-heading" class="text-base font-semibold text-slate-900">4 · Download report</h2>
          <p class="mt-1 text-sm text-slate-600">The server will re-check your role and resolve the final scope before generation.</p>
        </div>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        {(['csv', 'xlsx', 'pdf'] as const).map((format) => (
          <AppButton href={`/api/reports/${selectedType}.${format}${query ? `?${query}` : ''}`} variant="secondary">Download {format.toUpperCase()}</AppButton>
        ))}
      </div>
    </section>

    <section id="audit" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-base font-semibold text-slate-900">Audit Trail</h2>
      <p class="mt-1 text-sm text-slate-600">Every generation records Report ID, Generated By, Filters, Timestamp, Format, and Data Scope.</p>
      <a href="/api/reports/audit" class="mt-3 inline-block text-sm font-medium text-brand-700 hover:underline">View report audit JSON</a>
    </section>
  </div>
</BaseLayout>
