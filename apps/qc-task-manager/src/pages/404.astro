---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppButton from '../components/ui/AppButton.astro';
---
<BaseLayout title="Not found">
  <section class="py-16 text-center">
    <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Error 404</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">Page not found</h1>
    <p class="mx-auto mt-2 max-w-md text-slate-600">
      The page you're looking for doesn't exist or may have moved. Check the address, or start again from your home page.
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
      <AppButton href="/" variant="primary">Go home</AppButton>
      <AppButton href="/search" variant="secondary">Search tasks</AppButton>
    </div>
  </section>
</BaseLayout>
