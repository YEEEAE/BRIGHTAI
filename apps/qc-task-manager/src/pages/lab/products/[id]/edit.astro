---
// /lab/products/[id]/edit — edit a Product Master row (PROMPT 08).
// Manager+ only (canEditLabProduct). Inactive products are NOT editable —
// the page bounces to the read-only detail with a flash (archived master
// rows are historical). The form POSTs to this same URL; the middleware
// short-circuits it with the id from the path segment only.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import EmptyState from '../../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../../components/lab/LabSecondaryNav.astro';
import LabProductForm from '../../../../components/lab/LabProductForm.astro';
import { labNavForRole } from '../../../../lib/lab/navigation';
import {
  getLabProductDetail,
  getLabProductEquipmentIds,
  listLabDocumentsForProductForm,
  listLabEquipmentForProductForm,
  listLabTemplatesForProductForm,
} from '../../../../lib/lab/products';
import { LAB_CONNECTOR_TYPES } from '../../../../lib/lab/policy';
import { canEditLabProduct, canProposeLabProductEdit } from '../../../../lib/permissions';
import { setFlash } from '../../../../lib/flash';
import type { Role } from '../../../../lib/types';
import Banner from '../../../../components/ui/Banner.astro';

const user = Astro.locals.user!;
const role = user.role as Role;

if (!canEditLabProduct(role) && !canProposeLabProductEdit(role)) {
  setFlash(Astro, 'error', 'You do not have permission to edit products.');
  return Astro.redirect('/lab/products');
}

const id = Number(Astro.params.id);
let detail: ReturnType<typeof getLabProductDetail> = null;
try {
  detail = getLabProductDetail(id);
} catch (err) {
  console.error('[lab] product edit load failure', err);
}

if (!detail) {
  return Astro.redirect('/lab/products');
}
if (detail.product.is_active !== 1) {
  setFlash(Astro, 'error', 'Inactive products are read-only and cannot be edited.');
  return Astro.redirect(`/lab/products/${id}`);
}

const navItems = labNavForRole(role);

let loadError: string | null = null;
let equipment: ReturnType<typeof listLabEquipmentForProductForm> = [];
let templates: ReturnType<typeof listLabTemplatesForProductForm> = [];
let sops: ReturnType<typeof listLabDocumentsForProductForm> = [];
let wis: ReturnType<typeof listLabDocumentsForProductForm> = [];
let selectedEquipmentIds: number[] = [];
try {
  equipment = listLabEquipmentForProductForm();
  templates = listLabTemplatesForProductForm();
  sops = listLabDocumentsForProductForm('SOP');
  wis = listLabDocumentsForProductForm('WI');
  selectedEquipmentIds = getLabProductEquipmentIds(id);
} catch (err) {
  console.error('[lab] product edit reference load failure', err);
  loadError = 'Could not load the reference lists. Try reloading — if the problem persists, contact an administrator.';
}
---

<BaseLayout title={`Edit Product ${detail.product.code}`}>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Products', href: '/lab/products' },
        { label: detail.product.code, href: `/lab/products/${detail.product.id}` },
        { label: 'Edit' },
      ]}
    />

    <header>
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Master Data</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">Edit Product</h1>
      <p class="mt-1 max-w-3xl text-sm text-slate-600">
        {detail.product.name} (<span dir="ltr">{detail.product.code}</span>). Every change is audited; approved tests
        keep their own product snapshot and are never altered.
      </p>
    </header>

    <LabSecondaryNav items={navItems} currentPath={`/lab/products/${detail.product.id}/edit`} />

    {loadError ? (
      <>
        <Banner tone="error">{loadError}</Banner>
        <EmptyState
          title="Could not load the edit form"
          hint={loadError}
          ctaHref={`/lab/products/${detail.product.id}`}
          ctaLabel="Back to product details"
        />
      </>
    ) : (
      <LabProductForm
        mode="edit"
        product={detail.product}
        selectedEquipmentIds={selectedEquipmentIds}
        templates={templates}
        sops={sops}
        wis={wis}
        equipmentOptions={equipment}
        connectorTypes={[...LAB_CONNECTOR_TYPES]}
        isContributor={canProposeLabProductEdit(role)}
      />
    )}
  </div>
</BaseLayout>
