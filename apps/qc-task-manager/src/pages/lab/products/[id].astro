---
// /lab/products/[id] — Product Master details (PROMPT 08).
//
// Read-only view: all master fields, the linked controlled documents, the
// related equipment (by canonical id), test usage (drills into the register
// filtered by product), and the change history from the shared audit log
// (entity_type='LAB_PRODUCT'). Edit is offered only to manager+ AND only
// while the product is active — inactive products are historical.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import { getLabProductAuditTimeline, getLabProductDetail } from '../../../lib/lab/products';
import { getProductRepeatFailure } from '../../../lib/lab/scheduledNotifications';
import { getLabFailRateTrends, labTrendDrilldown, type LabTrendGranularity } from '../../../lib/lab/trends';
import LabFailRateChart from '../../../components/lab/LabFailRateChart';
import { canEditLabProduct, canProposeLabProductEdit } from '../../../lib/permissions';
import { canReviewLabChangeRequests } from '../../../lib/permissions';
import { countPendingChangeRequests } from '../../../lib/lab/changeRequests';
import type { Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;

const id = Number(Astro.params.id);
let detail: ReturnType<typeof getLabProductDetail> = null;
try {
  detail = getLabProductDetail(id);
} catch (err) {
  console.error('[lab] product detail query failure', err);
}

const navItems = labNavForRole(role);
const pendingContributorChanges = detail
  ? countPendingChangeRequests('PRODUCT', detail.product.id, canReviewLabChangeRequests(role) ? undefined : user.userId)
  : 0;

// FAIL-rate trends (read-only, over existing test records — no new tables).
// Granularity is switchable via ?trend=week|month (default weekly, same
// Monday-start alignment as the dashboard). VOID records never enter rates.
const trendParam = Astro.url.searchParams.get('trend');
const trendGranularity: LabTrendGranularity = trendParam === 'month' ? 'month' : 'week';
let trends: ReturnType<typeof getLabFailRateTrends> | null = null;
try {
  if (detail) trends = getLabFailRateTrends(trendGranularity, 8, detail.product.id);
} catch (err) {
  console.error('[lab] product trends query failure', err);
}
const trendsDecided = trends ? trends.points.reduce((sum, p) => sum + p.total, 0) : 0;

// Data-quality style flag (PROMPT 20 follow-up): same product with ≥2 FAIL
// final results inside the rolling 7-day window — the SAME detector the
// daily notification job uses (getProductRepeatFailure), read-only. The flag
// links to the FAIL-filtered register; findings stay a human decision.
let repeatFailure: ReturnType<typeof getProductRepeatFailure> = null;
try {
  if (detail) repeatFailure = getProductRepeatFailure(detail.product.id);
} catch (err) {
  console.error('[lab] product repeat-failure check failure', err);
}
const repeatRegisterHref = `/lab/tests?product=${detail?.product.id ?? ''}&result=FAIL`;
const repeatFindingHref =
  detail &&
  `/findings?inspection_type=${encodeURIComponent('Lab repeated test failures')}` +
    `&requirement_reference=${encodeURIComponent(`lab_test_records: ${repeatFailure?.test_ids.join(', ')}`)}` +
    `&risk_description=${encodeURIComponent(
      `Repeated FAIL results for product ${detail.product.code} (${detail.product.name}) within 7 days — ` +
        `affected lab_test_records ids: ${repeatFailure?.test_ids.join(', ')}.`,
    )}#new-finding`;

const fieldCls = 'rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700';
const labelCls = 'text-xs font-semibold uppercase tracking-wide text-slate-500';

function fmt(value: unknown): string {
  return value == null || String(value).trim() === '' ? '—' : String(value);
}
---

<BaseLayout title={detail ? `Product ${detail.product.code}` : 'Product not found'}>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Products', href: '/lab/products' },
        ...(detail ? [{ label: detail.product.code }] : []),
      ]}
    />

    {!detail ? (
      <EmptyState
        title="Product not found"
        hint="This product does not exist — it may have been removed, or the link is stale."
        ctaHref="/lab/products"
        ctaLabel="Back to the Product Master"
      />
    ) : (
      <>
        <header class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Master Data</p>
            <h1 class="mt-1 text-3xl font-semibold text-slate-900">{detail.product.name}</h1>
            <p class="mt-1 text-sm text-slate-600">
              Code <span class="font-medium text-slate-900" dir="ltr">{detail.product.code}</span>
              <span class={`ms-3 inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${detail.product.is_active === 1 ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-700'}`}>
                {detail.product.is_active === 1 ? 'Active' : 'Inactive'}
              </span>
            </p>
          </div>
          {(canEditLabProduct(role) || canProposeLabProductEdit(role)) && detail.product.is_active === 1 && (
            <a
              href={`/lab/products/${detail.product.id}/edit`}
              class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
            >
              Edit Product
            </a>
          )}
          {detail.product.is_active !== 1 && (
            <p class="text-sm text-slate-500">Inactive products are read-only historical records.</p>
          )}
          {(canEditLabProduct(role) || canProposeLabProductEdit(role)) && (
            <form method="post" action={`/lab/products/${detail.product.id}/${detail.product.is_active === 1 ? 'archive' : 'restore'}`}>
              <button
                type="submit"
                class={`rounded-lg px-4 py-2 text-sm font-semibold shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 ${
                  detail.product.is_active === 1
                    ? 'border border-slate-300 bg-white text-slate-700 hover:bg-slate-50'
                    : 'bg-brand-600 text-white hover:bg-brand-700'
                }`}
              >
                {detail.product.is_active === 1 ? 'Archive Product' : 'Restore Product'}
              </button>
            </form>
          )}
        </header>

        <LabSecondaryNav items={navItems} currentPath={`/lab/products/${detail.product.id}`} />
        {pendingContributorChanges > 0 && (
          <div role="status" class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            Pending contributor changes: {pendingContributorChanges}
            {canReviewLabChangeRequests(role) && <a class="ms-2 font-semibold underline" href="/lab/change-requests">Review</a>}
          </div>
        )}

        {repeatFailure && (
          <div
            role="status"
            data-testid="repeat-failure-flag"
            class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-300 bg-amber-50 p-4"
          >
            <p class="text-sm font-semibold text-amber-900">
              <span aria-hidden="true">⚠</span> Repeated failures in the last 7 days —{' '}
              <span class="font-normal text-amber-800">
                {repeatFailure.fail_count} FAIL results (tests #{repeatFailure.test_ids.join(', #')}) recorded for this product.
              </span>
            </p>
            <div class="flex flex-wrap gap-2">
              <a
                href={repeatRegisterHref}
                class="rounded-md border border-amber-400 bg-white px-3 py-1.5 text-sm font-medium text-amber-900 hover:bg-amber-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500"
              >
                View FAILed tests →
              </a>
              <a
                href={repeatFindingHref!}
                class="rounded-md bg-brand-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
              >
                Open Finding
              </a>
            </div>
          </div>
        )}

        <section aria-labelledby="sec-fields" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 id="sec-fields" class="text-base font-semibold text-slate-900">Master Data</h2>
          <dl class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <div class={fieldCls}>
              <dt class={labelCls}>Product Name</dt>
              <dd class="mt-1 font-medium text-slate-900">{detail.product.name}</dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Product Code</dt>
              <dd class="mt-1 font-medium text-slate-900" dir="ltr">{detail.product.code}</dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Connector Type</dt>
              <dd class="mt-1 text-slate-900">{fmt(detail.product.connector_type)}</dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Default Test Type</dt>
              <dd class="mt-1 uppercase text-slate-900">{detail.product.default_test_type ? detail.product.default_test_type : '—'}</dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Applicable Test Template</dt>
              <dd class="mt-1 text-slate-900">
                {detail.template_name ? `${detail.template_name} (${detail.template_code})` : '—'}
              </dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Applicable SOP</dt>
              <dd class="mt-1 text-slate-900">
                {detail.sop_title ? `${detail.sop_code} — ${detail.sop_title}` : '—'}
              </dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Applicable WI</dt>
              <dd class="mt-1 text-slate-900">
                {detail.wi_title ? `${detail.wi_code} — ${detail.wi_title}` : '—'}
              </dd>
            </div>
            <div class={`sm:col-span-2 lg:col-span-3 ${fieldCls}`}>
              <dt class={labelCls}>Product Description</dt>
              <dd class="mt-1 text-slate-900 whitespace-pre-line">{fmt(detail.product.description)}</dd>
            </div>
            <div class={`sm:col-span-2 lg:col-span-3 ${fieldCls}`}>
              <dt class={labelCls}>Notes</dt>
              <dd class="mt-1 text-slate-900 whitespace-pre-line">{fmt(detail.product.notes)}</dd>
            </div>
          </dl>
        </section>

        <section aria-labelledby="sec-equipment" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 id="sec-equipment" class="text-base font-semibold text-slate-900">Related Equipment</h2>
          {detail.equipment.length === 0 ? (
            <p class="mt-2 text-sm text-slate-600">No equipment linked to this product.</p>
          ) : (
            <ul class="mt-3 flex flex-wrap gap-2">
              {detail.equipment.map((e) => (
                <li class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">
                  <span class="font-medium">{e.name}</span>
                  <span class="ms-2 text-slate-500" dir="ltr">({e.code})</span>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section aria-labelledby="sec-usage" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 id="sec-usage" class="text-base font-semibold text-slate-900">Test Usage</h2>
          <p class="mt-2 text-sm text-slate-600">
            {detail.test_count.toLocaleString('en-US')} test{detail.test_count === 1 ? '' : 's'} reference this product by ID.
            {detail.test_count > 0 && (
              <a href={`/lab/tests?product=${detail.product.id}`} class="ms-1 font-medium text-brand-600 hover:underline">
                View in the test register →
              </a>
            )}
            {' '}Approved tests keep their own product snapshot — master edits never alter them.
          </p>
          {detail.product.is_active !== 1 && detail.test_count > 0 && (
            <p class="mt-2 text-sm text-amber-700">
              This inactive product is still referenced by tests — it is flagged in the Data Quality Center (product_inactive_in_use).
            </p>
          )}
        </section>

        <section aria-labelledby="sec-trends" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 id="sec-trends" class="text-base font-semibold text-slate-900">Trends</h2>
          <p class="mt-1 text-sm text-slate-600">
            FAIL rate over time for this product (decided, non-VOID tests) with a comparison against the previous
            {trendGranularity === 'month' ? ' 8 months' : ' 8 weeks'}.
          </p>

          <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Trend granularity">
            <a
              href={`/lab/products/${detail.product.id}?trend=week`}
              class={`rounded-md px-3 py-1.5 text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 ${trendGranularity === 'week' ? 'bg-brand-600 text-white' : 'border border-slate-300 text-slate-700 hover:bg-slate-50'}`}
              aria-current={trendGranularity === 'week' ? 'true' : undefined}
            >Weekly</a>
            <a
              href={`/lab/products/${detail.product.id}?trend=month`}
              class={`rounded-md px-3 py-1.5 text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 ${trendGranularity === 'month' ? 'bg-brand-600 text-white' : 'border border-slate-300 text-slate-700 hover:bg-slate-50'}`}
              aria-current={trendGranularity === 'month' ? 'true' : undefined}
            >Monthly</a>
          </div>

          {trends && trendsDecided === 0 ? (
            <div class="mt-4 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center">
              <p class="text-sm font-medium text-slate-700">No trend data yet</p>
              <p class="mt-1 text-sm text-slate-500">
                This product has no decided (non-VOID) test results in the window — rates appear once tests receive a final result.
              </p>
            </div>
          ) : trends && (
            <>
              {trends.comparison.direction !== 'insufficient' && trends.comparison.deltaPercentagePoints !== null && (
                <p class="mt-4 text-sm" data-testid="trend-comparison">
                  FAIL rate is <span class="font-semibold text-slate-900">{trends.comparison.currentFailRate}%</span> in the current window
                  vs {trends.comparison.previousFailRate}% in the previous one —
                  <span class={`ms-1 font-semibold ${trends.comparison.direction === 'up' ? 'text-red-600' : trends.comparison.direction === 'down' ? 'text-emerald-700' : 'text-slate-700'}`}>
                    {trends.comparison.direction === 'up' ? 'up' : trends.comparison.direction === 'down' ? 'down' : 'unchanged'} by {Math.abs(trends.comparison.deltaPercentagePoints)} percentage points.
                  </span>
                </p>
              )}
              <div class="mt-2">
                <LabFailRateChart client:visible points={trends.points} granularity={trends.granularity} />
              </div>
              <p class="mt-2 text-sm text-slate-600">
                <a href={labTrendDrilldown(detail.product.id, undefined, 'FAIL')} class="font-medium text-brand-600 hover:underline">
                  View FAILed tests in the register →
                </a>
              </p>

              {trends.lots.length > 0 && (
                <div class="mt-4">
                  <h3 class="text-sm font-semibold text-slate-900">Per-lot breakdown</h3>
                  <p class="mt-1 text-xs text-slate-500">Decided, non-VOID tests grouped by lot number (top lots first).</p>
                  <div class="mt-3 overflow-x-auto contain-layout contain-paint">
                    <table class="min-w-[560px] divide-y divide-slate-100 text-sm">
                      <thead class="text-left text-xs uppercase tracking-wide text-slate-500">
                        <tr>
                          <th scope="col" class="px-3 py-2 font-semibold">Lot</th>
                          <th scope="col" class="px-3 py-2 font-semibold">Decided</th>
                          <th scope="col" class="px-3 py-2 font-semibold">FAIL</th>
                          <th scope="col" class="px-3 py-2 font-semibold">FAIL rate</th>
                          <th scope="col" class="px-3 py-2 font-semibold">Register</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-slate-100">
                        {trends.lots.map((lot) => (
                          <tr data-lab-lot={lot.lotNumber}>
                            <td class="px-3 py-2 font-medium text-slate-900" dir="ltr">{lot.lotNumber}</td>
                            <td class="px-3 py-2 text-slate-700">{lot.total}</td>
                            <td class="px-3 py-2 text-slate-700">{lot.fail}</td>
                            <td class={`px-3 py-2 font-semibold ${lot.failRate !== null && lot.failRate >= 50 ? 'text-red-600' : 'text-slate-700'}`}>
                              {lot.failRate === null ? '—' : `${lot.failRate}%`}
                            </td>
                            <td class="px-3 py-2">
                              <a href={labTrendDrilldown(detail.product.id, lot.lotNumber)} class="font-medium text-brand-600 hover:underline">
                                View tests →
                              </a>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}
            </>
          )}
        </section>

        <section aria-labelledby="sec-history" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 id="sec-history" class="text-base font-semibold text-slate-900">Change History</h2>
          {(() => {
            const timeline = getLabProductAuditTimeline(detail.product.id);
            return timeline.length === 0 ? (
              <p class="mt-2 text-sm text-slate-600">No recorded changes yet.</p>
            ) : (
              <div class="mt-3 overflow-x-auto contain-layout contain-paint">
                <table class="min-w-[640px] divide-y divide-slate-100 text-sm">
                  <thead class="text-left text-xs uppercase tracking-wide text-slate-500">
                    <tr>
                      <th scope="col" class="px-3 py-2 font-semibold">When</th>
                      <th scope="col" class="px-3 py-2 font-semibold">Actor</th>
                      <th scope="col" class="px-3 py-2 font-semibold">Action</th>
                      <th scope="col" class="px-3 py-2 font-semibold">Detail</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    {timeline.map((entry) => (
                      <tr>
                        <td class="px-3 py-2 text-slate-500">{String(entry.created_at)}</td>
                        <td class="px-3 py-2 text-slate-700">{String(entry.actor_name ?? '—')}</td>
                        <td class="px-3 py-2 font-medium text-slate-900">{String(entry.action)}</td>
                        <td class="px-3 py-2 text-slate-600" dir="ltr">{String(entry.note ?? '—')}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            );
          })()}
        </section>
      </>
    )}
  </div>
</BaseLayout>
