---
// /lab/products — QC Laboratory Product Master (PROMPT 08).
//
// Central master-data list of tested products. Server-side search, safe
// sorting and pagination live in src/lib/lab/labProductSearch surface of
// src/lib/lab/products.ts (same shape as the test register): the URL is the
// source of truth, every SQL value is a bound parameter, and sorting is a
// whitelisted union. Employees may view the master data; only manager+ get
// the New / Edit affordances (canCreateLabProduct / canEditLabProduct).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import {
  hasLabProductFilters,
  labProductFiltersToQuery,
  parseLabProductSearchFilters,
  searchLabProducts,
  LAB_PRODUCT_PER_PAGE_OPTIONS,
  type LabProductSearchFilters,
  type LabProductSortField,
} from '../../../lib/lab/products';
import { LAB_CONNECTOR_TYPES } from '../../../lib/lab/policy';
import { canCreateLabProduct, canEditLabProduct, canProposeLabProductEdit } from '../../../lib/permissions';
import type { Role } from '../../../lib/types';
import Banner from '../../../components/ui/Banner.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { FILTER_TOOLBAR, FILTER_FIELD, FILTER_CONTROL } from '../../../components/ui/formPresets';
import AppButton from '../../../components/ui/AppButton.astro';

const user = Astro.locals.user!;
const role = user.role as Role;

const navItems = labNavForRole(role);
const filters: LabProductSearchFilters = parseLabProductSearchFilters(Astro.url);

let dataError: string | null = null;
let result: ReturnType<typeof searchLabProducts> = { rows: [], total: 0, page: 1, per_page: 25, total_pages: 1 };
try {
  result = searchLabProducts(filters);
} catch (err) {
  console.error('[lab] product master query failure', err);
  dataError = 'Could not load the Product Master. Try reloading — if the problem persists, contact an administrator.';
}

const filtered = hasLabProductFilters(filters);

const qsParams = new URLSearchParams(labProductFiltersToQuery({ ...filters, page: 1 }).replace(/^\?/, ''));

function pageHref(p: number): string {
  const sp = new URLSearchParams(qsParams);
  if (p > 1) sp.set('page', String(p));
  else sp.delete('page');
  const qs = sp.toString();
  return qs ? `/lab/products?${qs}` : '/lab/products';
}

function sortHref(field: LabProductSortField): string {
  const next: LabProductSearchFilters = {
    ...filters,
    sort: field,
    dir: (filters.sort === field && filters.dir === 'asc' ? 'desc' : 'asc') as 'asc' | 'desc',
    page: 1,
  };
  return `/lab/products${labProductFiltersToQuery(next)}`;
}

function sortArrow(field: LabProductSortField): string {
  if (filters.sort !== field) return '';
  return filters.dir === 'asc' ? ' ▲' : ' ▼';
}

const SORTABLE: { field: LabProductSortField; label: string }[] = [
  { field: 'code', label: 'Code' },
  { field: 'name', label: 'Product Name' },
  { field: 'connector_type', label: 'Connector Type' },
  { field: 'default_test_type', label: 'Default Test Type' },
  { field: 'is_active', label: 'Status' },
  { field: 'updated_at', label: 'Updated' },
];

function th(field: LabProductSortField, label: string): string {
  return `<a href="${sortHref(field)}" class="inline-flex items-center gap-1 hover:text-slate-900">${label}${sortArrow(field)}</a>`;
}

---

<BaseLayout title="Product Master">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Products' },
      ]}
    />

    <PageHeader eyebrow="QC Laboratory — Master Data" title="Product Master" description="Central master data for tested products. Tests reference products by ID; approved tests keep their own product snapshot, so master changes never alter historical records." />

    <LabSecondaryNav items={navItems} currentPath="/lab/products" />

    {dataError && (
      <Banner tone="error">{dataError}</Banner>
    )}

    {!dataError && (
      <>
        <form method="get" action="/lab/products" class={FILTER_TOOLBAR}>
          <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
            <label class={FILTER_FIELD}>
              Search
              <input
                type="search"
                name="q"
                value={filters.q ?? ''}
                placeholder="Code, name, description…"
                class={FILTER_CONTROL}
              />
            </label>
            <label class={FILTER_FIELD}>
              Connector Type
              <select name="connector" class={FILTER_CONTROL}>
                <option value="">All connectors</option>
                {LAB_CONNECTOR_TYPES.map((c) => (
                  <option value={c} selected={filters.connector_type === c}>{c}</option>
                ))}
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Default Test Type
              <select name="type" class={FILTER_CONTROL}>
                <option value="">All types</option>
                <option value="air" selected={filters.default_test_type === 'air'}>AIR</option>
                <option value="vacuum" selected={filters.default_test_type === 'vacuum'}>VACUUM</option>
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Status
              <select name="active" class={FILTER_CONTROL}>
                <option value="">All statuses</option>
                <option value="1" selected={filters.active === '1'}>Active</option>
                <option value="0" selected={filters.active === '0'}>Inactive</option>
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Per page
              <select name="per" class={FILTER_CONTROL}>
                {LAB_PRODUCT_PER_PAGE_OPTIONS.map((n) => (
                  <option value={n} selected={filters.per_page === n}>{n} per page</option>
                ))}
              </select>
            </label>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <AppButton type="submit" variant="primary">Apply filters</AppButton>
            <AppButton href="/lab/products" variant="secondary">Reset</AppButton>
          </div>
        </form>

        <p class="text-sm text-slate-600">
          {result.total.toLocaleString('en-US')} product{result.total === 1 ? '' : 's'} found
          {filtered && <span> (filtered — <a href="/lab/products" class="text-brand-600 hover:underline">clear all</a>)</span>}
        </p>

        {result.rows.length === 0 ? (
          <EmptyState
            title={filtered ? 'No products match your search' : 'No products registered yet'}
            hint={filtered ? 'Try adjusting the search or clearing the filters.' : 'Products created here appear on the test form and link tests to their reference values and documents.'}
            ctaHref={filtered ? '/lab/products' : canCreateLabProduct(role) ? '/lab/products/new' : '/lab'}
            ctaLabel={filtered ? 'Clear filters' : 'New Product'}
          />
        ) : (
          <section aria-label="Product Master" class="rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto contain-layout contain-paint">
              <table class="min-w-[900px] divide-y divide-slate-100 text-sm">
                <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    {SORTABLE.map((s) => (
                      <th scope="col" class="px-4 py-2.5 font-semibold" set:html={th(s.field, s.label)} />
                    ))}
                    <th scope="col" class="px-4 py-2.5 font-semibold">Tests</th>
                    <th scope="col" class="px-4 py-2.5 font-semibold"><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {result.rows.map((p) => (
                    <tr class="align-middle">
                      <td class="px-4 py-2 font-medium text-slate-900" dir="ltr">{p.code}</td>
                      <td class="px-4 py-2 text-slate-700">{p.name}</td>
                      <td class="px-4 py-2 text-slate-700">{p.connector_type ?? '—'}</td>
                      <td class="px-4 py-2 uppercase text-slate-600">{p.default_test_type ?? '—'}</td>
                      <td class="px-4 py-2">
                        <span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${p.is_active === 1 ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-500'}`}>
                          {p.is_active === 1 ? 'Active' : 'Inactive'}
                        </span>
                      </td>
                      <td class="px-4 py-2 text-slate-500">{p.updated_at}</td>
                      <td class="px-4 py-2 text-slate-700">
                        {p.test_count > 0 ? (
                          <a href={`/lab/tests?product=${p.id}`} class="text-brand-600 hover:underline">{p.test_count.toLocaleString('en-US')}</a>
                        ) : (
                          '0'
                        )}
                      </td>
                      <td class="px-4 py-2">
                        <span class="flex items-center gap-2">
                          <a href={`/lab/products/${p.id}`} class="font-medium text-brand-600 hover:underline">View</a>
                          {(canEditLabProduct(role) || canProposeLabProductEdit(role)) && p.is_active === 1 && (
                            <a href={`/lab/products/${p.id}/edit`} class="font-medium text-slate-600 hover:underline">Edit</a>
                          )}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <Pagination page={result.page} totalPages={result.total_pages} hrefFor={pageHref} />
      </>
    )}
  </div>
</BaseLayout>
