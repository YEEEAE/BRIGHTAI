---
// /lab/documents/new — create a controlled SOP/WI document (PROMPT 41, page
// reference §40). All roles may create a catalog identity; the shared editor
// component posts to this same URL and the middleware short-circuits the POST.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import LabDocumentEditor from '../../../components/lab/LabDocumentEditor.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import {
  listLabEquipmentForDocumentForm,
  listLabProductsForDocumentForm,
  listLabUsersForDocumentForm,
} from '../../../lib/lab/documents';
import { canCreateLabDocument } from '../../../lib/permissions';
import { setFlash } from '../../../lib/flash';
import type { Role } from '../../../lib/types';
import Banner from '../../../components/ui/Banner.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';

const user = Astro.locals.user!;
const role = user.role as Role;

if (!canCreateLabDocument(role)) {
  setFlash(Astro, 'error', 'You do not have permission to create controlled documents.');
  return Astro.redirect('/lab/documents');
}

const navItems = labNavForRole(role);

let loadError: string | null = null;
let equipmentOptions: Array<{ id: number; name: string; code: string }> = [];
let productOptions: Array<{ id: number; name: string; code: string }> = [];
let userOptions: Array<{ id: number; full_name: string }> = [];
try {
  equipmentOptions = listLabEquipmentForDocumentForm();
  productOptions = listLabProductsForDocumentForm();
  userOptions = listLabUsersForDocumentForm();
} catch (err) {
  console.error('[lab] document create reference load failure', err);
  loadError = 'Could not load the reference lists. Try reloading — if the problem persists, contact an administrator.';
}
---

<BaseLayout title="New Controlled Document">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Documents', href: '/lab/documents' },
        { label: 'New Document' },
      ]}
    />

    <PageHeader eyebrow="QC Laboratory — Controlled Documents" title="New Controlled Document" description="Create a SOP or WI identity first, then add content when ready. A numbered version is created only after the first non-empty content save." />

    <LabSecondaryNav items={navItems} currentPath="/lab/documents/new" />

    {loadError ? (
      <>
        <Banner tone="error">{loadError}</Banner>
        <EmptyState
          title="Could not load the document editor"
          hint={loadError}
          ctaHref="/lab/documents"
          ctaLabel="Back to the document library"
        />
      </>
    ) : (
      <LabDocumentEditor
        mode="create"
        equipmentOptions={equipmentOptions}
        selectedEquipmentIds={[]}
        productOptions={productOptions}
        userOptions={userOptions}
      />
    )}
  </div>
</BaseLayout>
