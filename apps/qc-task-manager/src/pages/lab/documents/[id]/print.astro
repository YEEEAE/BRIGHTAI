---
// Controlled, chrome-free print view for an SOP/WI. Content comes from the
// same sanitized detail loader as the reader; workflow and source metadata are
// printed verbatim without exposing document bodies to export endpoints.
import PrintLayout from '../../../../layouts/PrintLayout.astro';
import { getLabDocumentDetail, LAB_DOCUMENT_STATUS_LABELS } from '../../../../lib/lab/documents';
import { labQrPayload, labQrSvg, labSiteOrigin } from '../../../../lib/lab/qrcodes';
import { canViewLabDocuments } from '../../../../lib/permissions';

// Intentional UI↔server mapping: same canonical view permission as the
// document reader — deep links cannot bypass it.
const printUser = Astro.locals.user!;
if (!canViewLabDocuments(printUser.role)) return Astro.redirect('/lab/documents');

const id = Number(Astro.params.id);
let detail: ReturnType<typeof getLabDocumentDetail> = null;
let loadError: string | null = null;
if (Number.isInteger(id) && id > 0) {
  try {
    detail = getLabDocumentDetail(id);
  } catch (err) {
    console.error('[lab] document print load failure', err);
    loadError = 'Could not load this controlled document for printing.';
  }
}
const doc = detail?.document;
const version = detail?.currentVersion;
const fmt = (value: unknown) => value == null || String(value).trim() === '' ? '—' : String(value);
const qrSvg = doc ? labQrSvg(labQrPayload(doc.code, `${labSiteOrigin(Astro.url.origin)}/lab/documents/${doc.id}`), `QR: ${doc.code}`) : '';
---

<PrintLayout
  title={doc ? `${doc.code} — Controlled Document` : 'Document not found'}
  backHref={doc ? `/lab/documents/${String(doc.id)}` : ''}
  recordType={doc ? `${doc.type} controlled document` : 'Controlled document'}
  recordId={doc ? doc.code : '—'}
  authorization="Document reader access policy"
  signature={doc ? `Approval: ${fmt(doc.approver_name)} · ${fmt(doc.approved_at)}` : 'Approval metadata unavailable'}
  sourceReference={doc ? `${doc.code} · lab_documents${version ? ` · version ${version.version}` : ''}` : 'lab_documents'}
  qrSvg={qrSvg}
>
  {!doc ? (
    <section><h1 class="print-title">Document not found</h1><p>{loadError ?? 'This controlled document does not exist or is not available to you.'}</p></section>
  ) : (
    <>
      <header class="print-header">
        <div><h1 class="print-title">QC Laboratory</h1><div class="print-sub">Controlled SOP / WI Document</div></div>
        <div class="print-meta">
          <div><strong>Document:</strong> {doc.code}</div>
          <div><strong>Type:</strong> {doc.type}</div>
          <div><strong>Status:</strong> {LAB_DOCUMENT_STATUS_LABELS[doc.status]}</div>
          <div><strong>Version:</strong> {version ? `v${version.version}` : '—'}</div>
        </div>
      </header>

      <section class="print-section">
        <h2 class="print-section-title">Document Metadata</h2>
        <dl class="print-section-body grid3">
          <div class="dl-item"><dt>Title</dt><dd>{doc.title}</dd></div>
          <div class="dl-item"><dt>Owner</dt><dd>{fmt(doc.owner_name)}</dd></div>
          <div class="dl-item"><dt>Reviewer</dt><dd>{fmt(doc.reviewer_name)}</dd></div>
          <div class="dl-item"><dt>Approver</dt><dd>{fmt(doc.approver_name)}</dd></div>
          <div class="dl-item"><dt>Effective Date</dt><dd>{fmt(doc.effective_date)}</dd></div>
          <div class="dl-item"><dt>Review Due Date</dt><dd>{fmt(doc.review_due_date)}</dd></div>
          <div class="dl-item"><dt>Source Register</dt><dd>{fmt(doc.source_register_code)}</dd></div>
          <div class="dl-item"><dt>Source Revision</dt><dd>{fmt(doc.source_revision)}</dd></div>
          <div class="dl-item"><dt>Source Date</dt><dd>{fmt(doc.source_date)}</dd></div>
        </dl>
      </section>

      <section class="print-section">
        <h2 class="print-section-title">Controlled Content {version ? `(v${version.version})` : ''}</h2>
        <article class="print-section-body remark-text" set:html={detail!.contentHtml || '<p>No content has been entered.</p>'} />
      </section>

      {detail!.equipmentLinks.length > 0 && <section class="print-section"><h2 class="print-section-title">Linked Equipment</h2><div class="print-section-body"><table><thead><tr><th scope="col">Code</th><th scope="col">Name</th></tr></thead><tbody>{detail!.equipmentLinks.map((equipment) => <tr><td>{equipment.code}</td><td>{equipment.name}</td></tr>)}</tbody></table></div></section>}

      {detail!.auditTimeline.length > 0 && <section class="print-section"><h2 class="print-section-title">Authorization Audit Trail</h2><div class="print-section-body"><table><thead><tr><th scope="col">When</th><th scope="col">Actor</th><th scope="col">Action</th><th scope="col">Detail</th></tr></thead><tbody>{detail!.auditTimeline.map((item) => <tr><td>{item.created_at}</td><td>{fmt(item.actor_name)}</td><td>{item.action}</td><td>{fmt(item.note)}</td></tr>)}</tbody></table></div></section>}
    </>
  )}
</PrintLayout>
