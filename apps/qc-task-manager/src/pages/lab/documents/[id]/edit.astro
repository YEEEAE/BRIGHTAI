---
// /lab/documents/[id]/edit — edit a controlled SOP/WI document (PROMPT 41,
// page reference §40). Record-level permission (canEditLabDocumentRecord):
// manager+ may edit any non-archived/superseded document; supervisors may edit
// their own (owner/creator) documents in draft/review states. Editing an
// APPROVED document creates a NEW DRAFT version (change summary required);
// ARCHIVED/SUPERSEDED documents are read-only and bounce to the register.
// The form POSTs to this same URL; the middleware short-circuits it with the
// id from the path segment only.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import EmptyState from '../../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../../components/lab/LabSecondaryNav.astro';
import LabDocumentEditor from '../../../../components/lab/LabDocumentEditor.astro';
import { labNavForRole } from '../../../../lib/lab/navigation';
import {
  getLabDocumentEditor,
  listLabEquipmentForDocumentForm,
  listLabProductsForDocumentForm,
  listLabUsersForDocumentForm,
} from '../../../../lib/lab/documents';
import { canEditLabDocumentRecord } from '../../../../lib/permissions';
import { setFlash } from '../../../../lib/flash';
import type { Role } from '../../../../lib/types';
import Banner from '../../../../components/ui/Banner.astro';
import PageHeader from '../../../../components/ui/PageHeader.astro';

const user = Astro.locals.user!;
const role = user.role as Role;
const navItems = labNavForRole(role);

const id = Number(Astro.params.id);
let editor: ReturnType<typeof getLabDocumentEditor> = null;
try {
  editor = getLabDocumentEditor(id);
} catch (err) {
  console.error('[lab] document edit load failure', err);
}

if (editor && !canEditLabDocumentRecord({ id: user.userId, role }, editor.document)) {
  setFlash(Astro, 'error', 'You do not have permission to edit this document.');
  return Astro.redirect('/lab/documents');
}

let loadError: string | null = null;
let equipmentOptions: Array<{ id: number; name: string; code: string }> = [];
let productOptions: Array<{ id: number; name: string; code: string }> = [];
let userOptions: Array<{ id: number; full_name: string }> = [];
try {
  equipmentOptions = listLabEquipmentForDocumentForm();
  productOptions = listLabProductsForDocumentForm();
  userOptions = listLabUsersForDocumentForm();
} catch (err) {
  console.error('[lab] document edit reference load failure', err);
  loadError = 'Could not load the reference lists. Try reloading — if the problem persists, contact an administrator.';
}
---

<BaseLayout title={editor ? `Edit Document · ${editor.document.code}` : 'Document not found'}>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Documents', href: '/lab/documents' },
        ...(editor ? [{ label: editor.document.code, href: `/lab/documents/${editor.document.id}` }, { label: 'Edit' }] : []),
      ]}
    />

    {!editor ? (
      <>
        <PageHeader eyebrow="QC Laboratory — Controlled Documents" title="Document not found" />
        <EmptyState
          title="Document not found"
          hint="This document does not exist — it may have been removed, or the link is stale."
          ctaHref="/lab/documents"
          ctaLabel="Back to the document library"
        />
      </>
    ) : (
      <>
        <header class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Controlled Documents</p>
            <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">Edit Document · <span dir="ltr">{editor.document.code}</span></h1>
            <p class="mt-1 max-w-3xl text-sm text-slate-600">
              {editor.document.title} — current version{' '}
              <strong dir="ltr">v{editor.version?.version ?? 1}</strong> ({editor.version?.status ?? 'DRAFT'}). Every save is
              audited; approved versions are immutable and revising one opens a new draft version.
            </p>
          </div>
          <a
            href={`/lab/documents/${editor.document.id}/versions`}
            class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50"
          >
            Version History
          </a>
        </header>

        <LabSecondaryNav items={navItems} currentPath={`/lab/documents/${editor.document.id}/edit`} />

        {loadError ? (
          <>
            <Banner tone="error">{loadError}</Banner>
            <EmptyState
              title="Could not load the document editor"
              hint={loadError}
              ctaHref="/lab/documents"
              ctaLabel="Back to the document library"
            />
          </>
        ) : (
          <LabDocumentEditor
            mode="edit"
            document={editor.document}
            version={editor.version}
            currentContentMd={editor.version?.content_md ?? ''}
            equipmentOptions={equipmentOptions}
            selectedEquipmentIds={editor.equipment_ids}
            productOptions={productOptions}
            userOptions={userOptions}
          />
        )}
      </>
    )}
  </div>
</BaseLayout>