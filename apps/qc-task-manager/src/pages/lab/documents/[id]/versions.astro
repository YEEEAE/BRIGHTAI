---
// /lab/documents/[id]/versions — version history + read-only comparison for a
// controlled SOP/WI document (contract §5.2 route row, LAB_DOCUMENT_VIEW).
//
// Numbered content lives in lab_document_versions (migration 013): version,
// status, change summary, author, reviewer + approval metadata. Approved
// versions are immutable (contract §41/§42/§44), so this page is strictly
// read-only — no POST, no CSRF, nothing is ever written. Comparison is a GET
// form (?a=<versionId>&b=<versionId>) that renders the two stored sanitized
// HTML payloads side by side; both ids are validated server-side (positive
// integers that belong to this document and differ). The content shown comes
// from the stored content_html_sanitized cache with an escape-only markdown
// fallback (documentContent.ts), so raw HTML is never passed through.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import EmptyState from '../../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../../lib/lab/navigation';
import {
  getLabDocumentVersionContent,
  getLabDocumentVersions,
  LAB_DOCUMENT_STATUS_LABELS,
  LAB_DOCUMENT_TYPE_LABELS,
} from '../../../../lib/lab/documents';
import { canViewLabDocuments } from '../../../../lib/permissions';
import AiReviewPanel from '../../../../components/AiReviewPanel';
import { setFlash } from '../../../../lib/flash';
import type { LabDocumentStatus, Role } from '../../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;
const navItems = labNavForRole(role);

const id = Number(Astro.params.id);
let view: ReturnType<typeof getLabDocumentVersions> = null;
try {
  view = getLabDocumentVersions(id);
} catch (err) {
  console.error('[lab] document version history load failure', err);
}

// Defense-in-depth (contract §5.1): every page re-checks the permission
// server-side. All four roles hold LAB_DOCUMENT_VIEW, so this never trips.
if (view && !canViewLabDocuments(role)) {
  setFlash(Astro, 'error', 'You do not have permission to view this document.');
  return Astro.redirect('/lab/documents');
}

function parseIdParam(value: string | null): number | null {
  return value !== null && /^\d+$/.test(value) ? Number(value) : null;
}
const aId = parseIdParam(Astro.url.searchParams.get('a'));
const bId = parseIdParam(Astro.url.searchParams.get('b'));

let compareA: ReturnType<typeof getLabDocumentVersionContent> = null;
let compareB: ReturnType<typeof getLabDocumentVersionContent> = null;
if (view && aId !== null && bId !== null && aId !== bId) {
  compareA = getLabDocumentVersionContent(id, aId);
  compareB = getLabDocumentVersionContent(id, bId);
  if (!compareA || !compareB) {
    // One of the ids does not belong to this document → drop the comparison.
    compareA = null;
    compareB = null;
  }
}

const activeA = compareA ? compareA.version.id : null;
const activeB = compareB ? compareB.version.id : null;

const STATUS_BADGE_CLS: Record<LabDocumentStatus, string> = {
  DRAFT: 'bg-slate-100 text-slate-700 ring-slate-200',
  IN_REVIEW: 'bg-amber-50 text-amber-700 ring-amber-200',
  APPROVED: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
  SUPERSEDED: 'bg-violet-50 text-violet-700 ring-violet-200',
  ARCHIVED: 'bg-slate-100 text-slate-500 ring-slate-200',
};

function statusBadge(status: LabDocumentStatus): string {
  return `<span class="inline-flex items-center gap-1 whitespace-nowrap rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${STATUS_BADGE_CLS[status]}">${LAB_DOCUMENT_STATUS_LABELS[status]}</span>`;
}

function fmtDate(d: string | null): string {
  return d ? d.slice(0, 10) : '—';
}

const compareFormAction = `/lab/documents/${id}/versions`;
const versionRows = view?.versions ?? [];
const versionMeta = new Map(versionRows.map((v) => [v.id, v]));
const canCompare = versionRows.length >= 2;
---

<BaseLayout title={view ? `Version History · ${view.document.code}` : 'Document not found'}>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Documents', href: '/lab/documents' },
        // The per-document reader page (/lab/documents/[id]) does not exist yet,
        // so the code crumb is intentionally not a link (no dead links).
        ...(view ? [{ label: view.document.code }, { label: 'Versions' }] : []),
      ]}
    />

    {!view ? (
      <>
        <header>
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Controlled Documents</p>
          <h1 class="mt-1 text-3xl font-semibold text-slate-900">Document not found</h1>
        </header>
        <EmptyState
          title="Document not found"
          hint="This document does not exist — it may have been removed, or the link is stale."
          ctaHref="/lab/documents"
          ctaLabel="Back to the document library"
        />
      </>
    ) : (
      <>
        <header class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Controlled Documents</p>
            <h1 class="mt-1 text-3xl font-semibold text-slate-900">
              Version History · <span dir="ltr">{view.document.code}</span>
            </h1>
            <p class="mt-1 max-w-3xl text-sm text-slate-600">
              {view.document.title} — {LAB_DOCUMENT_TYPE_LABELS[view.document.type]}, current status{' '}
              <strong>{LAB_DOCUMENT_STATUS_LABELS[view.document.status]}</strong>. Every save is audited and each approved
              version is immutable; this page is read-only.
            </p>
          </div>
          <a
            href="/lab/documents"
            class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50"
          >
            ← Back to document library
          </a>
        </header>

        <LabSecondaryNav items={navItems} currentPath={`/lab/documents/${view.document.id}/versions`} />

        {versionRows.length === 0 ? (
          <EmptyState
            title="No versions yet"
            hint="This document has no numbered content versions — version history appears here as versions are created."
            ctaHref="/lab/documents"
            ctaLabel="Back to the document library"
          />
        ) : (
          <>
            <section aria-labelledby="version-history" class="rounded-xl border border-slate-200 bg-white shadow-sm">
              <div class="border-b border-slate-100 px-4 py-3">
                <h2 id="version-history" class="text-base font-semibold text-slate-900">Version History</h2>
                <p class="mt-0.5 text-xs text-slate-500">
                  {versionRows.length} version{versionRows.length === 1 ? '' : 's'} — newest first. Values shown are the
                  stored, immutable record; nothing here is derived at render time.
                </p>
              </div>
              <div class="overflow-x-auto contain-layout contain-paint">
                <table class="min-w-[1150px] divide-y divide-slate-100 text-sm">
                  <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                    <tr>
                      <th scope="col" class="px-4 py-2.5 font-semibold">Version</th>
                      <th scope="col" class="px-4 py-2.5 font-semibold">Status</th>
                      <th scope="col" class="px-4 py-2.5 font-semibold">Author</th>
                      <th scope="col" class="px-4 py-2.5 font-semibold">Created</th>
                      <th scope="col" class="px-4 py-2.5 font-semibold">Reviewer</th>
                      <th scope="col" class="px-4 py-2.5 font-semibold">Approver</th>
                      <th scope="col" class="px-4 py-2.5 font-semibold">Approval Date</th>
                      <th scope="col" class="px-4 py-2.5 font-semibold">Change Summary</th>
                      <th scope="col" class="px-4 py-2.5 font-semibold"><span class="sr-only">Actions</span></th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    {versionRows.map((v) => (
                      <tr class="align-middle">
                        <td class="px-4 py-2 whitespace-nowrap font-medium text-slate-900" dir="ltr">v{v.version}</td>
                        <td class="px-4 py-2" set:html={statusBadge(v.status)} />
                        <td class="px-4 py-2 whitespace-nowrap text-slate-700">{v.author_name ?? '—'}</td>
                        <td class="px-4 py-2 whitespace-nowrap text-slate-700" dir="ltr">{fmtDate(v.created_at)}</td>
                        <td class="px-4 py-2 whitespace-nowrap text-slate-700">{v.reviewer_name ?? '—'}</td>
                        <td class="px-4 py-2 whitespace-nowrap text-slate-700">{v.approver_name ?? '—'}</td>
                        <td class="px-4 py-2 whitespace-nowrap text-slate-700" dir="ltr">{fmtDate(v.approved_at)}</td>
                        <td class="px-4 py-2 text-slate-600">{v.change_summary ?? '—'}</td>
                        <td class="px-4 py-2 whitespace-nowrap">
                          <a
                            href={`/lab/acknowledgements?version=${v.id}`}
                            class="font-medium text-brand-600 hover:underline"
                          >
                            Acknowledgements
                          </a>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>

            {canCompare && (
              <section aria-labelledby="compare-versions" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <h2 id="compare-versions" class="text-base font-semibold text-slate-900">Compare Versions</h2>
                <p class="mt-0.5 text-xs text-slate-500">
                  Pick two versions to review their stored content side by side. Comparison is read-only — it renders
                  stored content and never writes anything.
                </p>

                <form method="get" action={compareFormAction} class="mt-3 flex flex-wrap items-end gap-3">
                  <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
                    Version A
                    <select
                      name="a"
                      class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
                    >
                      <option value="">— select —</option>
                      {versionRows.map((v) => (
                        <option value={v.id} selected={activeA === v.id}>
                          v{v.version} — {LAB_DOCUMENT_STATUS_LABELS[v.status]} — {fmtDate(v.created_at)}
                        </option>
                      ))}
                    </select>
                  </label>
                  <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
                    Version B
                    <select
                      name="b"
                      class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
                    >
                      <option value="">— select —</option>
                      {versionRows.map((v) => (
                        <option value={v.id} selected={activeB === v.id}>
                          v{v.version} — {LAB_DOCUMENT_STATUS_LABELS[v.status]} — {fmtDate(v.created_at)}
                        </option>
                      ))}
                    </select>
                  </label>
                  <button
                    type="submit"
                    class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
                  >
                    Compare
                  </button>
                  <a
                    href={compareFormAction}
                    class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50"
                  >
                    Clear
                  </a>
                </form>

                {compareA && compareB ? (
                  <>
                    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-slate-600">
                      <span>
                        Comparing <strong dir="ltr">v{compareA.version.version}</strong> and{' '}
                        <strong dir="ltr">v{compareB.version.version}</strong> — stored content shown verbatim.
                      </span>
                      <a
                        href={`${compareFormAction}?a=${compareB.version.id}&b=${compareA.version.id}`}
                        class="text-brand-600 hover:underline"
                      >
                        Swap
                      </a>
                    </div>
                    <div class="mt-3 grid gap-4 lg:grid-cols-2">
                      {[compareA, compareB].map((pane) => {
                        const meta = versionMeta.get(pane.version.id);
                        return (
                          <div class="overflow-hidden rounded-lg border border-slate-200">
                            <div class="border-b border-slate-100 bg-slate-50 px-4 py-3">
                              <div class="flex flex-wrap items-center gap-2">
                                <h3 class="text-sm font-semibold text-slate-900" dir="ltr">v{pane.version.version}</h3>
                                <span class="text-xs text-slate-500">{LAB_DOCUMENT_STATUS_LABELS[pane.version.status]}</span>
                              </div>
                              <p class="mt-1 text-xs text-slate-500">
                                Author: {meta?.author_name ?? '—'} · Created: {fmtDate(pane.version.created_at)}
                                {meta?.reviewer_name ? ` · Reviewer: ${meta.reviewer_name}` : ''}
                                {meta?.approver_name ? ` · Approved by: ${meta.approver_name}` : ''}
                              </p>
                            </div>
                            {pane.version.change_summary && (
                              <div class="border-b border-slate-100 bg-brand-50/40 px-4 py-2 text-sm text-slate-700">
                                <span class="font-medium">Change summary:</span> {pane.version.change_summary}
                              </div>
                            )}
                            <div class="max-h-[70vh] overflow-auto contain-layout contain-paint px-4 py-4">
                              <div class="doc-content" dir="ltr" set:html={pane.html} />
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </>
                ) : (
                  <p class="mt-3 text-sm text-slate-500">
                    {versionRows.length < 2
                      ? 'A second version is required before versions can be compared.'
                      : 'Select two different versions above to see their content side by side.'}
                  </p>
                )}
              </section>
            )}
          </>
        )}
        <AiReviewPanel feature="lab-document-changes" requestBody={{ id }} title="AI SOP/WI Change Summary" client:visible />
      </>
    )}
  </div>
</BaseLayout>