---
// /lab/documents — QC Laboratory SOP/WI Library register (PROMPT 39).
//
// Server-rendered register of controlled documents (page reference §39): the
// identity fields (code, title, type, status) live in lab_documents while the
// current version number comes from current_version_id → lab_document_versions
// (— when no version exists yet). Status is the stored five-state value
// (DRAFT / IN_REVIEW / APPROVED / SUPERSEDED / ARCHIVED) — nothing is derived.
// Approved versions are immutable; the register is read-only (the editor and
// workflow pages arrive in later prompts). Server-side search (title/code/
// product/equipment), filters (type/status/owner/equipment/product/review=due),
// safe sorting and pagination live in src/lib/lab/documents.ts — the URL is
// the source of truth, every SQL value is a bound parameter, and sorting is a
// whitelisted union. All roles may view (canViewLab); the New Document action
// is supervisor+ (canCreateLabDocument) and stays disabled until the editor
// page lands (no dead links).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import LabSaveViewForm from '../../../components/lab/LabSaveViewForm.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import {
  getLabDocumentInReviewCount,
  getLabDocumentReviewSummary,
  hasLabDocumentFilters,
  labDocumentFiltersToQuery,
  listLabDocumentEquipmentOptions,
  listLabDocumentOwners,
  listLabDocumentProductOptions,
  parseLabDocumentSearchFilters,
  searchLabDocuments,
  LAB_DOCUMENT_PER_PAGE_OPTIONS,
  LAB_DOCUMENT_REVIEW_FILTERS,
  LAB_DOCUMENT_REVIEW_STATE_LABELS,
  LAB_DOCUMENT_STATUS_LABELS,
  LAB_DOCUMENT_STATUSES,
  LAB_DOCUMENT_TYPE_LABELS,
  LAB_DOCUMENT_TYPES,
  type LabDocumentReviewFilter,
  type LabDocumentReviewState,
  type LabDocumentSearchFilters,
  type LabDocumentSortField,
} from '../../../lib/lab/documents';
import { canCreateLabDocument, canEditLabDocumentRecord } from '../../../lib/permissions';
import type { LabDocumentStatus, LabDocumentType, Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;

const navItems = labNavForRole(role);
const filters: LabDocumentSearchFilters = parseLabDocumentSearchFilters(Astro.url);

let dataError: string | null = null;
let result: ReturnType<typeof searchLabDocuments> = {
  rows: [],
  total: 0,
  page: 1,
  per_page: 25,
  total_pages: 1,
};
let owners: Array<{ id: number; full_name: string }> = [];
let equipmentOptions: Array<{ id: number; name: string; code: string }> = [];
let productOptions: Array<{ id: number; name: string; code: string }> = [];
let reviewSummary: ReturnType<typeof getLabDocumentReviewSummary> = {
  overdue: 0,
  due_today: 0,
  due_7: 0,
  due_15: 0,
  due_30: 0,
};
let inReviewCount = 0;
try {
  result = searchLabDocuments(filters);
  owners = listLabDocumentOwners();
  equipmentOptions = listLabDocumentEquipmentOptions();
  productOptions = listLabDocumentProductOptions();
  reviewSummary = getLabDocumentReviewSummary();
  inReviewCount = getLabDocumentInReviewCount();
} catch (err) {
  console.error('[lab] documents register query failure', err);
  dataError = 'Could not load the SOP / WI document library. Try reloading — if the problem persists, contact an administrator.';
}

const filtered = hasLabDocumentFilters(filters);

// Review-management summary strip (30 / 15 / 7 days remaining, today, overdue).
const REVIEW_WINDOWS: { key: LabDocumentReviewFilter; label: string; count: number }[] = [
  { key: 'overdue', label: 'Overdue', count: reviewSummary.overdue },
  { key: 'today', label: 'Due today', count: reviewSummary.due_today },
  { key: '7', label: 'Due within 7 days', count: reviewSummary.due_7 },
  { key: '15', label: 'Due within 15 days', count: reviewSummary.due_15 },
  { key: '30', label: 'Due within 30 days', count: reviewSummary.due_30 },
];

const qsParams = new URLSearchParams(labDocumentFiltersToQuery({ ...filters, page: 1 }).replace(/^\?/, ''));

function pageHref(p: number): string {
  const sp = new URLSearchParams(qsParams);
  if (p > 1) sp.set('page', String(p));
  else sp.delete('page');
  const qs = sp.toString();
  return qs ? `/lab/documents?${qs}` : '/lab/documents';
}

function sortHref(field: LabDocumentSortField): string {
  const next: LabDocumentSearchFilters = {
    ...filters,
    sort: field,
    dir: (filters.sort === field && filters.dir === 'asc' ? 'desc' : 'asc') as 'asc' | 'desc',
    page: 1,
  };
  return `/lab/documents${labDocumentFiltersToQuery(next)}`;
}

function sortArrow(field: LabDocumentSortField): string {
  if (filters.sort !== field) return '';
  return filters.dir === 'asc' ? ' ▲' : ' ▼';
}

const SORTABLE: { field: LabDocumentSortField; label: string }[] = [
  { field: 'code', label: 'Document Code' },
  { field: 'title', label: 'Title' },
  { field: 'type', label: 'Type' },
  { field: 'version', label: 'Version' },
  { field: 'status', label: 'Status' },
  { field: 'owner', label: 'Owner' },
  { field: 'effective_date', label: 'Effective Date' },
  { field: 'review_due_date', label: 'Review Due' },
  { field: 'review', label: 'Review' },
  { field: 'updated_at', label: 'Updated' },
];

function th(field: LabDocumentSortField, label: string): string {
  return `<a href="${sortHref(field)}" class="inline-flex items-center gap-1 hover:text-slate-900">${label}${sortArrow(field)}</a>`;
}

const pageNumbers: number[] = [];
{
  const total = result.total_pages;
  const cur = result.page;
  let start = Math.max(1, cur - 3);
  let end = Math.min(total, cur + 3);
  if (end - start < 6) {
    if (start === 1) end = Math.min(total, start + 6);
    else start = Math.max(1, end - 6);
  }
  for (let p = start; p <= end; p++) pageNumbers.push(p);
}

const STATUS_BADGE_CLS: Record<LabDocumentStatus, string> = {
  DRAFT: 'bg-slate-100 text-slate-700',
  IN_REVIEW: 'bg-amber-100 text-amber-800',
  APPROVED: 'bg-emerald-100 text-emerald-800',
  SUPERSEDED: 'bg-violet-100 text-violet-800',
  ARCHIVED: 'bg-slate-200 text-slate-600',
};

const TYPE_BADGE_CLS: Record<LabDocumentType, string> = {
  SOP: 'bg-sky-100 text-sky-800',
  WI: 'bg-indigo-100 text-indigo-800',
};

function statusBadge(status: LabDocumentStatus): string {
  return `<span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${STATUS_BADGE_CLS[status]}">${LAB_DOCUMENT_STATUS_LABELS[status]}</span>`;
}

function typeBadge(type: LabDocumentType): string {
  return `<span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${TYPE_BADGE_CLS[type]}">${LAB_DOCUMENT_TYPE_LABELS[type]}</span>`;
}

const REVIEW_BADGE_CLS: Record<LabDocumentReviewState, string> = {
  OVERDUE: 'bg-red-100 text-red-800',
  DUE_TODAY: 'bg-amber-100 text-amber-800',
  DUE_7: 'bg-orange-100 text-orange-800',
  DUE_15: 'bg-yellow-100 text-yellow-800',
  DUE_30: 'bg-sky-100 text-sky-800',
  OK: 'bg-slate-100 text-slate-600',
};

const REVIEW_FILTER_LABELS: Record<LabDocumentReviewFilter, string> = {
  due: 'Active — review date reached',
  overdue: LAB_DOCUMENT_REVIEW_STATE_LABELS.OVERDUE,
  today: LAB_DOCUMENT_REVIEW_STATE_LABELS.DUE_TODAY,
  '7': LAB_DOCUMENT_REVIEW_STATE_LABELS.DUE_7,
  '15': LAB_DOCUMENT_REVIEW_STATE_LABELS.DUE_15,
  '30': LAB_DOCUMENT_REVIEW_STATE_LABELS.DUE_30,
};

function reviewBadge(state: LabDocumentReviewState | null): string {
  if (!state) return `<span class="text-slate-400">—</span>`;
  return `<span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${REVIEW_BADGE_CLS[state]}">${LAB_DOCUMENT_REVIEW_STATE_LABELS[state]}</span>`;
}

function fmt(value: unknown): string {
  return value == null || String(value).trim() === '' ? '—' : String(value);
}
---

<BaseLayout title="SOP / WI Documents">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Documents' },
      ]}
    />

    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Controlled Documents</p>
        <h1 class="mt-1 text-3xl font-semibold text-slate-900">SOP / WI Documents</h1>
        <p class="mt-1 max-w-3xl text-sm text-slate-600">
          The controlled document library (SOP and WI). Status is stored (Draft / In Review / Approved / Superseded / Archived) and
          approved versions are immutable — the register shows the current version number, never fabricated history.
        </p>
      </div>
      {canCreateLabDocument(role) && (
        <a
          href="/lab/documents/new"
          class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
        >
          New Document
        </a>
      )}
    </header>

    <LabSecondaryNav items={navItems} currentPath="/lab/documents" />

    {dataError && (
      <div role="alert" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {dataError}
      </div>
    )}

    {!dataError && (
      <>
        <section aria-label="Document review status" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
          <div class="mb-3 flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Review management</h2>
            <div class="flex items-center gap-2">
              <a
                href="/lab/documents?status=IN_REVIEW"
                class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold ${
                  filters.status === 'IN_REVIEW'
                    ? 'bg-amber-600 text-white'
                    : 'bg-amber-100 text-amber-900 hover:bg-amber-200'
                }`}
              >
                <span>In Review Queue</span>
                <span class="rounded-full bg-amber-200/80 px-1.5 py-0.2 text-[10px] text-amber-950">{inReviewCount}</span>
              </a>
              <span class="text-xs text-slate-500">Active documents by review window</span>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5">
            {REVIEW_WINDOWS.map((w) => {
              const active = filters.review === w.key;
              const href = `/lab/documents?review=${w.key}`;
              return (
                <a
                  href={href}
                  aria-current={active ? 'true' : undefined}
                  class={`rounded-lg border p-3 transition hover:shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 ${
                    active ? 'border-brand-500 bg-brand-50' : 'border-slate-200 bg-white hover:border-slate-300'
                  }`}
                >
                  <span class="block text-2xl font-semibold text-slate-900" dir="ltr">{w.count}</span>
                  <span class="mt-0.5 block text-xs font-medium text-slate-600">{w.label}</span>
                </a>
              );
            })}
          </div>
        </section>

        <form method="get" action="/lab/documents" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
          <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Search
              <input
                type="search"
                name="q"
                value={filters.q ?? ''}
                placeholder="Title, document code, product, equipment…"
                class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
              />
            </label>
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Type
              <select name="type" class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="">All types</option>
                {LAB_DOCUMENT_TYPES.map((t) => (
                  <option value={t} selected={filters.type === t}>{LAB_DOCUMENT_TYPE_LABELS[t]}</option>
                ))}
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Status
              <select name="status" class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="">All statuses</option>
                {LAB_DOCUMENT_STATUSES.map((s) => (
                  <option value={s} selected={filters.status === s}>{LAB_DOCUMENT_STATUS_LABELS[s]}</option>
                ))}
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Owner
              <select name="owner" class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="">All owners</option>
                {owners.map((o) => (
                  <option value={o.id} selected={filters.owner === o.id}>{o.full_name}</option>
                ))}
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Equipment
              <select name="equipment" class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="">All equipment</option>
                {equipmentOptions.map((e) => (
                  <option value={e.id} selected={filters.equipment === e.id}>{e.code} — {e.name}</option>
                ))}
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Product
              <select name="product" class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="">All products</option>
                {productOptions.map((p) => (
                  <option value={p.id} selected={filters.product === p.id}>{p.code} — {p.name}</option>
                ))}
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Review Due
              <select name="review" class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="">All documents</option>
                {LAB_DOCUMENT_REVIEW_FILTERS.map((w) => (
                  <option value={w} selected={filters.review === w}>{REVIEW_FILTER_LABELS[w]}</option>
                ))}
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Per page
              <select name="per" class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                {LAB_DOCUMENT_PER_PAGE_OPTIONS.map((n) => (
                  <option value={n} selected={filters.per_page === n}>{n} per page</option>
                ))}
              </select>
            </label>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">Apply filters</button>
            <a href="/lab/documents" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">Reset</a>
          </div>
        </form>

        <LabSaveViewForm path="/lab/documents" />

        <p class="text-sm text-slate-600">
          {result.total.toLocaleString('en-US')} document{result.total === 1 ? '' : 's'} found
          {filtered && <span> (filtered — <a href="/lab/documents" class="text-brand-600 hover:underline">clear all</a>)</span>}
        </p>

        {result.rows.length === 0 ? (
          <EmptyState
            title={filtered ? 'No documents match your search' : 'No controlled documents yet'}
            hint={filtered ? 'Try adjusting the search or clearing the filters.' : 'Controlled SOP / WI documents appear here as they are created — nothing is fabricated.'}
            ctaHref={filtered ? '/lab/documents' : '/lab'}
            ctaLabel={filtered ? 'Clear filters' : 'Back to the command center'}
          />
        ) : (
          <section aria-label="Document Library" class="rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto contain-layout contain-paint">
              <table class="min-w-[1260px] divide-y divide-slate-100 text-sm">
                <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    {SORTABLE.map((s) => (
                      <th scope="col" class="px-4 py-2.5 font-semibold" set:html={th(s.field, s.label)} />
                    ))}
                    <th scope="col" class="px-4 py-2.5 font-semibold"><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {result.rows.map((r) => (
                    <tr class="align-middle">
                      <td class="px-4 py-2 font-medium text-slate-900" dir="ltr">
                        <a href={`/lab/documents/${r.id}`} class="text-brand-600 hover:underline">{r.code}</a>
                      </td>
                      <td class="px-4 py-2">
                        <a href={`/lab/documents/${r.id}`} class="font-medium text-slate-900 hover:text-brand-600">{r.title}</a>
                        {r.product_name && <div class="text-xs text-slate-500">Product: {r.product_name}</div>}
                      </td>
                      <td class="px-4 py-2" set:html={typeBadge(r.type)} />
                      <td class="px-4 py-2 whitespace-nowrap text-slate-700" dir="ltr">{r.version == null ? '—' : `v${r.version}`}</td>
                      <td class="px-4 py-2" set:html={statusBadge(r.status)} />
                      <td class="px-4 py-2 text-slate-700">{r.owner_name ?? '—'}</td>
                      <td class="px-4 py-2 whitespace-nowrap text-slate-700" dir="ltr">{fmt(r.effective_date)}</td>
                      <td class="px-4 py-2 whitespace-nowrap text-slate-700" dir="ltr">{fmt(r.review_due_date)}</td>
                      <td class="px-4 py-2" set:html={reviewBadge(r.review_state)} />
                      <td class="px-4 py-2 whitespace-nowrap text-slate-500" dir="ltr">{r.updated_at.slice(0, 10)}</td>
                      <td class="px-4 py-2">
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                          <a
                            href={`/lab/documents/${r.id}`}
                            class="font-medium text-brand-600 hover:underline"
                          >
                            View
                          </a>
                          <a
                            href={`/lab/documents/${r.id}/versions`}
                            class="font-medium text-brand-600 hover:underline"
                          >
                            Versions
                          </a>
                          {canEditLabDocumentRecord({ id: user.userId, role }, r) && r.status !== 'ARCHIVED' && (
                            <a
                              href={`/lab/documents/${r.id}/edit`}
                              class="font-medium text-brand-600 hover:underline"
                            >
                              Edit
                            </a>
                          )}
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {result.total_pages > 1 && (
          <nav aria-label="Pagination" class="flex flex-wrap items-center justify-center gap-2">
            {result.page > 1 ? (
              <a href={pageHref(result.page - 1)} class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">← Prev</a>
            ) : (
              <span class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-400">← Prev</span>
            )}
            {pageNumbers.map((p) => (
              <a
                href={pageHref(p)}
                aria-current={p === result.page ? 'page' : undefined}
                class={`rounded-md px-3 py-1.5 text-sm font-medium ${
                  p === result.page ? 'bg-brand-600 text-white' : 'border border-slate-300 bg-white text-slate-700 hover:bg-slate-50'
                }`}
              >
                {p}
              </a>
            ))}
            {result.page < result.total_pages ? (
              <a href={pageHref(result.page + 1)} class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Next →</a>
            ) : (
              <span class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-400">Next →</span>
            )}
          </nav>
        )}
      </>
    )}
  </div>
</BaseLayout>