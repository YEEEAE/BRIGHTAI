---
// /lab/equipment/new — add a device to the Equipment Registry (PROMPT 11).
// Manager+ only (canCreateLabEquipment); the shared form component posts to
// this same URL and the middleware short-circuits the POST.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import LabEquipmentForm from '../../../components/lab/LabEquipmentForm.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import { canCreateLabEquipment, canProposeLabEquipmentCreate } from '../../../lib/permissions';
import { setFlash } from '../../../lib/flash';
import type { Role } from '../../../lib/types';
import PageHeader from '../../../components/ui/PageHeader.astro';

const user = Astro.locals.user!;
const role = user.role as Role;

if (!canCreateLabEquipment(role) && !canProposeLabEquipmentCreate(role)) {
  setFlash(Astro, 'error', 'You do not have permission to add equipment to the registry.');
  return Astro.redirect('/lab/equipment');
}

const navItems = labNavForRole(role);
---

<BaseLayout title="New Equipment">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Equipment', href: '/lab/equipment' },
        { label: 'New Equipment' },
      ]}
    />

    <PageHeader eyebrow="QC Laboratory — Master Data" title="New Equipment" description="Register a device in the laboratory registry. Status and calibration are stored verbatim as company data; every change is written to the audit log." />

    <LabSecondaryNav items={navItems} currentPath="/lab/equipment/new" />

    <LabEquipmentForm mode="create" isContributor={canProposeLabEquipmentCreate(role)} />
  </div>
</BaseLayout>
