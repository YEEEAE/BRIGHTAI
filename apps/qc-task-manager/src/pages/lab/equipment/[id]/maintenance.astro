---
// /lab/equipment/[id]/maintenance — maintenance log + combined equipment
// timeline (contract §5.2 route map, page reference §33/§36).
//
// Read-only for every role; the "Log Maintenance Event" form appears only to
// LAB_EQUIPMENT_MAINTENANCE holders (supervisor+) and never on archived
// equipment. Maintenance events are APPEND-ONLY and are never seeded — the
// history starts empty and only records what a user actually logs (no
// fabricated historical events, page reference §36/§78). Every event writes a
// CREATE row to the shared qc_audit_log (entity_type=
// 'LAB_EQUIPMENT_MAINTENANCE'), shown here as an audit trail.
//
// The Equipment Timeline combines the four lifecycle streams for this device:
//   USAGE               — lab_test_records referencing it (drills into the test)
//   MAINTENANCE         — logged events
//   CALIBRATION         — lab_equipment_calibration records
//   RETURNED_TO_SERVICE — derived from COMPLETED events with a completed_date
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import EmptyState from '../../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../../lib/lab/navigation';
import {
  getLabEquipmentDetail,
  getLabEquipmentMaintenanceAudit,
  getLabEquipmentTimeline,
  listLabEquipmentMaintenance,
} from '../../../../lib/lab/equipment';
import type { LabEquipmentTimelineEntry } from '../../../../lib/lab/equipment';
import type { LabEquipmentMaintenance } from '../../../../lib/types';
import { statusLabels } from '../../../../lib/lab/equipmentStatus';
import { LAB_MAINTENANCE_STATUSES, LAB_MAINTENANCE_STATUS_LABELS } from '../../../../lib/lab/policy';
import { canRecordLabEquipmentMaintenance } from '../../../../lib/permissions';
import type { Role } from '../../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;

const id = Number(Astro.params.id);
let detail: ReturnType<typeof getLabEquipmentDetail> = null;
let maintenance: LabEquipmentMaintenance[] = [];
let timeline: LabEquipmentTimelineEntry[] = [];
let maintenanceAudit: Array<Record<string, unknown>> = [];
try {
  detail = getLabEquipmentDetail(id);
  if (detail) {
    maintenance = listLabEquipmentMaintenance(id);
    timeline = getLabEquipmentTimeline(id);
    maintenanceAudit = getLabEquipmentMaintenanceAudit(id);
  }
} catch (err) {
  console.error('[lab] equipment maintenance query failure', err);
}

const canRecord = canRecordLabEquipmentMaintenance(role);
const isArchived = detail?.equipment.is_archived === 1;
const navItems = labNavForRole(role);

const inputCls =
  'mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500';
const labelCls = 'block text-sm font-medium text-slate-700';
const sectionCls = 'rounded-xl border border-slate-200 bg-white p-5 shadow-sm';
const sectionTitleCls = 'text-base font-semibold text-slate-900';

function fmt(value: unknown): string {
  return value == null || String(value).trim() === '' ? '—' : String(value);
}

const TIMELINE_KIND_LABELS: Record<string, { label: string; cls: string }> = {
  USAGE: { label: 'Usage', cls: 'bg-sky-100 text-sky-800' },
  MAINTENANCE: { label: 'Maintenance', cls: 'bg-amber-100 text-amber-800' },
  CALIBRATION: { label: 'Calibration', cls: 'bg-violet-100 text-violet-800' },
  RETURNED_TO_SERVICE: { label: 'Returned to service', cls: 'bg-emerald-100 text-emerald-800' },
};

const MAINT_STATUS_CLS: Record<string, string> = {
  PLANNED: 'bg-slate-100 text-slate-700',
  IN_PROGRESS: 'bg-sky-100 text-sky-800',
  COMPLETED: 'bg-emerald-100 text-emerald-800',
  CANCELLED: 'bg-rose-100 text-rose-800',
};
---

<BaseLayout title={detail ? `Maintenance · ${detail.equipment.code}` : 'Equipment not found'}>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Equipment', href: '/lab/equipment' },
        ...(detail ? [{ label: detail.equipment.code, href: `/lab/equipment/${detail.equipment.id}` }] : []),
        ...(detail ? [{ label: 'Maintenance' }] : []),
      ]}
    />

    {!detail ? (
      <EmptyState
        title="Equipment not found"
        hint="This device does not exist — it may have been removed, or the link is stale."
        ctaHref="/lab/equipment"
        ctaLabel="Back to the Equipment Registry"
      />
    ) : (
      <>
        <header class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Master Data</p>
            <h1 class="mt-1 text-3xl font-semibold text-slate-900">Maintenance · {detail.equipment.name}</h1>
            <p class="mt-1 text-sm text-slate-600">
              Code <span class="font-medium text-slate-900" dir="ltr">{detail.equipment.code}</span>
              <span class="ms-3 inline-flex rounded-full px-2.5 py-1 text-xs font-semibold bg-slate-100 text-slate-700">
                {statusLabels(detail.equipment.status_raw)}
              </span>
              {isArchived && (
                <span class="ms-2 inline-flex rounded-full bg-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-500">Archived</span>
              )}
            </p>
          </div>
          <a
            href={`/lab/equipment/${detail.equipment.id}`}
            class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
          >
            ← Equipment details
          </a>
        </header>

        <LabSecondaryNav items={navItems} currentPath={`/lab/equipment/${detail.equipment.id}/maintenance`} />

        {isArchived && (
          <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            This equipment is archived — new maintenance events cannot be logged. Restore it from the equipment details page to
            continue its history.
          </div>
        )}

        {canRecord && !isArchived && (
          <section aria-labelledby="sec-log" class={sectionCls}>
            <h2 id="sec-log" class={sectionTitleCls}>Log Maintenance Event</h2>
            <p class="mt-1 text-sm text-slate-600">
              Record a maintenance event. Events are append-only and written to the audit log — they cannot be edited or deleted.
            </p>
            <form method="POST" action={`/api/lab/equipment/${detail.equipment.id}/maintenance`} class="mt-4">
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="maintenance_date" class={labelCls}>Maintenance Date <span class="text-red-600" aria-hidden="true">*</span></label>
                  <input id="maintenance_date" name="maintenance_date" type="date" required class={inputCls} />
                </div>
                <div>
                  <label for="maintenance_type" class={labelCls}>Maintenance Type <span class="text-red-600" aria-hidden="true">*</span></label>
                  <input id="maintenance_type" name="maintenance_type" type="text" maxlength="200" required class={inputCls} placeholder="e.g. Preventive / Corrective / Calibration" />
                </div>
                <div class="sm:col-span-2">
                  <label for="issue" class={labelCls}>Issue <span class="text-red-600" aria-hidden="true">*</span></label>
                  <input id="issue" name="issue" type="text" maxlength="200" required class={inputCls} placeholder="Brief description of the issue" />
                </div>
                <div class="sm:col-span-2">
                  <label for="description" class={labelCls}>Description</label>
                  <textarea id="description" name="description" rows="3" maxlength="5000" class={inputCls}></textarea>
                </div>
                <div>
                  <label for="technician_vendor" class={labelCls}>Technician / Vendor <span class="text-red-600" aria-hidden="true">*</span></label>
                  <input id="technician_vendor" name="technician_vendor" type="text" maxlength="200" required class={inputCls} />
                </div>
                <div>
                  <label for="status" class={labelCls}>Status <span class="text-red-600" aria-hidden="true">*</span></label>
                  <select id="status" name="status" required class={inputCls}>
                    {LAB_MAINTENANCE_STATUSES.map((s: (typeof LAB_MAINTENANCE_STATUSES)[number]) => (
                      <option value={s}>{LAB_MAINTENANCE_STATUS_LABELS[s]}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label for="completed_date" class={labelCls}>Completed Date</label>
                  <input id="completed_date" name="completed_date" type="date" class={inputCls} />
                  <p class="mt-1 text-xs text-slate-500">Required when the status is Completed — the equipment is back in service on this date.</p>
                </div>
                <div class="sm:col-span-2">
                  <label for="notes" class={labelCls}>Notes</label>
                  <textarea id="notes" name="notes" rows="2" maxlength="5000" class={inputCls}></textarea>
                </div>
              </div>
              <div class="mt-5">
                <button
                  type="submit"
                  class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
                >
                  Record Maintenance Event
                </button>
              </div>
            </form>
          </section>
        )}

        <section aria-labelledby="sec-history" class={sectionCls}>
          <h2 id="sec-history" class={sectionTitleCls}>Maintenance History</h2>
          {maintenance.length === 0 ? (
            <p class="mt-2 text-sm text-slate-600">
              No maintenance events recorded. This history is never fabricated — it only shows events logged here.
            </p>
          ) : (
            <div class="mt-3 overflow-x-auto contain-layout contain-paint">
              <table class="min-w-[920px] divide-y divide-slate-100 text-sm">
                <thead class="text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    <th scope="col" class="px-3 py-2 font-semibold">Maintenance Date</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Issue</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Type</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Technician / Vendor</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Status</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Completed Date</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Logged By</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {maintenance.map((m) => (
                    <tr>
                      <td class="px-3 py-2 whitespace-nowrap text-slate-900">{fmt(m.maintenance_date)}</td>
                      <td class="px-3 py-2">
                        <div class="font-medium text-slate-900">{fmt(m.issue)}</div>
                        {(m.description || m.notes) && <div class="mt-0.5 max-w-xs truncate text-xs text-slate-500">{fmt(m.description || m.notes)}</div>}
                      </td>
                      <td class="px-3 py-2 text-slate-700">{fmt(m.maintenance_type)}</td>
                      <td class="px-3 py-2 text-slate-700">{fmt(m.technician_vendor)}</td>
                      <td class="px-3 py-2">
                        <span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${MAINT_STATUS_CLS[m.status ?? ''] ?? 'bg-slate-100 text-slate-700'}`}>
                          {m.status ? LAB_MAINTENANCE_STATUS_LABELS[m.status as keyof typeof LAB_MAINTENANCE_STATUS_LABELS] ?? m.status : '—'}
                        </span>
                      </td>
                      <td class="px-3 py-2 whitespace-nowrap text-slate-700">{fmt(m.completed_date)}</td>
                      <td class="px-3 py-2 text-slate-700">{fmt(maintenanceAudit.find((a) => Number(a.entity_id) === m.id)?.actor_name)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        <section aria-labelledby="sec-timeline" class={sectionCls}>
          <h2 id="sec-timeline" class={sectionTitleCls}>Equipment Timeline</h2>
          <p class="mt-1 text-sm text-slate-600">
            Combined lifecycle history for this device — usage, maintenance, calibration, and returned-to-service events, newest
            first.
          </p>
          {timeline.length === 0 ? (
            <p class="mt-2 text-sm text-slate-600">
              No timeline activity yet. Usage appears when tests reference this device; maintenance and calibration appear as they
              are logged.
            </p>
          ) : (
            <ol class="mt-4 space-y-3">
              {timeline.map((entry) => {
                const kind = TIMELINE_KIND_LABELS[entry.kind] ?? { label: entry.kind, cls: 'bg-slate-100 text-slate-700' };
                return (
                  <li class="flex items-start gap-3 rounded-lg border border-slate-100 bg-slate-50/60 px-3 py-2.5">
                    <span class={`mt-0.5 shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold ${kind.cls}`}>{kind.label}</span>
                    <div class="min-w-0">
                      {entry.href ? (
                        <a href={entry.href} class="font-medium text-brand-600 hover:underline">
                          {entry.title}
                        </a>
                      ) : (
                        <p class="font-medium text-slate-900">{entry.title}</p>
                      )}
                      {entry.detail && <p class="mt-0.5 text-xs text-slate-500">{entry.detail}</p>}
                    </div>
                    <span class="ms-auto shrink-0 whitespace-nowrap text-xs text-slate-500" dir="ltr">{String(entry.at)}</span>
                  </li>
                );
              })}
            </ol>
          )}
        </section>

        <section aria-labelledby="sec-audit" class={sectionCls}>
          <h2 id="sec-audit" class={sectionTitleCls}>Maintenance Audit Trail</h2>
          {maintenanceAudit.length === 0 ? (
            <p class="mt-2 text-sm text-slate-600">No maintenance changes have been audited yet.</p>
          ) : (
            <div class="mt-3 overflow-x-auto contain-layout contain-paint">
              <table class="min-w-[640px] divide-y divide-slate-100 text-sm">
                <thead class="text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    <th scope="col" class="px-3 py-2 font-semibold">When</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Actor</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Action</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Detail</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {maintenanceAudit.map((entry) => (
                    <tr>
                      <td class="px-3 py-2 text-slate-500">{String(entry.created_at)}</td>
                      <td class="px-3 py-2 text-slate-700">{String(entry.actor_name ?? '—')}</td>
                      <td class="px-3 py-2 font-medium text-slate-900">{String(entry.action)}</td>
                      <td class="px-3 py-2 text-slate-600" dir="ltr">{String(entry.note ?? '—')}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </>
    )}
  </div>
</BaseLayout>