---
// /lab/equipment — QC Laboratory Equipment Registry (PROMPT 11).
//
// Server-rendered table of the 24-device registry (columns: Equipment | Code |
// Location | Status | Calibration | Serial Number | Notes | Updated By/At).
// Server-side search, safe sorting and pagination live in src/lib/lab/
// equipment.ts — the URL is the source of truth, every SQL value is a bound
// parameter, and sorting is a whitelisted union. Status and calibration are
// displayed via the read-time mapping (equipmentStatus.ts); stored text is
// never rewritten. Employees may view; only manager+ get New / Edit /
// Archive affordances (canCreateLabEquipment / canEditLabEquipment /
// canArchiveLabEquipment).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import LabSaveViewForm from '../../../components/lab/LabSaveViewForm.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import {
  hasLabEquipmentFilters,
  labEquipmentFiltersToQuery,
  parseLabEquipmentSearchFilters,
  searchLabEquipment,
  LAB_EQUIPMENT_PER_PAGE_OPTIONS,
  type LabEquipmentSearchFilters,
  type LabEquipmentSortField,
} from '../../../lib/lab/equipment';
import { STATUS_FILTER_LABELS, calibrationLabel, statusLabels } from '../../../lib/lab/equipmentStatus';
import { canArchiveLabEquipment, canCreateLabEquipment, canEditLabEquipment, canProposeLabEquipmentCreate, canProposeLabEquipmentEdit } from '../../../lib/permissions';
import type { Role } from '../../../lib/types';
import Banner from '../../../components/ui/Banner.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { FILTER_TOOLBAR, FILTER_FIELD, FILTER_CONTROL } from '../../../components/ui/formPresets';
import AppButton from '../../../components/ui/AppButton.astro';

const user = Astro.locals.user!;
const role = user.role as Role;

const navItems = labNavForRole(role);
const filters: LabEquipmentSearchFilters = parseLabEquipmentSearchFilters(Astro.url);

let dataError: string | null = null;
let result: ReturnType<typeof searchLabEquipment> = { rows: [], total: 0, page: 1, per_page: 25, total_pages: 1 };
try {
  result = searchLabEquipment(filters);
} catch (err) {
  console.error('[lab] equipment registry query failure', err);
  dataError = 'Could not load the Equipment Registry. Try reloading — if the problem persists, contact an administrator.';
}

const filtered = hasLabEquipmentFilters(filters);

const qsParams = new URLSearchParams(labEquipmentFiltersToQuery({ ...filters, page: 1 }).replace(/^\?/, ''));

function pageHref(p: number): string {
  const sp = new URLSearchParams(qsParams);
  if (p > 1) sp.set('page', String(p));
  else sp.delete('page');
  const qs = sp.toString();
  return qs ? `/lab/equipment?${qs}` : '/lab/equipment';
}

function sortHref(field: LabEquipmentSortField): string {
  const next: LabEquipmentSearchFilters = {
    ...filters,
    sort: field,
    dir: (filters.sort === field && filters.dir === 'asc' ? 'desc' : 'asc') as 'asc' | 'desc',
    page: 1,
  };
  return `/lab/equipment${labEquipmentFiltersToQuery(next)}`;
}

function sortArrow(field: LabEquipmentSortField): string {
  if (filters.sort !== field) return '';
  return filters.dir === 'asc' ? ' ▲' : ' ▼';
}

const SORTABLE: { field: LabEquipmentSortField; label: string }[] = [
  { field: 'code', label: 'Code' },
  { field: 'name', label: 'Equipment' },
  { field: 'location', label: 'Location' },
  { field: 'status_raw', label: 'Status' },
  { field: 'serial_number', label: 'Serial Number' },
  { field: 'updated_at', label: 'Updated' },
];

function th(field: LabEquipmentSortField, label: string): string {
  return `<a href="${sortHref(field)}" class="inline-flex items-center gap-1 hover:text-slate-900">${label}${sortArrow(field)}</a>`;
}


function statusBadgeClass(raw: string): string {
  const label = statusLabels(raw);
  if (label.includes('In Use')) return 'bg-emerald-100 text-emerald-800';
  if (label.includes('Under Maintenance')) return 'bg-amber-100 text-amber-800';
  if (label.includes('Not In Use')) return 'bg-slate-200 text-slate-600';
  if (label.includes('New')) return 'bg-sky-100 text-sky-800';
  return 'bg-slate-100 text-slate-700';
}
---

<BaseLayout title="Equipment Registry">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Equipment' },
      ]}
    />

    <PageHeader eyebrow="QC Laboratory — Master Data" title="Equipment Registry" description="The laboratory's device registry (24 seeded devices). Tests reference equipment by canonical ID, so retiring a device is archive — never a hard delete. Status and calibration values are stored verbatim." />

    <LabSecondaryNav items={navItems} currentPath="/lab/equipment" />

    {dataError && (
      <Banner tone="error">{dataError}</Banner>
    )}

    {!dataError && (
      <>
        <form method="get" action="/lab/equipment" class={FILTER_TOOLBAR}>
          <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
            <label class={FILTER_FIELD}>
              Search
              <input
                type="search"
                name="q"
                value={filters.q ?? ''}
                placeholder="Name, code, serial, location, notes…"
                class={FILTER_CONTROL}
              />
            </label>
            <label class={FILTER_FIELD}>
              Status
              <select name="status" class={FILTER_CONTROL}>
                <option value="">All statuses</option>
                {STATUS_FILTER_LABELS.map((label) => (
                  <option value={label} selected={filters.status === label}>{label}</option>
                ))}
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Calibration
              <select name="calibration" class={FILTER_CONTROL}>
                <option value="">All</option>
                <option value="yes" selected={filters.calibration === 'yes'}>Calibrated (Yes)</option>
                <option value="no" selected={filters.calibration === 'no'}>Not calibrated (No)</option>
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Registry
              <select name="archived" class={FILTER_CONTROL}>
                <option value="0" selected={filters.archived === '0'}>Active only</option>
                <option value="1" selected={filters.archived === '1'}>Archived only</option>
                <option value="all" selected={filters.archived === null}>All (incl. archived)</option>
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Per page
              <select name="per" class={FILTER_CONTROL}>
                {LAB_EQUIPMENT_PER_PAGE_OPTIONS.map((n) => (
                  <option value={n} selected={filters.per_page === n}>{n} per page</option>
                ))}
              </select>
            </label>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <AppButton type="submit" variant="primary">Apply filters</AppButton>
            <AppButton href="/lab/equipment" variant="secondary">Reset</AppButton>
          </div>
        </form>

        <LabSaveViewForm path="/lab/equipment" />

        <p class="text-sm text-slate-600">
          {result.total.toLocaleString('en-US')} device{result.total === 1 ? '' : 's'} found
          {filtered && <span> (filtered — <a href="/lab/equipment" class="text-brand-600 hover:underline">clear all</a>)</span>}
        </p>

        {result.rows.length === 0 ? (
          <EmptyState
            title={filtered ? 'No devices match your search' : 'No equipment registered yet'}
            hint={filtered ? 'Try adjusting the search or clearing the filters.' : 'The seeded registry loads automatically; new devices can be added here.'}
            ctaHref={filtered ? '/lab/equipment' : canCreateLabEquipment(role) ? '/lab/equipment/new' : '/lab'}
            ctaLabel={filtered ? 'Clear filters' : 'New Equipment'}
          />
        ) : (
          <section aria-label="Equipment Registry" class="rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto contain-layout contain-paint">
              <table class="min-w-[1000px] divide-y divide-slate-100 text-sm">
                <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    {SORTABLE.map((s) => (
                      <th scope="col" class="px-4 py-2.5 font-semibold" set:html={th(s.field, s.label)} />
                    ))}
                    <th scope="col" class="px-4 py-2.5 font-semibold">Calibration</th>
                    <th scope="col" class="px-4 py-2.5 font-semibold">Notes</th>
                    <th scope="col" class="px-4 py-2.5 font-semibold">Updated By/At</th>
                    <th scope="col" class="px-4 py-2.5 font-semibold"><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {result.rows.map((e) => (
                    <tr class="align-middle">
                      <td class="px-4 py-2 font-medium text-slate-900" dir="ltr">{e.code}</td>
                      <td class="px-4 py-2 text-slate-700">{e.name}{e.is_archived === 1 && <span class="ms-2 rounded-full bg-slate-200 px-2 py-0.5 text-xs font-semibold text-slate-500">Archived</span>}</td>
                      <td class="px-4 py-2 text-slate-600">{e.location ?? '—'}</td>
                      <td class="px-4 py-2">
                        <span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${statusBadgeClass(e.status_raw)}`}>
                          {statusLabels(e.status_raw)}
                        </span>
                      </td>
                      <td class="px-4 py-2 text-slate-600">{calibrationLabel(e.calibration_status_raw)}</td>
                      <td class="px-4 py-2 text-slate-600" dir="ltr">{e.serial_number ?? '—'}</td>
                      <td class="px-4 py-2 max-w-[220px] truncate text-slate-600" title={e.notes ?? ''}>{e.notes ?? '—'}</td>
                      <td class="px-4 py-2 text-slate-500">
                        {e.updated_by_name ? `${e.updated_by_name} · ` : ''}{e.updated_at}
                      </td>
                      <td class="px-4 py-2">
                        <span class="flex items-center gap-2">
                          <a href={`/lab/equipment/${e.id}`} class="font-medium text-brand-600 hover:underline">View</a>
                          {(canEditLabEquipment(role) || canProposeLabEquipmentEdit(role)) && e.is_archived === 0 && (
                            <a href={`/lab/equipment/${e.id}/edit`} class="font-medium text-slate-600 hover:underline">Edit</a>
                          )}
                          {canArchiveLabEquipment(role) && (
                            <form method="POST" action={`/lab/equipment/${e.id}/edit`}>
                              <input type="hidden" name="form_action" value={e.is_archived === 1 ? 'restore' : 'archive'} />
                              <button type="submit" class="font-medium text-amber-600 hover:underline">
                                {e.is_archived === 1 ? 'Restore' : 'Archive'}
                              </button>
                            </form>
                          )}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <Pagination page={result.page} totalPages={result.total_pages} hrefFor={pageHref} />
      </>
    )}
  </div>
</BaseLayout>
