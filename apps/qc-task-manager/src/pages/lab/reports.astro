---
// /lab/reports — QC Laboratory Reports (QC-LAB-ARCHITECTURE.md §13).
//
// 16 laboratory reports rendered through the SAME reporting pipeline as the
// task reports (api/reports/[reportType].[format] with the csv/xlsx/pdf
// writers) — this page is only the catalog + filter form. RBAC is enforced
// twice: here (canViewLabReports) and again in authorizeReport, which denies
// the employee role for every lab report type. Every generation is recorded
// in report_audit_log.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../components/lab/LabSecondaryNav.astro';
import { setFlash } from '../../lib/flash';
import { labNavForRole } from '../../lib/lab/navigation';
import { canViewLabReports } from '../../lib/permissions';
import { REPORT_CATALOG } from '../../lib/reporting/catalog';
import { LAB_REPORT_TYPES } from '../../lib/reporting/types';
import { LAB_RESULT_OPTIONS, LAB_RETEST_REASONS } from '../../lib/lab/policy';
import { LAB_REPORT_STATUSES, listLabProductsForReports, listLabEquipmentForReports } from '../../lib/lab/labReports';
import { getLabFailRateTrends, getLabFailRateByProduct, labTrendDrilldown, type LabTrendGranularity } from '../../lib/lab/trends';
import LabFailRateChart from '../../components/lab/LabFailRateChart';
import type { Role } from '../../lib/types';
import PageHeader from '../../components/ui/PageHeader.astro';
import { FILTER_TOOLBAR, FILTER_FIELD } from '../../components/ui/formPresets';
import AppButton from '../../components/ui/AppButton.astro';
import { parseReportFilters, parseReportScope } from '../../lib/reporting/filters';
import { resolveReportPreview } from '../../lib/reporting/preview';

const user = Astro.locals.user!;
const role = user.role as Role;

// Page-level guard: the /lab prefix wall only checks LAB_VIEW (all lab roles);
// reports are supervisor+. Everyone else is bounced to /lab.
if (!canViewLabReports(role)) {
  setFlash(Astro, 'error', 'You do not have permission to access laboratory reports.');
  return Astro.redirect('/lab');
}

const navItems = labNavForRole(role);

// Only the laboratory report types are shown on this page (task reports live
// on /reports). Order follows the §13 report list.
const labReports = LAB_REPORT_TYPES.map((key) => REPORT_CATALOG[key]).filter(Boolean);

const requestedType = Astro.url.searchParams.get('report_type');
const selected = labReports.find((r) => r.key === requestedType) ?? labReports[0];
const currentType = selected.key;

// Carry forward filter params into the download links (server re-validates).
const filters = new URLSearchParams(Astro.url.searchParams);
filters.delete('report_type');
filters.delete('format');
filters.delete('trend');
const query = filters.toString();
let preview: Awaited<ReturnType<typeof resolveReportPreview>> | null = null;
try {
  preview = await resolveReportPreview({
    actor: { id: user.userId, role: user.role, department: null },
    reportType: currentType,
    filters: parseReportFilters(Astro.url.searchParams),
    comprehensive: parseReportScope(Astro.url.searchParams),
  });
} catch {
  preview = null;
}
const previewFilters = preview && preview.allowed
  ? Object.entries(preview.filters).filter(([, value]) => value !== null && value !== '').map(([key, value]) => `${key.replaceAll('_', ' ')}: ${String(value)}`)
  : [];

const products = listLabProductsForReports();
const equipment = listLabEquipmentForReports();

// Optional FAIL-rate trend view (?trend=week|month) — read-only over existing
// test records, links drill into the implemented test register only.
const trendParam = Astro.url.searchParams.get('trend');
const showTrend = trendParam === 'week' || trendParam === 'month';
const trendGranularity: LabTrendGranularity = trendParam === 'month' ? 'month' : 'week';
let trendData: ReturnType<typeof getLabFailRateTrends> | null = null;
let trendByProduct: ReturnType<typeof getLabFailRateByProduct> = [];
if (showTrend) {
  try {
    trendData = getLabFailRateTrends(trendGranularity, 8);
    trendByProduct = getLabFailRateByProduct(trendGranularity, 8);
  } catch (err) {
    console.error('[lab] fail-rate trend query failure', err);
  }
}
---

<BaseLayout title="Laboratory Reports">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Reports' },
      ]}
    />

    <PageHeader eyebrow="QC Laboratory — Operations" title="Laboratory Reports" description={`Generate the ${labReports.length} laboratory reports (registers, results, calibration, documents, activity, data quality, retention status) as CSV, Excel, or PDF. Exports respect the selected filters and your data scope, and every generation is recorded in the report audit log. Report content is metadata only — document bodies and test snapshots are never exported.`} />

    <LabSecondaryNav items={navItems} currentPath="/lab/reports" />

    <!-- Filter form -->
    <form method="get" action="/lab/reports" class={FILTER_TOOLBAR}>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <label class={FILTER_FIELD}>Report type
          <select name="report_type" class="rounded-md border border-slate-300 px-3 py-2">
            {labReports.map((report) => <option value={report.key} selected={currentType === report.key}>{report.label}</option>)}
          </select>
        </label>
        <label class={FILTER_FIELD}>From date<input type="date" name="from" value={Astro.url.searchParams.get('from') ?? ''} class="rounded-md border border-slate-300 px-3 py-2" /></label>
        <label class={FILTER_FIELD}>To date<input type="date" name="to" value={Astro.url.searchParams.get('to') ?? ''} class="rounded-md border border-slate-300 px-3 py-2" /></label>
        <label class={FILTER_FIELD}>Test type
          <select name="test_type" class="rounded-md border border-slate-300 px-3 py-2"><option value="">All types</option>{['air', 'vacuum'].map((v) => <option value={v} selected={Astro.url.searchParams.get('test_type') === v}>{v.toUpperCase()}</option>)}</select>
        </label>
        <label class={FILTER_FIELD}>Result
          <select name="result" class="rounded-md border border-slate-300 px-3 py-2"><option value="">All results</option>{LAB_RESULT_OPTIONS.map((v) => <option value={v} selected={Astro.url.searchParams.get('result') === v}>{v}</option>)}</select>
        </label>
        <label class={FILTER_FIELD}>Status
          <select name="status" class="rounded-md border border-slate-300 px-3 py-2"><option value="">All statuses</option>{LAB_REPORT_STATUSES.map((v) => <option value={v} selected={Astro.url.searchParams.get('status') === v}>{v}</option>)}</select>
        </label>
        <label class={FILTER_FIELD}>Retest reason
          <select name="reason" class="rounded-md border border-slate-300 px-3 py-2"><option value="">All reasons</option>{LAB_RETEST_REASONS.map((v) => <option value={v} selected={Astro.url.searchParams.get('reason') === v}>{v}</option>)}</select>
        </label>
        <label class={FILTER_FIELD}>Product
          <select name="product" class="rounded-md border border-slate-300 px-3 py-2"><option value="">All products</option>{products.map((p) => <option value={p.id} selected={Astro.url.searchParams.get('product') === String(p.id)}>{p.name} ({p.code})</option>)}</select>
        </label>
        <label class={FILTER_FIELD}>Equipment
          <select name="equipment" class="rounded-md border border-slate-300 px-3 py-2"><option value="">All equipment</option>{equipment.map((e) => <option value={e.id} selected={Astro.url.searchParams.get('equipment') === String(e.id)}>{e.name} ({e.code})</option>)}</select>
        </label>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-3"><AppButton type="submit" variant="primary">Update filters</AppButton><span class="text-sm text-slate-600">Signed in as {user.fullName} ({user.role}).</span></div>
    </form>

    <!-- Preview + Download -->
    {preview?.allowed && (
      <section class="rounded-xl border border-slate-300 bg-white p-4 shadow-sm" aria-labelledby="lab-report-preview-heading">
        <h2 id="lab-report-preview-heading" class="text-lg font-semibold text-slate-900">Report preview</h2>
        <dl class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Report type</dt><dd class="mt-1 font-medium text-slate-900">{selected.label}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Resolved data scope</dt><dd class="mt-1 font-medium text-slate-900">Laboratory</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Date range</dt><dd class="mt-1 font-medium text-slate-900" dir="ltr">{preview.filters.from ?? 'Any'} → {preview.filters.to ?? 'Any'}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Filters</dt><dd class="mt-1 font-medium text-slate-900">{previewFilters.length ? previewFilters.join(' · ') : 'None'}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Matching rows</dt><dd class="mt-1 font-medium text-slate-900">{preview.matchingRowCount === null ? 'Not calculated for large result' : preview.matchingRowCount}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Generated as</dt><dd class="mt-1 font-medium text-slate-900">{user.fullName} · {user.role}</dd></div>
        </dl>
        <p class="mt-4 text-xs text-slate-600">This preview uses the same server authorization and scope resolution as the final download. Unauthorized counts are never shown.</p>
      </section>
    )}
    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm" aria-labelledby="lab-report-downloads-heading">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 id="lab-report-downloads-heading" class="text-lg font-semibold text-slate-900">Download report</h2>
          <p class="text-sm text-slate-600">{selected.description}</p>
        </div>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">Scope: Laboratory</span>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        {(['csv', 'xlsx', 'pdf'] as const).map((format) => <AppButton href={`/api/reports/${currentType}.${format}${query ? `?${query}` : ''}`} variant="secondary">Download {format.toUpperCase()}</AppButton>)}
      </div>
    </section>

    <!-- Catalog -->
    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm" aria-labelledby="lab-report-catalog-heading">
      <h2 id="lab-report-catalog-heading" class="text-lg font-semibold text-slate-900">Available reports</h2>
      <ul class="mt-3 grid gap-2 md:grid-cols-2">
        {labReports.map((report) => (
          <li>
            <a href={`/lab/reports?report_type=${report.key}${query ? `&${query}` : ''}`} class="block rounded-lg border border-slate-200 p-3 hover:border-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-500">
              <p class="text-sm font-medium text-slate-900">{report.label}</p>
              <p class="mt-0.5 text-xs text-slate-500">{report.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- Optional FAIL-rate trend view (?trend=week|month) -->
    <section id="fail-rate-trends" aria-labelledby="lab-trend-heading" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 id="lab-trend-heading" class="text-lg font-semibold text-slate-900">FAIL-rate trends</h2>
          <p class="text-sm text-slate-600">
            Lab-wide FAIL rate over time on decided, non-VOID tests —
            <a href="/lab/tests?result=FAIL" class="font-medium text-brand-600 hover:underline">open the FAILed tests in the register →</a>
          </p>
        </div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Trend granularity">
          <a
            href="/lab/reports?trend=week"
            class={`rounded-md px-3 py-1.5 text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 ${!showTrend || trendGranularity === 'week' ? 'bg-brand-600 text-white' : 'border border-slate-300 text-slate-700 hover:bg-slate-50'}`}
            aria-current={showTrend && trendGranularity === 'week' ? 'true' : undefined}
          >Weekly</a>
          <a
            href="/lab/reports?trend=month"
            class={`rounded-md px-3 py-1.5 text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 ${trendGranularity === 'month' && showTrend ? 'bg-brand-600 text-white' : 'border border-slate-300 text-slate-700 hover:bg-slate-50'}`}
            aria-current={showTrend && trendGranularity === 'month' ? 'true' : undefined}
          >Monthly</a>
        </div>
      </div>

      {showTrend && trendData && trendData.points.every((p) => p.total === 0) ? (
        <p class="mt-4 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-sm text-slate-500">
          No decided (non-VOID) test results in this window yet — rates appear once tests receive a final result.
        </p>
      ) : showTrend && trendData && (
        <>
          {trendData.comparison.direction !== 'insufficient' && trendData.comparison.deltaPercentagePoints !== null && (
            <p class="mt-4 text-sm" data-testid="trend-comparison">
              Lab-wide FAIL rate is <span class="font-semibold text-slate-900">{trendData.comparison.currentFailRate}%</span> in the current window
              vs {trendData.comparison.previousFailRate}% in the previous one —
              <span class={`ms-1 font-semibold ${trendData.comparison.direction === 'up' ? 'text-red-600' : trendData.comparison.direction === 'down' ? 'text-emerald-700' : 'text-slate-700'}`}>
                {trendData.comparison.direction === 'up' ? 'up' : trendData.comparison.direction === 'down' ? 'down' : 'unchanged'} by {Math.abs(trendData.comparison.deltaPercentagePoints)} percentage points.
              </span>
            </p>
          )}
          <div class="mt-2">
            <LabFailRateChart client:visible points={trendData.points} granularity={trendData.granularity} />
          </div>

          {trendByProduct.length > 0 && (
            <div class="mt-4">
              <h3 class="text-sm font-semibold text-slate-900">Highest FAIL rate by product</h3>
              <p class="mt-1 text-xs text-slate-500">Worst products first over the same window (decided, non-VOID tests).</p>
              <div class="mt-3 overflow-x-auto contain-layout contain-paint">
                <table class="min-w-[560px] divide-y divide-slate-100 text-sm">
                  <thead class="text-left text-xs uppercase tracking-wide text-slate-500">
                    <tr>
                      <th scope="col" class="px-3 py-2 font-semibold">Product</th>
                      <th scope="col" class="px-3 py-2 font-semibold">Decided</th>
                      <th scope="col" class="px-3 py-2 font-semibold">FAIL</th>
                      <th scope="col" class="px-3 py-2 font-semibold">FAIL rate</th>
                      <th scope="col" class="px-3 py-2 font-semibold">Register</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    {trendByProduct.map((row) => (
                      <tr data-lab-trend-product={row.productId}>
                        <td class="px-3 py-2 font-medium text-slate-900">{row.name} <span class="font-normal text-slate-500" dir="ltr">({row.code})</span></td>
                        <td class="px-3 py-2 text-slate-700">{row.total}</td>
                        <td class="px-3 py-2 text-slate-700">{row.fail}</td>
                        <td class={`px-3 py-2 font-semibold ${row.failRate !== null && row.failRate >= 50 ? 'text-red-600' : 'text-slate-700'}`}>
                          {row.failRate === null ? '—' : `${row.failRate}%`}
                        </td>
                        <td class="px-3 py-2">
                          <a href={labTrendDrilldown(row.productId, undefined, 'FAIL')} class="font-medium text-brand-600 hover:underline">View FAILed tests →</a>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </>
      )}
      {!showTrend && <p class="mt-3 text-sm text-slate-500">Select Weekly or Monthly above to visualize the lab-wide FAIL-rate trend.</p>}
    </section>

    <section id="audit" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><h2 class="text-lg font-semibold text-slate-900">Audit Trail</h2><p class="mt-1 text-sm text-slate-600">Every laboratory report generation records Report ID, Generated By, Filters, Timestamp, Format, and Data Scope.</p><a href="/api/reports/audit" class="mt-3 inline-block text-sm font-medium text-brand-700 hover:underline">View report audit JSON</a></section>
  </div>
</BaseLayout>
