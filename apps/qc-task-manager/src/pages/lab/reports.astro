---
// /lab/reports — QC Laboratory Reports (QC-LAB-ARCHITECTURE.md §13).
//
// 15 laboratory reports rendered through the SAME reporting pipeline as the
// task reports (api/reports/[reportType].[format] with the csv/xlsx/pdf
// writers) — this page is only the catalog + filter form. RBAC is enforced
// twice: here (canViewLabReports) and again in authorizeReport, which denies
// the employee role for every lab report type. Every generation is recorded
// in report_audit_log.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../components/lab/LabSecondaryNav.astro';
import { setFlash } from '../../lib/flash';
import { labNavForRole } from '../../lib/lab/navigation';
import { canViewLabReports } from '../../lib/permissions';
import { REPORT_CATALOG } from '../../lib/reporting/catalog';
import { LAB_REPORT_TYPES } from '../../lib/reporting/types';
import { LAB_RESULT_OPTIONS, LAB_RETEST_REASONS } from '../../lib/lab/policy';
import { LAB_REPORT_STATUSES, listLabProductsForReports, listLabEquipmentForReports } from '../../lib/lab/labReports';
import type { Role } from '../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;

// Page-level guard: the /lab prefix wall only checks LAB_VIEW (all lab roles);
// reports are supervisor+. Everyone else is bounced to /lab.
if (!canViewLabReports(role)) {
  setFlash(Astro, 'error', 'You do not have permission to access laboratory reports.');
  return Astro.redirect('/lab');
}

const navItems = labNavForRole(role);

// Only the laboratory report types are shown on this page (task reports live
// on /reports). Order follows the §13 report list.
const labReports = LAB_REPORT_TYPES.map((key) => REPORT_CATALOG[key]).filter(Boolean);

const requestedType = Astro.url.searchParams.get('report_type');
const selected = labReports.find((r) => r.key === requestedType) ?? labReports[0];
const currentType = selected.key;

// Carry forward filter params into the download links (server re-validates).
const filters = new URLSearchParams(Astro.url.searchParams);
filters.delete('report_type');
filters.delete('format');
const query = filters.toString();

const products = listLabProductsForReports();
const equipment = listLabEquipmentForReports();
---

<BaseLayout title="Laboratory Reports">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Reports' },
      ]}
    />

    <header>
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Operations</p>
      <h1 class="mt-1 text-3xl font-semibold text-slate-900">Laboratory Reports</h1>
      <p class="mt-1 max-w-3xl text-sm text-slate-600">
        Generate the 15 laboratory reports (registers, results, calibration, documents, activity, data quality) as
        CSV, Excel, or PDF. Exports respect the selected filters and your data scope, and every generation is
        recorded in the report audit log. Report content is metadata only — document bodies and test snapshots are
        never exported.
      </p>
    </header>

    <LabSecondaryNav items={navItems} currentPath="/lab/reports" />

    <!-- Filter form -->
    <form method="get" action="/lab/reports" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Report type
          <select name="report_type" class="rounded-md border border-slate-300 px-3 py-2">
            {labReports.map((report) => <option value={report.key} selected={currentType === report.key}>{report.label}</option>)}
          </select>
        </label>
        <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">From date<input type="date" name="from" value={Astro.url.searchParams.get('from') ?? ''} class="rounded-md border border-slate-300 px-3 py-2" /></label>
        <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">To date<input type="date" name="to" value={Astro.url.searchParams.get('to') ?? ''} class="rounded-md border border-slate-300 px-3 py-2" /></label>
        <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Test type
          <select name="test_type" class="rounded-md border border-slate-300 px-3 py-2"><option value="">All types</option>{['air', 'vacuum'].map((v) => <option value={v} selected={Astro.url.searchParams.get('test_type') === v}>{v.toUpperCase()}</option>)}</select>
        </label>
        <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Result
          <select name="result" class="rounded-md border border-slate-300 px-3 py-2"><option value="">All results</option>{LAB_RESULT_OPTIONS.map((v) => <option value={v} selected={Astro.url.searchParams.get('result') === v}>{v}</option>)}</select>
        </label>
        <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Status
          <select name="status" class="rounded-md border border-slate-300 px-3 py-2"><option value="">All statuses</option>{LAB_REPORT_STATUSES.map((v) => <option value={v} selected={Astro.url.searchParams.get('status') === v}>{v}</option>)}</select>
        </label>
        <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Retest reason
          <select name="reason" class="rounded-md border border-slate-300 px-3 py-2"><option value="">All reasons</option>{LAB_RETEST_REASONS.map((v) => <option value={v} selected={Astro.url.searchParams.get('reason') === v}>{v}</option>)}</select>
        </label>
        <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Product
          <select name="product" class="rounded-md border border-slate-300 px-3 py-2"><option value="">All products</option>{products.map((p) => <option value={p.id} selected={Astro.url.searchParams.get('product') === String(p.id)}>{p.name} ({p.code})</option>)}</select>
        </label>
        <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">Equipment
          <select name="equipment" class="rounded-md border border-slate-300 px-3 py-2"><option value="">All equipment</option>{equipment.map((e) => <option value={e.id} selected={Astro.url.searchParams.get('equipment') === String(e.id)}>{e.name} ({e.code})</option>)}</select>
        </label>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-3"><button type="submit" class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">Update filters</button><span class="text-sm text-slate-600">Signed in as {user.fullName} ({user.role}).</span></div>
    </form>

    <!-- Download -->
    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm" aria-labelledby="lab-report-downloads-heading">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 id="lab-report-downloads-heading" class="text-lg font-semibold text-slate-900">Download report</h2>
          <p class="text-sm text-slate-600">{selected.description}</p>
        </div>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">Scope: Laboratory</span>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        {(['csv', 'xlsx', 'pdf'] as const).map((format) => <a href={`/api/reports/${currentType}.${format}${query ? `?${query}` : ''}`} class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-brand-500">Download {format.toUpperCase()}</a>)}
      </div>
    </section>

    <!-- Catalog -->
    <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm" aria-labelledby="lab-report-catalog-heading">
      <h2 id="lab-report-catalog-heading" class="text-lg font-semibold text-slate-900">Available reports</h2>
      <ul class="mt-3 grid gap-2 md:grid-cols-2">
        {labReports.map((report) => (
          <li>
            <a href={`/lab/reports?report_type=${report.key}${query ? `&${query}` : ''}`} class="block rounded-lg border border-slate-200 p-3 hover:border-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-500">
              <p class="text-sm font-medium text-slate-900">{report.label}</p>
              <p class="mt-0.5 text-xs text-slate-500">{report.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="audit" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><h2 class="text-lg font-semibold text-slate-900">Audit Trail</h2><p class="mt-1 text-sm text-slate-600">Every laboratory report generation records Report ID, Generated By, Filters, Timestamp, Format, and Data Scope.</p><a href="/api/reports/audit" class="mt-3 inline-block text-sm font-medium text-brand-700 hover:underline">View report audit JSON</a></section>
  </div>
</BaseLayout>
