---
// /lab/templates/new — create a test template (PROMPT 10).
// Manager+ only (canCreateLabTemplate); the shared form component posts to
// this same URL and the middleware short-circuits the POST. Version 1 is
// created as a DRAFT with the printed reference defaults prefilled.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import LabTemplateForm from '../../../components/lab/LabTemplateForm.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import {
  listLabDocumentsForTemplateForm,
  listLabEquipmentForTemplateForm,
  listLabProductsForTemplateForm,
  parseTemplateParameters,
} from '../../../lib/lab/templates';
import { LAB_CONNECTOR_TYPES } from '../../../lib/lab/policy';
import { canCreateLabTemplate } from '../../../lib/permissions';
import type { Role } from '../../../lib/types';
import { setFlash } from '../../../lib/flash';
import Banner from '../../../components/ui/Banner.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';

const user = Astro.locals.user!;
const role = user.role as Role;

if (!canCreateLabTemplate(role)) {
  setFlash(Astro, 'error', 'You do not have permission to create test templates.');
  return Astro.redirect('/lab/templates');
}

const navItems = labNavForRole(role);

// No scientific values are invented here; managers enter approved template references.
const defaultParameters = parseTemplateParameters('{}');

let loadError: string | null = null;
let equipment: ReturnType<typeof listLabEquipmentForTemplateForm> = [];
let products: ReturnType<typeof listLabProductsForTemplateForm> = [];
let sops: ReturnType<typeof listLabDocumentsForTemplateForm> = [];
let wis: ReturnType<typeof listLabDocumentsForTemplateForm> = [];
try {
  equipment = listLabEquipmentForTemplateForm();
  products = listLabProductsForTemplateForm();
  sops = listLabDocumentsForTemplateForm('SOP');
  wis = listLabDocumentsForTemplateForm('WI');
} catch (err) {
  console.error('[lab] template form load failure', err);
  loadError = 'Could not load the reference lists. Try reloading — if the problem persists, contact an administrator.';
}
---

<BaseLayout title="New Test Template">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Test Templates', href: '/lab/templates' },
        { label: 'New Template' },
      ]}
    />

    <PageHeader eyebrow="QC Laboratory — Master Data" title="New Test Template" description="Create a versioned AIR/VACUUM template with reference parameters and test-form defaults. Version 1 starts as a draft; approving it makes it the current version, and later edits create version 2 — approved versions are immutable." />

    <LabSecondaryNav items={navItems} currentPath="/lab/templates/new" />

    {loadError && (
      <Banner tone="error">{loadError}</Banner>
    )}

    {!loadError && (
      <LabTemplateForm
        mode="create"
        parameters={defaultParameters}
        products={products}
        sops={sops}
        wis={wis}
        equipmentOptions={equipment}
        connectorTypes={[...LAB_CONNECTOR_TYPES]}
        selectedConnectorChoices={[...LAB_CONNECTOR_TYPES]}
      />
    )}
  </div>
</BaseLayout>
