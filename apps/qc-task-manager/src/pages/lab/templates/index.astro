---
// /lab/templates — QC Laboratory Test Templates (PROMPT 10).
//
// Central register of versioned AIR/VACUUM test templates. Server-side
// search, safe sorting and pagination live in src/lib/lab/templates.ts (same
// shape as the Product Master): the URL is the source of truth, every SQL
// value is a bound parameter, and sorting is a whitelisted union. Employees
// may view; only manager+ get the New / Edit affordances.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import {
  hasLabTemplateFilters,
  labTemplateFiltersToQuery,
  parseLabTemplateSearchFilters,
  searchLabTemplates,
  LAB_TEMPLATE_PER_PAGE_OPTIONS,
  type LabTemplateSearchFilters,
  type LabTemplateSortField,
} from '../../../lib/lab/templates';
import { canCreateLabTemplate, canEditLabTemplate } from '../../../lib/permissions';
import type { Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;

const navItems = labNavForRole(role);
const filters: LabTemplateSearchFilters = parseLabTemplateSearchFilters(Astro.url);

let dataError: string | null = null;
let result: ReturnType<typeof searchLabTemplates> = { rows: [], total: 0, page: 1, per_page: 25, total_pages: 1 };
try {
  result = searchLabTemplates(filters);
} catch (err) {
  console.error('[lab] test template query failure', err);
  dataError = 'Could not load the Test Templates. Try reloading — if the problem persists, contact an administrator.';
}

const filtered = hasLabTemplateFilters(filters);

const qsParams = new URLSearchParams(labTemplateFiltersToQuery({ ...filters, page: 1 }).replace(/^\?/, ''));

function pageHref(p: number): string {
  const sp = new URLSearchParams(qsParams);
  if (p > 1) sp.set('page', String(p));
  else sp.delete('page');
  const qs = sp.toString();
  return qs ? `/lab/templates?${qs}` : '/lab/templates';
}

function sortHref(field: LabTemplateSortField): string {
  const next: LabTemplateSearchFilters = {
    ...filters,
    sort: field,
    dir: (filters.sort === field && filters.dir === 'asc' ? 'desc' : 'asc') as 'asc' | 'desc',
    page: 1,
  };
  return `/lab/templates${labTemplateFiltersToQuery(next)}`;
}

function sortArrow(field: LabTemplateSortField): string {
  if (filters.sort !== field) return '';
  return filters.dir === 'asc' ? ' ▲' : ' ▼';
}

const SORTABLE: { field: LabTemplateSortField; label: string }[] = [
  { field: 'code', label: 'Code' },
  { field: 'name', label: 'Template Name' },
  { field: 'test_type', label: 'Test Type' },
  { field: 'status', label: 'Status' },
  { field: 'updated_at', label: 'Updated' },
];

function th(field: LabTemplateSortField, label: string): string {
  return `<a href="${sortHref(field)}" class="inline-flex items-center gap-1 hover:text-slate-900">${label}${sortArrow(field)}</a>`;
}

const STATUS_STYLES: Record<string, string> = {
  DRAFT: 'bg-amber-100 text-amber-800',
  ACTIVE: 'bg-emerald-100 text-emerald-800',
  ARCHIVED: 'bg-slate-200 text-slate-500',
};

const pageNumbers: number[] = [];
{
  const total = result.total_pages;
  const cur = result.page;
  let start = Math.max(1, cur - 3);
  let end = Math.min(total, cur + 3);
  if (end - start < 6) {
    if (start === 1) end = Math.min(total, start + 6);
    else start = Math.max(1, end - 6);
  }
  for (let p = start; p <= end; p++) pageNumbers.push(p);
}
---

<BaseLayout title="Test Templates">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Test Templates' },
      ]}
    />

    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Master Data</p>
        <h1 class="mt-1 text-3xl font-semibold text-slate-900">Test Templates</h1>
        <p class="mt-1 max-w-3xl text-sm text-slate-600">
          Versioned AIR/VACUUM templates with reference parameters and defaults. Tests store the exact template version
          they were created from — later versions never rewrite existing tests.
        </p>
      </div>
      {canCreateLabTemplate(role) && (
        <a
          href="/lab/templates/new"
          class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
        >
          New Template
        </a>
      )}
    </header>

    <LabSecondaryNav items={navItems} currentPath="/lab/templates" />

    {dataError && (
      <div role="alert" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {dataError}
      </div>
    )}

    {!dataError && (
      <>
        <form method="get" action="/lab/templates" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
          <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Search
              <input
                type="search"
                name="q"
                value={filters.q ?? ''}
                placeholder="Code, name…"
                class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
              />
            </label>
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Test Type
              <select name="type" class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="">All types</option>
                <option value="air" selected={filters.test_type === 'air'}>AIR</option>
                <option value="vacuum" selected={filters.test_type === 'vacuum'}>VACUUM</option>
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Status
              <select name="status" class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="">All statuses</option>
                <option value="DRAFT" selected={filters.status === 'DRAFT'}>Draft</option>
                <option value="ACTIVE" selected={filters.status === 'ACTIVE'}>Active</option>
                <option value="ARCHIVED" selected={filters.status === 'ARCHIVED'}>Archived</option>
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Per page
              <select name="per" class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                {LAB_TEMPLATE_PER_PAGE_OPTIONS.map((n) => (
                  <option value={n} selected={filters.per_page === n}>{n} per page</option>
                ))}
              </select>
            </label>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">Apply filters</button>
            <a href="/lab/templates" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">Reset</a>
          </div>
        </form>

        <p class="text-sm text-slate-600">
          {result.total.toLocaleString('en-US')} template{result.total === 1 ? '' : 's'} found
          {filtered && <span> (filtered — <a href="/lab/templates" class="text-brand-600 hover:underline">clear all</a>)</span>}
        </p>

        {result.rows.length === 0 ? (
          <EmptyState
            title={filtered ? 'No templates match your search' : 'No test templates registered yet'}
            hint={filtered ? 'Try adjusting the search or clearing the filters.' : 'Templates created here prefill the test form with reference parameters and defaults.'}
            ctaHref={filtered ? '/lab/templates' : canCreateLabTemplate(role) ? '/lab/templates/new' : '/lab'}
            ctaLabel={filtered ? 'Clear filters' : 'New Template'}
          />
        ) : (
          <section aria-label="Test Templates" class="rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto contain-layout contain-paint">
              <table class="min-w-[900px] divide-y divide-slate-100 text-sm">
                <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    {SORTABLE.map((s) => (
                      <th scope="col" class="px-4 py-2.5 font-semibold" set:html={th(s.field, s.label)} />
                    ))}
                    <th scope="col" class="px-4 py-2.5 font-semibold">Current Version</th>
                    <th scope="col" class="px-4 py-2.5 font-semibold">Default Samples</th>
                    <th scope="col" class="px-4 py-2.5 font-semibold">Tests</th>
                    <th scope="col" class="px-4 py-2.5 font-semibold"><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {result.rows.map((t) => (
                    <tr class="align-middle">
                      <td class="px-4 py-2 font-medium text-slate-900" dir="ltr">{t.code}</td>
                      <td class="px-4 py-2 text-slate-700">{t.name}</td>
                      <td class="px-4 py-2 uppercase text-slate-600">{t.test_type}</td>
                      <td class="px-4 py-2">
                        <span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${STATUS_STYLES[t.status] ?? 'bg-slate-100 text-slate-600'}`}>
                          {t.status === 'DRAFT' ? 'Draft' : t.status === 'ACTIVE' ? 'Active' : 'Archived'}
                        </span>
                      </td>
                      <td class="px-4 py-2 text-slate-500">{t.updated_at}</td>
                      <td class="px-4 py-2 text-slate-700" dir="ltr">{t.current_version ? `v${t.current_version}` : '—'}</td>
                      <td class="px-4 py-2 text-slate-700">{t.default_sample_count ?? '—'}</td>
                      <td class="px-4 py-2 text-slate-700">
                        {t.test_count > 0 ? (
                          <a href={`/lab/tests?template=${t.id}`} class="text-brand-600 hover:underline">{t.test_count.toLocaleString('en-US')}</a>
                        ) : (
                          '0'
                        )}
                      </td>
                      <td class="px-4 py-2">
                        <span class="flex items-center gap-2">
                          <a href={`/lab/templates/${t.id}`} class="font-medium text-brand-600 hover:underline">View</a>
                          {canEditLabTemplate(role) && t.status !== 'ARCHIVED' && (
                            <a href={`/lab/templates/${t.id}/edit`} class="font-medium text-slate-600 hover:underline">Edit</a>
                          )}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {result.total_pages > 1 && (
          <nav aria-label="Pagination" class="flex flex-wrap items-center justify-center gap-2">
            {result.page > 1 ? (
              <a href={pageHref(result.page - 1)} class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">← Prev</a>
            ) : (
              <span class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-400">← Prev</span>
            )}
            {pageNumbers.map((p) => (
              <a
                href={pageHref(p)}
                aria-current={p === result.page ? 'page' : undefined}
                class={`rounded-md px-3 py-1.5 text-sm font-medium ${
                  p === result.page ? 'bg-brand-600 text-white' : 'border border-slate-300 bg-white text-slate-700 hover:bg-slate-50'
                }`}
              >
                {p}
              </a>
            ))}
            {result.page < result.total_pages ? (
              <a href={pageHref(result.page + 1)} class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Next →</a>
            ) : (
              <span class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-400">Next →</span>
            )}
          </nav>
        )}
      </>
    )}
  </div>
</BaseLayout>
