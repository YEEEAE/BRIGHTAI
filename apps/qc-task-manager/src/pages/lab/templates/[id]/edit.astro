---
// /lab/templates/[id]/edit — edit a test template (PROMPT 10).
//
// Manager+ only (canEditLabTemplate). The form edits the NEWEST version: a
// draft updates in place, while editing after an approval creates the next
// draft version (the versioning rule lives in updateLabTemplate). Archived
// templates bounce back to the details with a read-only flash.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import EmptyState from '../../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../../components/lab/LabSecondaryNav.astro';
import LabTemplateForm from '../../../../components/lab/LabTemplateForm.astro';
import { labNavForRole } from '../../../../lib/lab/navigation';
import {
  getLabTemplateForEdit,
  listLabDocumentsForTemplateForm,
  listLabEquipmentForTemplateForm,
  listLabProductsForTemplateForm,
  parseTemplateParameters,
} from '../../../../lib/lab/templates';
import { LAB_CONNECTOR_TYPES } from '../../../../lib/lab/policy';
import { canEditLabTemplate } from '../../../../lib/permissions';
import type { Role } from '../../../../lib/types';
import { setFlash } from '../../../../lib/flash';

const user = Astro.locals.user!;
const role = user.role as Role;

if (!canEditLabTemplate(role)) {
  setFlash(Astro, 'error', 'You do not have permission to edit test templates.');
  return Astro.redirect('/lab/templates');
}

const id = Number(Astro.params.id);
let editView: ReturnType<typeof getLabTemplateForEdit> = null;
let loadError: string | null = null;
try {
  editView = getLabTemplateForEdit(id);
} catch (err) {
  console.error('[lab] template edit load failure', err);
  loadError = 'Could not load the test template. Try reloading — if the problem persists, contact an administrator.';
}

if (!loadError && !editView) {
  setFlash(Astro, 'error', 'Test template not found.');
  return Astro.redirect('/lab/templates');
}

// Archived templates are read-only historical records.
if (editView && editView.template.status === 'ARCHIVED') {
  setFlash(Astro, 'error', 'Archived test templates are read-only.');
  return Astro.redirect(`/lab/templates/${id}`);
}

const navItems = labNavForRole(role);

let equipment: ReturnType<typeof listLabEquipmentForTemplateForm> = [];
let products: ReturnType<typeof listLabProductsForTemplateForm> = [];
let sops: ReturnType<typeof listLabDocumentsForTemplateForm> = [];
let wis: ReturnType<typeof listLabDocumentsForTemplateForm> = [];
try {
  equipment = listLabEquipmentForTemplateForm();
  products = listLabProductsForTemplateForm();
  sops = listLabDocumentsForTemplateForm('SOP');
  wis = listLabDocumentsForTemplateForm('WI');
} catch (err) {
  console.error('[lab] template form load failure', err);
  loadError = 'Could not load the reference lists. Try reloading — if the problem persists, contact an administrator.';
}

const parameters = editView ? parseTemplateParameters(editView.version.parameters_json) : null;

let selectedConnectorChoices: string[] = [];
if (editView?.version.connector_choices_json) {
  try {
    const parsed = JSON.parse(editView.version.connector_choices_json) as unknown;
    if (Array.isArray(parsed)) selectedConnectorChoices = parsed.filter((c): c is string => typeof c === 'string');
  } catch {
    selectedConnectorChoices = [];
  }
}

const versionNote =
  editView && editView.version.approved_by !== null
    ? `The current version v${editView.version.version} is approved and immutable — saving creates draft version v${editView.version.version + 1}.`
    : editView
      ? `Editing draft version v${editView.version.version} in place.`
      : '';
---

<BaseLayout title={editView ? `Edit ${editView.template.code}` : 'Edit test template'}>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Test Templates', href: '/lab/templates' },
        ...(editView ? [{ label: editView.template.code, href: `/lab/templates/${editView.template.id}` }] : []),
        { label: 'Edit' },
      ]}
    />

    <header>
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Master Data</p>
      <h1 class="mt-1 text-3xl font-semibold text-slate-900">Edit Test Template</h1>
      {versionNote && <p class="mt-1 max-w-3xl text-sm font-medium text-amber-700">{versionNote}</p>}
    </header>

    <LabSecondaryNav items={navItems} currentPath="/lab/templates" />

    {loadError && (
      <div role="alert" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {loadError}
      </div>
    )}

    {!loadError && !editView && (
      <EmptyState
        title="Test template not found"
        hint="This template does not exist — it may have been removed, or the link is stale."
        ctaHref="/lab/templates"
        ctaLabel="Back to the Test Templates"
      />
    )}

    {!loadError && editView && (
      <LabTemplateForm
        mode="edit"
        template={editView.template}
        version={editView.version}
        parameters={parameters}
        selectedEquipmentIds={editView.equipmentIds}
        selectedConnectorChoices={selectedConnectorChoices}
        products={products}
        sops={sops}
        wis={wis}
        equipmentOptions={equipment}
        connectorTypes={[...LAB_CONNECTOR_TYPES]}
      />
    )}
  </div>
</BaseLayout>
