---
// /lab/templates/[id] — Test Template details (PROMPT 10).
//
// Read-only view: identity, current version content, the FULL version
// history (who created/approved each version and how many tests used it),
// equipment compatibility, test usage, and the change history from the
// shared audit log (entity_type='LAB_TEMPLATE'). Approve/Archive are native
// POST forms to /lab/templates/[id]/edit with a hidden form_action — the
// handler re-checks the per-action permission + CSRF. Archived templates are
// read-only historical records.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import {
  getLabTemplateAuditTimeline,
  getLabTemplateDetail,
  parseTemplateParameters,
} from '../../../lib/lab/templates';
import { canApproveLabTemplate, canArchiveLabTemplate, canEditLabTemplate } from '../../../lib/permissions';
import type { Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;

const id = Number(Astro.params.id);
let detail: ReturnType<typeof getLabTemplateDetail> = null;
try {
  detail = getLabTemplateDetail(id);
} catch (err) {
  console.error('[lab] template detail query failure', err);
}

const navItems = labNavForRole(role);

const fieldCls = 'rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700';
const labelCls = 'text-xs font-semibold uppercase tracking-wide text-slate-500';

function fmt(value: unknown): string {
  return value == null || String(value).trim() === '' ? '—' : String(value);
}

const STATUS_STYLES: Record<string, string> = {
  DRAFT: 'bg-amber-100 text-amber-800',
  ACTIVE: 'bg-emerald-100 text-emerald-800',
  ARCHIVED: 'bg-slate-200 text-slate-500',
};

const latestVersion = detail?.versions[detail.versions.length - 1] ?? null;
const latestIsDraft = latestVersion !== null && latestVersion.approved_by === null;
const editUrl = `/lab/templates/${id ?? 0}/edit`;

let currentParams: ReturnType<typeof parseTemplateParameters> | null = null;
if (detail?.currentVersion) {
  currentParams = parseTemplateParameters(detail.currentVersion.parameters_json);
}

let connectorChoices: string[] = [];
if (latestVersion?.connector_choices_json) {
  try {
    const parsed = JSON.parse(latestVersion.connector_choices_json) as unknown;
    if (Array.isArray(parsed)) connectorChoices = parsed.filter((c): c is string => typeof c === 'string');
  } catch {
    connectorChoices = [];
  }
}
---

<BaseLayout title={detail ? `Test Template ${detail.template.code}` : 'Test template not found'}>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Test Templates', href: '/lab/templates' },
        ...(detail ? [{ label: detail.template.code }] : []),
      ]}
    />

    {!detail ? (
      <EmptyState
        title="Test template not found"
        hint="This template does not exist — it may have been removed, or the link is stale."
        ctaHref="/lab/templates"
        ctaLabel="Back to the Test Templates"
      />
    ) : (
      <>
        <header class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Master Data</p>
            <h1 class="mt-1 text-3xl font-semibold text-slate-900">{detail.template.name}</h1>
            <p class="mt-1 text-sm text-slate-600">
              Code <span class="font-medium text-slate-900" dir="ltr">{detail.template.code}</span>
              <span class="ms-2 uppercase text-slate-500">{detail.template.test_type}</span>
              <span class={`ms-3 inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${STATUS_STYLES[detail.template.status] ?? 'bg-slate-100 text-slate-600'}`}>
                {detail.template.status === 'DRAFT' ? 'Draft' : detail.template.status === 'ACTIVE' ? 'Active' : 'Archived'}
              </span>
              {detail.currentVersion && (
                <span class="ms-3 text-slate-500" dir="ltr">current: v{detail.currentVersion.version}</span>
              )}
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            {canEditLabTemplate(role) && detail.template.status !== 'ARCHIVED' && (
              <a
                href={editUrl}
                class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
              >
                Edit Template
              </a>
            )}
            {canApproveLabTemplate(role) && detail.template.status !== 'ARCHIVED' && latestIsDraft && (
              <form method="POST" action={editUrl}>
                <input type="hidden" name="form_action" value="approve" />
                <button
                  type="submit"
                  class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
                >
                  Approve v{latestVersion!.version}
                </button>
              </form>
            )}
            {canArchiveLabTemplate(role) && detail.template.status !== 'ARCHIVED' && (
              <form method="POST" action={editUrl}>
                <input type="hidden" name="form_action" value="archive" />
                <button
                  type="submit"
                  class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
                >
                  Archive
                </button>
              </form>
            )}
            {detail.template.status === 'ARCHIVED' && (
              <p class="text-sm text-slate-500">Archived templates are read-only historical records.</p>
            )}
          </div>
        </header>

        <LabSecondaryNav items={navItems} currentPath={`/lab/templates/${detail.template.id}`} />

        <section aria-labelledby="sec-fields" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 id="sec-fields" class="text-base font-semibold text-slate-900">
            Current Version{detail.currentVersion ? ` — v${detail.currentVersion.version}` : ''}
          </h2>
          <dl class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            <div class={fieldCls}>
              <dt class={labelCls}>Template Name</dt>
              <dd class="mt-1 font-medium text-slate-900">{detail.template.name}</dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Template Code</dt>
              <dd class="mt-1 font-medium text-slate-900" dir="ltr">{detail.template.code}</dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Test Type</dt>
              <dd class="mt-1 uppercase text-slate-900">{detail.template.test_type}</dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Default Sample Count</dt>
              <dd class="mt-1 text-slate-900">{fmt(detail.currentVersion?.default_sample_count)}</dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Applicable Product</dt>
              <dd class="mt-1 text-slate-900">
                {detail.product_name ? `${detail.product_name} (${detail.product_code})` : '—'}
              </dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Primary Equipment</dt>
              <dd class="mt-1 text-slate-900">
                {detail.primary_equipment_name ? `${detail.primary_equipment_name} (${detail.primary_equipment_code})` : '—'}
              </dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Applicable SOP</dt>
              <dd class="mt-1 text-slate-900">{detail.sop_title ? `${detail.sop_code} — ${detail.sop_title}` : '—'}</dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Applicable WI</dt>
              <dd class="mt-1 text-slate-900">{detail.wi_title ? `${detail.wi_code} — ${detail.wi_title}` : '—'}</dd>
            </div>
            <div class={fieldCls}>
              <dt class={labelCls}>Connector Options</dt>
              <dd class="mt-1 text-slate-900">
                {connectorChoices.length === 0 ? '—' : (
                  <ul class="list-disc space-y-0.5 ps-4">
                    {connectorChoices.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                )}
              </dd>
            </div>
          </dl>
          {currentParams && (
            <div class="mt-4 rounded-lg border border-blue-100 bg-blue-50 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-blue-700">Reference Parameters (display only)</p>
              <dl class="mt-2 grid gap-2 text-sm text-slate-700 sm:grid-cols-2 lg:grid-cols-4">
                <div>
                  <dt class="text-xs text-slate-500">Standard Parameter</dt>
                  <dd dir="ltr">{currentParams.standard_parameter}</dd>
                </div>
                <div>
                  <dt class="text-xs text-slate-500">Acceptance Criteria</dt>
                  <dd dir="ltr">{currentParams.acceptance_criteria}</dd>
                </div>
                <div>
                  <dt class="text-xs text-slate-500">Holding Time</dt>
                  <dd dir="ltr">{currentParams.holding_time}</dd>
                </div>
                <div>
                  <dt class="text-xs text-slate-500">Actual Pressure Reference</dt>
                  <dd dir="ltr">{currentParams.actual_pressure_reference}</dd>
                </div>
              </dl>
              <p class="mt-2 text-xs text-blue-700">Never validated against measurements — snapshotted onto approved tests.</p>
            </div>
          )}
        </section>

        <section aria-labelledby="sec-versions" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 id="sec-versions" class="text-base font-semibold text-slate-900">Version History</h2>
          <p class="mt-1 text-xs text-slate-500">
            Approved versions are immutable. Editing after an approval creates the next draft version — tests always keep the version they were created from.
          </p>
          <div class="mt-3 overflow-x-auto contain-layout contain-paint">
            <table class="min-w-[820px] divide-y divide-slate-100 text-sm">
              <thead class="text-left text-xs uppercase tracking-wide text-slate-500">
                <tr>
                  <th scope="col" class="px-3 py-2 font-semibold">Version</th>
                  <th scope="col" class="px-3 py-2 font-semibold">Status</th>
                  <th scope="col" class="px-3 py-2 font-semibold">Created By</th>
                  <th scope="col" class="px-3 py-2 font-semibold">Created</th>
                  <th scope="col" class="px-3 py-2 font-semibold">Approved By</th>
                  <th scope="col" class="px-3 py-2 font-semibold">Default Samples</th>
                  <th scope="col" class="px-3 py-2 font-semibold">Tests</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {[...detail.versions].reverse().map((v) => (
                  <tr>
                    <td class="px-3 py-2 font-medium text-slate-900" dir="ltr">v{v.version}</td>
                    <td class="px-3 py-2">
                      <span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${v.approved_by !== null ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}`}>
                        {v.approved_by !== null ? 'Approved' : 'Draft'}
                      </span>
                      {detail.template.current_version_id === v.id && (
                        <span class="ms-2 text-xs font-medium text-slate-500">current</span>
                      )}
                    </td>
                    <td class="px-3 py-2 text-slate-700">{v.created_by_name ?? '—'}</td>
                    <td class="px-3 py-2 text-slate-500">{v.created_at}</td>
                    <td class="px-3 py-2 text-slate-700">{v.approved_by_name ?? '—'}</td>
                    <td class="px-3 py-2 text-slate-700">{v.default_sample_count ?? '—'}</td>
                    <td class="px-3 py-2 text-slate-700">{v.test_count.toLocaleString('en-US')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section aria-labelledby="sec-equipment" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 id="sec-equipment" class="text-base font-semibold text-slate-900">Equipment Compatibility</h2>
          {detail.equipment.length === 0 ? (
            <p class="mt-2 text-sm text-slate-600">No equipment linked to this template.</p>
          ) : (
            <ul class="mt-3 flex flex-wrap gap-2">
              {detail.equipment.map((e) => (
                <li class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">
                  <span class="font-medium">{e.name}</span>
                  <span class="ms-2 text-slate-500" dir="ltr">({e.code})</span>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section aria-labelledby="sec-usage" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 id="sec-usage" class="text-base font-semibold text-slate-900">Test Usage</h2>
          <p class="mt-2 text-sm text-slate-600">
            {detail.test_count.toLocaleString('en-US')} test{detail.test_count === 1 ? '' : 's'} reference this template by ID and version.
            {detail.test_count > 0 && (
              <a href={`/lab/tests?template=${detail.template.id}`} class="ms-1 font-medium text-brand-600 hover:underline">
                View in the test register →
              </a>
            )}
            {' '}Approved tests keep their own template snapshot — later versions never rewrite them.
          </p>
        </section>

        <section aria-labelledby="sec-history" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 id="sec-history" class="text-base font-semibold text-slate-900">Change History</h2>
          {(() => {
            const timeline = getLabTemplateAuditTimeline(detail.template.id);
            return timeline.length === 0 ? (
              <p class="mt-2 text-sm text-slate-600">No recorded changes yet.</p>
            ) : (
              <div class="mt-3 overflow-x-auto contain-layout contain-paint">
                <table class="min-w-[640px] divide-y divide-slate-100 text-sm">
                  <thead class="text-left text-xs uppercase tracking-wide text-slate-500">
                    <tr>
                      <th scope="col" class="px-3 py-2 font-semibold">When</th>
                      <th scope="col" class="px-3 py-2 font-semibold">Actor</th>
                      <th scope="col" class="px-3 py-2 font-semibold">Action</th>
                      <th scope="col" class="px-3 py-2 font-semibold">Detail</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    {timeline.map((entry) => (
                      <tr>
                        <td class="px-3 py-2 text-slate-500">{String(entry.created_at)}</td>
                        <td class="px-3 py-2 text-slate-700">{String(entry.actor_name ?? '—')}</td>
                        <td class="px-3 py-2 font-medium text-slate-900">{String(entry.action)}</td>
                        <td class="px-3 py-2 text-slate-600" dir="ltr">{String(entry.note ?? '—')}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            );
          })()}
        </section>
      </>
    )}
  </div>
</BaseLayout>
