---
// /lab/acknowledgements — QC Laboratory controlled-document acknowledgement
// register (contract §5.2 LAB_DOCUMENT_ACKNOWLEDGE use case).
//
// Server-rendered register over lab_document_acknowledgements (migration 013):
// one row per (document_version, user) with the six tracked fields — document
// (code/title/type via the version join), version number, employee, assigned
// date, acknowledged date and the stored status (PENDING / ACKNOWLEDGED).
// Acknowledgement is VERSION-SPECIFIC by construction: each row is pinned to
// exactly one document version, so acknowledging v3 of an SOP never touches
// the v4 rows. Every column is a stored value — nothing is derived.
//
// All roles may view (LAB_DOCUMENT_VIEW); the Acknowledge action renders only
// on the viewer's OWN pending rows (self-scoped). Assignment lives on the
// version-filtered view (or the per-version "Assign employees" page): a
// supervisor+ assigns an APPROVED version to active employees, which creates
// the PENDING rows + notifications. Server-side filters (q / status / document
// / employee / version), whitelisted sorting and pagination live in
// src/lib/lab/acknowledgements.ts — the URL is the source of truth and every
// SQL value is a bound parameter.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import LabSaveViewForm from '../../../components/lab/LabSaveViewForm.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import {
  hasLabAcknowledgementFilters,
  labAcknowledgementFiltersToQuery,
  listLabAcknowledgementDocuments,
  listLabAcknowledgementEmployees,
  parseLabAcknowledgementFilters,
  searchLabAcknowledgements,
  LAB_ACKNOWLEDGEMENT_PER_PAGE_OPTIONS,
  LAB_ACKNOWLEDGEMENT_STATUS_LABELS,
  LAB_ACKNOWLEDGEMENT_STATUSES,
  type LabAcknowledgementSearchFilters,
  type LabAcknowledgementSortField,
} from '../../../lib/lab/acknowledgements';
import { canAssignLabDocumentAcknowledgement } from '../../../lib/permissions';
import type { LabAcknowledgementStatus, Role } from '../../../lib/types';
import Banner from '../../../components/ui/Banner.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { FILTER_TOOLBAR } from '../../../components/ui/formPresets';
import AppButton from '../../../components/ui/AppButton.astro';
import { ACKNOWLEDGEMENT_BADGE_CLS as STATUS_BADGE_CLS } from '../../../components/ui/labBadgeClasses';

const user = Astro.locals.user!;
const role = user.role as Role;

const navItems = labNavForRole(role);
const filters: LabAcknowledgementSearchFilters = parseLabAcknowledgementFilters(Astro.url);

let dataError: string | null = null;
let result: ReturnType<typeof searchLabAcknowledgements> = {
  rows: [],
  total: 0,
  page: 1,
  per_page: 25,
  total_pages: 1,
};
let documents: Array<{ id: number; code: string; title: string }> = [];
let employees: Array<{ id: number; full_name: string }> = [];
try {
  result = searchLabAcknowledgements(filters);
  documents = listLabAcknowledgementDocuments();
  employees = listLabAcknowledgementEmployees();
} catch (err) {
  console.error('[lab] acknowledgements register query failure', err);
  dataError = 'Could not load the acknowledgement register. Try reloading — if the problem persists, contact an administrator.';
}

const filtered = hasLabAcknowledgementFilters(filters);
const versionScoped = filters.version !== null;
const canAssign = canAssignLabDocumentAcknowledgement(role);

const qsParams = new URLSearchParams(labAcknowledgementFiltersToQuery({ ...filters, page: 1 }).replace(/^\?/, ''));

function pageHref(p: number): string {
  const sp = new URLSearchParams(qsParams);
  if (p > 1) sp.set('page', String(p));
  else sp.delete('page');
  const qs = sp.toString();
  return qs ? `/lab/acknowledgements?${qs}` : '/lab/acknowledgements';
}

function sortHref(field: LabAcknowledgementSortField): string {
  const next: LabAcknowledgementSearchFilters = {
    ...filters,
    sort: field,
    dir: (filters.sort === field && filters.dir === 'asc' ? 'desc' : 'asc') as 'asc' | 'desc',
    page: 1,
  };
  return `/lab/acknowledgements${labAcknowledgementFiltersToQuery(next)}`;
}

function sortArrow(field: LabAcknowledgementSortField): string {
  if (filters.sort !== field) return '';
  return filters.dir === 'asc' ? ' ▲' : ' ▼';
}

const SORTABLE: { field: LabAcknowledgementSortField; label: string }[] = [
  { field: 'document', label: 'Document' },
  { field: 'version', label: 'Version' },
  { field: 'employee', label: 'Employee' },
  { field: 'assigned_at', label: 'Assigned Date' },
  { field: 'acknowledged_at', label: 'Acknowledged Date' },
  { field: 'status', label: 'Status' },
];

function th(field: LabAcknowledgementSortField, label: string): string {
  return `<a href="${sortHref(field)}" class="inline-flex items-center gap-1 hover:text-slate-900">${label}${sortArrow(field)}</a>`;
}



function statusBadge(status: LabAcknowledgementStatus): string {
  return `<span class="inline-flex items-center gap-1 whitespace-nowrap rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${STATUS_BADGE_CLS[status]}">${LAB_ACKNOWLEDGEMENT_STATUS_LABELS[status]}</span>`;
}

function fmtDate(d: string | null | undefined): string {
  return d ? String(d).slice(0, 10) : '—';
}
---

<BaseLayout title="Document Acknowledgements">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Acknowledgements' },
      ]}
    />

    <PageHeader eyebrow="QC Laboratory — Controlled Documents" title="Document Acknowledgements" description="Tracks who must read and acknowledge each controlled document version. Every row is pinned to one version — acknowledging SOP-QC-001 v3 never counts for v4. Assigned employees see an Acknowledge action on their own pending rows; supervisors assign versions from the version history." />

    <LabSecondaryNav items={navItems} currentPath="/lab/acknowledgements" />

    {dataError && (
      <Banner tone="error">{dataError}</Banner>
    )}

    {!dataError && (
      <>
        <form method="get" action="/lab/acknowledgements" class={FILTER_TOOLBAR}>
          <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
            <label class="flex min-w-0 flex-col gap-1 text-sm font-medium text-slate-700">
              Search
              <input
                type="search"
                name="q"
                value={filters.q ?? ''}
                placeholder="Document code, title, employee…"
                class="mt-0.5 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
              />
            </label>
            <label class="flex min-w-0 flex-col gap-1 text-sm font-medium text-slate-700">
              Status
              <select name="status" class="mt-0.5 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="">All statuses</option>
                {LAB_ACKNOWLEDGEMENT_STATUSES.map((s) => (
                  <option value={s} selected={filters.status === s}>{LAB_ACKNOWLEDGEMENT_STATUS_LABELS[s]}</option>
                ))}
              </select>
            </label>
            <label class="flex min-w-0 flex-col gap-1 text-sm font-medium text-slate-700">
              Document
              <select name="document" class="mt-0.5 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="">All documents</option>
                {documents.map((d) => (
                  <option value={d.id} selected={filters.document === d.id} dir="ltr">{d.code} — {d.title}</option>
                ))}
              </select>
            </label>
            <label class="flex min-w-0 flex-col gap-1 text-sm font-medium text-slate-700">
              Employee
              <select name="employee" class="mt-0.5 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="">All employees</option>
                {employees.map((e) => (
                  <option value={e.id} selected={filters.employee === e.id}>{e.full_name}</option>
                ))}
              </select>
            </label>
            <label class="flex min-w-0 flex-col gap-1 text-sm font-medium text-slate-700">
              Per page
              <select name="per" class="mt-0.5 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                {LAB_ACKNOWLEDGEMENT_PER_PAGE_OPTIONS.map((n) => (
                  <option value={n} selected={filters.per_page === n}>{n} per page</option>
                ))}
              </select>
            </label>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <AppButton type="submit" variant="primary">Apply filters</AppButton>
            <AppButton href="/lab/acknowledgements" variant="secondary">Reset</AppButton>
          </div>
        </form>

        <LabSaveViewForm path="/lab/acknowledgements" />

        {versionScoped && (
          <p class="rounded-lg border border-brand-100 bg-brand-50/50 px-4 py-2.5 text-sm text-slate-700">
            Showing acknowledgements for one version only.
            {canAssign && (
              <a
                href={`/lab/acknowledgements/assign?version=${filters.version}`}
                class="ml-1 font-medium text-brand-700 hover:underline"
              >
                Assign employees to this version
              </a>
            )}
          </p>
        )}

        <p class="text-sm text-slate-600">
          {result.total.toLocaleString('en-US')} acknowledgement{result.total === 1 ? '' : 's'} found
          {filtered && <span> (filtered — <a href="/lab/acknowledgements" class="text-brand-600 hover:underline">clear all</a>)</span>}
        </p>

        {result.rows.length === 0 ? (
          <EmptyState
            title={filtered ? 'No acknowledgements match your search' : 'No acknowledgements yet'}
            hint={filtered ? 'Try adjusting the search or clearing the filters.' : 'Assigned document versions appear here as supervisors assign them — nothing is fabricated.'}
            ctaHref={filtered ? '/lab/acknowledgements' : '/lab/documents'}
            ctaLabel={filtered ? 'Clear filters' : 'Browse the document library'}
          />
        ) : (
          <section aria-label="Acknowledgement Register" class="rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto contain-layout contain-paint">
              <table class="min-w-[1000px] divide-y divide-slate-100 text-sm">
                <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    {SORTABLE.map((s) => (
                      <th scope="col" class="px-4 py-2.5 font-semibold" set:html={th(s.field, s.label)} />
                    ))}
                    <th scope="col" class="px-4 py-2.5 font-semibold"><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {result.rows.map((r) => {
                    const isMine = r.user_id === user.userId && r.status === 'PENDING';
                    return (
                      <tr class="align-middle">
                        <td class="px-4 py-2">
                          <div class="font-medium text-slate-900" dir="ltr">{r.code}</div>
                          <div class="text-xs text-slate-500">{r.title}</div>
                        </td>
                        <td class="px-4 py-2 whitespace-nowrap text-slate-700" dir="ltr">v{r.version}</td>
                        <td class="px-4 py-2 whitespace-nowrap text-slate-700">{r.employee_name}</td>
                        <td class="px-4 py-2 whitespace-nowrap text-slate-700" dir="ltr">{fmtDate(r.assigned_at)}</td>
                        <td class="px-4 py-2 whitespace-nowrap text-slate-700" dir="ltr">{fmtDate(r.acknowledged_at)}</td>
                        <td class="px-4 py-2" set:html={statusBadge(r.status)} />
                        <td class="px-4 py-2">
                          {isMine ? (
                            <form method="post" action={`/lab/acknowledgements/${r.id}/acknowledge`}>
                              <button
                                type="submit"
                                class="rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
                              >
                                Acknowledge
                              </button>
                            </form>
                          ) : (
                            <span class="text-slate-300">—</span>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <Pagination page={result.page} totalPages={result.total_pages} hrefFor={pageHref} />
      </>
    )}
  </div>
</BaseLayout>
