---
// /lab/acknowledgements/assign?version=<id> — assign a controlled document
// version to employees for acknowledgement (LAB_DOCUMENT_ACKNOWLEDGE use case,
// supervisor+ action).
//
// The version id comes from the URL query ONLY (never a form field — the same
// pattern as retest creation). The page loads the version + its document via
// getLabAcknowledgementAssignView and renders:
//   - the version identity read-only (document code/title/type + version + the
//     version's stored status);
//   - employees ALREADY assigned, read-only (employee, status, dates);
//   - ACTIVE employees NOT yet assigned as checkboxes (the assignable pool).
// Only APPROVED versions are assignable — a draft is never something an
// employee acknowledges — so a non-APPROVED version renders an empty state
// with no form (no dead affordance). Assignment itself is version-specific by
// construction: each (version, user) pair is one PENDING row, so assigning v3
// and v4 of the same document creates two independent rows.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import { getLabAcknowledgementAssignView, LAB_ACKNOWLEDGEMENT_STATUS_LABELS } from '../../../lib/lab/acknowledgements';
import { canAssignLabDocumentAcknowledgement } from '../../../lib/permissions';
import { setFlash } from '../../../lib/flash';
import type { LabAcknowledgementStatus, LabDocumentStatus, Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;
const navItems = labNavForRole(role);

// Defense-in-depth (contract §5.1): every page re-checks the permission
// server-side. Assignment is supervisor+.
if (!canAssignLabDocumentAcknowledgement(role)) {
  setFlash(Astro, 'error', 'You do not have permission to assign document acknowledgements.');
  return Astro.redirect('/lab/acknowledgements');
}

const versionParam = Astro.url.searchParams.get('version');
const versionId = versionParam !== null && /^\d+$/.test(versionParam) ? Number(versionParam) : null;

let view: ReturnType<typeof getLabAcknowledgementAssignView> = null;
if (versionId !== null) {
  try {
    view = getLabAcknowledgementAssignView(versionId);
  } catch (err) {
    console.error('[lab] acknowledgement assign view load failure', err);
  }
}

const STATUS_BADGE_CLS: Record<LabDocumentStatus, string> = {
  DRAFT: 'bg-slate-100 text-slate-700 ring-slate-200',
  IN_REVIEW: 'bg-amber-50 text-amber-700 ring-amber-200',
  APPROVED: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
  SUPERSEDED: 'bg-violet-50 text-violet-700 ring-violet-200',
  ARCHIVED: 'bg-slate-100 text-slate-500 ring-slate-200',
};

const ACK_BADGE_CLS: Record<LabAcknowledgementStatus, string> = {
  PENDING: 'bg-amber-50 text-amber-700 ring-amber-200',
  ACKNOWLEDGED: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
};

function ackBadge(status: LabAcknowledgementStatus): string {
  return `<span class="inline-flex items-center gap-1 whitespace-nowrap rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${ACK_BADGE_CLS[status]}">${LAB_ACKNOWLEDGEMENT_STATUS_LABELS[status]}</span>`;
}

function fmtDate(d: string | null): string {
  return d ? d.slice(0, 10) : '—';
}

function versionStatusBadge(status: LabDocumentStatus): string {
  return `<span class="inline-flex items-center gap-1 whitespace-nowrap rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${STATUS_BADGE_CLS[status]}">${status}</span>`;
}

const backHref = view
  ? `/lab/acknowledgements?version=${view.version_id}`
  : '/lab/acknowledgements';
---

<BaseLayout title={view ? `Assign · ${view.document.code} v${view.version}` : 'Assign Acknowledgements'}>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Acknowledgements', href: '/lab/acknowledgements' },
        ...(view ? [{ label: 'Assign' }] : []),
      ]}
    />

    {!view ? (
      <>
        <header>
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Controlled Documents</p>
          <h1 class="mt-1 text-3xl font-semibold text-slate-900">Version not found</h1>
        </header>
        <EmptyState
          title="No version selected"
          hint="Open a version from the document version history and choose “Acknowledgements” to assign employees."
          ctaHref="/lab/documents"
          ctaLabel="Browse the document library"
        />
      </>
    ) : (
      <>
        <header class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Controlled Documents</p>
            <h1 class="mt-1 text-3xl font-semibold text-slate-900">
              Assign <span dir="ltr">{view.document.code} v{view.version}</span>
            </h1>
            <p class="mt-1 max-w-3xl text-sm text-slate-600">
              {view.document.title} — version status{' '}
              <span set:html={versionStatusBadge(view.version_status)} />
              . Assigning creates one PENDING row per employee — version-specific, so this never touches other versions.
            </p>
          </div>
          <a
            href={backHref}
            class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50"
          >
            ← Back to acknowledgements
          </a>
        </header>

        <LabSecondaryNav items={navItems} currentPath="/lab/acknowledgements/assign" />

        {!view.is_assignable ? (
          <EmptyState
            title="Only approved versions can be assigned"
            hint={`Version v${view.version} of ${view.document.code} is ${view.version_status}. Employees acknowledge versions once they are approved and in effect — a draft or superseded version is never assigned.`}
            ctaHref={`/lab/acknowledgements?version=${view.version_id}`}
            ctaLabel="View this version's acknowledgements"
          />
        ) : (
          <form
            method="post"
            action={`/lab/acknowledgements/assign?version=${view.version_id}`}
            class="space-y-6"
          >
            {view.existing.length > 0 && (
              <section aria-labelledby="existing-assignments" class="rounded-xl border border-slate-200 bg-white shadow-sm">
                <div class="border-b border-slate-100 px-4 py-3">
                  <h2 id="existing-assignments" class="text-base font-semibold text-slate-900">Already Assigned</h2>
                  <p class="mt-0.5 text-xs text-slate-500">
                    These employees already hold an acknowledgement row for this version — read-only, never duplicated.
                  </p>
                </div>
                <div class="overflow-x-auto contain-layout contain-paint">
                  <table class="min-w-[720px] divide-y divide-slate-100 text-sm">
                    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                      <tr>
                        <th scope="col" class="px-4 py-2.5 font-semibold">Employee</th>
                        <th scope="col" class="px-4 py-2.5 font-semibold">Status</th>
                        <th scope="col" class="px-4 py-2.5 font-semibold">Assigned Date</th>
                        <th scope="col" class="px-4 py-2.5 font-semibold">Acknowledged Date</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                      {view.existing.map((a) => (
                        <tr class="align-middle">
                          <td class="px-4 py-2 text-slate-700">{a.full_name}</td>
                          <td class="px-4 py-2" set:html={ackBadge(a.status)} />
                          <td class="px-4 py-2 whitespace-nowrap text-slate-700" dir="ltr">{fmtDate(a.assigned_at)}</td>
                          <td class="px-4 py-2 whitespace-nowrap text-slate-700" dir="ltr">{fmtDate(a.acknowledged_at)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </section>
            )}

            <section aria-labelledby="assign-employees" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
              <h2 id="assign-employees" class="text-base font-semibold text-slate-900">Assign Employees</h2>
              <p class="mt-0.5 text-xs text-slate-500">
                Pick the active employees who must read and acknowledge this version. Each selection creates a PENDING
                acknowledgement and notifies the employee.
              </p>
              {view.available_users.length === 0 ? (
                <p class="mt-3 text-sm text-slate-500">
                  Every active employee is already assigned to this version.
                </p>
              ) : (
                <fieldset class="mt-3">
                  <legend class="sr-only">Employees to assign</legend>
                  <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                    {view.available_users.map((u) => (
                      <label class="flex items-start gap-2 rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">
                        <input
                          type="checkbox"
                          name="user_ids"
                          value={u.id}
                          class="mt-0.5 h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"
                        />
                        <span>{u.full_name}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              )}
            </section>

            <div class="flex flex-wrap items-center gap-2">
              <button
                type="submit"
                class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
              >
                Assign for Acknowledgement
              </button>
              <a
                href={backHref}
                class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50"
              >
                Cancel
              </a>
            </div>
          </form>
        )}
      </>
    )}
  </div>
</BaseLayout>
