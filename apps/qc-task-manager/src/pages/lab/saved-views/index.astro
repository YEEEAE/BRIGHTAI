---
// /lab/saved-views — QC Laboratory Saved Views (PROMPT 24).
//
// Lists the signed-in user's saved laboratory filter views. Every view is a
// named, structured, validated filter set ({ path, params }) — never raw SQL
// or an arbitrary query string. Applying a view rebuilds a safe URL from the
// allowlisted params; deleting is owner-only. Views are strictly user-scoped:
// a user only ever sees, applies, or deletes their own rows.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import {
  LAB_SAVED_VIEW_NAME_MAX,
  LAB_VIEW_TARGET_LABELS,
  labViewHref,
  listLabSavedViews,
  validateLabViewFilter,
} from '../../../lib/lab/savedViews';
import type { Role } from '../../../lib/types';
import Banner from '../../../components/ui/Banner.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';

const user = Astro.locals.user!;
const role = user.role as Role;
const navItems = labNavForRole(role);

let dataError: string | null = null;
let views: ReturnType<typeof listLabSavedViews> = [];
try {
  views = listLabSavedViews(user.userId);
} catch (err) {
  console.error('[lab] saved views query failure', err);
  dataError = 'Could not load your saved views. Try reloading — if the problem persists, contact an administrator.';
}

function formatDbDate(value: string): string {
  const d = new Date(value.replace(' ', 'T') + 'Z');
  return Number.isNaN(d.getTime())
    ? value
    : d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}

const currentUrl = Astro.url.pathname + Astro.url.search;
---

<BaseLayout title="Saved Views">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Saved Views' },
      ]}
    />

    <PageHeader eyebrow="QC Laboratory — Overview" title="Saved Views" description="One-click access to the filter sets you saved from any laboratory list. Views are private — only you can see, apply, or delete them. Each view stores a validated, structured filter (never raw SQL)." />

    <LabSecondaryNav items={navItems} currentPath="/lab/saved-views" />

    {dataError && (
      <Banner tone="error">{dataError}</Banner>
    )}

    {!dataError && views.length === 0 && (
      <EmptyState
        title="No saved views yet"
        hint="Open a laboratory list (Tests, Equipment, Documents, …), apply the filters you want, then choose “Save view” to reuse them here with one click."
        ctaHref="/lab/tests"
        ctaLabel="Go to Test Register"
      />
    )}

    {!dataError && views.length > 0 && (
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {views.map((v) => {
          const filter = validateLabViewFilter(v.filter_json);
          const targetLabel = filter ? (LAB_VIEW_TARGET_LABELS[filter.path] ?? filter.path) : 'Invalid';
          return (
            <li class="flex flex-col justify-between gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-slate-900" title={v.name}>{v.name}</p>
                <p class="mt-0.5 text-xs text-slate-500">
                  <span class="font-medium text-slate-600">{targetLabel}</span>
                  {' · '}saved {formatDbDate(v.created_at)}
                </p>
              </div>
              <div class="flex items-center justify-between gap-2">
                <a
                  href={labViewHref(v.filter_json)}
                  class="inline-flex items-center rounded-lg bg-brand-600 px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-brand-700"
                >
                  Open view
                </a>
                <form method="post" action="/api/lab/saved-views">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="view_id" value={v.id} />
                  <input type="hidden" name="next" value={currentUrl} />
                  <button
                    type="submit"
                    class="rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:bg-red-50 hover:text-red-700"
                    aria-label={`Delete saved view ${v.name}`}
                  >
                    Delete saved view
                  </button>
                </form>
              </div>
            </li>
          );
        })}
      </ul>
    )}

    <p class="text-xs text-slate-400">
      Tip: view names can be up to {LAB_SAVED_VIEW_NAME_MAX} characters. Common starting points: My Air Tests
      (<code class="rounded bg-slate-100 px-1">type=air</code>), My Vacuum Tests (<code class="rounded bg-slate-100 px-1">type=vacuum</code>),
      Failed Tests (<code class="rounded bg-slate-100 px-1">result=FAIL</code>), HOLD Tests (<code class="rounded bg-slate-100 px-1">result=HOLD</code>),
      Calibration Due (<code class="rounded bg-slate-100 px-1">due=1</code>), SOP Review Due (<code class="rounded bg-slate-100 px-1">review=due</code>),
      Open Retests (<code class="rounded bg-slate-100 px-1">status=OPEN</code>).
    </p>
  </div>
</BaseLayout>
