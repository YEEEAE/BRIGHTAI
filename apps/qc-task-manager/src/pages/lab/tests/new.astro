---
// /lab/tests/new — Shared AIR/VACUUM Laboratory Test Form (PROMPT 05).
//
// ONE page serves both test types; test_type comes from the query parameter
// (?type=air | ?type=vacuum) and NEVER from the request body — the POST
// handler re-resolves it from the query only (§66: hidden fields are
// ignored). Only printed/black fields from the approved form become inputs;
// handwritten-only content is not invented. Reference values are displayed
// for traceability but never compared against measurements, and no formula
// or AI-determined result exists anywhere (§78).
//
// The form itself lives in the LabTestForm island (client:visible) so the
// sample grid can grow/shrink with No. of Samples Tested without a page
// round-trip. The server re-validates the entire payload with Zod
// (labTestFormSchema in src/lib/validation.ts).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import LabTestForm from '../../../components/lab/LabTestForm';
import { labNavForRole } from '../../../lib/lab/navigation';
import { listLabEquipmentForForm, listLabProductsForForm, getLabTestEditableDraft, listLabTestEnvironmentReadings } from '../../../lib/lab/tests';
import { listLabProductReferences } from '../../../lib/lab/products';
import { listLabTemplateReferences } from '../../../lib/lab/templates';
import {
  LAB_CONNECTOR_TYPES,
  LAB_ENV_READINGS_MAX,
  LAB_RESULT_LABELS,
  LAB_SAMPLE_RESULT_OPTIONS,
  LAB_FINAL_RESULT_OPTIONS,
  LAB_SAMPLE_COUNT_DEFAULT,
  LAB_SAMPLE_COUNT_MAX,
  LAB_SAMPLE_COUNT_MIN,
} from '../../../lib/lab/policy';
import { canCreateLabTest } from '../../../lib/permissions';
import type { Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;

const rawType = Astro.url.searchParams.get('type');
if (rawType !== 'air' && rawType !== 'vacuum') {
  return Astro.redirect('/lab');
}
const testType = rawType;

// Edit mode (PROMPT 43-B): ?test=<id> loads the caller's own DRAFT for
// editing on this same form. The scope + DRAFT-only decision is server-side
// (tested_by OR created_by for employees); anything else renders the same
// not-found state as the detail page (no existence leak). In edit mode the
// test type comes from the stored record, not the query.
const rawTestId = Astro.url.searchParams.get('test');
let editDraft: ReturnType<typeof getLabTestEditableDraft> = null;
if (rawTestId !== null && /^\d+$/.test(rawTestId)) {
  editDraft = getLabTestEditableDraft(Number(rawTestId), { id: user.userId, role });
  if (!editDraft) {
    return Astro.redirect('/lab/tests');
  }
}
const effectiveTestType = (editDraft?.test_type ?? testType) as 'air' | 'vacuum';

if (!canCreateLabTest(role)) {
  return Astro.redirect('/lab');
}

let loadError: string | null = null;
let equipment: ReturnType<typeof listLabEquipmentForForm> = [];
let products: ReturnType<typeof listLabProductsForForm> = [];
let productRefs: ReturnType<typeof listLabProductReferences> = [];
let templateRefs: ReturnType<typeof listLabTemplateReferences> = [];
try {
  equipment = listLabEquipmentForForm();
  products = listLabProductsForForm();
  productRefs = listLabProductReferences();
  templateRefs = listLabTemplateReferences();
} catch (err) {
  console.error('[lab] test form load failure', err);
  loadError = 'Could not load the equipment and product lists. Try reloading — if the problem persists, contact an administrator.';
}

const navItems = labNavForRole(role);
const title = editDraft ? `Edit Draft ${editDraft.test_number}` : testType === 'air' ? 'New AIR Test' : 'New VACUUM Test';
const testTypeLabel = effectiveTestType === 'air' ? 'AIR' : 'VACUUM';
const userName = user.fullName;

const initialValues = editDraft
  ? {
      product_description: editDraft.product_description,
      connector_type: (editDraft.record.connector_type as string | null) ?? null,
      sample_count: Number(editDraft.record.sample_count),
      lot_number: (editDraft.record.lot_number as string | null) ?? null,
      sampling_area: (editDraft.record.sampling_area as string | null) ?? null,
      equipment_id: editDraft.record.equipment_id == null ? null : Number(editDraft.record.equipment_id),
      medium_used: (editDraft.record.medium_used as string | null) ?? null,
      actual_pressure: (editDraft.record.actual_pressure as string | null) ?? null,
      actual_force: (editDraft.record.actual_force as string | null) ?? null,
      torque_in_lb: (editDraft.record.torque_in_lb as string | null) ?? null,
      torque_value: (editDraft.record.torque_value as string | null) ?? null,
      time_sec: (editDraft.record.time_sec as string | null) ?? null,
      angle: (editDraft.record.angle as string | null) ?? null,
      temperature_measured: (editDraft.record.temperature_measured as string | null) ?? null,
      testing_date: (editDraft.record.testing_date as string | null) ?? null,
      humidity_measured: (editDraft.record.humidity_measured as string | null) ?? null,
      remarks: (editDraft.record.remarks as string | null) ?? null,
      final_result: (editDraft.record.final_result as string | null) ?? null,
      template_version_id: editDraft.record.template_version_id == null ? null : Number(editDraft.record.template_version_id),
      environmentReadings: listLabTestEnvironmentReadings(editDraft.id).map((r) => ({
        reading_at: r.reading_at,
        temperature: r.temperature,
        humidity: r.humidity ?? '',
        notes: r.notes ?? '',
      })),
      samples: editDraft.samples.map((s) => ({
        sample_no: Number(s.sample_no),
        part_name: s.part_name ?? '',
        set_pressure: s.set_pressure ?? '',
        actual_pressure: s.actual_pressure ?? '',
        applied_pressure: s.applied_pressure ?? '',
        volume_sec: s.volume_sec ?? '',
        volume_liter: s.volume_liter ?? '',
        pressure_difference: s.pressure_difference ?? '',
        holding_time_sec: s.holding_time_sec ?? '',
        leakage_rate: s.leakage_rate ?? '',
        result: (s.result ?? '') as '' | 'PASS' | 'FAIL' | 'HOLD',
      })),
    }
  : undefined;

const referenceValues = {
  actualPressure: 'No approved reference available.',
  standardParameter: 'No approved reference available.',
  acceptanceCriteria: 'No approved reference available.',
  holdingTime: 'No approved reference available.',
};

const sampleResultOptions = LAB_SAMPLE_RESULT_OPTIONS.map((value) => ({ value, label: LAB_RESULT_LABELS[value] }));
const finalResultOptions = LAB_FINAL_RESULT_OPTIONS.map((value) => ({ value, label: LAB_RESULT_LABELS[value] }));
---

<BaseLayout title={title}>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: testTypeLabel === 'AIR' ? 'New AIR Test' : 'New VACUUM Test' },
      ]}
    />

    <header>
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — {testTypeLabel}</p>
      <h1 class="mt-1 text-3xl font-semibold text-slate-900">{title}</h1>
      <p class="mt-1 max-w-3xl text-sm text-slate-600">
        Records an {testTypeLabel} leak test for a product lot. Sample measurements are entered exactly as taken;
        results are human decisions. Reference values are shown for traceability only.
      </p>
    </header>

    <LabSecondaryNav items={navItems} currentPath="/lab/tests/new" />

    {loadError && (
      <div role="alert" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {loadError}
      </div>
    )}

    <LabTestForm
      client:visible
      testType={effectiveTestType}
      userName={userName}
      testId={editDraft?.id}
      testNumber={editDraft?.test_number}
      initial={initialValues}
      equipment={equipment}
      products={products}
      productRefs={productRefs}
      connectorTypes={[...LAB_CONNECTOR_TYPES]}
      templateRefs={templateRefs}
      sampleResultOptions={sampleResultOptions}
      finalResultOptions={finalResultOptions}
      reference={referenceValues}
      sampleCountMin={LAB_SAMPLE_COUNT_MIN}
      sampleCountMax={LAB_SAMPLE_COUNT_MAX}
      sampleCountDefault={LAB_SAMPLE_COUNT_DEFAULT}
      envReadingsMax={LAB_ENV_READINGS_MAX}
    />
  </div>
</BaseLayout>
