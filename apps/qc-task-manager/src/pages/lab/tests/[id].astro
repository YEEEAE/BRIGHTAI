---
// /lab/tests/[id] — read-only laboratory test record (PROMPT 06, extended).
//
// This page is the complete record view: test identification, sample
// identification, equipment, connector assembly, differential conversion,
// test parameters, sample results, remarks, workflow, applicable SOP/WI,
// equipment + calibration snapshots, related product, template snapshot,
// retest history, investigation/NCR/CAPA hooks and the audit timeline
// (page reference §24).
//
// It is intentionally READ-ONLY: workflow mutations (Edit/Submit/Review/
// Approve/Void/Retest) land with the review/approve module. APPROVED and VOID
// records are immutable quality records — this page surfaces a clear badge and
// shows no mutable affordances for them. RBAC scope mirrors the register:
// employees may only open tests they tested or created; anyone else gets 404.
//
// Approval-time immutability is honoured: the equipment/SOP/WI snapshots and
// the product/template/parameters snapshots on the record are the historical
// truth and are shown as-is. The controlled print view reads the SAME loader
// (loadLabTestView) so the printed record matches the stored record exactly.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import { loadLabTestView } from '../../../lib/lab/tests';
import { LAB_TEST_STATUS_LABELS } from '../../../lib/lab/testSearch';
import { LAB_RESULT_LABELS, LAB_RESULT_OPTIONS } from '../../../lib/lab/policy';
import { getLabTestFindingLinkOptions } from '../../../lib/lab/findingLinks';
import { canCreateLabRetest, canLinkLabTestToFinding, canReviewLabTest } from '../../../lib/permissions';
import AiReviewPanel from '../../../components/AiReviewPanel';
import type { Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;
const userId = user.userId;

const navItems = labNavForRole(role);

const idParam = Astro.params.id;
const id = idParam ? Number(idParam) : Number.NaN;
const validId = Number.isInteger(id) && id > 0;

let view = loadLabTestView(Number.NaN, false);
let loadError: string | null = null;

if (validId) {
  try {
    const record = loadLabTestView(id, true).record;
    const testedBy = record?.tested_by == null ? null : Number(record.tested_by);
    const createdBy = record?.created_by == null ? null : Number(record.created_by);
    const isOwn = role === 'employee' && (testedBy === userId || createdBy === userId);
    view = loadLabTestView(id, role !== 'employee' || isOwn);
  } catch (err) {
    console.error('[lab] test details load failure', err);
    loadError = 'Could not load this test record. Try reloading — if the problem persists, contact an administrator.';
  }
}

const record = view.record;
const notFound = !validId || record === null;

const status = record ? String(record.status) : '';
const result = record ? String(record.final_result ?? '') : '';
const immutable = status === 'APPROVED' || status === 'VOID';
const typeLabel = record ? String(record.test_type).toUpperCase() : '';
const recordId = record ? Number(record.id) : Number.NaN;
const canLinkFindings = canLinkLabTestToFinding(role);
const findingLinkOptions = record && canLinkFindings ? getLabTestFindingLinkOptions(recordId) : [];

const statusTone: Record<string, string> = {
  DRAFT: 'bg-slate-100 text-slate-700',
  SUBMITTED: 'bg-blue-100 text-blue-800',
  UNDER_REVIEW: 'bg-amber-100 text-amber-800',
  REJECTED: 'bg-rose-100 text-rose-800',
  APPROVED: 'bg-emerald-100 text-emerald-800',
  VOID: 'bg-slate-200 text-slate-500',
};
const resultTone: Record<string, string> = { PASS: 'text-green-700', FAIL: 'text-red-700', HOLD: 'text-orange-700' };
const resultToneBadge: Record<string, string> = {
  PASS: 'bg-green-100 text-green-800',
  FAIL: 'bg-red-100 text-red-800',
  HOLD: 'bg-orange-100 text-orange-800',
};

function actor(name: unknown): string {
  return name ? String(name) : '—';
}
function field(k: string): string {
  const v = record?.[k];
  return v == null || v === '' ? '—' : String(v);
}

// Human labels for the snapshots_json keys (see policy.ts §5).
const PARAM_LABELS: Record<string, string> = {
  standard_parameter: 'Standard Parameter',
  acceptance_criteria: 'Acceptance Criteria',
  holding_time: 'Holding Time',
  actual_pressure_reference: 'Actual Pressure Reference',
};
const RETEST_REASON_LABELS: Record<string, string> = {
  FAIL: 'FAIL',
  HOLD: 'HOLD / Further Evaluation',
  SAMPLE_ISSUE: 'Sample Issue',
  EQUIPMENT_ISSUE: 'Equipment Issue',
  PROCEDURAL_ISSUE: 'Procedural Issue',
  OTHER: 'Other',
};

const resultLabel = (v: unknown) => {
  const s = v == null ? '' : String(v);
  return s ? (LAB_RESULT_LABELS[s as (typeof LAB_RESULT_OPTIONS)[number]] ?? s) : '—';
};

const SAMPLE_STATUS_LABELS: Record<string, string> = {
  PENDING: 'Pending',
  TESTED: 'Tested',
  APPROVED: 'Approved',
  VOID: 'Void',
};
const sampleStatusLabel = (v: unknown) => {
  const s = v == null ? '' : String(v);
  return s ? (SAMPLE_STATUS_LABELS[s] ?? s) : '—';
};

function snapshotEntries(snap: Record<string, unknown> | null): Array<[string, string]> {
  if (!snap) return [];
  return Object.entries(snap).map(([k, v]) => [k, v == null || v === '' ? '—' : String(v)]);
}
---

<BaseLayout title={record ? `${String(record.test_number)} — Laboratory Test` : 'Test not found'}>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Tests', href: '/lab/tests' },
        { label: record ? String(record.test_number) : 'Test' },
      ]}
    />

    <LabSecondaryNav items={navItems} currentPath="/lab/tests" />

    {notFound ? (
      <section class="mx-auto max-w-xl rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
        <h1 class="text-xl font-semibold text-slate-900">Test not found</h1>
        <p class="mt-2 text-sm text-slate-600">
          {loadError ?? 'This test record does not exist or is not available to you.'}
        </p>
        <a href="/lab/tests" class="mt-5 inline-block rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Back to the register</a>
      </section>
    ) : record ? (
      <>
        <header class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Laboratory Test Record</p>
            <h1 class="mt-1 text-3xl font-semibold text-slate-900">{String(record.test_number)}</h1>
            <p class="mt-1 text-sm text-slate-600">
              {typeLabel} test · created {field('created_at')} by {actor(record.creator_name)}
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span class={`inline-flex rounded-full px-3 py-1 text-xs font-semibold ${statusTone[status] ?? 'bg-slate-100 text-slate-700'}`}>
              {LAB_TEST_STATUS_LABELS[status as keyof typeof LAB_TEST_STATUS_LABELS] ?? status}
            </span>
            {result && <span class={`inline-flex rounded-full px-3 py-1 text-xs font-semibold ${resultToneBadge[result] ?? 'bg-slate-100 text-slate-700'}`}>{resultLabel(result)}</span>}
            {immutable && (
              <span class="inline-flex rounded-full bg-slate-200 px-3 py-1 text-xs font-semibold text-slate-600" title="Approved and voided records are immutable quality records — they cannot be edited.">Read-only</span>
            )}
          </div>
        </header>

        {loadError && (
          <div role="alert" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{loadError}</div>
        )}

        {/* 1. Test Identification */}
        <section aria-label="Test identification" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Test Identification</h2>
          <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
            <div><dt class="text-xs font-medium text-slate-500">Test ID</dt><dd class="mt-0.5 text-sm text-slate-900">{field('test_number')}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Record ID</dt><dd class="mt-0.5 text-sm text-slate-900">{field('id')}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Test Type</dt><dd class="mt-0.5 text-sm text-slate-900">{typeLabel}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Workflow Status</dt><dd class="mt-0.5 text-sm text-slate-900">{LAB_TEST_STATUS_LABELS[status as keyof typeof LAB_TEST_STATUS_LABELS] ?? status}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Created By</dt><dd class="mt-0.5 text-sm text-slate-900">{actor(record.creator_name)}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Created At</dt><dd class="mt-0.5 text-sm text-slate-900">{field('created_at')}</dd></div>
          </dl>
        </section>

        {/* 2. Sample Identification */}
        <section aria-label="Sample identification" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Sample Identification</h2>
          <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
            <div><dt class="text-xs font-medium text-slate-500">Product Description</dt><dd class="mt-0.5 text-sm text-slate-900">{field('product_name')} <span class="text-slate-500">{record.product_code ? `(${record.product_code})` : ''}</span></dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Connector Type</dt><dd class="mt-0.5 text-sm text-slate-900">{field('connector_type')}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">No. of Samples Tested</dt><dd class="mt-0.5 text-sm text-slate-900">{field('sample_count')}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Lot Number</dt><dd class="mt-0.5 text-sm text-slate-900">{field('lot_number')}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Sampling Area</dt><dd class="mt-0.5 text-sm text-slate-900">{field('sampling_area')}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Medium Used</dt><dd class="mt-0.5 text-sm text-slate-900">{field('medium_used')}</dd></div>
          </dl>
        </section>

        {/* 3. Equipment */}
        <section aria-label="Equipment" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Equipment Used</h2>
          <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
            <div><dt class="text-xs font-medium text-slate-500">Machine</dt><dd class="mt-0.5 text-sm text-slate-900">{field('equipment_name')} <span class="text-slate-500">{record.equipment_code ? `(${record.equipment_code})` : ''}</span></dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Medium Used</dt><dd class="mt-0.5 text-sm text-slate-900">{field('medium_used')}</dd></div>
          </dl>
        </section>

        {/* 4. Connector Assembly */}
        <section aria-label="Connector assembly" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Connector Assembly</h2>
          <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
            <div><dt class="text-xs font-medium text-slate-500">Actual Pressure</dt><dd class="mt-0.5 text-sm text-slate-900">{field('actual_pressure')}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Torque (in.lb)</dt><dd class="mt-0.5 text-sm text-slate-900">{field('torque_in_lb')}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Time (Sec.)</dt><dd class="mt-0.5 text-sm text-slate-900">{field('time_sec')}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Angle</dt><dd class="mt-0.5 text-sm text-slate-900">{field('angle')}</dd></div>
          </dl>
        </section>

        {/* 5. Differential Conversion */}
        <section aria-label="Differential conversion" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Differential Conversion</h2>
          <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
            <div><dt class="text-xs font-medium text-slate-500">Temperature (Measured)</dt><dd class="mt-0.5 text-sm text-slate-900">{field('temperature_measured')}</dd></div>
          </dl>
        </section>

        {/* 6. Test Parameters */}
        <section aria-label="Test parameters" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Test Parameters</h2>
          {view.parametersSnapshot ? (
            <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
              {snapshotEntries(view.parametersSnapshot).map(([key, value]) => (
                <div><dt class="text-xs font-medium text-slate-500">{PARAM_LABELS[key] ?? key}</dt><dd class="mt-0.5 text-sm text-slate-700">{value}</dd></div>
              ))}
            </dl>
          ) : (
            <p class="mt-3 text-sm text-slate-500">Reference parameters are captured when this test is submitted for review.</p>
          )}
        </section>

        {/* 7. Sample Results */}
        <section aria-label="Sample results" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Sample Results</h2>
          {view.samples.length === 0 ? (
            <p class="mt-3 text-sm text-slate-500">No sample rows recorded.</p>
          ) : (
            <div class="mt-3 overflow-x-auto contain-layout contain-paint">
              <table class="min-w-[760px] divide-y divide-slate-100 text-sm">
                <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    <th scope="col" class="px-3 py-2 font-semibold">Sample</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Part Name</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Set Pressure</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Actual Pressure</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Volume (Sec.)</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Pressure Difference</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Holding Time (Sec.)</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Leakage Rate</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Status</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Result</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {view.samples.map((s) => {
                    const sr = s.result as string | null;
                    return (
                      <tr>
                        <td class="px-3 py-2 font-medium text-slate-900">{s.sample_identifier ?? `S${s.sample_no}`}</td>
                        <td class="px-3 py-2 text-slate-700">{s.part_name ?? '—'}</td>
                        <td class="px-3 py-2 text-slate-700">{s.set_pressure ?? '—'}</td>
                        <td class="px-3 py-2 text-slate-700">{s.actual_pressure ?? '—'}</td>
                        <td class="px-3 py-2 text-slate-700">{s.volume_sec ?? '—'}</td>
                        <td class="px-3 py-2 text-slate-700">{s.pressure_difference ?? '—'}</td>
                        <td class="px-3 py-2 text-slate-700">{s.holding_time_sec ?? '—'}</td>
                        <td class="px-3 py-2 text-slate-700">{s.leakage_rate ?? '—'}</td>
                        <td class="px-3 py-2 text-slate-700">{sampleStatusLabel(s.status)}</td>
                        <td class={`px-3 py-2 font-semibold ${sr ? resultTone[sr] ?? 'text-slate-500' : 'text-slate-400'}`}>{sr ? resultLabel(sr) : '—'}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}
        </section>

        {/* 8. Remarks */}
        {record.remarks ? (
          <section aria-label="Remarks" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Remarks</h2>
            <p class="mt-2 text-sm whitespace-pre-wrap text-slate-700">{String(record.remarks)}</p>
          </section>
        ) : null}

        {/* 9. Final Result */}
        <section aria-label="Final result" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Final Result</h2>
          <p class={`mt-3 text-sm font-semibold ${result ? resultTone[result] ?? 'text-slate-900' : 'text-slate-400'}`}>
            {result ? resultLabel(result) : 'Pending'}
          </p>
        </section>

        {/* 10. Workflow */}
        <section aria-label="Workflow" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Workflow</h2>
          <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
            <div><dt class="text-xs font-medium text-slate-500">Current Status</dt><dd class="mt-0.5 text-sm text-slate-900">{LAB_TEST_STATUS_LABELS[status as keyof typeof LAB_TEST_STATUS_LABELS] ?? status}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Submitted At</dt><dd class="mt-0.5 text-sm text-slate-900">{field('submitted_at')}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Reviewed At</dt><dd class="mt-0.5 text-sm text-slate-900">{field('reviewed_at')}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Approved At</dt><dd class="mt-0.5 text-sm text-slate-900">{field('approved_at')}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Updated At</dt><dd class="mt-0.5 text-sm text-slate-900">{field('updated_at')}</dd></div>
          </dl>
          {status === 'REJECTED' && record.rejected_reason ? (
            <div class="mt-4 rounded-lg border border-rose-200 bg-rose-50 p-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-rose-700">Rejection Reason</p>
              <p class="mt-1 text-sm text-rose-800">{String(record.rejected_reason)}</p>
            </div>
          ) : null}
          {status === 'VOID' && record.void_reason ? (
            <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-600">Void Reason</p>
              <p class="mt-1 text-sm text-slate-700">{String(record.void_reason)}</p>
            </div>
          ) : null}
        </section>

        {/* 11. Applicable SOP/WI */}
        <section aria-label="Applicable SOP or WI" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Applicable SOP / WI</h2>
          {view.documentSnapshots.length === 0 ? (
            <p class="mt-3 text-sm text-slate-500">No applicable controlled document recorded for this test.</p>
          ) : (
            <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
              {view.documentSnapshots.map((doc) => (
                <div>
                  <dt class="text-xs font-medium text-slate-500">{String(doc.role)} {doc.version_number ? `v${String(doc.version_number)}` : ''}</dt>
                  <dd class="mt-0.5 text-sm text-slate-900">{String(doc.document_code ?? '—')} — {String(doc.title ?? '—')}</dd>
                </div>
              ))}
            </dl>
          )}
        </section>

        {/* 12. Equipment + Calibration snapshot */}
        {immutable && view.equipmentSnapshot && (
          <section aria-label="Equipment and calibration snapshot" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Equipment &amp; Calibration Snapshot <span class="text-slate-400">(frozen at approval)</span></h2>
            <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
              <div><dt class="text-xs font-medium text-slate-500">Equipment Name</dt><dd class="mt-0.5 text-sm text-slate-900">{String(view.equipmentSnapshot.equipment_name ?? '—')}</dd></div>
              <div><dt class="text-xs font-medium text-slate-500">Equipment Code</dt><dd class="mt-0.5 text-sm text-slate-900">{String(view.equipmentSnapshot.equipment_code ?? '—')}</dd></div>
              <div><dt class="text-xs font-medium text-slate-500">Serial Number</dt><dd class="mt-0.5 text-sm text-slate-900">{String(view.equipmentSnapshot.serial_number ?? '—')}</dd></div>
              <div><dt class="text-xs font-medium text-slate-500">Location</dt><dd class="mt-0.5 text-sm text-slate-900">{String(view.equipmentSnapshot.location ?? '—')}</dd></div>
              <div><dt class="text-xs font-medium text-slate-500">Calibration State</dt><dd class="mt-0.5 text-sm text-slate-900">{String(view.equipmentSnapshot.calibration_state ?? '—')}</dd></div>
              <div><dt class="text-xs font-medium text-slate-500">Calibration Reference</dt><dd class="mt-0.5 text-sm text-slate-900">{String(view.equipmentSnapshot.calibration_reference ?? '—')}</dd></div>
            </dl>
          </section>
        )}

        {/* 13. Related Product */}
        <section aria-label="Related product" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Related Product</h2>
          {view.productSnapshot ? (
            <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
              {snapshotEntries(view.productSnapshot).map(([key, value]) => (
                <div><dt class="text-xs font-medium text-slate-500">{key.replace(/_/g, ' ')}</dt><dd class="mt-0.5 text-sm text-slate-700">{value}</dd></div>
              ))}
            </dl>
          ) : (
            <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
              <div><dt class="text-xs font-medium text-slate-500">Product Name</dt><dd class="mt-0.5 text-sm text-slate-900">{field('product_name')}</dd></div>
              <div><dt class="text-xs font-medium text-slate-500">Product Code</dt><dd class="mt-0.5 text-sm text-slate-900">{field('product_code')}</dd></div>
            </dl>
          )}
        </section>

        {/* 14. Template snapshot */}
        {view.templateSnapshot && (
          <section aria-label="Template snapshot" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Template Snapshot <span class="text-slate-400">(frozen at approval)</span></h2>
            <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
              {snapshotEntries(view.templateSnapshot).map(([key, value]) => (
                <div><dt class="text-xs font-medium text-slate-500">{key.replace(/_/g, ' ')}</dt><dd class="mt-0.5 text-sm text-slate-700">{value}</dd></div>
              ))}
            </dl>
          </section>
        )}

        {/* 15. Retest History */}
        <section aria-label="Retest history" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Retest History</h2>
            {canCreateLabRetest(role) && ['APPROVED', 'REJECTED', 'VOID'].includes(String(view.record?.status)) && (
              <a
                href={`/lab/retests/new?test=${id}`}
                class="rounded-lg bg-brand-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
              >
                Create Retest
              </a>
            )}
          </div>
          {view.retests.length === 0 ? (
            <p class="mt-3 text-sm text-slate-500">No retests recorded for this test.</p>
          ) : (
            <div class="mt-3 overflow-x-auto contain-layout contain-paint">
              <table class="min-w-[620px] divide-y divide-slate-100 text-sm">
                <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    <th scope="col" class="px-3 py-2 font-semibold">Retest</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Reason</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Status</th>
                    <th scope="col" class="px-3 py-2 font-semibold">New Test</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Result</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Created</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {view.retests.map((r) => (
                    <tr>
                      <td class="px-3 py-2 font-medium text-slate-900"><a href={`/lab/retests/${r.id}`} class="text-brand-600 hover:underline">{r.retest_number}</a></td>
                      <td class="px-3 py-2 text-slate-700">{RETEST_REASON_LABELS[r.reason] ?? r.reason}{r.reason_note ? ` — ${r.reason_note}` : ''}</td>
                      <td class="px-3 py-2 text-slate-700">{r.status}</td>
                      <td class="px-3 py-2 text-slate-700">{r.new_test_number ?? '—'}</td>
                      <td class="px-3 py-2 text-slate-700">{r.new_test_result ? resultLabel(r.new_test_result) : '—'}</td>
                      <td class="px-3 py-2 text-slate-700">{r.created_at}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        {/* 16. Investigation / NCR / CAPA Links */}
        <section aria-label="Investigation or CAPA links" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Investigation / NCR / CAPA Links</h2>
          {view.findingLinks.length === 0 ? (
            <p class="mt-3 text-sm text-slate-500">No linked findings.</p>
          ) : (
            <ul class="mt-3 space-y-3">
              {view.findingLinks.map((link) => (
                <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-l-2 border-brand-100 pl-3 text-sm">
                  <a href={link.href} class="font-semibold text-brand-700 hover:underline">{link.finding_number}</a>
                  <span class="text-slate-600">{link.classification} · {link.severity} · {link.status}</span>
                  {link.note ? <span class="text-slate-500">{link.note}</span> : null}
                  <span class="text-xs text-slate-400">{link.linked_by_name} · {link.created_at}</span>
                  {canLinkFindings && (
                    <form method="post" action={`/lab/tests/${recordId}/links/unlink`} class="inline">
                      <input type="hidden" name="finding_id" value={link.finding_id} />
                      <button type="submit" class="rounded-md border border-slate-300 px-2 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50">
                        Unlink
                      </button>
                    </form>
                  )}
                </li>
              ))}
            </ul>
          )}

          {canLinkFindings && (
            <form method="post" action={`/lab/tests/${recordId}/links`} class="mt-4 rounded-lg border border-slate-200 bg-slate-50 p-3">
              <div class="flex flex-wrap items-end gap-3">
                <label class="min-w-[220px] flex-1">
                  <span class="block text-xs font-medium text-slate-600">Link to a QC Finding</span>
                  <select
                    name="finding_id"
                    required
                    disabled={findingLinkOptions.length === 0}
                    class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm"
                  >
                    {findingLinkOptions.length === 0 ? (
                      <option value="">No findings available to link</option>
                    ) : (
                      <>
                        <option value="" disabled>Select a finding…</option>
                        {findingLinkOptions.map((opt) => (
                          <option value={opt.id}>{opt.finding_number} — {opt.classification} · {opt.status}</option>
                        ))}
                      </>
                    )}
                  </select>
                </label>
                <label class="min-w-[220px] flex-1">
                  <span class="block text-xs font-medium text-slate-600">Note (optional)</span>
                  <input
                    type="text"
                    name="note"
                    maxlength="5000"
                    class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm"
                  />
                </label>
                <button
                  type="submit"
                  disabled={findingLinkOptions.length === 0}
                  class="rounded-md bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700"
                >
                  Link Finding
                </button>
              </div>
            </form>
          )}

          {view.relatedQuality.length > 0 && (
            <div class="mt-4">
              <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">Link activity</h3>
              <ol class="mt-2 space-y-2">
                {view.relatedQuality.map((e) => (
                  <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xs text-slate-500">
                    <span class="font-semibold text-slate-700">{String(e.action)}</span>
                    <span>{String(e.note ?? '')}</span>
                    <span>{String(e.actor_name ?? 'System')} · {String(e.created_at)}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </section>

        {/* 17. Authorization */}
        <section aria-label="Authorization" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Authorization</h2>
          <dl class="mt-3 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
            <div><dt class="text-xs font-medium text-slate-500">Tested By</dt><dd class="mt-0.5 text-sm text-slate-900">{actor(record.tester_name)}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Reviewed By</dt><dd class="mt-0.5 text-sm text-slate-900">{actor(record.reviewer_name)} {record.reviewed_at ? <span class="text-slate-500">· {String(record.reviewed_at)}</span> : ''}</dd></div>
            <div><dt class="text-xs font-medium text-slate-500">Approved By (Q.C.M.)</dt><dd class="mt-0.5 text-sm text-slate-900">{actor(record.approver_name)} {record.approved_at ? <span class="text-slate-500">· {String(record.approved_at)}</span> : ''}</dd></div>
          </dl>
        </section>

        {/* 18. Audit Timeline */}
        <section aria-label="Audit timeline" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Audit Timeline</h2>
          {view.timeline.length === 0 ? (
            <p class="mt-3 text-sm text-slate-500">No recorded activity.</p>
          ) : (
            <ol class="mt-3 space-y-3">
              {view.timeline.map((e) => (
                <li class="border-s-2 border-brand-100 ps-3 text-sm">
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span class="font-mono text-xs text-slate-400">{String(e.created_at)}</span>
                    <span class="font-semibold text-slate-900">{String(e.action)}</span>
                    {(e.old_value !== null && e.old_value !== undefined) || (e.new_value !== null && e.new_value !== undefined) ? (
                      <span class="flex flex-wrap items-center gap-1">
                        <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-mono text-xs text-slate-700">{String(e.old_value ?? '—')}</span>
                        <span aria-hidden="true" class="text-slate-400">→</span>
                        <span class="inline-flex items-center rounded-md border border-brand-100 bg-brand-50 px-1.5 py-0.5 font-mono text-xs text-brand-800">{String(e.new_value ?? '—')}</span>
                      </span>
                    ) : null}
                    <span class="text-xs text-slate-400">{String(e.actor_name ?? 'System')}</span>
                  </div>
                  {e.note ? <p class="mt-1 text-slate-600"><span class="text-xs font-medium uppercase tracking-wide text-slate-400">Reason / details</span> <span class="ms-1">{String(e.note)}</span></p> : null}
                </li>
              ))}
            </ol>
          )}
        </section>

        <div class="flex flex-wrap items-center gap-3">
          <a href="/lab/tests" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">← Back to the register</a>
          <a href={`/lab/tests/${String(record.id)}/print`} class="rounded-lg border border-brand-600 bg-white px-4 py-2 text-sm font-medium text-brand-700 shadow-sm hover:bg-brand-50">Print</a>
          {!immutable && (
            <p class="text-sm text-slate-500">Workflow actions (edit, review, approve, retest) are coming with the review/approve module.</p>
          )}
        </div>

        <section class="mt-6 space-y-4" aria-label="AI assistance (advisory only)">
          <AiReviewPanel feature="lab-test-summary" requestBody={{ id: recordId }} title="AI Test Summary" client:visible />
          <AiReviewPanel feature="lab-missing-fields" requestBody={{ id: recordId }} title="AI Missing-Fields Check" client:visible />
          <AiReviewPanel feature="lab-sop-comparison" requestBody={{ id: recordId }} title="AI SOP/WI Comparison" client:visible />
          {canReviewLabTest(role) && (
            <AiReviewPanel feature="lab-review-questions" requestBody={{ id: recordId }} title="AI Review Questions" client:visible />
          )}
        </section>
      </>
    ) : null}
  </div>
</BaseLayout>