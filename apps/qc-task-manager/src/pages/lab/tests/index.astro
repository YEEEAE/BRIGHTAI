---
// /lab/tests — QC Laboratory Test Register (PROMPT 06).
//
// Central searchable register of all laboratory tests. Server-side search,
// filters, safe sorting and pagination all live in src/lib/lab/testSearch.ts
// (a faithful mirror of src/lib/taskSearch.ts): the URL is the source of
// truth, every SQL value is a bound parameter, and sorting is constrained to
// a whitelisted union (no injection).
//
// RBAC: employees see only tests they tested or created; supervisor/manager/
// admin see the full register. The register is read-only here — no workflow
// mutations. Row actions (Edit/Submit/Review/Approve) render only when the
// requesting user actually holds that authority for the row (via the
// can*LabTestRecord predicates); APPROVED and VOID records are immutable and
// show no mutable actions (visually read-only). Targets whose pages are not
// implemented yet render as disabled affordances with a hint — never a dead
// link (same pattern as /lab). View opens the read-only details page, which
// IS implemented. Export (CSV/XLSX) is shown only when the user may export.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import StatusPill from '../../../components/ui/StatusPill.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import LabSaveViewForm from '../../../components/lab/LabSaveViewForm.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import {
  hasLabTestFilters,
  LAB_TEST_STATUSES,
  LAB_TEST_STATUS_LABELS,
  labTestFiltersToQuery,
  parseLabTestSearchFilters,
  searchLabTests,
  listLabTesters,
  listLabTestEquipment,
  listLabTestProducts,
  LAB_TEST_PER_PAGE_OPTIONS,
  type LabTestSearchFilters,
  type LabTestSortField,
} from '../../../lib/lab/testSearch';
import { LAB_RESULT_OPTIONS, LAB_RESULT_LABELS, isLabTestRecordImmutable } from '../../../lib/lab/policy';
import {
  canApproveLabTestRecord,
  canCreateLabTest,
  canEditLabTestRecord,
  canExportLabData,
  canReviewLabTestRecord,
  canSubmitLabTestRecord,
} from '../../../lib/permissions';
import { canViewLabReports } from '../../../lib/permissions';
import AiReviewPanel from '../../../components/AiReviewPanel';
import type { Role } from '../../../lib/types';
import Banner from '../../../components/ui/Banner.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { FILTER_TOOLBAR, FILTER_FIELD, FILTER_CONTROL } from '../../../components/ui/formPresets';
import AppButton from '../../../components/ui/AppButton.astro';

const user = Astro.locals.user!;
const role = user.role as Role;
const userId = user.userId;

const navItems = labNavForRole(role);

const filters: LabTestSearchFilters = parseLabTestSearchFilters(Astro.url, Astro);

let dataError: string | null = null;
let result: { rows: Awaited<ReturnType<typeof searchLabTests>>['rows']; total: number; page: number; per_page: number; total_pages: number } = { rows: [], total: 0, page: 1, per_page: 25, total_pages: 1 };
let testers: { id: number; full_name: string }[] = [];
let equipmentOptions: { id: number; name: string; code: string }[] = [];
let productOptions: { id: number; name: string; code: string }[] = [];
try {
  result = await searchLabTests(filters, { role, userId });
  [testers, equipmentOptions, productOptions] = await Promise.all([
    listLabTesters(),
    listLabTestEquipment(),
    listLabTestProducts(),
  ]);
} catch (err) {
  console.error('[lab] test register query failure', err);
  dataError = 'Could not load the test register. Try reloading — if the problem persists, contact an administrator.';
}

const filtered = hasLabTestFilters(filters);

// Query-string helpers (pattern from /search).
const qsParams = new URLSearchParams(labTestFiltersToQuery({ ...filters, page: 1 }).replace(/^\?/, ''));

function pageHref(p: number): string {
  const sp = new URLSearchParams(qsParams);
  if (p > 1) sp.set('page', String(p));
  else sp.delete('page');
  const qs = sp.toString();
  return qs ? `/lab/tests?${qs}` : '/lab/tests';
}

function sortHref(field: LabTestSortField): string {
  const next: LabTestSearchFilters = {
    ...filters,
    sort: field,
    dir: (filters.sort === field && filters.dir === 'asc' ? 'desc' : 'asc') as 'asc' | 'desc',
    page: 1,
  };
  return `/lab/tests${labTestFiltersToQuery(next)}`;
}

function sortArrow(field: LabTestSortField): string {
  if (filters.sort !== field) return '';
  return filters.dir === 'asc' ? ' ▲' : ' ▼';
}

const SORTABLE: { field: LabTestSortField; label: string }[] = [
  { field: 'test_number', label: 'Test ID' },
  { field: 'test_type', label: 'Type' },
  { field: 'product', label: 'Product' },
  { field: 'lot', label: 'Lot' },
  { field: 'sampling_area', label: 'Sampling Area' },
  { field: 'equipment', label: 'Equipment' },
  { field: 'tester', label: 'Tester' },
  { field: 'result', label: 'Result' },
  { field: 'status', label: 'Workflow Status' },
  { field: 'created_at', label: 'Created' },
  { field: 'updated_at', label: 'Updated' },
];

function th(field: LabTestSortField, label: string): string {
  return `<a href="${sortHref(field)}" class="inline-flex items-center gap-1 hover:text-slate-900">${label}${sortArrow(field)}</a>`;
}


const resultTone: Record<string, string> = { PASS: 'text-emerald-700', FAIL: 'text-red-700', HOLD: 'text-orange-700' };

// True when the view/details route is implemented (it is — this prompt).
const viewEnabled = true;

function actionCell(row: Awaited<ReturnType<typeof searchLabTests>>['rows'][number]): string {
  const test = { status: row.status as never, tested_by: null as number | null, reviewed_by: null as number | null, created_by: 0 };
  // We cannot know tested_by/created_by from the joined register row alone, so
  // the mutable actions are gated by ROLE + STATUS only here. The authoritative
  // per-record decisions (own-test, self-review) live in the details page and
  // the future workflow handlers, which re-check against the full record.
  const view = viewEnabled
    ? `<a href="/lab/tests/${row.id}" class="font-medium text-brand-600 hover:underline">View</a>`
    : `<span class="text-slate-500" title="Coming with the Tests module">View</span>`;
  const immutable = isLabTestRecordImmutable(String(row.status));
  if (immutable) {
    return `<span class="flex items-center gap-2">${view}<span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">Read-only</span></span>`;
  }
  const canEdit = canEditLabTestRecord({ id: userId, role }, test);
  const canSubmit = canSubmitLabTestRecord({ id: userId, role }, test);
  const canReview = canReviewLabTestRecord({ id: userId, role }, test);
  const canApprove = canApproveLabTestRecord({ id: userId, role }, test);
  const hint = 'Workflow actions land with the review/approve module.';
  const parts: string[] = [];
  if (canEdit) parts.push(`<button type="button" disabled title="${hint}" class="cursor-not-allowed text-xs font-medium text-slate-500">Edit</button>`);
  if (canSubmit) parts.push(`<button type="button" disabled title="${hint}" class="cursor-not-allowed text-xs font-medium text-slate-500">Submit test</button>`);
  if (canReview) parts.push(`<button type="button" disabled title="${hint}" class="cursor-not-allowed text-xs font-medium text-slate-500">Review</button>`);
  if (canApprove) parts.push(`<button type="button" disabled title="${hint}" class="cursor-not-allowed text-xs font-medium text-slate-500">Approve test</button>`);
  const actions = parts.length ? parts.join('') : '';
  return `<span class="flex items-center gap-2">${view}${actions}</span>`;
}
---

<BaseLayout title="Laboratory Test Register">
  <div class="min-w-0 max-w-full space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Tests' },
      ]}
    />

    <PageHeader eyebrow="QC Laboratory — Testing" title="Laboratory Test Register" description="Searchable register of all AIR and VACUUM laboratory tests. Results are human decisions; approved and voided tests are read-only quality records.">
      <fragment slot="actions">
        {canExportLabData(role) && (
        <div class="flex flex-wrap gap-2" role="group" aria-label="Export the test register">
        <a href={`/api/lab/tests/export.csv${labTestFiltersToQuery({ ...filters, page: 1 })}`} class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">Export CSV</a>
        <a href={`/api/lab/tests/export.xlsx${labTestFiltersToQuery({ ...filters, page: 1 })}`} class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">Export XLSX</a>
        </div>
        )}
        {canCreateLabTest(role) && (
          <div class="flex flex-wrap gap-2" role="group" aria-label="Create a new test">
            <AppButton href="/lab/tests/new?type=air" variant="primary">New AIR Test</AppButton>
            <AppButton href="/lab/tests/new?type=vacuum" variant="secondary">New VACUUM Test</AppButton>
          </div>
        )}
      </fragment>
    </PageHeader>

    <LabSecondaryNav items={navItems} currentPath="/lab/tests" />

    {dataError && (
      <Banner tone="error">{dataError}</Banner>
    )}

    {!dataError && (
      <>
        {/* Search + filter toolbar */}
        <form method="get" action="/lab/tests" class={FILTER_TOOLBAR}>
          <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            <label class={FILTER_FIELD}>
              Search
              <input
                type="search"
                name="q"
                value={filters.q ?? ''}
                placeholder="Test ID, product, lot, equipment, tester…"
                class={FILTER_CONTROL}
              />
            </label>
            <label class={FILTER_FIELD}>
              Type
              <select name="type" class={FILTER_CONTROL}>
                <option value="">All types</option>
                <option value="air" selected={filters.test_type === 'air'}>AIR</option>
                <option value="vacuum" selected={filters.test_type === 'vacuum'}>VACUUM</option>
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Workflow Status
              <select name="status" class={FILTER_CONTROL}>
                <option value="">All statuses</option>
                {LAB_TEST_STATUSES.map((s) => (
                  <option value={s} selected={filters.status === s}>{LAB_TEST_STATUS_LABELS[s]}</option>
                ))}
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Result
              <select name="result" class={FILTER_CONTROL}>
                <option value="">All results</option>
                {LAB_RESULT_OPTIONS.map((r) => (
                  <option value={r} selected={filters.result === r}>{LAB_RESULT_LABELS[r]}</option>
                ))}
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Tester
              <select name="tester" class={FILTER_CONTROL}>
                <option value="">All testers</option>
                {testers.map((t) => (
                  <option value={t.id} selected={filters.tester_id === t.id}>{t.full_name}</option>
                ))}
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Equipment
              <select name="equipment" class={FILTER_CONTROL}>
                <option value="">All equipment</option>
                {equipmentOptions.map((e) => (
                  <option value={e.id} selected={filters.equipment_id === e.id}>{e.name} ({e.code})</option>
                ))}
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Product
              <select name="product" class={FILTER_CONTROL}>
                <option value="">All products</option>
                {productOptions.map((p) => (
                  <option value={p.id} selected={filters.product_id === p.id}>{p.name} ({p.code})</option>
                ))}
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Lot Number
              <input
                type="text"
                name="lot"
                value={filters.lot ?? ''}
                placeholder="e.g. LOT-0001"
                class={FILTER_CONTROL}
              />
            </label>
            <label class={FILTER_FIELD}>
              Created
              <select name="created" class={FILTER_CONTROL}>
                <option value="">Any date</option>
                <option value="today" selected={filters.created === 'today'}>Today</option>
                <option value="week" selected={filters.created === 'week'}>This Week</option>
              </select>
            </label>
            <label class={FILTER_FIELD}>
              From
              <input type="date" name="from" value={filters.created_from ?? ''} class={FILTER_CONTROL} />
            </label>
            <label class={FILTER_FIELD}>
              To
              <input type="date" name="to" value={filters.created_to ?? ''} class={FILTER_CONTROL} />
            </label>
            <label class={FILTER_FIELD}>
              Per page
              <select name="per" class={FILTER_CONTROL}>
                {LAB_TEST_PER_PAGE_OPTIONS.map((n) => (
                  <option value={n} selected={filters.per_page === n}>{n} per page</option>
                ))}
              </select>
            </label>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <AppButton type="submit" variant="primary">Apply filters</AppButton>
            {filtered && <AppButton href="/lab/tests" variant="secondary">Clear filters</AppButton>}
          </div>
        </form>

        <LabSaveViewForm path="/lab/tests" />

        {/* Result summary */}
        <p class="text-sm text-slate-600">
          {result.total.toLocaleString('en-US')} test{result.total === 1 ? '' : 's'} found
          {filtered && <span> (filtered — <a href="/lab/tests" class="text-brand-600 hover:underline">clear all</a>)</span>}
        </p>

        {/* Results table */}
        {result.rows.length === 0 ? (
          <EmptyState
            title={filtered ? 'No tests match your search' : 'No tests recorded yet'}
            hint={filtered ? 'Try adjusting the search or clearing the filters.' : 'Record the first AIR or VACUUM test from the New Test buttons above.'}
            ctaHref={filtered ? '/lab/tests' : '/lab/tests/new?type=air'}
            ctaLabel={filtered ? 'Clear filters' : 'New AIR Test'}
          />
        ) : (
          <section aria-label="Test register" class="qc-table-panel min-w-0 max-w-full">
            <div class="min-w-0 max-w-full overflow-x-auto contain-layout contain-paint">
              <table class="min-w-[1080px] divide-y divide-slate-100 text-sm">
                <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    {SORTABLE.map((s) => (
                      <th scope="col" class="px-4 py-2.5 font-semibold" set:html={th(s.field, s.label)} />
                    ))}
                    <th scope="col" class="px-4 py-2.5 font-semibold"><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {result.rows.map((t) => (
                    <tr class="align-middle">
                      <td class="px-4 py-2 font-medium text-slate-900">{t.test_number}</td>
                      <td class="px-4 py-2 uppercase text-slate-600">{t.test_type}</td>
                      <td class="px-4 py-2 text-slate-700">{t.product_name ?? '—'}</td>
                      <td class="px-4 py-2 text-slate-700">{t.lot_number ?? '—'}</td>
                      <td class="px-4 py-2 text-slate-700">{t.sampling_area ?? '—'}</td>
                      <td class="px-4 py-2 text-slate-700">{t.equipment_code ?? t.equipment_name ?? '—'}</td>
                      <td class="px-4 py-2 text-slate-700">{t.tester_name ?? '—'}</td>
                      <td class={`px-4 py-2 font-semibold ${t.final_result ? resultTone[t.final_result] ?? 'text-slate-500' : 'text-slate-500'}`}>{t.final_result ?? '—'}</td>
                      <td class="px-4 py-2">
                        <StatusPill status={t.status} dot />
                      </td>
                      <td class="px-4 py-2 text-slate-500">{t.created_at}</td>
                      <td class="px-4 py-2 text-slate-500">{t.updated_at}</td>
                      <td class="px-4 py-2" set:html={actionCell(t)} />
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {/* Pagination */}
        <Pagination page={result.page} totalPages={result.total_pages} hrefFor={pageHref} />
        {canViewLabReports(role) && (
          <AiReviewPanel feature="lab-fail-patterns" requestBody={{}} title="AI FAIL Patterns" client:visible />
        )}
      </>
    )}
  </div>
</BaseLayout>
