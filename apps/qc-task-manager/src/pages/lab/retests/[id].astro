---
// /lab/retests/[id] — one controlled retest (§46–§47): the preserved original
// test snapshot (frozen result + final state at creation), the documented
// reason, the relationship to the new execution test, and the retest audit
// trail (creation + completion) from the shared qc_audit_log, newest first.
// Read-only for every role.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import { getLabRetestDetail, LAB_RETEST_REASON_LABELS } from '../../../lib/lab/retests';
import type { Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;
const scope = { role, userId: user.userId };
const navItems = labNavForRole(role);

const id = Number(Astro.params.id);
let detail: ReturnType<typeof getLabRetestDetail> = null;
try {
  detail = getLabRetestDetail(id, scope);
} catch (err) {
  console.error('[lab] retest detail query failure', err);
}

const sectionCls = 'rounded-xl border border-slate-200 bg-white p-5 shadow-sm';
const sectionTitleCls = 'text-base font-semibold text-slate-900';

function fmt(value: unknown): string {
  return value == null || String(value).trim() === '' ? '—' : String(value);
}

const r = detail?.retest;
const reasonLabel = r ? (LAB_RETEST_REASON_LABELS[r.reason as keyof typeof LAB_RETEST_REASON_LABELS] ?? r.reason) : '';
const RETEST_STATUS_BADGE: Record<string, string> = {
  OPEN: 'bg-amber-100 text-amber-800',
  COMPLETED: 'bg-emerald-100 text-emerald-800',
};
const badgeCls = r ? (RETEST_STATUS_BADGE[r.status] ?? 'bg-slate-100 text-slate-700') : '';
---

<BaseLayout title={r ? `Retest ${r.retest_number}` : 'Retest not found'}>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Retests', href: '/lab/retests' },
        ...(r ? [{ label: r.retest_number }] : []),
      ]}
    />

    {!r ? (
      <EmptyState
        title="Retest not found"
        hint="This retest does not exist — it may have been removed, or the link is stale."
        ctaHref="/lab/retests"
        ctaLabel="Back to the Retest Register"
      />
    ) : (
      <>
        <header class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Testing</p>
            <h1 class="mt-1 text-3xl font-semibold text-slate-900" dir="ltr">{r.retest_number}</h1>
            <p class="mt-1 max-w-3xl text-sm text-slate-600">
              Controlled retest of <a href={`/lab/tests/${r.original_test_id}`} class="font-medium text-brand-600 hover:underline" dir="ltr">{fmt(r.original_test_number)}</a>.
              The original test was never modified by this retest.
            </p>
          </div>
          <span class={`inline-flex rounded-full px-3 py-1.5 text-sm font-semibold ${badgeCls}`}>{r.status}</span>
        </header>

        <LabSecondaryNav items={navItems} currentPath="/lab/retests/[id]" />

        <section class={sectionCls}>
          <h2 class={sectionTitleCls}>Retest Record</h2>
          <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
            <div><dt class="font-medium text-slate-500">Retest Number</dt><dd class="mt-0.5 text-slate-900" dir="ltr">{r.retest_number}</dd></div>
            <div><dt class="font-medium text-slate-500">Reason</dt><dd class="mt-0.5 text-slate-900">{reasonLabel}</dd></div>
            <div><dt class="font-medium text-slate-500">Reason Note</dt><dd class="mt-0.5 text-slate-900">{fmt(r.reason_note)}</dd></div>
            <div><dt class="font-medium text-slate-500">Status</dt><dd class="mt-0.5 text-slate-900">{r.status}</dd></div>
            <div><dt class="font-medium text-slate-500">Created By</dt><dd class="mt-0.5 text-slate-900">{fmt(r.created_by_name)}</dd></div>
            <div><dt class="font-medium text-slate-500">Created At</dt><dd class="mt-0.5 text-slate-900" dir="ltr">{r.created_at}</dd></div>
            <div><dt class="font-medium text-slate-500">Updated At</dt><dd class="mt-0.5 text-slate-900" dir="ltr">{r.updated_at}</dd></div>
          </dl>
        </section>

        <section class={sectionCls}>
          <h2 class={sectionTitleCls}>Original Test (preserved at retest creation)</h2>
          <p class="mt-1 text-sm text-slate-600">
            These values are frozen on the retest record when it is created — they stay truthful even if the original test's
            workflow state changes later.
          </p>
          <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
            <div><dt class="font-medium text-slate-500">Original Test ID</dt><dd class="mt-0.5"><a href={`/lab/tests/${r.original_test_id}`} class="font-medium text-brand-600 hover:underline" dir="ltr">{fmt(r.original_test_number)}</a></dd></div>
            <div><dt class="font-medium text-slate-500">Original Final State</dt><dd class="mt-0.5 text-slate-900">{fmt(r.original_status)}</dd></div>
            <div><dt class="font-medium text-slate-500">Original Result</dt><dd class="mt-0.5 text-slate-900">{fmt(r.original_result)}</dd></div>
            <div><dt class="font-medium text-slate-500">Original Type</dt><dd class="mt-0.5 text-slate-900">{fmt(detail?.original_type)}</dd></div>
            <div><dt class="font-medium text-slate-500">Original Lot Number</dt><dd class="mt-0.5 text-slate-900" dir="ltr">{fmt(detail?.original_lot)}</dd></div>
            <div><dt class="font-medium text-slate-500">Original Sampling Area</dt><dd class="mt-0.5 text-slate-900">{fmt(detail?.original_sampling_area)}</dd></div>
          </dl>
        </section>

        <section class={sectionCls}>
          <h2 class={sectionTitleCls}>New Execution Test (relationship)</h2>
          <p class="mt-1 text-sm text-slate-600">
            The retest is performed on this new test record — it carries the original's controlled context, follows the normal
            review workflow, and completes the retest when approved.
          </p>
          {r.new_test_id ? (
            <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
              <div><dt class="font-medium text-slate-500">New Test ID</dt><dd class="mt-0.5"><a href={`/lab/tests/${r.new_test_id}`} class="font-medium text-brand-600 hover:underline" dir="ltr">{fmt(r.new_test_number)}</a></dd></div>
              <div><dt class="font-medium text-slate-500">New Test Status</dt><dd class="mt-0.5 text-slate-900">{fmt(r.new_test_status)}</dd></div>
              <div><dt class="font-medium text-slate-500">New Test Final Result</dt><dd class="mt-0.5 text-slate-900">{fmt(r.new_test_result)}</dd></div>
            </dl>
          ) : (
            <p class="mt-3 text-sm text-slate-500">No execution record is linked yet.</p>
          )}
        </section>

        <section class={sectionCls}>
          <h2 class={sectionTitleCls}>Retest Audit Trail</h2>
          <p class="mt-1 text-sm text-slate-600">Every retest creation and completion is audited (shared qc_audit_log, newest first).</p>
          <div class="mt-3 overflow-x-auto contain-layout contain-paint">
            <table class="min-w-[640px] divide-y divide-slate-100 text-sm">
              <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                <tr>
                  <th scope="col" class="px-4 py-2.5 font-semibold">When</th>
                  <th scope="col" class="px-4 py-2.5 font-semibold">Actor</th>
                  <th scope="col" class="px-4 py-2.5 font-semibold">Action</th>
                  <th scope="col" class="px-4 py-2.5 font-semibold">Note</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {detail?.audit.map((a) => (
                  <tr>
                    <td class="px-4 py-2 whitespace-nowrap text-slate-500" dir="ltr">{String(a.created_at)}</td>
                    <td class="px-4 py-2 text-slate-700">{fmt(a.actor_name)}</td>
                    <td class="px-4 py-2 font-medium text-slate-700" dir="ltr">{String(a.action)}</td>
                    <td class="px-4 py-2 max-w-[420px] break-words text-slate-600" dir="ltr">{fmt(a.note)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </>
    )}
  </div>
</BaseLayout>
