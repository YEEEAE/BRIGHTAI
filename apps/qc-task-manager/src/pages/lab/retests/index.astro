---
// /lab/retests — QC Laboratory Retest Register (§46–§47).
//
// Controlled repeat testing: every row preserves the ORIGINAL test (number,
// result and final state frozen at creation — migration 019), the documented
// reason, the relationship to the new execution test, and the retest status
// (OPEN at creation, COMPLETED when the new test is approved). The original
// test is never modified by a retest. Server-side search, safe sorting and
// pagination live in src/lib/lab/retests.ts — the URL is the source of truth,
// every SQL value is a bound parameter, and sorting is a whitelisted union.
// All roles may view (canViewLabRetests); supervisor+ create (canCreateLabRetest).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import LabSaveViewForm from '../../../components/lab/LabSaveViewForm.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import {
  hasLabRetestFilters,
  labRetestFiltersToQuery,
  parseLabRetestSearchFilters,
  searchLabRetests,
  LAB_RETEST_PER_PAGE_OPTIONS,
  LAB_RETEST_REASON_LABELS,
  LAB_RETEST_REASONS,
  LAB_RETEST_STATUSES,
  type LabRetestSearchFilters,
  type LabRetestSortField,
} from '../../../lib/lab/retests';
import type { Role } from '../../../lib/types';
import AiReviewPanel from '../../../components/AiReviewPanel';
import Banner from '../../../components/ui/Banner.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import { FILTER_TOOLBAR, FILTER_FIELD, FILTER_CONTROL } from '../../../components/ui/formPresets';
import AppButton from '../../../components/ui/AppButton.astro';

const user = Astro.locals.user!;
const role = user.role as Role;
const scope = { role, userId: user.userId };

const navItems = labNavForRole(role);
const filters: LabRetestSearchFilters = parseLabRetestSearchFilters(Astro.url);

let dataError: string | null = null;
let result: ReturnType<typeof searchLabRetests> = {
  rows: [],
  total: 0,
  page: 1,
  per_page: 25,
  total_pages: 1,
};
try {
  result = searchLabRetests(filters, scope);
} catch (err) {
  console.error('[lab] retest register query failure', err);
  dataError = 'Could not load the Retest Register. Try reloading — if the problem persists, contact an administrator.';
}

const filtered = hasLabRetestFilters(filters);

const qsParams = new URLSearchParams(labRetestFiltersToQuery({ ...filters, page: 1 }).replace(/^\?/, ''));

function pageHref(p: number): string {
  const sp = new URLSearchParams(qsParams);
  if (p > 1) sp.set('page', String(p));
  else sp.delete('page');
  const qs = sp.toString();
  return qs ? `/lab/retests?${qs}` : '/lab/retests';
}

function sortHref(field: LabRetestSortField): string {
  const next: LabRetestSearchFilters = {
    ...filters,
    sort: field,
    dir: (filters.sort === field && filters.dir === 'asc' ? 'desc' : 'asc') as 'asc' | 'desc',
    page: 1,
  };
  return `/lab/retests${labRetestFiltersToQuery(next)}`;
}

function sortArrow(field: LabRetestSortField): string {
  if (filters.sort !== field) return '';
  return filters.dir === 'asc' ? ' ▲' : ' ▼';
}

const SORTABLE: { field: LabRetestSortField; label: string }[] = [
  { field: 'retest_number', label: 'Retest' },
  { field: 'original_test', label: 'Original Test' },
  { field: 'reason', label: 'Reason' },
  { field: 'status', label: 'Status' },
];

function th(field: LabRetestSortField, label: string): string {
  return `<a href="${sortHref(field)}" class="inline-flex items-center gap-1 hover:text-slate-900">${label}${sortArrow(field)}</a>`;
}


const RETEST_STATUS_BADGE: Record<string, string> = {
  OPEN: 'bg-amber-100 text-amber-800',
  COMPLETED: 'bg-emerald-100 text-emerald-800',
};

function statusBadge(status: string): string {
  const cls = RETEST_STATUS_BADGE[status] ?? 'bg-slate-100 text-slate-700';
  return `<span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${cls}">${status}</span>`;
}

function reasonLabel(reason: string): string {
  return LAB_RETEST_REASON_LABELS[reason as keyof typeof LAB_RETEST_REASON_LABELS] ?? reason;
}

function fmt(value: unknown): string {
  return value == null || String(value).trim() === '' ? '—' : String(value);
}
---

<BaseLayout title="Retest Register">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Retests' },
      ]}
    />

    <PageHeader eyebrow="QC Laboratory — Testing" title="Retest Register" description="Controlled repeat testing. Each retest preserves the original test, the documented reason, and the relationship to the new execution record — the original test is never modified. A retest completes when its new test is approved." />

    <LabSecondaryNav items={navItems} currentPath="/lab/retests" />

    {dataError && (
      <Banner tone="error">{dataError}</Banner>
    )}

    {!dataError && (
      <>
        <form method="get" action="/lab/retests" class={FILTER_TOOLBAR}>
          <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
            <label class={FILTER_FIELD}>
              Search
              <input
                type="search"
                name="q"
                value={filters.q ?? ''}
                placeholder="Retest number, original test number, product…"
                class={FILTER_CONTROL}
              />
            </label>
            <label class={FILTER_FIELD}>
              Reason
              <select name="reason" class={FILTER_CONTROL}>
                <option value="">All reasons</option>
                {LAB_RETEST_REASONS.map((r) => (
                  <option value={r} selected={filters.reason === r}>{reasonLabel(r)}</option>
                ))}
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Status
              <select name="status" class={FILTER_CONTROL}>
                <option value="">All statuses</option>
                {LAB_RETEST_STATUSES.map((s) => (
                  <option value={s} selected={filters.status === s}>{s}</option>
                ))}
              </select>
            </label>
            <label class={FILTER_FIELD}>
              Per page
              <select name="per" class={FILTER_CONTROL}>
                {LAB_RETEST_PER_PAGE_OPTIONS.map((n) => (
                  <option value={n} selected={filters.per_page === n}>{n} per page</option>
                ))}
              </select>
            </label>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <AppButton type="submit" variant="primary">Apply filters</AppButton>
            <AppButton href="/lab/retests" variant="secondary">Clear filters</AppButton>
          </div>
        </form>

        <LabSaveViewForm path="/lab/retests" />

        <p class="text-sm text-slate-600">
          {result.total.toLocaleString('en-US')} retest{result.total === 1 ? '' : 's'} found
          {filtered && <span> (filtered — <a href="/lab/retests" class="text-brand-600 hover:underline">clear all</a>)</span>}
        </p>

        {result.rows.length === 0 ? (
          <EmptyState
            title={filtered ? 'No retests match your search' : 'No retests yet'}
            hint={filtered ? 'Try adjusting the search or clearing the filters.' : 'Retests appear here when a supervisor creates a controlled retest from a dispositioned test.'}
            ctaHref={filtered ? '/lab/retests' : '/lab/tests'}
            ctaLabel={filtered ? 'Clear filters' : 'Open the Test Register'}
          />
        ) : (
          <section aria-label="Retest Register" class="rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto contain-layout contain-paint">
              <table class="min-w-[1100px] divide-y divide-slate-100 text-sm">
                <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    {SORTABLE.map((s) => (
                      <th scope="col" class="px-4 py-2.5 font-semibold" set:html={th(s.field, s.label)} />
                    ))}
                    <th scope="col" class="px-4 py-2.5 font-semibold">Product</th>
                    <th scope="col" class="px-4 py-2.5 font-semibold">Original Result</th>
                    <th scope="col" class="px-4 py-2.5 font-semibold">New Test</th>
                    <th scope="col" class="px-4 py-2.5 font-semibold" set:html={th('updated_at', 'Updated')} />
                    <th scope="col" class="px-4 py-2.5 font-semibold"><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {result.rows.map((r) => (
                    <tr class="align-middle">
                      <td class="px-4 py-2 whitespace-nowrap">
                        <a href={`/lab/retests/${r.id}`} class="font-medium text-brand-600 hover:underline" dir="ltr">{r.retest_number}</a>
                        <div class="text-xs text-slate-500">by {fmt(r.created_by_name)}</div>
                      </td>
                      <td class="px-4 py-2 whitespace-nowrap">
                        <a href={`/lab/tests/${r.original_test_id}`} class="font-medium text-slate-700 hover:underline" dir="ltr">{fmt(r.original_test_number)}</a>
                        <div class="text-xs text-slate-500">{fmt(r.original_status ?? r.original_test_status)}</div>
                      </td>
                      <td class="px-4 py-2">
                        <span class="font-medium text-slate-700">{reasonLabel(r.reason)}</span>
                        {r.reason_note && <div class="max-w-[220px] truncate text-xs text-slate-500" title={r.reason_note}>{r.reason_note}</div>}
                      </td>
                      <td class="px-4 py-2" set:html={statusBadge(r.status)} />
                      <td class="px-4 py-2 text-slate-500">{fmt(r.product_name)}</td>
                      <td class="px-4 py-2 whitespace-nowrap text-slate-700" dir="ltr">{fmt(r.original_result)}</td>
                      <td class="px-4 py-2 whitespace-nowrap">
                        {r.new_test_id ? (
                          <a href={`/lab/tests/${r.new_test_id}`} class="font-medium text-brand-600 hover:underline" dir="ltr">{fmt(r.new_test_number)}</a>
                        ) : (
                          <span class="text-slate-400">—</span>
                        )}
                        {r.new_test_id && <div class="text-xs text-slate-500">{fmt(r.new_test_status)}{r.new_test_result ? ` · ${r.new_test_result}` : ''}</div>}
                      </td>
                      <td class="px-4 py-2 whitespace-nowrap text-slate-500" dir="ltr">{r.updated_at.slice(0, 10)}</td>
                      <td class="px-4 py-2">
                        <a href={`/lab/retests/${r.id}`} class="font-medium text-brand-600 hover:underline">View</a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <Pagination page={result.page} totalPages={result.total_pages} hrefFor={pageHref} />

        <AiReviewPanel feature="lab-retest-patterns" requestBody={{}} title="AI Retest Patterns" client:visible />
      </>
    )}
  </div>
</BaseLayout>
