---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import { getChangeRequestForViewer } from '../../../lib/lab/changeRequests';
import { canApproveLabChangeRequest } from '../../../lib/permissions';
import type { Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;
const id = Number(Astro.params.id);
const request = Number.isInteger(id) && id > 0 ? getChangeRequestForViewer(id, { id: user.userId, role }) : null;
if (!request) return Astro.redirect('/lab/change-requests');
const pretty = (value: string | null) => { try { return JSON.stringify(JSON.parse(value ?? 'null'), null, 2); } catch { return value ?? '—'; } };
const mayReview = request.status === 'PENDING' && canApproveLabChangeRequest({ id: user.userId, role }, request);
---
<BaseLayout title={`Change Request CR-${request.id}`}>
  <div class="space-y-6"><Breadcrumbs items={[{ label: 'QC Tasks' }, { label: 'Laboratory', href: '/lab' }, { label: 'Change Requests', href: '/lab/change-requests' }, { label: `CR-${request.id}` }]} /><LabSecondaryNav items={labNavForRole(role)} currentPath="/lab/change-requests" />
    <header><p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Laboratory governance</p><h1 class="mt-1 text-3xl font-semibold text-slate-900">Change Request CR-{request.id}</h1><p class="mt-1 text-sm text-slate-600">{request.operation} · {request.entity_type} · requested by {request.requested_by_name ?? `User #${request.requested_by}`}</p></header>
    <section class="grid gap-4 lg:grid-cols-2"><div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-semibold text-slate-900">Base snapshot</h2><pre class="mt-3 max-h-96 overflow-auto rounded-lg bg-slate-50 p-3 text-xs text-slate-700">{pretty(request.base_snapshot_json)}</pre></div><div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-semibold text-slate-900">Proposed snapshot</h2><pre class="mt-3 max-h-96 overflow-auto rounded-lg bg-slate-50 p-3 text-xs text-slate-700">{pretty(request.proposed_snapshot_json)}</pre></div></section>
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><dl class="grid gap-3 text-sm sm:grid-cols-3"><div><dt class="text-slate-500">Status</dt><dd class="font-semibold text-slate-900">{request.status}</dd></div><div><dt class="text-slate-500">Created</dt><dd class="font-semibold text-slate-900">{request.created_at}</dd></div><div><dt class="text-slate-500">Reviewed</dt><dd class="font-semibold text-slate-900">{request.reviewed_at ?? '—'}</dd></div></dl>{request.review_note && <p class="mt-4 rounded-lg bg-slate-50 p-3 text-sm text-slate-700"><strong>Review note:</strong> {request.review_note}</p>}{mayReview && <form class="mt-5 space-y-3 border-t border-slate-200 pt-5"><label class="block text-sm font-semibold text-slate-700" for="review_note">Review note <span class="font-normal text-slate-500">(required for rejection)</span></label><textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="review_note" name="review_note" rows="3"></textarea><div class="flex flex-wrap gap-3"><button class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white" type="submit" formaction={`/lab/change-requests/${request.id}/approve`} name="action" value="approve">Approve and apply</button><button class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white" type="submit" formaction={`/lab/change-requests/${request.id}/reject`} name="action" value="reject">Reject</button></div></form>}</section>
  </div>
</BaseLayout>
