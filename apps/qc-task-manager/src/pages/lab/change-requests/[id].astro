---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import { getChangeRequestForViewer, getChangeRequestPresentation } from '../../../lib/lab/changeRequests';
import { canApproveLabChangeRequest } from '../../../lib/permissions';
import type { Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;
const id = Number(Astro.params.id);
const request = Number.isInteger(id) && id > 0 ? getChangeRequestForViewer(id, { id: user.userId, role }) : null;
if (!request) return Astro.redirect('/lab/change-requests');
const presentation = request ? getChangeRequestPresentation(request.id) : null;
const pretty = (value: string | null) => { try { return JSON.stringify(JSON.parse(value ?? 'null'), null, 2); } catch { return value ?? '—'; } };
const mayReview = request.status === 'PENDING' && canApproveLabChangeRequest({ id: user.userId, role }, request);
---
<BaseLayout title={`Change Request CR-${request.id}`}>
  <div class="space-y-6"><Breadcrumbs items={[{ label: 'QC Tasks' }, { label: 'Laboratory', href: '/lab' }, { label: 'Change Requests', href: '/lab/change-requests' }, { label: `CR-${request.id}` }]} /><LabSecondaryNav items={labNavForRole(role)} currentPath="/lab/change-requests" />
    <header><p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Laboratory governance</p><h1 class="mt-1 text-3xl font-semibold text-slate-900">Change Request CR-{request.id}</h1><p class="mt-1 text-sm text-slate-600">{request.operation} · {request.entity_type} · requested by {request.requested_by_name ?? `User #${request.requested_by}`} ({request.requested_by_role ?? 'unknown role'})</p></header>
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><dl class="grid gap-4 text-sm sm:grid-cols-2 lg:grid-cols-4"><div><dt class="text-slate-500">Target</dt><dd class="font-semibold text-slate-900">{presentation?.target_href ? <a class="text-brand-700 underline" href={presentation.target_href}>{presentation.target_label}</a> : presentation?.target_label ?? '—'}</dd></div><div><dt class="text-slate-500">Submitted At</dt><dd class="font-semibold text-slate-900">{request.created_at}</dd></div><div><dt class="text-slate-500">Reviewer</dt><dd class="font-semibold text-slate-900">{request.reviewed_by_name ?? '—'}</dd></div><div><dt class="text-slate-500">Reviewed At</dt><dd class="font-semibold text-slate-900">{request.reviewed_at ?? '—'}</dd></div></dl><div class="mt-4 flex flex-wrap gap-2"><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold">Status: {request.status}</span>{request.operation === 'UPDATE' && <span class={`rounded-full px-3 py-1 text-xs font-semibold ${presentation?.stale ? 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-700'}`}>{presentation?.stale ? 'Stale / Conflict' : 'Current target'}</span>}</div>{request.review_note && <p class="mt-4 rounded-lg bg-slate-50 p-3 text-sm text-slate-700"><strong>Review note:</strong> {request.review_note}</p>}</section>
    {request.operation === 'UPDATE' && <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-semibold text-slate-900">Field-level diff</h2><div class="mt-3 overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-3 py-2">Field</th><th class="px-3 py-2">Before</th><th class="px-3 py-2">Proposed</th></tr></thead><tbody class="divide-y divide-slate-100">{(presentation?.diff ?? []).map((row) => <tr><td class="px-3 py-2 font-medium">{row.field}</td><td class="px-3 py-2 text-slate-600">{row.before}</td><td class="px-3 py-2 text-slate-900">{row.proposed}</td></tr>)}</tbody></table>{(presentation?.diff ?? []).length === 0 && <p class="p-3 text-sm text-slate-500">No field differences were found.</p>}</div></section>}
    <details class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><summary class="cursor-pointer font-semibold text-slate-900">Raw JSON diagnostics</summary><div class="mt-4 grid gap-4 lg:grid-cols-2"><div><h2 class="text-sm font-semibold">Before</h2><pre class="mt-2 max-h-64 overflow-auto rounded-lg bg-slate-50 p-3 text-xs text-slate-700">{pretty(request.base_snapshot_json)}</pre></div><div><h2 class="text-sm font-semibold">Proposed</h2><pre class="mt-2 max-h-64 overflow-auto rounded-lg bg-slate-50 p-3 text-xs text-slate-700">{pretty(request.proposed_snapshot_json)}</pre></div></div></details>
    {mayReview && <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><form action={`/api/lab/change-requests/${request.id}/review`} method="post" class="space-y-3"><label class="block text-sm font-semibold text-slate-700" for="review_note">Review note <span class="font-normal text-slate-500">(required for rejection)</span></label><textarea class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" id="review_note" name="review_note" rows="3"></textarea><div class="flex flex-wrap gap-3"><button class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white" type="submit" name="action" value="approve">Approve and apply</button><button class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white" type="submit" name="action" value="reject">Reject</button></div></form></section>}
  </div>
</BaseLayout>
