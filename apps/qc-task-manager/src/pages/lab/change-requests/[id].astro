---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import LabActionButton from '../../../components/lab/LabActionButton.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import { getChangeRequestForViewer, getChangeRequestPresentation } from '../../../lib/lab/changeRequests';
import { canApproveLabChangeRequest } from '../../../lib/permissions';
import type { Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;
const id = Number(Astro.params.id);
const request = Number.isInteger(id) && id > 0 ? getChangeRequestForViewer(id, { id: user.userId, role }) : null;
if (!request) return Astro.redirect('/lab/change-requests');
const presentation = request ? getChangeRequestPresentation(request.id) : null;
const pretty = (value: string | null) => { try { return JSON.stringify(JSON.parse(value ?? 'null'), null, 2); } catch { return value ?? '—'; } };
const mayReview = request.status === 'PENDING' && canApproveLabChangeRequest({ id: user.userId, role }, request);
---
<BaseLayout title={`Change Request CR-${request.id}`}>
  <div class="space-y-6"><Breadcrumbs items={[{ label: 'QC Tasks' }, { label: 'Laboratory', href: '/lab' }, { label: 'Change Requests', href: '/lab/change-requests' }, { label: `CR-${request.id}` }]} /><LabSecondaryNav items={labNavForRole(role)} currentPath="/lab/change-requests" />
    <header><p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Laboratory governance</p><h1 class="mt-1 text-3xl font-semibold text-slate-900">Change Request CR-{request.id}</h1><p class="mt-1 text-sm text-slate-600">{request.operation} · {request.entity_type} · requested by {request.requested_by_name ?? `User #${request.requested_by}`} ({request.requested_by_role ?? 'unknown role'})</p></header>
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><dl class="grid gap-4 text-sm sm:grid-cols-2 lg:grid-cols-4"><div><dt class="text-slate-500">Requester</dt><dd class="font-semibold text-slate-900">{request.requested_by_name ?? `User #${request.requested_by}`} <span class="font-normal text-slate-500">({request.requested_by_role ?? '—'})</span></dd></div><div><dt class="text-slate-500">Submitted At</dt><dd class="font-semibold text-slate-900" dir="ltr">{request.created_at}</dd></div><div><dt class="text-slate-500">Canonical Target</dt><dd class="font-semibold text-slate-900">{presentation?.target_href ? <a class="text-brand-700 underline" href={presentation.target_href}>{presentation.target_label}</a> : presentation?.target_label ?? '—'}</dd></div><div><dt class="text-slate-500">Reviewer</dt><dd class="font-semibold text-slate-900">{request.reviewed_by_name ?? '—'}{request.reviewed_at && <span class="block text-xs font-normal text-slate-500" dir="ltr">{request.reviewed_at}</span>}</dd></div></dl><div class="mt-4 flex flex-wrap gap-2"><span class="rounded-full border border-slate-300 bg-slate-100 px-3 py-1 text-xs font-semibold">Status: {request.status}</span>{request.operation === 'UPDATE' && <span class={`rounded-full border px-3 py-1 text-xs font-semibold ${presentation?.stale ? 'border-red-300 bg-red-50 text-red-800' : 'border-emerald-300 bg-emerald-50 text-emerald-800'}`}>{presentation?.stale ? 'Conflict — target changed' : 'Target is current'}</span>}</div>{request.review_note ? <p class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-950" role="note"><strong>Review reason:</strong> {request.review_note}</p> : request.status === 'REJECTED' ? <p class="mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-900" role="alert"><strong>Review reason:</strong> No reason was recorded.</p> : null}</section>
    {request.operation === 'UPDATE' && <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-semibold text-slate-900">Changed fields</h2><div class="mt-3 overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th scope="col" class="px-3 py-2">Field</th><th scope="col" class="px-3 py-2">Before</th><th scope="col" class="px-3 py-2">After</th></tr></thead><tbody class="divide-y divide-slate-100">{(presentation?.diff ?? []).map((row) => <tr><td class="px-3 py-2 font-medium">{row.field}</td><td class="max-w-xs break-words px-3 py-2 text-slate-600">{row.before}</td><td class="max-w-xs break-words px-3 py-2 text-slate-900">{row.proposed}</td></tr>)}</tbody></table>{(presentation?.diff ?? []).length === 0 && <p class="p-3 text-sm text-slate-500">No field differences were found.</p>}</div></section>}
    <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm" aria-labelledby="audit-correlation-heading"><div class="flex flex-wrap items-baseline justify-between gap-2"><h2 id="audit-correlation-heading" class="font-semibold text-slate-900">Audit correlation</h2><span class="text-xs text-slate-500">Shared QC audit chain</span></div><ol class="mt-3 divide-y divide-slate-100">{(presentation?.audit ?? []).map((event) => <li class="flex flex-wrap items-center justify-between gap-2 py-2 text-sm"><span><strong>{event.action}</strong> <span class="text-slate-600">by {event.actor_name ?? 'Unknown actor'}</span></span><span class="text-xs text-slate-500" dir="ltr">AUD-{event.id} · {event.created_at}</span></li>)}</ol>{(presentation?.audit ?? []).length === 0 && <p class="mt-3 text-sm text-slate-600">No audit events were found for this request.</p>}</section>
    <details class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><summary class="cursor-pointer font-semibold text-slate-900">Raw JSON diagnostics</summary><div class="mt-4 grid gap-4 lg:grid-cols-2"><div><h2 class="text-sm font-semibold">Before</h2><pre class="mt-2 max-h-64 overflow-auto rounded-lg bg-slate-50 p-3 text-xs text-slate-700">{pretty(request.base_snapshot_json)}</pre></div><div><h2 class="text-sm font-semibold">Proposed</h2><pre class="mt-2 max-h-64 overflow-auto rounded-lg bg-slate-50 p-3 text-xs text-slate-700">{pretty(request.proposed_snapshot_json)}</pre></div></div></details>
    {request.status === 'REJECTED' && request.requested_by === user.userId && <section class="rounded-xl border border-red-200 bg-red-50 p-5 shadow-sm"><h2 class="text-base font-semibold text-red-950">Resubmit rejected request</h2><p class="mt-1 text-sm text-red-900">The original review reason remains above. Review the proposed values before creating a new request.</p><LabActionButton href={`/lab/change-requests/new?resubmit=${request.id}`} kind="primary">Resubmit Request</LabActionButton></section>}
    {mayReview && <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><form action={`/api/lab/change-requests/${request.id}/review`} method="post" class="space-y-3"><fieldset><legend class="text-sm font-semibold text-slate-700">Review decision</legend><label class="mt-3 block text-sm font-semibold text-slate-700" for="review_note">Review reason <span class="font-normal text-slate-500">(required for rejection)</span></label><textarea aria-describedby="review-note-help" class="w-full min-h-11 rounded-lg border border-slate-300 px-3 py-2 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600" id="review_note" name="review_note" rows="3"></textarea><p id="review-note-help" class="text-xs text-slate-600">Explain what was checked, and list the correction required when rejecting.</p></fieldset><div class="flex flex-wrap gap-3"><LabActionButton type="submit" name="action" value="approve" kind="primary">Approve and apply</LabActionButton><LabActionButton type="submit" name="action" value="reject" kind="destructive">Reject</LabActionButton></div></form></section>}
  </div>
</BaseLayout>
