---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import type { Role } from '../../../lib/types';
const user = Astro.locals.user!;
const role = user.role as Role;
const cls = 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm';
const label = 'mb-1 block text-xs font-semibold text-slate-600';
---
<BaseLayout title="New Laboratory Change Request">
  <div class="space-y-6"><Breadcrumbs items={[{ label: 'QC Tasks' }, { label: 'Laboratory', href: '/lab' }, { label: 'Change Requests', href: '/lab/change-requests' }, { label: 'New' }]} /><LabSecondaryNav items={labNavForRole(role)} currentPath="/lab/change-requests" />
    <header><p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Validated proposal intake</p><h1 class="mt-1 text-3xl font-semibold text-slate-900">New Change Request</h1><p class="mt-1 max-w-3xl text-sm text-slate-600">Choose an entity and enter only canonical form fields. The server validates and snapshots the proposal; it never trusts a browser-supplied snapshot.</p></header>
    <form method="post" action="/lab/change-requests/new" class="space-y-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="grid gap-4 sm:grid-cols-3"><div><label class={label} for="entity_type">Entity</label><select class={cls} id="entity_type" name="entity_type"><option value="EQUIPMENT">Equipment</option><option value="PRODUCT">Product</option><option value="CALIBRATION">Calibration</option><option value="RETEST_REQUEST">Retest request</option></select></div><div><label class={label} for="operation">Operation</label><select class={cls} id="operation" name="operation"><option value="CREATE">Create</option><option value="UPDATE">Update</option></select></div><div><label class={label} for="entity_id">Existing record ID (updates)</label><input class={cls} id="entity_id" name="entity_id" inputmode="numeric" /></div></div>
      <fieldset class="space-y-4 border-t border-slate-200 pt-5"><legend class="text-lg font-semibold text-slate-900">Canonical fields</legend><div class="grid gap-4 sm:grid-cols-2"><div><label class={label} for="name">Name</label><input class={cls} id="name" name="name" /></div><div><label class={label} for="code">Code</label><input class={cls} id="code" name="code" /></div><div><label class={label} for="location">Location</label><input class={cls} id="location" name="location" /></div><div><label class={label} for="status_raw">Status</label><input class={cls} id="status_raw" name="status_raw" /></div><div><label class={label} for="calibration_status_raw">Calibration status</label><select class={cls} id="calibration_status_raw" name="calibration_status_raw"><option value="">Not specified</option><option value="yes">Yes</option><option value="no">No</option></select></div><div><label class={label} for="serial_number">Serial number</label><input class={cls} id="serial_number" name="serial_number" /></div><div class="sm:col-span-2"><label class={label} for="description">Description / notes</label><textarea class={cls} id="description" name="description" rows="3"></textarea><input type="hidden" name="notes" value="" /></div></div></fieldset>
      <fieldset class="space-y-4 border-t border-slate-200 pt-5"><legend class="text-lg font-semibold text-slate-900">Product / calibration / retest fields</legend><div class="grid gap-4 sm:grid-cols-2"><div><label class={label} for="equipment_id">Equipment ID</label><input class={cls} id="equipment_id" name="equipment_id" inputmode="numeric" /></div><div><label class={label} for="default_test_type">Default test type</label><select class={cls} id="default_test_type" name="default_test_type"><option value="">Not specified</option><option value="air">AIR</option><option value="vacuum">VACUUM</option></select></div><div><label class={label} for="provider">Provider</label><input class={cls} id="provider" name="provider" /></div><div><label class={label} for="certificate_reference">Certificate reference</label><input class={cls} id="certificate_reference" name="certificate_reference" /></div><div><label class={label} for="last_calibrated_at">Last calibrated</label><input class={cls} id="last_calibrated_at" name="last_calibrated_at" type="date" /></div><div><label class={label} for="calibration_due_at">Calibration due</label><input class={cls} id="calibration_due_at" name="calibration_due_at" type="date" /></div><div><label class={label} for="next_due_at">Next due</label><input class={cls} id="next_due_at" name="next_due_at" type="date" /></div><div><label class={label} for="result">Result</label><input class={cls} id="result" name="result" /></div><div><label class={label} for="original_test_id">Original test ID</label><input class={cls} id="original_test_id" name="original_test_id" inputmode="numeric" /></div><div><label class={label} for="reason">Retest reason</label><select class={cls} id="reason" name="reason"><option value="FAIL">FAIL</option><option value="HOLD">HOLD</option><option value="SAMPLE_ISSUE">SAMPLE_ISSUE</option><option value="EQUIPMENT_ISSUE">EQUIPMENT_ISSUE</option><option value="PROCEDURAL_ISSUE">PROCEDURAL_ISSUE</option><option value="OTHER">OTHER</option></select></div><div class="sm:col-span-2"><label class={label} for="reason_note">Reason note</label><textarea class={cls} id="reason_note" name="reason_note" rows="2"></textarea></div></div></fieldset>
      <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="is_active" value="1" checked /> Product is active</label>
      <div class="flex gap-3"><button class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700" type="submit">Submit for review</button><a class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700" href="/lab/change-requests">Cancel</a></div>
    </form>
  </div>
</BaseLayout>
