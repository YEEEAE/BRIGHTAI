---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { getChangeRequestForViewer } from '../../../lib/lab/changeRequests';
import { labNavForRole } from '../../../lib/lab/navigation';
import type { Role } from '../../../lib/types';
import PageHeader from '../../../components/ui/PageHeader.astro';
import AppButton from '../../../components/ui/AppButton.astro';
import ContextualHelp from '../../../components/ui/ContextualHelp.astro';

const user = Astro.locals.user!;
const role = user.role as Role;
const cls = 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-1 focus:ring-primary-500';
const label = 'mb-1 block text-xs font-semibold text-slate-700';
const helpText = 'mt-1 block text-xs text-slate-500';

const resubmitId = Number(Astro.url.searchParams.get('resubmit'));
const rejected = Number.isInteger(resubmitId) && resubmitId > 0
  ? getChangeRequestForViewer(resubmitId, { id: user.userId, role })
  : null;
const isResubmit = rejected?.status === 'REJECTED' && rejected.requested_by === user.userId;
const requestEntity = isResubmit ? rejected.entity_type : '';
let draft: Record<string, unknown> = {};
if (isResubmit) {
  try { draft = JSON.parse(rejected.proposed_snapshot_json) as Record<string, unknown>; } catch { draft = {}; }
}
const value = (name: string, fallback = ''): string => draft[name] == null ? fallback : String(draft[name]);
const selected = (name: string, option: string, fallback = false): boolean => name === 'entity_type'
  ? (isResubmit ? requestEntity === option : fallback)
  : (isResubmit ? value(name) === option : fallback);
---

<BaseLayout title="New Laboratory Change Request">
  <div class="space-y-6">
    <Breadcrumbs items={[{ label: 'QC Tasks' }, { label: 'Laboratory', href: '/lab' }, { label: 'Change Requests', href: '/lab/change-requests' }, { label: 'New' }]} />
    <LabSecondaryNav items={labNavForRole(role)} currentPath="/lab/change-requests" />
    
    <PageHeader
      eyebrow="Controlled Change Intake"
      title={isResubmit ? 'Resubmit Change Request' : 'New Change Request'}
      description="Follow the 3-step intent flow: define scope, assess GMP risk, and provide action plan details. All proposals require supervisory review before applying to live records."
    />

    <ContextualHelp title="Change request workflow: Intent-Driven Guidance">
      Laboratory change requests must clearly establish operational intent rather than exposing low-level database details.
      Step 1 clarifies what is changing and why; Step 2 evaluates pharmaceutical and GMP quality risks; Step 3 defines execution responsibility and validation evidence. All proposals are subject to supervisory review.
    </ContextualHelp>

    {isResubmit && (
      <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-900" role="note">
        <strong>Resubmitting CR-{rejected.id}.</strong> Previous review reason: {rejected.review_note ?? 'No reason was recorded.'}
      </div>
    )}

    <!-- Multi-Step Progress Indicator with Screen Reader Announcement -->
    <nav aria-label="Change request progress" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <ol class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <li id="step-nav-1" class="step-nav-item flex items-center gap-3 border-b-2 border-primary-600 pb-2 text-primary-900 sm:border-b-0 sm:border-l-4 sm:pl-3" aria-current="step">
          <span class="step-badge flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary-600 text-xs font-bold text-white">1</span>
          <div>
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Step 1</span>
            <span class="text-sm font-semibold">Objective & Scope</span>
          </div>
        </li>
        <li id="step-nav-2" class="step-nav-item flex items-center gap-3 border-b-2 border-transparent pb-2 text-slate-500 sm:border-b-0 sm:border-l-4 sm:pl-3">
          <span class="step-badge flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-200 text-xs font-bold text-slate-700">2</span>
          <div>
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Step 2</span>
            <span class="text-sm font-semibold">Risk & Quality Impact</span>
          </div>
        </li>
        <li id="step-nav-3" class="step-nav-item flex items-center gap-3 border-b-2 border-transparent pb-2 text-slate-500 sm:border-b-0 sm:border-l-4 sm:pl-3">
          <span class="step-badge flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-200 text-xs font-bold text-slate-700">3</span>
          <div>
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Step 3</span>
            <span class="text-sm font-semibold">Action Plan & Reviewers</span>
          </div>
        </li>
      </ol>
    </nav>

    <form id="change-request-form" method="post" action="/lab/change-requests/new" class="space-y-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      
      <!-- ==================== STEP 1: OBJECTIVE & SCOPE ==================== -->
      <fieldset id="form-step-1" class="space-y-5" aria-labelledby="step-1-heading">
        <div class="border-b border-slate-100 pb-3">
          <legend id="step-1-heading" class="text-lg font-bold text-slate-900" tabindex="-1">
            Step 1: Change Objective & Scope
          </legend>
          <p class="mt-1 text-sm text-slate-500">Define the purpose, urgency, and affected operational area for this proposed change.</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label class={label} for="title">Change Title <span class="text-red-500">*</span></label>
            <input class={cls} id="title" name="title" required minlength="3" maxlength="200" placeholder="e.g., Upgrade Calibration Cycle for Vacuum Chamber B" value={value('title', value('name'))} />
            <span class={helpText}>A concise, descriptive summary of the change objective.</span>
          </div>

          <div class="sm:col-span-2">
            <label class={label} for="change_reason">Reason for Change / Justification <span class="text-red-500">*</span></label>
            <textarea class={cls} id="change_reason" name="change_reason" required minlength="5" rows="3" placeholder="Explain the regulatory, quality, or operational driver for this change...">{value('change_reason', value('description'))}</textarea>
            <span class={helpText}>Explain why this change is necessary and what problem or improvement it addresses.</span>
          </div>

          <div>
            <label class={label} for="urgency">Change Urgency <span class="text-red-500">*</span></label>
            <select class={cls} id="urgency" name="urgency" required>
              <option value="ROUTINE" selected={selected('urgency', 'ROUTINE', true)}>Routine (Standard planned change)</option>
              <option value="URGENT" selected={selected('urgency', 'URGENT')}>Urgent (Impending test delay or hold)</option>
              <option value="EMERGENCY" selected={selected('urgency', 'EMERGENCY')}>Emergency (Critical stoppage or audit non-conformance)</option>
            </select>
          </div>

          <div>
            <label class={label} for="affected_areas">Affected Areas / Laboratory Units <span class="text-red-500">*</span></label>
            <input class={cls} id="affected_areas" name="affected_areas" required placeholder="e.g., Analytical Lab Room 102, Sterile Packaging Line" value={value('affected_areas', value('location', 'Quality Lab'))} />
            <span class={helpText}>Facilities, benches, or production units directly affected.</span>
          </div>

          <div>
            <label class={label} for="entity_type">Target Master Entity <span class="text-red-500">*</span></label>
            <select class={cls} id="entity_type" name="entity_type" required>
              <option value="EQUIPMENT" selected={selected('entity_type', 'EQUIPMENT', true)}>Equipment</option>
              <option value="PRODUCT" selected={selected('entity_type', 'PRODUCT')}>Product</option>
              <option value="CALIBRATION" selected={selected('entity_type', 'CALIBRATION')}>Calibration</option>
              <option value="RETEST_REQUEST" selected={selected('entity_type', 'RETEST_REQUEST')}>Retest Request</option>
            </select>
          </div>

          <div>
            <label class={label} for="operation">Proposed Operation <span class="text-red-500">*</span></label>
            <select class={cls} id="operation" name="operation" required>
              <option value="CREATE" selected={isResubmit ? rejected.operation === 'CREATE' : true}>Create New Master Record</option>
              <option value="UPDATE" selected={isResubmit ? rejected.operation === 'UPDATE' : false}>Update Existing Master Record</option>
            </select>
          </div>

          <div>
            <label class={label} for="entity_id">Existing Record ID (If Updating)</label>
            <input class={cls} id="entity_id" name="entity_id" inputmode="numeric" placeholder="e.g., 42" value={isResubmit ? String(rejected.entity_id ?? '') : ''} />
            <span class={helpText}>Required only when proposing updates to an existing master record.</span>
          </div>
        </div>

        <div class="flex justify-end pt-4 border-t border-slate-100">
          <button type="button" class="step-btn-next inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700" data-target-step="2">
            Next: Risk & Quality Impact &rarr;
          </button>
        </div>
      </fieldset>

      <!-- ==================== STEP 2: RISK & QUALITY IMPACT ==================== -->
      <fieldset id="form-step-2" class="space-y-5 hidden" aria-labelledby="step-2-heading">
        <div class="border-b border-slate-100 pb-3">
          <legend id="step-2-heading" class="text-lg font-bold text-slate-900" tabindex="-1">
            Step 2: Risk & Quality Impact Assessment
          </legend>
          <p class="mt-1 text-sm text-slate-500">Evaluate Good Manufacturing Practice (GMP) impact, validation requirements, and rollback protocol.</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class={label} for="gmp_impact">GMP / Product Quality Impact <span class="text-red-500">*</span></label>
            <select class={cls} id="gmp_impact" name="gmp_impact" required>
              <option value="NONE" selected={selected('gmp_impact', 'NONE', true)}>None (Non-critical auxiliary tool or documentation)</option>
              <option value="MINOR" selected={selected('gmp_impact', 'MINOR')}>Minor (Lab measurement without direct release change)</option>
              <option value="DIRECT_GMP" selected={selected('gmp_impact', 'DIRECT_GMP')}>Direct GMP (Critical equipment, product specifications, or release testing)</option>
            </select>
            <span class={helpText}>Classify whether this change influences batch release or regulatory standards.</span>
          </div>

          <div>
            <label class={label} for="validation_required">Validation / Qualification Required? <span class="text-red-500">*</span></label>
            <select class={cls} id="validation_required" name="validation_required" required>
              <option value="NO" selected={selected('validation_required', 'NO', true)}>No (Routine calibration or pre-qualified equivalent)</option>
              <option value="YES" selected={selected('validation_required', 'YES')}>Yes (Requires IQ/OQ/PQ or method re-verification)</option>
            </select>
            <span class={helpText}>Indicate if formal re-qualification or re-validation protocols must precede go-live.</span>
          </div>

          <div class="sm:col-span-2">
            <label class={label} for="rollback_plan">Rollback / Contingency Protocol <span class="text-red-500">*</span></label>
            <textarea class={cls} id="rollback_plan" name="rollback_plan" required minlength="5" rows="3" placeholder="Specify exact steps to restore previous validated state if change fails verification...">{value('rollback_plan', 'Revert equipment to backup unit and restore previous calibration parameters.')}</textarea>
            <span class={helpText}>Mandatory for GMP auditability: define the recovery procedure if unexpected deviations occur.</span>
          </div>
        </div>

        <div class="flex justify-between pt-4 border-t border-slate-100">
          <button type="button" class="step-btn-prev inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" data-target-step="1">
            &larr; Previous: Objective & Scope
          </button>
          <button type="button" class="step-btn-next inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-700" data-target-step="3">
            Next: Action Plan & Reviewers &rarr;
          </button>
        </div>
      </fieldset>

      <!-- ==================== STEP 3: ACTION PLAN & REVIEWERS ==================== -->
      <fieldset id="form-step-3" class="space-y-5 hidden" aria-labelledby="step-3-heading">
        <div class="border-b border-slate-100 pb-3">
          <legend id="step-3-heading" class="text-lg font-bold text-slate-900" tabindex="-1">
            Step 3: Action Plan & Stakeholder Reviewers
          </legend>
          <p class="mt-1 text-sm text-slate-500">Designate the responsible executor, target implementation timeline, and technical specifications.</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class={label} for="assignee">Assigned Implementation Lead</label>
            <input class={cls} id="assignee" name="assignee" placeholder="e.g., Senior QA Specialist" value={value('assignee')} />
            <span class={helpText}>Individual responsible for carrying out the physical or system change.</span>
          </div>

          <div>
            <label class={label} for="target_completion_date">Target Completion Date</label>
            <input class={cls} id="target_completion_date" name="target_completion_date" type="date" value={value('target_completion_date')} />
            <span class={helpText}>Proposed execution target (YYYY-MM-DD).</span>
          </div>

          <div class="sm:col-span-2">
            <label class={label} for="attachments_note">Supporting Documents / Protocol References</label>
            <input class={cls} id="attachments_note" name="attachments_note" placeholder="e.g., Protocol V-2026-08, Manufacturer Spec Sheet Rev 3" value={value('attachments_note')} />
            <span class={helpText}>References to attached test protocols, calibration certificates, or vendor documentation.</span>
          </div>
        </div>

        <!-- Technical Specification Details (collapsible details panel) -->
        <details class="rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm" open>
          <summary class="cursor-pointer font-semibold text-slate-900 select-none">
            Technical Record Parameters (Entity-Specific)
          </summary>
          <div class="mt-4 space-y-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <div><label class={label} for="name">Technical Name</label><input class={cls} id="name" name="name" value={value('name')} placeholder="Equipment / Product Name" /></div>
              <div><label class={label} for="code">Identifier / Code</label><input class={cls} id="code" name="code" value={value('code')} placeholder="EQ-XXX / PRD-XXX" /></div>
              <div><label class={label} for="location">Location</label><input class={cls} id="location" name="location" value={value('location')} /></div>
              <div><label class={label} for="serial_number">Serial Number</label><input class={cls} id="serial_number" name="serial_number" value={value('serial_number')} /></div>
              <div><label class={label} for="status_raw">Equipment Status</label><input class={cls} id="status_raw" name="status_raw" value={value('status_raw', 'ACTIVE')} /></div>
              <div><label class={label} for="calibration_status_raw">Calibrated?</label><select class={cls} id="calibration_status_raw" name="calibration_status_raw"><option value="" selected={value('calibration_status_raw') === ''}>Not specified</option><option value="yes" selected={selected('calibration_status_raw', 'yes', true)}>Yes</option><option value="no" selected={selected('calibration_status_raw', 'no')}>No</option></select></div>
            </div>

            <!-- Calibration & Retest Parameters -->
            <div class="grid gap-4 sm:grid-cols-2 border-t border-slate-200 pt-3">
              <div><label class={label} for="provider">Calibration Provider</label><input class={cls} id="provider" name="provider" value={value('provider')} /></div>
              <div><label class={label} for="certificate_reference">Cert Reference</label><input class={cls} id="certificate_reference" name="certificate_reference" value={value('certificate_reference')} /></div>
              <div><label class={label} for="last_calibrated_at">Last Calibrated</label><input class={cls} id="last_calibrated_at" name="last_calibrated_at" type="date" value={value('last_calibrated_at')} /></div>
              <div><label class={label} for="calibration_due_at">Calibration Due</label><input class={cls} id="calibration_due_at" name="calibration_due_at" type="date" value={value('calibration_due_at')} /></div>
              <div><label class={label} for="original_test_id">Original Test ID (For Retests)</label><input class={cls} id="original_test_id" name="original_test_id" inputmode="numeric" value={value('original_test_id')} /></div>
              <div>
                <label class={label} for="reason">Retest Reason</label>
                <select class={cls} id="reason" name="reason">
                  <option value="FAIL" selected={selected('reason', 'FAIL', true)}>FAIL</option>
                  <option value="HOLD" selected={selected('reason', 'HOLD')}>HOLD</option>
                  <option value="SAMPLE_ISSUE" selected={selected('reason', 'SAMPLE_ISSUE')}>SAMPLE_ISSUE</option>
                  <option value="EQUIPMENT_ISSUE" selected={selected('reason', 'EQUIPMENT_ISSUE')}>EQUIPMENT_ISSUE</option>
                  <option value="PROCEDURAL_ISSUE" selected={selected('reason', 'PROCEDURAL_ISSUE')}>PROCEDURAL_ISSUE</option>
                  <option value="OTHER" selected={selected('reason', 'OTHER')}>OTHER</option>
                </select>
              </div>
              <div class="sm:col-span-2">
                <label class={label} for="reason_note">Retest Justification Note</label>
                <textarea class={cls} id="reason_note" name="reason_note" rows="2">{value('reason_note')}</textarea>
              </div>
            </div>
          </div>
        </details>

        <label class="flex items-center gap-2 text-sm text-slate-700 select-none">
          <input type="checkbox" name="is_active" value="1" checked class="h-4 w-4 rounded border-slate-300 text-primary-600 focus:ring-primary-500" />
          Entity record should be marked Active upon approval
        </label>

        <div class="flex justify-between pt-4 border-t border-slate-100">
          <button type="button" class="step-btn-prev inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" data-target-step="2">
            &larr; Previous: Risk Assessment
          </button>
          <div class="flex gap-3">
            <AppButton href="/lab/change-requests" variant="secondary">Cancel</AppButton>
            <AppButton type="submit" variant="primary">Submit Change Request</AppButton>
          </div>
        </div>
      </fieldset>
    </form>
  </div>

  <script is:inline>
    // Client-side multi-step wizard with full progressive enhancement and aria-current updates
    (function initChangeRequestWizard() {
      const form = document.getElementById('change-request-form');
      if (!form) return;

      const steps = [
        document.getElementById('form-step-1'),
        document.getElementById('form-step-2'),
        document.getElementById('form-step-3'),
      ];

      const navItems = [
        document.getElementById('step-nav-1'),
        document.getElementById('step-nav-2'),
        document.getElementById('step-nav-3'),
      ];

      function goToStep(stepNumber) {
        steps.forEach((step, idx) => {
          if (!step) return;
          const isCurrent = (idx + 1) === stepNumber;
          if (isCurrent) {
            step.classList.remove('hidden');
            const heading = step.querySelector('legend');
            if (heading) heading.focus();
          } else {
            step.classList.add('hidden');
          }
        });

        navItems.forEach((nav, idx) => {
          if (!nav) return;
          const isCurrent = (idx + 1) === stepNumber;
          const badge = nav.querySelector('.step-badge');
          if (isCurrent) {
            nav.setAttribute('aria-current', 'step');
            nav.classList.add('border-primary-600', 'text-primary-900');
            nav.classList.remove('border-transparent', 'text-slate-500');
            if (badge) {
              badge.classList.add('bg-primary-600', 'text-white');
              badge.classList.remove('bg-slate-200', 'text-slate-700');
            }
          } else {
            nav.removeAttribute('aria-current');
            nav.classList.remove('border-primary-600', 'text-primary-900');
            nav.classList.add('border-transparent', 'text-slate-500');
            if (badge) {
              badge.classList.remove('bg-primary-600', 'text-white');
              badge.classList.add('bg-slate-200', 'text-slate-700');
            }
          }
        });
      }

      // Next step buttons
      form.querySelectorAll('.step-btn-next').forEach(btn => {
        btn.addEventListener('click', () => {
          const target = Number(btn.getAttribute('data-target-step'));
          const currentStepEl = btn.closest('fieldset');
          if (currentStepEl) {
            // Validate required inputs in current fieldset
            const inputs = currentStepEl.querySelectorAll('input, select, textarea');
            let allValid = true;
            for (const input of inputs) {
              if (!input.checkValidity()) {
                input.reportValidity();
                allValid = false;
                break;
              }
            }
            if (!allValid) return;
          }
          goToStep(target);
        });
      });

      // Prev step buttons
      form.querySelectorAll('.step-btn-prev').forEach(btn => {
        btn.addEventListener('click', () => {
          const target = Number(btn.getAttribute('data-target-step'));
          goToStep(target);
        });
      });
    })();
  </script>
</BaseLayout>
