---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { getChangeRequestForViewer } from '../../../lib/lab/changeRequests';
import { labNavForRole } from '../../../lib/lab/navigation';
import type { Role } from '../../../lib/types';
const user = Astro.locals.user!;
const role = user.role as Role;
const cls = 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm';
const label = 'mb-1 block text-xs font-semibold text-slate-600';
const resubmitId = Number(Astro.url.searchParams.get('resubmit'));
const rejected = Number.isInteger(resubmitId) && resubmitId > 0
  ? getChangeRequestForViewer(resubmitId, { id: user.userId, role })
  : null;
const isResubmit = rejected?.status === 'REJECTED' && rejected.requested_by === user.userId;
const requestEntity = isResubmit ? rejected.entity_type : '';
let draft: Record<string, unknown> = {};
if (isResubmit) {
  try { draft = JSON.parse(rejected.proposed_snapshot_json) as Record<string, unknown>; } catch { draft = {}; }
}
const value = (name: string): string => draft[name] == null ? '' : String(draft[name]);
const selected = (name: string, option: string, fallback = false): boolean => name === 'entity_type'
  ? (isResubmit ? requestEntity === option : fallback)
  : (isResubmit ? value(name) === option : fallback);
---
<BaseLayout title="New Laboratory Change Request">
  <div class="space-y-6"><Breadcrumbs items={[{ label: 'QC Tasks' }, { label: 'Laboratory', href: '/lab' }, { label: 'Change Requests', href: '/lab/change-requests' }, { label: 'New' }]} /><LabSecondaryNav items={labNavForRole(role)} currentPath="/lab/change-requests" />
    <header><p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Validated proposal intake</p><h1 class="mt-1 text-3xl font-semibold text-slate-900">{isResubmit ? 'Resubmit Change Request' : 'New Change Request'}</h1><p class="mt-1 max-w-3xl text-sm text-slate-600">{isResubmit ? 'The rejected proposal is prefilled for correction. The original review reason remains on the previous request.' : 'Choose an entity and enter only canonical form fields.'} The server validates and snapshots the proposal; it never trusts a browser-supplied snapshot.</p></header>
    {isResubmit && <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-900" role="note"><strong>Resubmitting CR-{rejected.id}.</strong> Previous review reason: {rejected.review_note ?? 'No reason was recorded.'}</div>}
    <form method="post" action="/lab/change-requests/new" class="space-y-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="grid gap-4 sm:grid-cols-3"><div><label class={label} for="entity_type">Entity</label><select class={cls} id="entity_type" name="entity_type"><option value="EQUIPMENT" selected={selected('entity_type', 'EQUIPMENT', true)}>Equipment</option><option value="PRODUCT" selected={selected('entity_type', 'PRODUCT')}>Product</option><option value="CALIBRATION" selected={selected('entity_type', 'CALIBRATION')}>Calibration</option><option value="RETEST_REQUEST" selected={selected('entity_type', 'RETEST_REQUEST')}>Retest request</option></select></div><div><label class={label} for="operation">Operation</label><select class={cls} id="operation" name="operation"><option value="CREATE" selected={isResubmit ? rejected.operation === 'CREATE' : true}>Create</option><option value="UPDATE" selected={isResubmit ? rejected.operation === 'UPDATE' : false}>Update</option></select></div><div><label class={label} for="entity_id">Existing record ID (updates)</label><input class={cls} id="entity_id" name="entity_id" inputmode="numeric" value={isResubmit ? String(rejected.entity_id ?? '') : ''} /></div></div>
      <fieldset class="space-y-4 border-t border-slate-200 pt-5"><legend class="text-lg font-semibold text-slate-900">Canonical fields</legend><div class="grid gap-4 sm:grid-cols-2"><div><label class={label} for="name">Name</label><input class={cls} id="name" name="name" value={value('name')} /></div><div><label class={label} for="code">Code</label><input class={cls} id="code" name="code" value={value('code')} /></div><div><label class={label} for="location">Location</label><input class={cls} id="location" name="location" value={value('location')} /></div><div><label class={label} for="status_raw">Status</label><input class={cls} id="status_raw" name="status_raw" value={value('status_raw')} /></div><div><label class={label} for="calibration_status_raw">Calibration status</label><select class={cls} id="calibration_status_raw" name="calibration_status_raw"><option value="" selected={value('calibration_status_raw') === ''}>Not specified</option><option value="yes" selected={selected('calibration_status_raw', 'yes')}>Yes</option><option value="no" selected={selected('calibration_status_raw', 'no')}>No</option></select></div><div><label class={label} for="serial_number">Serial number</label><input class={cls} id="serial_number" name="serial_number" value={value('serial_number')} /></div><div class="sm:col-span-2"><label class={label} for="description">Description / notes</label><textarea class={cls} id="description" name="description" rows="3">{value('description')}</textarea><input type="hidden" name="notes" value={value('notes')} /></div></div></fieldset>
      <fieldset class="space-y-4 border-t border-slate-200 pt-5"><legend class="text-lg font-semibold text-slate-900">Product / calibration / retest fields</legend><div class="grid gap-4 sm:grid-cols-2"><div><label class={label} for="equipment_id">Equipment ID</label><input class={cls} id="equipment_id" name="equipment_id" inputmode="numeric" value={value('equipment_id')} /></div><div><label class={label} for="default_test_type">Default test type</label><select class={cls} id="default_test_type" name="default_test_type"><option value="">Not specified</option><option value="air" selected={selected('default_test_type', 'air')}>AIR</option><option value="vacuum" selected={selected('default_test_type', 'vacuum')}>VACUUM</option></select></div><div><label class={label} for="provider">Provider</label><input class={cls} id="provider" name="provider" value={value('provider')} /></div><div><label class={label} for="certificate_reference">Certificate reference</label><input class={cls} id="certificate_reference" name="certificate_reference" value={value('certificate_reference')} /></div><div><label class={label} for="last_calibrated_at">Last calibrated</label><input class={cls} id="last_calibrated_at" name="last_calibrated_at" type="date" value={value('last_calibrated_at')} /></div><div><label class={label} for="calibration_due_at">Calibration due</label><input class={cls} id="calibration_due_at" name="calibration_due_at" type="date" value={value('calibration_due_at')} /></div><div><label class={label} for="next_due_at">Next due</label><input class={cls} id="next_due_at" name="next_due_at" type="date" value={value('next_due_at')} /></div><div><label class={label} for="result">Result</label><input class={cls} id="result" name="result" value={value('result')} /></div><div><label class={label} for="original_test_id">Original test ID</label><input class={cls} id="original_test_id" name="original_test_id" inputmode="numeric" value={value('original_test_id')} /></div><div><label class={label} for="reason">Retest reason</label><select class={cls} id="reason" name="reason"><option value="FAIL" selected={selected('reason', 'FAIL', true)}>FAIL</option><option value="HOLD" selected={selected('reason', 'HOLD')}>HOLD</option><option value="SAMPLE_ISSUE" selected={selected('reason', 'SAMPLE_ISSUE')}>SAMPLE_ISSUE</option><option value="EQUIPMENT_ISSUE" selected={selected('reason', 'EQUIPMENT_ISSUE')}>EQUIPMENT_ISSUE</option><option value="PROCEDURAL_ISSUE" selected={selected('reason', 'PROCEDURAL_ISSUE')}>PROCEDURAL_ISSUE</option><option value="OTHER" selected={selected('reason', 'OTHER')}>OTHER</option></select></div><div class="sm:col-span-2"><label class={label} for="reason_note">Reason note</label><textarea class={cls} id="reason_note" name="reason_note" rows="2">{value('reason_note')}</textarea></div></div></fieldset>
      <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="is_active" value="1" checked /> Product is active</label>
      <div class="flex gap-3"><button class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700" type="submit">Submit for review</button><a class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700" href="/lab/change-requests">Cancel</a></div>
    </form>
  </div>
</BaseLayout>
