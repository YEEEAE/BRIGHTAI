---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import { listPendingChangeRequests, listUserChangeRequests } from '../../../lib/lab/changeRequests';
import { canReviewLabChangeRequests } from '../../../lib/permissions';
import type { Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;
const mine = listUserChangeRequests(user.userId);
const pending = canReviewLabChangeRequests(role) ? listPendingChangeRequests() : [];
const fmt = (value: string) => value.replace('T', ' ').slice(0, 16);
const statusClass = (status: string) => status === 'APPROVED' ? 'bg-emerald-100 text-emerald-700' : status === 'REJECTED' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700';
---
<BaseLayout title="Laboratory Change Requests">
  <div class="space-y-6">
    <Breadcrumbs items={[{ label: 'QC Tasks' }, { label: 'Laboratory', href: '/lab' }, { label: 'Change Requests' }]} />
    <header class="flex flex-wrap items-start justify-between gap-4">
      <div><p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Governance</p><h1 class="mt-1 text-3xl font-semibold text-slate-900">Change Requests</h1><p class="mt-1 max-w-3xl text-sm text-slate-600">Propose a validated laboratory master-data change for manager review. Canonical records change only after approval.</p></div>
      <a href="/lab/change-requests/new" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">New proposal</a>
    </header>
    <LabSecondaryNav items={labNavForRole(role)} currentPath="/lab/change-requests" />

    {canReviewLabChangeRequests(role) && <section class="space-y-3"><h2 class="text-xl font-semibold text-slate-900">Pending review ({pending.length})</h2><div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Request</th><th class="px-4 py-3">Contributor</th><th class="px-4 py-3">Operation</th><th class="px-4 py-3">Created</th><th class="px-4 py-3">Review</th></tr></thead><tbody class="divide-y divide-slate-100">{pending.map((request) => <tr><td class="px-4 py-3 font-medium"><a class="text-brand-700 hover:underline" href={`/lab/change-requests/${request.id}`}>CR-{request.id} · {request.entity_type}</a></td><td class="px-4 py-3">{request.requested_by_name ?? `User #${request.requested_by}`}</td><td class="px-4 py-3">{request.operation}</td><td class="px-4 py-3 text-slate-600">{fmt(request.created_at)}</td><td class="px-4 py-3"><a class="font-semibold text-brand-700 hover:underline" href={`/lab/change-requests/${request.id}`}>Open</a></td></tr>)}</tbody></table>{pending.length === 0 && <p class="p-6 text-sm text-slate-500">No pending proposals.</p>}</div></section>}

    <section class="space-y-3"><h2 class="text-xl font-semibold text-slate-900">My proposals ({mine.length})</h2><div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Request</th><th class="px-4 py-3">Operation</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Created</th></tr></thead><tbody class="divide-y divide-slate-100">{mine.map((request) => <tr><td class="px-4 py-3 font-medium"><a class="text-brand-700 hover:underline" href={`/lab/change-requests/${request.id}`}>CR-{request.id} · {request.entity_type}</a></td><td class="px-4 py-3">{request.operation}</td><td class="px-4 py-3"><span class={`rounded-full px-2 py-1 text-xs font-semibold ${statusClass(request.status)}`}>{request.status}</span></td><td class="px-4 py-3 text-slate-600">{fmt(request.created_at)}</td></tr>)}</tbody></table>{mine.length === 0 && <p class="p-6 text-sm text-slate-500">You have not submitted any proposals.</p>}</div></section>
  </div>
</BaseLayout>
