---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import LabActionButton from '../../../components/lab/LabActionButton.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import { listAllChangeRequests, listUserChangeRequests, getChangeRequestPresentation } from '../../../lib/lab/changeRequests';
import { canReviewLabChangeRequests } from '../../../lib/permissions';
import type { Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;
const management = canReviewLabChangeRequests(role);
const requests = management ? listAllChangeRequests() : listUserChangeRequests(user.userId);
const title = management ? 'All contributor change requests' : 'My change requests';
const fmt = (value: string | null) => value ? value.replace('T', ' ').slice(0, 16) : '—';
const statusClass = (status: string) => status === 'APPROVED' ? 'bg-emerald-100 text-emerald-700' : status === 'REJECTED' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700';
---
<BaseLayout title="Laboratory Change Requests">
  <div class="space-y-6">
    <Breadcrumbs items={[{ label: 'QC Tasks' }, { label: 'Laboratory', href: '/lab' }, { label: 'Change Requests' }]} />
    <header class="flex flex-wrap items-start justify-between gap-4">
      <div><p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Governance</p><h1 class="mt-1 text-3xl font-semibold text-slate-900">Change Requests</h1><p class="mt-1 max-w-3xl text-sm text-slate-600">{management ? 'Review every contributor proposal from one shared queue.' : 'Track only the proposals you submitted. Other contributors’ private pending proposals are not visible.'}</p></div>
      <a href="/lab/change-requests/new" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">New proposal</a>
    </header>
    <LabSecondaryNav items={labNavForRole(role)} currentPath="/lab/change-requests" />

    <section class="space-y-3" aria-labelledby="requests-heading"><h2 id="requests-heading" class="text-xl font-semibold text-slate-900">{title} ({requests.length})</h2><div class="divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white md:hidden">{requests.map((request) => { const presentation = getChangeRequestPresentation(request.id); return <article class="space-y-3 p-4"><div class="flex items-start justify-between gap-3"><div><a class="font-semibold text-brand-700 hover:underline" href={`/lab/change-requests/${request.id}`}>CR-{request.id}</a><p class="mt-1 text-sm text-slate-700">{presentation?.target_label ?? '—'}</p></div><span class={`rounded-full border px-2.5 py-1 text-xs font-semibold ${statusClass(request.status)}`}>{request.status}</span></div><dl class="grid grid-cols-2 gap-3 text-sm"><div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Requester</dt><dd class="mt-1 break-words">{request.requested_by_name ?? `User #${request.requested_by}`}</dd></div><div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Submitted</dt><dd class="mt-1" dir="ltr">{fmt(request.created_at)}</dd></div><div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Conflict</dt><dd class="mt-1">{request.operation === 'UPDATE' ? (presentation?.stale ? 'Conflict' : 'Current') : '—'}</dd></div><div><dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Review reason</dt><dd class="mt-1 break-words">{request.review_note ?? '—'}</dd></div></dl><LabActionButton href={`/lab/change-requests/${request.id}`} kind="secondary">Open Request</LabActionButton></article>; })}{requests.length === 0 && <p class="p-6 text-sm text-slate-500">No change requests are available for this view.</p>}</div><div class="hidden overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm md:block"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th scope="col" class="px-4 py-3">Request ID</th><th scope="col" class="px-4 py-3">Entity</th><th scope="col" class="px-4 py-3">Operation</th><th scope="col" class="px-4 py-3">Target</th><th scope="col" class="px-4 py-3">Requested By</th><th scope="col" class="px-4 py-3">Requester Role</th><th scope="col" class="px-4 py-3">Submitted At</th><th scope="col" class="px-4 py-3">Status</th><th scope="col" class="px-4 py-3">Reviewer</th><th scope="col" class="px-4 py-3">Reviewed At</th><th scope="col" class="px-4 py-3">Review Note</th><th scope="col" class="px-4 py-3">Stale / Conflict</th></tr></thead><tbody class="divide-y divide-slate-100">{requests.map((request) => { const presentation = getChangeRequestPresentation(request.id); return <tr><td class="px-4 py-3 font-medium"><a class="text-brand-700 hover:underline" href={`/lab/change-requests/${request.id}`}>CR-{request.id}</a></td><td class="px-4 py-3">{request.entity_type}</td><td class="px-4 py-3">{request.operation}</td><td class="px-4 py-3">{presentation?.target_label ?? '—'}</td><td class="px-4 py-3">{request.requested_by_name ?? `User #${request.requested_by}`}</td><td class="px-4 py-3">{request.requested_by_role ?? '—'}</td><td class="px-4 py-3 text-slate-600">{fmt(request.created_at)}</td><td class="px-4 py-3"><span class={`rounded-full border px-2.5 py-1 text-xs font-semibold ${statusClass(request.status)}`}>{request.status}</span></td><td class="px-4 py-3">{request.reviewed_by_name ?? '—'}</td><td class="px-4 py-3 text-slate-600">{fmt(request.reviewed_at)}</td><td class="max-w-xs px-4 py-3 text-slate-600">{request.review_note ?? '—'}</td><td class="px-4 py-3">{request.operation === 'UPDATE' ? (presentation?.stale ? <span class="font-semibold text-red-700">Conflict</span> : <span class="text-emerald-700">Current</span>) : <span class="text-slate-500">—</span>}</td></tr>; })}</tbody></table>{requests.length === 0 && <p class="p-6 text-sm text-slate-500">No change requests are available for this view.</p>}</div></section>
  </div>
</BaseLayout>
