---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../components/lab/LabSecondaryNav.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import AppButton from '../../components/ui/AppButton.astro';
import Banner from '../../components/ui/Banner.astro';
import { labNavForRole } from '../../lib/lab/navigation';
import { canViewLabManagementDashboard } from '../../lib/permissions';
import { getLabManagementDashboard, type LabManagementDashboard } from '../../lib/lab/management';
import type { Role } from '../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;
if (!canViewLabManagementDashboard(role)) return Astro.redirect('/lab');

let data: LabManagementDashboard | null = null;
let dataError: string | null = null;
try {
  data = getLabManagementDashboard();
} catch (error) {
  console.error('[lab/management] dashboard query failure', error);
  dataError = 'Could not load the management dashboard. Try reloading — if the problem persists, contact an administrator.';
}

const dashboard = data ?? {
  attention: { approvalQueue: 0, pendingChangeRequests: 0, waitingOver24h: 0, rejectedChanges: 0 },
  risk: { overdueCalibration: 0, dueSoonCalibration: 0, equipmentAttention: 0, documentsInReview: 0, documentsOverdue: 0, pendingAcknowledgements: 0, wiTotal: 0, wiWithContent: 0 },
  quality: { failTests: 0, holdTests: 0, openRetests: 0, completedRetests: 0, dataQualityIssues: 0, failHoldTrend: [] },
  assurance: { recentAuditEvents: 0, audit: { task: { status: 'PASS' }, qcLab: { status: 'PASS' }, lastVerifiedAt: null } },
} satisfies LabManagementDashboard;

const card = (label: string, value: number, href: string, tone = 'border-slate-200 bg-white text-slate-900') => ({ label, value, href, tone });
const attentionCards = [
  card('Approval Queue', dashboard.attention.approvalQueue, '/lab/tests/review?status=UNDER_REVIEW', 'border-amber-200 bg-amber-50/60 text-amber-950'),
  card('Change Requests', dashboard.attention.pendingChangeRequests, '/lab/change-requests?status=PENDING', 'border-amber-200 bg-amber-50/60 text-amber-950'),
  card('Waiting >24h', dashboard.attention.waitingOver24h, '/lab/change-requests?status=PENDING&aging=24h', 'border-orange-200 bg-orange-50/60 text-orange-950'),
  card('Rejected Contributor Changes', dashboard.attention.rejectedChanges, '/lab/change-requests?status=REJECTED', 'border-red-200 bg-red-50/50 text-red-950'),
];
const riskCards = [
  card('Overdue Calibration', dashboard.risk.overdueCalibration, '/lab/calibration?status=OVERDUE', 'border-red-200 bg-red-50/50 text-red-950'),
  card('Calibration Due Soon', dashboard.risk.dueSoonCalibration, '/lab/calibration?due=1', 'border-amber-200 bg-amber-50/60 text-amber-950'),
  card('Equipment Attention', dashboard.risk.equipmentAttention, '/lab/equipment?attention=1', 'border-rose-200 bg-rose-50/50 text-rose-950'),
  card('Documents In Review', dashboard.risk.documentsInReview, '/lab/documents?status=IN_REVIEW', 'border-sky-200 bg-sky-50/50 text-sky-950'),
  card('Documents Overdue', dashboard.risk.documentsOverdue, '/lab/documents?review=overdue', 'border-orange-200 bg-orange-50/60 text-orange-950'),
  card('Pending Acknowledgements', dashboard.risk.pendingAcknowledgements, '/lab/acknowledgements', 'border-indigo-200 bg-indigo-50/50 text-indigo-950'),
];
const qualityCards = [
  card('FAIL Tests', dashboard.quality.failTests, '/lab/tests?result=FAIL', 'border-red-200 bg-red-50/50 text-red-950'),
  card('HOLD Tests', dashboard.quality.holdTests, '/lab/tests?result=HOLD', 'border-orange-200 bg-orange-50/60 text-orange-950'),
  card('Open Retests', dashboard.quality.openRetests, '/lab/retests?status=OPEN', 'border-orange-200 bg-orange-50/60 text-orange-950'),
  card('Completed Retests', dashboard.quality.completedRetests, '/lab/retests?status=COMPLETED', 'border-emerald-200 bg-emerald-50/60 text-emerald-950'),
  card('Data Quality', dashboard.quality.dataQualityIssues, '/lab/data-quality', 'border-red-200 bg-red-50/50 text-red-950'),
];
const maxTrend = Math.max(1, ...dashboard.quality.failHoldTrend.map((point) => Math.max(point.fail, point.hold)));
---

<BaseLayout title="Laboratory Management">
  <div class="space-y-6">
    <Breadcrumbs items={[{ label: 'QC Tasks' }, { label: 'Laboratory', href: '/lab' }, { label: 'Management' }]} />
    <PageHeader eyebrow="QC Laboratory — Management" title="Laboratory Management" description="Action queues, operational risk, quality outcomes, and assurance signals from the live laboratory registers." />
    <LabSecondaryNav items={labNavForRole(role)} currentPath="/lab/management" />

    {dataError && <Banner tone="error">{dataError}</Banner>}

    <section aria-labelledby="attention-heading" class="space-y-3">
      <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Needs your attention</p><h2 id="attention-heading" class="mt-1 text-xl font-semibold text-slate-900">Approval and contributor queues</h2></div><AppButton href="/lab" variant="secondary">Back to Command Center</AppButton></div>
      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        {attentionCards.map((item) => <a data-management-card href={item.href} class={`rounded-xl border p-4 shadow-sm transition-shadow duration-qc-standard ease-qc-standard hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 ${item.tone}`}><span class="block text-3xl font-semibold tabular-nums" dir="ltr">{item.value.toLocaleString('en-US')}</span><span class="mt-1 block text-sm font-semibold">{item.label}</span><span class="mt-3 block text-xs font-medium underline decoration-current/30 underline-offset-2">Open filtered register</span></a>)}
      </div>
    </section>

    <section aria-labelledby="risk-heading" class="space-y-3"><div><p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Operational risk</p><h2 id="risk-heading" class="mt-1 text-xl font-semibold text-slate-900">Calibration, equipment, and documents</h2></div><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">{riskCards.map((item) => <a data-management-card href={item.href} class={`rounded-xl border p-4 shadow-sm transition-shadow duration-qc-standard ease-qc-standard hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 ${item.tone}`}><span class="block text-2xl font-semibold tabular-nums" dir="ltr">{item.value.toLocaleString('en-US')}</span><span class="mt-1 block text-sm font-semibold">{item.label}</span></a>)}</div><div class="rounded-xl border border-indigo-200 bg-indigo-50/50 p-4"><div class="flex flex-wrap items-center justify-between gap-3"><div><h3 class="font-semibold text-slate-900">WI completion</h3><p class="mt-1 text-sm text-slate-600"><span dir="ltr">{dashboard.risk.wiWithContent}</span> of <span dir="ltr">{dashboard.risk.wiTotal}</span> WIs have content.</p></div><a class="text-sm font-semibold text-indigo-700 underline" href="/lab/documents?type=WI">Open WI register</a></div><progress class="mt-3 h-2 w-full accent-indigo-600" max={Math.max(1, dashboard.risk.wiTotal)} value={dashboard.risk.wiWithContent} aria-label="WI content completion">{dashboard.risk.wiWithContent}</progress></div></section>

    <section aria-labelledby="quality-heading" class="space-y-3"><div><p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Quality outcomes</p><h2 id="quality-heading" class="mt-1 text-xl font-semibold text-slate-900">Results and retest workload</h2></div><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">{qualityCards.map((item) => <a data-management-card href={item.href} class={`rounded-xl border p-4 shadow-sm transition-shadow duration-qc-standard ease-qc-standard hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 ${item.tone}`}><span class="block text-2xl font-semibold tabular-nums" dir="ltr">{item.value.toLocaleString('en-US')}</span><span class="mt-1 block text-sm font-semibold">{item.label}</span></a>)}</div><div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm"><table class="min-w-full text-sm"><caption class="sr-only">FAIL and HOLD tests by week</caption><thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-600"><tr><th scope="col" class="px-4 py-2.5">Week</th><th scope="col" class="px-4 py-2.5">FAIL</th><th scope="col" class="px-4 py-2.5">HOLD</th></tr></thead><tbody class="divide-y divide-slate-100">{dashboard.quality.failHoldTrend.map((point) => <tr><th scope="row" class="whitespace-nowrap px-4 py-2.5 font-medium" dir="ltr">{point.week}</th><td class="px-4 py-2.5"><a class="font-semibold text-red-700 underline" href="/lab/tests?result=FAIL">{point.fail}</a><span class="ml-3 inline-block h-2 rounded-full bg-red-500 align-middle" style={`width:${Math.max(2, Math.round((point.fail / maxTrend) * 120))}px`} aria-hidden="true"></span></td><td class="px-4 py-2.5"><a class="font-semibold text-orange-700 underline" href="/lab/tests?result=HOLD">{point.hold}</a><span class="ml-3 inline-block h-2 rounded-full bg-orange-500 align-middle" style={`width:${Math.max(2, Math.round((point.hold / maxTrend) * 120))}px`} aria-hidden="true"></span></td></tr>)}</tbody></table>{dashboard.quality.failHoldTrend.length === 0 && <p class="p-5 text-sm text-slate-600">No dated FAIL or HOLD results are recorded yet.</p>}</div></section>

    <section aria-labelledby="assurance-heading" class="space-y-3"><div><p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Assurance</p><h2 id="assurance-heading" class="mt-1 text-xl font-semibold text-slate-900">Audit and system health</h2></div><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"><a data-management-card href="/lab/audit" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:border-brand-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-600"><span class="block text-2xl font-semibold tabular-nums" dir="ltr">{dashboard.assurance.recentAuditEvents}</span><span class="mt-1 block text-sm font-semibold text-slate-900">Lab audit events in the last 7 days</span><span class="mt-3 block text-xs font-medium text-brand-700 underline">Open Audit Timeline</span></a><div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><span class={`inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${dashboard.assurance.audit.qcLab.status === 'PASS' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}`}>{dashboard.assurance.audit.qcLab.status}</span><h3 class="mt-3 font-semibold text-slate-900">QC audit chain</h3><p class="mt-1 text-sm text-slate-600">Read-only integrity status for the shared laboratory audit log.</p></div>{role === 'admin' && <a data-management-card href="/admin/system-health" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:border-brand-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-600"><span class="block text-sm font-semibold text-slate-900">System Health</span><span class="mt-1 block text-sm text-slate-600">Database, backups, migration, and provider diagnostics.</span><span class="mt-3 block text-xs font-medium text-brand-700 underline">Open system health</span></a>}</div></section>
  </div>
</BaseLayout>
