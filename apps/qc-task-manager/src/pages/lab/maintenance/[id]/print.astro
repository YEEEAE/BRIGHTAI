---
// /lab/maintenance/[id]/print — controlled maintenance record print view.
// Same print architecture as /lab/tests/[id]/print: server-rendered A4 via
// PrintLayout (no chrome), one loader (getLabEquipmentMaintenanceDetail) shared
// with nothing fabricated — maintenance events are append-only, every printed
// value is the stored verbatim value. Route lives under /lab/maintenance/[id]
// because maintenance events have no standalone detail page; the source list
// is /lab/equipment/[id]/maintenance (linked back via backHref).
import PrintLayout from '../../../../layouts/PrintLayout.astro';
import { getLabEquipmentMaintenanceDetail } from '../../../../lib/lab/equipment';
import { LAB_MAINTENANCE_STATUS_LABELS } from '../../../../lib/lab/policy';
import { labQrPayload, labQrSvg, labSiteOrigin } from '../../../../lib/lab/qrcodes';

const idParam = Astro.params.id;
const id = idParam ? Number(idParam) : Number.NaN;
const validId = Number.isInteger(id) && id > 0;

let detail: ReturnType<typeof getLabEquipmentMaintenanceDetail> = null;
let loadError: string | null = null;
if (validId) {
  try {
    detail = getLabEquipmentMaintenanceDetail(id);
  } catch (err) {
    console.error('[lab] maintenance print load failure', err);
    loadError = 'Could not load this maintenance record for printing.';
  }
}

function fmt(value: unknown): string {
  return value == null || String(value).trim() === '' ? '—' : String(value);
}
const statusLabel = (status: string | null) =>
  status ? (LAB_MAINTENANCE_STATUS_LABELS[status as keyof typeof LAB_MAINTENANCE_STATUS_LABELS] ?? status) : '—';
const qrSvg = detail ? labQrSvg(labQrPayload(`MAINT-${detail.maintenance.id}`, `${labSiteOrigin(Astro.url.origin)}/lab/maintenance/${detail.maintenance.id}`), `QR: MAINT-${detail.maintenance.id}`) : '';
---

<PrintLayout
  title={detail ? `Maintenance · ${detail.equipment_code}` : 'Maintenance record not found'}
  backHref={detail ? `/lab/equipment/${String(detail.equipment_id)}/maintenance` : ''}
  recordType="Equipment maintenance"
  recordId={detail ? String(detail.maintenance.id) : '—'}
  authorization="Logged-by actor and maintenance workflow"
  signature="Maintenance completion metadata where recorded"
  sourceReference={detail ? `${detail.equipment_code} · lab_equipment_maintenance` : 'lab_equipment_maintenance'}
  qrSvg={qrSvg}
>
  {!detail ? (
    <section>
      <h1 class="print-title">Maintenance record not found</h1>
      <p>{loadError ?? 'This maintenance record does not exist or is not available to you.'}</p>
    </section>
  ) : (
    <>
      <header class="print-header">
        <div>
          <h1 class="print-title">QC Laboratory</h1>
          <div class="print-sub">Maintenance Record</div>
        </div>
        <div class="print-meta">
          <div><strong>Record ID:</strong> {String(detail.maintenance.id)}</div>
          <div><strong>Equipment:</strong> {detail.equipment_name} ({detail.equipment_code})</div>
          <div><strong>Status:</strong> {statusLabel(detail.maintenance.status)}</div>
        </div>
      </header>

      <section class="print-section">
        <h2 class="print-section-title">1 · Equipment</h2>
        <dl class="print-section-body grid2">
          <div class="dl-item"><dt>Equipment Name</dt><dd>{fmt(detail.equipment_name)}</dd></div>
          <div class="dl-item"><dt>Equipment Code</dt><dd>{fmt(detail.equipment_code)}</dd></div>
          <div class="dl-item"><dt>Equipment Record ID</dt><dd>{String(detail.equipment_id)}</dd></div>
        </dl>
      </section>

      <section class="print-section">
        <h2 class="print-section-title">2 · Maintenance Event</h2>
        <dl class="print-section-body grid2">
          <div class="dl-item"><dt>Maintenance Date</dt><dd>{fmt(detail.maintenance.maintenance_date)}</dd></div>
          <div class="dl-item"><dt>Maintenance Type</dt><dd>{fmt(detail.maintenance.maintenance_type)}</dd></div>
          <div class="dl-item"><dt>Issue</dt><dd>{fmt(detail.maintenance.issue)}</dd></div>
          <div class="dl-item"><dt>Technician / Vendor</dt><dd>{fmt(detail.maintenance.technician_vendor)}</dd></div>
          <div class="dl-item"><dt>Status</dt><dd>{statusLabel(detail.maintenance.status)}</dd></div>
          <div class="dl-item"><dt>Completed Date</dt><dd>{fmt(detail.maintenance.completed_date)}</dd></div>
        </dl>
      </section>

      {detail.maintenance.description ? (
        <section class="print-section">
          <h2 class="print-section-title">3 · Description</h2>
          <div class="print-section-body remark-text">{String(detail.maintenance.description)}</div>
        </section>
      ) : null}

      {detail.maintenance.notes ? (
        <section class="print-section">
          <h2 class="print-section-title">{detail.maintenance.description ? '4' : '3'} · Notes</h2>
          <div class="print-section-body remark-text">{String(detail.maintenance.notes)}</div>
        </section>
      ) : null}

      <section class="print-section">
        <h2 class="print-section-title">Record Origin</h2>
        <dl class="print-section-body grid3">
          <div class="dl-item"><dt>Logged By</dt><dd>{fmt(detail.created_by_name)}</dd></div>
          <div class="dl-item"><dt>Logged At</dt><dd>{fmt(detail.maintenance.created_at)}</dd></div>
          <div class="dl-item"><dt>Event Nature</dt><dd>Append-only (no edits or deletes)</dd></div>
        </dl>
      </section>

      <section class="print-section">
        <h2 class="print-section-title">Controlled Version Metadata</h2>
        <dl class="print-section-body grid3">
          <div class="dl-item"><dt>Record ID</dt><dd>{String(detail.maintenance.id)}</dd></div>
          <div class="dl-item"><dt>Created</dt><dd>{fmt(detail.maintenance.created_at)}</dd></div>
          <div class="dl-item"><dt>Status</dt><dd>{statusLabel(detail.maintenance.status)}</dd></div>
        </dl>
      </section>
    </>
  )}
</PrintLayout>
