---
// /lab/notifications — QC Laboratory notifications (PROMPT 26).
//
// A lab-filtered view over the SAME notifications table as /notifications and
// the navbar bell — never a second system. Data comes from listLabNotifications
// (src/lib/notifications.ts), which selects only the lab kinds. Read state uses
// the same is_read column: marking a notification read here also clears it from
// the global page and the badge (and vice-versa). Each row links to its real
// source record via entity_href (migration 022).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EmptyState from '../../components/EmptyState.astro';
import LabSecondaryNav from '../../components/lab/LabSecondaryNav.astro';
import MarkAllReadButton from '../../components/MarkAllReadButton';
import NotificationCard from '../../components/NotificationCard.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Banner from '../../components/ui/Banner.astro';
import {
  NOTIFICATION_KIND_ICON,
  NOTIFICATION_KIND_LABEL,
  groupNotificationsByKind,
  orderedNotificationKinds,
} from '../../components/ui/notificationPresentation';
import { labNavForRole } from '../../lib/lab/navigation';
import { listLabNotifications } from '../../lib/notifications';
import type { Role } from '../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;
const navItems = labNavForRole(role);

// All / Unread filter — plain query param, server-rendered (no JS needed).
const filter = Astro.url.searchParams.get('filter') === 'unread' ? 'unread' : 'all';

let dataError: string | null = null;
let notifications: ReturnType<typeof listLabNotifications>['notifications'] = [];
let unread = 0;
let total = 0;
try {
  const result = listLabNotifications(user.userId, { unreadOnly: filter === 'unread' });
  notifications = result.notifications;
  unread = result.unread;
  total = result.total;
} catch (err) {
  console.error('[lab] notifications query failure', err);
  dataError = 'Could not load your notifications. Try reloading — if the problem persists, contact an administrator.';
}

const grouped = groupNotificationsByKind(notifications);
const orderedKinds = orderedNotificationKinds(grouped);
---

<BaseLayout title="Lab Notifications">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Notifications' },
      ]}
    />

    <PageHeader
      eyebrow="QC Laboratory — Overview"
      title="Notifications"
      description="Laboratory alerts — review requests, rejections, approvals, document reviews and acknowledgements, calibration reminders, maintenance events and retest updates. Read state is shared with the global notifications page and the navbar badge."
    >
      <fragment slot="actions">
        {!dataError && total > 0 && <MarkAllReadButton client:visible redirectTo="/lab/notifications" />}
      </fragment>
    </PageHeader>

    <LabSecondaryNav items={navItems} currentPath="/lab/notifications" />

    {dataError && <Banner tone="error">{dataError}</Banner>}

    {!dataError && (
      <>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <nav aria-label="Notification filter" class="flex gap-1 rounded-lg border border-slate-200 bg-white p-1">
            <a
              href="/lab/notifications"
              aria-current={filter === 'all' ? 'page' : undefined}
              class={`rounded-md px-3 py-1.5 text-sm font-medium ${
                filter === 'all' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-100'
              }`}
            >
              All ({total})
            </a>
            <a
              href="/lab/notifications?filter=unread"
              aria-current={filter === 'unread' ? 'page' : undefined}
              class={`rounded-md px-3 py-1.5 text-sm font-medium ${
                filter === 'unread' ? 'bg-brand-600 text-white' : 'text-slate-600 hover:bg-slate-100'
              }`}
            >
              Unread ({unread})
            </a>
          </nav>
          <p class="text-xs text-slate-500">Showing the {notifications.length} most recent</p>
        </div>

        {notifications.length === 0 ? (
          <EmptyState
            title={filter === 'unread' ? 'No unread laboratory notifications 🎉' : 'No laboratory notifications yet 🎉'}
            hint={
              filter === 'unread'
                ? 'You have read every laboratory alert. Switch to “All” to see the full history.'
                : 'Alerts about test reviews, approvals, documents, calibration, maintenance and retests will appear here.'
            }
            ctaHref="/lab"
            ctaLabel="Back to Laboratory"
          />
        ) : (
          orderedKinds.map((kind) => (
            <section aria-labelledby={`lab-section-${kind}`}>
              <h2
                id={`lab-section-${kind}`}
                class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-slate-500"
              >
                <span aria-hidden="true">{NOTIFICATION_KIND_ICON[kind] ?? '🔔'}</span>
                {NOTIFICATION_KIND_LABEL[kind] ?? kind}
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">
                  {grouped.get(kind)!.length}
                </span>
              </h2>
              <ul class="space-y-2">
                {grouped.get(kind)!.map((n) => (
                  <li>
                    <NotificationCard notification={n} notificationId={n.id} />
                  </li>
                ))}
              </ul>
            </section>
          ))
        )}
      </>
    )}
  </div>
</BaseLayout>
