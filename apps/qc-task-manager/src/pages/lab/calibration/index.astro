---
// /lab/calibration — QC Laboratory Calibration Register (PROMPT 37).
//
// Server-rendered register of dated calibration records (equipment, last
// calibration date, calibration due date, provider, certificate reference,
// result, next due date, status, notes). The six-state status is derived per
// row at read time (Compliant / Due Soon / Due Today / Overdue / Not
// Compliant / Unknown) — it is never stored. Missing data stays null and
// renders as "—". Server-side search, safe sorting and pagination live in
// src/lib/lab/calibration.ts — the URL is the source of truth, every SQL
// value is a bound parameter, and sorting is a whitelisted union. Employees
// may view; only manager+ get New / Edit affordances (canCreateLabCalibration
// / canEditLabCalibration).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import LabSaveViewForm from '../../../components/lab/LabSaveViewForm.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import {
  hasLabCalibrationFilters,
  labCalibrationFiltersToQuery,
  parseLabCalibrationSearchFilters,
  searchLabCalibration,
  LAB_CALIBRATION_PER_PAGE_OPTIONS,
  LAB_CALIBRATION_STATUS_LABELS,
  LAB_CALIBRATION_STATUSES,
  type LabCalibrationSearchFilters,
  type LabCalibrationSortField,
  type LabCalibrationStatus,
} from '../../../lib/lab/calibration';
import { canCreateLabCalibration, canEditLabCalibration, canProposeLabCalibrationCreate, canProposeLabCalibrationEdit } from '../../../lib/permissions';
import type { Role } from '../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;

const navItems = labNavForRole(role);
const filters: LabCalibrationSearchFilters = parseLabCalibrationSearchFilters(Astro.url);

let dataError: string | null = null;
let result: ReturnType<typeof searchLabCalibration> = {
  rows: [],
  total: 0,
  page: 1,
  per_page: 25,
  total_pages: 1,
};
try {
  result = searchLabCalibration(filters);
} catch (err) {
  console.error('[lab] calibration register query failure', err);
  dataError = 'Could not load the Calibration Register. Try reloading — if the problem persists, contact an administrator.';
}

const filtered = hasLabCalibrationFilters(filters);

const qsParams = new URLSearchParams(labCalibrationFiltersToQuery({ ...filters, page: 1 }).replace(/^\?/, ''));

function pageHref(p: number): string {
  const sp = new URLSearchParams(qsParams);
  if (p > 1) sp.set('page', String(p));
  else sp.delete('page');
  const qs = sp.toString();
  return qs ? `/lab/calibration?${qs}` : '/lab/calibration';
}

function sortHref(field: LabCalibrationSortField): string {
  const next: LabCalibrationSearchFilters = {
    ...filters,
    sort: field,
    dir: (filters.sort === field && filters.dir === 'asc' ? 'desc' : 'asc') as 'asc' | 'desc',
    page: 1,
  };
  return `/lab/calibration${labCalibrationFiltersToQuery(next)}`;
}

function sortArrow(field: LabCalibrationSortField): string {
  if (filters.sort !== field) return '';
  return filters.dir === 'asc' ? ' ▲' : ' ▼';
}

const SORTABLE: { field: LabCalibrationSortField; label: string }[] = [
  { field: 'created_at', label: 'Recorded' },
  { field: 'equipment_code', label: 'Equipment' },
  { field: 'last_calibrated_at', label: 'Last Calibrated' },
  { field: 'due_date', label: 'Due Date' },
  { field: 'provider', label: 'Provider' },
  { field: 'certificate_reference', label: 'Certificate' },
  { field: 'result', label: 'Result' },
  { field: 'status', label: 'Status' },
];

function th(field: LabCalibrationSortField, label: string): string {
  return `<a href="${sortHref(field)}" class="inline-flex items-center gap-1 hover:text-slate-900">${label}${sortArrow(field)}</a>`;
}

const pageNumbers: number[] = [];
{
  const total = result.total_pages;
  const cur = result.page;
  let start = Math.max(1, cur - 3);
  let end = Math.min(total, cur + 3);
  if (end - start < 6) {
    if (start === 1) end = Math.min(total, start + 6);
    else start = Math.max(1, end - 6);
  }
  for (let p = start; p <= end; p++) pageNumbers.push(p);
}

const STATUS_BADGE_CLS: Record<LabCalibrationStatus, string> = {
  COMPLIANT: 'bg-emerald-100 text-emerald-800',
  DUE_SOON: 'bg-amber-100 text-amber-800',
  DUE_TODAY: 'bg-orange-100 text-orange-800',
  OVERDUE: 'bg-rose-100 text-rose-800',
  NOT_COMPLIANT: 'bg-red-100 text-red-800',
  UNKNOWN: 'bg-slate-100 text-slate-700',
};

function statusBadge(status: LabCalibrationStatus): string {
  return `<span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${STATUS_BADGE_CLS[status]}">${LAB_CALIBRATION_STATUS_LABELS[status]}</span>`;
}

function fmt(value: unknown): string {
  return value == null || String(value).trim() === '' ? '—' : String(value);
}
---

<BaseLayout title="Calibration Register">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Calibration' },
      ]}
    />

    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Master Data</p>
        <h1 class="mt-1 text-3xl font-semibold text-slate-900">Calibration Register</h1>
        <p class="mt-1 max-w-3xl text-sm text-slate-600">
          Dated calibration records for laboratory equipment. Status (Compliant / Due Soon / Due Today / Overdue / Not Compliant /
          Unknown) is derived from the dates and result at read time — missing data is shown as —, never auto-filled.
        </p>
      </div>
      {(canCreateLabCalibration(role) || canProposeLabCalibrationCreate(role)) && (
        <a
          href="/lab/calibration/new"
          class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
        >
          New Calibration Record
        </a>
      )}
    </header>

    <LabSecondaryNav items={navItems} currentPath="/lab/calibration" />

    {dataError && (
      <div role="alert" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {dataError}
      </div>
    )}

    {!dataError && (
      <>
        <form method="get" action="/lab/calibration" class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
          <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Search
              <input
                type="search"
                name="q"
                value={filters.q ?? ''}
                placeholder="Equipment code / name, provider, certificate…"
                class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
              />
            </label>
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Status
              <select name="status" class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="">All statuses</option>
                {LAB_CALIBRATION_STATUSES.map((s) => (
                  <option value={s} selected={filters.status === s}>{LAB_CALIBRATION_STATUS_LABELS[s]}</option>
                ))}
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Attention
              <select name="due" class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                <option value="">All records</option>
                <option value="1" selected={filters.due === '1'}>Due today or within 30 days</option>
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm font-medium text-slate-700">
              Per page
              <select name="per" class="mt-0.5 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500">
                {LAB_CALIBRATION_PER_PAGE_OPTIONS.map((n) => (
                  <option value={n} selected={filters.per_page === n}>{n} per page</option>
                ))}
              </select>
            </label>
          </div>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">Apply filters</button>
            <a href="/lab/calibration" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">Reset</a>
          </div>
        </form>

        <LabSaveViewForm path="/lab/calibration" />

        <p class="text-sm text-slate-600">
          {result.total.toLocaleString('en-US')} calibration record{result.total === 1 ? '' : 's'} found
          {filtered && <span> (filtered — <a href="/lab/calibration" class="text-brand-600 hover:underline">clear all</a>)</span>}
        </p>

        {result.rows.length === 0 ? (
          <EmptyState
            title={filtered ? 'No calibration records match your search' : 'No calibration records yet'}
            hint={filtered ? 'Try adjusting the search or clearing the filters.' : 'Dated calibration records appear here as they are logged — nothing is fabricated.'}
            ctaHref={filtered ? '/lab/calibration' : canCreateLabCalibration(role) ? '/lab/calibration/new' : '/lab/equipment'}
            ctaLabel={filtered ? 'Clear filters' : 'New Calibration Record'}
          />
        ) : (
          <section aria-label="Calibration Register" class="rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto contain-layout contain-paint">
              <table class="min-w-[1100px] divide-y divide-slate-100 text-sm">
                <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    {SORTABLE.map((s) => (
                      <th scope="col" class="px-4 py-2.5 font-semibold" set:html={th(s.field, s.label)} />
                    ))}
                    <th scope="col" class="px-4 py-2.5 font-semibold">Notes</th>
                    <th scope="col" class="px-4 py-2.5 font-semibold"><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {result.rows.map((r) => (
                    <tr class="align-middle">
                      <td class="px-4 py-2 text-slate-500" dir="ltr">{r.created_at.slice(0, 10)}</td>
                      <td class="px-4 py-2">
                        <a href={`/lab/calibration/${r.id}`} class="font-medium text-brand-600 hover:underline">
                          <span dir="ltr">{r.equipment_code}</span>
                        </a>
                        <div class="text-xs text-slate-500">{r.equipment_name}</div>
                        {r.is_archived === 1 && <span class="ms-1 rounded-full bg-slate-200 px-2 py-0.5 text-xs font-semibold text-slate-500">Archived</span>}
                      </td>
                      <td class="px-4 py-2 whitespace-nowrap text-slate-700" dir="ltr">{fmt(r.last_calibrated_at)}</td>
                      <td class="px-4 py-2 whitespace-nowrap text-slate-700" dir="ltr">{fmt(r.due_date)}</td>
                      <td class="px-4 py-2 text-slate-700">{fmt(r.provider)}</td>
                      <td class="px-4 py-2 text-slate-700" dir="ltr">{fmt(r.certificate_reference)}</td>
                      <td class="px-4 py-2 text-slate-700">{fmt(r.result)}</td>
                      <td class="px-4 py-2" set:html={statusBadge(r.status)} />
                      <td class="px-4 py-2 max-w-[200px] truncate text-slate-600" title={r.notes ?? ''}>{r.notes ?? '—'}</td>
                      <td class="px-4 py-2">
                        <span class="flex items-center gap-2">
                          <a href={`/lab/calibration/${r.id}`} class="font-medium text-brand-600 hover:underline">View</a>
                          {(canEditLabCalibration(role) || canProposeLabCalibrationEdit(role)) && (
                            <a href={`/lab/calibration/${r.id}/edit`} class="font-medium text-slate-600 hover:underline">Edit</a>
                          )}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {result.total_pages > 1 && (
          <nav aria-label="Pagination" class="flex flex-wrap items-center justify-center gap-2">
            {result.page > 1 ? (
              <a href={pageHref(result.page - 1)} class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">← Prev</a>
            ) : (
              <span class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-400">← Prev</span>
            )}
            {pageNumbers.map((p) => (
              <a
                href={pageHref(p)}
                aria-current={p === result.page ? 'page' : undefined}
                class={`rounded-md px-3 py-1.5 text-sm font-medium ${
                  p === result.page ? 'bg-brand-600 text-white' : 'border border-slate-300 bg-white text-slate-700 hover:bg-slate-50'
                }`}
              >
                {p}
              </a>
            ))}
            {result.page < result.total_pages ? (
              <a href={pageHref(result.page + 1)} class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Next →</a>
            ) : (
              <span class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-400">Next →</span>
            )}
          </nav>
        )}
      </>
    )}
  </div>
</BaseLayout>
