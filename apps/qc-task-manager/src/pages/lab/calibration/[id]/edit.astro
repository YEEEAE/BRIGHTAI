---
// /lab/calibration/[id]/edit — edit a calibration record (PROMPT 37).
// Manager+ only (canEditLabCalibration); the shared form component posts to
// this same URL and the middleware short-circuits the POST.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import EmptyState from '../../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../../components/lab/LabSecondaryNav.astro';
import LabCalibrationForm from '../../../../components/lab/LabCalibrationForm.astro';
import { labNavForRole } from '../../../../lib/lab/navigation';
import { getLabCalibrationDetail, listLabEquipmentOptionsForCalibration } from '../../../../lib/lab/calibration';
import { canEditLabCalibration, canProposeLabCalibrationEdit } from '../../../../lib/permissions';
import { setFlash } from '../../../../lib/flash';
import type { Role } from '../../../../lib/types';

const user = Astro.locals.user!;
const role = user.role as Role;
const navItems = labNavForRole(role);

const id = Number(Astro.params.id);
let detail: ReturnType<typeof getLabCalibrationDetail> = null;
try {
  detail = getLabCalibrationDetail(id);
} catch (err) {
  console.error('[lab] calibration edit query failure', err);
}

if (detail && !canEditLabCalibration(role) && !canProposeLabCalibrationEdit(role)) {
  setFlash(Astro, 'error', 'You do not have permission to edit calibration records.');
  return Astro.redirect(`/lab/calibration/${id}`);
}

const equipmentOptions = listLabEquipmentOptionsForCalibration();
---

<BaseLayout title={detail ? `Edit Calibration · ${detail.equipment_code}` : 'Calibration record not found'}>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Calibration', href: '/lab/calibration' },
        ...(detail
          ? [
              { label: detail.equipment_code, href: `/lab/calibration/${detail.calibration.id}` },
              { label: 'Edit' },
            ]
          : []),
      ]}
    />

    {!detail ? (
      <EmptyState
        title="Calibration record not found"
        hint="This record does not exist — it may have been removed, or the link is stale."
        ctaHref="/lab/calibration"
        ctaLabel="Back to the Calibration Register"
      />
    ) : (
      <>
        <header>
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Master Data</p>
          <h1 class="mt-1 text-3xl font-semibold text-slate-900">Edit Calibration · {detail.equipment_code}</h1>
          <p class="mt-1 max-w-3xl text-sm text-slate-600">
            Update the calibration record. Changes are audited with an UPDATE entry and the derived status is recomputed on save.
          </p>
        </header>

        <LabSecondaryNav items={navItems} currentPath={`/lab/calibration/${detail.calibration.id}/edit`} />

        <LabCalibrationForm mode="edit" calibration={detail.calibration} equipmentOptions={equipmentOptions} isContributor={canProposeLabCalibrationEdit(role)} />
      </>
    )}
  </div>
</BaseLayout>
