---
// /lab/calibration/[id]/print — controlled calibration certificate/report
// print view. Same print architecture as /lab/tests/[id]/print: server-rendered
// A4 via PrintLayout (no navbar/dashboard chrome), reads the SAME loader as the
// calibration detail page (getLabCalibrationDetail) so the printed values match
// the stored record exactly. Derived status is labeled as derived — all stored
// fields print verbatim. Route-based extension (not a ?print query param) to
// mirror the existing test print route and reuse the /lab/* middleware wall.
import PrintLayout from '../../../../layouts/PrintLayout.astro';
import {
  getLabCalibrationAudit,
  getLabCalibrationDetail,
  LAB_CALIBRATION_STATUS_LABELS,
} from '../../../../lib/lab/calibration';

const idParam = Astro.params.id;
const id = idParam ? Number(idParam) : Number.NaN;
const validId = Number.isInteger(id) && id > 0;

let detail: ReturnType<typeof getLabCalibrationDetail> = null;
let loadError: string | null = null;
if (validId) {
  try {
    detail = getLabCalibrationDetail(id);
  } catch (err) {
    console.error('[lab] calibration print load failure', err);
    loadError = 'Could not load this calibration record for printing.';
  }
}
const audit = detail ? getLabCalibrationAudit(detail.calibration.equipment_id) : [];

function fmt(value: unknown): string {
  return value == null || String(value).trim() === '' ? '—' : String(value);
}
---

<PrintLayout
  title={detail ? `Calibration · ${detail.equipment_code}` : 'Calibration record not found'}
  backHref={detail ? `/lab/calibration/${String(detail.calibration.id)}` : ''}
  recordType="Equipment calibration"
  recordId={detail ? String(detail.calibration.id) : '—'}
  authorization="Recorded-by actor and calibration workflow"
  signature="Calibration approval metadata where recorded"
  sourceReference={detail ? `${detail.equipment_code} · lab_calibrations` : 'lab_calibrations'}
>
  {!detail ? (
    <section>
      <h1 class="print-title">Calibration record not found</h1>
      <p>{loadError ?? 'This calibration record does not exist or is not available to you.'}</p>
    </section>
  ) : (
    <>
      <header class="print-header">
        <div>
          <h1 class="print-title">QC Laboratory</h1>
          <div class="print-sub">Calibration Certificate / Report</div>
        </div>
        <div class="print-meta">
          <div><strong>Record ID:</strong> {String(detail.calibration.id)}</div>
          <div><strong>Equipment:</strong> {detail.equipment_name} ({detail.equipment_code})</div>
          <div><strong>Derived Status:</strong> {LAB_CALIBRATION_STATUS_LABELS[detail.status]}</div>
          {detail.is_archived === 1 && <div><strong>Equipment:</strong> Archived</div>}
        </div>
      </header>

      <section class="print-section">
        <h2 class="print-section-title">1 · Equipment</h2>
        <dl class="print-section-body grid2">
          <div class="dl-item"><dt>Equipment Name</dt><dd>{fmt(detail.equipment_name)}</dd></div>
          <div class="dl-item"><dt>Equipment Code</dt><dd>{fmt(detail.equipment_code)}</dd></div>
          <div class="dl-item"><dt>Certificate Reference</dt><dd>{fmt(detail.calibration.certificate_reference)}</dd></div>
          <div class="dl-item"><dt>Calibration Provider</dt><dd>{fmt(detail.calibration.provider)}</dd></div>
        </dl>
      </section>

      <section class="print-section">
        <h2 class="print-section-title">2 · Calibration Dates</h2>
        <dl class="print-section-body grid3">
          <div class="dl-item"><dt>Last Calibrated</dt><dd>{fmt(detail.calibration.last_calibrated_at)}</dd></div>
          <div class="dl-item"><dt>Calibration Due</dt><dd>{fmt(detail.calibration.calibration_due_at)}</dd></div>
          <div class="dl-item"><dt>Next Due</dt><dd>{fmt(detail.calibration.next_due_at)}</dd></div>
        </dl>
      </section>

      <section class="print-section">
        <h2 class="print-section-title">3 · Calibration Result</h2>
        <div class="print-section-body">
          <div class="final-result">{fmt(detail.calibration.result)}</div>
          <p class="print-sub">Result text is stored verbatim as supplied. Derived state: {LAB_CALIBRATION_STATUS_LABELS[detail.status]}.</p>
        </div>
      </section>

      {detail.calibration.notes ? (
        <section class="print-section">
          <h2 class="print-section-title">4 · Notes</h2>
          <div class="print-section-body remark-text">{String(detail.calibration.notes)}</div>
        </section>
      ) : null}

      <section class="print-section">
        <h2 class="print-section-title">{detail.calibration.notes ? '5' : '4'} · Record Origin</h2>
        <dl class="print-section-body grid3">
          <div class="dl-item"><dt>Recorded By</dt><dd>{fmt(detail.created_by_name)}</dd></div>
          <div class="dl-item"><dt>Recorded At</dt><dd>{fmt(detail.calibration.created_at)}</dd></div>
          <div class="dl-item"><dt>Equipment Record ID</dt><dd>{String(detail.calibration.equipment_id)}</dd></div>
        </dl>
      </section>

      {audit.length > 0 ? (
        <section class="print-section">
          <h2 class="print-section-title">Calibration Audit Trail (this equipment)</h2>
          <div class="print-section-body">
            <table>
              <thead>
                <tr>
                  <th scope="col">When</th>
                  <th scope="col">Actor</th>
                  <th scope="col">Action</th>
                  <th scope="col">Detail</th>
                </tr>
              </thead>
              <tbody>
                {audit.map((entry) => (
                  <tr>
                    <td>{String(entry.created_at)}</td>
                    <td>{String(entry.actor_name ?? '—')}</td>
                    <td>{String(entry.action)}</td>
                    <td>{String(entry.note ?? '—')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ) : null}

      <section class="print-section">
        <h2 class="print-section-title">Controlled Version Metadata</h2>
        <dl class="print-section-body grid3">
          <div class="dl-item"><dt>Record ID</dt><dd>{String(detail.calibration.id)}</dd></div>
          <div class="dl-item"><dt>Created</dt><dd>{fmt(detail.calibration.created_at)}</dd></div>
          <div class="dl-item"><dt>Derived Status</dt><dd>{LAB_CALIBRATION_STATUS_LABELS[detail.status]}</dd></div>
        </dl>
      </section>
    </>
  )}
</PrintLayout>
