---
// /lab/calibration/[id] — one calibration record (PROMPT 37): every field,
// the derived six-state status, the owning equipment, and the calibration
// audit trail for that device (shared qc_audit_log, newest first). Read-only
// for every role; manager+ get the Edit link (canEditLabCalibration).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmptyState from '../../../components/EmptyState.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import { getLabCalibrationAudit, getLabCalibrationDetail, LAB_CALIBRATION_STATUS_LABELS } from '../../../lib/lab/calibration';
import { canEditLabCalibration, canProposeLabCalibrationEdit } from '../../../lib/permissions';
import type { Role } from '../../../lib/types';
import { countPendingChangeRequests } from '../../../lib/lab/changeRequests';
import { canReviewLabChangeRequests } from '../../../lib/permissions';
import { CALIBRATION_STATUS_BADGE_CLS as STATUS_BADGE_CLS } from '../../../components/ui/labBadgeClasses';

const user = Astro.locals.user!;
const role = user.role as Role;
const navItems = labNavForRole(role);

const id = Number(Astro.params.id);
let detail: ReturnType<typeof getLabCalibrationDetail> = null;
let audit: Array<Record<string, unknown>> = [];
try {
  detail = getLabCalibrationDetail(id);
  if (detail) audit = getLabCalibrationAudit(detail.calibration.equipment_id);
} catch (err) {
  console.error('[lab] calibration detail query failure', err);
}
const pendingContributorChanges = detail
  ? countPendingChangeRequests('CALIBRATION', detail.calibration.id, canReviewLabChangeRequests(role) ? undefined : user.userId)
  : 0;

const sectionCls = 'rounded-xl border border-slate-200 bg-white p-5 shadow-sm';
const sectionTitleCls = 'text-base font-semibold text-slate-900';

function fmt(value: unknown): string {
  return value == null || String(value).trim() === '' ? '—' : String(value);
}

const ROWS: { label: string; value: unknown; ltr?: boolean }[] = detail
  ? [
      { label: 'Equipment', value: `${detail.equipment_name} (${detail.equipment_code})` },
      { label: 'Last Calibration Date', value: fmt(detail.calibration.last_calibrated_at), ltr: true },
      { label: 'Calibration Due Date', value: fmt(detail.calibration.calibration_due_at), ltr: true },
      { label: 'Next Due Date', value: fmt(detail.calibration.next_due_at), ltr: true },
      { label: 'Calibration Provider', value: fmt(detail.calibration.provider) },
      { label: 'Certificate Reference', value: fmt(detail.calibration.certificate_reference), ltr: true },
      { label: 'Calibration Result', value: fmt(detail.calibration.result) },
      { label: 'Recorded By', value: fmt(detail.created_by_name) },
      { label: 'Recorded At', value: String(detail.calibration.created_at), ltr: true },
    ]
  : [];
---

<BaseLayout title={detail ? `Calibration · ${detail.equipment_code}` : 'Calibration record not found'}>
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Calibration', href: '/lab/calibration' },
        ...(detail ? [{ label: `#${detail.calibration.id}` }] : []),
      ]}
    />

    {!detail ? (
      <EmptyState
        title="Calibration record not found"
        hint="This record does not exist — it may have been removed, or the link is stale."
        ctaHref="/lab/calibration"
        ctaLabel="Back to the Calibration Register"
      />
    ) : (
      <>
        <header class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">QC Laboratory — Master Data</p>
            <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">Calibration · {detail.equipment_name}</h1>
            <p class="mt-1 text-sm text-slate-600">
              Code <span class="font-medium text-slate-900" dir="ltr">{detail.equipment_code}</span>
              <span class={`ms-3 inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${STATUS_BADGE_CLS[detail.status]}`}>
                {LAB_CALIBRATION_STATUS_LABELS[detail.status]}
              </span>
              {detail.is_archived === 1 && (
                <span class="ms-2 inline-flex rounded-full bg-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-500">Archived</span>
              )}
            </p>
          </div>
          <div class="flex items-center gap-3">
            <a
              href={`/lab/calibration?equipment=${detail.calibration.equipment_id}`}
              class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
            >
              All records for this equipment
            </a>
            <a
              href={`/lab/calibration/${detail.calibration.id}/print`}
              class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
            >
              Print Certificate
            </a>
            {(canEditLabCalibration(role) || canProposeLabCalibrationEdit(role)) && (
              <a
                href={`/lab/calibration/${detail.calibration.id}/edit`}
                class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
              >
                Edit
              </a>
            )}
          </div>
        </header>

        <LabSecondaryNav items={navItems} currentPath={`/lab/calibration/${detail.calibration.id}`} />
        {pendingContributorChanges > 0 && (
          <div role="status" class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            Pending contributor changes: {pendingContributorChanges}
            {canReviewLabChangeRequests(role) && <a class="ms-2 font-semibold underline" href="/lab/change-requests">Review</a>}
          </div>
        )}

        <section aria-labelledby="sec-fields" class={sectionCls}>
          <h2 id="sec-fields" class={sectionTitleCls}>Calibration Details</h2>
          <dl class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {ROWS.map((row) => (
              <div class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm">
                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{row.label}</dt>
                <dd class="mt-1 font-medium text-slate-900" dir={row.ltr ? 'ltr' : undefined}>{String(row.value)}</dd>
              </div>
            ))}
          </dl>
          {detail.calibration.notes && (
            <div class="mt-4 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Notes</p>
              <p class="mt-1 whitespace-pre-wrap text-slate-900">{detail.calibration.notes}</p>
            </div>
          )}
        </section>

        <section aria-labelledby="sec-audit" class={sectionCls}>
          <h2 id="sec-audit" class={sectionTitleCls}>Calibration Audit Trail</h2>
          {audit.length === 0 ? (
            <p class="mt-2 text-sm text-slate-600">No calibration changes have been audited yet.</p>
          ) : (
            <div class="mt-3 overflow-x-auto contain-layout contain-paint">
              <table class="min-w-[640px] divide-y divide-slate-100 text-sm">
                <thead class="text-left text-xs uppercase tracking-wide text-slate-500">
                  <tr>
                    <th scope="col" class="px-3 py-2 font-semibold">When</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Actor</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Action</th>
                    <th scope="col" class="px-3 py-2 font-semibold">Detail</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {audit.map((entry) => (
                    <tr>
                      <td class="px-3 py-2 text-slate-500">{String(entry.created_at)}</td>
                      <td class="px-3 py-2 text-slate-700">{String(entry.actor_name ?? '—')}</td>
                      <td class="px-3 py-2 font-medium text-slate-900">{String(entry.action)}</td>
                      <td class="px-3 py-2 text-slate-600" dir="ltr">{String(entry.note ?? '—')}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      </>
    )}
  </div>
</BaseLayout>
