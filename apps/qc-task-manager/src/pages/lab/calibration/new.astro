---
// /lab/calibration/new — add a calibration record to the register (PROMPT 37).
// Manager+ only (canCreateLabCalibration); the shared form component posts to
// this same URL and the middleware short-circuits the POST.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LabSecondaryNav from '../../../components/lab/LabSecondaryNav.astro';
import LabCalibrationForm from '../../../components/lab/LabCalibrationForm.astro';
import { labNavForRole } from '../../../lib/lab/navigation';
import { listLabEquipmentOptionsForCalibration } from '../../../lib/lab/calibration';
import { canCreateLabCalibration, canProposeLabCalibrationCreate } from '../../../lib/permissions';
import { setFlash } from '../../../lib/flash';
import type { Role } from '../../../lib/types';
import PageHeader from '../../../components/ui/PageHeader.astro';

const user = Astro.locals.user!;
const role = user.role as Role;

if (!canCreateLabCalibration(role) && !canProposeLabCalibrationCreate(role)) {
  setFlash(Astro, 'error', 'You do not have permission to add calibration records.');
  return Astro.redirect('/lab/calibration');
}

const navItems = labNavForRole(role);
const equipmentOptions = listLabEquipmentOptionsForCalibration();
---

<BaseLayout title="New Calibration Record">
  <div class="space-y-6">
    <Breadcrumbs
      items={[
        { label: 'QC Tasks' },
        { label: 'Laboratory', href: '/lab' },
        { label: 'Calibration', href: '/lab/calibration' },
        { label: 'New Calibration Record' },
      ]}
    />

    <PageHeader eyebrow="QC Laboratory — Master Data" title="New Calibration Record" description="Log a dated calibration for laboratory equipment. The status badge is derived from the dates and result — nothing is fabricated or auto-filled." />

    <LabSecondaryNav items={navItems} currentPath="/lab/calibration/new" />

    <LabCalibrationForm mode="create" equipmentOptions={equipmentOptions} isContributor={canProposeLabCalibrationCreate(role)} />
  </div>
</BaseLayout>
