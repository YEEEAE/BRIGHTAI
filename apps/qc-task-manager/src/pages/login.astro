---
// Login page (public). GET renders the form; POST /login is handled by
// src/middleware.ts (Astro 6 pages have no named request handlers), so the
// form stays self-submitting with no separate API endpoint.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSessionUser } from '../lib/auth';
import { roleHome } from '../lib/permissions';

// Only allow internal redirect targets (blocks open-redirect abuse).
const rawTarget = Astro.url.searchParams.get('redirect') || '';
const redirectTarget = rawTarget.startsWith('/') && !rawTarget.startsWith('//') ? rawTarget : '/';
const error = Astro.url.searchParams.get('error') === '1';

// Already signed in? Bounce to the role home.
const existing = getSessionUser(Astro.request);
if (existing) {
  return Astro.redirect(roleHome(existing.role));
}

// The seeded-accounts hint is a local-dev convenience. It must never render in
// production: the default credentials would be broadcast on the public login
// page. Mirrors the seed policy in src/lib/seed.ts (production refuses to
// boot with the default "admin123" password).
const showSeededHint = process.env.NODE_ENV !== 'production';
---

<BaseLayout title="Sign in" hideNav>
  <section class="mx-auto mt-12 w-full max-w-sm">
    <h1 class="text-2xl font-semibold text-slate-900">Sign in</h1>
    <p class="mt-1 text-sm text-slate-600">Use your QC Tasks account.</p>

    {error && (
      <div class="mt-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
        Invalid username or password.
      </div>
    )}

    <form action="/login" method="POST" class="mt-6 space-y-4">
      <input type="hidden" name="redirect" value={redirectTarget} />
      <div>
        <label for="username" class="block text-sm font-medium text-slate-700">Username</label>
        <input
          id="username"
          name="username"
          type="text"
          autocomplete="username"
          required
          class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        />
      </div>
      <div>
        <label for="password" class="block text-sm font-medium text-slate-700">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        />
      </div>
      <button
        type="submit"
        class="w-full rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"
      >
        Sign in
      </button>
    </form>

    {showSeededHint && (
      <p class="mt-6 text-xs text-slate-400">
        Seeded accounts — password <code>admin123</code> by default:
        <code>admin</code> → /admin/users, <code>manager</code> → /manager,
        <code>supervisor</code> → /supervisor, <code>employee</code> → /employee.
        Additional roles are created by an admin from the <code>/admin/users</code> area.
      </p>
    )}
  </section>
</BaseLayout>
