---
// Login page (public). GET renders the form; POST /login is handled by
// src/middleware.ts (Astro 6 pages have no named request handlers), so the
// form stays self-submitting with no separate API endpoint.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSessionUser } from '../lib/auth';
import AppButton from '../components/ui/AppButton.astro';
import Banner from '../components/ui/Banner.astro';
import FormField from '../components/ui/FormField.astro';
import Input from '../components/ui/Input.astro';

// Only allow internal redirect targets (blocks open-redirect abuse).
const rawTarget = Astro.url.searchParams.get('redirect') || '';
const redirectTarget = rawTarget.startsWith('/') && !rawTarget.startsWith('//') ? rawTarget : '/';
const error = Astro.url.searchParams.get('error') === '1';

// Already signed in? Bounce to the role home — or straight to the
// password-change flow when the account still runs on an admin-set password.
const existing = getSessionUser(Astro.request);
if (existing) {
  return Astro.redirect(existing.mustChangePassword ? '/account/security' : roleHome(existing.role));
}

// The seeded-accounts hint is a local-dev convenience. It must never render in
// production: the default credentials would be broadcast on the public login
// page. Mirrors the seed policy in src/lib/seed.ts (production refuses to
// boot with the default "admin123" password).
const showSeededHint = process.env.NODE_ENV !== 'production';
---

<BaseLayout title="Sign in" hideNav>
  <section class="qc-surface-panel mx-auto mt-8 w-full max-w-md p-6 sm:mt-12 sm:p-8" aria-labelledby="sign-in-title">
    <p class="type-page-eyebrow">QC Tasks</p>
    <h1 id="sign-in-title" class="type-page-title mt-1">Sign in</h1>
    <p class="type-page-subtitle">Use your QC Tasks account.</p>

    {error && (
      <Banner tone="error" title="Sign-in unsuccessful" class="mt-5">Invalid username or password.</Banner>
    )}

    <form action="/login" method="POST" class="mt-6 space-y-4">
      <input type="hidden" name="redirect" value={redirectTarget} />
      <FormField label="Username" forId="username">
        <Input
          id="username"
          name="username"
          type="text"
          autocomplete="username"
          required
        />
      </FormField>
      <FormField label="Password" forId="password">
        <Input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </FormField>
      <AppButton type="submit" variant="primary" class="w-full">Sign in</AppButton>
    </form>

    {showSeededHint && (
      <p class="mt-6 border-t border-border pt-5 type-caption">
        Seeded accounts — password <code>admin123</code> by default:
        <code>admin</code> → /admin/users, <code>manager</code> → /manager,
        <code>supervisor</code> → /supervisor, <code>employee</code> → /employee.
        Additional roles are created by an admin from the <code>/admin/users</code> area.
      </p>
    )}
  </section>
</BaseLayout>
