---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getUserById } from '../../lib/auth';
import { parseReportFilters } from '../../lib/reporting/filters';
import { DRILLDOWN_KPIS, listDrilldownTasks, type DrilldownKpi } from '../../lib/reporting/queries';
import { resolveReportScope } from '../../lib/reporting/scope';
import { formatDueDate, priorityLabel, statusLabel } from '../../lib/format';
import { TASK_STATUSES } from '../../lib/task-policy';
import type { TaskStatus } from '../../lib/types';

const user = Astro.locals.user!;
const actor = getUserById(user.userId);
if (!actor) return Astro.redirect('/login');

const requestedKpi = Astro.url.searchParams.get('kpi') as DrilldownKpi | null;
if (!requestedKpi || !DRILLDOWN_KPIS.includes(requestedKpi)) {
  return new Response('Invalid dashboard drill-down.', { status: 400 });
}
const kpi = requestedKpi;
const reportParams = new URLSearchParams(Astro.url.searchParams);
reportParams.delete('kpi');
const rawTaskStatus = reportParams.get('task_status');
reportParams.delete('task_status');
const rawOverdueFilter = reportParams.get('overdue_filter');
reportParams.delete('overdue_filter');
if (rawTaskStatus && !TASK_STATUSES.includes(rawTaskStatus as TaskStatus)) {
  return new Response('Invalid task status filter.', { status: 400 });
}
if (rawOverdueFilter && rawOverdueFilter !== '1') {
  return new Response('Invalid overdue filter.', { status: 400 });
}
const filters = parseReportFilters(reportParams);
const scope = resolveReportScope({ id: actor.id, role: actor.role, department: actor.department }, filters);
const tasks = listDrilldownTasks(filters, scope, kpi, null, 500, {
  taskStatus: rawTaskStatus as TaskStatus | null,
  overdueOnly: rawOverdueFilter === '1',
});
const KPI_LABELS: Record<DrilldownKpi, string> = {
  total: 'All', not_started: 'Not started', in_progress: 'In progress', on_hold: 'On hold', completed: 'Completed',
  completion_rate: 'Completed', overdue: 'Overdue', urgent_open: 'Urgent open', completed_without_evidence: 'Completed without evidence',
  average_resolution: 'Resolved', sla_compliance: 'SLA compliant', sla_started: 'SLA tracked', sla_at_risk: 'SLA at risk',
  sla_critical: 'SLA critical', sla_breached: 'SLA breached', critical_findings: 'Critical finding', open_capa: 'Open CAPA',
  evidence_compliance: 'Completed with evidence',
};
const label = KPI_LABELS[kpi];
const reportsQuery = reportParams.toString();
---

<BaseLayout title="KPI drill-down">
  <header class="mb-6 flex flex-wrap items-start justify-between gap-3">
    <div>
      <a href="/dashboard" class="text-sm font-medium text-brand-700 hover:underline">← Back to dashboard</a>
      <h1 class="mt-2 text-2xl font-semibold capitalize text-slate-900">{label} tasks</h1>
      <p class="mt-1 text-sm text-slate-600">{tasks.length} matching task{tasks.length === 1 ? '' : 's'} in your authorized scope.</p>
    </div>
    <a href={reportsQuery ? `/reports?${reportsQuery}` : '/reports'} class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Open reports</a>
  </header>

  <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" aria-label="Matching tasks">
    {tasks.length === 0 ? (
      <div class="p-8 text-center text-sm text-slate-600">No matching tasks were found.</div>
    ) : (
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">
            <tr><th class="px-4 py-2.5">ID</th><th class="px-4 py-2.5">Title</th><th class="px-4 py-2.5">Employee</th><th class="px-4 py-2.5">Department</th><th class="px-4 py-2.5">Status</th><th class="px-4 py-2.5">Priority</th><th class="px-4 py-2.5">SLA</th><th class="px-4 py-2.5">Due</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {tasks.map((task) => (
              <tr class="hover:bg-slate-50">
                <td class="whitespace-nowrap px-4 py-3"><a class="font-medium text-brand-700 hover:underline" href={`/tasks/${task.id}`}>#{task.id}</a></td>
                <td class="min-w-64 px-4 py-3 text-slate-900">{task.title}</td>
                <td class="whitespace-nowrap px-4 py-3 text-slate-700">{task.assignee ?? 'Unassigned'}</td>
                <td class="whitespace-nowrap px-4 py-3 text-slate-700">{task.department}</td>
                <td class="whitespace-nowrap px-4 py-3 text-slate-700">{statusLabel(task.status)}</td>
                <td class="whitespace-nowrap px-4 py-3 text-slate-700">{priorityLabel(task.priority)}</td>
                <td class="whitespace-nowrap px-4 py-3 font-medium text-slate-700">{task.sla_status}</td>
                <td class="whitespace-nowrap px-4 py-3 text-slate-700">{task.due_date ? formatDueDate(task.due_date) : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
</BaseLayout>
