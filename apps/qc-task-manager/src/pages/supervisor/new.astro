---
// New task form (supervisor + manager + admin). Full create scope: title,
// description, assignee (any active user), priority, due date.
//
// GET renders the form; POST is short-circuited in src/middleware.ts which
// calls handleCreateTaskPost (Astro 6 pages have no named request handlers).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listActiveUsers } from '../../lib/tasks';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const users = listActiveUsers();
---

<BaseLayout title="New task">
  <div class="mx-auto max-w-2xl">
    <header class="mb-6">
      <a href="/supervisor" class="text-sm font-medium text-brand-600 hover:underline">&larr; Back to tasks</a>
      <h1 class="mt-2 text-2xl font-semibold text-slate-900">New task</h1>
      <p class="text-sm text-slate-600">Create a task as {user.fullName} ({user.role}).</p>
    </header>

    <form action="/supervisor/new" method="POST" class="space-y-5 rounded-lg border border-slate-200 bg-white p-6">
      <div>
        <label for="title" class="block text-sm font-medium text-slate-700">Title</label>
        <input
          id="title"
          name="title"
          type="text"
          required
          maxlength="200"
          placeholder="e.g. Review inspection report Q3"
          class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        />
      </div>

      <div>
        <label for="description" class="block text-sm font-medium text-slate-700">Description</label>
        <textarea
          id="description"
          name="description"
          rows="4"
          placeholder="Optional details, acceptance criteria, links…"
          class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        ></textarea>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="assigned_to" class="block text-sm font-medium text-slate-700">Assignee</label>
          <select
            id="assigned_to"
            name="assigned_to"
            class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
          >
            <option value="">Unassigned</option>
            {users.map((u) => (
              <option value={u.id}>{u.full_name} ({u.role})</option>
            ))}
          </select>
        </div>

        <div>
          <label for="priority" class="block text-sm font-medium text-slate-700">Priority</label>
          <select
            id="priority"
            name="priority"
            class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
          >
            <option value="low">Low</option>
            <option value="medium" selected>Medium</option>
            <option value="high">High</option>
          </select>
        </div>
      </div>

      <div>
        <label for="due_date" class="block text-sm font-medium text-slate-700">Due date</label>
        <input
          id="due_date"
          name="due_date"
          type="date"
          class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
        />
      </div>

      <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-5">
        <a href="/supervisor" class="rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
          Cancel
        </a>
        <button type="submit" class="rounded-md bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
          Create task
        </button>
      </div>
    </form>
  </div>
</BaseLayout>
