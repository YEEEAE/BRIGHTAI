---
// New task form (supervisor + manager + admin). Full create scope, but the
// assignee dropdown is restricted to ACTIVE QC EMPLOYEES (per spec:
// "supervisor can create tasks and assign them to active QC employees").
// The server enforces the same restriction in validateAssignee.
//
// GET renders the form; POST is short-circuited in src/middleware.ts which
// calls handleCreateTaskPost (Astro 6 pages have no named request handlers).
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewTaskForm from '../../components/NewTaskForm.astro';
import { listActiveEmployees, listTasksForDependency } from '../../lib/tasks';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const employees = listActiveEmployees();
const dependencyTasks = listTasksForDependency();
---

<BaseLayout title="New task">
  <div class="mx-auto max-w-2xl">
    <header class="mb-6">
      <a href="/supervisor" class="text-sm font-medium text-brand-600 hover:underline">&larr; Back to tasks</a>
      <h1 class="mt-2 text-2xl font-semibold text-slate-900">New task</h1>
      <p class="text-sm text-slate-600">
        Create a task as {user.fullName} ({user.role}) — assignees are limited to active QC employees.
      </p>
    </header>

    <NewTaskForm
      action="/supervisor/new"
      users={employees}
      includeDependencies={true}
      dependencyTasks={dependencyTasks}
    />
  </div>
</BaseLayout>
