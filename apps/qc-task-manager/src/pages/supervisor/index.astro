---
// Supervisor task list (supervisor + manager + admin). Create/edit/assign scope.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../lib/db';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const db = getDb();

const tasks = db
  .prepare(
    `SELECT t.id, t.title, t.status, t.priority, t.progress_percent,
            u.full_name AS assignee
     FROM tasks t
     LEFT JOIN users u ON u.id = t.assigned_to
     ORDER BY t.updated_at DESC
     LIMIT 100`,
  )
  .all() as {
    id: number;
    title: string;
    status: string;
    priority: string;
    progress_percent: number;
    assignee: string | null;
  }[];
---
<BaseLayout title="Tasks">
  <header class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Tasks</h1>
      <p class="text-sm text-slate-600">Supervisor view (create, edit, assign). Signed in as {user.fullName} ({user.role}).</p>
    </div>
    <a href="/supervisor/new" class="rounded-md bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700">
      New task
    </a>
  </header>

  {tasks.length === 0 ? (
    <p class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
      No tasks yet.
    </p>
  ) : (
    <ul class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      {tasks.map((t) => (
        <li class="flex items-center justify-between p-4">
          <div>
            <a href={`/tasks/${t.id}`} class="font-medium text-slate-900 hover:underline">{t.title}</a>
            <div class="mt-0.5 text-xs text-slate-500">
              #{t.id} · {t.assignee ?? 'Unassigned'} · {t.priority} · {t.progress_percent}%
            </div>
          </div>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{t.status}</span>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
