---
// Supervisor task list (supervisor + manager + admin). Create/edit/assign scope.
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getDb } from '../../lib/db';
import {
  formatDueDate,
  isOverdue,
  isUrgent,
  priorityLabel,
  priorityBadgeClass,
  URGENT_ROW_CLASS,
} from '../../lib/format';

const user = Astro.locals.user!; // protected route — middleware guarantees a session
const db = getDb();

const tasks = db
  .prepare(
    `SELECT t.id, t.title, t.status, t.priority, t.progress_percent, t.due_date, t.recurrence,
            u.full_name AS assignee
     FROM tasks t
     LEFT JOIN users u ON u.id = t.assigned_to
     ORDER BY t.updated_at DESC
     LIMIT 100`,
  )
  .all() as {
    id: number;
    title: string;
    status: string;
    priority: string;
    progress_percent: number;
    due_date: string | null;
    recurrence: string;
    assignee: string | null;
  }[];
---
<BaseLayout title="Tasks">
  <header class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Tasks</h1>
      <p class="text-sm text-slate-600">Supervisor view (create, edit, assign). Signed in as {user.fullName} ({user.role}).</p>
    </div>
    <a href="/supervisor/new" class="rounded-md bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700">
      New task
    </a>
  </header>

  {tasks.length === 0 ? (
    <EmptyState
      title="No tasks yet"
      hint="Create the first task for your team to get started."
      ctaHref="/supervisor/new"
      ctaLabel="Create your first task"
    />
  ) : (
    <ul class="divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white shadow-sm">
      {tasks.map((t) => {
        const overdue = isOverdue(t.due_date, t.status);
        const urgent = isUrgent(t.priority);
        return (
          <li class={`flex flex-wrap items-center justify-between gap-3 p-4 ${urgent ? URGENT_ROW_CLASS : 'transition-colors hover:bg-slate-50'}`}>
            <div class="min-w-0">
              <a href={`/tasks/${t.id}`} class="font-medium text-slate-900 hover:underline">{t.title}</a>
              {t.recurrence !== 'none' && <span title="Recurring task" aria-label="Recurring task"> 🔁</span>}
              <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
                <span>#{t.id}</span>
                <span>{t.assignee ?? 'Unassigned'}</span>
                <span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium ${priorityBadgeClass(t.priority)}`}>
                  {priorityLabel(t.priority)}
                </span>
                {t.due_date && (
                  <span class={overdue ? 'font-semibold text-red-600' : ''}>
                    Due {formatDueDate(t.due_date)}
                    {overdue && ' ⚠️'}
                  </span>
                )}
                <span class="tabular-nums">{t.progress_percent}%</span>
              </div>
            </div>
            <StatusBadge status={t.status} />
          </li>
        );
      })}
    </ul>
  )}
</BaseLayout>
