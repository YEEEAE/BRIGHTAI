---
// Base layout for QC Task Manager. English UI, LTR, top navbar + flash messages.
// FlashNotice is rendered here so every page gets one-shot flash support
// (success/error) without each page importing it manually.
import Navbar from '../components/Navbar';
import FlashNotice from '../components/FlashNotice.astro';

interface Props {
  title: string;
  /** Hide the navbar (e.g. on the login page). */
  hideNav?: boolean;
}

const { title, hideNav = false } = Astro.props;
const siteTitle = title ? `${title} · QC Tasks` : 'QC Tasks';
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    {!hideNav && (
      <Navbar client:load user={Astro.locals.user} />
    )}
    <main class="mx-auto w-full max-w-6xl px-4 py-8">
      <FlashNotice />
      <slot />
    </main>
  </body>
</html>
