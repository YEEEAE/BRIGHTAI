---
// Base layout for QC Task Manager. English UI, LTR, top navbar + flash messages.
// FlashNotice is rendered here so every page gets one-shot flash support
// (success/error) without each page importing it manually.
import Navbar from '../components/Navbar';
import FlashNotice from '../components/FlashNotice.astro';
import SystemBackground from '../components/SystemBackground.astro';
import { countNotifications, listPersistedNotifications } from '../lib/notifications';
// Global a11y styles (skip link + prefers-reduced-motion). Bundled by Astro
// as a same-origin stylesheet so the strict CSP in src/middleware.ts stays
// intact (no inline <style> blocks).
import '../styles/global.css';

interface Props {
  title: string;
  /** Hide the navbar (e.g. on the login page). */
  hideNav?: boolean;
}

const { title, hideNav = false } = Astro.props;
const siteTitle = title ? `${title} · QC Tasks` : 'QC Tasks';

// Live alert count for the navbar bell + the latest persisted notifications
// for the dropdown (only when signed in — login has no nav).
const navUser = Astro.locals.user;
const notificationCount = navUser
  ? countNotifications({ id: navUser.userId, role: navUser.role })
  : 0;
const recentNotifications = navUser
  ? listPersistedNotifications(navUser.userId, 8)
  : [];
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
    <script is:inline src="/scripts/form-productivity.js" defer></script>
    <script is:inline src="/scripts/ux-telemetry.js" data-enabled={!hideNav && !!Astro.locals.user} data-route={Astro.url.pathname} defer></script>
  </head>
  <body class="min-h-screen bg-surface-page text-content antialiased" data-qc-user-id={Astro.locals.user?.userId ?? 'anonymous'}>
    <SystemBackground />
    <div class="qc-app-layer">
      <!-- Skip link — first focusable element on every page (WCAG 2.4.1).
           Hidden until focused; styling lives in src/styles/global.css. -->
      <a class="skip-link" href="#main-content">تخطي إلى المحتوى الرئيسي</a>
      {!hideNav && (
        <Navbar
          client:load
          user={Astro.locals.user}
          notificationCount={notificationCount}
          recentNotifications={recentNotifications}
        />
      )}
      <main id="main-content" tabindex="-1" class="mx-auto min-w-0 w-full max-w-7xl overflow-x-hidden px-4 py-6 sm:px-6 sm:py-8 lg:px-8 lg:py-10 focus:outline-none">
        <FlashNotice />
        <div class="qc-page-content"><slot /></div>
      </main>
      <footer class="border-t border-slate-200 bg-white px-4 py-6 text-center text-sm text-slate-600" aria-label="Site footer">
        <p>QC Task Manager</p>
      </footer>
      <div id="qc-live-region" aria-live="polite" aria-atomic="true" class="sr-only"></div>
    </div>
  </body>
</html>
