---
// PrintLayout — a chrome-free, A4, server-rendered document shell for
// controlled laboratory print views (/lab/tests/[id]/print, page ref §25/§70).
//
// Unlike BaseLayout this layout renders NO navbar, no flash, no dashboard
// chrome and no skip-link/max-width wrapper — just the controlled document.
// `inlineStylesheets: 'never'` in astro.config ensures the <style> below is
// emitted as a same-origin stylesheet, so the strict CSP (style-src 'self')
// in src/middleware.ts is not violated.
interface Props {
  title: string;
  /** Screen-only "back to details" target (hidden when printed). */
  backHref?: string;
  recordType?: string;
  recordId?: string;
  authorization?: string;
  signature?: string;
  sourceReference?: string;
  orientation?: 'portrait' | 'landscape';
}
const { title, backHref = '', recordType = 'Controlled record', recordId = '—', authorization = 'Authorization recorded in the source workflow', signature = 'Electronic signature metadata recorded in the source workflow', sourceReference = 'Source record and audit trail', orientation = 'portrait' } = Astro.props;
const printTimestamp = new Date();
function iso(ts: Date): string {
  const p = (n: number) => String(n).padStart(2, '0');
  return `${ts.getFullYear()}-${p(ts.getMonth() + 1)}-${p(ts.getDate())} ${p(ts.getHours())}:${p(ts.getMinutes())}:${p(ts.getSeconds())}`;
}
const tsText = iso(printTimestamp);
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: #ffffff; color: #111827; }
      body { font-family: 'IBM Plex Sans', 'Segoe UI', Arial, sans-serif; font-size: 12px; line-height: 1.45; -webkit-print-color-adjust: exact; print-color-adjust: exact; }

      .print-page {
        max-width: 210mm;
        margin: 0 auto;
        padding: 14mm;
      }
      .print-landscape { page: landscape; max-width: none; }
      .print-header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #111827; padding-bottom: 10px; margin-bottom: 14px; }
      .print-title { font-size: 18px; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; }
      .print-sub { font-size: 11px; color: #4b5563; margin-top: 2px; }
      .print-meta { text-align: right; font-size: 11px; color: #4b5563; }
      .print-meta strong { color: #111827; }

      .print-section { border: 1px solid #d1d5db; margin-bottom: 10px; }
      .print-section-title { background: #f3f4f6; font-weight: 700; text-transform: uppercase; font-size: 11px; letter-spacing: 0.04em; padding: 5px 10px; border-bottom: 1px solid #d1d5db; margin: 0; }
      .print-section-body { padding: 8px 10px; }

      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 24px; }
      .grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 4px 24px; }
      .dl-item { display: flex; gap: 6px; }
      .dl-item dt { font-weight: 600; color: #4b5563; min-width: 0; flex: 0 0 auto; max-width: 45%; }
      .dl-item dd { margin: 0; }

      table { width: 100%; border-collapse: collapse; }
      th, td { border: 1px solid #d1d5db; padding: 4px 6px; font-size: 11px; text-align: left; }
      th { background: #f9fafb; font-weight: 700; }

      .remark-text { white-space: pre-wrap; }

      /* Sample QR sheet (PROMPT 48) — fixed 22mm cells, 6 per row max on A4. */
      .qr-grid { display: flex; flex-wrap: wrap; gap: 6mm; }
      .qr-cell { width: 24mm; text-align: center; break-inside: avoid; }
      .qr-cell svg { display: block; width: 22mm; height: 22mm; margin: 0 auto; border: 1px solid #d1d5db; }
      .qr-id { display: block; margin-top: 1mm; font-family: 'IBM Plex Mono', 'Courier New', monospace; font-size: 8px; color: #111827; word-break: break-all; }
      .auth-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
      .auth-box { border: 1px solid #d1d5db; padding: 8px; min-height: 56px; }
      .auth-box .label { font-size: 10px; text-transform: uppercase; color: #6b7280; }
      .auth-box .value { font-size: 13px; font-weight: 700; margin-top: 8px; }
      .auth-box .stamp { font-size: 10px; color: #4b5563; margin-top: 6px; }

      .final-result { font-size: 18px; font-weight: 800; }
      .result-pass { color: #047857; }
      .result-fail { color: #b91c1c; }
      .result-hold { color: #c2410c; }

      .print-footer { margin-top: 20px; padding-top: 8px; border-top: 1px solid #d1d5db; display: flex; justify-content: space-between; font-size: 10px; color: #6b7280; }
      .print-control-metadata { margin-top: 10px; border: 1px solid #d1d5db; padding: 8px 10px; break-inside: avoid; }
      .print-control-metadata dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px 16px; margin: 0; }
      .print-control-metadata dt { color: #4b5563; font-weight: 600; font-size: 10px; }
      .print-control-metadata dd { margin: 2px 0 0; font-size: 11px; }

      /* Screen-only "back" affordance — never printed. */
      .no-print { padding: 10px 0; }
      .no-print a { color: #0f766e; text-decoration: underline; }

      /* A4 page rules for real printing. */
      @page { size: A4 portrait; margin: 12mm; }
      @page landscape { size: A4 landscape; margin: 10mm; }
      @media print {
        .no-print { display: none !important; }
        body { font-size: 11px; }
        .print-page { max-width: none; padding: 0; }
        .print-section { break-inside: avoid; }
        table { break-inside: auto; }
        thead { display: table-header-group; }
        tr { break-inside: avoid; page-break-inside: avoid; }
        .print-control-metadata { break-inside: avoid; }
      }
    </style>
  </head>
  <body>
    <div class="no-print">
      {backHref ? <a href={backHref}>← Back to test details</a> : <span>Controlled print view</span>}
    </div>
    <main class={`print-page ${orientation === 'landscape' ? 'print-landscape' : ''}`}>
      <slot />
      <section class="print-control-metadata" aria-label="Controlled print metadata">
        <dl>
          <div><dt>Record type</dt><dd>{recordType}</dd></div>
          <div><dt>Record ID</dt><dd dir="ltr">{recordId}</dd></div>
          <div><dt>Authorization</dt><dd>{authorization}</dd></div>
          <div><dt>Signature / e-signature</dt><dd>{signature}</dd></div>
          <div><dt>Reference / source</dt><dd>{sourceReference}</dd></div>
          <div><dt>Viewer context</dt><dd>{Astro.locals.user ? `${Astro.locals.user.fullName} · ${Astro.locals.user.role}` : 'Authenticated user'}</dd></div>
        </dl>
      </section>
      <div class="print-footer">
        <span>Generated {tsText}</span>
        <span>Controlled laboratory record — printed copy</span>
      </div>
    </main>
  </body>
</html>
