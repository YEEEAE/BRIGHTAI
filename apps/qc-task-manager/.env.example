# QC Task Manager — environment variables.
# انسخ هذا الملف إلى .env وعدّل القيم:
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────────
# كلمة مرور حساب الـ admin الأولي.
# يُستخدم بس مرة وحدة: أول ما تنشئ قاعدة البيانات وما في أي مستخدمين.
# لو ما حطيته، يكون البديل الافتراضي "admin123" ويطلع تحذير في الكونسول.
# ─────────────────────────────────────────────────────────────────
ADMIN_DEFAULT_PASSWORD=admin123

# ─────────────────────────────────────────────────────────────────
# مسار ملف قاعدة البيانات (اختياري).
# الافتراضي: db/qc_tasks.db (نسبي لجذر التطبيق).
# غيّره لو تبي تخزنها في مكان ثابت مطلق.
# ─────────────────────────────────────────────────────────────────
# QC_DB_PATH=/absolute/path/to/qc_tasks.db
