# ═══════════════════════════════════════════════════════════════════
# BrightAI Dashboard — Environment Variables (EXAMPLE)
# ═══════════════════════════════════════════════════════════════════
#
# Copy to .env and fill in real values. Never commit .env.
# Get Clerk keys from https://dashboard.clerk.com
# SendGrid from https://app.sendgrid.com
# Unifonic from https://www.unifonic.com (Saudi SMS provider)
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=development

# ── Database (matches docker-compose.yml) ──────────────────────────
# brightai_admin owns the schema and runs migrations.
DATABASE_URL="postgresql://brightai_admin:brightai_admin@localhost:5432/brightai_dev"
# brightai_app is the runtime user, subject to RLS.
DATABASE_URL_APP="postgresql://brightai_app:brightai_app@localhost:5432/brightai_dev"
# brightai_service has BYPASSRLS, used for cross-tenant jobs.
DATABASE_URL_SERVICE="postgresql://brightai_service:brightai_service@localhost:5432/brightai_dev"
# Used by Prisma for direct connections (migrations). Same as DATABASE_URL
# in dev, but a pooler URL (e.g. PgBouncer) in production.
DIRECT_URL="postgresql://brightai_admin:brightai_admin@localhost:5432/brightai_dev"

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Clerk (auth) ──────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"

# ── AI Firewall (Layer 1 + Phase 1b/c) ────────────────────

# Groq (LLM provider) — required for the firewall chat endpoint.
# Get from https://console.groq.com/keys
GROQ_API_KEY="gsk_xxx"
GROQ_DEFAULT_MODEL="llama-3.1-8b-instant"   # chat completion
GROQ_WHISPER_MODEL="whisper-large-v3"       # audio transcription (Phase 1c)

# Token vault — HMAC keys for the reversible `tokenize` action.
# Generate with: openssl rand -base64 32
# Rotate quarterly. PREV key is kept for a 24h overlap window so
# in-flight tokens can still be resolved during rotation.
FIREWALL_TOKEN_VAULT_KEY=""
FIREWALL_TOKEN_VAULT_KEY_PREV=""

# NER toggle (Phase 1b). Default: enabled. Set to "false" to skip
# the Arabic NER model and run regex-only.
FIREWALL_NER_ENABLED="true"
FIREWALL_CACHE_DIR="/tmp/firewall-models"   # where ONNX models are cached

# Default PII action when caller doesn't override.
# mask | redact | tokenize | block
FIREWALL_DEFAULT_ACTION="mask"
# Webhook secret from Clerk → Webhooks → Endpoints (after you add one)
CLERK_WEBHOOK_SECRET="whsec_xxx"
# Optional: for session token customization
CLERK_JWT_KEY=""

# ── Email (SendGrid) ──────────────────────────────────────────────
SENDGRID_API_KEY="SG.xxx"
SENDGRID_FROM_EMAIL="[email protected]"
SENDGRID_FROM_NAME_AR="BrightAI - ذكاء اصطناعي آمن"

# ── SMS (Unifonic — Saudi Arabia) ────────────────────────────────
UNIFONIC_APP_ID=""
UNIFONIC_ACCOUNT_ID=""
UNIFONIC_SENDER_ID="BrightAI"

# ── Multi-tenant routing ────────────────────────────────────────
NEXT_PUBLIC_ROOT_DOMAIN="brightai.live"
ROOT_DOMAIN="brightai.live"
# Comma-separated list of reserved subdomains that map to marketing / API / etc.
RESERVED_SUBDOMAINS="www,api,admin,app,dashboard,docs,status,mail,cdn"

# ── Feature flags ───────────────────────────────────────────────
ENABLE_SIGNUP="true"
ENABLE_PASSKEYS="true"
ENABLE_2FA_SMS="false"

# ── Operational ──────────────────────────────────────────────────
AUDIT_RETENTION_DAYS="730"
INVITATION_BASE_URL="http://localhost:3000"

# ── Clerk redirect URLs (after sign-in / sign-up) ────────────────
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding/welcome"

# ── App URL (for absolute URLs in emails, etc.) ─────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Stripe (BAI-004 / 2026-07-15) ─────────────────────────────
# Get from https://dashboard.stripe.com → Developers → API keys
# Test mode keys start with sk_test_/pk_test_, live mode sk_live_/pk_live_.
# Webhook secret comes from the webhook endpoint (Developers → Webhooks).
# The dashboard boots without these; the billing page shows a
# "billing is not configured" state until they're set.
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Stripe Price IDs (one per plan). Create in Stripe Dashboard →
# Products → Add product. Server-only (NEVER prefix with NEXT_PUBLIC_).
STRIPE_PRICE_STARTER="price_xxx_starter"
STRIPE_PRICE_PRO="price_xxx_pro"
# ENTERPRISE plan is sales-led → contact form. No self-serve price.
