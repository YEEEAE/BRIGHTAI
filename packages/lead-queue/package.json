{
  "name": "@brightai/lead-queue",
  "version": "0.1.0",
  "private": true,
  "description": "Durable lead-capture outbox for the marketing site (HIGH-04). Persists /api/lead submissions to Postgres, retries with exponential backoff, routes failures to DLQ, and sweeps expired rows.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./queue": "./src/queue.ts",
    "./delivery": "./src/delivery.ts",
    "./retention": "./src/retention.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "retention:sweep": "node ./scripts/retention-sweep.mjs"
  },
  "dependencies": {
    "@brightai/db": "workspace:*",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
