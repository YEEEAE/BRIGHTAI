{
  "name": "@brightai/firewall-detectors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight PII detection (regex-based) for marketing site + dashboard. NER is optional + injectable. No DB, no ONNX, no Prisma.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./regex": "./src/regex.ts",
    "./redaction": "./src/redaction.ts",
    "./piidetector": "./src/piidetector.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^1.6.1"
  }
}
