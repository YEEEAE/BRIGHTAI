// ─────────────────────────────────────────────────────────────────
// Subscription — Stripe subscription state (mirrors dashboard/src/lib/billing/stripe.ts).
//
// One row per Stripe subscription. Organization has 1 active subscription
// at a time (enforced by application logic + unique stripeSubscriptionId).
// We keep history in this table (rather than overwriting) so we can
// audit plan changes, cancellations, and reactivations.
//
// The 8 statuses map 1:1 to Stripe's subscription.status enum — never
// invent new values; add a new enum entry + a migration instead.
// ─────────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

enum BillingPlan {
  STARTER
  PRO
  ENTERPRISE
}

// ─────────────────────────────────────────────────────────────────
// LeadQueue — durable outbox for marketing-site /api/lead submissions
// (HIGH-04 / 2026-07-15).
//
// Why durable:
//   - The Astro /api/lead/ endpoint receives leads from public kernel
//     pages. The previous in-memory queue (cap 100) was lost on every
//     Render restart.
//   - This table is the single source of truth: rows survive restarts,
//     enable idempotency, retry with exponential backoff, and DLQ.
//
// No organization_id: leads are pre-signup (public visitors). They are
// NOT tenant-scoped, so they bypass RLS via dbServiceRole. The service
// role has BYPASSRLS so it reads + writes without per-row policy.
//
// Lifecycle:
//   - PENDING     → newly enqueued, not yet attempted (or nextRetryAt in
//                   the future).
//   - SENDING     → an attempt is in flight (worker holds the row).
//   - DELIVERED   → webhook returned 2xx. deliveredAt recorded.
//   - DLQ         → attempts ≥ MAX_ATTEMPTS. lastError populated.
//                   CI cron prunes DLQ rows after 30 days.
//   - EXPIRED     → retention sweep deleted a delivered row (TTL). Only
//                   used for observability — actual delete is hard.
//
// Idempotency:
//   - idempotencyKey is UNIQUE. The Astro endpoint computes either the
//     client-provided `Idempotency-Key` header value, or a synthetic
//     fallback: sha256(ip + userAgent + contact + createdAtBucket).
//   - Duplicate keys return the existing row (same id, same response).
//   - Synthetic key bucket = current 30-second window. Same client
//     resubmitting within the same window yields the same key (idempotent).
//     Resubmitting across windows yields a different key (new lead).
//
// Retention:
//   - Delivered rows older than 7 days are deleted by
//     scripts/lead-retention-sweep.mjs (cron / scheduled job).
//   - DLQ rows older than 30 days are deleted by the same sweep.
// ─────────────────────────────────────────────────────────────────

enum LeadQueueStatus {
  PENDING
  SENDING
  DELIVERED
  DLQ
  EXPIRED
}

model LeadQueue {
  id             String          @id @default(cuid())
  // Idempotency
  idempotencyKey String          @unique
  // Lead payload — server-validated by Zod (3-120 chars each)
  name           String
  contact        String
  company        String
  page           String?
  source         String?
  // Submission context (used for synthetic key + audit; never PII-shared)
  ip             String?
  userAgent      String?
  // Delivery state
  status         LeadQueueStatus @default(PENDING)
  attempts       Int             @default(0)
  nextRetryAt    DateTime?
  lastError      String?
  webhookUrl     String?
  responseStatus Int?
  // Lead hash for log correlation (NOT the same as idempotencyKey)
  leadHash       String?
  // Timestamps
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deliveredAt    DateTime?
  dlqAt          DateTime?

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@index([status, dlqAt])
  @@map("lead_queue")
}

// ─────────────────────────────────────────────────────────────────
// Organization — the tenant
// ─────────────────────────────────────────────────────────────────

model Organization {
  id                    String                @id @default(cuid())
  slug                  String                @unique
  name                  String
  nameAr                String
  crNumber              String?               @unique
  industry              Industry
  size                  CompanySize
  deployment            DeploymentMode        @default(CLOUD)
  logoUrl               String?
  primaryColor          String? // hex; default brand uses cyan/indigo
  settings              Json                  @default("{}")
  // Onboarding
  onboardingStep        OnboardingStep        @default(ORG_INFO)
  onboardingCompletedAt DateTime?
  // Compliance frameworks (selected at signup, mutable in settings)
  compliance            ComplianceFramework[]
  // Billing
  stripeCustomerId      String?               @unique
  planName              String                @default("trial")
  trialEndsAt           DateTime?
  // Soft delete
  deletedAt             DateTime?
  // Timestamps
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Relations
  members              Membership[]
  invitations          Invitation[]
  policies             Policy[]
  requests             AIRequest[]
  integrations         Integration[]
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  domains              Domain[]
  complianceRecords    OrganizationCompliance[]
  onboardingProgress   OnboardingProgress?
  dataExportRequests   DataExportRequest[]
  dataDeletionRequests DataDeletionRequest[]
  sessions             Session[]
  subscriptions        Subscription[]
  orgFeatureFlags      OrgFeatureFlag[]
  // USAGE-001 (2026-07-15): per-org AI token usage for billing.
  aiUsageEntries       AiUsageEntry[]
  // SSO-001 (2026-07-15): per-org enterprise SSO connections.
  samlConnections      SamlConnection[]

  @@index([slug])
  @@index([deletedAt])
  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────
// User — synced from Clerk
// ─────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  clerkUserId      String    @unique
  email            String    @unique @db.Citext
  emailVerified    Boolean   @default(false)
  fullName         String?
  fullNameAr       String?
  avatarUrl        String?
  phoneNumber      String?   @db.Citext
  phoneVerified    Boolean   @default(false)
  primaryLocale    String    @default("ar-SA")
  timezone         String    @default("Asia/Riyadh")
  // 2FA
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String? // encrypted at-rest (TOTP secret)
  twoFactorMethod  String? // 'totp' | 'sms' | null
  // Preferences
  preferences      Json      @default("{}")
  // Activity
  lastSeenAt       DateTime?
  // Soft delete
  deletedAt        DateTime?
  // Timestamps
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  memberships            Membership[]
  membershipsInvited     Membership[]          @relation("MembershipInvitedBy")
  membershipsDeactivated Membership[]          @relation("MembershipDeactivatedBy")
  passkeys               Passkey[]
  backupCodes            TwoFactorBackupCode[]
  sessions               Session[]
  sessionsRevoked        Session[]             @relation("SessionRevokedBy")
  auditLogs              AuditLog[]
  invitationsSent        Invitation[]          @relation("InvitationInvitedBy")
  apiKeysCreated         ApiKey[]
  dataExports            DataExportRequest[]
  dataDeletions          DataDeletionRequest[]
  dataDeletionsAsTarget  DataDeletionRequest[] @relation("DataDeletionTargetUser")
  requestsCreated        AIRequest[]
  requestsReviewed       AIRequest[]           @relation("AIRequestReviewedBy")
  impersonatedSessions   Session[]             @relation("SessionImpersonatedBy")

  @@index([clerkUserId])
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────
// Membership — User × Organization × Role × Status
// ─────────────────────────────────────────────────────────────────

model Membership {
  id                 String       @id @default(cuid())
  organizationId     String
  userId             String
  role               Role
  status             MemberStatus @default(ACTIVE)
  // Invitation lineage
  invitedById        String?
  invitedAt          DateTime     @default(now())
  acceptedAt         DateTime?
  joinedAt           DateTime?
  // Deactivation
  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivationReason String?
  // Activity
  lastActiveAt       DateTime?
  // Preferences (per-org)
  preferences        Json         @default("{}")
  // Timestamps
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy     User?        @relation("MembershipInvitedBy", fields: [invitedById], references: [id])
  deactivatedBy User?        @relation("MembershipDeactivatedBy", fields: [deactivatedById], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@index([organizationId, status])
  @@index([status])
  @@map("memberships")
}

// ─────────────────────────────────────────────────────────────────
// Invitation — pending team invites
// ─────────────────────────────────────────────────────────────────

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String    @db.Citext
  role           Role
  token          String    @unique // SHA-256 of the raw token (the lookup key — see app/invitation/[token]/page.tsx for hash flow)
  // Lifecycle
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  // Meta
  invitedById    String
  message        String?
  // Bulk import (CSV)
  batchId        String?
  // Timestamps
  createdAt      DateTime  @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@unique([organizationId, email])
  @@index([email])
  @@index([organizationId, expiresAt])
  @@index([batchId])
  @@map("invitations")
}

// ─────────────────────────────────────────────────────────────────
// Passkey — WebAuthn credentials
// ─────────────────────────────────────────────────────────────────

model Passkey {
  id             String    @id @default(cuid())
  userId         String
  credentialId   String    @unique // base64url-encoded
  publicKey      String // base64url-encoded COSE key
  counter        BigInt    @default(0)
  deviceName     String?
  transports     String[] // ['usb', 'nfc', 'ble', 'internal']
  backupEligible Boolean   @default(false)
  backupState    Boolean   @default(false)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

// ─────────────────────────────────────────────────────────────────
// TwoFactorBackupCode — one-time recovery codes
// ─────────────────────────────────────────────────────────────────

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String // bcrypt-hashed code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

// ─────────────────────────────────────────────────────────────────
// Session — server-side session record (mirror of Clerk JWT)
// ─────────────────────────────────────────────────────────────────

model Session {
  id                     String    @id @default(cuid())
  userId                 String
  organizationId         String? // current active tenant
  // Token
  tokenHash              String    @unique // SHA-256 of session cookie
  fingerprint            String? // browser fingerprint hash
  // Request context
  ipAddress              String?
  userAgent              String?
  device                 String? // parsed device name
  country                String?
  // Lifecycle
  expiresAt              DateTime
  lastActiveAt           DateTime  @default(now())
  revokedAt              DateTime?
  revokedById            String?
  revocationReason       String?
  // Impersonation
  impersonatedById       String?
  impersonationStartedAt DateTime?
  impersonationEndedAt   DateTime?
  impersonationReason    String?

  // Relations
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  revokedBy      User?         @relation("SessionRevokedBy", fields: [revokedById], references: [id])
  impersonatedBy User?         @relation("SessionImpersonatedBy", fields: [impersonatedById], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────
// Compliance frameworks join table (explicit for RLS clarity)
// ─────────────────────────────────────────────────────────────────

model OrganizationCompliance {
  organizationId String
  framework      ComplianceFramework
  enabledAt      DateTime            @default(now())
  certifiedAt    DateTime?
  expiresAt      DateTime?
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, framework])
  @@index([framework])
  @@map("organization_compliance")
}

// ─────────────────────────────────────────────────────────────────
// Policy — AI governance policy (e.g. "Block PII in prompts")
// ─────────────────────────────────────────────────────────────────

model Policy {
  id             String         @id @default(cuid())
  organizationId String
  // Identity
  name           String
  nameAr         String
  description    String?
  descriptionAr  String?
  category       PolicyCategory
  // Rules (JSON: conditions, actions, exceptions)
  rules          Json
  // Priority (higher = applied first; ties broken by createdAt asc)
  priority       Int            @default(0)
  // Lifecycle
  status         PolicyStatus   @default(DRAFT)
  version        Int            @default(1)
  parentId       String?
  // Audit
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  // Timestamps
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  archivedAt     DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Policy?      @relation("PolicyVersion", fields: [parentId], references: [id])
  versions     Policy[]     @relation("PolicyVersion")
  requests     AIRequest[]

  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, createdAt])
  @@map("policies")
}

// ─────────────────────────────────────────────────────────────────
// AIRequest — gated AI request awaiting review
// ─────────────────────────────────────────────────────────────────

model AIRequest {
  id             String            @id @default(cuid())
  organizationId String
  requestedById  String
  policyId       String?
  // Payload
  prompt         String            @db.Text
  response       String?           @db.Text
  modelUsed      String?
  tokensUsed     Int?
  // Risk
  riskScore      Float? // 0.0 - 1.0
  riskLevel      RequestRiskLevel?
  piiDetected    Boolean           @default(false)
  piiTypes       String[]
  // Review
  status         RequestStatus     @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNotes    String?
  // Lifecycle
  expiresAt      DateTime?
  // Timestamps
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation(fields: [requestedById], references: [id])
  reviewedBy   User?        @relation("AIRequestReviewedBy", fields: [reviewedById], references: [id])
  policy       Policy?      @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, riskLevel])
  @@index([requestedById, createdAt])
  @@map("ai_requests")
}

// ─────────────────────────────────────────────────────────────────
// Integration — SharePoint / Slack / Teams / etc.
// ─────────────────────────────────────────────────────────────────

model Integration {
  id             String               @id @default(cuid())
  organizationId String
  connector      IntegrationConnector
  // Display
  displayName    String
  // Config (encrypted at-rest JSON)
  config         Json
  // Status
  status         IntegrationStatus    @default(PENDING_SETUP)
  errorMessage   String?
  // Sync
  lastSyncAt     DateTime?
  syncCursor     String?
  // Audit
  connectedById  String
  // Timestamps
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  disconnectedAt DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, connector, displayName])
  @@index([organizationId, status])
  @@map("integrations")
}

// ─────────────────────────────────────────────────────────────────
// ApiKey — programmatic access
// ─────────────────────────────────────────────────────────────────

model ApiKey {
  id               String       @id @default(cuid())
  organizationId   String
  name             String
  // First 8 chars for display (e.g. "bk_live_")
  prefix           String
  // SHA-256 of the full key (raw never stored)
  hashedKey        String       @unique
  // Authorization
  scopes           String[]
  // Lifecycle
  status           ApiKeyStatus @default(ACTIVE)
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  lastUsedIp       String?
  // Audit
  createdById      String
  revokedAt        DateTime?
  revokedById      String?
  revocationReason String?
  // Timestamps
  createdAt        DateTime     @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId, status])
  @@index([prefix])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────────
// AuditLog — immutable log of every privileged action
// ─────────────────────────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  // Actor (may be null for SYSTEM)
  actorId        String?
  actorType      ActorType   @default(USER)
  // Action
  action         AuditAction
  // Target
  targetType     String? // 'Policy' | 'AIRequest' | etc
  targetId       String?
  // Context
  ipAddress      String?
  userAgent      String?
  // Free-form metadata (JSON)
  metadata       Json        @default("{}")
  // Hash chain (tamper-evidence)
  prevHash       String?
  hash           String?
  // Timestamp
  createdAt      DateTime    @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────
// TokenMapping — reversible tokenization vault (AI Firewall Phase 1c)
//
// Maps an opaque token (TKN_xxx) back to the original PII value.
// Encrypted at rest with HMAC-SHA256 using the org's vault key.
// The plaintext value is NEVER stored — only the HMAC-protected
// ciphertext. To resolve, the caller must have the current vault
// key (or the previous key during a 24h rotation window).
// ─────────────────────────────────────────────────────────────────

model TokenMapping {
  id             String    @id @default(cuid())
  organizationId String
  // The token (e.g. "TKN_a1b2c3d4...") — what the LLM sees.
  token          String
  // HMAC-SHA256(token, vault_key) — proves the token was issued
  // by this vault. Not a secret, but authenticates the token.
  tokenHmac      String
  // AES-256-GCM ciphertext of the original value. Encrypted with
  // a key derived from FIREWALL_TOKEN_VAULT_KEY via HKDF.
  encryptedValue String
  // IV for the AES-GCM ciphertext (base64).
  iv             String
  // Auth tag for the AES-GCM ciphertext (base64).
  authTag        String
  // Which key encrypted this (for rotation: "current" | "prev").
  keyVersion     String    @default("current")
  // Original PII type (for audit context, not used for resolution).
  piiType        String
  // Lifecycle
  expiresAt      DateTime?
  // Audit
  createdById    String
  createdAt      DateTime  @default(now())

  @@unique([organizationId, token])
  @@index([organizationId, createdAt])
  @@index([organizationId, piiType])
  @@index([expiresAt])
  @@map("token_mappings")
}

// ─────────────────────────────────────────────────────────────────
// Domain — custom domains for an org (e.g. ai.acme.com)
// ─────────────────────────────────────────────────────────────────

model Domain {
  id                String       @id @default(cuid())
  organizationId    String
  domain            String       @unique
  // Verification
  verificationToken String
  isVerified        Boolean      @default(false)
  verifiedAt        DateTime?
  // SSL
  sslStatus         DomainStatus @default(PENDING_VERIFICATION)
  sslIssuedAt       DateTime?
  sslExpiresAt      DateTime?
  // CNAME
  cnameTarget       String       @default("proxy.brightai.site")
  // Primary flag (only one per org)
  isPrimary         Boolean      @default(false)
  // Timestamps
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@index([organizationId, isPrimary])
  @@map("domains")
}

// ─────────────────────────────────────────────────────────────────
// OnboardingProgress — 5-step wizard state
// ─────────────────────────────────────────────────────────────────

model OnboardingProgress {
  id             String           @id @default(cuid())
  organizationId String           @unique
  currentStep    OnboardingStep   @default(ORG_INFO)
  completedSteps OnboardingStep[] @default([])
  // Per-step partial data (so user can resume)
  stepData       Json             @default("{}")
  completedAt    DateTime?
  // Timestamps
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

// ─────────────────────────────────────────────────────────────────
// DataExportRequest — PDPL data export
// ─────────────────────────────────────────────────────────────────

model DataExportRequest {
  id                String            @id @default(cuid())
  organizationId    String
  requestedById     String
  status            DataRequestStatus @default(PENDING)
  // Result
  downloadUrl       String?
  downloadExpiresAt DateTime?
  fileSizeBytes     BigInt?
  // Metadata
  recordCounts      Json? // { users: 5, policies: 12, ... }
  // Lifecycle
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  // Timestamps
  createdAt         DateTime          @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation(fields: [requestedById], references: [id])

  @@index([organizationId, status, createdAt])
  @@map("data_export_requests")
}

// ─────────────────────────────────────────────────────────────────
// DataDeletionRequest — PDPL right-to-be-forgotten
// ─────────────────────────────────────────────────────────────────

model DataDeletionRequest {
  id             String            @id @default(cuid())
  organizationId String
  requestedById  String
  targetUserId   String? // null = full org deletion
  status         DataRequestStatus @default(PENDING)
  // Grace period (e.g. 14 days for full org deletion)
  scheduledFor   DateTime
  // Lifecycle
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  reason         String?
  // Audit preservation (audit logs may be retained per legal requirement)
  preserveAudit  Boolean           @default(true)
  // Timestamps
  createdAt      DateTime          @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation(fields: [requestedById], references: [id])
  targetUser   User?        @relation("DataDeletionTargetUser", fields: [targetUserId], references: [id])

  @@index([organizationId, status])
  @@index([scheduledFor])
  @@map("data_deletion_requests")
}

// ─────────────────────────────────────────────────────────────────
// Subscription — Stripe subscription state mirror (BAI-004 / 2026-07-15).
//
// Single source of truth for billing state. The Stripe customer +
// subscription objects are the canonical records, but THIS table is
// what the dashboard reads/writes for plan display, cancel/resume, and
// the Customer Portal redirect.
//
// Lifecycle:
//   - Insert: when checkout.session.completed fires (webhook).
//   - Update: on every customer.subscription.* event (idempotent).
//   - Soft-cancel: cancelAtPeriodEnd=true → status stays ACTIVE until
//     currentPeriodEnd. The customer can resume from the portal or via
//     the resume server action.
//   - Hard-cancel: status=CANCELED, canceledAt set, currentPeriodEnd
//     frozen. Row is kept for audit (no hard delete).
//
// Webhook idempotency: stripeEventId is UNIQUE. Replayed events (Stripe
// retries up to 3 days) are detected by the unique violation and turned
// into a no-op 200 response.
//
// RLS: tenant-isolated like all other organization-scoped rows. The
// webhook handler uses dbServiceRole (BYPASSRLS) because there's no
// user session in webhook context — the organizationId comes from the
// Stripe customer metadata we set in checkout creation.
// ─────────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String
  // Stripe identifiers
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  stripePriceId        String
  // Plan + status (denormalized for query speed; the canonical is Stripe)
  plan                 BillingPlan
  status               SubscriptionStatus
  // Billing period
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  // Cancellation
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  cancellationReason   String?
  // Trial
  trialStart           DateTime?
  trialEnd             DateTime?
  // Webhook idempotency — unique per Stripe event id
  lastStripeEventId    String?            @unique
  // Timestamps
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, stripeSubscriptionId])
  @@index([organizationId, status])
  @@index([stripeCustomerId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────────
// FeatureFlag — global catalog of feature flags
//
// One row per flag key. The key is a stable string identifier (e.g.
// "ai_streaming") shared across code + DB. The defaultValue is the
// fail-closed baseline: false means disabled unless explicitly enabled
// for an organization via OrgFeatureFlag.
//
// RLS: FeatureFlag is non-tenant (global catalog). The service role
// reads all rows when resolving flags for any org. Application layer
// enforces the per-org toggle via OrgFeatureFlag.
//
// Lifecycle:
//   - Flags are inserted via migration seed (INSERT ... ON CONFLICT DO NOTHING).
//   - Removing a flag from code: leave the DB row (soft-warn in logs,
//     no break). Hard-delete only when all references are gone.
// ─────────────────────────────────────────────────────────────────

model FeatureFlag {
  id           String         @id @default(cuid())
  key          String         @unique      // e.g. "ai_streaming", "vault_v2"
  description  String
  defaultValue Boolean        @default(false)
  createdAt    DateTime       @default(now())

  orgOverrides OrgFeatureFlag[]

  @@map("feature_flags")
}

// ─────────────────────────────────────────────────────────────────
// OrgFeatureFlag — per-organization flag overrides
//
// Each row says whether a specific flag is enabled/disabled for
// one organization. If no row exists, the flag falls back to
// FeatureFlag.defaultValue (fail-closed: false).
//
// RLS: tenant-scoped. The app sets `app.current_org_id` before
// any read so the DB enforces org isolation.
//
// Cache: the application caches resolved flags per-org for 30s
// (module-level Map in lib/feature-flags/client.ts). Toggle
// invalidates the cache immediately for the affected org.
// ─────────────────────────────────────────────────────────────────

model OrgFeatureFlag {
  id             String       @id @default(cuid())
  organizationId String
  flagKey        String
  enabled        Boolean
  updatedAt      DateTime     @updatedAt
  updatedBy      String?      // userId who last toggled

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flag         FeatureFlag  @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([organizationId, flagKey])
  @@index([organizationId])
  @@map("org_feature_flags")
}

// ─────────────────────────────────────────────────────────────────────────
// AI Usage Tracking (USAGE-001 — 2026-07-15)
//
// Per-request AI token usage records for:
//   - Usage-based billing (charge customers per token)
//   - Cost anomaly alerts (>2x daily average)
//   - Product analytics (which prompts use which models)
//
// Anonymous (marketing site) records have organizationId = null.
// Authenticated (dashboard) records link via organizationId.
// ─────────────────────────────────────────────────────────────────

model AiUsageEntry {
  id               String   @id @default(cuid())
  organizationId   String?            // nullable for marketing site anon chat
  userId           String?            // Clerk userId when authenticated
  sessionId        String?            // chat sessionId for context
  provider         String             // 'groq' | 'gemini'
  model            String             // 'llama-3.3-70b-versatile' | 'gemini-2.5-flash'
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  latencyMs        Int
  promptId         String?            // 'compliance' | 'policies' | ...
  cost             Decimal  @db.Decimal(10, 6)  // USD, computed at insert
  createdAt        DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([provider, createdAt])
  @@index([createdAt])
  @@map("ai_usage_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// Enterprise SSO (SSO-001 — 2026-07-15)
//
// Per-organization SAML 2.0 / OIDC connection metadata.
// Clerk handles the actual SAML protocol; we store a reference + the
// email domains that should auto-route to this IdP (used by our custom
// sign-in page to detect "is this an SSO-eligible user?").
//
// One row per organization (one active IdP at a time — multi-IdP is
// out of scope until customers ask).
// ─────────────────────────────────────────────────────────────────────────

model SamlConnection {
  id                          String   @id @default(cuid())
  organizationId              String   @unique
  provider                     String   // 'azure_ad' | 'okta' | 'google_workspace' | 'generic'
  clerkEnterpriseSsoId        String?  @unique  // Clerk's internal ID (set via webhook)
  // IdP-specific config (entityId, SSO URL, signing certificate) for
  // both Clerk Pro + native SAML SP paths.
  entityId                     String?  // SAML 2.0 EntityID (urn:...)
  ssoUrl                       String?  // SingleSignOnService URL
  sloUrl                       String?  // SingleLogoutService URL (optional)
  x509Cert                     String?  @db.Text  // IdP signing cert (PEM, multiline)
  nameIdFormat                 String?  // e.g. urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
  emailDomains                String[] // email domains that trigger SSO (e.g. ['acme.com'])
  enabled                     Boolean  @default(true)
  // IdP-specific config (attribute mapping, raw metadata XML).
  config                       Json     @default("{}")
  // Role mapping from SAML groups claim → BrightAI Role enum.
  // Example: { "compliance-officers": "COMPLIANCE_OFFICER", "admins": "ADMIN" }
  roleMapping                  Json     @default("{}")
  // Lifecycle.
  lastSsoLoginAt               DateTime?
  lastError                    String?  // Last failed assertion (for debugging)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([provider])
  @@index([enabled])
  @@map("saml_connections")
}

// ─────────────────────────────────────────────────────────────────────────
// Evaluation Certificates (EVAL-CERT-001 — 2026-08-03)
//
// Server-side evaluation runs + digitally-signed certificates.
// Non-tenant (public marketing kernel feature), NOT organization-scoped —
// like LeadQueue, these bypass RLS via dbServiceRole (BYPASSRLS).
//
// Rules enforced at the service layer (src/lib/kernel-certs/):
//   - No edit/delete of a completed (immutable) run.
//   - No duplicate caseId within an evaluation.
//   - Optimistic locking via `version`.
//   - Certificate signed via Ed25519 (node:crypto) — signature over a fixed
//     canonical payload. signedBy = «يزيد البديوي». Key rotation via
//     signing_keys.publicKeyId.
// ─────────────────────────────────────────────────────────────────────────

enum EvalEnvironment {
  demo
  test
  live
}

enum EvalRunStatus {
  running
  partial
  complete
  failed
  review
}

enum EvalGate {
  passed
  passed_with_findings
  review_required
  blocked
  incomplete
}

/// حالة بيت المفتاح العام المستخدم في التحقق من الشهادة (rotation).
model SigningKey {
  id           String   @id @default(cuid())
  publicKeyId  String   @unique        // e.g. "v1", "v2" — يُشار إليها في cert
  algorithm    String   @default("Ed25519")
  publicKeyPem String   @db.Text
  signedBy     String   @default("يزيد البديوي")
  createdAt    DateTime @default(now())
  revokedAt    DateTime?

  @@index([publicKeyId])
  @@map("signing_keys")
}

/// الحالة المحفوظة لـ run (partial saving / resume / replay).
model EvaluationRun {
  id                 String          @id @default(cuid())
  evaluationId       String          @unique
  parentEvaluationId String?         // عند إعادة تشغيل/نسخة للـ replay
  name               String
  status             EvalRunStatus   @default(running)
  gate               EvalGate        @default(incomplete)
  environment        EvalEnvironment @default(demo)
  provider           String          @default("simulated")

  // Refs (denormalized snapshot of the setup at run time)
  datasetId          String
  datasetVersion     Int
  datasetHash        String
  policyId           String
  policyVersion      Int
  policyHash         String
  modelId            String
  modelName          String
  modelVersion       Int
  modelProvider      String
  promptId           String
  promptVersion      Int

  // Progress
  totalCases         Int     @default(0)
  completedCases     Int     @default(0)
  failedCases        Int     @default(0)
  criticalCount      Int     @default(0)
  humanReviewCount   Int     @default(0)
  costSar            Decimal @db.Decimal(10, 4) @default(0)

  // Timing percentiles (ms)
  p50Ms              Int     @default(0)
  p95Ms              Int     @default(0)
  p99Ms              Int     @default(0)

  // Digests
  inputHash          String
  outputHash         String
  runHash            String

  // Optimistic lock + immutability
  version            Int     @default(1)
  immutable          Boolean @default(false) // frozen once complete

  // Timestamps
  startedAt          DateTime
  finishedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cases      EvaluationCase[]
  certificates EvaluationCertificate[]

  @@index([environment, createdAt])
  @@index([status])
  @@map("evaluation_runs")
}

/// نتيجة case واحدة ضمن run (caseId تنفرد داخل الـ run وأي تعديل يُعنف).
model EvaluationCase {
  id            String   @id @default(cuid())
  runId         String
  caseId        String
  traceId       String
  state         String   // pass/fail/partial/na/human-review/blocked
  expected      String   @db.Text
  actual        String   @db.Text
  riskLevel     String   // low/medium/high/critical
  piiTypes      String[] @default([])
  injectionDetected Boolean @default(false)
  scorerResults Json     @default("{}")
  costSar       Decimal  @db.Decimal(10, 4) @default(0)
  latencyMs     Int      @default(0)
  inputHash     String
  outputHash    String
  createdAt     DateTime @default(now())

  run EvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, caseId])
  @@index([runId])
  @@map("evaluation_cases")
}

/// الشهادة الموقّعة (قابلة للتحقق؛ سحب لا حذف).
model EvaluationCertificate {
  id              String          @id @default(cuid())
  certificateId   String          @unique
  runId           String
  signedBy        String          @default("يزيد البديوي")
  environment      EvalEnvironment @default(demo)
  gate            EvalGate
  signedAt        DateTime        @default(now())
  signedByKeyId   String          @default("v1")
  signature       String          @db.Text         // base64 DER / key value
  payloadDigest   String          // sha256Hex(canonicalJson(payload))
  payload         Json            // signed payload (exact) for verification
  verifyUrl       String
  revokedAt       DateTime?
  revokedBy       String?
  revocationReason String?
  createdAt       DateTime        @default(now())

  run EvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("evaluation_certificates")
}

/// سجل أحداث غير قابل للتعديل لكل دورة حياة شهادة/run (audit).
model EvaluationAuditEvent {
  id            String   @id @default(cuid())
  evaluationId  String
  certificateId String?
  action        String // create/resume/rerun/issue/revoke/verify_fail/verify_ok
  actor         String   @default("system")
  metadata      Json     @default("{}")
  prevHash      String?
  hash          String   // hash chain (tamper-evidence)
  createdAt     DateTime @default(now())

  @@index([evaluationId])
  @@index([certificateId])
  @@index([createdAt])
  @@map("evaluation_audit_events")
}
