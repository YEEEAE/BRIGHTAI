enum IntegrationConnector {
  SHAREPOINT
  SLACK
  TEAMS
  EMAIL
  WEBHOOK
  CUSTOM_API
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PolicyCategory {
  DATA_PRIVACY
  ACCESS_CONTROL
  MODEL_USAGE
  CONTENT_MODERATION
  INCIDENT_RESPONSE
  AUDIT_RETENTION
  CUSTOM
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPROVED
  EXPIRED
}

enum RequestRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
  PENDING_SETUP
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum DomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  FAILED
  SSL_PENDING
  SSL_ACTIVE
  SSL_FAILED
}

enum DataRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ActorType {
  USER
  SYSTEM
  SUPPORT
  API_KEY
}

// ─────────────────────────────────────────────────────────────────
// LeadQueue — durable outbox for marketing-site /api/lead submissions
// (HIGH-04 / 2026-07-15).
//
// Why durable:
//   - The Astro /api/lead/ endpoint receives leads from public kernel
//     pages. The previous in-memory queue (cap 100) was lost on every
//     Render restart.
//   - This table is the single source of truth: rows survive restarts,
//     enable idempotency, retry with exponential backoff, and DLQ.
//
// No organization_id: leads are pre-signup (public visitors). They are
// NOT tenant-scoped, so they bypass RLS via dbServiceRole. The service
// role has BYPASSRLS so it reads + writes without per-row policy.
//
// Lifecycle:
//   - PENDING     → newly enqueued, not yet attempted (or nextRetryAt in
//                   the future).
//   - SENDING     → an attempt is in flight (worker holds the row).
//   - DELIVERED   → webhook returned 2xx. deliveredAt recorded.
//   - DLQ         → attempts ≥ MAX_ATTEMPTS. lastError populated.
//                   CI cron prunes DLQ rows after 30 days.
//   - EXPIRED     → retention sweep deleted a delivered row (TTL). Only
//                   used for observability — actual delete is hard.
//
// Idempotency:
//   - idempotencyKey is UNIQUE. The Astro endpoint computes either the
//     client-provided `Idempotency-Key` header value, or a synthetic
//     fallback: sha256(ip + userAgent + contact + createdAtBucket).
//   - Duplicate keys return the existing row (same id, same response).
//   - Synthetic key bucket = current 30-second window. Same client
//     resubmitting within the same window yields the same key (idempotent).
//     Resubmitting across windows yields a different key (new lead).
//
// Retention:
//   - Delivered rows older than 7 days are deleted by
//     scripts/lead-retention-sweep.mjs (cron / scheduled job).
//   - DLQ rows older than 30 days are deleted by the same sweep.
// ─────────────────────────────────────────────────────────────────

enum LeadQueueStatus {
  PENDING
  SENDING
  DELIVERED
  DLQ
  EXPIRED
}

model LeadQueue {
  id             String          @id @default(cuid())
  // Idempotency
  idempotencyKey String          @unique
  // Lead payload — server-validated by Zod (3-120 chars each)
  name           String
  contact        String
  company        String
  page           String?
  source         String?
  // Submission context (used for synthetic key + audit; never PII-shared)
  ip             String?
  userAgent      String?
  // Delivery state
  status         LeadQueueStatus @default(PENDING)
  attempts       Int             @default(0)
  nextRetryAt    DateTime?
  lastError      String?
  webhookUrl     String?
  responseStatus Int?
  // Lead hash for log correlation (NOT the same as idempotencyKey)
  leadHash       String?
  // Timestamps
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deliveredAt    DateTime?
  dlqAt          DateTime?

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@index([status, dlqAt])
  @@map("lead_queue")
}

// ─────────────────────────────────────────────────────────────────
// Organization — the tenant
// ─────────────────────────────────────────────────────────────────

model Organization {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  nameAr      String
  crNumber    String?      @unique
  industry    Industry
  size        CompanySize
  deployment  DeploymentMode @default(CLOUD)
  logoUrl     String?
  primaryColor String?     // hex; default brand uses cyan/indigo
  settings    Json         @default("{}")
  // Onboarding
  onboardingStep        OnboardingStep @default(ORG_INFO)
  onboardingCompletedAt DateTime?
  // Compliance frameworks (selected at signup, mutable in settings)
  compliance  ComplianceFramework[]
  // Billing
  stripeCustomerId String? @unique
  planName        String  @default("trial")
  trialEndsAt     DateTime?
  // Soft delete
  deletedAt   DateTime?
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members             Membership[]
  invitations         Invitation[]
  policies            Policy[]
  requests            AIRequest[]
  integrations        Integration[]
  apiKeys             ApiKey[]
  auditLogs           AuditLog[]
  domains             Domain[]
  complianceRecords   OrganizationCompliance[]
  onboardingProgress  OnboardingProgress?
  dataExportRequests  DataExportRequest[]
  dataDeletionRequests DataDeletionRequest[]
  sessions            Session[]

  @@index([slug])
  @@index([deletedAt])
  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────
// User — synced from Clerk
// ─────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  clerkUserId   String   @unique
  email         String   @unique @db.Citext
  emailVerified Boolean  @default(false)
  fullName      String?
  fullNameAr    String?
  avatarUrl     String?
  phoneNumber   String?  @db.Citext
  phoneVerified Boolean  @default(false)
  primaryLocale String   @default("ar-SA")
  timezone      String   @default("Asia/Riyadh")
  // 2FA
  twoFactorEnabled  Boolean @default(false)
  twoFactorSecret   String? // encrypted at-rest (TOTP secret)
  twoFactorMethod   String? // 'totp' | 'sms' | null
  // Preferences
  preferences  Json     @default("{}")
  // Activity
  lastSeenAt   DateTime?
  // Soft delete
  deletedAt    DateTime?
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  memberships         Membership[]
  membershipsInvited    Membership[] @relation("MembershipInvitedBy")
  membershipsDeactivated Membership[] @relation("MembershipDeactivatedBy")
  passkeys            Passkey[]
  backupCodes         TwoFactorBackupCode[]
  sessions            Session[]
  sessionsRevoked     Session[] @relation("SessionRevokedBy")
  auditLogs           AuditLog[]
  invitationsSent     Invitation[] @relation("InvitationInvitedBy")
  apiKeysCreated      ApiKey[]
  dataExports         DataExportRequest[]
  dataDeletions       DataDeletionRequest[]
  dataDeletionsAsTarget DataDeletionRequest[] @relation("DataDeletionTargetUser")
  requestsCreated     AIRequest[]
  requestsReviewed    AIRequest[] @relation("AIRequestReviewedBy")
  impersonatedSessions Session[] @relation("SessionImpersonatedBy")

  @@index([clerkUserId])
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────
// Membership — User × Organization × Role × Status
// ─────────────────────────────────────────────────────────────────

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           Role
  status         MemberStatus @default(ACTIVE)
  // Invitation lineage
  invitedById    String?
  invitedAt      DateTime     @default(now())
  acceptedAt     DateTime?
  joinedAt       DateTime?
  // Deactivation
  deactivatedAt  DateTime?
  deactivatedById String?
  deactivationReason String?
  // Activity
  lastActiveAt   DateTime?
  // Preferences (per-org)
  preferences    Json         @default("{}")
  // Timestamps
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User?        @relation("MembershipInvitedBy", fields: [invitedById], references: [id])
  deactivatedBy  User?        @relation("MembershipDeactivatedBy", fields: [deactivatedById], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@index([organizationId, status])
  @@index([status])
  @@map("memberships")
}

// ─────────────────────────────────────────────────────────────────
// Invitation — pending team invites
// ─────────────────────────────────────────────────────────────────

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @db.Citext
  role           Role
  token          String   @unique // SHA-256 of the raw token (the lookup key — see app/invitation/[token]/page.tsx for hash flow)
  // Lifecycle
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  // Meta
  invitedById    String
  message        String?
  // Bulk import (CSV)
  batchId        String?
  // Timestamps
  createdAt      DateTime @default(now())

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@unique([organizationId, email])
  @@index([email])
  @@index([organizationId, expiresAt])
  @@index([batchId])
  @@map("invitations")
}

// ─────────────────────────────────────────────────────────────────
// Passkey — WebAuthn credentials
// ─────────────────────────────────────────────────────────────────

model Passkey {
  id            String   @id @default(cuid())
  userId        String
  credentialId  String   @unique // base64url-encoded
  publicKey     String   // base64url-encoded COSE key
  counter       BigInt   @default(0)
  deviceName    String?
  transports    String[] // ['usb', 'nfc', 'ble', 'internal']
  backupEligible Boolean @default(false)
  backupState   Boolean  @default(false)
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

// ─────────────────────────────────────────────────────────────────
// TwoFactorBackupCode — one-time recovery codes
// ─────────────────────────────────────────────────────────────────

model TwoFactorBackupCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   // bcrypt-hashed code
  usedAt    DateTime?
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

// ─────────────────────────────────────────────────────────────────
// Session — server-side session record (mirror of Clerk JWT)
// ─────────────────────────────────────────────────────────────────

model Session {
  id             String   @id @default(cuid())
  userId         String
  organizationId String? // current active tenant
  // Token
  tokenHash      String   @unique // SHA-256 of session cookie
  fingerprint    String?  // browser fingerprint hash
  // Request context
  ipAddress      String?
  userAgent      String?
  device         String?  // parsed device name
  country        String?
  // Lifecycle
  expiresAt      DateTime
  lastActiveAt   DateTime @default(now())
  revokedAt      DateTime?
  revokedById    String?
  revocationReason String?
  // Impersonation
  impersonatedById String?
  impersonationStartedAt DateTime?
  impersonationEndedAt   DateTime?
  impersonationReason    String?

  // Relations
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  revokedBy      User?         @relation("SessionRevokedBy", fields: [revokedById], references: [id])
  impersonatedBy User?         @relation("SessionImpersonatedBy", fields: [impersonatedById], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────
// Compliance frameworks join table (explicit for RLS clarity)
// ─────────────────────────────────────────────────────────────────

model OrganizationCompliance {
  organizationId String
  framework      ComplianceFramework
  enabledAt      DateTime @default(now())
  certifiedAt    DateTime?
  expiresAt      DateTime?
  notes          String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, framework])
  @@index([framework])
  @@map("organization_compliance")
}

// ─────────────────────────────────────────────────────────────────
// Policy — AI governance policy (e.g. "Block PII in prompts")
// ─────────────────────────────────────────────────────────────────

model Policy {
  id             String       @id @default(cuid())
  organizationId String
  // Identity
  name           String
  nameAr         String
  description    String?
  descriptionAr  String?
  category       PolicyCategory
  // Rules (JSON: conditions, actions, exceptions)
  rules          Json
  // Priority (higher = applied first; ties broken by createdAt asc)
  priority       Int          @default(0)
  // Lifecycle
  status         PolicyStatus @default(DRAFT)
  version        Int          @default(1)
  parentId       String?
  // Audit
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  // Timestamps
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Policy?      @relation("PolicyVersion", fields: [parentId], references: [id])
  versions       Policy[]     @relation("PolicyVersion")
  requests       AIRequest[]

  @@index([organizationId, status])
  @@index([organizationId, category])
  @@index([organizationId, createdAt])
  @@map("policies")
}

// ─────────────────────────────────────────────────────────────────
// AIRequest — gated AI request awaiting review
// ─────────────────────────────────────────────────────────────────

model AIRequest {
  id             String           @id @default(cuid())
  organizationId String
  requestedById  String
  policyId       String?
  // Payload
  prompt         String           @db.Text
  response       String?          @db.Text
  modelUsed      String?
  tokensUsed     Int?
  // Risk
  riskScore      Float?           // 0.0 - 1.0
  riskLevel      RequestRiskLevel?
  piiDetected    Boolean          @default(false)
  piiTypes       String[]
  // Review
  status         RequestStatus    @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNotes    String?
  // Lifecycle
  expiresAt      DateTime?
  // Timestamps
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    User             @relation(fields: [requestedById], references: [id])
  reviewedBy     User?            @relation("AIRequestReviewedBy", fields: [reviewedById], references: [id])
  policy         Policy?          @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, riskLevel])
  @@index([requestedById, createdAt])
  @@map("ai_requests")
}

// ─────────────────────────────────────────────────────────────────
// Integration — SharePoint / Slack / Teams / etc.
// ─────────────────────────────────────────────────────────────────

model Integration {
  id             String              @id @default(cuid())
  organizationId String
  connector      IntegrationConnector
  // Display
  displayName    String
  // Config (encrypted at-rest JSON)
  config         Json
  // Status
  status         IntegrationStatus   @default(PENDING_SETUP)
  errorMessage   String?
  // Sync
  lastSyncAt     DateTime?
  syncCursor     String?
  // Audit
  connectedById  String
  // Timestamps
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  disconnectedAt DateTime?

  // Relations
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, connector, displayName])
  @@index([organizationId, status])
  @@map("integrations")
}

// ─────────────────────────────────────────────────────────────────
// ApiKey — programmatic access
// ─────────────────────────────────────────────────────────────────

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  // First 8 chars for display (e.g. "bk_live_")
  prefix         String
  // SHA-256 of the full key (raw never stored)
  hashedKey      String       @unique
  // Authorization
  scopes         String[]
  // Lifecycle
  status         ApiKeyStatus @default(ACTIVE)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  lastUsedIp     String?
  // Audit
  createdById    String
  revokedAt      DateTime?
  revokedById    String?
  revocationReason String?
  // Timestamps
  createdAt      DateTime     @default(now())

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id])

  @@index([organizationId, status])
  @@index([prefix])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────────
// AuditLog — immutable log of every privileged action
// ─────────────────────────────────────────────────────────────────

model AuditLog {
  id             String     @id @default(cuid())
  organizationId String
  // Actor (may be null for SYSTEM)
  actorId        String?
  actorType      ActorType  @default(USER)
  // Action
  action         AuditAction
  // Target
  targetType     String?    // 'Policy' | 'AIRequest' | etc
  targetId       String?
  // Context
  ipAddress      String?
  userAgent      String?
  // Free-form metadata (JSON)
  metadata       Json       @default("{}")
  // Hash chain (tamper-evidence)
  prevHash       String?
  hash           String?
  // Timestamp
  createdAt      DateTime   @default(now())

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────
// TokenMapping — reversible tokenization vault (AI Firewall Phase 1c)
//
// Maps an opaque token (TKN_xxx) back to the original PII value.
// Encrypted at rest with HMAC-SHA256 using the org's vault key.
// The plaintext value is NEVER stored — only the HMAC-protected
// ciphertext. To resolve, the caller must have the current vault
// key (or the previous key during a 24h rotation window).
// ─────────────────────────────────────────────────────────────────

model TokenMapping {
  id             String   @id @default(cuid())
  organizationId String
  // The token (e.g. "TKN_a1b2c3d4...") — what the LLM sees.
  token          String
  // HMAC-SHA256(token, vault_key) — proves the token was issued
  // by this vault. Not a secret, but authenticates the token.
  tokenHmac      String
  // AES-256-GCM ciphertext of the original value. Encrypted with
  // a key derived from FIREWALL_TOKEN_VAULT_KEY via HKDF.
  encryptedValue String
  // IV for the AES-GCM ciphertext (base64).
  iv             String
  // Auth tag for the AES-GCM ciphertext (base64).
  authTag        String
  // Which key encrypted this (for rotation: "current" | "prev").
  keyVersion     String   @default("current")
  // Original PII type (for audit context, not used for resolution).
  piiType        String
  // Lifecycle
  expiresAt      DateTime?
  // Audit
  createdById    String
  createdAt      DateTime @default(now())

  @@unique([organizationId, token])
  @@index([organizationId, createdAt])
  @@index([organizationId, piiType])
  @@index([expiresAt])
  @@map("token_mappings")
}

// ─────────────────────────────────────────────────────────────────
// Domain — custom domains for an org (e.g. ai.acme.com)
// ─────────────────────────────────────────────────────────────────

model Domain {
  id                  String       @id @default(cuid())
  organizationId      String
  domain              String       @unique
  // Verification
  verificationToken   String
  isVerified          Boolean      @default(false)
  verifiedAt          DateTime?
  // SSL
  sslStatus           DomainStatus @default(PENDING_VERIFICATION)
  sslIssuedAt         DateTime?
  sslExpiresAt        DateTime?
  // CNAME
  cnameTarget         String       @default("proxy.brightai.site")
  // Primary flag (only one per org)
  isPrimary           Boolean      @default(false)
  // Timestamps
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Relations
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@index([organizationId, isPrimary])
  @@map("domains")
}

// ─────────────────────────────────────────────────────────────────
// OnboardingProgress — 5-step wizard state
// ─────────────────────────────────────────────────────────────────

model OnboardingProgress {
  id              String         @id @default(cuid())
  organizationId  String         @unique
  currentStep     OnboardingStep @default(ORG_INFO)
  completedSteps  OnboardingStep[] @default([])
  // Per-step partial data (so user can resume)
  stepData        Json           @default("{}")
  completedAt     DateTime?
  // Timestamps
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

// ─────────────────────────────────────────────────────────────────
// DataExportRequest — PDPL data export
// ─────────────────────────────────────────────────────────────────

model DataExportRequest {
  id              String           @id @default(cuid())
  organizationId  String
  requestedById   String
  status          DataRequestStatus @default(PENDING)
  // Result
  downloadUrl     String?
  downloadExpiresAt DateTime?
  fileSizeBytes   BigInt?
  // Metadata
  recordCounts    Json?            // { users: 5, policies: 12, ... }
  // Lifecycle
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  // Timestamps
  createdAt       DateTime         @default(now())

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy     User             @relation(fields: [requestedById], references: [id])

  @@index([organizationId, status, createdAt])
  @@map("data_export_requests")
}

// ─────────────────────────────────────────────────────────────────
// DataDeletionRequest — PDPL right-to-be-forgotten
// ─────────────────────────────────────────────────────────────────

model DataDeletionRequest {
  id              String           @id @default(cuid())
  organizationId  String
  requestedById   String
  targetUserId    String?          // null = full org deletion
  status          DataRequestStatus @default(PENDING)
  // Grace period (e.g. 14 days for full org deletion)
  scheduledFor    DateTime
  // Lifecycle
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  reason          String?
  // Audit preservation (audit logs may be retained per legal requirement)
  preserveAudit   Boolean          @default(true)
  // Timestamps
  createdAt       DateTime         @default(now())

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy     User             @relation(fields: [requestedById], references: [id])
  targetUser      User?            @relation("DataDeletionTargetUser", fields: [targetUserId], references: [id])

  @@index([organizationId, status])
  @@index([scheduledFor])
  @@map("data_deletion_requests")
}