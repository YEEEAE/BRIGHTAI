// ═══════════════════════════════════════════════════════════════════
// BrightAI Prisma Schema — Multi-tenant SaaS Database
// ═══════════════════════════════════════════════════════════════════
//
// Architecture:
//   - Organization = tenant (slug + optional customDomain)
//   - User synced from Clerk via webhook (clerkUserId is the join key)
//   - Membership = (User × Organization × Role × Status)
//   - Row-Level Security (RLS) in prisma/policies/rls.sql enforces
//     tenant isolation at the database level. The application MUST
//     set `app.current_org_id` before each query.
//
// Enums mirror @brightai/config/src/constants.ts. If you change one,
// change the other.
//
// Naming:
//   - Models:    PascalCase, singular
//   - Fields:    camelCase
//   - Tables:    snake_case via @@map
//   - Indexes:   idx_<table>_<columns>
//   - FK names:  fk_<from>_<to>
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // HIGH-04 / PRISMA-RESOLUTION-001 (2026-07-18): Output goes to the
  // pnpm-hoisted `.prisma/client/` at the workspace root, NOT to
  // `packages/db/node_modules/.prisma/client/`. Reason:
  //   - TypeScript with `moduleResolution: "Bundler"` (the db package
  //     default) follows symlinks when resolving modules. From any
  //     workspace package, `@prisma/client` resolves to the pnpm-store
  //     location (`node_modules/.pnpm/@prisma+client@.../.../@prisma/client/`).
  //   - The `@prisma/client/default.d.ts` in that location re-exports
  //     from `.prisma/client/default`, which TS resolves relative to
  //     the pnpm-store path, NOT the source-file path. So the generated
  //     client must live under the pnpm-store sibling, not under
  //     `packages/db/node_modules/.prisma/client/`.
  //   - Writing to `../../node_modules/.prisma/client` (from
  //     `packages/db/prisma/schema.prisma`) places the output at the
  //     hoisted root, which both runtime (Node.js walks up from
  //     `packages/db/node_modules/@prisma/client/`) and TypeScript
  //     (resolves from the pnpm-store symlink) can find.
  output          = "../../../node_modules/.prisma/client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, citext]
}

