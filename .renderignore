# .renderignore — BAI-SEC-10 (2026-07-25)
#
# Render Static Sites + Render Web Services do NOT honour .gitignore
# when collecting build context. This file is the explicit allow/deny
# list for the build context that Render uploads as the service.
#
# Render uses these patterns (see https://docs.render.com/disable-google-analytics):
#   - .renderignore   — applies to Render Web Services (Node runtime)
#   - .dockerignore   — applies to Render Docker services
#
# This is the .renderignore for the brightai-site Node service. Patterns
# are gitignore-style (one per line, ! for negation, # for comments).
#
# Why this file exists:
#   The build artifact (dist/) is the ONLY thing the Node service needs
#   at runtime. Anything else in the repo (source files, .agents/,
#   scripts/, docs/, frontend/ legacy residue, etc.) MUST be excluded
#   from the build context. Even though the deny-list middleware
#   (src/server/deny-list.mjs) blocks accidental leaks at runtime,
#   excluding the files at the build context level is the first
#   line of defence — fail-fast at upload time, not at request time.
#
# Mirror policy: this file's deny patterns must stay in sync with
# scripts/verify-deployment-surface.mjs DENY_LIST_SURFACE. If you add a
# new forbidden path to the verifier, also add it here.
#
# Mirror policy 2: the entry point + start command in render.yaml must
# stay aligned with this list. The current runtime entrypoint is
# `node ./dist/server/entry.mjs`, which only reads from dist/server/.

# ── Build output: ONLY dist/ matters at runtime ──
# dist/ is the artifact astro build produces. Everything outside dist/
# is source / dev / doc and must not be uploaded.

# Source code that must not be uploaded
/src
/src/**
/scripts
/scripts/**

# Repo metadata that must not be uploaded
/.agents
/.agents/**
/.astro
/CLAUDE.md
/AGENTS.md
/report
/report/**
/_reports
/_reports/**
/reports
/reports/**
/docs
/docs/**
/audit
/audit/**
/artifacts
/artifacts/**
/download
/download/**
/demo
/demo/**
/blog
/blog/**
/components
/components/**
/kernel
/kernel/**
/strategy
/strategy/**
/customer-success
/customer-success/**
/solutions
/solutions/**

# Frontend (legacy backend, deleted per DEC-011 — residual paths
# would be leaked to brightai.live if .renderignore did not catch them)
/frontend
/frontend/**

# Workspace + apps that should never reach the Astro build context
/apps
/apps/**
/packages
/packages/**

# Private (notes / not for production)
/private
/private/**

# Env + secrets + state
.env
.env.*
*.env
!.env.example

# Tool / CI residue
/.github
/.github/**
/.git
/.git/**
/.gitignore
/.dockerignore
/.renderignore
/.gitattributes
/.vscode
/.vscode/**
/.qoder
/.qoder/**
/.hermes
/.hermes/**
/.roo
/.roo/**
/.opencode.json
/opencode.json
/.lighthouseci
/.lighthouseci/**
/.lighthouserc.json
/.playwright-cli
/.playwright-cli/**
/.clinerules
/.clinerules/**
/.claude
/.claude/**
/.storybook
/.storybook/**
/.vercel
/.vercel/**
/.cspell
/.cspell/**

# Lock files (not needed at runtime; render runs `pnpm install` itself)
/pnpm-lock.yaml
/package-lock.json
/package-lock 2.json
/yarn.lock

# Test / bench / coverage
/coverage
/coverage/**
**/*.test.ts
**/*.test.mjs
**/*.spec.ts
**/*.spec.mjs
**/__tests__
**/__tests__/**
**/tests
**/tests/**

# OS + editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Compressed archives (never runtime)
/*.tgz
/*.tar.gz
/*.zip
/META-CHANGES.csv

# Local config that is not the deployment surface
/tsconfig.json
/tsconfig.tsbuildinfo
/vitest.config.js
/eslint.config.mjs
/Makefile
/MONOREPO.md
/Dockerfile
/docker-compose.yml

# Skill artifacts (dev-only)
/skills-lock.json
