# DOCKER-001 (2026-07-15): Exclude non-production paths from Docker build context.

# Dependencies (re-installed inside the image via pnpm install).
node_modules
**/node_modules
.pnpm-store

# Build outputs (regenerated inside the image).
dist
.astro
.next
.render-static
build

# Version control + CI.
.git
.github
.gitignore
.gitattributes

# Tests (not needed at runtime).
**/*.test.mjs
**/*.test.ts
**/__tests__
**/tests
scripts/test-*.mjs

# Dev documentation (not needed in production image).
CLAUDE.md
prompts.md
docs

# Snapshots + reports (historical archives, never runtime files).
.agents/snapshots
.agents/brain.md
.agents/types
.agents/plugins
.agents/vendored-artifacts
_reports
report
reports
download
demo

# CI residue.
seo_gate_log.txt
*.tgz
*.tar.gz
package-lock 2.json
package-lock.json
yarn.lock
.opencode.json
opencode.json

# Local env files (Docker uses env vars from compose/render).
.env
.env.*
**/.env

# Editor / OS noise.
.vscode
.idea
.DS_Store
Thumbs.db

# Docker itself (avoid recursive COPY).
Dockerfile
.dockerignore
docker-compose.yml