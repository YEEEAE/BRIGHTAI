# ── Server ──
PORT=3000
NODE_ENV=development

# ── Security ──
JWT_SECRET=replace_with_a_long_random_jwt_secret
SESSION_SECRET=replace_with_a_long_random_session_secret
DASHBOARD_TOKEN=

# ── Gemini AI ──
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Excel Data Source (Official) ──
# ALL_ITEMS_MAIS_with_life_years.xlsx — Stock/Life Risk analysis by Batch
# Use absolute path or /BRIGHTAI/... shorthand (resolves to <project-parent>/BRIGHTAI/...)
EXCEL_FILE_PATH=/Users/yzydalshmry/Desktop/BRIGHTAI/reports/internal-links/ALL_ITEMS_MAIS_with_life_years.xlsx

# ── CORS ──
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Logging ──
LOG_LEVEL=info

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Bootstrap Admin (seeded on first run only) ──
# If BOOTSTRAP_ADMIN_PASSWORD is empty, a random password is generated and printed to console.
BOOTSTRAP_ADMIN_EMAIL=yazeed@brightai.site
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Super Admin

# ── Optional: Focus ERP Integration (future — actual reject source) ──
FOCUS_API_URL=
FOCUS_API_TOKEN=
