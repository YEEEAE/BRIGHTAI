NODE_ENV=development
PORT=3001

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Demo settings
DEMO_GEMINI_TIMEOUT_MS=30000
DEMO_MOCK_PROVIDER=0

# Optional RAG tuning
RAG_INDEX_REFRESH_MS=600000
RAG_MAX_FILES=180
RAG_MAX_FILE_BYTES=512000
RAG_CHUNK_SIZE_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=180
RAG_MIN_CHUNK_CHARS=130

# Rate limiting
DEMO_RATE_LIMIT_WINDOW_MS=60000
DEMO_RATE_LIMIT_MAX=10
