{
  "name": "brightai-backend",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "build": "echo 'No build step required for brightai-backend'",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:setup": "npm install --no-audit --no-fund",
    "test": "vitest run --config vitest.config.mjs",
    "test:ai-gateway:mock": "AI_GATEWAY_MOCK_MODE=1 node scripts/test-gemini-unified-api.mjs",
    "test:ai-gateway:live": "node scripts/test-gemini-unified-api.mjs --live"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^4.22.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "vitest": "^1.0.0"
  }
}
