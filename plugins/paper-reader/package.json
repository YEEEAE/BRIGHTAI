{
  "name": "@local/paper-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A right-sidebar PDF paper reader with lossless originals, text selection, highlights, notes, and chat prompts.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "vendor/LICENSE.pdfjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
