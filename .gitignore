# Note: .min.js and .min.css files are now included in git (needed for production)

# CLEANUP-2026-07-16 (DEPLOY-FIX): vitest coverage artifacts
# Render deploy failed at commit 58034d8 because 30+ coverage HTML/JSON/PNG files
# were committed. These are generated by `pnpm vitest run --coverage` and must
# NEVER be tracked. See report/RELEASE-READINESS-BOARD-2026-07-16.md (D-8).
apps/dashboard/coverage/
coverage/
*.lcov

# BAI-REPO-13 (2026-07-25): internal state files moved outside the public repo
# These files were bloating git history (1MB+ per commit) and exposing internal
# memory + sensitive context. The agent's brain lives at ~/agents-data/brightai/.
# Skills, types, and plugins under .agents/ stay in the repo (they're tooling).
.agents/brain.md
.agents/AGENTS.md
.agents/snapshots/
.agents/vendored-artifacts/
.lighthouseci/

# Publish surface protection - these should never be published
.ai-reject-dashboard/.env
.telegram-devto-bot/.env
private/
.next/

# Cache
.cache/
.parcel-cache/
tmp/
reports/

# CLEANUP-2026-07-15: tarballs + CI residue (no longer needed in repo)
*.tgz
*.tar.gz
/seo_gate_log.txt

