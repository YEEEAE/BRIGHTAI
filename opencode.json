{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      },
      "21st": {
        "type": "remote",
        "url": "https://21st.dev/api/mcp"
      },
      "stitch": {
        "type": "remote",
        "url": "https://stitch.googleapis.com/mcp"
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.12.0",
          "--no-usage-statistics"
        ]
      },
      "mgd-design": {
        "type": "remote",
        "url": "https://madegooddesigns.com/inspiration/mcp/core",
        "enabled": true
      },
      "firecrawl": {
        "type": "remote",
        "url": "https://mcp.firecrawl.dev/v2/mcp-oauth"
      },
      "openseo": {
        "type": "remote",
        "url": "https://app.openseo.so/mcp"
      },
      "similarweb": {
        "type": "remote",
        "url": "https://mcp.similarweb.com",
        "oauth": false,
        "headers": {
          "api-key": "{env:SIMILARWEB_API_KEY}"
        }
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      }
    }
  },
  "skills": {
    "paths": [
      ".agents/skills/awesome-design-md",
      ".agents/skills/design-md",
      ".agents/skills/frontend-design",
      ".agents/skills/google-indexing-seo-guardian",
      ".agents/skills/intelligent-content-reviewer-validator",
      ".agents/skills/internal-links-guardian",
      ".agents/skills/karpathy-guidelines",
      ".agents/skills/render-deploy",
      ".agents/skills/rtl-ui-guardian",
      ".agents/skills/seo",
      ".agents/skills/seo-audit",
      ".agents/skills/seo-content",
      ".agents/skills/seo-geo",
      ".agents/skills/seo-hreflang",
      ".agents/skills/seo-images",
      ".agents/skills/seo-local",
      ".agents/skills/seo-page",
      ".agents/skills/seo-plan",
      ".agents/skills/seo-schema",
      ".agents/skills/seo-sitemap",
      ".agents/skills/seo-technical",
      ".agents/skills/vercel-react-best-practices"
    ]
  }
}
