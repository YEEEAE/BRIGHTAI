---
/**
 * RelatedPosts — Displays related blog posts with cards.
 */
import type { BlogPost } from '../data/blog';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <aside class="related-posts" aria-labelledby="related-title">
    <h2 id="related-title">📄 مقالات ذات صلة</h2>
    <div class="related-posts__grid">
      {posts.map(post => (
        <a href={`/blog/${post.slug}/`} class="related-posts__card">
          <span class="related-posts__category">{post.category}</span>
          <h3>{post.title}</h3>
          <p>{post.description}</p>
          <span class="related-posts__meta">{post.pubDate} · {post.readingTime} دقائق</span>
        </a>
      ))}
    </div>
  </aside>
)}

<style is:global>
  .related-posts {
    margin-block-start: 3rem;
    padding-block-start: 2rem;
    border-block-start: 1px solid rgba(148, 163, 184, 0.16);
  }
  .related-posts > h2 {
    color: var(--neutral-50);
    font-size: 1.25rem;
    margin-block-end: 1rem;
  }
  .related-posts__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .related-posts__card {
    display: block;
    padding: 1.25rem;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 1rem;
    background: rgba(15, 23, 42, 0.5);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .related-posts__card:hover,
  .related-posts__card:focus-visible {
    border-color: var(--interactive-primary);
  }
  .related-posts__category {
    display: inline-block;
    margin-block-end: 0.5rem;
    color: var(--interactive-primary);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .related-posts__card h3 {
    margin: 0 0 0.5rem;
    color: var(--neutral-50);
    font-size: 1rem;
    line-height: 1.4;
  }
  .related-posts__card p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-posts__meta {
    display: block;
    margin-block-start: 0.75rem;
    font-size: 0.75rem;
    /* DEC-2026-031: tertiary opacity for related-posts meta (0.58, ≈ 5.25:1).
       Was: --fg-muted fallback to --text-muted (~3.4:1, below AA).
       New: primary × 0.58 → passes WCAG AA. */
    color: var(--text-primary);
    opacity: var(--text-tertiary-opacity);
  }
  @media (prefers-reduced-motion: reduce) {
    .related-posts__card { transition: none; }
  }
</style>