---
/**
 * Header — Sticky glass-blur navigation bar with dropdowns.
 * Features: RTL/LTR, keyboard nav, aria-labels, WhatsApp CTA, "Book Demo" CTA.
 * Touch targets ≥ 44px. Progressive enhancement (works without JS for links).
 */
import { NAV, CTA_NAV } from '../data/navigation';
import { SITE } from '../data/site';
import type { NavItem } from '../data/navigation';

interface Props {
  lang?: 'ar' | 'en';
  currentPath?: string;
}

const { lang = 'ar', currentPath = '/' } = Astro.props;
const isAr = lang === 'ar';

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

/** Pre-compute grouped dropdowns in frontmatter to avoid IIFE in template */
interface DropdownGroup {
  label: string;
  items: NavItem[];
}

const dropdownGroups = new Map<number, DropdownGroup[]>();

NAV.forEach((item, idx) => {
  if (!item.children) return;
  const map = new Map<string, NavItem[]>();
  const ungrouped: NavItem[] = [];
  for (const child of item.children) {
    const g = child.group || '';
    if (g) {
      if (!map.has(g)) map.set(g, []);
      map.get(g)!.push(child);
    } else {
      ungrouped.push(child);
    }
  }
  const groups: DropdownGroup[] = [];
  for (const [name, items] of map) {
    groups.push({
      label: isAr ? (items[0].groupAr || name) : name,
      items,
    });
  }
  if (ungrouped.length > 0) {
    groups.push({
      label: groups.length > 0 ? (isAr ? 'عام' : 'General') : '',
      items: ungrouped,
    });
  }
  dropdownGroups.set(idx, groups);
});
---

<header class="site-header" role="banner">
  <div class="site-header__inner">
    <!-- Logo -->
    <a href="/" class="site-header__logo" aria-label={isAr ? 'برايت أيه آي — الصفحة الرئيسية' : 'BrightAI — Home'} transition:animate="fade">
      {/* WCAG fix (REPORTS-18): alt="" because the visible <span> already
          names the brand. Without this, screen readers announce
          "BrightAI logo BrightAI" (redundant). The logo is decorative
          in this context because the link's aria-label provides the
          accessible name. */}
      <img src="/logo-96.webp" alt="" width="36" height="36" class="site-header__logo-img" fetchpriority="high" decoding="async" />
      <span class="site-header__logo-text">BrightAI</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="site-header__nav" aria-label={isAr ? 'القائمة الرئيسية' : 'Main navigation'}>
      <ul class="site-header__nav-list" role="menubar">
        {NAV.map((item, idx) => {
          const groups = dropdownGroups.get(idx);
          const itemActive = isActive(item.href);
          return (
            <li class="site-header__nav-item" role="none">
              {groups ? (
                <div class="site-header__dropdown" data-dropdown>
                  <button
                    class:list={[
                      'site-header__nav-link',
                      'site-header__dropdown-trigger',
                      { 'site-header__nav-link--active': itemActive },
                    ]}
                    role="menuitem"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls={`dropdown-${idx}`}
                    aria-current={itemActive ? 'page' : undefined}
                    data-dropdown-trigger
                  >
                    <span>{isAr ? item.labelAr : item.label}</span>
                    <svg class="site-header__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M3 5L6 8L9 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                  <div
                    id={`dropdown-${idx}`}
                    class="site-header__dropdown-panel"
                    role="menu"
                    aria-label={isAr ? item.labelAr : item.label}
                    data-dropdown-panel
                  >
                    <div class="site-header__dropdown-grid">
                      {groups.map((group) => (
                        <div class="site-header__dropdown-group">
                          {group.label && (
                            <span class="site-header__dropdown-group-label">
                              {group.label}
                            </span>
                          )}
                          {group.items.map((child) => (
                            <a
                              href={child.href}
                              class:list={[
                                'site-header__dropdown-link',
                                { 'site-header__dropdown-link--active': currentPath === child.href },
                              ]}
                              role="menuitem"
                              tabindex="-1"
                              aria-current={currentPath === child.href ? 'page' : undefined}
                            >
                              {isAr ? child.labelAr : child.label}
                            </a>
                          ))}
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              ) : (
                <a
                  href={item.href}
                  class:list={[
                    'site-header__nav-link',
                    { 'site-header__nav-link--active': isActive(item.href) },
                  ]}
                  role="menuitem"
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {isAr ? item.labelAr : item.label}
                </a>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Actions: WhatsApp + CTA + Burger -->
    <div class="site-header__actions">
      <a
        href={`${SITE.whatsapp.url}?text=${encodeURIComponent(isAr ? SITE.whatsapp.message.ar : SITE.whatsapp.message.en)}`}
        class="site-header__whatsapp"
        target="_blank"
        rel="nofollow noopener noreferrer"
        aria-label={isAr ? 'تواصل معنا عبر واتساب' : 'Chat on WhatsApp'}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>

      {CTA_NAV.map((item) => (
        <a href={item.href} class="site-header__cta btn btn--primary btn--sm">
          {isAr ? item.labelAr : item.label}
        </a>
      ))}

      <button
        class="site-header__burger"
        aria-label={isAr ? 'فتح القائمة' : 'Open menu'}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-toggle
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7H20M4 12H20M4 17H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="site-header__overlay" data-header-overlay aria-hidden="true"></div>

<script>
  document.addEventListener('astro:page-load', () => {
    const header = document.querySelector('.site-header');
    const overlay = document.querySelector('[data-header-overlay]') as HTMLDivElement | null;
    if (!header || !overlay) return;

    let openDropdown: HTMLElement | null = null;

    function openPanel(trigger: HTMLButtonElement, panel: HTMLElement) {
      closeAll();
      trigger.setAttribute('aria-expanded', 'true');
      panel.classList.add('site-header__dropdown-panel--open');
      overlay?.classList.add('site-header__overlay--active');
      openDropdown = panel;
      panel.querySelectorAll('[role="menuitem"]').forEach((l) => l.setAttribute('tabindex', '0'));
    }

    function closePanel(trigger: HTMLButtonElement, panel: HTMLElement) {
      trigger.setAttribute('aria-expanded', 'false');
      panel.classList.remove('site-header__dropdown-panel--open');
      overlay?.classList.remove('site-header__overlay--active');
      openDropdown = null;
      panel.querySelectorAll<HTMLElement>('[role="menuitem"]').forEach((l) => l.setAttribute('tabindex', '-1'));
    }

    function closeAll() {
      if (!header || !overlay) return;
      header.querySelectorAll<HTMLButtonElement>('[data-dropdown-trigger]').forEach((t) => t.setAttribute('aria-expanded', 'false'));
      header.querySelectorAll<HTMLElement>('[data-dropdown-panel]').forEach((p) => p.classList.remove('site-header__dropdown-panel--open'));
      overlay.classList.remove('site-header__overlay--active');
      openDropdown = null;
    }

    header.querySelectorAll('[data-dropdown]').forEach((dropdown) => {
      const trigger = dropdown.querySelector('[data-dropdown-trigger]') as HTMLButtonElement;
      const panel = dropdown.querySelector('[data-dropdown-panel]') as HTMLElement;
      if (!trigger || !panel) return;

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        if (trigger.getAttribute('aria-expanded') === 'true') {
          closePanel(trigger, panel);
        } else {
          openPanel(trigger, panel);
        }
      });

      trigger.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowDown' || e.key === ' ') {
          e.preventDefault();
          openPanel(trigger, panel);
          panel.querySelector<HTMLElement>('[role="menuitem"]')?.focus();
        }
      });

      panel.addEventListener('keydown', (e: KeyboardEvent) => {
        const items = Array.from(panel.querySelectorAll<HTMLElement>('[role="menuitem"]'));
        const idx = items.indexOf(document.activeElement as HTMLElement);
        if (e.key === 'ArrowDown') { e.preventDefault(); (items[idx + 1] || items[0]).focus(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); (items[idx - 1] || items[items.length - 1]).focus(); }
        else if (e.key === 'Escape') { e.preventDefault(); closePanel(trigger, panel); trigger.focus(); }
        else if (e.key === 'Tab') { closePanel(trigger, panel); }
      });
    });

    overlay.addEventListener('click', closeAll);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--glass-strong);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid var(--border-subtle);
    isolation: isolate;
  }

  /* Top hairline highlight — gives the glass header a tangible upper edge
     so it reads as a separate plane above the page rather than a flat bar.
     Sits above background, below content (z-index 0 on a transformed pseudo). */
  .site-header::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent 0%,
      var(--glass-highlight-strong) 50%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* Subtle noise grain on the header bar — same 2.2% token used by cards,
     so the glass treatment visually rhymes with the rest of the UI. */
  .site-header::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image: var(--noise-svg);
    background-size: 200px 200px;
    background-repeat: repeat;
    opacity: var(--noise-card);
    mix-blend-mode: overlay;
  }

  .site-header__inner {
    position: relative;
    z-index: 1;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-inline: var(--space-4);
    padding-block: var(--space-3);
    max-width: 1280px;
    margin-inline: auto;
    height: 72px;
  }

  @media (min-width: 768px) {
    .site-header__inner { padding-inline: var(--space-6); }
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--text-primary);
    font-weight: var(--font-bold);
    font-size: var(--text-lg);
    flex-shrink: 0;
    min-height: 44px;
  }

  .site-header__logo-text { letter-spacing: -0.02em; }

  .site-header__logo-img {
    width: 36px;
    height: 36px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .site-header__nav { display: none; }
  @media (min-width: 1024px) { .site-header__nav { display: flex; } }

  .site-header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav-item { position: relative; }

  .site-header__nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding-inline: var(--space-3);
    padding-block: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    border-radius: var(--radius-md);
    transition: color var(--duration-fast) var(--ease-out),
                background var(--duration-fast) var(--ease-out);
    min-height: 44px;
    cursor: pointer;
    border: none;
    background: none;
    font-family: inherit;
    white-space: nowrap;
  }

  .site-header__nav-link:hover,
  .site-header__nav-link:focus-visible {
    color: var(--text-primary);
    background: var(--bg-elevated);
  }

  .site-header__nav-link--active { color: var(--interactive-primary); }

  .site-header__nav-link:focus-visible {
    outline: 2px solid var(--interactive-primary);
    outline-offset: 2px;
  }

  .site-header__chevron { transition: transform var(--duration-fast) var(--ease-out); }
  .site-header__dropdown-trigger[aria-expanded="true"] .site-header__chevron { transform: rotate(180deg); }

  .site-header__dropdown { position: relative; }

  .site-header__dropdown-panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    inset-inline-start: 0;
    min-width: 280px;
    max-width: 520px;
    background: var(--glass-strong);
    backdrop-filter: var(--glass-blur-lg);
    -webkit-backdrop-filter: var(--glass-blur-lg);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xl);
    box-shadow:
      var(--shadow-xl),
      var(--highlight-inner-strong);
    padding: var(--space-4);
    opacity: 0;
    visibility: hidden;
    transform: translateY(var(--space-2));
    transition: opacity var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out),
                visibility var(--duration-fast) var(--ease-out);
    z-index: 100;
    isolation: isolate;
    overflow: hidden;
  }

  /* Cyan top edge + noise grain on dropdown panel — matches the header treatment
     so they read as one continuous frosted surface when stacked. */
  .site-header__dropdown-panel::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(42, 138, 126, 0.35) 50%,   /* DEC-SovB-001: Teal */
      transparent 100%
    );
    z-index: 1;
  }

  .site-header__dropdown-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: var(--noise-svg);
    background-size: 200px 200px;
    background-repeat: repeat;
    opacity: var(--noise-card);
    mix-blend-mode: overlay;
    z-index: 0;
    border-radius: inherit;
  }

  .site-header__dropdown-panel > * {
    position: relative;
    z-index: 2;
  }

  .site-header__dropdown-panel--open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .site-header__dropdown-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 1024px) {
    .site-header__dropdown-grid { flex-direction: row; gap: var(--space-6); }
  }

  .site-header__dropdown-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 180px;
  }

  .site-header__dropdown-group-label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-block: var(--space-1);
    padding-inline: var(--space-3);
  }
  /* REPORTS-19: تكبير النص 12px → 13px على mobile عشان القراءة بدون zoom. */
  @media (max-width: 1023px) {
    .site-header__dropdown-group-label {
      font-size: 0.8125rem;       /* 13px */
    }
  }

  .site-header__dropdown-link {
    display: flex;
    align-items: center;
    padding-inline: var(--space-3);
    padding-block: var(--space-2);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    min-height: 44px;
    line-height: 1.5;
    transition: color var(--duration-fast) var(--ease-out),
                background var(--duration-fast) var(--ease-out);
  }

  .site-header__dropdown-link:hover,
  .site-header__dropdown-link:focus-visible {
    color: var(--text-primary);
    background: var(--bg-surface);
  }

  .site-header__dropdown-link--active { color: var(--interactive-primary); }

  .site-header__dropdown-link:focus-visible {
    outline: 2px solid var(--interactive-primary);
    outline-offset: -2px;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .site-header__whatsapp {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    color: var(--status-success);
    background: var(--bg-elevated);
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  @media (min-width: 1024px) { .site-header__whatsapp { display: inline-flex; } }

  .site-header__whatsapp:hover { background: var(--bg-surface); color: var(--status-success); }
  .site-header__whatsapp:focus-visible { outline: 2px solid var(--bg-base); outline-offset: -4px; }

  .btn--sm { display: none; }
  @media (min-width: 768px) { .btn--sm { display: inline-flex; } }

  .site-header__burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    background: none;
    color: var(--text-primary);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .site-header__burger:hover { background: var(--bg-elevated); }
  .site-header__burger:focus-visible { outline: 2px solid var(--interactive-primary); outline-offset: 2px; }

  @media (min-width: 1024px) { .site-header__burger { display: none; } }

  .site-header__overlay {
    position: fixed;
    inset: 0;
    z-index: 99;
    pointer-events: none;
  }

  .site-header__overlay--active { pointer-events: auto; }

  @media (prefers-reduced-motion: reduce) {
    .site-header__dropdown-panel,
    .site-header__chevron { transition: none; }
  }

  /* User opted out of translucency — kill backdrop-filter + noise grain so the
     header reads as a solid bar. Background opacity goes to ~0.95 (essentially
     opaque) so text contrast is identical to the alt-fallback. */
  @media (prefers-reduced-transparency: reduce) {
    .site-header,
    .site-header__dropdown-panel {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: rgba(10, 14, 26, 0.95);
    }
    .site-header::after,
    .site-header__dropdown-panel::after { display: none; }
  }
</style>
