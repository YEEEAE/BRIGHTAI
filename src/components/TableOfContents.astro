---
/**
 * TableOfContents — Sticky sidebar TOC with scroll-spy + active state.
 *
 * Reads `headings` (h2/h3 list built by [slug].astro) and renders a nav
 * with deep-link anchors. Client-side script (loaded lazily) observes
 * heading intersection to highlight the active one.
 *
 * Content Preservation Rule:
 *   Heading texts come from the published Markdown (verbatim). We do not
 *   "correct" Saudi dialect to MSA — the rendered list preserves whatever
 *   the source uses.
 */
interface Heading {
  depth: 2 | 3;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  title?: string;
}

const { headings, title = 'في هذه الوثيقة' } = Astro.props;
---

{headings.length > 0 && (
  <nav class="docs-toc" aria-label="جدول المحتويات">
    <p class="docs-toc__title">{title}</p>
    <ol class="docs-toc__list">
      {headings.map((heading) => (
        <li
          class:list={[
            'docs-toc__item',
            heading.depth === 3 && 'docs-toc__item--nested',
          ]}
          data-toc-target={`${heading.slug}`}
        >
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>

  <script>
    // REPORT-12: Scroll-spy for the TOC. Reads every heading linked in the
    // .docs-toc__list, watches it via IntersectionObserver, toggles
    // .is-active on the matching <li> when the heading enters the viewport.
    //
    // - Uses IntersectionObserver (no JS animations, no scroll listeners).
    // - Cleans up on astro:before-swap to avoid duplicate observers across page loads.
    // - Honors prefers-reduced-motion (no smooth scroll on click).
    function initTocScrollSpy() {
      const toc = document.querySelector('.docs-toc');
      if (!toc || toc.hasAttribute('data-toc-initialized')) return;
      toc.setAttribute('data-toc-initialized', 'true');

      const items = Array.from(toc.querySelectorAll('.docs-toc__item'));
      const linksBySlug = new Map<string, HTMLElement>();
      items.forEach((item) => {
        const slug = (item as HTMLElement).dataset.tocTarget;
        if (slug) linksBySlug.set(slug, item as HTMLElement);
      });

      const observedHeadings = new Map<string, HTMLElement>();
      linksBySlug.forEach((_, slug) => {
        const heading = document.getElementById(slug);
        if (heading) observedHeadings.set(slug, heading);
      });

      if (observedHeadings.size === 0) return;

      const headingTargets = Array.from(observedHeadings.values());

      // Smooth-scroll on click — but only if motion is allowed.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      items.forEach((item) => {
        const anchor = item.querySelector('a');
        if (!anchor) return;
        anchor.addEventListener('click', (e) => {
          const slug = (item as HTMLElement).dataset.tocTarget;
          if (!slug) return;
          const target = observedHeadings.get(slug);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({
            behavior: reduceMotion ? 'auto' : 'smooth',
            block: 'start',
          });
          // Update URL hash without triggering an extra scroll.
          history.replaceState(null, '', `#${slug}`);
          // Set active class synchronously so the user sees instant feedback.
          items.forEach((i) => i.classList.remove('is-active'));
          item.classList.add('is-active');
        });
      });

      // IntersectionObserver: mark all headings currently intersecting as active
      // at intervals, then pick the topmost one — handles long headings that
      // span viewport height cleanly.
      const setActiveForInView = () => {
        const viewportTop = window.scrollY + 120; // 120px offset for sticky header
        let topSlug: string | null = null;
        let topY = -Infinity;

        headingTargets.forEach((heading) => {
          const slug = heading.id;
          const rect = heading.getBoundingClientRect();
          const absoluteTop = rect.top + window.scrollY;
          if (absoluteTop <= viewportTop && absoluteTop > topY) {
            topY = absoluteTop;
            topSlug = slug;
          }
        });

        items.forEach((item) => item.classList.remove('is-active'));
        if (topSlug) {
          const targetItem = linksBySlug.get(topSlug);
          if (targetItem) targetItem.classList.add('is-active');
        }
      };

      setActiveForInView();
      let raf = 0;
      window.addEventListener(
        'scroll',
        () => {
          if (raf) return;
          raf = window.requestAnimationFrame(() => {
            setActiveForInView();
            raf = 0;
          });
        },
        { passive: true }
      );
    }

    document.addEventListener('astro:page-load', initTocScrollSpy);
    document.addEventListener('astro:before-swap', () => {
      // Cleanup any lingering flags before page swap re-init.
      document.querySelectorAll('.docs-toc[data-toc-initialized]').forEach((el) => {
        el.removeAttribute('data-toc-initialized');
      });
    });
  </script>
)}
