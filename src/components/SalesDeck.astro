---
/**
 * SalesDeck.astro — Reusable slide deck body for the BrightAI sales deck.
 * Renders a printable sequence of slide cards. RTL/LTR handled by parent layout.
 */
interface Slide {
  kicker?: string;
  title: string;
  bullets?: string[];
  note?: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<section class="deck" aria-label="عروض الشرائح">
  <div class="max-w-4xl mx-auto px-5 lg:px-8" style="display:flex; flex-direction:column; gap: var(--space-6);">
    {
      slides.map((s, i) => (
        <article class="card card--feature card--lg deck-slide">
          <span class="deck-slide__num">{String(i + 1).padStart(2, '0')}</span>
          {s.kicker && <span class="assessment-tag">{s.kicker}</span>}
          <h2 class="deck-slide__title">{s.title}</h2>
          {s.bullets && (
            <ul class="deck-slide__bullets">
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
          {s.note && <p class="deck-slide__note">{s.note}</p>}
        </article>
      ))
    }
  </div>
</section>

<style>
  .deck-slide { position: relative; padding: var(--space-8); }
  .deck-slide__num {
    font-size: var(--text-5xl);
    font-weight: var(--font-extrabold);
    color: rgba(0, 212, 255, 0.18);
    position: absolute;
    top: var(--space-4);
    inset-inline-end: var(--space-6);
    line-height: 1;
  }
  .deck-slide__title { font-size: var(--text-2xl); margin-block-end: var(--space-4); }
  .deck-slide__bullets { margin: 0; padding-inline-start: var(--space-6); display: flex; flex-direction: column; gap: var(--space-2); }
  .deck-slide__bullets li { color: var(--text-secondary); line-height: 1.7; }
  .deck-slide__note { margin-block-start: var(--space-4); color: var(--text-muted); font-size: var(--text-sm); }
  .assessment-tag { font-size: var(--text-xs); padding: 2px 10px; border-radius: var(--radius-lg); background: rgba(0,212,255,0.08); border: 1px solid rgba(0,212,255,0.25); color: #9be5ff; display: inline-block; margin-block-end: var(--space-3); }
  @media print {
    .deck-slide { break-inside: avoid; page-break-inside: avoid; }
  }
</style>
