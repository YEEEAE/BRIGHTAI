---
/**
 * Footer — Site-wide footer with navigation columns, legal links,
 * WhatsApp, language switcher (ar/en), Saudi branding, and social links.
 *
 * Architecture:
 *   - All visual styles live in src/styles/components.css (section 12. FOOTER).
 *     This component owns the markup, props, and i18n string selection only.
 *   - 5-column desktop grid (2fr brand + 4×1fr nav), 2-col tablet, 1-col mobile.
 *   - Brand column carries logo + tagline + WhatsApp CTA + language pill.
 *   - Bottom bar splits copyright/legal (left) and social/Made-in-SA (right)
 *     on desktop, stacks centered on mobile.
 *
 * Constraints (BrightAI Footer Redesign v1):
 *   - Does NOT modify FOOTER_NAV (single source of truth lives in src/data/navigation.ts).
 *   - Does NOT remove WhatsApp, language switcher, or legal links.
 *   - Preserves logo, tagline, and copyright as published branding.
 *
 * Accessibility:
 *   - role="contentinfo" on <footer>.
 *   - Each nav column has an aria-label inherited from the section label.
 *   - All interactive elements have aria-label and visible touch target ≥ 44px.
 *   - focus-visible styling on every link, button, and icon-link.
 *   - prefers-reduced-motion respected by tokens (durations become 0 on reduce).
 */
import { FOOTER_NAV } from '../data/navigation';
import { SITE } from '../data/site';

interface Props {
  lang?: 'ar' | 'en';
  currentPath?: string;
  languageCounterpart?: string;
}

const { lang = 'ar', languageCounterpart } = Astro.props;
const isAr = lang === 'ar';
const year = new Date().getFullYear();

const footerSections = Object.values(FOOTER_NAV);

// Social links — driven by the owner-confirmed official profile list in SITE.
// Each entry uses an inline SVG glyph
// (no external icon library) and inherits color from .footer__social-link.
interface SocialLink {
  name: string;
  nameAr: string;
  href: string;
  icon: 'twitter' | 'linkedin';
}

const socialLinks: SocialLink[] = [
  { name: 'Twitter',  nameAr: 'تويتر',   href: SITE.social.twitter,  icon: 'twitter'  },
  { name: 'LinkedIn', nameAr: 'لينكدإن', href: SITE.social.linkedin, icon: 'linkedin' },
];
---

<footer class="footer" role="contentinfo">
  <div class="footer__topline" aria-hidden="true"></div>

  <div class="container">
    <div class="footer__grid">
      <!-- Brand column — spans 2 fr on desktop, full width on mobile -->
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label={isAr ? 'الصفحة الرئيسية لـ BrightAI' : 'BrightAI Home'}>
          {/*
            ECHO: The Star (minimal variant) replaces logo.png.
            Single SVG, scales perfectly, no extra requests.
          */}
          <img src="/assets/star/bright-star-minimal.svg" alt="" width="40" height="40" class="footer__logo-img" loading="lazy" decoding="async" />
          <span class="footer__logo-text">BrightAI</span>
        </a>

        <p class="footer__tagline">
          {isAr
            ? 'نظام حماية الذكاء الاصطناعي السعودي — حوكمة، امتثال، وأمان للمؤسسات.'
            : 'Saudi AI Safety OS — Governance, compliance, and security for enterprises.'}
        </p>

        <!-- WhatsApp CTA — outline button with green icon -->
        <a
          href={`${SITE.whatsapp.goUrl}?text=${encodeURIComponent(isAr ? SITE.whatsapp.message.ar : SITE.whatsapp.message.en)}`}
          class="footer__whatsapp"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={isAr ? 'تواصل معنا عبر واتساب' : 'Chat on WhatsApp'}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <use href="/icons.svg#mdi-whatsapp" />
          </svg>
          <span>{isAr ? 'تواصل عبر واتساب' : 'Chat on WhatsApp'}</span>
        </a>

        <!-- Language Switcher — pill toggle (only renders when counterpart exists) -->
        {languageCounterpart && (
          <a
            href={languageCounterpart}
            class="footer__lang"
            aria-label={isAr ? 'Switch to English' : 'التبديل إلى العربية'}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <use href="/icons.svg#lucide-globe" />
            </svg>
            <span>{isAr ? 'English' : 'العربية'}</span>
          </a>
        )}
      </div>

      <!-- Nav columns — 4 sections from FOOTER_NAV -->
      {footerSections.map((section) => (
        <div class="footer__col">
          {/* WCAG fix (REPORTS-18): h3 inside the footer landmark, not h4.
              The footer landmark is anonymous (not a sectioning root that
              auto-establishes heading level 3), so h4 was a heading-order
              skip. h3 is correct semantically AND satisfies the heading
              hierarchy (page h2 sections → footer h3 columns). */}
          <h3 class="footer__heading">{isAr ? section.labelAr : section.label}</h3>
          <nav aria-label={isAr ? section.labelAr : section.label}>
            <ul class="footer__links" role="list">
              {section.items.map((item) => (
                <li>
                  <a href={item.href} class="footer__link">
                    {isAr ? item.labelAr : item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      ))}
    </div>

    <!-- Bottom bar — copyright + legal info on one side, social + Made-in-SA on the other -->
    <div class="footer__bottom">
      <div class="footer__bottom-left">
        <p class="footer__copy">
          © {year} {SITE.name}. {isAr ? 'جميع الحقوق محفوظة.' : 'All rights reserved.'}
          {SITE.crNumber && (
            <span class="footer__cr">
              {' · '}{isAr ? `سجل تجاري: ${SITE.crNumber}` : `CR: ${SITE.crNumber}`}
            </span>
          )}
          {SITE.founder && SITE.founder.name && (
            <span class="footer__founder">
              {' · '}{isAr ? `المؤسس: ${SITE.founder.name}` : `Founder: ${SITE.founder.nameEn}`}
              {SITE.founder.linkedIn && (
                <>
                  {' '}
                  <a
                    href={SITE.founder.linkedIn}
                    class="footer__founder-link"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={isAr ? 'ملف المؤسس على لينكدإن' : 'Founder LinkedIn profile'}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                  </a>
                </>
              )}
            </span>
          )}
        </p>
      </div>

      <div class="footer__bottom-right">
        {/* WCAG fix (REPORTS-18): use semantic <ul>/<li> instead of
            role="list"/role="listitem" on <a>. The role="listitem" on
            an <a> was invalid per ARIA in HTML spec and triggered
            aria-allowed-role. */}
        <ul class="footer__social" aria-label={isAr ? 'حساباتنا على التواصل' : 'Our social accounts'}>
          {socialLinks.map((social) => (
            <li class="footer__social-item">
              <a
                href={social.href}
                class="footer__social-link"
                aria-label={isAr ? social.nameAr : social.name}
                target="_blank"
                rel="noopener noreferrer"
              >
                {social.icon === 'twitter' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <use href="/icons.svg#brand-x" />
                  </svg>
                )}
                {social.icon === 'linkedin' && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <use href="/icons.svg#brand-linkedin" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
        <span class="footer__made-in" aria-hidden="true">
          🇸🇦 {isAr ? 'صنع في السعودية' : 'Made in Saudi Arabia'}
        </span>
      </div>
    </div>
  </div>
</footer>
