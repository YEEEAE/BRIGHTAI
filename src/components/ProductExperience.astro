---
import SecureChatDemo from './SecureChatDemo.astro';
import RiskWorkspace from './RiskWorkspace.astro';
import HumanGateDemo from './HumanGateDemo.astro';
import FirewallWorkspace from './FirewallWorkspace.astro';
import LedgerDemo from './LedgerDemo.astro';
interface Props { kind: string }
const { kind } = Astro.props;
---
{kind === 'secure-chat' ? <SecureChatDemo /> : kind === 'risk-engine' ? <RiskWorkspace demo /> : kind === 'human-gate' ? <HumanGateDemo /> : kind === 'firewall' ? <FirewallWorkspace /> : kind === 'ledger' ? <LedgerDemo /> : null}
