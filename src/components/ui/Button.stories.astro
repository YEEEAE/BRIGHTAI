---
/**
 * Button.stories.astro — Storybook stories for Button.
 *
 * Canonical button component. Polymorphic (a/button).
 * Variants: primary | secondary | ghost | danger | whatsapp
 * Sizes: sm | md | lg
 */
import type { Meta, StoryObj } from '@storybook/astro-vite';
import Button from './Button.astro';

const meta = {
  title: 'UI/Button',
  component: Button,
  tags: ['autodocs'],
  argTypes: {
    variant: {
      control: 'select',
      options: ['primary', 'secondary', 'ghost', 'danger', 'whatsapp'],
    },
    size: { control: 'inline-radio', options: ['sm', 'md', 'lg'] },
    href: { control: 'text' },
    type: { control: 'inline-radio', options: ['button', 'submit', 'reset'] },
    fullWidth: { control: 'boolean' },
    disabled: { control: 'boolean' },
    iconLeft: { control: 'text' },
    iconRight: { control: 'text' },
    external: { control: 'boolean' },
  },
  args: {
    variant: 'primary',
    size: 'md',
    fullWidth: false,
    disabled: false,
    external: false,
  },
} satisfies Meta<typeof Button>;

export default meta;
type Story = StoryObj<typeof Button>;

// ─── Variants ─────────────────────────────────────────────────
export const Primary: Story = {
  args: { variant: 'primary' },
};

export const Secondary: Story = {
  args: { variant: 'secondary' },
};

export const Ghost: Story = {
  args: { variant: 'ghost' },
};

export const Danger: Story = {
  args: { variant: 'danger' },
};

export const Whatsapp: Story = {
  args: { variant: 'whatsapp' },
};

// ─── Sizes ────────────────────────────────────────────────────
export const SizeSm: Story = { args: { size: 'sm' } };
export const SizeMd: Story = { args: { size: 'md' } };
export const SizeLg: Story = { args: { size: 'lg' } };

// ─── States ───────────────────────────────────────────────────
export const Disabled: Story = {
  args: { variant: 'primary', disabled: true },
};

export const FullWidth: Story = {
  args: { fullWidth: true },
};

// ─── As link ──────────────────────────────────────────────────
export const AsLink: Story = {
  args: { variant: 'primary', href: '/contact/' },
};

export const External: Story = {
  args: { variant: 'secondary', href: 'https://wa.me/966538229013', external: true },
};

// ─── With icons ───────────────────────────────────────────────
export const WithLeftIcon: Story = {
  args: { variant: 'primary', iconLeft: 'arrow-right' },
};

export const WithBothIcons: Story = {
  args: { variant: 'secondary', iconLeft: 'check', iconRight: 'arrow-left' },
};