---
/**
 * Button.astro — Canonical button component for BrightAI.
 *
 * Variants: primary | secondary | ghost | danger
 * Sizes:    sm | md | lg
 *
 * المكوّن الموحّد للأزرار عبر الموقع كله.
 * - يدعم `<a>` و `<button>` (الـ polymorphic)
 * - touch target ≥ 44px (mobile-first)
 * - focus-visible افتراضياً عبر :focus-visible في global.css
 * - prefers-reduced-motion محترم (animation/transition قصيرة فقط)
 *
 * USAGE:
 *   <Button href="/contact/" variant="primary">تواصل معنا</Button>
 *   <Button type="submit" variant="secondary">أرسل</Button>
 *   <Button variant="ghost" onclick="...">إلغاء</Button>
 */
import '../../styles/global.css';

type Variant = 'primary' | 'secondary' | 'ghost' | 'danger' | 'whatsapp';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  /** Render as <a> when href is provided, otherwise <button> */
  href?: string;
  /** Button type (submit/reset/button) — only used when no href */
  type?: 'button' | 'submit' | 'reset';
  variant?: Variant;
  size?: Size;
  /** Full width on all viewports */
  fullWidth?: boolean;
  /** Optional icon name (mdi-*) rendered before the label */
  iconLeft?: string;
  /** Optional icon name (mdi-*) rendered after the label */
  iconRight?: string;
  /** When href is external */
  external?: boolean;
  /** Disable (for <button> only) */
  disabled?: boolean;
  /** Pass-through class for context-specific overrides */
  class?: string;
  /** aria-label override (defaults to slot text — but screen readers need explicit) */
  'aria-label'?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  fullWidth = false,
  iconLeft,
  iconRight,
  external = false,
  disabled = false,
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = [
  'btn',
  `btn--${variant}`,
  `btn--${size}`,
  fullWidth ? 'btn--full' : '',
  className,
].filter(Boolean).join(' ');

const isExternal = external || (href && /^https?:\/\//.test(href));
const ariaLabel = rest['aria-label'];
---

<Tag
  class={classes}
  href={href}
  type={!href ? type : undefined}
  disabled={!href && disabled}
  aria-label={ariaLabel}
  {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  {iconLeft && (
    <svg class="btn__icon btn__icon--left" aria-hidden="true" width="1em" height="1em">
      <use href={`/icons.svg#mdi-${iconLeft}`}></use>
    </svg>
  )}
  <span class="btn__label"><slot /></span>
  {iconRight && (
    <svg class="btn__icon btn__icon--right" aria-hidden="true" width="1em" height="1em">
      <use href={`/icons.svg#mdi-${iconRight}`}></use>
    </svg>
  )}
</Tag>

<style>
  /* ───────────────────────────────────────────
     BASE — كل variant ترث من هنا
     ─────────────────────────────────────────── */
  .btn {
    --btn-bg: var(--color-primary);
    --btn-color: var(--white);
    --btn-border: transparent;
    --btn-hover-bg: var(--color-primary-hover);
    --btn-active-bg: var(--color-primary-active);
    --btn-shadow: var(--shadow-cta-glow);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-arabic);
    font-weight: var(--font-semibold);
    font-size: var(--text-base);
    line-height: 1.2;
    text-decoration: none;
    text-align: center;
    border: 1px solid var(--btn-border);
    border-radius: var(--radius-lg);
    background: var(--btn-bg);
    color: var(--btn-color);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
    box-shadow: var(--btn-shadow);
    /* touch target minimum — size lg 44px+ */
    min-height: var(--touch-min);
  }

  .btn:hover:not(:disabled) {
    background: var(--btn-hover-bg);
    transform: translateY(-1px);
    box-shadow: var(--shadow-cta-glow);
  }

  .btn:active:not(:disabled) {
    background: var(--btn-active-bg);
    transform: translateY(0);
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  /* ───────────────────────────────────────────
     SIZES
     ─────────────────────────────────────────── */
  .btn--sm {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    min-height: 2.25rem;        /* 36px — small action */
    border-radius: var(--radius-md);
  }

  .btn--md {
    /* default sizes — already in base */
  }

  .btn--lg {
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-lg);
    min-height: 3.25rem;        /* 52px — hero CTA */
    border-radius: var(--radius-xl);
  }

  .btn--full {
    width: 100%;
  }

  /* ───────────────────────────────────────────
     VARIANTS
     ─────────────────────────────────────────── */

  /* PRIMARY — Deep Teal filled */
  .btn--primary {
    --btn-bg: var(--color-primary);
    --btn-color: var(--white);
    --btn-hover-bg: var(--color-primary-hover);
    --btn-active-bg: var(--color-primary-active);
  }

  /* SECONDARY — outlined */
  .btn--secondary {
    --btn-bg: transparent;
    --btn-color: var(--color-primary);
    --btn-border: var(--color-primary);
    --btn-hover-bg: var(--color-primary-soft);
    --btn-active-bg: var(--color-primary-soft);
    --btn-shadow: none;
  }

  /* GHOST — minimal, text-only */
  .btn--ghost {
    --btn-bg: transparent;
    --btn-color: var(--color-text);
    --btn-border: transparent;
    --btn-hover-bg: var(--color-border-subtle);
    --btn-active-bg: var(--color-border-subtle);
    --btn-shadow: none;
  }

  /* DANGER — destructive actions */
  .btn--danger {
    --btn-bg: var(--color-danger);
    --btn-color: var(--white);
    --btn-hover-bg: var(--status-danger);
    --btn-active-bg: var(--status-danger);
    --btn-shadow: 0 0 28px -6px rgba(239, 68, 68, 0.45);
  }

  /* WHATSAPP — success/contact green */
  .btn--whatsapp {
    --btn-bg: var(--color-success);
    --btn-color: var(--white);
    --btn-hover-bg: var(--accent-600);
    --btn-active-bg: var(--accent-700);
    --btn-shadow: 0 0 28px -6px rgba(34, 197, 94, 0.45);
  }

  /* ───────────────────────────────────────────
     ICONS
     ─────────────────────────────────────────── */
  .btn__icon {
    flex-shrink: 0;
    width: 1.2em;
    height: 1.2em;
    display: inline-block;
    vertical-align: -0.125em;
    fill: currentColor;
  }

  .btn--sm .btn__icon { width: 1em; height: 1em; }
  .btn--lg .btn__icon { width: 1.4em; height: 1.4em; }

  /* ───────────────────────────────────────────
     RTL — arrows behave correctly
     ─────────────────────────────────────────── */
  [dir="rtl"] .btn__icon--right { transform: scaleX(-1); }
  [dir="rtl"] .btn__icon--left  { transform: scaleX(-1); }

  /* ───────────────────────────────────────────
     MOBILE — full-width on tight viewports
     عبر class prop لو رغبت، أو [data-mobile-full]
     ─────────────────────────────────────────── */
  @media (max-width: 479px) {
    .btn:not(.btn--full) {
      /* لا نجبر full-width افتراضياً — نحترم تصميم الصفحات */
    }
  }
</style>
