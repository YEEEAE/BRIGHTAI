---
/**
 * Card.stories.astro — Storybook stories for Card.
 *
 * Canonical card component. Polymorphic (a/div).
 * Variants: feature | pricing | sector | solution | trust | stat | plain
 */
import type { Meta, StoryObj } from '@storybook/react';
import Card from './Card.astro';

const meta = {
  title: 'UI/Card',
  component: Card,
  tags: ['autodocs'],
  argTypes: {
    variant: {
      control: 'select',
      options: ['feature', 'pricing', 'sector', 'solution', 'trust', 'stat', 'plain'],
    },
    href: { control: 'text' },
    icon: { control: 'text', description: 'mdi-* icon name' },
    eyebrow: { control: 'text' },
    interactive: { control: 'boolean' },
  },
  args: {
    variant: 'feature',
    interactive: false,
  },
} satisfies Meta<typeof Card>;

export default meta;
type Story = StoryObj<typeof Card>;

// ─── Variants ─────────────────────────────────────────────────
export const Feature: Story = {
  args: { variant: 'feature', icon: 'shield', eyebrow: 'حوكمة' },
};

export const Pricing: Story = {
  args: { variant: 'pricing', icon: 'cash', eyebrow: 'الباقة' },
};

export const Sector: Story = {
  args: { variant: 'sector', icon: 'bank', eyebrow: 'القطاع' },
};

export const Solution: Story = {
  args: { variant: 'solution', icon: 'lightbulb', eyebrow: 'الحل' },
};

export const Trust: Story = {
  args: { variant: 'trust', icon: 'certificate', eyebrow: 'الامتثال' },
};

export const Stat: Story = {
  args: { variant: 'stat', icon: 'chart-line', eyebrow: 'الإحصائية' },
};

export const Plain: Story = {
  args: { variant: 'plain' },
};

// ─── States ───────────────────────────────────────────────────
export const AsLink: Story = {
  args: { variant: 'feature', icon: 'shield', href: '/solutions/ai-firewall/' },
};

export const Interactive: Story = {
  args: { variant: 'feature', interactive: true, icon: 'arrow-right' },
};

export const NoIcon: Story = {
  args: { variant: 'feature', icon: '' },
};