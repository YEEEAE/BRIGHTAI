---
/**
 * SectionHeading.astro — Canonical section heading for BrightAI.
 *
 * Variants: center (default) | start (left/right in RTL)
 *
 * USAGE:
 *   <SectionHeading
 *     eyebrow="حوكمة AI"
 *     title="نظام تشغيل أمان سعودي للذكاء الاصطناعي"
 *     subtitle="كل طلب ذكاء اصطناعي يمر عبر طبقة وسيطة موثّقة."
 *     align="center"
 *   />
 *
 * يحترم نفس canonical CSS في components.css (.section__header، section__title، section__subtitle).
 * يُضاف فوقه:
 *   - dir-aware alignment
 *   - lazy-render (no script needed — visual only)
 *   - reduced spacing على mobile
 */
import '../../styles/global.css';

interface Props {
  /** Small uppercase tag above title (e.g. "نظرة عامة") */
  eyebrow?: string;
  /** Main heading text — also becomes the h2 */
  title: string;
  /** Optional paragraph below */
  subtitle?: string;
  /** Visual alignment of the heading block */
  align?: 'center' | 'start';
  /** h-level override — defaults to h2 (semantic; do not lower) */
  as?: 'h1' | 'h2' | 'h3';
  /** Pass-through class */
  class?: string;
  /** Stable heading id for the owning section's aria-labelledby contract. */
  id?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  align = 'center',
  as: HeadingTag = 'h2',
  class: className = '',
  id,
} = Astro.props;

const classes = [
  'section__header',
  align === 'start' ? 'section__header--start' : '',
  className,
].filter(Boolean).join(' ');
---

<header class={classes}>
  {eyebrow && <span class="section__eyebrow">{eyebrow}</span>}
  <HeadingTag id={id} class="section__title">{title}</HeadingTag>
  {subtitle && <p class="section__subtitle">{subtitle}</p>}
</header>

<style>
  /* ───────────────────────────────────────────
     BASE — يطابق canonical في components.css
     ─────────────────────────────────────────── */
  .section__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .section__header--start {
    text-align: start;
    align-items: flex-start;
  }

  [dir="rtl"] .section__header--start {
    text-align: start;
  }

  /* ───────────────────────────────────────────
     EYEBROW — chip-style category label
     ─────────────────────────────────────────── */
  .section__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--brand-300);     /* WCAG AA+ on tinted bg */
    background: var(--color-primary-soft);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid rgba(42, 138, 126, 0.18);
  }

  /* Arabic: skip uppercase (no case distinction) */
  .section__eyebrow:lang(ar) {
    text-transform: none;
    letter-spacing: 0;
  }

  /* ───────────────────────────────────────────
     TITLE — h2 with display hierarchy
     ─────────────────────────────────────────── */
  .section__title {
    font-size: var(--text-3xl);
    font-weight: var(--font-extrabold);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .section__title {
      font-size: var(--text-4xl);
    }
  }

  /* ───────────────────────────────────────────
     SUBTITLE — large secondary paragraph
     ─────────────────────────────────────────── */
  .section__subtitle {
    font-size: var(--text-lg);
    font-weight: var(--font-normal);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 45rem;
    text-wrap: pretty;
  }

  .section__header--start .section__subtitle {
    max-width: 100%;
  }

  /* ───────────────────────────────────────────
     MOBILE — compact spacing
     ─────────────────────────────────────────── */
  @media (max-width: 479px) {
    .section__header {
      margin-bottom: var(--space-8);
      gap: var(--space-2);
    }

    .section__title {
      font-size: var(--text-2xl);
    }

    .section__subtitle {
      font-size: var(--text-base);
    }
  }
</style>
