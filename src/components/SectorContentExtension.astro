---
import ContentExtension from './ContentExtension.astro';
interface Props { kind: string }
const { kind } = Astro.props;
const cases: Record<string, {title: string; scenario: string; steps: string[]; evidence: string; guide: string; link: string; product: string; productName: string}> = {
  government: {title: 'سيناريو تعليمي: تلخيص طلب مستفيد', scenario: 'يريد فريق خدمة عامة تلخيص طلبات المستفيدين. قد يجمع الطلب بيانات تعريفية وتفاصيل تؤثر في تقديم الخدمة؛ لذلك يجب فصل مهمة التلخيص عن سلطة اتخاذ القرار.', steps: ['استخدم نسخة اصطناعية من الطلب لفهم المهمة قبل إدخال معلومات مستفيد حقيقية.', 'حدّد من يراجع الملخص، وما المعلومات التي لا يجوز أن تغادر القناة المعتمدة.', 'تحقق من أن المخرج يساعد الموظف ولا يصدر قراراً آلياً خارج التفويض.'], evidence: 'احتفظ بوصف الغرض، وقرار اعتماد الاستخدام، وحدود البيانات، ومسؤول المراجعة؛ مع تحديد الأنظمة والسياسات المنطبقة على الجهة فعلاً.', guide: 'ابدأ بدليل الحوكمة السعودي', link: 'ai-governance-saudi', product: 'human-gate', productName: 'AIGAS Human Gate'},
  finance: {title: 'سيناريو تعليمي: مسودة شرح مالي', scenario: 'يريد موظف إعداد مسودة شرح لخدمة مالية. تختلف حساسية صياغة نص عام عن تحليل ملف عميل أو إصدار توصية تؤثر في قرار مالي؛ لا تنقل صلاحيات المهمة الأولى إلى الثانية.', steps: ['ابدأ بمحتوى عام معتمد دون بيانات عميل أو حسابات أو معاملات.', 'حدّد مراجعة الدقة وحدود اعتماد النص والجهة التي تجيز إرساله.', 'إذا توسع الغرض إلى تحليل فردي، أعد تقييم البيانات والمخاطر والمتطلبات القطاعية قبل التنفيذ.'], evidence: 'وثّق مصدر المعلومات، والمراجع المخول، ونسخة النص المعتمدة. لا يُستنتج من وجود ضابط تقني أن المتطلبات التنظيمية قد استوفيت.', guide: 'استخدم ورقة عمل تقييم المخاطر', link: 'ai-risk-assessment', product: 'risk-engine', productName: 'AIGAS Risk Engine'},
  healthcare: {title: 'سيناريو تعليمي: صياغة تعليمات إدارية', scenario: 'يمكن التمييز بين إعداد نص عام عن إجراءات المواعيد وبين تلخيص سجل مريض أو اقتراح قرار سريري. أي انتقال إلى البيانات الصحية أو التأثير في العلاج يستدعي مراجعة مختلفة.', steps: ['ابدأ بتعليمات إدارية عامة دون أسماء أو معرفات أو تاريخ طبي.', 'راجع اللغة والدقة مع مالك الإجراء قبل مشاركة التعليمات.', 'أوقف توسع المهمة إلى تفسير طبي أو قرار سريري دون مسار مهني وتقني ونظامي معتمد.'], evidence: 'حدّد حدود المهمة والمحتوى المسموح وصاحب الاعتماد. البيانات المنقحة قد تظل قابلة لإعادة التعرف بحسب السياق، فلا تعتبر إزالة الاسم وحدها كافية.', guide: 'راجع قائمة حماية البيانات', link: 'protect-company-data-chatgpt', product: 'firewall', productName: 'AIGAS Firewall'},
  enterprise: {title: 'سيناريو تعليمي: مسودة رد لعميل', scenario: 'يريد فريق المبيعات صياغة رد باستخدام مساعد AI. قد تتضمن الرسالة عقداً غير معلن أو أسعاراً خاصة أو بيانات تواصل؛ ما يصلح للنشر العام يختلف عما يجوز مشاركته مع أداة خارجية.', steps: ['اكتب وصفاً عاماً للاحتياج، وحدّد المعلومات الداخلية قبل نسخ الرسالة.', 'استخدم أداة وحساباً معتمدين؛ اطلب مراجعة عند غموض العقد أو صلاحية المشاركة.', 'راجع الرد النهائي حتى لا يتضمن سعراً أو وعداً أو التزاماً لم يُعتمد.'], evidence: 'اكتب قاعدة يفهمها الموظف: ما المسموح؟ متى يطلب الموافقة؟ ولمن يبلغ عند مشاركة غير مقصودة؟ ثم حدد مالكاً لتحديث السياسة مع تغير الأدوات.', guide: 'صِغ سياسة استخدام للموظفين', link: 'ai-use-policy-employees', product: 'secure-chat', productName: 'AIGAS Secure Chat'},
};
const entry = cases[kind];
---
<ContentExtension>
  <section><p class="extension-label">تطبيق على سياق القطاع · مثال افتراضي</p><h2>{entry.title}</h2><p>{entry.scenario}</p><ol class="extension-path">{entry.steps.map(step => <li>{step}</li>)}</ol></section>
  <section><h2>ما الذي يُراجع قبل الانتقال للتشغيل؟</h2><p>{entry.evidence}</p><p>المثال ليس حالة عميل أو إجراءً معتمداً. لا تنشئ بيئة النشر وحدها امتثالاً؛ تُراجع العقود والصلاحيات والمعالجة والتكاملات ضمن نطاق الجهة.</p><p><a href={`/knowledge/${entry.link}/`}>{entry.guide}</a>، ثم تعرّف على النطاق المخطط لـ<a href={`/products/${entry.product}/`}><bdi>{entry.productName}</bdi></a>. المنتج غير متحقق تشغيلياً؛ الرابط يشرح المتطلبات والحدود.</p></section>
</ContentExtension>
