---
/**
 * Product glyphs — one fixed outline set for the five AIGAS products and the
 * shared Kernel. Geometry is drawn on a 24px grid with round caps/joins so the
 * same drawing stays legible from 16px (sidebars) to 40px (product mastheads).
 * The official shield logo is NOT here: it stays in BrandLogo.astro / brand.ts.
 */
interface Props {
  kind: string;
  size?: 16 | 20 | 24 | 32 | 40;
  /** When provided the icon is exposed to assistive tech; otherwise decorative. */
  label?: string;
}
const { kind, size = 40, label } = Astro.props;

const glyphs: Record<string, string[]> = {
  /* Protection of a request, not the brand shield: guard outline + verdict tick. */
  firewall: [
    'M12 3.3 5.4 5.9v5.05c0 4.32 2.8 7.6 6.6 8.95 3.8-1.35 6.6-4.63 6.6-8.95V5.9Z',
    'm9.15 11.85 2.1 2.15 3.7-4.1',
  ],
  /* Evidence and record: document with a folded corner and ledger lines. */
  ledger: [
    'M6.4 3.3h7.25l3.95 3.95V20.7H6.4Z',
    'M13.65 3.3v3.95h3.95',
    'M9.3 11.5h5.4M9.3 14.55h5.4M9.3 17.6h3.05',
  ],
  /* Human approval, not automation: reviewer plus a cleared gate. */
  'human-gate': [
    'M9.9 11.45a3.4 3.4 0 1 0 0-6.8 3.4 3.4 0 0 0 0 6.8Z',
    'M3.85 19.65c.5-3.25 2.8-5.2 6.05-5.2 1.3 0 2.45.35 3.4.95',
    'm14.55 17.25 2.05 2.05 3.85-4.3',
  ],
  /* Risk assessment: measured axes with a rising exposure line. */
  'risk-engine': [
    'M4.1 3.9v16.2h16.2',
    'm7.5 15.5 3.55-4.35 2.95 2.7 4.15-5.35',
    'M18.1 6.5h2.15v2.15',
  ],
  /* Confidential conversation: message frame with a lock in the payload area. */
  'secure-chat': [
    'M4.2 3.9h15.6v10.85h-6.95L8.7 18.2v-3.45H4.2Z',
    'M13.4 11.2V9.75a1.6 1.6 0 0 1 3.2 0V11.2',
    'M12.85 11.2h4.3v3.1h-4.3Z',
  ],
  /* Shared layer under all products. */
  kernel: [
    'M12 3.4 4.4 7.45 12 11.5l7.6-4.05Z',
    'm4.4 12.05 7.6 4.05 7.6-4.05',
    'm4.4 16.55 7.6 4.05 7.6-4.05',
  ],
};

/* Thicker strokes at small sizes keep the outline from dissolving. */
const strokeWidths: Record<number, number> = { 16: 1.75, 20: 1.7, 24: 1.6, 32: 1.5, 40: 1.5 };
const stroke = strokeWidths[size] ?? 1.6;
const shapes = glyphs[kind] ?? glyphs.kernel;
---
<svg
  class="product-icon"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  style={`--icon-size:${size}px`}
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {label && <title>{label}</title>}
  {shapes.map((d) => <path d={d} />)}
</svg>
