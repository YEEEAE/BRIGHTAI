---
/**
 * Knowledge topic glyphs — the same 24px outline grid, round caps and optical
 * stroke as ProductIcon. The shield here means a safety *topic*; the official
 * brand shield is never used as a small section logo.
 */
interface Props {
  kind?: string;
  size?: 16 | 20 | 24 | 32;
  /** When provided the icon is exposed to assistive tech; otherwise decorative. */
  label?: string;
}
const { kind = 'guide', size = 24, label } = Astro.props;
const paths: Record<string, string> = {
  search: 'm21 21-5-5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0',
  guide: 'M12 5c-3-2-7-2-10 0v15c3-2 7-2 10 0 3-2 7-2 10 0V5c-3-2-7-2-10 0Zm0 0v15',
  technical: 'm8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16',
  policy: 'M5 3h14v18H5V3Zm4 5h6m-6 4h6m-6 4h3',
  safety: 'M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6l-9-4Zm-4 10 3 3 5-6',
};
const strokeWidths: Record<number, number> = { 16: 1.75, 20: 1.7, 24: 1.6, 32: 1.6 };
const stroke = strokeWidths[size] ?? 1.6;
---
<svg
  class="knowledge-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {label && <title>{label}</title>}
  <path d={paths[kind] ?? paths.guide} vector-effect="non-scaling-stroke"/>
</svg>
