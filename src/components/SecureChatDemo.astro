---
import {chatScenarios} from '../shared/secure-chat-demo.mjs';
---
<section class="sc-demo ph-no-capture" data-chat-demo data-ph-no-capture aria-label="محادثة محاكاة محلية">
 <header><div><p>BRIGHT AI / SECURE CHAT</p><h2>مساحة هادئة لتجربة طلبك</h2></div><span>محاكاة محلية فقط</span></header>
 <p>ردود محددة مسبقًا، وليست من Groq أو نموذج متصل. لا تدخل بيانات حقيقية؛ قواعد المثال محدودة ولا تثبت حماية إنتاجية.</p>
 <div class="sc-tools"><button type="button" data-new>محادثة جديدة</button><button type="button" data-reset>إعادة الضبط</button><span>Live send · غير جاهز / NOT VERIFIED</span></div>
 <div class="sc-scenarios" aria-label="سيناريوهات المحاكاة">{chatScenarios.map((s,i)=><button type="button" data-scenario={i}>{s.label}</button>)}</div>
 <ol data-thread aria-label="رسائل المحاكاة"><li>اختر مثالًا أو اكتب طلبًا افتراضيًا؛ الرد التالي محاكاة محددة.</li></ol>
 <p data-loading hidden role="status">جارٍ إعداد رد المحاكاة محليًا…</p>
 <form novalidate><label for="sc-demo-input">رسالتك الافتراضية</label><textarea id="sc-demo-input" rows="3" maxlength="2000" autocomplete="off" data-private placeholder="اكتب طلبًا عامًا أو اختر مثالًا أعلاه"></textarea><div class="sc-tools"><button type="submit">أرسل للمحاكاة</button><span>لا إرسال لمزود · لا حفظ للمحتوى أو المسودة</span></div></form>
 <p role="status" aria-live="polite" data-feedback></p>
 <details><summary>حدود التجربة التشغيلية · 48 ساعة</summary><p>مسار منفصل يتطلب Auth ومؤسسة وصلاحية خادمية، اعتماد المزود والمنطقة والخروج، قرار ALLOW وحصة وسقف تكلفة. لا تعني تهيئة الموصل READY؛ يلزم رد نموذج فعلي بإذن. المختبر هنا يستمر دون مزود.</p></details>
 <noscript>تحتاج المحادثة المحلية JavaScript. لا يوجد اتصال بنموذج.</noscript>
</section>
<script>
import {chatScenarios,simulateChat} from '../shared/secure-chat-demo.mjs';
document.querySelectorAll<HTMLElement>('[data-chat-demo]').forEach(root=>{
 const input=root.querySelector('textarea')!,form=root.querySelector('form')!,thread=root.querySelector<HTMLOListElement>('[data-thread]')!,loading=root.querySelector<HTMLElement>('[data-loading]')!,feedback=root.querySelector<HTMLElement>('[data-feedback]')!,send=form.querySelector('button')!;
 let generation=0,timer:ReturnType<typeof setTimeout>|undefined;
 const say=(s:string)=>feedback.textContent=s;
 function clear(){generation++;clearTimeout(timer);thread.replaceChildren();input.value='';loading.hidden=true;send.disabled=false;form.removeAttribute('aria-busy');say('محادثة محلية جديدة؛ أُزيل المحتوى من العرض.');input.focus();}
 root.querySelector<HTMLElement>('[data-new]')!.onclick=clear;
 root.querySelector<HTMLElement>('[data-reset]')!.onclick=clear;
 const shellReset=root.closest('[data-lab-shell]')?.querySelector<HTMLButtonElement>('[data-lab-reset]');if(shellReset){shellReset.hidden=false;shellReset.onclick=clear;}
 root.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach(b=>b.onclick=()=>{input.value=chatScenarios[Number(b.dataset.scenario)].text;input.focus();say('حُمّل المثال؛ اضغط أرسل للمحاكاة.');});
 form.onsubmit=e=>{e.preventDefault();if(send.disabled)return;let result;try{result=simulateChat(input.value);}catch{say('اكتب نصًا افتراضيًا بين 1 و2000 حرف، أو اختر مثالًا.');input.focus();return;}
 const epoch=++generation;loading.hidden=false;send.disabled=true;form.setAttribute('aria-busy','true');say('');
 timer=setTimeout(()=>{if(epoch!==generation)return;
 const item=document.createElement('li');item.className='sc-turn';
 const add=(tag:string,text:string)=>{const el=document.createElement(tag);el.textContent=text;item.append(el);return el;};
 add('small','أنت · قبل التنقيح (محلي فقط)');add('p',result.before);
 add('small','BRIGHT AI · رد محاكاة');const reply=add('p',result.reply);reply.className='sc-reply';
 add('p',`Firewall: ${result.decision} · Kernel: ${result.kernel} · قرارات محاكاة`);
 add('p',result.reason);add('small','بعد التنقيح / حدود الخروج المحاكى');add('pre',result.after);
 const copy=add('button','نسخ رد المحاكاة') as HTMLButtonElement;copy.type='button';copy.onclick=async()=>{try{await navigator.clipboard.writeText('رد محاكاة\n'+result.reply);say('نُسخ رد المحاكاة.');}catch{say('تعذر النسخ؛ حدد نص الرد وانسخه يدويًا.');}};
 thread.append(item);while(thread.children.length>12)thread.firstElementChild?.remove();input.value='';loading.hidden=true;send.disabled=false;form.removeAttribute('aria-busy');say('اكتمل رد المحاكاة؛ لم يُرسل المحتوى إلى خادم أو مزود.');
 },400);
 };
});
</script>
<style>
.sc-demo{padding:clamp(18px,4vw,36px);overflow-wrap:anywhere;color:var(--color-text,#f2f4ff)}header,.sc-tools,.sc-scenarios{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}header p,small,.sc-tools span{font-size:13px;color:var(--color-text-muted,#c7c9df)}h2{font-size:clamp(22px,3vw,30px);margin:8px 0}p{line-height:1.9}.sc-scenarios{justify-content:start;margin-block:24px}button,textarea{font:inherit;color:inherit;background:var(--surface-raised,#202b43);border:1px solid var(--border-strong,#69738a);border-radius:12px;padding:12px;min-height:44px;box-sizing:border-box}button{cursor:pointer}button:disabled{opacity:.6;cursor:wait}textarea{display:block;width:100%;resize:vertical;margin-block:12px}button:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid var(--color-focus,#cbbaff);outline-offset:3px}ol{list-style:none;padding:0;min-height:160px}li{padding:22px;margin-block:18px;border:1px solid var(--border-strong,#69738a);border-radius:16px;background:var(--surface-raised,#202b43)}.sc-reply{border-inline-start:3px solid var(--color-focus,#cbbaff);padding-inline-start:18px;font-size:18px}pre{white-space:pre-wrap;font:inherit;line-height:1.8}form,details{border-block-start:1px solid var(--border-strong,#69738a);padding-block-start:20px}summary{cursor:pointer;min-height:44px}[data-loading]{padding:16px;border-inline-start:3px solid var(--color-focus,#cbbaff)}[hidden]{display:none}
</style>
