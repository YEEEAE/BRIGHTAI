---
/**
 * Breadcrumbs — Accessible breadcrumb navigation (visual only).
 *
 * BAI-LINK-03 (2026-07-29):
 *   The Schema.org BreadcrumbList JSON-LD node is emitted by the foundation
 *   Schema.astro (via the `breadcrumbs` prop on BaseLayout). Emitting a second
 *   `<script type="application/ld+json">` here would duplicate the node and
 *   trigger `_check-duplicate-schema-ids.mjs` warnings. This component is now
 *   visual-only — the structured data lives in ONE place (FoundationSchema).
 *
 * Accessibility:
 *   - `<nav aria-label="مسار التنقل">` landmark for screen readers.
 *   - Last item carries `aria-current="page"` (WCAG 2.4.8).
 *   - Separator is `aria-hidden="true"` so it isn't announced.
 *
 * Visual:
 *   - Uses `.breadcrumbs` / `.breadcrumbs__link` / `.breadcrumbs__sep` /
 *     `.breadcrumbs__current` styles in src/styles/pages.css (existing tokens).
 *   - Inline rendering inside `<main>` (caller positions it where needed).
 */
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="breadcrumbs" aria-label="مسار التنقل">
  {crumbs.map((crumb, i) => (
    <>
      {i > 0 && <span class="breadcrumbs__sep" aria-hidden="true">/</span>}
      {crumb.href ? (
        <a href={crumb.href} class="breadcrumbs__link">{crumb.label}</a>
      ) : (
        <span class="breadcrumbs__current" aria-current="page">{crumb.label}</span>
      )}
    </>
  ))}
</nav>
