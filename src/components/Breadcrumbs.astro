---
/**
 * Breadcrumbs — Accessible breadcrumb navigation with Schema.org markup.
 */
import { SITE } from '../data/site';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;

const schemaItems = crumbs.map((crumb, i) => {
  const isLast = i === crumbs.length - 1;
  let href = crumb.href;
  if (!href && isLast) {
    href = Astro.url.pathname;
  }

  let itemUrl = '';
  if (href) {
    let cleanPath = href;
    if (!cleanPath.startsWith('/')) {
      cleanPath = '/' + cleanPath;
    }
    if (!cleanPath.endsWith('/')) {
      cleanPath = cleanPath + '/';
    }
    itemUrl = `${SITE.url}${cleanPath}`;
  }

  return {
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    ...(itemUrl ? { item: itemUrl } : {}),
  };
});

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: schemaItems,
};
---

<nav class="breadcrumbs" aria-label="مسار التنقل">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {crumbs.map((crumb, i) => (
    <>
      {i > 0 && <span class="breadcrumbs__sep" aria-hidden="true">/</span>}
      {crumb.href ? (
        <a href={crumb.href} class="breadcrumbs__link">{crumb.label}</a>
      ) : (
        <span class="breadcrumbs__current" aria-current="page">{crumb.label}</span>
      )}
    </>
  ))}
</nav>