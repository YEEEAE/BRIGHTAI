---
/**
 * LeadForm.astro — Reusable lead-capture form wired to formsubmit.co.
 *
 * Emits a POST form to https://formsubmit.co/<leadInbox> with hidden fields for
 * subject, captcha-off, and UTM attribution so every captured lead carries its
 * acquisition source into the inbox (and a future HubSpot/CRM import).
 *
 * Design: uses existing canonical form classes (.inner-form, .field, .form-row,
 * .form-label, .btn--primary). No Tailwind, no inline styles (rule 2.1), RTL + tokens.
 *
 * a11y (DEC-A11Y-002, 2026-07-14):
 *   - Every input has aria-describedby pointing to its error message span
 *     so screen readers announce validation errors when they appear.
 *   - The PDPL consent checkbox has its own error slot (linked via aria-describedby).
 *   - Required fields are marked with both HTML5 `required` and `aria-required="true"`
 *     for older assistive tech that doesn't pick up the HTML5 attribute.
 *   - Error spans use role="alert" + aria-live="polite" so errors are announced
 *     automatically when the text content changes.
 *   - Helper text (e.g. field hint) is also linked via aria-describedby
 *     (multiple IDs space-separated).
 *
 * Props:
 *   - title: form card heading
 *   - intro: short helper text under the title
 *   - subject: value for formsubmit `_subject`
 *   - ctaLabel: submit button text
 *   - source/medium/campaign: UTM attribution
 *   - fields: field definitions (see FieldDef)
 *   - consentLabel: PDPL consent text (defaults to standard wording)
 */
import { MARKETING } from '../data/marketing';
import { attributionFields } from '../data/marketing';

interface FieldDef {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'select';
  options?: string[];
  required?: boolean;
  placeholder?: string;
  autocomplete?: string;
  full?: boolean; // span both columns in the 2-col row
  hint?: string;  // helper text below the field, linked via aria-describedby
}

interface Props {
  title: string;
  intro?: string;
  subject: string;
  ctaLabel: string;
  source?: string;
  medium?: string;
  campaign?: string;
  fields: FieldDef[];
  consentLabel?: string;
}

const {
  title,
  intro,
  subject,
  ctaLabel,
  source,
  medium,
  campaign,
  fields,
  consentLabel = 'أوافق على معالجة بياناتي الشخصية المدخلة وفقاً لـ <a href="/privacy-policy/">سياسة الخصوصية</a> و <a href="/pdpl-statement/">بيان الامتثال لنظام PDPL السعودي</a>.',
} = Astro.props;

const attr = attributionFields({ source, medium, campaign });
const formAction = `https://formsubmit.co/${MARKETING.leadInbox}`;

// Error span IDs — used by both the input (aria-describedby) and the span (id).
// Same pattern as KernelLeadForm.astro (DEC-A11Y-002 + DEC-KERNEL-AI-2026-07-14).
const errorIdFor = (name: string) => `${name}-error`;
const hintIdFor = (name: string) => `${name}-hint`;
---

<form
  class="inner-form"
  action={formAction}
  method="POST"
  aria-label={title}
  novalidate
>
  <input type="hidden" name="_subject" value={subject} />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_next" value={MARKETING.leadThankYou} />
  <input type="hidden" name="_template" value="table" />
  {attr.map((a) => <input type="hidden" name={a.name} value={a.value} />)}

  <h3 class="form-card__title">{title}</h3>
  {intro && <p class="form-card__desc">{intro}</p>}

  <div class="form-row form-row--2">
  {
    fields.map((f) => {
      const isSelect = f.type === 'select';
      const isArea = f.type === 'textarea';
      const inputType = isSelect || isArea ? undefined : f.type || 'text';
      const errorId = errorIdFor(f.name);
      const hintId = f.hint ? hintIdFor(f.name) : undefined;
      // aria-describedby: hint + error (whichever exist)
      const describedBy = [hintId, errorId].filter(Boolean).join(' ') || undefined;
      return (
        <div class:list={['form-field', f.full && 'form-field--full']}>
          <label class="form-label" for={f.name}>
            {f.label}
            {f.required && <span class="form-label__required" aria-hidden="true">*</span>}
          </label>
          {isSelect ? (
            <>
              <select
                class="field field--select"
                id={f.name}
                name={f.name}
                required={f.required}
                aria-required={f.required ? 'true' : undefined}
                aria-describedby={describedBy}
              >
                <option value="">اختر…</option>
                {f.options?.map((o) => <option>{o}</option>)}
              </select>
              {f.hint && <span id={hintId} class="form-field__hint">{f.hint}</span>}
              <span id={errorId} class="form-field__error" role="alert" aria-live="polite" hidden></span>
            </>
          ) : isArea ? (
            <>
              <textarea
                class="field field--textarea"
                id={f.name}
                name={f.name}
                required={f.required}
                aria-required={f.required ? 'true' : undefined}
                aria-describedby={describedBy}
                placeholder={f.placeholder}
              ></textarea>
              {f.hint && <span id={hintId} class="form-field__hint">{f.hint}</span>}
              <span id={errorId} class="form-field__error" role="alert" aria-live="polite" hidden></span>
            </>
          ) : (
            <>
              <input
                class="field"
                type={inputType}
                id={f.name}
                name={f.name}
                required={f.required}
                aria-required={f.required ? 'true' : undefined}
                aria-describedby={describedBy}
                autocomplete={f.autocomplete}
                inputmode={f.type === 'tel' ? 'tel' : f.type === 'email' ? 'email' : undefined}
                placeholder={f.placeholder}
              />
              {f.hint && <span id={hintId} class="form-field__hint">{f.hint}</span>}
              <span id={errorId} class="form-field__error" role="alert" aria-live="polite" hidden></span>
            </>
          )}
        </div>
      );
    })
  }
  </div>

  <div class="form-field form-field--full form-field--consent">
    <input
      required
      aria-required="true"
      aria-describedby="pdpl-consent-error"
      id="pdpl_consent"
      name="pdpl_consent"
      type="checkbox"
      class="form-field__checkbox"
    />
    <label for="pdpl_consent" class="form-field__consent-text" set:html={consentLabel}></label>
    <span id="pdpl-consent-error" class="form-field__error" role="alert" aria-live="polite" hidden></span>
  </div>

  <button class="btn btn--primary btn--block inner-form__submit" type="submit">
    <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-send"></use></svg>
    {ctaLabel}
  </button>
</form>

<style>
  .form-card__title { margin-block-end: var(--space-2); }
  .form-card__desc {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    margin-block-end: var(--space-4);
    line-height: 1.6;
  }
  .form-field--full { grid-column: 1 / -1; }
  /* 2-column field layout when the parent is .form-row--2 */
  .inner-form :global(.form-field) { min-width: 0; }

  /* DEC-A11Y-002 (2026-07-14): moved from inline styles in template */
  .form-label__required {
    color: var(--status-danger);
    margin-inline-start: var(--space-1);
  }
  .form-field__hint {
    display: block;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    line-height: 1.5;
    margin-block-start: var(--space-1);
  }
  .form-field__error {
    display: block;
    color: var(--status-danger);
    font-size: var(--text-xs);
    line-height: 1.5;
    margin-block-start: var(--space-1);
    font-weight: var(--font-semibold);
  }
  .form-field__error[hidden] { display: none; }
  .form-field--consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .form-field__checkbox {
    margin-block-start: 0.2em;
    flex-shrink: 0;
  }
  .form-field__consent-text {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: var(--text-xs);
    flex: 1 1 200px;
  }
  .form-field--consent .form-field__error {
    flex-basis: 100%;
    margin-block-start: 0;
  }
</style>
