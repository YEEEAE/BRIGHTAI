---
const references = [
  {
    name: 'إرشادات الذكاء الاصطناعي من سدايا (SDAIA)',
    href: 'https://sdaia.gov.sa/en/SDAIA/about/Pages/RegulationsAndPolicies.aspx',
    detail: 'مرجع توضيحي للحوكمة والاستخدام المسؤول؛ لا يدل على اعتماد أو موافقة من سدايا.',
  },
  {
    name: 'ضوابط الأمن السيبراني الأساسية (NCA ECC)',
    href: 'https://nca.gov.sa/en/regulatory-documents/controls-list/ecc/',
    detail: 'يحدد نطاق انطباق كل ضابط بحسب الجهة؛ ذكره هنا لا يثبت امتثال BrightAI أو العميل.',
  },
  {
    name: 'معيار أنظمة إدارة الذكاء الاصطناعي ISO/IEC 42001:2023',
    href: 'https://www.iso.org/standard/42001',
    detail: 'مرجع تعريفي بالمعيار، وليس شهادة ممنوحة لـ BrightAI أو لعملائه.',
  },
  {
    name: 'إطار الأمن السيبراني للجهات الخاضعة للبنك المركزي السعودي (SAMA)',
    href: 'https://rulebook.sama.gov.sa/en/cyber-security-framework-2',
    detail: 'مرجع للجهات التي ينطبق عليها الإطار؛ مسؤولية تطبيقه وتقييمه على الجهة نفسها.',
  },
];
---

<section class="trust-references" aria-labelledby="trust-references-title">
  <h2 id="trust-references-title">مراجع تنظيمية للاسترشاد</h2>
  <p class="trust-references__intro">
    نعرض هذه الأسماء كمراجع عامة فقط. ما عندنا ما يثبت شهادة أو اعتمادًا أو موافقة رسمية من الجهات المذكورة.
  </p>
  <ul class="trust-references__list">
    {references.map((reference) => (
      <li>
        <a href={reference.href} target="_blank" rel="noopener noreferrer">
          {reference.name}<span class="trust-references__external" aria-hidden="true"> ↗</span>
        </a>
        <p>{reference.detail}</p>
      </li>
    ))}
  </ul>
  <p class="trust-references__disclaimer">
    لا تعني هذه المراجع أن BrightAI أو أي عميل حاصل على شهادة أو موافقة أو ممتثل تلقائيًا. يعتمد الامتثال النهائي على نطاق الجهة وبيئة النشر والضوابط المطبقة، ويتطلب تقييمًا مستقلًا من الجهة المؤهلة.
  </p>
</section>

<style>
  .trust-references {
    margin-block: 1.25rem 0;
    color: var(--text-secondary, #cbd5e1);
    line-height: 1.65;
  }

  .trust-references h2 {
    margin: 0;
    color: var(--text-primary, #f1f5f9);
    font-size: 1rem;
    font-weight: 700;
  }

  .trust-references__intro,
  .trust-references__disclaimer {
    margin-block: 0.5rem;
    font-size: 0.875rem;
  }

  .trust-references__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.75rem 1.25rem;
    margin: 0.75rem 0;
    padding: 0;
    list-style: none;
  }

  .trust-references__list li {
    min-width: 0;
  }

  .trust-references__list a {
    color: var(--interactive-primary, #67e8f9);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .trust-references__list a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .trust-references__list p {
    margin: 0.2rem 0 0;
    font-size: 0.8125rem;
  }

  .trust-references__disclaimer {
    padding-block-start: 0.65rem;
    border-block-start: 1px solid rgb(148 163 184 / 0.25);
  }
</style>
