---
/**
 * SolutionCard — Card for a single solution on /solutions/ hub + cross-links.
 *
 * Canonical anatomy (REPORT-07 + REPORT-10 enhancements):
 *   - .card__icon      — brand-glow icon (top)
 *   - .card__eyebrow   — uppercase category tag (e.g. "حماية البيانات")
 *   - .card__title     — h3 headline
 *   - .card__desc      — lead paragraph (shortDesc)
 *   - .card__meta      — bottom row (when-needed question/answer)
 *   - .card__action    — cta link with arrow
 *   - .solution-card-tags (optional) — chip cluster before meta for
 *                                       compliance hint (PDPL, NCA, ...)
 *
 * Used by:
 *   - src/pages/solutions/index.astro (hub grid)
 *   - src/pages/solutions/[slug].astro (cross-link grid inside product page)
 */
import type { SolutionData } from '../data/solutions';
import Icon from '../components/Icon.astro';

interface Props { solution: SolutionData; }
const { solution } = Astro.props;

const cardTitle =
  solution.cardTitle ??
  (solution.h1.split(' ').length > 4 ? solution.h1 : solution.title.split(' | ')[0]);

// Generate descriptive anchor text based on solution slug
function getDescriptiveAnchor(solution: SolutionData): string {
  const slug = solution.slug;
  const anchors: Record<string, string> = {
    'ai-governance-platform': 'تعرّف على منصة الحوكمة الكاملة',
    'ai-firewall': 'اكتشف كيف يحمي AI Firewall بياناتك',
    'ai-audit-trail': 'تعرّف على سجل تدقيق AI غير القابل للتعديل',
    'ai-evidence-file': 'شوف كيف يُصدّر ملف الأدلة للمدققين',
    'human-approval-layer': 'اكتشف طبقة الموافقة البشرية للقرارات الحساسة',
    'continuous-ai-governance': 'تعرّف على الحوكمة المستمرة والتحديث التلقائي',
    'ai-risk-classification': 'شوف كيف يُصنّف مخاطر كل استخدام AI',
    'ai-use-case-discovery': 'اكتشف استخدامات AI الخفية (Shadow AI) في شركتك',
    'policy-to-control-mapping': 'تعرّف على ربط السياسات بالضوابط التقنية',
  };
  return anchors[slug] ?? 'اعرف المزيد ←';
}
---

<a
  href={solution.href}
  class="card card--feature card--interactive solution-card"
  aria-label={solution.h1}
>
  <span class="card__icon" aria-hidden="true">
    <Icon name={solution.icon} />
  </span>

  {solution.chip && <span class="card__eyebrow">{solution.chip}</span>}

  <h3 class="card__title">{cardTitle}</h3>

  <p class="card__desc">{solution.shortDesc}</p>

  <span class="card__meta">
    <span class="card__meta-label">
      {solution.whenLabel ?? 'متى تحتاجه؟'}
    </span>
    <span class="card__meta-value">{solution.whenNeeded}</span>
  </span>

  <span class="card__action">{getDescriptiveAnchor(solution)}</span>
</a>

<style>
  .solution-card {
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  /* When "whenNeeded" question lives at bottom, keep label/value stacked
     for readability — separates semantic from value visually. */
  .solution-card .card__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    margin-block-start: auto;
  }

  .solution-card .card__meta-label {
    font-weight: var(--font-bold);
    letter-spacing: 0.04em;
    font-size: var(--text-xs);
    color: var(--brand-300);
    text-transform: uppercase;
  }

  .solution-card .card__meta-value {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-snug);
    text-wrap: pretty;
  }

  .solution-card .card__action {
    font-size: var(--text-sm);
  }
</style>