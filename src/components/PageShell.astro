---
import '../styles/pages.css';
import '../styles/interior.css';
import InteriorController from './InteriorController.astro';
import InteriorMotion from './InteriorMotion.astro';
import PageMotionStudy from './PageMotionStudy.astro';
import '../styles/interior-motion.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
interface Crumb { name: string; href?: string }
interface Props { title: string; description: string; crumbs: Crumb[]; robots?: string; ogType?: 'website' | 'article'; structuredData?: Record<string, unknown> }
const { title, description, crumbs, robots = 'index, follow', ogType = 'website', structuredData } = Astro.props;
const family = Astro.url.pathname.split('/').filter(Boolean)[0] ?? 'home';
const segment = Astro.url.pathname.split('/').filter(Boolean)[1] ?? 'index';
// Opt in only the public editorial families; leave product and home styling alone.
const publicContent = ['solutions', 'pillars', 'services', 'pricing', 'about', 'contact', 'trust', 'compliance', 'docs', 'knowledge', 'privacy', 'terms'].includes(family);
const site = 'https://brightai.live';
const all = [{ name: 'الرئيسية', href: '/' }, ...crumbs];
const schema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href ?? Astro.url.pathname, site).href })),
};
const reading = ['knowledge', 'privacy', 'terms'].includes(family);
let content = await Astro.slots.render('default');
const toc: { id: string; title: string }[] = [];
if (reading) content = content.replace(/<h2\b([^>]*)>([\s\S]*?)<\/h2>/g, (full, attrs, text) => {
  if (/في هذا الدليل/.test(text)) return full;
  const id = /\bid="([^"]+)"/.exec(attrs)?.[1] ?? `document-heading-${toc.length + 1}`;
  toc.push({ id, title: text.replace(/<[^>]*>/g, '').trim() });
  return `<h2${attrs}${/\bid=/.test(attrs) ? '' : ` id="${id}"`}>${text}</h2>`;
});
const words = content.replace(/<(script|style|svg|noscript)\b[^>]*>[\s\S]*?<\/\1>/gi, '').replace(/<[^>]+>/g, ' ').replace(/&[^;]+;/g, ' ').trim().split(/\s+/).length;
const minutes = Math.max(1, Math.ceil(words / 180));
---
<BaseLayout title={title} description={description} robots={robots} ogType={ogType}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  <Header />
  <main id="main" tabindex="-1" class={`wrap section page page-family-${family} interior-page interior-${family}-${segment}${publicContent ? ' public-content' : ''}`}>
    <nav class="breadcrumb" aria-label="مسار التنقل">
      {all.map((c, i) => i < all.length - 1 ? <><a href={c.href}><bdi>{c.name}</bdi></a> / </> : <span aria-current="page"><bdi>{c.name}</bdi></span>)}
    </nav>
    {reading && <nav class="document-toc" aria-label="تنقل القراءة"><p>{family === 'knowledge' ? `وقت قراءة تقريبي: ${minutes} دقيقة، بافتراض 180 كلمة في الدقيقة.` : 'داخل هذه الوثيقة'}</p><details><summary>انتقل إلى قسم</summary>{toc.map(item => <a href={`#${item.id}`}>{item.title}</a>)}</details></nav>}
    <Fragment set:html={content} />
    <PageMotionStudy family={family} segment={segment}/>
    <details class="section-compass" hidden data-section-compass>
      <summary aria-controls="section-compass-links"><span aria-hidden="true">☷</span> داخل الصفحة <span data-section-position></span></summary>
      <nav id="section-compass-links" aria-label="فهرس أقسام الصفحة" data-section-links></nav>
    </details>
  </main>
  <InteriorController />
  <InteriorMotion />
  <Footer />
</BaseLayout>
