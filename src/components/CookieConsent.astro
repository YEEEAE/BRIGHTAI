---
/**
 * CookieConsent — GDPR/PDPL cookie banner with accept/decline.
 * Uses V3 unified design tokens with scoped styles.
 */
---

<div id="cookie-consent" class="cookie-consent" role="dialog" aria-label="إشعار ملفات تعريف الارتباط" hidden>
  <div class="cookie-consent__inner">
    <p class="cookie-consent__text">
      نستخدم ملفات تعريف الارتباط لتحسين تجربتك. بالاستمرار في التصفح، أنت توافق على
      <a href="/privacy-cookies/" class="cookie-consent__link">سياسة ملفات تعريف الارتباط</a>.
    </p>
    <div class="cookie-consent__actions">
      <button id="cookie-accept" class="btn btn--primary cookie-consent__btn">قبول</button>
      <button id="cookie-decline" class="btn btn--ghost cookie-consent__btn">رفض</button>
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-consent');
  if (banner && !localStorage.getItem('cookie-consent')) {
    banner.hidden = false;
  }
  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem('cookie-consent', 'accepted');
    banner!.hidden = true;
  });
  document.getElementById('cookie-decline')?.addEventListener('click', () => {
    localStorage.setItem('cookie-consent', 'declined');
    banner!.hidden = true;
  });
</script>

<style>
  .cookie-consent {
    position: fixed;
    bottom: 0;
    inset-inline: 0;
    z-index: 900;
    background: var(--bg-elevated);
    border-top: 1px solid var(--border-default);
    padding: var(--space-4) var(--space-6);
    box-shadow: 0 -4px 24px rgba(0,0,0,0.3);
  }

  .cookie-consent__inner {
    max-width: 80rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
  }

  @media (min-width: 768px) {
    .cookie-consent__inner {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .cookie-consent__text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
    text-align: center;
  }

  @media (min-width: 768px) {
    .cookie-consent__text { text-align: start; }
  }

  .cookie-consent__link {
    color: var(--interactive-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-consent__link:hover { opacity: 0.85; }

  .cookie-consent__actions {
    display: flex;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .cookie-consent__btn {
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
    min-height: 44px;
  }
</style>