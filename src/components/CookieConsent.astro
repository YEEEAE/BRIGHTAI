---
/**
 * CookieConsent — GDPR/PDPL cookie banner with accept/decline.
 *
 * CRO audit Prompt 5 (2026-07-18): wires the consent decision into the
 * unified analytics runtime (window.__BRIGHTAI_ANALYTICS__.setConsent) so
 * that:
 *
 *   - On accept: queued events (collected before the user clicked) are
 *     flushed to the providers (gtag, mixpanel, bing).
 *   - On decline: queued events are dropped, and the providers never
 *     receive anything for the rest of the session.
 *
 * The consent flag is also written to localStorage under the
 * `brightai:tracking_consent` key (the analytics runtime reads this on
 * boot so consent survives a hard refresh).
 *
 * The legacy `cookie-consent` localStorage key is still set for any
 * downstream scripts that read it (kept for back-compat with the
 * perf-audit consent state).
 *
 * Visual: V3 unified design tokens with scoped styles (unchanged from
 * the prior version).
 */
---

<div id="cookie-consent" class="cookie-consent" role="dialog" aria-label="إشعار ملفات تعريف الارتباط" hidden>
  <div class="cookie-consent__inner">
    <p class="cookie-consent__text">
      نستخدم ملفات تعريف الارتباط والقياس الاختياري لتحسين تجربتك. تقدر تقبل أو ترفض، وتفاصيل الاستخدام موجودة في
      <a href="/privacy-cookies/" class="cookie-consent__link">سياسة ملفات تعريف الارتباط</a>.
    </p>
    <div class="cookie-consent__actions">
      <button id="cookie-accept" class="btn btn--primary cookie-consent__btn" type="button">قبول</button>
      <button id="cookie-decline" class="btn btn--ghost cookie-consent__btn" type="button">رفض</button>
    </div>
  </div>
</div>

<script>
  // Migrate the legacy decision once, then show the banner only when no
  // explicit tracking decision exists.
  const legacyConsent = localStorage.getItem('cookie-consent');
  const storedConsent = localStorage.getItem('brightai:tracking_consent');
  if (!storedConsent && (legacyConsent === 'accepted' || legacyConsent === 'declined')) {
    localStorage.setItem('brightai:tracking_consent', legacyConsent === 'accepted' ? 'granted' : 'denied');
  } else if ((storedConsent === 'granted' || storedConsent === 'denied') && !legacyConsent) {
    localStorage.setItem('cookie-consent', storedConsent === 'granted' ? 'accepted' : 'declined');
  }
  const banner = document.getElementById('cookie-consent');
  if (banner && !storedConsent && !legacyConsent) {
    banner.hidden = false;
  }

  // Helper — set the legacy + the new consent key, and notify the analytics
  // runtime. We tolerate the runtime not being installed yet (first page
  // load order: this script runs synchronously, analytics.js runs deferred).
  type ConsentState = 'granted' | 'denied';

  function setTrackingConsent(value: ConsentState) {
    try {
      localStorage.setItem('cookie-consent', value === 'granted' ? 'accepted' : 'declined');
      localStorage.setItem('brightai:tracking_consent', value);
    } catch { /* private mode */ }
    if (banner) banner.hidden = true;
    // Notify the runtime — if it isn't installed yet, hydrateConsentFromStorage
    // will pick up the localStorage value when it boots.
    const rt = window.__BRIGHTAI_ANALYTICS__;
    if (rt && typeof rt.setConsent === 'function') {
      rt.setConsent(value);
    }
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    setTrackingConsent('granted');
  });
  document.getElementById('cookie-decline')?.addEventListener('click', () => {
    setTrackingConsent('denied');
  });
</script>

<style>
  .cookie-consent {
    position: fixed;
    bottom: 0;
    inset-inline: 0;
    z-index: 900;
    background: var(--bg-elevated, #141b2d);
    border-top: 1px solid var(--border-default, #334155);
    padding: var(--space-4, 1rem) var(--space-6, 1.5rem);
    box-shadow: 0 -4px 24px rgba(0,0,0,0.3);
  }

  .cookie-consent__inner {
    max-width: 80rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
    align-items: center;
  }

  @media (min-width: 768px) {
    .cookie-consent__inner {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .cookie-consent__text {
    font-size: var(--text-sm, 0.875rem);
    color: var(--text-secondary, #e2e8f0);
    margin: 0;
    text-align: center;
  }

  @media (min-width: 768px) {
    .cookie-consent__text { text-align: start; }
  }

  .cookie-consent__link {
    color: var(--interactive-primary, #67e8f9);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cookie-consent__link:hover { opacity: 0.85; }

  .cookie-consent__actions {
    display: flex;
    gap: var(--space-3, 0.75rem);
    flex-shrink: 0;
  }

  .cookie-consent__btn {
    font-size: var(--text-sm, 0.875rem);
    padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
    min-height: 44px;
  }
</style>
