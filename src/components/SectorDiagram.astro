---
interface Props { kind: string; contexts: string[][] }
const { kind, contexts } = Astro.props;
const lines: Record<string,string[]> = {
  government: ['M300 30V90L100 145','M300 90V145','M300 90L500 145'],
  finance: ['M100 110H300','M300 110H500','M500 110V175'],
  healthcare: ['M100 110L300 55','M300 55L500 110','M100 110L300 165L500 110'],
  enterprise: ['M100 55L300 110','M100 110H300','M100 165L300 110'],
};
const nodes: Record<string, Array<[number,number]>> = {
  government: [[100,145],[300,145],[500,145]],
  finance: [[100,110],[300,110],[500,110]],
  healthcare: [[100,110],[300,55],[500,110]],
  enterprise: [[100,55],[100,110],[100,165]],
};
---
<figure class={`sector-visual sector-diagram diagram-${kind}`}>
  <figcaption class="context-label">خريطة أسئلة / ليست إجراء تشغيل معتمداً</figcaption>
  <svg viewBox="0 0 600 220" fill="none" aria-hidden="true">
    <rect x="1" y="1" width="598" height="218" stroke="#44304d" stroke-dasharray="2 10"/>
    {lines[kind].map((path,i) => <path class={`sector-line line-${i}`} data-stage={i+1} d={path} stroke="currentColor" stroke-width="1.5" pathLength="1"/>)}
    {nodes[kind].map(([x,y],i) => <g class="sector-node" data-stage={i+1}><circle cx={x} cy={y} r="20"/><text x={x} y={y+4} text-anchor="middle">0{i+1}</text></g>)}
  </svg>
  <ol class="sector-stages">{contexts.map(([name,text],i) => <li><span aria-hidden="true">0{i+1}</span><details open={i === 0}><summary>{name}</summary><p>{text}</p></details></li>)}</ol>
</figure>
<style>
 .sector-diagram svg { display: block; inline-size: 100%; block-size: auto; margin-block: 16px 28px; }
 .sector-line { color: #8052ff; stroke-dasharray: 1; }
 .sector-diagram .sector-line { opacity: .42; transition: opacity var(--ui-state,220ms),stroke-width var(--ui-state,220ms); }
 .sector-diagram .sector-node circle { fill: #120d19; stroke: #705986; stroke-width: 1.5; transition: fill var(--ui-state,220ms),stroke var(--ui-state,220ms),r var(--ui-state,220ms); }
 .sector-diagram .sector-node text { fill: #bdbdbd; font: 11px ui-monospace,monospace; direction: ltr; unicode-bidi: isolate; }
 .sector-diagram:has(.sector-stages li:nth-child(1) details[open]) svg [data-stage="1"],
 .sector-diagram:has(.sector-stages li:nth-child(2) details[open]) svg [data-stage="2"],
 .sector-diagram:has(.sector-stages li:nth-child(3) details[open]) svg [data-stage="3"] { opacity: 1; stroke-width: 2.5; animation: sector-route 700ms var(--ui-ease,ease-out) both; }
 .sector-diagram:has(.sector-stages li:nth-child(1) details[open]) svg .sector-node[data-stage="1"] circle,
 .sector-diagram:has(.sector-stages li:nth-child(2) details[open]) svg .sector-node[data-stage="2"] circle,
 .sector-diagram:has(.sector-stages li:nth-child(3) details[open]) svg .sector-node[data-stage="3"] circle { fill: #221a0b; stroke: var(--ui-amber); r: 23px; }
 .sector-diagram:has(.sector-stages li:nth-child(1) details[open]) svg .sector-node[data-stage="1"] text,
 .sector-diagram:has(.sector-stages li:nth-child(2) details[open]) svg .sector-node[data-stage="2"] text,
 .sector-diagram:has(.sector-stages li:nth-child(3) details[open]) svg .sector-node[data-stage="3"] text { fill: var(--ui-amber); }
 .sector-stages { margin: 0; padding: 0; list-style: none; }
 .sector-stages li { display: grid; grid-template-columns: 32px minmax(0,1fr); gap: 16px; border-block-start: 1px solid var(--ui-line,#302a39); }
 .sector-stages li>span { font: 12px ui-monospace,monospace; font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate; color: #bdbdbd; padding-top: 24px; }
 .sector-stages details { border: 0; padding-block: 10px; border-radius: 8px; }
 .sector-stages summary { font-size: 18px; min-height: 48px; padding-block: 12px; color: #fff; letter-spacing: 0; transition: color var(--ui-fast,140ms); }
 .sector-stages summary::marker { color: #8052ff; }
 .sector-stages details[open] summary { color: #ffb829; }
 .sector-stages details[open] summary::marker { color: #ffb829; }
 .sector-stages p { font-size: 14px; line-height: 1.9; font-weight: 400; letter-spacing: 0; color: #bdbdbd; margin-block: 4px 16px; }
 @media(hover:hover) { .sector-stages summary:hover { color: #ffb829; } }
 .diagram-finance .sector-stages li:nth-child(2) { margin-inline-start: 20px; }.diagram-finance .sector-stages li:nth-child(3) { margin-inline-start: 40px; }
 .diagram-enterprise .sector-stages li { border-inline-start: 1px solid #614674; padding-inline-start: 18px; }
 .sector-diagram .context-label { inline-size: fit-content; max-inline-size: 100%; padding: 7px 11px; border: 1px solid var(--ui-line); border-radius: var(--ui-radius-sm); background: var(--surface-panel); color: var(--ui-copy); line-height: 1.7; }
 .sector-diagram svg { overflow: visible; padding: 8px; border: 1px solid var(--ui-line); border-radius: var(--ui-radius-sm); background: linear-gradient(90deg,transparent 49.8%,#ffffff08 50%,transparent 50.2%),linear-gradient(0deg,transparent 49.8%,#ffffff08 50%,transparent 50.2%),#09070d; }
 .sector-diagram svg > rect { stroke: var(--ui-line); }
 .sector-stages li { grid-template-columns: 40px minmax(0,1fr); gap: 14px; border-block-start-color: var(--ui-line); }
 .sector-stages li > span { display: grid; place-items: center; inline-size: 32px; block-size: 32px; padding: 0; margin-block-start: 18px; border: 1px solid #705986; border-radius: 50%; background: #120d19; color: var(--ui-amber); font-size: 12px; }
 .sector-stages li:has(details[open]) > span { border-color: var(--ui-amber); background: #221a0b; }
 .sector-stages details[open] summary { text-decoration: underline; text-decoration-color: #ffb82955; text-underline-offset: 6px; }
 .sector-stages p { max-inline-size: 54ch; }
 .sector-diagram:focus-within svg { border-color: #705986; }
 @keyframes sector-route { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
 @media(prefers-reduced-motion:reduce) { .sector-diagram .sector-line,.sector-diagram .sector-node circle { animation: none !important; transition: none; } }
</style>
