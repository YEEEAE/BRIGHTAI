<script>
  // Interior-only enhancement. No router, scroll hijacking, or background loops.
  function initializeInterior() {
    const root = document.querySelector<HTMLElement>('.interior-page');
    if (!root) return;
    const lifetime = new AbortController();
    const signal = lifetime.signal;
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    const observers: IntersectionObserver[] = [];
    const frames = new Set<number>();
    const frame = (fn: () => void) => {
      const id = requestAnimationFrame(() => { frames.delete(id); fn(); });
      frames.add(id);
    };

    // Entrance choreography belongs to InteriorMotion; keep one observer owner.

    // A generated, optional compass supplements the server-rendered article TOC.
    const compass = root.querySelector<HTMLDetailsElement>('[data-section-compass]');
    const linksRoot = root.querySelector('[data-section-links]');
    const headings = [...root.querySelectorAll<HTMLHeadingElement>('h2')].filter(heading =>
      !heading.closest('.reading-nav,.experience,.section-compass') && heading.textContent?.trim());
    const links: HTMLAnchorElement[] = [];
    headings.forEach((heading, index) => {
      heading.id ||= `reading-section-${index + 1}`;
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      const number = document.createElement('bdi');
      number.dir = 'ltr';
      number.textContent = `${String(index + 1).padStart(2, '0')} /`;
      const label = document.createElement('bdi');
      label.textContent = heading.innerText.replace(/\s+/g, ' ').trim();
      link.append(number, document.createTextNode(' '), label);
      link.addEventListener('click', () => {
        if (compass) compass.open = false;
        heading.tabIndex = -1;
        heading.focus({ preventScroll: true });
      }, { signal });
      linksRoot?.append(link); links.push(link);
    });
    if (compass && headings.length > 2) compass.hidden = false;
    const position = root.querySelector('[data-section-position]');
    if (position) position.textContent = `01 / ${String(headings.length).padStart(2, '0')}`;
    const visibleHeadings = new Set<Element>();
    const headingObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => entry.isIntersecting ? visibleHeadings.add(entry.target) : visibleHeadings.delete(entry.target));
      const current = headings.find(heading => visibleHeadings.has(heading));
      if (!current) return;
      const index = headings.indexOf(current);
      links.forEach((link, i) => i === index ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current'));
      if (position) position.textContent = `${String(index + 1).padStart(2, '0')} / ${String(headings.length).padStart(2, '0')}`;
    }, { rootMargin: '-12% 0px -55% 0px' });
    headings.forEach(heading => headingObserver.observe(heading)); observers.push(headingObserver);

    const footer = document.querySelector('footer');
    if (footer && compass && headings.length > 2) {
      const footerObserver = new IntersectionObserver(entries => {
        compass.hidden = entries.some(entry => entry.isIntersecting);
      });
      footerObserver.observe(footer); observers.push(footerObserver);
    }

    // Reading progress is local UI state; no analytics, storage, or text collection.
    const article = root.querySelector('article');
    const readingNav = root.querySelector('.reading-nav');
    if (article && readingNav) {
      const progress = document.createElement('progress');
      progress.max = 100; progress.value = 0; progress.className = 'reading-progress';
      progress.setAttribute('aria-label', 'تقدّم قراءة الدليل'); readingNav.prepend(progress);
      let pending = false;
      const update = () => {
        pending = false;
        const box = article.getBoundingClientRect();
        progress.value = Math.max(0, Math.min(100, -box.top / Math.max(1, box.height - innerHeight) * 100));
      };
      const schedule = () => { if (!pending) { pending = true; frame(update); } };
      addEventListener('scroll', schedule, { passive: true, signal });
      addEventListener('resize', schedule, { passive: true, signal }); update();
    }

    // Hover light follows the device pointer only on capable devices.
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      root.querySelectorAll<HTMLElement>('.experience,.sector-visual').forEach(panel => {
        let queued = false; let x = 50; let y = 50;
        panel.addEventListener('pointermove', event => {
          if (preference.matches) return;
          const rect = panel.getBoundingClientRect(); x = event.clientX - rect.left; y = event.clientY - rect.top;
          if (queued) return; queued = true;
          frame(() => { queued = false; panel.style.setProperty('--pointer-x', `${x}px`); panel.style.setProperty('--pointer-y', `${y}px`); });
        }, { passive: true, signal });
      });
    }

    // Native disclosure remains usable without this linked diagram feedback.
    root.querySelectorAll<HTMLElement>('.experience-human-gate,.experience-ledger,.sector-visual').forEach(panel => {
      panel.querySelectorAll('details').forEach((details, index) => details.addEventListener('toggle', () => {
        if (details.open) panel.dataset.stage = String(index);
      }, { signal }));
    });
    // Branch feedback (state, label, result, packet) is owned by interior-motion.ts,
    // together with the entrance choreography; this controller never duplicates it.

    addEventListener('pagehide', () => {
      lifetime.abort(); observers.forEach(observer => observer.disconnect());
      frames.forEach(id => cancelAnimationFrame(id));
      compass?.setAttribute('hidden', ''); linksRoot?.replaceChildren();
      root.querySelector('.reading-progress')?.remove();
    }, { once: true, signal });
  }
  initializeInterior();
  addEventListener('pageshow', event => { if (event.persisted) initializeInterior(); });
</script>
