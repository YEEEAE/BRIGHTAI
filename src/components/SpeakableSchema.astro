---
/**
 * SpeakableSchema.astro — Voice Search / AEO Speakable Schema component.
 *
 * Provides schema.org SpeakableSpecification selectors for Blog and Docs pages
 * to support AI Voice interfaces (Google Assistant, Perplexity, Voice Search).
 */
interface Props {
  selectors?: string[];
  canonical?: string;
}

const {
  selectors = ['h1', '.speakable-summary'],
} = Astro.props;
---

<!-- Speakable AEO Schema metadata marker -->
<meta name="speakable-selectors" content={selectors.join(', ')} />
