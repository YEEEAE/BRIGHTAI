---
import RiskEvaluation from "./RiskEvaluation.astro";
import { riskAssets, riskDemo, riskLevel } from '../shared/risk-demo.mjs';
const initial = riskDemo({asset:'privacy',context:'sandbox',likelihood:3,impact:3,treatment:'reduce',control:'none'});
---
<section class="rd" data-risk-demo aria-label="مختبر المخاطر الاصطناعي">
 <header class="rd-head"><div><p class="rd-kicker">RISK STUDIO / 05</p><h2>من الأصل إلى قرار مفهوم.</h2><p>جرّب أثر السياق والضوابط على خطر خيالي.</p></div><span class="rd-tag">Synthetic · بيانات خيالية</span></header>
 <ol class="rd-flow" aria-label="مراحل التقدير"><li>01 أصل</li><li>02 خطر</li><li>03 تقدير</li><li>04 معالجة</li><li>05 قبول / مراجعة</li></ol>
 <div class="rd-layout"><div>
 <section class="rd-panel"><h3>01 / اختر الأصل والسياق</h3><label>حالة الاستخدام<select data-field="asset">{Object.entries(riskAssets).map(([key,a])=><option value={key}>{a.name}</option>)}</select></label><label>سياق الاستخدام<select data-field="context"><option value="sandbox">بيئة اختبار مغلقة · لا نشر</option><option value="public">مخرجات تصل إلى جمهور افتراضي</option></select></label><p class="rd-risk"><span>02 / الخطر المحتمل</span><strong data-risk-name>{initial.risk}</strong></p><p>تغيير الأصل يحمّل تقديره الافتراضي ويزيل المعالجة والقرار السابقين.</p></section>
 <section class="rd-panel"><h3>03 / قدّر الاحتمال والأثر</h3><div class="rd-pair"><label>احتمال الضرر<select data-field="likelihood">{['غير مرجح','ممكن','مرجح'].map((s,i)=><option value={i+1} selected={i===2}>{i+1} · {s}</option>)}</select></label><label>أثر الضرر<select data-field="impact">{['محدود وقابل للتدارك','مؤثر ويتطلب معالجة','جسيم'].map((s,i)=><option value={i+1} selected={i===2}>{i+1} · {s}</option>)}</select></label></div>
 <p>الصفوف: الاحتمال ↑ · الأعمدة: الأثر من 1 إلى 3 ←</p><div class="rd-matrix" aria-label="مصفوفة الاحتمال والأثر">{[3,2,1].map(l=>[1,2,3].map(i=><button type="button" disabled data-matrix={`${l}-${i}`} data-band={riskLevel(l*i)} aria-pressed={l===3&&i===3?'true':'false'}><b>{l*i}</b><span>{riskLevel(l*i)}</span><small data-marker>{l===3&&i===3?'أولي · متبقٍ':`${l} × ${i}`}</small></button>))}</div><p>اختر خلية أو استخدم القوائم. في سياق الجمهور يُرفع الاحتمال 1 إلى 2.</p>
 <details><summary>كيف تُحسب الدرجة؟ منهج demo معلن</summary><p>احتمال × أثر على مقياس ترتيبي 1–3، وليس نسبة حدوث. 1–2 منخفض، 3–4 متوسط، 6–9 مرتفع؛ القيم 5 و7 و8 لا تنتج. العتبات افتراضات تعليمية، لا تُنسب إلى ISO أو NIST أو جهة رقابية. المنهج التشغيلي مستقل؛ لا تنسخ هذه التخفيضات إلى تقييم مؤسسة.</p></details></section>
 <section class="rd-panel"><h3>04 / اختر المعالجة والضابط</h3><label>إجراء المعالجة<select data-field="treatment"><option value="reduce">تقليل الخطر</option><option value="review">إحالة للمراجعة</option><option value="avoid">تجنب الاستخدام · تعليق المثال</option></select></label><label>الضابط المفترض<select data-field="control"><option value="none">بدون ضابط</option><option value="human">مراجعة بشرية قبل الإرسال</option><option value="redact">إخفاء البيانات</option></select></label><p>اختيار الضابط لا يخفض الدرجة تلقائيًا؛ يلزم تقدير بشري مستقل مدعوم بالأدلة.</p></section>
 </div><aside class="rd-panel rd-inspector" aria-label="Inspector المالك والمراجعة والافتراضات"><p class="rd-kicker">INSPECTOR / تفسير القرار</p><div class="rd-scores" aria-live="polite" aria-atomic="true"><div><span>أولي · Initial</span><strong data-initial>9 / 9 · مرتفع</strong></div><div><span>متبقٍ · Residual</span><strong data-residual>9 / 9 · مرتفع</strong></div><p data-initial-reason>{initial.initialReason}</p><p data-residual-reason>{initial.residualReason}</p><p data-delta>الفرق: 0 درجات</p></div><dl><dt>مالك الأصل الخيالي</dt><dd data-owner>{initial.owner}</dd><dt>المراجع الخيالي</dt><dd>نورة · مراجعة مستقلة افتراضية</dd><dt>موعد المراجعة</dt><dd>بعد 7 أيام افتراضية، أو فور تغيّر الأصل أو الضابط</dd><dt>الافتراضات</dt><dd>لا بيانات فعلية؛ قيم مرتبة وليست احتمالات مقاسة؛ فاعلية الضابط غير مثبتة.</dd></dl><h3>05 / قرار المثال</h3><p>أنت تستكشف دورًا خياليًا؛ لا تملك هذه الواجهة قبول مخاطر أي مؤسسة.</p><div class="rd-decisions"><button type="button" disabled data-decision="review">إحالة خيالية للمراجعة</button><button type="button" disabled data-decision="accepted">محاكاة قبول خيالي فقط</button></div><p class="rd-decision" data-decision-status role="status">غير مقبول · لم يُحاكَ قرار بعد</p><p>أي تغيير في المدخلات يلغي قرار المثال ويستدعي مراجعة جديدة. القبول لا يخفض الدرجة ولا يجيز التشغيل.</p><button type="button" disabled data-export-risk>تصدير ملخص Synthetic · JSON</button><button type="button" disabled data-reset-risk>إعادة المثال</button><p data-export-status role="status"></p></aside></div>
 <RiskEvaluation />
 <p><a href="/demo/governance/#risk-engine">شغّل إعادة العرض وافتح نتائجها في مختبر الحوكمة</a></p>
 <noscript>فعّل JavaScript لاختيار السيناريو وإعادة الحساب والتصدير. التقدير الافتراضي أعلاه للقراءة فقط.</noscript>
</section>
<script>
import {startLab,completeLab,resetLab} from '../scripts/measurement';
import { riskAssets, riskDemo } from '../shared/risk-demo.mjs';
document.querySelectorAll<HTMLElement>('[data-risk-demo]').forEach(root=>{
 const field=(name:string)=>root.querySelector<HTMLSelectElement>(`[data-field="${name}"]`)!;
 const set=(selector:string,value:string)=>{root.querySelector(selector)!.textContent=value;};
 let decision='unaccepted';
 let result:ReturnType<typeof riskDemo>;
 function render(){
  result=riskDemo({asset:field('asset').value,context:field('context').value,likelihood:Number(field('likelihood').value),impact:Number(field('impact').value),treatment:field('treatment').value,control:field('control').value});
  set('[data-risk-name]',result.risk); set('[data-owner]',result.owner);
  for(const name of ['initial','residual'] as const){const r=result[name];set(`[data-${name}]`,`${r.score} / 9 · ${r.level} (${r.likelihood} × ${r.impact})`);set(`[data-${name}-reason]`,result[name+'Reason']);}
  set('[data-delta]',`الفرق: ${result.initial.score-result.residual.score} درجات في هذا المثال فقط`);
  root.querySelectorAll<HTMLButtonElement>('[data-matrix]').forEach(b=>{const key=b.dataset.matrix;const a=key===`${result.initial.likelihood}-${result.initial.impact}`,r=key===`${result.residual.likelihood}-${result.residual.impact}`;b.setAttribute('aria-pressed',String(a));b.dataset.residualCell=String(r);b.querySelector('[data-marker]')!.textContent=a&&r?'أولي · متبقٍ':a?'أولي':r?'متبقٍ':key!.replace('-',' × ');});
  set('[data-decision-status]',decision==='accepted'?`مقبول تجريبيًا · Accepted · ${result.residual.score}/9 — قبول خيالي دون صلاحية تشغيل`:decision==='review'?'قيد مراجعة خيالية · لم يُقبل':'غير مقبول · يلزم قرار جديد بعد أي تغيير');
  root.querySelector<HTMLButtonElement>('[data-decision="accepted"]')!.disabled=field('treatment').value!=='reduce';
 }
 root.querySelectorAll<HTMLSelectElement>('[data-field]').forEach(el=>el.addEventListener('change',()=>{startLab(root,'risk-engine');if(el===field('asset')){const a=riskAssets[el.value];field('likelihood').value=String(a.likelihood);field('impact').value=String(a.impact);field('control').value='none';field('treatment').value='reduce';}decision='unaccepted';set('[data-export-status]','');render();}));
 root.querySelectorAll<HTMLButtonElement>('button').forEach(b=>b.disabled=false);
 root.querySelectorAll<HTMLButtonElement>('[data-matrix]').forEach(b=>b.addEventListener('click',()=>{startLab(root,'risk-engine');const [l,i]=b.dataset.matrix!.split('-');field('likelihood').value=l;field('impact').value=i;decision='unaccepted';render();}));
 root.querySelectorAll<HTMLButtonElement>('[data-decision]').forEach(b=>b.addEventListener('click',()=>{startLab(root,'risk-engine');decision=b.dataset.decision!;render();completeLab(root,'risk-engine');}));
 root.querySelector('[data-reset-risk]')!.addEventListener('click',()=>{resetLab(root);for(const [key,value] of Object.entries({asset:'privacy',context:'sandbox',likelihood:'3',impact:'3',treatment:'reduce',control:'none'}))field(key).value=value;decision='unaccepted';set('[data-export-status]','');render();});
 root.querySelector('[data-export-risk]')!.addEventListener('click',()=>{const blob=new Blob([JSON.stringify({...result,decision,accepted:decision==='accepted'?{marking:'Synthetic',score:result.residual.score,operationalAcceptance:false}:null,reviewer:'نورة · مراجعة مستقلة افتراضية',review:'بعد 7 أيام افتراضية أو فور تغير المدخلات',assumptions:'Demo ordinal scale; no assumed control effectiveness, real data, or regulatory thresholds'},null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='Synthetic-risk-demo.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);set('[data-export-status]','أُنشئ ملخص Synthetic محليًا؛ لا قبول مؤسسي.');});
 const reset=root.closest('[data-lab-shell]')?.querySelector<HTMLButtonElement>('[data-lab-reset]');if(reset){reset.hidden=false;reset.addEventListener('click',()=>root.querySelector<HTMLButtonElement>('[data-reset-risk]')!.click());}
 render();
});
</script>
<style>
.rd{color:var(--color-text,#f2f4ff);padding:clamp(16px,3vw,32px);font-size:14px;line-height:1.85;overflow-wrap:anywhere}.rd *{box-sizing:border-box}.rd-head{display:flex;align-items:start;justify-content:space-between;gap:16px;flex-wrap:wrap}.rd h2{font-size:clamp(23px,3vw,32px);margin:4px 0}.rd h3{font-size:18px;margin:0 0 18px}.rd-kicker{font-size:12px;letter-spacing:.07em;color:var(--color-focus,#cbbaff)}.rd-tag{border:1px solid var(--border-strong,#53627f);border-radius:6px;padding:6px 12px;font-size:12px}.rd-flow{display:flex;flex-wrap:wrap;gap:8px 24px;list-style:none;padding:16px 0;margin:12px 0 24px;border-block:1px solid var(--border-subtle,#35415a);font-size:13px}.rd-layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(250px,.85fr);gap:20px}.rd-panel{min-width:0;padding:22px;border:1px solid var(--border-subtle,#35415a);background:var(--surface-raised,#192237);border-radius:10px;margin-bottom:16px}.rd-panel p{color:var(--color-text-muted,#c0cadd)}.rd label{display:block;margin-block:12px}.rd select{display:block;width:100%;min-height:48px;margin-top:6px;background:var(--surface-sunken,#101523);color:inherit;border:1px solid var(--border-strong,#53627f);border-radius:6px;padding:10px;font:inherit}.rd button{font:inherit;color:inherit;background:var(--surface-sunken,#101523);border:1px solid var(--border-strong,#53627f);border-radius:6px;min-height:46px;padding:10px;cursor:pointer}.rd button:disabled{opacity:.55;cursor:default}.rd :is(button,select,summary):focus-visible{outline:3px solid var(--color-focus,#cbbaff);outline-offset:3px}.rd button:hover:not(:disabled){border-color:var(--color-focus,#cbbaff)}.rd-risk{border-inline-start:2px solid var(--color-focus,#cbbaff);padding:12px}.rd-risk span,.rd-risk strong{display:block}.rd-risk strong{color:var(--color-text,#fff);font-size:18px}.rd-pair{display:grid;grid-template-columns:1fr 1fr;gap:12px}.rd-matrix{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;direction:ltr}.rd-matrix button{direction:rtl;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100px;padding:6px}.rd-matrix b{font-size:23px}.rd-matrix small{font-size:11px}.rd-matrix [data-band=مرتفع]{background:#382538;color:#ffe0eb}.rd-matrix [data-band=متوسط]{background:#342c4b;color:#e5daff}.rd-matrix [data-band=منخفض]{background:#173940;color:#c9f2f2}.rd-matrix [aria-pressed=true]{outline:2px solid currentColor;outline-offset:-4px}.rd-matrix [data-residual-cell=true]{border-bottom:4px dashed currentColor}.rd-scores>div{display:flex;flex-direction:column;border-inline-start:3px solid var(--color-focus,#cbbaff);padding:12px 16px;margin-bottom:12px;background:var(--surface-sunken,#101523)}.rd-scores strong{font-size:22px}.rd-scores span{font-size:12px}.rd dl{border-block:1px solid var(--border-subtle,#35415a);padding-block:20px}.rd dt{font-size:12px;color:var(--color-text-muted,#c0cadd)}.rd dd{margin:4px 0 16px}.rd-inspector{align-self:start}.rd-decisions{display:grid;gap:10px}.rd-decision{padding:12px;border:1px solid var(--color-focus,#cbbaff)}.rd [data-export-risk],.rd [data-reset-risk]{width:100%;margin-top:10px}.rd summary{cursor:pointer;min-height:44px;padding-block:8px}@media(max-width:1100px){.rd-layout{grid-template-columns:minmax(0,1fr)}}@media(max-width:480px){.rd-panel{padding:16px}.rd-pair{grid-template-columns:minmax(0,1fr);gap:0}.rd-matrix{gap:5px}.rd-matrix button{min-height:92px}.rd-flow{gap:8px 16px}.rd-scores strong{font-size:20px}}
</style>
