---
/**
 * WhatsAppCTA — Fixed floating WhatsApp button.
 * Real number: 966538229013 — never change.
 * Uses V3 unified design tokens with scoped styles.
 */
import { SITE } from '../data/site';

interface Props {
  lang?: 'ar' | 'en';
}

const { lang = 'ar' } = Astro.props;
const message = lang === 'ar' ? SITE.whatsapp.message.ar : SITE.whatsapp.message.en;
const whatsappUrl = `${SITE.whatsapp.goUrl}?text=${encodeURIComponent(message)}`;
---

<a
  href={whatsappUrl}
  class="whatsapp-cta"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={lang === 'ar' ? 'تواصل معنا عبر واتساب' : 'Chat with us on WhatsApp'}
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <use href="/icons.svg#mdi-whatsapp" />
  </svg>
</a>

<style>
  .whatsapp-cta {
    position: fixed;
    bottom: var(--space-6);
    inset-inline-end: var(--space-6);
    z-index: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    /* WCAG 1.4.11 Non-text Contrast (REPORTS-18): --status-success + white SVG fails.
       WhatsApp's official dark teal gives 7.24:1 against white — passes AAA.
       Identifiable as "WhatsApp green" in Saudi Arabia thanks to the brand's universal recognition.
NOTE: Tokenized in BAI-CLEAN-05 (2026-07-29) as --whatsapp-bg
        (AA-safe darker teal). Original raw hex replaced with token. */
     background: var(--whatsapp-bg);
     color: var(--white);
    box-shadow: 0 4px 16px rgba(7, 94, 84, 0.4);
    transition: transform var(--duration-fast) var(--ease-spring),
                box-shadow var(--duration-fast) var(--ease-out);
    text-decoration: none;
  }

  .whatsapp-cta svg {
    width: 28px;
    height: 28px;
  }

  .whatsapp-cta:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 24px rgba(34, 197, 94, 0.5);
  }

  .whatsapp-cta:focus-visible {
    outline: 2px solid var(--status-success);
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .whatsapp-cta {
      width: 48px;
      height: 48px;
      bottom: var(--space-4);
      inset-inline-end: var(--space-4);
    }
    .whatsapp-cta svg {
      width: 24px;
      height: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-cta {
      transition: none;
    }
    .whatsapp-cta:hover {
      transform: none;
    }
  }
</style>
