---
/**
 * WhatsAppCTA — Fixed floating WhatsApp button.
 * Real number: 966538229013 — never change.
 * Uses V3 unified design tokens with scoped styles.
 */
import { SITE } from '../data/site';

interface Props {
  lang?: 'ar' | 'en';
}

const { lang = 'ar' } = Astro.props;
const message = lang === 'ar' ? SITE.whatsapp.message.ar : SITE.whatsapp.message.en;
const whatsappUrl = `${SITE.whatsapp.url}?text=${encodeURIComponent(message)}`;
---

<a
  href={whatsappUrl}
  class="whatsapp-cta"
  target="_blank"
  rel="nofollow noopener noreferrer"
  aria-label={lang === 'ar' ? 'تواصل معنا عبر واتساب' : 'Chat with us on WhatsApp'}
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
</a>

<style>
  .whatsapp-cta {
    position: fixed;
    bottom: var(--space-6);
    inset-inline-end: var(--space-6);
    z-index: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    /* WCAG 1.4.11 Non-text Contrast (REPORTS-18): --status-success + white SVG fails.
       WhatsApp's official dark teal gives 7.24:1 against white — passes AAA.
       Identifiable as "WhatsApp green" in Saudi Arabia thanks to the brand's universal recognition.
NOTE: Tokenized in BAI-CLEAN-05 (2026-07-29) as --whatsapp-bg
        (AA-safe darker teal). Original raw hex replaced with token. */
     background: var(--whatsapp-bg);
     color: var(--white);
    box-shadow: 0 4px 16px rgba(7, 94, 84, 0.4);
    transition: transform var(--duration-fast) var(--ease-spring),
                box-shadow var(--duration-fast) var(--ease-out);
    text-decoration: none;
  }

  .whatsapp-cta svg {
    width: 28px;
    height: 28px;
  }

  .whatsapp-cta:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 24px rgba(34, 197, 94, 0.5);
  }

  .whatsapp-cta:focus-visible {
    outline: 2px solid var(--status-success);
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .whatsapp-cta {
      width: 48px;
      height: 48px;
      bottom: var(--space-4);
      inset-inline-end: var(--space-4);
    }
    .whatsapp-cta svg {
      width: 24px;
      height: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-cta {
      transition: none;
    }
    .whatsapp-cta:hover {
      transform: none;
    }
  }
</style>