---
/**
 * MarketingScripts.astro — Emits growth-stack config for consent-gated loading.
 *
 * Emits non-executable metadata only when a real ID is configured. The
 * analytics runtime loads provider scripts after explicit consent.
 *
 * Provider IDs are passed as metadata values; they are not secrets.
 *
 * Provider origins must also be allowed by CSP before scripts can execute.
 */
import { TRACKING, hasHubSpot, hasBingUet, hasMixpanel } from '../data/marketing';
---

{hasHubSpot && <meta name="brightai-hubspot-portal" content={TRACKING.hubspot} />}
{hasBingUet && <meta name="brightai-bing-uet" content={TRACKING.bingUet} />}
{hasMixpanel && <meta name="brightai-mixpanel-token" content={TRACKING.mixpanel} />}
