<script>
  // Spotlight effect — desktop only, ~20 lines vanilla JS
  (function setupSpotlight() {
    let raf = 0;
    let targetX = 0, targetY = 0, currentX = 0, currentY = 0;

    function update() {
      currentX += (targetX - currentX) * 0.15;
      currentY += (targetY - currentY) * 0.15;
      if (spotlight) {
        spotlight.style.background = `radial-gradient(300px circle at ${currentX}px ${currentY}px, rgba(34,211,238,0.08), transparent 70%)`;
      }
      if (Math.abs(targetX - currentX) > 0.5 || Math.abs(targetY - currentY) > 0.5) {
        raf = requestAnimationFrame(update);
      } else {
        raf = 0;
      }
    }

    let hero: HTMLElement | null = null;
    let spotlight: HTMLElement | null = null;

    function init() {
      hero = document.querySelector('.split-hero');
      spotlight = document.querySelector('.split-hero__spotlight');
      if (!hero || !spotlight || !window.matchMedia('(min-width: 768px)').matches) return;

      const heroEl = hero;
      const spotlightEl = spotlight;
      heroEl.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = heroEl.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;
        if (!raf) raf = requestAnimationFrame(update);
      });
      heroEl.addEventListener('mouseleave', () => {
        spotlightEl.style.background = 'transparent';
      });
    }

    function destroy() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      hero = null;
      spotlight = null;
    }

    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', destroy);
  })();
</script>

<script>
  // Kernel panel 3D tilt — vanilla JS, max 6deg, respects prefers-reduced-motion.
  // ~0.4KB minified. Skipped entirely on touch devices.
  (function setupTilt() {
    let panel: HTMLElement | null = null;
    let raf = 0;
    let tx = 0, ty = 0;

    function apply() {
      if (panel) {
        panel.style.setProperty('--tilt-x', tx.toFixed(3));
        panel.style.setProperty('--tilt-y', ty.toFixed(3));
      }
      raf = 0;
    }
    function onMove(e: MouseEvent) {
      if (!panel) return;
      const r = panel.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;
      // clamp to [-1, 1], multiply by 6deg in CSS
      tx = Math.max(-1, Math.min(1, (x - 0.5) * 2));
      ty = Math.max(-1, Math.min(1, (y - 0.5) * 2));
      if (!raf) raf = requestAnimationFrame(apply);
    }
    function reset() {
      tx = 0; ty = 0;
      if (!raf) raf = requestAnimationFrame(apply);
    }

    function init() {
      // Gate 1 — reduced motion: no tilt at all
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // Gate 2 — coarse pointer (touch): no hover, skip
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      // Gate 3 — narrow viewports: skip (mobile CSS already disables via transform)
      if (!window.matchMedia('(min-width: 768px)').matches) return;

      panel = document.querySelector('.home-kernel-panel');
      if (!panel) return;
      const el = panel;
      el.addEventListener('mousemove', onMove, { passive: true });
      el.addEventListener('mouseleave', reset, { passive: true });
    }

    function destroy() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      if (panel) {
        panel.removeEventListener('mousemove', onMove);
        panel.removeEventListener('mouseleave', reset);
        panel.style.removeProperty('--tilt-x');
        panel.style.removeProperty('--tilt-y');
      }
      panel = null;
    }

    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', destroy);
  })();
</script>

<script>
  // Hero chip word rotator — founder request (2026-07-08).
  // يبدّل بين "AI Governance Platform" و "AI Audit Trail" كل 2800ms بـ fade.
  // يحترم prefers-reduced-motion (يوقف الدوران ويعرض الكلمة الأولى).
  // cleanup على astro:before-swap عشان view-transitions ما يكدّس intervals.
  (function setupChipRotate() {
    const ROTATE_MS = 2800;
    const TRANSITION_MS = 450; // يطابق transition في CSS
    let timer: number | null = null;
    let words: HTMLElement[] = [];
    let activeIdx = 0;

    function tick() {
      if (words.length < 2) return;
      const current = words[activeIdx];
      const next = words[(activeIdx + 1) % words.length];
      if (!current || !next) return;
      current.classList.remove('is-active');
      // ننتظر transition يخلص قبل ما نضيف للكلمة الجاية
      // (CSS transition على الكلمة اللي طافت يخلص ضمن TRANSITION_MS)
      window.setTimeout(() => {
        next.classList.add('is-active');
        activeIdx = (activeIdx + 1) % words.length;
      }, TRANSITION_MS);
    }

    function init() {
      // Gate 1 — reduced motion: نخلي الكلمة الأولى فقط بدون أي دوران
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const container = document.querySelector<HTMLElement>('[data-hero-chip-rotate]');
      if (!container) return;
      words = Array.from(container.querySelectorAll<HTMLElement>('.split-hero__chip-word'));
      if (words.length < 2) return;

      // نبدأ بكلمة activeIdx = 0 (الـ HTML الأولية)
      activeIdx = 0;
      timer = window.setInterval(tick, ROTATE_MS);
    }

    function destroy() {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
      words = [];
    }

    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', destroy);
  })();
</script>

