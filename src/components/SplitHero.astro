<!-- BAI-VOC-001-A (2026-07-18): VOC injection في H1 + lead — أضفنا 5 ركائز (جرد AI، مالك مسؤول، سجل مخاطر، أدلة جاهزة للتدقيق، إشراف بشري) مع الحفاظ على الـ keywords (حوكمة الذكاء الاصطناعي / الشركات السعودية). tone = "يدعم الجاهزية" بدل "متوافق/مضمون". -->
<!-- BAI-VOC-001-C (2026-07-18): توحيد CTAs حسب intent — primary=MOFU "احجز جلسة جاهزية 30 دقيقة" → /contact/، whatsapp=BOFU "احصل على رد سريع" → wa.me، solution/kernel=TOFU "استكشف/جرّب". microcopy موحّد أسفل الأزرار: "بدون التزام • سرية بياناتك مضمونة". href/action لم يتغير. -->
---
/**
 * SplitHero.astro — Premium split-layout hero.
 *
 * Design intent: Faithful production-safe adaptation of the
 * 21st.dev "serafim/splite" split/Spline-inspired hero pattern.
 *
 * Architecture:
 *   - Left column: Server-rendered hero text, CTAs, trust chip (SSR, SEO-safe)
 *   - Right column: Kernel showcase panel (SSR, interactive links)
 *   - Background layer: dotted-surface vanilla JS canvas (interactive
 *     dotted grid, 21st.dev inspired) hydrated lazily via client:visible
 *
 * Content Preservation Rule:
 *   This component preserves EXACTLY the same hero text, CTAs, links,
 *   trust chip, and semantic structure as the original SparklesHero.
 *   Only the visual/technical implementation changed.
 *
 * Performance:
 *   - Hero text is 100% server-rendered — no hydration needed for LCP
 *   - HeroVisual uses client:visible (lazy hydration)
 *   - Respects prefers-reduced-motion (static poster)
 *   - Mobile: reduced particle count, no connection lines
 *   - DPR capped at 2, fps throttled on low-power devices
 *   - Pauses when off-screen or tab hidden
 *
 * RTL: Layout flows naturally with logical properties (inset-inline, etc.)
 */

import BrightStar from './brand/BrightStar.astro';
---

<section class="split-hero" aria-label="BrightAI الرئيسية">
  {/* ─── Interactive Dotted-Surface (vanilla JS canvas — REPORTS-20)
        Replaces the prior DottedSurface React island. Removes the React
        renderer payload (~185KB raw / ~58KB gzipped) from the homepage
        critical path. The canvas stays inert until JS hydrates
        src/scripts/dotted-surface.js via astro:page-load. CSS controls
        the ambient opacity/positioning; the script handles pointer
        interaction and frame timing. ─── */}
  <div class="split-hero__visual" aria-hidden="true">
    <canvas class="dotted-surface-canvas"></canvas>
  </div>

  {/* ─── Gradient beam accents (pure CSS, enhanced) ─── */}
  <div class="split-hero__beams" aria-hidden="true">
    <div class="split-hero__beam split-hero__beam--wide-blur"></div>
    <div class="split-hero__beam split-hero__beam--wide"></div>
    <div class="split-hero__beam split-hero__beam--narrow-blur"></div>
    <div class="split-hero__beam split-hero__beam--narrow"></div>
  </div>

  {/* ─── Mouse-following spotlight (desktop only, CSS-driven) ─── */}
  <div class="split-hero__spotlight" aria-hidden="true"></div>

  {/* ─── Vignette overlay for text legibility ─── */}
  <div class="split-hero__vignette" aria-hidden="true"></div>

  {/* ─── Hero Content Grid ─── */}
  <div class="split-hero__grid">

    {/* Left Column — Main Hero Content */}
    <div class="split-hero__main">
      {/* ─── THE STAR — single visual identity for BrightAI ───
            Sits at the top of the main column, directly above the H1.
            Decorative (aria-hidden) — the heading carries the verbal story.
            On the homepage hero, this is the visual that people remember. */}
      <div class="split-hero__star-wrap" data-priority="hero-visual">
        <BrightStar variant="hero" size={300} decorative={true} className="split-hero__star" />
      </div>

      {/* Animated chip — يبدّل بين "AI Governance Platform" و "AI Audit Trail" كل 2.8 ثانية.
         طلب المؤسس: استبدال النص الثابت بمحتوى متحرك يعرض أهم منتجين في المنصة.
         يحترم prefers-reduced-motion (يعرض الكلمة الأولى بدون دوران). */}
      <span class="chip split-hero__chip" data-hero-chip-rotate>
        <span class="split-hero__dot pulse-dot" aria-hidden="true"></span>
        <span class="split-hero__chip-words" aria-live="polite" aria-atomic="true">
          <span class="split-hero__chip-word is-active">AI Governance Platform</span>
          <span class="split-hero__chip-word" aria-hidden="true">AI Audit Trail</span>
        </span>
      </span>

      <div class="split-hero__title-wrap">
        {/* REPORTS-SEO-KEYWORDS-2026-07-08: H1 rewritten to lead with the canonical
            Saudi search term "حوكمة الذكاء الاصطناعي" verbatim (was previously
            "منصة أمان وحوكمة" + "الذكاء الاصطناعي" on a separate line, which
            left the two anchor words split across visual lines).
            Visual structure preserved: gradient on the keyword span, plain
            text for the location phrase. Saudi dialect untouched.
            BAI-VOC-001-A (2026-07-18): appended "بجرد AI ومالك مسؤول" as a
            plain (non-gradient) suffix to inject 2 VOC pillars (AI inventory
            + accountable owner) into the H1 while preserving the keyword
            anchors (حوكمة الذكاء الاصطناعي / الشركات السعودية). tone is
            "يدعم الجاهزية" — no "مضمون/كامل" claims. */}
        <h1 id="hero-title" class="split-hero__h1" transition:animate="fade">
          <span class="gradient-text">حوكمة الذكاء الاصطناعي</span>
          للشركات
          <span class="gradient-text">السعودية</span>
          <span class="split-hero__h1-voc" style="display:block; font-size:0.42em; font-weight:500; color:var(--text-secondary); margin-top:0.4em; letter-spacing:-0.005em; line-height:1.4;">بجرد AI ومالك مسؤول — Saudi AI Safety OS</span>
        </h1>
      </div>

      <p class="split-hero__lead">
        <strong>BrightAI</strong> تقدم <strong class="text-white">Saudi AI Safety OS</strong>:
        <strong class="text-white">نواة أمان وتشغيل</strong> تدخل بين الموظف والـ AI وبيانات الشركة،
        وتضمن إن كل طلب ذكاء اصطناعي يكون
        <span class="text-white">آمن، موثّق، وقابل للمراجعة</span>.
        {/* BAI-VOC-001-A (2026-07-18): 3 additional VOC pillars injected into
            the lead paragraph (AI risk register + audit-ready evidence +
            human oversight). Combined with the H1 suffix, the hero now
            carries all 5 VOC pillars required by the task. */}
        تساعد المنشأة على تشغيل <strong class="text-white">سجل مخاطر</strong> محدّث،
        و<strong class="text-white">أدلة جاهزة للتدقيق</strong>، مع
        <strong class="text-white">إشراف بشري</strong> على القرارات عالية المخاطر.
      </p>

      <div class="home-hero-actions">
        <a href="https://wa.me/966538229013" target="_blank" rel="nofollow noopener noreferrer" class="wa-btn"
           data-whatsapp data-cta-label="احصل على رد سريع عبر واتساب" data-position="hero" data-page-type="home">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-whatsapp"></use></svg> احصل على رد سريع عبر واتساب
        </a>
        <a href="/contact/" class="home-cta-primary"
           data-cta="hero_cta_click" data-cta-label="احجز جلسة جاهزية 30 دقيقة" data-position="hero" data-page-type="home" data-offer="assessment">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-calendar-check"></use></svg>
          <span>احجز جلسة جاهزية 30 دقيقة</span>
        </a>
        <a href="/solutions/ai-governance-platform/" class="home-cta-secondary"
           data-cta="hero_cta_click" data-cta-label="استكشف منصة الحوكمة" data-position="hero" data-page-type="home" data-persona="CISO">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-scale-balance"></use></svg>
          <span>استكشف منصة الحوكمة</span>
        </a>
        <a href="/kernel/" class="home-cta-secondary"
           data-cta="hero_cta_click" data-cta-label="جرّب Kernel — 8 دقائق" data-position="hero" data-page-type="home" data-persona="CIO">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-gauge"></use></svg>
          <span>جرّب Kernel — 8 دقائق</span>
        </a>
      </div>
      <small class="cta-micro cta-micro--inverse" aria-hidden="true">بدون التزام • سرية بياناتك مضمونة • يردّك فريق سعودي</small>
    </div>

    {/* Right Column — Kernel Showcase */}
    <aside class="home-kernel-showcase" aria-labelledby="kernel-demo-title">
      <div class="home-kernel-panel">
        <div class="home-kernel-bar">
          <div class="home-kernel-dots"><span style="--dot:var(--status-danger)"></span><span style="--dot:var(--status-warning)"></span><span style="--dot:var(--status-success)"></span></div>
          <span class="home-kernel-path">brightai.site/kernel</span>
        </div>
        <div class="home-kernel-body">
          <span class="home-kernel-badge">
            <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-lock-open-variant"></use></svg>
            نموذج تجريبي مجاني للشركات
          </span>
          <h2 class="home-kernel-title" id="kernel-demo-title">جرّب BrightAI Kernel كأنك داخل غرفة تشغيل شركتك</h2>
          <p class="home-kernel-copy">
            تدخل التجربة، ترسل طلبات عمل واقعية، وتشوف كيف الـ Kernel يحمي البيانات الحساسة، يطبق السياسات،
            يوقف القرارات العالية المخاطر للموافقة، ويوثق كل خطوة بدليل واضح يصلح لفريق الأمن والامتثال.
          </p>
          <div class="home-kernel-actions">
            <a href="/kernel/" class="home-kernel-action home-kernel-action--primary"
               data-cta="hero_cta_click" data-cta-label="ابدأ تجربة Kernel المجانية" data-position="kernel_demo" data-page-type="home" data-persona="CIO" data-offer="pilot">
              <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-gauge"></use></svg>
              <span>ابدأ تجربة Kernel المجانية</span>
            </a>
            <a href="/kernel/chat/" class="home-kernel-action home-kernel-action--secondary"
               data-cta="hero_cta_click" data-cta-label="اختبر المحادثة الآمنة" data-position="kernel_demo" data-page-type="home" data-persona="CIO">
              <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-message-text"></use></svg>
              <span>اختبر المحادثة الآمنة</span>
            </a>
          </div>
          <small class="cta-micro cta-micro--inverse" aria-hidden="true">بدون تسجيل • 8 دقائق • Sandbox معزول</small>
        </div>
      </div>

      <div class="home-kernel-features" aria-labelledby="kernel-features-title">
        <div class="home-kernel-feature-header">
          <h2 id="kernel-features-title">وش تقدر تجرّب؟</h2>
          <p>كل مسار هنا يوريك جزء من اللي نقدمه للشركات قبل ربطه بأنظمتها الفعلية.</p>
          <span class="home-kernel-feature-count">10 مزايا</span>
        </div>
        <div class="home-kernel-feature-grid">
          <a href="/kernel/" class="home-kernel-feature-link" style="--i:0"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-gauge"></use></svg></span><span><span class="home-kernel-feature-title">لوحة تشغيل واحدة</span><span class="home-kernel-feature-copy">حالة النواة، الطلبات، المخاطر، وآخر الأحداث من مكان واحد.</span></span></a>
          <a href="/kernel/chat/" class="home-kernel-feature-link" style="--i:1"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-message-text"></use></svg></span><span><span class="home-kernel-feature-title">محادثة آمنة</span><span class="home-kernel-feature-copy">اسأل النموذج، والـ Kernel يفحص البيانات والسياسات قبل الرد.</span></span></a>
          <a href="/kernel/audit/" class="home-kernel-feature-link" style="--i:2"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-file-lock"></use></svg></span><span><span class="home-kernel-feature-title">سجل تدقيق كامل</span><span class="home-kernel-feature-copy">كل طلب وقرار محفوظ بتوقيت، درجة مخاطر، وهاش قابل للمراجعة.</span></span></a>
          <a href="/kernel/evidence/" class="home-kernel-feature-link" style="--i:3"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-folder-open"></use></svg></span><span><span class="home-kernel-feature-title">ملف أدلة</span><span class="home-kernel-feature-copy">اجمع المدخلات والردود وسلسلة التدقيق كدليل واضح للمدقق.</span></span></a>
          <a href="/kernel/approvals/" class="home-kernel-feature-link" style="--i:4"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-account-check"></use></svg></span><span><span class="home-kernel-feature-title">موافقات بشرية</span><span class="home-kernel-feature-copy">أي قرار حساس يتوقف لين يراجعه الشخص المخول داخل الشركة.</span></span></a>
          <a href="/kernel/compliance/" class="home-kernel-feature-link" style="--i:5"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-scale-balance"></use></svg></span><span><span class="home-kernel-feature-title">متابعة الامتثال</span><span class="home-kernel-feature-copy">اربط استخدامات AI بضوابط PDPL وNCA وحزم الحوكمة السعودية.</span></span></a>
          <a href="/kernel/policies/" class="home-kernel-feature-link" style="--i:6"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-tune"></use></svg></span><span><span class="home-kernel-feature-title">محرر السياسات</span><span class="home-kernel-feature-copy">اضبط قواعد الاستخدام، الحساسية، والتصعيد بدون تعقيد تقني.</span></span></a>
          <a href="/kernel/connectors/" class="home-kernel-feature-link" style="--i:7"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-power-plug"></use></svg></span><span><span class="home-kernel-feature-title">موصلات الأنظمة</span><span class="home-kernel-feature-copy">شوف تصور ربط ERP وCRM وHIS وSharePoint بطريقة مضبوطة.</span></span></a>
          <a href="/kernel/reports/" class="home-kernel-feature-link" style="--i:8"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-chart-bar"></use></svg></span><span><span class="home-kernel-feature-title">تقارير تنفيذية</span><span class="home-kernel-feature-copy">حوّل نشاط الذكاء الاصطناعي إلى تقرير يفهمه الأمن والإدارة.</span></span></a>
          <a href="/kernel/scenarios/" class="home-kernel-feature-link" style="--i:9"><span class="home-kernel-feature-icon"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#material-symbols-account-tree"></use></svg></span><span><span class="home-kernel-feature-title">سيناريوهات واقعية</span><span class="home-kernel-feature-copy">اختبر حالات مالية، موارد بشرية، قانونية، صحية، وأمن كود.</span></span></a>
        </div>
        <p class="home-kernel-footnote">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-information"></use></svg>
          التجربة تستخدم بيانات صناعية، وإذا ناسبتكم نركب نفس الفكرة على بياناتكم وأنظمتكم الفعلية.
        </p>
      </div>
    </aside>
  </div>
</section>

<style>
  /* ─── SplitHero Container ─── */
  .split-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: transparent; /* DottedBackground shows through */
  }

  /* ─── Premium Canvas Visual Scene ─── */
  .split-hero__visual {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .dotted-surface-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    will-change: transform;
    transform: translateZ(0);
    opacity: 0.9;
  }

  /* ─── THE STAR — wraps the BrightStar.astro SVG at the top of the main column ─── */
  .split-hero__star-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto 0.5rem;
    width: 100%;
    max-width: 320px;
    z-index: 22;       /* above visual layer + spotlight, below main content text */
    pointer-events: none; /* decorative — don't block CTAs */
  }
  .split-hero__star {
    width: 100%;
    height: auto;
    /* Pull up slightly so the star visually "leads" the title, not crowds it */
    margin-top: -0.5rem;
  }
  /* Desktop: star grows slightly and gets a touch of pull-up via translateZ */
  @media (min-width: 768px) {
    .split-hero__star-wrap {
      max-width: 360px;
      margin-bottom: 0.75rem;
    }
  }
  /* Below 640px (small phones): stay compact to preserve CTA prominence */
  @media (max-width: 640px) {
    .split-hero__star-wrap {
      max-width: 230px;
      margin-bottom: 0.25rem;
    }
    .split-hero__star { margin-top: 0; }
  }

  /* On the homepage, dim the background canvas so The Star wins the visual hierarchy.
     Spotlight + beams + vignette still operate — only the dotted canvas dims. */
  @media (min-width: 768px) {
    .split-hero .dotted-surface-canvas { opacity: 0.32; }
  }

  /* ─── Gradient Beams (REPORT-09: less distraction, more directional) ───
     Directional accent: a single soft beam from the top with focused blur,
     replaced the original 4-beam clutter. Keeps the "Sovereign Calm" feel. */
  .split-hero__beams {
    position: absolute;
    top: 18%;
    inset-inline: 0;
    height: 2px;
    pointer-events: none;
    z-index: 1;
  }
  .split-hero__beam {
    position: absolute;
    top: 0;
    inset-inline-start: 50%;
    transform: translateX(-50%);
  }
  /* Soft wide beam — primary direction marker */
  .split-hero__beam--wide-blur {
    width: 60%;
    height: 40px;
    background: radial-gradient(ellipse 50% 100% at 50% 0%, rgba(42, 138, 126, 0.18), transparent 70%);
    filter: blur(2px);
    opacity: 0.7;
  }
  /* Crisp narrow accent line — the actual beam */
  .split-hero__beam--wide {
    width: 40%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(75, 166, 156, 0.7), transparent);
  }
  /* Kept narrow variants but reduced opacity (decorative depth) */
  .split-hero__beam--narrow-blur {
    width: 18%;
    height: 3px;
    background: linear-gradient(90deg, transparent, rgba(75, 166, 156, 0.35), transparent);
    filter: blur(3px);
    opacity: 0.6;
  }
  .split-hero__beam--narrow {
    display: none; /* REPORT-09: removed — was redundant and distracting */
  }

  /* ─── Spotlight (mouse-follow, desktop only) ─── */
  .split-hero__spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: transparent;
    transition: background 0.3s ease;
  }

  /* ─── Vignette overlay for text legibility ─── */
  .split-hero__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background:
      radial-gradient(ellipse 100% 80% at 30% 50%, rgba(4,7,17,0.5), transparent 70%),
      linear-gradient(180deg, transparent 0%, rgba(4,7,17,0.2) 100%);
  }
  [dir="rtl"] .split-hero__vignette {
    background:
      radial-gradient(ellipse 100% 80% at 70% 50%, rgba(4,7,17,0.5), transparent 70%),
      linear-gradient(180deg, transparent 0%, rgba(4,7,17,0.2) 100%);
  }

  /* ─── Grid Layout (7fr 5fr split) ─── */
  .split-hero__grid {
    position: relative;
    z-index: 20;
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: 3.5rem 1.25rem 5rem;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .split-hero__grid {
      grid-template-columns: 7fr 5fr;
      padding-top: 6rem;
      padding-bottom: 7rem;
    }
  }

  /* ─── Main Column ─── */
  .split-hero__main {
    text-align: center;
    position: relative;
    z-index: 21;
  }
  @media (min-width: 1024px) {
    .split-hero__main {
      text-align: start;
    }
  }

  /* Chip — refined for SaaS polish */
  .split-hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4375rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    background: rgba(42, 138, 126, 0.08);   /* DEC-SovB-001: Teal */
    border: 1px solid rgba(59, 163, 149, 0.25);   /* brand-400 Teal */
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    position: relative;
    z-index: 21;
  }
  .split-hero__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--emerald-bright);
    display: inline-block;
  }

  /* Animated chip words — يبدّل بين كلمتين بـ fade + slide-up.
     الكلمة الفعّالة relative + opacity 1 (تأخذ مساحة),
     الكلمات الباقية absolute + opacity 0 فوقها. */
  .split-hero__chip-words {
    position: relative;
    display: inline-block;
    min-width: 13ch;   /* يحجز عرض ثابت أطول من "AI Audit Trail" عشان ما يرتجف الـ chip */
    text-align: start;
