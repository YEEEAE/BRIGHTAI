---
/**
 * Schema — Foundation schema.org JSON-LD for BrightAI.
 *
 * PURPOSE (REPORTS-SEO-FOUNDATION, 2026-07-07):
 *   Single source of truth for the **foundation** structured data that every
 *   page in the BrightAI site must emit. Composed of:
 *     1. Organization    — company identity, postal address, contact
 *     2. WebSite         — site identity + SearchAction for sitelinks searchbox
 *     3. LocalBusiness   — Riyadh office (geo.region SA-01)
 *     4. BreadcrumbList  — when crumbs are provided
 *
 * VALUES PRESERVED FROM EXISTING SCHEMA:
 *   - postalCode = "14254"     (السجل الرسمي — شركة سعودية الرياض الفيحاء)
 *   - foundingDate = "2025"    (سنة التأسيس — confirmed by founder 2026-07-07)
 *   - telephone = "+966538229013"
 *   - whatsapp  = https://wa.me/966538229013
 *   - addressLocality = "الرياض"
 *   - region = "منطقة الرياض"
 *   - country = "SA"
 *
 * The component emits **additive** schema nodes — pages may pass additional
 * schema via the `extra` prop and they will be merged into a single @graph
 * to avoid duplicate <script type="application/ld+json"> blocks.
 *
 * CONSTRAINTS:
 *   - No fabricated data. Every field reflects real published content.
 *   - Saudi dialect preserved verbatim in any string we own.
 *   - If a verified ID is empty (clarityId, bingVerification), it is omitted.
 */
import { SITE } from '../../data/site';

export interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  /**
   * Optional extra schema nodes (FAQPage, Service, Article, HowTo, …).
   * Will be merged into the foundation @graph.
   */
  extra?: Array<Record<string, unknown> | null | undefined>;
  /**
   * Breadcrumb items (without the home crumb — added automatically).
   * Provide items in display order; the last one is the current page.
   */
  breadcrumbs?: BreadcrumbItem[];
  /**
   * Canonical absolute URL of the current page. Used in BreadcrumbList
   * and the foundation WebPage node (speakable for AI voice answer engines).
   */
  canonical?: string;
  /**
   * Optional page title. Used by the foundation WebPage node.
   * If omitted, falls back to SITE.name.
   */
  pageTitle?: string;
  /**
   * Optional page description. Used by the foundation WebPage node.
   * If omitted, falls back to SITE.description.
   */
  pageDescription?: string;
  /**
   * Optional language code (defaults to 'ar-SA'). Used by the WebPage node.
   */
  language?: string;
}

const { extra = [], breadcrumbs = [], canonical, pageTitle, pageDescription, language = 'ar-SA' } = Astro.props;

// ─── Foundation nodes ───────────────────────────────────────────────────────

const organization = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  alternateName: SITE.nameAr,
  legalName: 'BrightAI',
  url: SITE.url,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE.url}/assets/images/logo.png`,
    width: 200,
    height: 55,
    caption: 'شعار BrightAI',
  },
  description:
    'BrightAI شركة سعودية متخصصة في حوكمة وأمان وتشغيل الذكاء الاصطناعي للمؤسسات في السعودية — Saudi AI Safety OS.',
  foundingDate: '2025',
  founder: {
    '@type': 'Person',
    '@id': `${SITE.url}/#founder`,
    name: 'يزيد',
    jobTitle: 'المؤسس والمدير التنفيذي',
    worksFor: { '@id': `${SITE.url}/#organization` },
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'الرياض',
      addressCountry: 'SA',
    },
    sameAs: ['https://www.linkedin.com/in/yazeed-brightai'],
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '6913 المبارك بن فضالة، حي الفيحاء',
    addressLocality: 'الرياض',
    addressRegion: 'منطقة الرياض',
    postalCode: '14254',
    addressCountry: 'SA',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: '+966538229013',
      contactType: 'customer support',
      contactOption: 'WhatsApp',
      url: SITE.whatsapp.url,
      areaServed: 'SA',
      availableLanguage: ['Arabic', 'English'],
    },
  ],
  areaServed: [
    { '@type': 'Country', name: 'المملكة العربية السعودية' },
    { '@type': 'City', name: 'الرياض' },
    { '@type': 'City', name: 'جدة' },
    { '@type': 'City', name: 'الدمام' },
    { '@type': 'City', name: 'الخبر' },
    { '@type': 'City', name: 'مكة المكرمة' },
    { '@type': 'City', name: 'المدينة المنورة' },
  ],
  sameAs: [
    'https://linkedin.com/company/brightai-site',
    'https://x.com/BrightAISite',
    'https://www.youtube.com/@BrightAiSaudi',
    'https://www.tiktok.com/@bright1ai',
    'https://github.com/brightai-site',
    'https://wa.me/966538229013',
  ],
  knowsAbout: [
    'الذكاء الاصطناعي',
    'AI Governance',
    'AI Safety',
    'PDPL Compliance',
    'NCA ECC Controls',
    'SDAIA Generative AI Guidelines',
    'ISO/IEC 42001',
    'ISO/IEC 27001',
    'SFDA Medical Quality',
    'ZATCA',
    'SAMA',
    'حوكمة الذكاء الاصطناعي في السعودية',
  ],
  knowsLanguage: ['ar-SA', 'en-SA'],
  slogan: SITE.tagline,
  brand: {
    '@type': 'Brand',
    name: SITE.name,
    slogan: SITE.tagline,
  },
} as const;

const website = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  alternateName: SITE.nameAr,
  publisher: { '@id': `${SITE.url}/#organization` },
  inLanguage: ['ar-SA', 'en-SA'],
  // SearchAction — enables sitelinks searchbox in Google SERPs.
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE.url}/search?q={search_term_string}`,
    },
    // query-input schema: "required name=search_term_string"
    'query-input': 'required name=search_term_string',
  },
} as const;

// LocalBusiness — Riyadh HQ (geo.region SA-01)
const localBusiness = {
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': `${SITE.url}/#localbusiness-riyadh`,
  name: 'BrightAI — حوكمة AI في الرياض',
  description:
    'مكتب BrightAI الرئيسي في الرياض — حوكمة وأمان وتشغيل الذكاء الاصطناعي للمؤسسات السعودية. متوافق مع PDPL وNCA ECC. لا يُعد استشارة قانونية.',
  url: SITE.url,
  telephone: '+966538229013',
  image: `${SITE.url}/assets/images/og/brightai-og-1200x630.png`,
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '6913 المبارك بن فضالة، حي الفيحاء',
    addressLocality: 'الرياض',
    addressRegion: 'منطقة الرياض',
    postalCode: '14254',
    addressCountry: 'SA',
  },
  geo: {
    '@type': 'GeoCoordinates',
    // Riyadh city centre (public knowledge, mirrored in schema-helpers.ts)
    latitude: 24.7136,
    longitude: 46.6753,
  },
  areaServed: [
    { '@type': 'Country', name: 'المملكة العربية السعودية' },
    { '@type': 'City', name: 'الرياض' },
    { '@type': 'City', name: 'جدة' },
    { '@type': 'City', name: 'الدمام' },
    { '@type': 'City', name: 'الخبر' },
    { '@type': 'City', name: 'مكة المكرمة' },
    { '@type': 'City', name: 'المدينة المنورة' },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
      opens: '08:00',
      closes: '17:00',
    },
  ],
  currenciesAccepted: 'SAR',
  paymentAccepted: 'Cash, Credit Card, Bank Transfer',
  parentOrganization: { '@id': `${SITE.url}/#organization` },
} as const;

// ─── Breadcrumbs (optional) ─────────────────────────────────────────────────

const allCrumbs: BreadcrumbItem[] = [
  { name: 'الرئيسية', href: '/' },
  ...breadcrumbs,
];

const breadcrumbList = allCrumbs.length > 1
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: allCrumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: c.href.startsWith('http') ? c.href : `${SITE.url}${c.href}`,
      })),
    }
  : null;

// ─── Compose @graph ─────────────────────────────────────────────────────────

// REPORTS-SEO-FOUNDATION (2026-07-07): foundation WebPage node. Emits
// `speakable` on every page so the site-wide Speakable audit (≥30 pages
// required for AI voice / TTS eligibility) passes automatically. The
// cssSelector `h1` is universal — every page in BrightAI has exactly one
// <h1>, so the schema validates against real visible HTML on every URL.
const pageWebPage = canonical
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageTitle || SITE.name,
      description:
        pageDescription ||
        'BrightAI — Saudi AI Safety OS، حوكمة وأمان وتشغيل الذكاء الاصطناعي للمؤسسات في السعودية.',
      inLanguage: language,
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${SITE.url}/#organization` },
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1'],
      },
    }
  : null;

const graph = [
  organization,
  website,
  localBusiness,
  pageWebPage,
  breadcrumbList,
  ...extra,
].filter((n): n is Record<string, unknown> => Boolean(n));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<script
  id="brightai-foundation-schema"
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
/>