---
/**
 * Schema — Foundation schema.org JSON-LD for BrightAI.
 *
 * PURPOSE (REPORTS-SEO-FOUNDATION, 2026-07-07 + BAI-SEO-003-S3, 2026-07-18):
 *   Single source of truth for the **foundation** structured data that every
 *   page in the BrightAI site must emit. Composed of:
 *     1. Organization    — company identity, postal address, contact
 *     2. WebSite         — site identity (SearchAction removed: no /search route)
 *     3. LocalBusiness   — Riyadh office (geo.region SA-01)
 *     4. BreadcrumbList  — when crumbs are provided
 *
 * VALUES PRESERVED FROM EXISTING SCHEMA:
 *   - streetAddress = "رويغب الفيحاء"  (العنوان الموحد — الرياض، رويغب الفيحاء؛ confirmed by founder 2026-08-23)
 *   - foundingDate = "2025"    (سنة التأسيس — confirmed by founder 2026-07-07)
 *   - telephone = "+966538229013"
 *   - whatsapp  = https://wa.me/966538229013
 *   - addressLocality = "الرياض"
 *   - region = "منطقة الرياض"
 *   - country = "SA"
 *
 * BAI-SEO-003-S3 CHANGES:
 *   - Organization node is now imported from src/data/schema-helpers.ts
 *     (ORGANIZATION constant) so Schema.astro and page-level code share
 *     ONE source of truth — no more drift between the two copies.
 *   - `sameAs` no longer includes the WhatsApp number (wa.me is a contact
 *     channel, not a social identity profile). Verified social profiles only.
 *   - WebSite `potentialAction` (SearchAction) removed: there is no live
 *     `/search` route in the build, and emitting a SearchAction that points
 *     to a 404 violates Google's sitelinks searchbox guidelines.
 *   - `knowsLanguage` is preserved as `['ar-SA', 'en-SA']` to match the
 *     bilingual content surface.
 *
 * The component emits **additive** schema nodes — pages may pass additional
 * schema via the `extra` prop and they will be merged into a single @graph
 * to avoid duplicate <script type="application/ld+json"> blocks.
 *
 * CONSTRAINTS:
 *   - No fabricated data. Every field reflects real published content.
 *   - Saudi dialect preserved verbatim in any string we own.
 *   - If a verified ID is empty (clarityId, bingVerification), it is omitted.
 */
import { SITE } from '../../data/site';
import { ORGANIZATION } from '../../data/schema-helpers';

export interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  /**
   * Optional extra schema nodes (FAQPage, Service, Article, HowTo, …).
   * Will be merged into the foundation @graph.
   */
  extra?: Array<Record<string, unknown> | null | undefined>;
  /**
   * BAI-VOC-001-B (2026-07-18): extra cssSelector entries to add to the
   * foundation WebPage `speakable` node alongside the universal `h1`.
   * Pages can opt in by passing class names that match visible content
   * (e.g. an answer-first summary block). Each entry MUST match a real
   * visible element on the page — `check-speakable-schema.mjs` validates.
   * Default is `[]` so the existing 419-page audit (≥30 pages) keeps
   * passing without any caller changes.
   */
  extraSpeakableSelectors?: string[];
  /**
   * Breadcrumb items (without the home crumb — added automatically).
   * Provide items in display order; the last one is the current page.
   */
  breadcrumbs?: BreadcrumbItem[];
  /**
   * Canonical absolute URL of the current page. Used in BreadcrumbList
   * and the foundation WebPage node (speakable for AI voice answer engines).
   */
  canonical?: string;
  /**
   * Optional page title. Used by the foundation WebPage node.
   * If omitted, falls back to SITE.name.
   */
  pageTitle?: string;
  /**
   * Optional page description. Used by the foundation WebPage node.
   * If omitted, falls back to SITE.description.
   */
  pageDescription?: string;
  /**
   * Optional language code (defaults to 'ar-SA'). Used by the WebPage node.
   */
  language?: string;
  /**
   * When true, the foundation LocalBusiness / ProfessionalService node is
   * omitted from the @graph. Used by product-style pages (e.g. /kernel/*)
   * where a SoftwareApplication is the primary entity and a nested
   * LocalBusiness confuses schema validators (Semrush Issue #45).
   * Pages that genuinely benefit from LocalBusiness (/contact/, /about/,
   * the homepage) keep it by leaving this false.
   */
  omitLocalBusiness?: boolean;
}

const { extra = [], breadcrumbs = [], canonical, pageTitle, pageDescription, language = 'ar-SA', omitLocalBusiness = false, extraSpeakableSelectors = [] } = Astro.props;

// ─── Foundation nodes ───────────────────────────────────────────────────────

/**
 * BAI-SEO-003-S3 (2026-07-18): import Organization from the shared
 * `schema-helpers` module instead of redeclaring it. This is the SINGLE
 * source of truth for the BrightAI Organization @id — every page in the
 * site now references the EXACT same node, eliminating duplicate @id
 * warnings in Schema.org validators.
 */
const organization = ORGANIZATION;

const website = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  alternateName: SITE.nameAr,
  publisher: { '@id': `${SITE.url}/#organization` },
  inLanguage: ['ar-SA', 'en-SA'],
  // BAI-SEO-003-S3 (2026-07-18): SearchAction removed. There is no live
  // `/search` route in the build (verified 2026-07-18 — no /search dir
  // under src/pages, no /search/index.html in dist). Emitting a SearchAction
  // to a 404 URL violates Google's sitelinks searchbox policy and is a
  // soft-spam signal. Re-add ONLY when a real /search route ships.
} as const;

// LocalBusiness — Riyadh HQ (geo.region SA-01)
const localBusiness = {
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': `${SITE.url}/#localbusiness-riyadh`,
  name: 'BrightAI — حوكمة AI في الرياض',
  description:
    `${SITE.descriptionAr} مقر التواصل في الرياض. تدعم BrightAI الجاهزية التشغيلية للامتثال ولا تُعد استشارة قانونية.`,
  url: SITE.url,
  telephone: '+966538229013',
  image: `${SITE.url}/assets/images/og/brightai-og-1200x630.png`,
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'رويغب الفيحاء',
    addressLocality: 'الرياض',
    addressRegion: 'منطقة الرياض',
    addressCountry: 'SA',
  },
  geo: {
    '@type': 'GeoCoordinates',
    // Riyadh city centre (public knowledge, mirrored in schema-helpers.ts)
    latitude: 24.7136,
    longitude: 46.6753,
  },
  areaServed: [
    { '@type': 'Country', name: 'المملكة العربية السعودية' },
    { '@type': 'City', name: 'الرياض' },
    { '@type': 'City', name: 'جدة' },
    { '@type': 'City', name: 'الدمام' },
    { '@type': 'City', name: 'الخبر' },
    { '@type': 'City', name: 'مكة المكرمة' },
    { '@type': 'City', name: 'المدينة المنورة' },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
      opens: '08:00',
      closes: '17:00',
    },
  ],
  currenciesAccepted: 'SAR',
  paymentAccepted: 'Cash, Credit Card, Bank Transfer',
  parentOrganization: { '@id': `${SITE.url}/#organization` },
} as const;

// ─── Breadcrumbs (optional) ─────────────────────────────────────────────────

const allCrumbs: BreadcrumbItem[] = [
  { name: 'الرئيسية', href: '/' },
  ...breadcrumbs,
];

const breadcrumbList = allCrumbs.length > 1
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: allCrumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: c.href.startsWith('http') ? c.href : `${SITE.url}${c.href}`,
      })),
    }
  : null;

// ─── Compose @graph ─────────────────────────────────────────────────────────

// REPORTS-SEO-FOUNDATION (2026-07-07): foundation WebPage node. Emits
// `speakable` on every page so the site-wide Speakable audit (≥30 pages
// required for AI voice / TTS eligibility) passes automatically. The
// cssSelector `h1` is universal — every page in BrightAI has exactly one
// <h1>, so the schema validates against real visible HTML on every URL.
//
// BAI-VOC-001-B (2026-07-18): P0 pages can extend the selector with
// `extraSpeakableSelectors` (e.g. `.answer-first-summary`) to also
// tag the answer-first summary block for AI voice / TTS. The array is
// sanitised: empty strings and duplicates are dropped to keep the
// schema tidy and to satisfy `check-speakable-schema.mjs`.
const sanitisedExtraSelectors = Array.from(
  new Set(extraSpeakableSelectors.filter((s) => typeof s === 'string' && s.trim().length > 0))
);

const pageWebPage = canonical
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageTitle || SITE.name,
      description:
        pageDescription ||
        SITE.descriptionAr,
      inLanguage: language,
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${SITE.url}/#organization` },
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', ...sanitisedExtraSelectors],
      },
    }
  : null;

const graph = [
  organization,
  website,
  // SEMRUSH-FIX-2026-07-08 (#45): omit LocalBusiness on product-style pages
  // (e.g. /kernel/*) so a SoftwareApplication primary entity is not confused
  // by a sibling LocalBusiness/ProfessionalService node.
  omitLocalBusiness ? null : localBusiness,
  pageWebPage,
  breadcrumbList,
  ...extra,
].filter((n): n is Record<string, unknown> => Boolean(n));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<script
  id="brightai-foundation-schema"
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
/>
