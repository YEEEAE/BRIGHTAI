---
/**
 * ActivityStream — Audit trail events for /kernel/audit/.
 * Visible without JS. CSS-only subtle animation with reduced-motion fallback.
 */
import KernelBadge from './kernel/KernelBadge.astro';
import { activityEvents, riskLevelClass, riskLevelLabel } from '../data/kernel';
import type { ActivityEvent } from '../data/kernel';

interface Props { events?: ActivityEvent[] }
const { events = activityEvents } = Astro.props;
---

<style>
  .k-timeline { list-style: none; padding: 0; margin: 0; }
  .k-timeline__item {
    position: relative;
    padding-block: var(--space-4);
    padding-inline: var(--space-5) var(--space-8);
    border-bottom: 1px solid var(--border);
  }
  .k-timeline__item::before {
    content: '';
    position: absolute;
    inset-inline-start: 1rem;
    top: 1.35rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }
  .k-timeline__item.k-risk--minimal::before { background: var(--status-success); }
  .k-timeline__item.k-risk--low::before { background: #3b82f6; }      /* blue-500 — no token match, kept as hex */
  .k-timeline__item.k-risk--medium::before { background: var(--status-warning); }
  .k-timeline__item.k-risk--high::before { background: var(--status-danger); }
  .k-timeline__item.k-risk--critical::before { background: var(--status-danger); }
  .k-timeline__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
  }
  .k-timeline__type {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--text);
  }
  .k-timeline__desc {
    font-size: var(--text-sm);
    color: var(--text-soft);
    line-height: var(--leading-normal);
  }
  .k-timeline__time {
    font-size: var(--text-xs);
    color: var(--text-faint);
    margin-top: var(--space-1-5);
  }
  .k-timeline__demo {
    display: inline-block;
    font-size: 0.625rem;
    color: var(--text-faint);
    background: var(--glass);
    border-radius: var(--radius-xs);
    padding: var(--space-0-5) var(--space-1-5);
    margin-top: var(--space-1-5);
  }
</style>

<ol class="k-timeline" aria-label="سجل الأنشطة">
  {events.map(ev => (
    <li class={`k-timeline__item ${riskLevelClass(ev.riskLevel)}`}>
      <div class="k-timeline__header">
        <span class="k-timeline__type">{ev.label}</span>
        <KernelBadge level={ev.riskLevel} label={riskLevelLabel(ev.riskLevel)} size="sm" />
      </div>
      <p class="k-timeline__desc">{ev.description}</p>
      <time class="k-timeline__time">{ev.timestamp}</time>
      {ev.demo && <span class="k-timeline__demo">بيانات توضيحية</span>}
    </li>
  ))}
</ol>
