---
import { productNavigation } from '../shared/product-navigation.mjs';
import ProductIcon from './ProductIcon.astro';
const { mode = 'lab', current = '' } = Astro.props;
const links = productNavigation.map(p => ({ ...p, href: mode === 'lab' ? `${p.publicPath}#lab` : p.workspacePath }));
---
<details class="workspace-menu" open data-workspace-menu>
  <summary>التنقل بين {mode === 'lab' ? 'المختبرات' : 'المنتجات'} <span aria-hidden="true">⌄</span></summary>
  <nav aria-label={mode === 'lab' ? 'مختبرات المنتجات' : 'تنقل النظام'}>
    <a href="/products/">مركز التجارب <span aria-hidden="true">↗</span></a>
    {links.map(p => <a href={p.href} aria-current={current === p.slug ? 'page' : undefined}><ProductIcon kind={p.slug} size={20}/><bdi dir="ltr">{p.name}</bdi><span class="workspace-current" aria-hidden="true">←</span></a>)}
    <a href="/app/kernel/" aria-current={current === 'kernel' ? 'page' : undefined}><span aria-hidden="true">◈</span> بوابة Kernel</a>
  </nav>
</details>
<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-workspace-menu]').forEach(menu => {
    const desktop = matchMedia('(min-width: 1000px)');
    const update = () => { menu.open = desktop.matches; };
    update(); desktop.addEventListener('change', update);
    menu.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !desktop.matches && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
    });
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { if (!desktop.matches) menu.open = false; }));
  });
</script>
<style>
  .workspace-menu { border:0; padding:0; min-inline-size:0; }
  .workspace-menu summary { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:12px 18px; font-size:14px; min-block-size:48px; list-style:none; color:var(--color-text); background:var(--surface-raised); border:1px solid var(--border-strong); border-radius:var(--radius-control); }
  summary::-webkit-details-marker { display:none; }
  nav { display:grid; gap:6px; padding-block:12px; }
  nav a { display:flex; align-items:center; gap:12px; padding:12px; min-block-size:48px; font-size:14px; line-height:1.5; color:var(--color-text-muted); border:1px solid transparent; border-radius:var(--radius-control); }
  nav a:is(:hover,:focus-visible) { color:var(--color-text); background:var(--surface-raised-hover); }
  nav a[aria-current=page] { color:var(--color-text); background:var(--surface-raised-hover); border-color:var(--icon-accent); }
  .workspace-current { margin-inline-start:auto; visibility:hidden; color:var(--color-focus); }
  [aria-current=page] .workspace-current { visibility:visible; }
  :is(a,summary):focus-visible { outline:3px solid var(--color-focus); outline-offset:3px; }
  @media(min-width:1000px) { .workspace-menu summary { display:none; } .workspace-menu::details-content { content-visibility:visible; } }
</style>
