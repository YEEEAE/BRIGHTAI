---
import { brand } from '../data/brand';
interface Props { placement?: 'header' | 'footer'; }
const { placement = 'header' } = Astro.props;
---
<a class:list={['brand-logo', placement]} href="/" aria-label="BRIGHTAI — الرئيسية">
  <img src={brand.logo} alt={brand.alt} width={brand.width} height={brand.height} loading={placement === 'footer' ? 'lazy' : 'eager'} decoding="async" />
</a>
<style>
  .brand-logo { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; }
  img { display: block; width: 144px; height: 96px; object-fit: contain; }
  .footer img { width: 180px; height: 120px; }
  @media (max-width: 767px) { .header img { width: 120px; height: 80px; } }
</style>
