---
/**
 * KernelConfirmDialog — مودال تأكيد مشترك للإجراءات الخطرة في صفحات /kernel/*.
 *
 * Architecture:
 *   - Static markup only (CSP-safe). Behavior is wired by public/js/kernel-feedback.js
 *     via the shared window.KernelFeedback.confirm API — no inline JS.
 *   - Uses the existing .kernel-modal design tokens/classes from kernel.css.
 *   - One instance per page; render it once near the end of the page markup.
 *
 * DOM contract:
 *   [data-kernel-confirm]           → the modal root (data-open="true|false")
 *   [data-kernel-confirm-title]     → dialog title (h2, aria-labelledby target)
 *   [data-kernel-confirm-message]   → confirmation message (danger hint)
 *   [data-kernel-confirm-close]     → backdrop / cancel button / X button
 *   [data-kernel-confirm-ok]        → confirm button (variant-styled)
 *   [data-kernel-confirm] [data-variant] → "danger" | "warning" | "info"
 *
 * Accessibility:
 *   - role=dialog + aria-modal + aria-labelledby → title
 *   - Enter confirms, Escape cancels (kernel-feedback.js), focus moved to the
 *     confirm button on open, focus restored via [data-kernel-confirm].
 *   - ≥44px touch targets, RTL-safe via logical properties.
 *
 * Content Preservation Rule:
 *   This component ships NO published Arabic copy. All user-facing strings
 *   (title/message/buttons) are passed by the caller at usage time.
 */
interface Props {
  id?: string;
  /** Default title — overridden at open time by KernelFeedback.confirm.open(). */
  title?: string;
  /** Default message — overridden at open time. */
  message?: string;
  confirmLabel?: string;
  cancelLabel?: string;
  variant?: 'danger' | 'warning' | 'info';
}

const {
  id = 'kernel-confirm-dialog',
  title = 'تأكيد الإجراء',
  message = 'متأكد؟ هذا الإجراء لا يُرجع بسهولة.',
  confirmLabel = 'تأكيد',
  cancelLabel = 'إلغاء',
  variant = 'danger',
} = Astro.props;

const titleId = `${id}-title`;
const iconClose = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
---

<div
  class="kernel-modal kernel-confirm-dialog"
  id={id}
  data-kernel-confirm
  data-variant={variant}
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-labelledby={titleId}
  aria-hidden="true"
>
  <div class="kernel-modal__backdrop" data-kernel-confirm-close></div>
  <div class="kernel-modal__dialog" tabindex="-1">
    <header class="kernel-modal__head">
      <h2 class="kernel-modal__title" id={titleId} data-kernel-confirm-title>{title}</h2>
      <button type="button" class="kernel-modal__close" data-kernel-confirm-close aria-label="إغلاق">
        <Fragment set:html={iconClose} />
      </button>
    </header>

    <div class="kernel-modal__context" data-kernel-confirm-message>{message}</div>

    <div class="kernel-modal__actions">
      <button type="button" class="kernel-modal__btn" data-kernel-confirm-close>{cancelLabel}</button>
      <button type="button" class="kernel-modal__btn kernel-modal__btn--confirm" data-kernel-confirm-ok>{confirmLabel}</button>
    </div>
  </div>
</div>
