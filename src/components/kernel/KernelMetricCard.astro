---
/**
 * KernelMetricCard — KPI tile used on dashboard + sub-pages.
 * Variants: brand (gradient text) | gold (copper) | plain
 * Trend: up | down | flat | null
 */
interface Props {
  label: string;
  value: string | number;
  unit?: string;
  trend?: 'up' | 'down' | 'flat' | null;
  trendLabel?: string;
  variant?: 'brand' | 'gold' | 'plain';
  iconSvg?: string;
  footer?: string;
  /** When true, the KPI holds demo data → renders an amber honesty badge + tooltip. */
  demo?: boolean;
}

const {
  label,
  value,
  unit = '',
  trend = null,
  trendLabel = '',
  variant = 'plain',
  iconSvg = '',
  footer = '',
  demo = false,
} = Astro.props;

// Warning triangle shown before the value when demo=true (honesty marker).
const iconDemoWarn = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';

// Screen-reader label: announces the demo nature ("Demo data") per honesty spec.
const DEMO_TOOLTIP = 'هذه أرقام تجريبية. ربط Kernel ببيئتك لأرقام حقيقية';
const DEMO_ARIA = 'بيانات توضيحية · Demo data';

const valueClass = variant === 'brand' ? 'kernel-metric-card__value--brand'
                  : variant === 'gold' ? 'kernel-metric-card__value--gold'
                  : '';

const trendClass = trend === 'up' ? 'kernel-metric-card__trend--up'
                  : trend === 'down' ? 'kernel-metric-card__trend--down'
                  : trend === 'flat' ? 'kernel-metric-card__trend--flat'
                  : '';

const trendArrow = trend === 'up' ? '▲'
                  : trend === 'down' ? '▼'
                  : '—';
---

<article class="kernel-metric-card">
  <header class="kernel-metric-card__header">
    <span class="kernel-metric-card__label">
      {iconSvg && <span class="kernel-metric-card__label-icon" aria-hidden="true"><Fragment set:html={iconSvg} /></span>}
      {label}
    </span>
    <span class="kernel-metric-card__meta">
      {demo && (
        <span class="kernel-metric-card__demo-badge" role="img" aria-label={DEMO_ARIA} title={DEMO_TOOLTIP}>
          <span class="kernel-metric-card__demo-dot" aria-hidden="true"></span>
          بيانات توضيحية
        </span>
      )}
      {trend && (
        <span class:list={['kernel-metric-card__trend', trendClass]} aria-label={trendLabel}>
          {trendArrow} {trendLabel}
        </span>
      )}
    </span>
  </header>
  <div class="kernel-metric-card__value-row">
    {demo && <span class="kernel-metric-card__demo-warn" aria-hidden="true"><Fragment set:html={iconDemoWarn} /></span>}
    <span class:list={['kernel-metric-card__value', valueClass]}>{value}</span>
    {unit && <span class="kernel-metric-card__unit">{unit}</span>}
  </div>
  {footer && <footer class="kernel-metric-card__footer">{footer}</footer>}
</article>