---
/**
 * KernelChatError — KERNEL-AI-2026-07-14 / CHAT-STATE-001 (2026-08-09)
 *
 * Canonical error UI for /api/ai/chat. This component is the single
 * source of truth for error TYPES and Arabic copy. The chat page
 * (src/pages/kernel/chat.astro) renders errors dynamically via an inline
 * showChatError() function (it needs to re-render on each request), but
 * that function mirrors the type union + message map defined here so the
 * two never drift.
 *
 * HTTP status → type mapping (see src/pages/api/ai/chat.ts):
 *   429              → rate_limit
 *   451              → blocked            (firewall decision: block)
 *   428              → approval_required  (firewall decision: require_approval)
 *   502 / 503        → provider_failed
 *   504 / AbortError → timeout
 *   200 + X-Stream-Status: all_providers_failed → provider_failed
 *   fetch() throw    → network
 *   404              → unavailable         (Render static — no endpoint)
 *   403              → unavailable         (origin allowlist / key)
 *   anything else    → unknown
 *
 * الاستخدام:
 *   <KernelChatError type="rate_limit" retryAfterSec={42} />
 *   <KernelChatError type="provider_failed" retryable />
 *   <KernelChatError type="blocked" />          ← 451 firewall
 *   <KernelChatError type="approval_required" /> ← 428 firewall
 *   <KernelChatError type="unavailable" />       ← API رجع 404 (Render static)
 *
 * التصميم: يستخدم kernel-chat-policy-banner classes الموجودة في kernel.css.
 * RTL-aware، touch ≥44px، aria-live="polite" للقراءة من قارئ الشاشة.
 * retryAction: 'resend' (default) يعرض زر "إعادة المحاولة" مربوط بـ
 *   data-kernel-retry — chat.astro يربطه بإعادة إرسال آخر رسالة.
 *
 * لا يلمس chat.ts — يكتفي بعرض رسائل واضحة للزائر.
 */
import DOMPurify from 'isomorphic-dompurify';

export type KernelChatErrorType =
  | 'rate_limit'          // 429 — تجاوز حد المعدل
  | 'blocked'             // 451 — firewall قرر block (PII/سرية محظورة)
  | 'approval_required'   // 428 — firewall قرر require_approval
  | 'provider_failed'     // 502/503 — المزود (Groq/Gemini) فشل
  | 'network'             // fetch() throw — انقطاع
  | 'unavailable'         // 404/403 — الـ API مو متاح (Render static أو hosting بدون server)
  | 'timeout'             // 504 أو timeout
  | 'cancelled'           // CHAT-STATE-001 — المستخدم أوقف الرد
  | 'unknown';            // أي شي ثاني

interface Props {
  type: KernelChatErrorType;
  retryAfterSec?: number;
  /** Show the retry button. Defaults to true for recoverable errors. */
  retryable?: boolean;
  id?: string;
}

const { type, retryAfterSec, retryable = true, id = 'kernel-chat-error' } = Astro.props;

const iconError = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
const iconWarning = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';

interface ErrorView {
  tone: 'warning' | 'danger' | 'info';
  icon: string;
  title: string;
  msg: string;
  cta?: { href: string; label: string; external?: boolean };
}

function buildView(t: KernelChatErrorType, retry?: number): ErrorView {
  switch (t) {
    case 'rate_limit':
      return {
        tone: 'warning',
        icon: iconWarning,
        title: 'تم تجاوز حد الطلبات',
        msg: retry
          ? `وصلنا للحد المسموح (10 طلبات في الدقيقة). حاول مرة ثانية بعد ${retry} ثانية.`
          : 'وصلنا للحد المسموح (10 طلبات في الدقيقة). حاول مرة ثانية بعد لحظات.',
        cta: { href: '/go/whatsapp/', label: 'تواصل عبر واتساب', external: true },
      };
    case 'blocked':
      // CHAT-STATE-001: HTTP 451 — firewall.decision === 'block'.
      // The request contained PII/secrets and was refused before reaching
      // the model. The refusal text + suggested rewrite live in the AI
      // message bubble (renderBlockedMessage in chat.astro), not here;
      // this banner is the inline alert that accompanies it.
      return {
        tone: 'danger',
        icon: iconError,
        title: 'محظور بسياسة الأمان',
        msg: 'طلبك يحتوي على بيانات شخصية أو سرية محظورة. أعد صياغته بدون أرقام هوية أو بيانات حساسة. الصياغة الآمنة المقترحة ظاهرة في الرد.',
        cta: { href: '/kernel/policies/', label: 'اطّلع على سياسات الحوكمة' },
      };
    case 'approval_required':
      // CHAT-STATE-001: HTTP 428 — firewall.decision === 'require_approval'.
      // The request needs explicit human sign-off before the model can run.
      return {
        tone: 'warning',
        icon: iconWarning,
        title: 'يتطلب موافقة بشرية',
        msg: 'هذا الطلب يحتوي على بيانات حساسة تتطلب موافقة صريحة قبل المتابعة. رفعناه إلى لوحة الموافقات — ستصل إشعار فور البتّ في الطلب.',
        cta: { href: '/kernel/approvals/', label: 'افتح لوحة الموافقات' },
      };
    case 'provider_failed':
      return {
        tone: 'danger',
        icon: iconError,
        title: 'المزود الذكي غير متاح مؤقتاً',
        msg: 'فشل الوصول إلى نموذج الذكاء الاصطناعي (Groq أو Gemini). طلبك ما وصل للنموذج. تقدر تعيد المحاولة الآن، أو تتواصل مع فريق الحوكمة لو تكرر.',
        cta: { href: '/go/whatsapp/', label: 'تواصل مع فريق الحوكمة', external: true },
      };
    case 'network':
      return {
        tone: 'warning',
        icon: iconWarning,
        title: 'تعذّر الاتصال',
        msg: 'تعذّر الاتصال بالخادم. تحقق من الإنترنت ثم أعد المحاولة. طلبك ما وصل للنموذج.',
        cta: { href: '/go/whatsapp/', label: 'تواصل عبر واتساب', external: true },
      };
    case 'unavailable':
      return {
        tone: 'info',
        icon: iconInfo(),
        title: 'المساعد الذكي في وضع تجريبي',
        msg: 'هذه الصفحة تستدعي المساعد الذكي في الخادم، لكن البيئة الحالية لا تشغّل نقطة الاتصال (Render static). سترى ردوداً تجريبية توضيحية. للتفعيل الكامل في بيئة إنتاجية، تواصل مع فريق BrightAI.',
        cta: { href: '/contact/', label: 'تواصل مع فريق BrightAI' },
      };
    case 'timeout':
      return {
        tone: 'warning',
        icon: iconWarning,
        title: 'انتهت مهلة الاستجابة',
        msg: 'النموذج أخذ وقتاً أطول من المتوقع للرد. طلبك ما اكتمل — تقدر تعيد المحاولة بنفس السؤال أو بصياغة أقصر.',
        cta: { href: '/go/whatsapp/', label: 'تواصل عبر واتساب', external: true },
      };
    case 'cancelled':
      // CHAT-STATE-001: user pressed the Cancel button mid-stream.
      return {
        tone: 'warning',
        icon: iconWarning,
        title: 'تم إيقاف الرد',
        msg: 'أوقفت الرد يدوياً. النص الجزئي (إن وُجد) ظاهر فوق. تقدر تعيد المحاولة بنفس الرسالة.',
        cta: { href: '/go/whatsapp/', label: 'تواصل عبر واتساب', external: true },
      };
    default:
      return {
        tone: 'danger',
        icon: iconError,
        title: 'حدث خطأ غير متوقع',
        msg: 'حدث خطأ غير متوقع. طلبك ما وصل للنموذج — تقدر تعيد المحاولة. لو تكرر الخطأ تواصل مع فريق الدعم.',
        cta: { href: '/go/whatsapp/', label: 'تواصل عبر واتساب', external: true },
      };
  }
}

function iconInfo(): string {
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';
}

const view = buildView(type, retryAfterSec);
const bannerClass = `kernel-chat-policy-banner kernel-chat-policy-banner--${view.tone}`;
// CHAT-STATE-001: only show the retry button for genuinely recoverable
// errors. rate_limit / unavailable / blocked / approval_required each
// have their own resolution path (wait, demo, rewrite, approve).
const RETRYABLE_TYPES: KernelChatErrorType[] = [
  'provider_failed',
  'network',
  'timeout',
  'cancelled',
  'unknown',
];
const showRetry = retryable && RETRYABLE_TYPES.includes(type);
---

<div
  id={id}
  class={bannerClass}
  role="alert"
  aria-live="polite"
  data-kernel-chat-error
  data-error-type={type}
  hidden
>
  <span class="kernel-chat-policy-banner__icon" aria-hidden="true">
    <Fragment set:html={DOMPurify.sanitize(view.icon)} />
  </span>
  <div class="kernel-chat-policy-banner__body">
    <p class="kernel-chat-policy-banner__title">{view.title}</p>
    <p class="kernel-chat-policy-banner__msg">{view.msg}</p>
    {showRetry && (
      <button
        type="button"
        class="kernel-chat-policy-banner__retry"
        data-kernel-retry
        aria-label="إعادة إرسال آخر رسالة"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
        <span>إعادة المحاولة</span>
      </button>
    )}
    {view.cta && (
      <p class="kernel-chat-policy-banner__msg" style="margin-block-start:var(--space-1);">
        <a
          href={view.cta.href}
          target={view.cta.external ? '_blank' : undefined}
          rel={view.cta.external ? 'noopener noreferrer' : undefined}
          style="color:var(--text-primary); font-weight:var(--font-bold); text-decoration:underline; text-underline-offset:3px;"
        >
          {view.cta.label} ←
        </a>
      </p>
    )}
  </div>
</div>

<style>
  /* خفيف: الـ banner الأساسي موجود في kernel.css.
     هنا نضيف تعديلات خاصة بالـ error variant فقط. */
  [data-kernel-chat-error][data-error-type="provider_failed"] {
    border-color: var(--status-danger);
  }
  [data-kernel-chat-error][data-error-type="unavailable"] {
    border-color: var(--interactive-primary);
  }
  [data-kernel-chat-error] .kernel-chat-policy-banner__title {
    color: var(--text-primary);
  }
</style>
