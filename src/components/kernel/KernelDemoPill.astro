---
/**
 * KernelDemoPill — Static "demo data" disclosure badge (BAI-P0-TRUTH-001).
 *
 * Read-only indicator: the Kernel surfaces only deterministic/demo data.
 * Not a toggle — there is no live data source to switch to (every
 * src/data/kernel-*.ts is a seeded generator; KERNEL_DATASETS_LIVE = [],
 * EVAL_LIVE_DATASETS = [], liveCount = 0). Replacing the old interactive
 * toggle with a fixed badge avoids the "control that changes label + CSS
 * only" anti-pattern. The shell-level "Mode: Demo" chip in KernelLayout
 * is the other half of this disclosure.
 *
 * Provenance for live-backed surfaces lives separately on chat.astro
 * (data-demo-badge toggled by setDemoMode), which marks real demo vs
 * live provider replies — that system is untouched here.
 */
interface Props {
  label?: string;
}

const { label = 'بيانات تجريبية' } = Astro.props;
---

<span
  class="kernel-demo-pill"
  role="img"
  aria-label="البيانات المعروضة تجريبية"
  title="البيانات المعروضة تجريبية"
>
  <span class="kernel-demo-pill__dot" aria-hidden="true"></span>
  <span>{label}</span>
</span>
