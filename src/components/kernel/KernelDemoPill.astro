---
/**
 * KernelDemoPill — Demo data toggle (matches /kernel/ PWA pattern).
 * - Pressed state reads from a parent data attr or localStorage.
 * - Click dispatches `kernel:demo-toggle` custom event for any page to listen.
 * - Pure CSS styling; no JS logic to wire up — page reads aria-pressed.
 */
interface Props {
  label?: string;
  pressed?: boolean;
}

const { label = 'بيانات تجريبية', pressed = true } = Astro.props;
---

<button
  class:list={['kernel-demo-pill', !pressed && 'kernel-demo-pill--inactive']}
  type="button"
  aria-pressed={pressed ? 'true' : 'false'}
  aria-label="تبديل البيانات التجريبية"
  data-kernel-demo-pill
>
  <span class="kernel-demo-pill__dot" aria-hidden="true"></span>
  <span>{label}</span>
</button>

<!-- BAI-SEC-18 (2026-07-25): inline script moved to public/js/kernel-demo-pill.js
     to enable strict-CSP (no 'unsafe-inline' on script-src). Loaded as ES module. -->
<script type="module" src="/js/kernel-demo-pill.js"></script>