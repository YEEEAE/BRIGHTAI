---
/**
 * KernelRoleSelector — P1 (2026-08-04) Role-Based Personalized Journey
 *
 * يسمح للزائر الجديد باختيار دوره في الشركة (CISO/DPO، مسؤول امتثال،
 * مطوّر، موظف) فيعرض له KernelRecommendedJourney مخصصة.
 *
 * التكامل مع الشِل المشترك:
 *  - يستخدم نفس localStorage key (`brightai-kernel-role`) اللي يستخدمه
 *    kernel-shell.js عبر مبدّل الدور في السايدبار — مصدر واحد للحقيقة.
 *  - عند الاختيار: يحدّث body[data-role] + يحدّث الـ select في السايدبار
 *    (لو موجود) + يطلق حدث `kernel:role-change` ليستمع له الـ journey.
 *
 * قواعد:
 *  - اختياري: الزائر يقدر يتجاهله (ما يفرض عليه شي).
 *  - RTL كامل + logical properties.
 *  - Accessibility: أزرار حقيقية مع aria-pressed + focus-visible.
 *  - prefers-reduced-motion محترم.
 *  - لا PII — الدور فقط يُحفظ في localStorage.
 */
const roles = [
  { id: 'ciso', label: 'CISO / DPO', icon: '🛡️', hint: 'أمن المعلومات وحماية البيانات' },
  { id: 'compliance', label: 'مسؤول امتثال', icon: '✅', hint: 'اللوائح والضوابط والأدلة' },
  { id: 'developer', label: 'مطوّر', icon: '👨‍💻', hint: 'ربط النماذج والـ API' },
  { id: 'employee', label: 'موظف', icon: '👤', hint: 'استخدام AI الآمن في شغلك' },
];
---

<div class="kernel-role-selector" data-kernel-role-selector>
  <h2 class="kernel-role-selector__title">ما دورك في الشركة؟</h2>
  <p class="kernel-role-selector__lead">نرتّب لك وحدات Kernel حسب مسؤوليتك — تقدر تغيّره لاحقاً من الشريط الجانبي.</p>
  <div class="kernel-role-selector__grid" role="group" aria-label="اختيار الدور">
    {roles.map(role => (
      <button
        type="button"
        class="kernel-role-selector__btn"
        data-kernel-role-option={role.id}
        aria-pressed="false"
        aria-label={`${role.icon} ${role.label} — ${role.hint}`}
      >
        <span class="kernel-role-selector__icon" aria-hidden="true">{role.icon}</span>
        <span class="kernel-role-selector__label">{role.label}</span>
        <span class="kernel-role-selector__hint">{role.hint}</span>
      </button>
    ))}
  </div>
  <p class="kernel-role-selector__note">اختياري — تقدر تتصفح كل الوحدات بدون اختيار.</p>
</div>

<style>
  .kernel-role-selector {
    margin: var(--space-6) 0 var(--space-4);
    padding: var(--space-5) var(--space-4);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .kernel-role-selector__title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-xl);
    color: var(--text-primary);
  }
  .kernel-role-selector__lead {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 65ch;
  }
  .kernel-role-selector__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .kernel-role-selector__btn {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-align: start;
    cursor: pointer;
    min-height: 48px;
    transition: background var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }
  .kernel-role-selector__btn:hover {
    background: var(--brand-soft);
    border-color: var(--interactive-primary);
  }
  .kernel-role-selector__btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--interactive-primary);
  }
  .kernel-role-selector__btn[aria-pressed="true"] {
    background: var(--brand-soft-strong);
    border-color: var(--interactive-primary);
    box-shadow: inset 0 0 0 1px var(--interactive-primary);
  }
  .kernel-role-selector__icon {
    font-size: var(--text-xl);
    line-height: 1;
    flex-shrink: 0;
  }
  .kernel-role-selector__label {
    flex-shrink: 0;
  }
  .kernel-role-selector__hint {
    margin-inline-start: auto;
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: var(--font-normal);
  }
  .kernel-role-selector__note {
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (min-width: 640px) {
    .kernel-role-selector__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kernel-role-selector__btn {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    'use strict';
    var ROLE_KEY = 'brightai-kernel-role';

    function getSavedRole() {
      try { return localStorage.getItem(ROLE_KEY); } catch (e) { return null; }
    }

    function setRole(roleId) {
      try { localStorage.setItem(ROLE_KEY, roleId); } catch (e) {}
      document.body.setAttribute('data-role', roleId);
      // حدّث الـ select في السايدبار (لو موجود) — مصدر واحد للحقيقة.
      var select = document.querySelector('[data-kernel-role]');
      if (select) select.value = roleId;
      // أطلق حدث للـ Journey component.
      document.dispatchEvent(new CustomEvent('kernel:role-change', { detail: { role: roleId } }));
    }

    function init() {
      var root = document.querySelector('[data-kernel-role-selector]');
      if (!root) return;
      var saved = getSavedRole();
      var buttons = root.querySelectorAll('[data-kernel-role-option]');
      buttons.forEach(function (btn) {
        if (btn.dataset.bound === '1') return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', function () {
          var roleId = btn.getAttribute('data-kernel-role-option');
          setRole(roleId);
          // حدّث aria-pressed على كل الأزرار.
          buttons.forEach(function (b) {
            b.setAttribute('aria-pressed', String(b === btn));
          });
        });
      });
      // لو في دور محفوظ، علّمه.
      if (saved) {
        buttons.forEach(function (btn) {
          if (btn.getAttribute('data-kernel-role-option') === saved) {
            btn.setAttribute('aria-pressed', 'true');
          }
        });
      }
    }

    document.addEventListener('astro:page-load', init);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>