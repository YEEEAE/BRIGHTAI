---
/**
 * KernelContactCta — KERNEL-AI-2026-07-14
 *
 * CTA "تواصل معنا" يظهر بعد 3 رسائل في /kernel/chat/ لتحويل الزائر إلى lead.
 * يستخدم نفس النمط البصري لـ kernel-chat-policy-banner.
 *
 * يخفي نفسه افتراضياً ([hidden]) — يُفعّل عبر JS من chat.astro بعد 3 رسائل.
 *
 * Props:
 *   - threshold: number (افتراضي: 3) — عدد الرسائل قبل الظهور
 *   - id: string (افتراضي: 'kernel-contact-cta')
 *   - message: string (افتراضي: جملة توضيحية)
 */

interface Props {
  threshold?: number;
  id?: string;
  message?: string;
}

const {
  threshold = 3,
  id = 'kernel-contact-cta',
  message = 'تبي تطبيق فعلي في منشأتك؟ تواصل مع فريق الحوكمة مباشرة عبر واتساب أو عبّي النموذج أدناه.',
} = Astro.props;

const iconChat = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>';
---

<div
  id={id}
  class="kernel-contact-cta kernel-chat-policy-banner kernel-chat-policy-banner--info"
  role="complementary"
  aria-live="polite"
  data-kernel-contact-cta
  data-threshold={String(threshold)}
  hidden
>
  <span class="kernel-chat-policy-banner__icon" aria-hidden="true">
    <Fragment set:html={iconChat} />
  </span>
  <div class="kernel-chat-policy-banner__body">
    <p class="kernel-chat-policy-banner__title">لاحظنا تفاعلك — تبي نكمل معك بشكل مخصص؟</p>
    <p class="kernel-chat-policy-banner__msg">{message}</p>
    <div style="display:flex; flex-wrap:wrap; gap:var(--space-2); margin-block-start:var(--space-2);">
      <a
        href="/go/whatsapp/?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%AC%D8%B1%D8%A8%D8%AA%20%D8%A7%D9%84%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%20%D8%A7%D9%84%D8%B0%D9%83%D9%8A%20%D9%81%D9%8A%20%2Fkernel%2Fchat%2F%20%D9%88%D8%A3%D8%B1%D9%8A%D8%AF%20%D9%85%D8%AA%D8%A7%D8%A8%D8%B9%D8%A9%20%D8%A8%D8%B4%D9%83%D9%84%20%D9%85%D8%AE%D8%B5%D8%B5"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--primary"
        style="padding:var(--space-2) var(--space-4); font-size:var(--text-sm);"
      >
        تواصل عبر واتساب ←
      </a>
      <a
        href="#kernel-lead-form"
        class="btn btn--outline"
        style="padding:var(--space-2) var(--space-4); font-size:var(--text-sm);"
      >
        عبّي نموذج التواصل
      </a>
    </div>
  </div>
</div>

<style>
  .kernel-contact-cta {
    margin-block: var(--space-3);
  }
  .kernel-contact-cta .kernel-chat-policy-banner__icon {
    color: var(--interactive-primary);
  }
  .btn--outline {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }
  .btn--outline:hover,
  .btn--outline:focus-visible {
    border-color: var(--interactive-primary);
  }
</style>
