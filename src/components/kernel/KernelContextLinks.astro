---
/**
 * KernelContextLinks — Cross-links section for Kernel pages.
 * Shows: back to index, solution link, docs link, blog link, contact CTA,
 * and related kernel units.
 * Uses V2 design tokens. CSS-only, no JS.
 *
 * Phase 9 (2026-07-14): added blogPath + blogLabel for the related blog
 * cross-link so every kernel page links to a relevant blog post.
 */
import { kernelNavItems, type KernelUnit } from '../../data/kernel';

interface Props {
  currentPath: string;
  solutionPath?: string | null;
  solutionLabel?: string;
  docPath: string;
  blogPath?: string;
  blogLabel?: string;
  relatedSlugs?: string[];
}

const {
  currentPath,
  solutionPath,
  solutionLabel = 'الحل المقابل',
  docPath,
  blogPath,
  blogLabel = 'مقال مرتبط',
  relatedSlugs = [],
} = Astro.props;
---

<style>
  .k-cross {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .k-cross__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .k-cross a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-soft);
    text-decoration: none;
    font-size: var(--text-xs);
    transition: color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }
  .k-cross a:hover,
  .k-cross a:focus-visible {
    color: var(--brand);
    border-color: var(--brand);
  }
  .k-cross__related {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .k-cross a { transition: none; }
  }
</style>

<div class="k-cross">
  <div class="k-cross__links">
    <a href="/kernel/">← العودة لفهرس Kernel</a>
    {solutionPath && <a href={solutionPath}>{solutionLabel} ←</a>}
    <a href={docPath}>التوثيق التقني ←</a>
    {blogPath && <a href={blogPath}>{blogLabel} ←</a>}
    <a href="/contact/">احجز استشارة ←</a>
  </div>

  {relatedSlugs.length > 0 && (
    <div class="k-cross__related">
      {relatedSlugs.map(slug => {
        const related = kernelNavItems.find((u: KernelUnit) => u.slug === slug);
        return related ? <a href={related.path}><span>{related.label}</span></a> : null;
      })}
    </div>
  )}
</div>
