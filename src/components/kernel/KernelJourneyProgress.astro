---
/**
 * KernelJourneyProgress — K1 (2026-07-18)
 *
 * شريط تقدم بصري للـ 5 مراحل في مسار Kernel.
 * - keyboard-navigable: Tab/Shift+Tab عبر المراحل، Enter ينقل للصفحة
 * - RTL: التصميم من اليمين لليسار تلقائياً (المرحلة 1 يمين، المرحلة 5 يسار)
 * - current stage: aria-current="step" + visual highlight
 * - completed stage: علامة ✓ + لون ثانوي
 * - لا overflow على 320/375/544/1024 (flex-wrap محكوم + scroll-x آمن)
 * - يحترم prefers-reduced-motion
 *
 * السلوك:
 *  - يُحسم الـ current stage من الـ prop `currentPath` (auto-detect)
 *  - كل stage هو <a> ينقل لـ pagePath — ما عدا الـ current (aria-disabled)
 *  - emitted dataset: data-journey-progress, data-current-stage
 *
 * Props:
 *  - currentPath: المسار الحالي (مثلاً "/kernel/scenarios/")
 *  - variant: 'full' | 'compact' (compact فقط على الجوال الصغير)
 */

import {
  JOURNEY_STAGES,
  getStageForPath,
  type JourneyStage,
} from '../../data/kernel-journey';

interface Props {
  currentPath: string;
  variant?: 'full' | 'compact';
  /** Optional override (e.g. when deep-linking directly into a sub-stage). */
  forcedStageId?: JourneyStage['id'] | null;
}

const { currentPath, variant = 'full', forcedStageId = null } = Astro.props;

const detectedStage = forcedStageId
  ? JOURNEY_STAGES.find(s => s.id === forcedStageId) ?? null
  : getStageForPath(currentPath);

const currentStage = detectedStage ?? JOURNEY_STAGES[0]!;
const currentIndex = JOURNEY_STAGES.findIndex(s => s.id === currentStage.id);

const iconCheck = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
const iconArrowL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>';
const iconArrowR = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
---

<nav
  class:list={['k-journey', variant === 'compact' && 'k-journey--compact']}
  aria-label="مسار Kernel من 5 مراحل"
  data-journey-progress
  data-current-stage={currentStage.id}
  data-current-stage-number={String(currentStage.number)}
>
  <ol class="k-journey__list" role="list">
    {JOURNEY_STAGES.map((stage, i) => {
      const isCurrent = stage.id === currentStage.id;
      const isCompleted = i < currentIndex;
      const isUpcoming = i > currentIndex;
      const stateClass = isCurrent
        ? 'k-journey__item--current'
        : isCompleted
          ? 'k-journey__item--completed'
          : 'k-journey__item--upcoming';
      return (
        <li
          class:list={['k-journey__item', stateClass]}
          data-stage-id={stage.id}
          data-stage-number={String(stage.number)}
        >
          <a
            href={isCurrent ? undefined : stage.pagePath}
            class="k-journey__step"
            tabindex={isCurrent ? -1 : 0}
            aria-current={isCurrent ? 'step' : undefined}
            aria-disabled={isCurrent ? 'true' : undefined}
            aria-label={`المرحلة ${stage.number} من 5: ${stage.label} — ${stage.subtitle}`}
            data-stage-link
          >
            <span class="k-journey__number" aria-hidden="true">
              {isCompleted ? <Fragment set:html={iconCheck} /> : <span>{stage.number}</span>}
            </span>
            <span class="k-journey__body">
              <span class="k-journey__label">{stage.label}</span>
              <span class="k-journey__subtitle">{stage.subtitle}</span>
            </span>
            {i < JOURNEY_STAGES.length - 1 && (
              <span class="k-journey__connector" aria-hidden="true">
                {isCompleted ? <Fragment set:html={iconArrowL} /> : <Fragment set:html={iconArrowR} />}
              </span>
            )}
          </a>
        </li>
      );
    })}
  </ol>

  <p class="k-journey__hint" aria-live="polite">
    <span>المرحلة {currentStage.number} من 5: {currentStage.label}</span>
    <span class="k-journey__hint-sep" aria-hidden="true">·</span>
    <span>{currentStage.expectedDuration}</span>
  </p>
</nav>

<style>
  .k-journey {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-base) 100%);
    border-bottom: 1px solid var(--border);
    /* perf(2026-07-14): non-blocking; no render-blocking pattern needed
       because this CSS is in the KernelLayout scoped style block. */
  }

  .k-journey__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: stretch;
    gap: var(--space-1);
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    /* RTL: progress reads right-to-left — stage 1 is on the right,
       stage 5 is on the left. */
  }
  .k-journey__list::-webkit-scrollbar { display: none; }

  .k-journey__item {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
  }

  .k-journey__step {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid transparent;
    transition: background var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
    min-height: 44px; /* touch target */
    width: 100%;
    cursor: pointer;
  }

  .k-journey__step:hover:not([aria-disabled="true"]),
  .k-journey__step:focus-visible:not([aria-disabled="true"]) {
    background: var(--brand-soft);
    color: var(--text-primary);
    border-color: var(--border);
    outline: none;
  }
  .k-journey__step:focus-visible:not([aria-disabled="true"]) {
    box-shadow: 0 0 0 2px var(--brand-500);
  }

  .k-journey__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    min-width: 28px;
    border-radius: 9999px;
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .k-journey__number svg { width: 14px; height: 14px; }

  .k-journey__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    overflow: hidden;
  }

  .k-journey__label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .k-journey__subtitle {
    font-size: 0.6875rem; /* 11px — smaller than text-xs to fit */
    color: var(--text-muted);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .k-journey__connector {
    display: none; /* hidden on compact, only visual on full */
  }

  /* States */
  .k-journey__item--completed .k-journey__number {
    background: var(--status-success);
    color: var(--text-inverse);
    border-color: var(--status-success);
  }
  .k-journey__item--completed .k-journey__step {
    color: var(--text-secondary);
  }

  .k-journey__item--current .k-journey__number {
    background: var(--interactive-primary);
    color: var(--bg-base);
    border-color: var(--interactive-primary);
  }
  .k-journey__item--current .k-journey__step {
    color: var(--text-primary);
    background: var(--brand-soft-strong);
    border-color: var(--interactive-primary);
  }
  .k-journey__item--current .k-journey__label {
    color: var(--interactive-primary);
  }

  .k-journey__item--upcoming .k-journey__step {
    color: var(--text-muted);
  }
  .k-journey__item--upcoming .k-journey__number {
    background: transparent;
    color: var(--text-muted);
  }

  .k-journey__item--current .k-journey__step {
    cursor: default;
  }
  .k-journey__item--upcoming .k-journey__step {
    cursor: pointer;
  }

  /* Hint line */
  .k-journey__hint {
    margin: var(--space-2) 0 0;
    padding: 0;
    font-size: var(--text-xs);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .k-journey__hint-sep {
    opacity: 0.5;
  }

  /* Compact mode: 320px and below */
  @media (max-width: 480px) {
    .k-journey {
      padding: var(--space-2) var(--space-3);
    }
    .k-journey__list {
      gap: 0;
    }
    .k-journey__body { display: none; }
    .k-journey__item--current .k-journey__body { display: flex; }
    .k-journey__step {
      padding: var(--space-2);
      justify-content: center;
    }
    .k-journey__item--current .k-journey__step {
      justify-content: flex-start;
    }
  }

  /* Tablet 544-1024: keep labels, hide subtitles */
  @media (min-width: 481px) and (max-width: 768px) {
    .k-journey__subtitle { display: none; }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .k-journey__step { transition: none; }
  }
</style>
