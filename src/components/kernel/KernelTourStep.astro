---
/**
 * KernelTourStep — Single step definition for the Kernel Product Tour.
 *
 * Used by KernelProductTour to feed driver.js step definitions.
 * Each step targets a real DOM element on the page, describes it in
 * Saudi dialect, and positions the tooltip relative to the target.
 *
 * Props mirror driver.js Step interface (subset).
 */
interface Props {
  /** CSS selector of the element to highlight. */
  element: string;
  /** Step title (Arabic). */
  title: string;
  /** Step description (Arabic). */
  description: string;
  /** Tooltip placement. */
  position?: 'top' | 'bottom' | 'left' | 'right';
  /** Optional: extra CSS classes for the step card. */
  className?: string;
}

const { element, title, description, position = 'bottom', className = '' } = Astro.props;
---

<li
  class={`kernel-tour-step ${className}`}
  data-tour-step
  data-tour-element={element}
  data-tour-title={title}
  data-tour-description={description}
  data-tour-position={position}
  hidden
></li>