---
/**
 * KernelUndoToast — توست نجاح مشترك مع زر «تراجع» لمدة 10 ثوانٍ (كل صفحات /kernel/*).
 *
 * Architecture:
 *   - Static markup only (CSP-safe). Behavior is wired by public/js/kernel-feedback.js
 *     via window.KernelFeedback.toast — no inline JS.
 *   - Replaces the previous hand-written #k-toast block in KernelLayout.astro
 *     (kept the exact same id + data-* attributes so existing consumers
 *     kernel-scenarios.js / kernel-reports.js / kernel-drawer.js keep working).
 *
 * DOM contract (unchanged from the shell toast):
 *   #k-toast                       → toast root (hidden default)
 *   [data-kernel-toast-msg]        → message span
 *   [data-kernel-toast-undo]       → تراجع button (hidden unless an undo handler exists)
 *   [data-kernel-toast-close]      → close (×) button
 *
 * Accessibility:
 *   - role=status + aria-live=polite + aria-atomic=true → screen readers announce.
 *   - The undo button keeps visible focus until the window (10s default) closes.
 *   - RTL-safe (logical properties), ≥44px touch targets.
 */
interface Props {
  message?: string;
}

const { message = 'تم.' } = Astro.props;
---

<div class="k-toast" id="k-toast" role="status" aria-live="polite" aria-atomic="true" hidden>
  <span class="k-toast__msg" data-kernel-toast-msg>{message}</span>
  <button class="k-toast__undo" type="button" data-kernel-toast-undo hidden>تراجع</button>
  <button class="k-toast__close" type="button" data-kernel-toast-close aria-label="إغلاق">×</button>
</div>
