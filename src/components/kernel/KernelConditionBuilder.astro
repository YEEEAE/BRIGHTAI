---
/**
 * KernelConditionBuilder.astro — باني الشروط البصري (M17/PROMPT 8).
 *
 * يوفر مخططاً انسيابياً بصرياً (Visual Flowchart) لبناء شروط سياسات الحوكمة:
 *   - Node Trigger: عقدة نقطة البداية (الرسالة / طلب AI).
 *   - Connector: خط الربط RTL الموصل بين العقد.
 *   - Node Condition: عقد المطابقة (PII / القسم / حزمة الامتثال) مع دعم التجميع البصري AND/OR.
 *   - Node Action: عقدة الإجراء النهائي (حظر / تعمية / موافقة بشرية / تنبيه).
 *   - Live Preview: لوحة معاينة سياقية حية تشرح القاعدة بالنص العربي الواضح.
 *   - Mode Toggle: التبديل بين المحرر البصري التفاعلي والمحرر النصي التقليدي.
 */
interface Props {
  id?: string;
  class?: string;
}

const { id = 'kernel-condition-builder', class: className = '' } = Astro.props;
---

<div class:list={['po-builder-root', className]} id={id} data-po-builder-root>
  <!-- ═══ شريط الأدوات ومبدّل النمط ═══ -->
  <div class="po-builder-toolbar">
    <div class="po-builder-modes" role="radiogroup" aria-label="نمط التحرير">
      <button
        type="button"
        class="po-builder-mode-btn po-builder-mode-btn--active"
        data-po-builder-mode="visual"
        role="radio"
        aria-checked="true"
      >
        <span class="po-builder-mode-icon">🔀</span>
        <span>المحرر البصري</span>
      </button>
      <button
        type="button"
        class="po-builder-mode-btn"
        data-po-builder-mode="classic"
        role="radio"
        aria-checked="false"
      >
        <span class="po-builder-mode-icon">📝</span>
        <span>المحرر النصي</span>
      </button>
    </div>

    <div class="po-builder-quick-actions" data-po-builder-visual-only>
      <button type="button" class="po-btn po-btn--ghost po-btn--sm" data-po-add-condition-btn>
        <span aria-hidden="true">➕</span> أضف شرطاً (AND)
      </button>
      <button type="button" class="po-btn po-btn--ghost po-btn--sm" data-po-add-or-group-btn>
        <span aria-hidden="true">🔀</span> أضف مجموعة بديلة (OR)
      </button>
    </div>
  </div>

  <!-- ═══ قماش المخطط الانسيابي البصري (Visual Flowchart Container) ═══ -->
  <div class="po-flowchart-canvas" data-po-builder-canvas data-po-builder-visual-only>
    <!-- العقدة 1: المحفز (Trigger Node) -->
    <div class="po-node po-node--trigger" data-node-type="trigger">
      <div class="po-node__header">
        <span class="po-node__badge">بداية التدفق</span>
        <span class="po-node__icon">💬</span>
      </div>
      <div class="po-node__body">
        <strong class="po-node__title">عند استقبال رسالة جديدة</strong>
        <p class="po-node__desc">يتم فحص محتوى الطلب في محرك الحوكمة</p>
      </div>
    </div>

    <!-- موصل بصري -->
    <div class="po-connector" aria-hidden="true">
      <div class="po-connector__line"></div>
      <div class="po-connector__arrow">▼</div>
    </div>

    <!-- حاوية الشروط البصرية (AND / OR Groups Container) -->
    <div class="po-conditions-tree" data-po-conditions-container>
      <!-- تُرسم الشروط ديناميكياً بواسطة kernel-policies.js -->
    </div>

    <!-- موصل بصري للنتيجة -->
    <div class="po-connector" aria-hidden="true">
      <div class="po-connector__line"></div>
      <div class="po-connector__arrow">▼</div>
    </div>

    <!-- العقدة الأخيرة: الإجراء (Action Node) -->
    <div class="po-node po-node--action" data-node-type="action">
      <div class="po-node__header">
        <span class="po-node__badge po-node__badge--action">الإجراء المستهدف</span>
        <span class="po-node__icon">⚡</span>
      </div>
      <div class="po-node__body">
        <div class="po-node__field">
          <label for="po-builder-action-select" class="po-node__label">إجراء الحوكمة</label>
          <select id="po-builder-action-select" class="po-node__select" data-po-builder-action>
            <option value="mask">◐ تعمية البيانات (Mask)</option>
            <option value="block">⊘ حظر الطلب (Block)</option>
            <option value="redact">✂️ حذف النص الحساس (Redact)</option>
            <option value="approve">⏱ موافقة بشرية (HITL)</option>
            <option value="warn">⚠️ تسجيل وتنبيه (Log)</option>
            <option value="local_model_only">🛡 نموذج محلي فقط (Local)</option>
          </select>
        </div>
        <div class="po-node__field po-node__field--risk">
          <label for="po-builder-risk-input" class="po-node__label">مُعدِّل المخاطر (+/-)</label>
          <input
            type="number"
            id="po-builder-risk-input"
            class="po-node__input"
            data-po-builder-risk
            min="0"
            max="50"
            value="10"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ لوحة المعاينة الحية بالنص العربي البسيط (Live Arabic Preview) ═══ -->
  <div class="po-builder-preview-box" data-po-builder-preview-wrap>
    <div class="po-builder-preview-head">
      <span class="po-builder-preview-icon">👁️</span>
      <h4 class="po-builder-preview-title">معاينة منطق السياسة بالعربية</h4>
      <span class="po-builder-preview-badge">Live Plain Arabic</span>
    </div>
    <div
      class="po-builder-preview-content"
      data-po-builder-arabic-preview
      role="region"
      aria-live="polite"
      aria-label="النص العربي للشروط"
    >
      جاري تحميل صياغة القاعدة…
    </div>
  </div>
</div>
