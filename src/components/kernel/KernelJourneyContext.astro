---
/**
 * KernelJourneyContext — K1 (2026-07-18)
 *
 * Component غير مرئي: يحقن <script> يقرأ / يكتب سياق الرحلة
 * في sessionStorage. الـ data المخزّنة:
 *
 *   {
 *     scenario: string  // scenario id (e.g. "pdpl-id-leak")
 *     sector:   string  // Sector enum
 *     riskBand: string  // RiskBand enum
 *     stage:    string  // JourneyStageId
 *     ts:       number  // timestamp ms
 *   }
 *
 * - لا PII على الإطلاق (لا اسم، لا بريد، لا هاتف)
 * - فقط بيانات وصفية (sector + riskBand + scenario id)
 * - sessionStorage يُمسح تلقائياً عند إغلاق التبويب
 * - BAI-P0-TRUTH-001: بدايت السياسة مرة واحدة — demo SSI، ما فيه toggle
 *   جوّال، فلا يبكي حدث kernel:demo-toggle (أُزيل من النظام)
 *
 * كيف يُستخدم:
 *   - <a data-scenario-link data-scenario-id="..." data-sector="..." data-risk-band="...">
 *       ← عند الـ click، يُحفَّظ الـ context في sessionStorage
 *   - <form data-kernel-lead-form>
 *       ← عند الـ submit، تُضاف القيم للـ payload
 *
 * Props:
 *   - id: string (افتراضي: 'k-journey-ctx')
 *   - active: boolean (افتراضي: true) — لتعطيل المكون على صفحات معينة
 */

import { JOURNEY_STORAGE_KEY, type JourneyContextPayload } from '../../data/kernel-journey';

interface Props {
  id?: string;
  active?: boolean;
}

const { id = 'k-journey-ctx', active = true } = Astro.props;
---

{active && (
  <div
    id={id}
    class="k-journey-ctx"
    hidden
    aria-hidden="true"
    data-kernel-journey-context
    data-journey-storage-key={JOURNEY_STORAGE_KEY}
  >
    {/* Marker element — no visible UI. The <script> below does the work. */}
  </div>
)}

<script>
  /**
   * K1 (2026-07-18) — kernel journey context store.
   * Wires:
   *  - <a data-scenario-link> → writes {scenario, sector, riskBand, stage} to sessionStorage
   *  - <form data-kernel-lead-form> → reads + injects as hidden fields before submit
   *  - <nav data-journey-progress> → updates the current stage on page load
   *  - <body data-journey-stage="..."> override → set on every page by KernelLayout
   */
  (function () {
    'use strict';

    var STORAGE_KEY = 'brightai-kernel-journey';

    function safeRead() {
      try {
        var raw = sessionStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        var data = JSON.parse(raw);
        if (!data || typeof data !== 'object') return null;
        return data;
      } catch (e) {
        return null;
      }
    }

    function safeWrite(payload) {
      try {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      } catch (e) {
        /* private mode / quota — silently drop */
      }
    }

    function safeClear() {
      try { sessionStorage.removeItem(STORAGE_KEY); } catch (e) {}
    }

    /** Read scenario metadata from a scenario link's data-* attributes. */
    function readScenarioLink(link) {
      var id = link.getAttribute('data-scenario-id');
      var sector = link.getAttribute('data-sector');
      var riskBand = link.getAttribute('data-risk-band');
      var stage = link.getAttribute('data-journey-stage') || 'scenario';
      if (!id || !sector || !riskBand) return null;
      return {
        scenario: id,
        sector: sector,
        riskBand: riskBand,
        stage: stage,
        ts: Date.now(),
      };
    }

    function wireScenarioLinks() {
      var links = document.querySelectorAll('[data-scenario-link]');
      links.forEach(function (link) {
        if (link.dataset.journeyBound === '1') return;
        link.dataset.journeyBound = '1';
        // Capture phase so we run before any other click handler
        link.addEventListener('click', function () {
          var payload = readScenarioLink(link);
          if (payload) safeWrite(payload);
        });
      });
    }

    /**
     * Inject hidden inputs into the kernel lead form so the form payload
     * includes scenario + sector + riskBand metadata (no PII).
     */
    function wireLeadForms() {
      var forms = document.querySelectorAll('form[data-kernel-lead-form-element]');
      if (!forms.length) return;
      var ctx = safeRead();
      forms.forEach(function (form) {
        if (form.dataset.journeyInjected === '1') return;
        // Always inject a stable set of hidden fields, even when ctx is null —
        // a missing field becomes empty string in the payload (not "undefined").
        var fields = ['scenario', 'sector', 'riskBand', 'journeyStage', 'journeyTs'];
        fields.forEach(function (name) {
          if (form.querySelector('input[name="' + name + '"]')) return;
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = name;
          input.setAttribute('data-kernel-journey-field', name);
          if (ctx) {
            if (name === 'scenario') input.value = ctx.scenario || '';
            else if (name === 'sector') input.value = ctx.sector || '';
            else if (name === 'riskBand') input.value = ctx.riskBand || '';
            else if (name === 'journeyStage') input.value = ctx.stage || '';
            else if (name === 'journeyTs') input.value = String(ctx.ts || '');
          } else {
            input.value = '';
          }
          form.appendChild(input);
        });
        form.dataset.journeyInjected = '1';

        // Refresh values just before submit (in case ctx changed mid-session)
        form.addEventListener('submit', function () {
          var latest = safeRead();
          if (!latest) return;
          ['scenario', 'sector', 'riskBand', 'journeyStage', 'journeyTs'].forEach(function (name) {
            var el = form.querySelector('input[name="' + name + '"]');
            if (!el) return;
            if (name === 'scenario') el.value = latest.scenario || '';
            else if (name === 'sector') el.value = latest.sector || '';
            else if (name === 'riskBand') el.value = latest.riskBand || '';
            else if (name === 'journeyStage') el.value = latest.stage || '';
            else if (name === 'journeyTs') el.value = String(latest.ts || '');
          });
        }, true);
      });
    }

    /** Update body data attribute so progress can re-derive on view transitions. */
    function wireBodyAttribute() {
      var progress = document.querySelector('[data-journey-progress]');
      if (!progress) return;
      var stage = progress.getAttribute('data-current-stage');
      if (stage) document.body.setAttribute('data-journey-stage', stage);
    }

    function init() {
      wireScenarioLinks();
      wireLeadForms();
      wireBodyAttribute();
    }

    // Astro view transitions
    document.addEventListener('astro:page-load', init);

    // Initial load (when no view transitions)
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
