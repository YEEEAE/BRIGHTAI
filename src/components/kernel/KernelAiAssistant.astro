---
/**
 * KernelAiAssistant — KERNEL-AI-2026-07-14
 *                  + KERNEL-AUDIT-2026-07-15-BATCH-2 (EXEC-02)
 *
 * قسم "جرّب بالذكاء الاصطناعي" قابل لإعادة الاستخدام في صفحات Kernel
 * الوظيفية (compliance / policies / evidence / audit / scenarios).
 *
 * يستدعي /api/ai/chat مع promptId من allowlist الخادم. الـ server يبحث
 * عن الـ systemPrompt الفعلي من KERNEL_SYSTEM_PROMPTS ويرسله للنموذج.
 * Fallback: لو الـ API رجع 404 (Render static أو hosting بدون serverless)
 * → يعرض "وضع تجريبي" + ردود توضيحية.
 *
 * يحفظ المحادثة في sessionStorage (مفتاح فريد لكل instance) ليحافظ على
 * السياق عند navigation بين الصفحات. لو sessionStorage غير متاح
 * (private mode) → يستخدم Map داخل الذاكرة فقط.
 *
 * Props:
 *   - promptId: 'compliance'|'policies'|'evidence'|'audit'|'scenarios' (مطلوب)
 *     — يُمرر للـ server كـ lookup key. الـ server لا يقبل systemPrompt
 *     نصّي من الـ client (KRN-001 / EXEC-01).
 *   - title: string (افتراضي: "مساعد الحوكمة")
 *   - subtitle: string (افتراضي: جملة توضيحية)
 *   - placeholder: string (افتراضي: مثال عام)
 *   - id: string (افتراضي: auto-generated) — لتفادي تعارض sessionStorage
 *   - maxTurns: number (افتراضي: 6) — حد أقصى للرسائل قبل CTA
 *
 * الأداء:
 *   - script is:inline + lazy init عبر astro:page-load
 *   - DOM diffing بسيط (no framework)
 *   - يحترم prefers-reduced-motion
 *
 * الأمان:
 *   - لا يستدعي Groq/Gemini مباشرة
 *   - لا يحفظ الـ systemPrompt في DOM (KRN-002 / EXEC-02)
 *   - يبعت promptId فقط (الـ server يبحث عن النص)
 */

interface Props {
  promptId: 'compliance' | 'policies' | 'evidence' | 'audit' | 'scenarios';
  title?: string;
  subtitle?: string;
  placeholder?: string;
  id?: string;
  maxTurns?: number;
}

const {
  promptId,
  title = 'مساعد الحوكمة',
  subtitle = 'اسأل سؤالاً متخصصاً في سياق السوق السعودي. كل سؤال يمر عبر طبقات الأمان قبل الوصول للنموذج.',
  placeholder = 'مثال: وش أحتاج عشان ألتزم PDPL في معالجة بيانات المرضى؟',
  id,
  maxTurns = 6,
} = Astro.props;

// معرّف فريد للـ instance
const instanceId =
  id ?? `kass-${Math.random().toString(36).slice(2, 9)}-${Date.now().toString(36)}`;

// إعدادات
const STORAGE_KEY = `kass-history-${instanceId}`;
const MAX_STORAGE_BYTES = 50_000; // ~50KB

const iconSend = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>';
const iconAi = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>';
---

<section
  class:list={['kernel-ai-assistant', 'kernel-card']}
  aria-labelledby={`${instanceId}-title`}
  data-kernel-ai-assistant
  data-instance-id={instanceId}
  data-prompt-id={promptId}
  data-max-turns={String(maxTurns)}
  data-storage-key={STORAGE_KEY}
>
  <header class="kernel-card__header">
    <div class="kernel-card__lead">
      <span class="kernel-card__icon" aria-hidden="true">
        <Fragment set:html={iconAi} />
      </span>
      <div class="kernel-card__title-block">
        <h3 class="kernel-card__title" id={`${instanceId}-title`}>{title}</h3>
        <span class="kernel-card__subtitle">{subtitle}</span>
      </div>
    </div>
    <div class="kernel-card__actions">
      <button
        type="button"
        class="kernel-ai-assistant__clear"
        data-kernel-ai-clear
        aria-label="مسح المحادثة"
        title="مسح المحادثة"
      >
        مسح المحادثة
      </button>
    </div>
  </header>

  <div class="kernel-card__body">
    {/* الرسائل */}
    <div
      class="kernel-ai-assistant__thread"
      data-kernel-ai-thread
      role="log"
      aria-live="polite"
      aria-busy="false"
      aria-relevant="additions"
    >
      <div class="kernel-ai-assistant__empty" data-kernel-ai-empty>
        <p>لم يبدأ أي سؤال بعد. اكتب سؤالك في الأسفل وستحصل على إجابة متخصصة.</p>
      </div>
    </div>

    {/* typing indicator — light 3-dot pulse, shows as soon as the request fires.
        Kept for snappy first-paint feedback. */}
    <div
      class="kernel-ai-assistant__typing"
      data-kernel-ai-typing
      role="status"
      aria-live="polite"
      hidden
    >
      <span class="sr-only">المساعد يكتب</span>
      <span class="kernel-ai-assistant__typing-dot" aria-hidden="true"></span>
      <span class="kernel-ai-assistant__typing-dot" aria-hidden="true"></span>
      <span class="kernel-ai-assistant__typing-dot" aria-hidden="true"></span>
    </div>

    {/* skeleton bubble (BAI-DESIGN-06) — shimmer placeholder for the AI reply.
        Mimics the actual response structure (3 lines of varying widths) so
        the user sees a recognizable "ghost message" while the model thinks.
        aria-hidden so screen readers get the typing indicator only, not a
        duplicated "loading" announcement. */}
    <div
      class="kernel-ai-assistant__skeleton"
      data-kernel-ai-skeleton
      aria-hidden="true"
      hidden
    >
      <span class="kernel-ai-assistant__skeleton-line kernel-ai-assistant__skeleton-line--lg"></span>
      <span class="kernel-ai-assistant__skeleton-line kernel-ai-assistant__skeleton-line--md"></span>
      <span class="kernel-ai-assistant__skeleton-line kernel-ai-assistant__skeleton-line--sm"></span>
    </div>

    {/* error banner (مخفي افتراضياً، يظهر عند الخطأ) */}
    <div data-kernel-ai-error-slot></div>

    {/* عداد الرسائل + CTA بعد 3 رسائل */}
    <div
      class="kernel-ai-assistant__cta"
      data-kernel-ai-cta
      hidden
    >
      <p>تبي تطبيق فعلي في منشأتك؟</p>
      <a
        href="#kernel-lead-form"
        class="btn btn--primary kernel-ai-assistant__cta-btn"
        data-kernel-ai-cta-link
      >
        تواصل مع فريق الحوكمة ←
      </a>
    </div>

    {/* حقل الإدخال */}
    <form
      class="kernel-ai-assistant__composer"
      data-kernel-ai-form
      data-prevent-default
      aria-label="حقل سؤال المساعد"
    >
      <label for={`${instanceId}-input`} class="visually-hidden" style="position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;">
        سؤالك
      </label>
      <textarea
        id={`${instanceId}-input`}
        class="kernel-ai-assistant__textarea"
        rows="2"
        placeholder={placeholder}
        data-kernel-ai-input
        maxlength="4000"
        aria-describedby={`${instanceId}-hint`}
      ></textarea>
      <div class="kernel-ai-assistant__composer-row">
        <span class="kernel-ai-assistant__hint" id={`${instanceId}-hint`}>
          <kbd>Enter</kbd> للإرسال · <kbd>Shift+Enter</kbd> سطر جديد
        </span>
        <button
          type="submit"
          class="kernel-ai-assistant__send"
          data-kernel-ai-send
          data-default-label="إرسال"
          aria-label="إرسال السؤال"
        >
          <span class="kernel-ai-assistant__send-spinner" aria-hidden="true" data-kai-spinner hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" width="16" height="16">
              <circle cx="12" cy="12" r="10" stroke-dasharray="31.4 31.4" stroke-dashoffset="0" />
            </svg>
          </span>
          <span aria-hidden="true" data-kai-send-icon><Fragment set:html={iconSend} /></span>
          <span data-kai-send-label>إرسال</span>
        </button>
      </div>
    </form>
  </div>
</section>

<style>
  .kernel-ai-assistant {
    --ai-max-height: 480px;
  }

  .kernel-ai-assistant__clear {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }
  .kernel-ai-assistant__clear:hover,
  .kernel-ai-assistant__clear:focus-visible {
    color: var(--text-primary);
    border-color: var(--interactive-primary);
  }
  .kernel-ai-assistant__clear:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
  }

  .kernel-ai-assistant__thread {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-block-size: var(--ai-max-height);
    overflow-y: auto;
    padding-block: var(--space-2);
    margin-block-end: var(--space-3);
  }

  .kernel-ai-assistant__empty {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-align: center;
    padding: var(--space-6) var(--space-3);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .kernel-ai-assistant__message {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }
  .kernel-ai-assistant__message--user {
    flex-direction: row-reverse;
  }
  .kernel-ai-assistant__avatar {
    inline-size: 32px;
    block-size: 32px;
    flex: 0 0 32px;
    border-radius: var(--radius-full);
    display: grid;
    place-items: center;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--text-inverse);
  }
  .kernel-ai-assistant__message--user .kernel-ai-assistant__avatar {
    background: var(--indigo-400);
  }
  .kernel-ai-assistant__message--ai .kernel-ai-assistant__avatar {
    background: var(--brand-500);
  }
  .kernel-ai-assistant__bubble {
    background: var(--bg-elevated);
    color: var(--text-primary);
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    line-height: 1.65;
    font-size: var(--text-sm);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .kernel-ai-assistant__message--user .kernel-ai-assistant__bubble {
    background: var(--bg-surface);
    border-color: var(--indigo-400);
  }
  .kernel-ai-assistant__meta {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-block-start: 2px;
  }

  .kernel-ai-assistant__typing {
    display: flex;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    margin-block-end: var(--space-2);
    align-items: center;
  }
  .kernel-ai-assistant__typing-dot {
    inline-size: 8px;
    block-size: 8px;
    background: var(--brand-500);
    border-radius: var(--radius-full);
    animation: kai-typing-bounce 1.2s var(--ease-in-out) infinite;
  }
  .kernel-ai-assistant__typing-dot:nth-child(2) { animation-delay: 0.15s; }
  .kernel-ai-assistant__typing-dot:nth-child(3) { animation-delay: 0.3s; }
  @keyframes kai-typing-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kernel-ai-assistant__typing-dot { animation: none; }
  }

  /* BAI-DESIGN-06: skeleton bubble (shimmer placeholder) — appears next to
     the typing dots while the AI is thinking. Mimics a 3-line response so
     the user sees a recognizable ghost message, not just an abstract
     spinner. Skeleton uses the same bubble shape as real AI messages
     (--bg-elevated, --radius-lg) so the layout doesn't jump when the
     response streams in. */
  .kernel-ai-assistant__skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    margin-block-end: var(--space-2);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    max-inline-size: 85%;
    inset-inline-start: 0; /* AI bubbles align inline-start in RTL */
  }
  .kernel-ai-assistant__skeleton-line {
    display: block;
    block-size: 12px;
    border-radius: var(--radius-full);
    background: linear-gradient(
      90deg,
      var(--bg-surface) 0%,
      rgba(148, 163, 184, 0.18) 50%,
      var(--bg-surface) 100%
    );
    background-size: 200% 100%;
    animation: kai-skeleton-shimmer 1.4s var(--ease-in-out) infinite;
  }
  .kernel-ai-assistant__skeleton-line--lg { inline-size: 92%; }
  .kernel-ai-assistant__skeleton-line--md { inline-size: 68%; }
  .kernel-ai-assistant__skeleton-line--sm { inline-size: 41%; }
  @keyframes kai-skeleton-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kernel-ai-assistant__skeleton-line {
      animation: none;
      background: var(--bg-surface);
    }
  }

  .kernel-ai-assistant__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--bg-elevated);
    border: 1px solid var(--brand-500);
    border-radius: var(--radius-lg);
    margin-block-end: var(--space-3);
    font-size: var(--text-sm);
  }
  .kernel-ai-assistant__cta p { margin: 0; color: var(--text-primary); }
  .kernel-ai-assistant__cta-btn {
    flex: 0 0 auto;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  .kernel-ai-assistant__composer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .kernel-ai-assistant__textarea {
    inline-size: 100%;
    background: var(--bg-base);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    font-family: inherit;
    /* KRN-017 fix: font-size: var(--text-base) (16px) prevents iOS Safari auto-zoom on focus */
    font-size: var(--text-base);
    line-height: 1.5;
    resize: vertical;
    min-block-size: 64px;
    max-block-size: 200px;
  }
  .kernel-ai-assistant__textarea:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
    border-color: var(--interactive-primary);
  }
  .kernel-ai-assistant__composer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .kernel-ai-assistant__hint {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
  .kernel-ai-assistant__hint kbd {
    background: var(--bg-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 0.7rem;
    font-family: var(--font-mono);
  }
  .kernel-ai-assistant__send {
    background: var(--brand-500);
    color: var(--text-inverse);
    border: 0;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: var(--font-bold);
    font-size: var(--text-sm);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: background var(--duration-fast) var(--ease-out);
  }
  .kernel-ai-assistant__send:hover,
  .kernel-ai-assistant__send:focus-visible {
    background: var(--brand-400);
  }
  .kernel-ai-assistant__send:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }
  .kernel-ai-assistant__send.is-loading,
  .kernel-ai-assistant__send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .kernel-ai-assistant__send-spinner {
    display: none;
    animation: kai-spin 0.6s linear infinite;
  }
  .kernel-ai-assistant__send-spinner[hidden] { display: none; }
  .kernel-ai-assistant__send.is-loading .kernel-ai-assistant__send-spinner {
    display: inline-block;
  }
  .kernel-ai-assistant__send.is-loading [data-kai-send-icon] {
    display: none;
  }
  .kernel-ai-assistant__send svg {
    inline-size: 16px;
    block-size: 16px;
  }
  @keyframes kai-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .kernel-ai-assistant__send-spinner { animation: none; }
  }

  .kernel-ai-assistant__retry-btn {
    background: transparent;
    color: var(--interactive-primary);
    border: 1px solid var(--interactive-primary);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    cursor: pointer;
    margin-block-start: var(--space-2);
    transition: background var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }
  .kernel-ai-assistant__retry-btn:hover,
  .kernel-ai-assistant__retry-btn:focus-visible {
    background: var(--interactive-primary);
    color: var(--text-inverse);
  }
  .kernel-ai-assistant__retry-btn:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .kernel-ai-assistant__cta {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
    .kernel-ai-assistant__hint {
      inline-size: 100%;
    }
  }
</style>

<script defer src="/js/kernel-ai-assistant.js"></script>
