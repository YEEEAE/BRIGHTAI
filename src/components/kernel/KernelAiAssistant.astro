---
/**
 * KernelAiAssistant — KERNEL-AI-2026-07-14
 *                  + KERNEL-AUDIT-2026-07-15-BATCH-2 (EXEC-02)
 *
 * قسم "جرّب بالذكاء الاصطناعي" قابل لإعادة الاستخدام في صفحات Kernel
 * الوظيفية (compliance / policies / evidence / audit / scenarios).
 *
 * يستدعي /api/ai/chat مع promptId من allowlist الخادم. الـ server يبحث
 * عن الـ systemPrompt الفعلي من KERNEL_SYSTEM_PROMPTS ويرسله للنموذج.
 * Fallback: لو الـ API رجع 404 (Render static أو hosting بدون serverless)
 * → يعرض "وضع تجريبي" + ردود توضيحية.
 *
 * يحفظ المحادثة في sessionStorage (مفتاح فريد لكل instance) ليحافظ على
 * السياق عند navigation بين الصفحات. لو sessionStorage غير متاح
 * (private mode) → يستخدم Map داخل الذاكرة فقط.
 *
 * Props:
 *   - promptId: 'compliance'|'policies'|'evidence'|'audit'|'scenarios' (مطلوب)
 *     — يُمرر للـ server كـ lookup key. الـ server لا يقبل systemPrompt
 *     نصّي من الـ client (KRN-001 / EXEC-01).
 *   - title: string (افتراضي: "مساعد الحوكمة")
 *   - subtitle: string (افتراضي: جملة توضيحية)
 *   - placeholder: string (افتراضي: مثال عام)
 *   - id: string (افتراضي: auto-generated) — لتفادي تعارض sessionStorage
 *   - maxTurns: number (افتراضي: 6) — حد أقصى للرسائل قبل CTA
 *
 * الأداء:
 *   - script is:inline + lazy init عبر astro:page-load
 *   - DOM diffing بسيط (no framework)
 *   - يحترم prefers-reduced-motion
 *
 * الأمان:
 *   - لا يستدعي Groq/Gemini مباشرة
 *   - لا يحفظ الـ systemPrompt في DOM (KRN-002 / EXEC-02)
 *   - يبعت promptId فقط (الـ server يبحث عن النص)
 */

interface Props {
  promptId: 'compliance' | 'policies' | 'evidence' | 'audit' | 'scenarios';
  title?: string;
  subtitle?: string;
  placeholder?: string;
  id?: string;
  maxTurns?: number;
}

const {
  promptId,
  title = 'مساعد الحوكمة',
  subtitle = 'اسأل سؤالاً متخصصاً في سياق السوق السعودي. كل سؤال يمر عبر طبقات الأمان قبل الوصول للنموذج.',
  placeholder = 'مثال: وش أحتاج عشان ألتزم PDPL في معالجة بيانات المرضى؟',
  id,
  maxTurns = 6,
} = Astro.props;

// معرّف فريد للـ instance
const instanceId =
  id ?? `kass-${Math.random().toString(36).slice(2, 9)}-${Date.now().toString(36)}`;

// إعدادات
const STORAGE_KEY = `kass-history-${instanceId}`;
const MAX_STORAGE_BYTES = 50_000; // ~50KB

const iconSend = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>';
const iconAi = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>';
---

<section
  class:list={['kernel-ai-assistant', 'kernel-card']}
  aria-labelledby={`${instanceId}-title`}
  data-kernel-ai-assistant
  data-instance-id={instanceId}
  data-prompt-id={promptId}
  data-max-turns={String(maxTurns)}
  data-storage-key={STORAGE_KEY}
>
  <header class="kernel-card__header">
    <div class="kernel-card__lead">
      <span class="kernel-card__icon" aria-hidden="true">
        <Fragment set:html={iconAi} />
      </span>
      <div class="kernel-card__title-block">
        <h3 class="kernel-card__title" id={`${instanceId}-title`}>{title}</h3>
        <span class="kernel-card__subtitle">{subtitle}</span>
      </div>
    </div>
    <div class="kernel-card__actions">
      <button
        type="button"
        class="kernel-ai-assistant__clear"
        data-kernel-ai-clear
        aria-label="مسح المحادثة"
        title="مسح المحادثة"
      >
        مسح المحادثة
      </button>
    </div>
  </header>

  <div class="kernel-card__body">
    {/* الرسائل */}
    <div
      class="kernel-ai-assistant__thread"
      data-kernel-ai-thread
      role="log"
      aria-live="polite"
      aria-busy="false"
      aria-relevant="additions"
    >
      <div class="kernel-ai-assistant__empty" data-kernel-ai-empty>
        <p>لم يبدأ أي سؤال بعد. اكتب سؤالك في الأسفل وستحصل على إجابة متخصصة.</p>
      </div>
    </div>

    {/* typing indicator */}
    <div
      class="kernel-ai-assistant__typing"
      data-kernel-ai-typing
      role="status"
      aria-live="polite"
      hidden
    >
      <span class="sr-only">المساعد يكتب</span>
      <span class="kernel-ai-assistant__typing-dot" aria-hidden="true"></span>
      <span class="kernel-ai-assistant__typing-dot" aria-hidden="true"></span>
      <span class="kernel-ai-assistant__typing-dot" aria-hidden="true"></span>
    </div>

    {/* error banner (مخفي افتراضياً، يظهر عند الخطأ) */}
    <div data-kernel-ai-error-slot></div>

    {/* عداد الرسائل + CTA بعد 3 رسائل */}
    <div
      class="kernel-ai-assistant__cta"
      data-kernel-ai-cta
      hidden
    >
      <p>تبي تطبيق فعلي في منشأتك؟</p>
      <a
        href="#kernel-lead-form"
        class="btn btn--primary kernel-ai-assistant__cta-btn"
        data-kernel-ai-cta-link
      >
        تواصل مع فريق الحوكمة ←
      </a>
    </div>

    {/* حقل الإدخال */}
    <form
      class="kernel-ai-assistant__composer"
      data-kernel-ai-form
      data-prevent-default
      aria-label="حقل سؤال المساعد"
    >
      <label for={`${instanceId}-input`} class="visually-hidden" style="position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;">
        سؤالك
      </label>
      <textarea
        id={`${instanceId}-input`}
        class="kernel-ai-assistant__textarea"
        rows="2"
        placeholder={placeholder}
        data-kernel-ai-input
        maxlength="4000"
        aria-describedby={`${instanceId}-hint`}
      ></textarea>
      <div class="kernel-ai-assistant__composer-row">
        <span class="kernel-ai-assistant__hint" id={`${instanceId}-hint`}>
          <kbd>Enter</kbd> للإرسال · <kbd>Shift+Enter</kbd> سطر جديد
        </span>
        <button
          type="submit"
          class="kernel-ai-assistant__send"
          data-kernel-ai-send
          aria-label="إرسال السؤال"
        >
          <span aria-hidden="true"><Fragment set:html={iconSend} /></span>
          <span>إرسال</span>
        </button>
      </div>
    </form>
  </div>
</section>

<style>
  .kernel-ai-assistant {
    --ai-max-height: 480px;
  }

  .kernel-ai-assistant__clear {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }
  .kernel-ai-assistant__clear:hover,
  .kernel-ai-assistant__clear:focus-visible {
    color: var(--text-primary);
    border-color: var(--interactive-primary);
  }
  .kernel-ai-assistant__clear:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
  }

  .kernel-ai-assistant__thread {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-block-size: var(--ai-max-height);
    overflow-y: auto;
    padding-block: var(--space-2);
    margin-block-end: var(--space-3);
  }

  .kernel-ai-assistant__empty {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    text-align: center;
    padding: var(--space-6) var(--space-3);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .kernel-ai-assistant__message {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }
  .kernel-ai-assistant__message--user {
    flex-direction: row-reverse;
  }
  .kernel-ai-assistant__avatar {
    inline-size: 32px;
    block-size: 32px;
    flex: 0 0 32px;
    border-radius: var(--radius-full);
    display: grid;
    place-items: center;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--text-inverse);
  }
  .kernel-ai-assistant__message--user .kernel-ai-assistant__avatar {
    background: var(--indigo-400);
  }
  .kernel-ai-assistant__message--ai .kernel-ai-assistant__avatar {
    background: var(--brand-500);
  }
  .kernel-ai-assistant__bubble {
    background: var(--bg-elevated);
    color: var(--text-primary);
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    line-height: 1.65;
    font-size: var(--text-sm);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .kernel-ai-assistant__message--user .kernel-ai-assistant__bubble {
    background: var(--bg-surface);
    border-color: var(--indigo-400);
  }
  .kernel-ai-assistant__meta {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-block-start: 2px;
  }

  .kernel-ai-assistant__typing {
    display: flex;
    gap: 4px;
    padding: var(--space-2) var(--space-3);
    margin-block-end: var(--space-2);
    align-items: center;
  }
  .kernel-ai-assistant__typing-dot {
    inline-size: 8px;
    block-size: 8px;
    background: var(--brand-500);
    border-radius: var(--radius-full);
    animation: kai-typing-bounce 1.2s var(--ease-in-out) infinite;
  }
  .kernel-ai-assistant__typing-dot:nth-child(2) { animation-delay: 0.15s; }
  .kernel-ai-assistant__typing-dot:nth-child(3) { animation-delay: 0.3s; }
  @keyframes kai-typing-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kernel-ai-assistant__typing-dot { animation: none; }
  }

  .kernel-ai-assistant__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--bg-elevated);
    border: 1px solid var(--brand-500);
    border-radius: var(--radius-lg);
    margin-block-end: var(--space-3);
    font-size: var(--text-sm);
  }
  .kernel-ai-assistant__cta p { margin: 0; color: var(--text-primary); }
  .kernel-ai-assistant__cta-btn {
    flex: 0 0 auto;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  .kernel-ai-assistant__composer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .kernel-ai-assistant__textarea {
    inline-size: 100%;
    background: var(--bg-base);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    font-family: inherit;
    /* KRN-017 fix: font-size: var(--text-base) (16px) prevents iOS Safari auto-zoom on focus */
    font-size: var(--text-base);
    line-height: 1.5;
    resize: vertical;
    min-block-size: 64px;
    max-block-size: 200px;
  }
  .kernel-ai-assistant__textarea:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
    border-color: var(--interactive-primary);
  }
  .kernel-ai-assistant__composer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .kernel-ai-assistant__hint {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
  .kernel-ai-assistant__hint kbd {
    background: var(--bg-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 0.7rem;
    font-family: var(--font-mono);
  }
  .kernel-ai-assistant__send {
    background: var(--brand-500);
    color: var(--text-inverse);
    border: 0;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: var(--font-bold);
    font-size: var(--text-sm);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: background var(--duration-fast) var(--ease-out);
  }
  .kernel-ai-assistant__send:hover,
  .kernel-ai-assistant__send:focus-visible {
    background: var(--brand-400);
  }
  .kernel-ai-assistant__send:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }
  .kernel-ai-assistant__send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .kernel-ai-assistant__send svg {
    inline-size: 16px;
    block-size: 16px;
  }

  @media (max-width: 640px) {
    .kernel-ai-assistant__cta {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
    .kernel-ai-assistant__hint {
      inline-size: 100%;
    }
  }
</style>

<script is:inline>
  (function () {
    'use strict';

    var DEMO_RESPONSES = [
      'في وضع البيانات التوضيحية، هذا نموذج لإجابة المساعد الذكي. في البيئة الإنتاجية، يتم استدعاء نموذج لغوي كبير عبر /api/ai/chat مع طبقات حوكمة (PDPL filter + risk scoring + policy match). جرّب سؤالاً متخصصاً في مجال هذه الصفحة وستحصل على رد مخصص في الإنتاج.',
      'في الوضع التجريبي: تتطلب هذه الحالة مراجعة سياسات المؤسسة وإطار PDPL قبل أي تنفيذ. فعّل نقطة الاتصال /api/ai/chat في بيئتك (Vercel أو @astrojs/node على Render) لتفعيل الردود الفعلية.',
      'وضع تجريبي: تذكّر — كل استدعاء AI في BrightAI Kernel يمر عبر فلتر PII، تقييم مخاطر، فحص سياسات، ثم توثيق الدليل. لمشاهدة المكدس الكامل، افتح /kernel/audit/ و /kernel/evidence/.',
    ];

    function $(q, root) { return (root || document).querySelector(q); }
    function $$(q, root) { return Array.prototype.slice.call((root || document).querySelectorAll(q)); }
    function pickDemo() { return DEMO_RESPONSES[Math.floor(Math.random() * DEMO_RESPONSES.length)]; }

    function safeStorage() {
      try {
        var t = '__kass_test__';
        window.sessionStorage.setItem(t, '1');
        window.sessionStorage.removeItem(t);
        return window.sessionStorage;
      } catch (e) { return null; }
    }

    function loadHistory(storage, key) {
      if (!storage) return [];
      try {
        var raw = storage.getItem(key);
        if (!raw) return [];
        var parsed = JSON.parse(raw);
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) { return []; }
    }

    function saveHistory(storage, key, history) {
      if (!storage) return;
      try {
        var raw = JSON.stringify(history);
        if (raw.length > 50000) {
          history = history.slice(-10); // keep last 10 turns if too long
          raw = JSON.stringify(history);
        }
        storage.setItem(key, raw);
      } catch (e) { /* ignore quota errors silently */ }
    }

    function renderMessage(thread, role, text) {
      // إخفاء empty state إن وُجد
      var empty = $('.kernel-ai-assistant__empty', thread);
      if (empty) empty.remove();

      var article = document.createElement('article');
      article.className = 'kernel-ai-assistant__message kernel-ai-assistant__message--' + role;

      var avatar = document.createElement('span');
      avatar.className = 'kernel-ai-assistant__avatar';
      avatar.setAttribute('aria-hidden', 'true');
      avatar.textContent = role === 'user' ? 'ي' : 'AI';
      article.appendChild(avatar);

      var wrapper = document.createElement('div');
      wrapper.style.flex = '1';
      wrapper.style.minInlineSize = '0';

      var bubble = document.createElement('div');
      bubble.className = 'kernel-ai-assistant__bubble';
      bubble.textContent = text;
      wrapper.appendChild(bubble);

      var meta = document.createElement('span');
      meta.className = 'kernel-ai-assistant__meta';
      meta.textContent = 'الآن · ' + (role === 'user' ? 'سؤالك' : 'المساعد');
      wrapper.appendChild(meta);

      article.appendChild(wrapper);
      thread.appendChild(article);

      // scroll to end
      thread.scrollTop = thread.scrollHeight;
      return article;
    }

    function streamInto(bubble, text, onDone) {
      // عرض النص كاملاً (بدون streaming فعلي لأن chat.ts يرجع النص دفعة واحدة)
      // مع تأثير "ظهور تدريجي" يحترم prefers-reduced-motion
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) {
        bubble.textContent = text;
        if (onDone) onDone();
        return;
      }
      var chars = Array.from(text);
      var idx = 0;
      bubble.textContent = '';
      var interval = setInterval(function () {
        if (idx >= chars.length) {
          clearInterval(interval);
          if (onDone) onDone();
          return;
        }
        bubble.textContent += chars[idx];
        idx++;
      }, 14);
    }

    function showError(slot, type, retryAfterSec) {
      slot.innerHTML = '';
      var banner = document.createElement('div');
      banner.className = 'kernel-chat-policy-banner kernel-chat-policy-banner--' + (type === 'rate_limit' || type === 'network' || type === 'timeout' ? 'warning' : type === 'unavailable' ? 'info' : 'danger');
      banner.setAttribute('role', 'alert');
      banner.setAttribute('aria-live', 'polite');

      var title, msg;
      switch (type) {
        case 'rate_limit':
          title = 'تم تجاوز حد الطلبات';
          msg = retryAfterSec ? 'حاول بعد ' + retryAfterSec + ' ثانية.' : 'حاول بعد لحظات.';
          break;
        case 'unavailable':
          title = 'المساعد في وضع تجريبي';
          msg = 'نقطة الاتصال /api/ai/chat غير متاحة في هذه البيئة. سترى ردوداً توضيحية. للتفعيل الكامل، تواصل مع فريق BrightAI.';
          break;
        case 'provider_failed':
          title = 'المزود الذكي غير متاح مؤقتاً';
          msg = 'حاول مرة ثانية خلال دقيقة.';
          break;
        case 'network':
          title = 'تعذّر الاتصال';
          msg = 'تحقق من اتصالك بالإنترنت.';
          break;
        case 'timeout':
          title = 'انتهت مهلة الاستجابة';
          msg = 'حاول بسؤال أقصر.';
          break;
        default:
          title = 'حدث خطأ غير متوقع';
          msg = 'حاول مرة ثانية.';
      }

      banner.innerHTML =
        '<span class="kernel-chat-policy-banner__icon" aria-hidden="true">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>' +
        '</span>' +
        '<div class="kernel-chat-policy-banner__body">' +
          '<p class="kernel-chat-policy-banner__title">' + title + '</p>' +
          '<p class="kernel-chat-policy-banner__msg">' + msg + '</p>' +
        '</div>';

      slot.appendChild(banner);
    }

    function hideError(slot) {
      slot.innerHTML = '';
    }

    function init() {
      $$('[data-kernel-ai-assistant]').forEach(function (root) {
        if (root.dataset.bound === '1') return;
        root.dataset.bound = '1';

        var form = $('[data-kernel-ai-form]', root);
        var input = $('[data-kernel-ai-input]', root);
        var sendBtn = $('[data-kernel-ai-send]', root);
        var thread = $('[data-kernel-ai-thread]', root);
        var typing = $('[data-kernel-ai-typing]', root);
        var errorSlot = $('[data-kernel-ai-error-slot]', root);
        var cta = $('[data-kernel-ai-cta]', root);
        var ctaLink = $('[data-kernel-ai-cta-link]', root);
        var clearBtn = $('[data-kernel-ai-clear]', root);

        if (!form || !input || !thread) return;

        var promptId = root.dataset.promptId || '';
        var maxTurns = parseInt(root.dataset.maxTurns, 10) || 6;
        var storageKey = root.dataset.storageKey;
        var storage = safeStorage();
        var apiAvailability = null; // null = untested, true = ok, false = 404
        var userTurnCount = 0;
        var currentController = null;

        // استرجاع المحادثة من sessionStorage
        var history = loadHistory(storage, storageKey);
        if (history.length > 0) {
          history.forEach(function (turn) {
            renderMessage(thread, turn.role, turn.text);
          });
          userTurnCount = history.filter(function (t) { return t.role === 'user'; }).length;
          if (userTurnCount >= 3) cta.hidden = false;
        }

        // مسح المحادثة
        if (clearBtn) {
          clearBtn.addEventListener('click', function () {
            if (currentController) {
              currentController.abort();
              currentController = null;
            }
            history = [];
            if (storage) storage.removeItem(storageKey);
            thread.innerHTML = '<div class="kernel-ai-assistant__empty" data-kernel-ai-empty><p>لم يبدأ أي سؤال بعد. اكتب سؤالك في الأسفل وستحصل على إجابة متخصصة.</p></div>';
            cta.hidden = true;
            userTurnCount = 0;
            input.focus();
          });
        }

        // CTA link → smooth scroll to lead form
        if (ctaLink) {
          ctaLink.addEventListener('click', function (e) {
            var targetId = ctaLink.getAttribute('href');
            if (targetId && targetId.startsWith('#')) {
              var target = document.querySelector(targetId);
              if (target) {
                e.preventDefault();
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                var firstInput = target.querySelector('input,textarea');
                if (firstInput) setTimeout(function () { firstInput.focus(); }, 400);
              }
            }
          });
        }

        function send() {
          var raw = input.value;
          if (!raw || !raw.trim()) return;

          var userText = raw.trim();
          input.value = '';
          if (sendBtn) sendBtn.disabled = true;
          hideError(errorSlot);
          typing.hidden = false;
          thread.setAttribute('aria-busy', 'true');

          // ارسم رسالة المستخدم
          renderMessage(thread, 'user', userText);
          history.push({ role: 'user', text: userText });
          saveHistory(storage, storageKey, history);

          // عند 3+ رسائل، أظهر CTA
          userTurnCount++;
          if (userTurnCount >= 3 && cta) cta.hidden = false;

          function finalize(text, isDemo) {
            typing.hidden = true;
            var article = renderMessage(thread, 'ai', '');
            streamInto(article.querySelector('.kernel-ai-assistant__bubble'), text, function () {
              thread.setAttribute('aria-busy', 'false');
              if (sendBtn) sendBtn.disabled = false;
              input.focus();
            });
            history.push({ role: 'ai', text: text, demo: !!isDemo });
            saveHistory(storage, storageKey, history);
          }

          // لو الـ API مو متاح (404 سابقاً) → demo مباشرة
          if (apiAvailability === false) {
            showError(errorSlot, 'unavailable');
            setTimeout(function () {
              finalize(pickDemo(), true);
            }, 600);
            return;
          }

          var activeControllers = window.__kassActiveControllers || [];
          window.__kassActiveControllers = activeControllers;

          if (!window.__kassNavListenerBound) {
            window.__kassNavListenerBound = true;
            document.addEventListener('astro:before-preparation', function () {
              while (activeControllers.length > 0) {
                var ctrl = activeControllers.pop();
                if (ctrl) ctrl.abort();
              }
            });
          }

          if (currentController) {
            currentController.abort();
          }
          currentController = new AbortController();
          activeControllers.push(currentController);

          function handleStream(res) {
            var reader = res.body.getReader();
            var decoder = new TextDecoder('utf-8');
            var buffer = '';
            var fullReplyText = '';
            var bubble = null;
            var messageArticle = null;

            var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            function finishStream() {
              var idx = activeControllers.indexOf(currentController);
              if (idx > -1) activeControllers.splice(idx, 1);
              currentController = null;

              thread.setAttribute('aria-busy', 'false');
              if (sendBtn) sendBtn.disabled = false;
              input.focus();
            }

            function processEvent(event, dataStr) {
              try {
                var data = JSON.parse(dataStr);
                if (event === 'token') {
                  if (data.delta) {
                    fullReplyText += data.delta;
                    if (!bubble) {
                      typing.hidden = true;
                      messageArticle = renderMessage(thread, 'ai', '');
                      bubble = messageArticle.querySelector('.kernel-ai-assistant__bubble');
                    }
                    if (!reduceMotion) {
                      bubble.textContent = fullReplyText;
                      thread.scrollTop = thread.scrollHeight;
                    }
                  }
                } else if (event === 'done') {
                  if (!bubble) {
                    typing.hidden = true;
                    messageArticle = renderMessage(thread, 'ai', '');
                    bubble = messageArticle.querySelector('.kernel-ai-assistant__bubble');
                  }
                  if (reduceMotion) {
                    bubble.textContent = fullReplyText;
                    thread.scrollTop = thread.scrollHeight;
                  }
                  history.push({ role: 'ai', text: fullReplyText, demo: false });
                  saveHistory(storage, storageKey, history);
                } else if (event === 'error') {
                  showError(errorSlot, 'provider_failed');
                  if (!bubble) {
                    typing.hidden = true;
                  }
                }
              } catch (e) {
                // Ignore malformed JSON frames
              }
            }

            function read() {
              return reader.read().then(function (result) {
                if (result.done) {
                  finishStream();
                  return;
                }
                buffer += decoder.decode(result.value, { stream: true });
                var lines = buffer.split('\n');
                buffer = lines.pop();

                var currentEvent = '';
                for (var i = 0; i < lines.length; i++) {
                  var line = lines[i].trim();
                  if (!line) continue;

                  if (line.indexOf('event: ') === 0) {
                    currentEvent = line.slice(7).trim();
                  } else if (line.indexOf('data: ') === 0) {
                    var dataStr = line.slice(6).trim();
                    processEvent(currentEvent, dataStr);
                  }
                }
                return read();
              }).catch(function (err) {
                if (err.name === 'AbortError') return;
                showError(errorSlot, 'network');
                typing.hidden = true;
                thread.setAttribute('aria-busy', 'false');
                if (sendBtn) sendBtn.disabled = false;
              });
            }

            return read();
          }

          // جرّب /api/ai/chat/ (مع trailing slash لتفادي 301 → method change)
          // KRN-001 / EXEC-02: نرسل promptId فقط — السيرفر يرفض أي prompt نصي من العميل.
          // السيرفر يبحث عن النص الفعلي من allowlist الخادم (server-side).
          fetch('/api/ai/chat/', {
            method: 'POST',
            headers: {
              'Accept': 'text/event-stream, application/json',
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ message: userText, promptId: promptId, provider: 'auto' }),
            signal: currentController.signal
          })
            .then(function (res) {
              if (res.status === 404) {
                apiAvailability = false;
                showError(errorSlot, 'unavailable');
                return null;
              }
              if (res.status === 429) {
                var retryAfter = parseInt(res.headers.get('Retry-After') || '60', 10);
                showError(errorSlot, 'rate_limit', retryAfter);
                return null;
              }
              if (res.status === 502) {
                showError(errorSlot, 'provider_failed');
                return null;
              }
              if (res.status === 504) {
                showError(errorSlot, 'timeout');
                return null;
              }
              if (!res.ok) {
                showError(errorSlot, 'unknown');
                return null;
              }

              var contentType = res.headers.get('content-type') || '';
              if (contentType.indexOf('text/event-stream') > -1) {
                apiAvailability = true;
                return handleStream(res);
              } else {
                return res.json().then(function (data) {
                  if (!data) return;
                  if (data && data.reply) {
                    apiAvailability = true;
                    finalize(data.reply, false);
                  } else {
                    showError(errorSlot, 'unknown');
                    typing.hidden = true;
                    thread.setAttribute('aria-busy', 'false');
                    if (sendBtn) sendBtn.disabled = false;
                  }
                });
              }
            })
            .catch(function (err) {
              if (err.name === 'AbortError') return;
              showError(errorSlot, 'network');
              typing.hidden = true;
              thread.setAttribute('aria-busy', 'false');
              if (sendBtn) sendBtn.disabled = false;
            });
        }

        form.addEventListener('submit', function (e) { e.preventDefault(); send(); });
        if (sendBtn) sendBtn.addEventListener('click', send);
        input.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            send();
          }
        });
      });
    }

    document.addEventListener('astro:page-load', init);
    if (document.readyState !== 'loading') init();
  })();
</script>
