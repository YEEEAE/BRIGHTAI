---
/**
 * KernelConsentModal — بوابة موافقة بنص عربي بسيط (Prompt 12).
 *
 * يحل محل النص القانوني القديم في /kernel/replay/ بنص واضح + مؤشرات بصرية
 * (✅/❌) + أيقونات لكل قسم. الهدف: رفع الفهم والتحويل وتقليل drop-off.
 *
 * يحافظ على DOM contract الخاص بـ M20 security gate (data-rp-consent*)
 * حتى يستمر محرك kernel-time-machine.js في العمل دون تغيير جذري:
 *   [data-rp-consent]            → حاوية المودال (dialog)
 *   [data-rp-consent-text]       → فقرة الإفصاح الديناميكية (العدد)
 *   [data-rp-consent-approve]    → زر الموافقة والإرسال
 *   [data-rp-consent-local]      → زر التشغيل المحلي (البديل الآمن)
 *   [data-rp-consent-cancel]     → زر الإلغاء
 *
 * Accessibility: role=dialog + aria-modal + aria-labelledby + focus على أول زر.
 * RTL: خصائص منطقية. prefers-reduced-motion: لا حركة.
 *
 * القيود: vanilla CSS (توكنز التصميم)، عامية سعودية، الأرقام لاتينية.
 */
interface Props {
  /** عدد الطلبات التاريخية (يُحقن ديناميكياً من المحرك) */
  count?: number;
  /** عنوان المودال */
  title?: string;
  /** نص زر الموافقة */
  approveLabel?: string;
  /** نص زر التشغيل المحلي */
  localLabel?: string;
  /** نص زر الإلغاء */
  cancelLabel?: string;
}

const {
  count = 0,
  title = '⚠️ قبل ما نكمل',
  approveLabel = '✅ موافق، أكمل المقارنة',
  localLabel = 'شغّل محلياً (لا إرسال)',
  cancelLabel = '❌ لا، ألغِ',
} = Astro.props;
---

<div class="rp-consent" data-rp-consent role="dialog" aria-modal="true" aria-labelledby="rp-consent-title" aria-hidden="true" hidden>
  <div class="rp-consent__box">
    <div class="rp-consent__head">
      <h2 id="rp-consent-title" class="rp-consent__title">{title}</h2>
    </div>

    <div class="rp-consent__body">
      <!-- فقرة الإفصاح البسيطة — العدد يُحقن ديناميكياً من المحرك -->
      <p class="rp-consent__simple" data-rp-consent-text>
        عشان نقارن السياسة الجديدة بالقديمة، نحتاج نرسل <strong>{count} طلب قديم</strong> للنموذج.
      </p>

      <!-- وش بنرسل؟ -->
      <div class="rp-consent__details">
        <h3 class="rp-consent__details-title">📦 وش بنرسل؟</h3>
        <ul class="rp-consent__list">
          <li class="rp-consent__item rp-consent__item--ok">
            <span class="rp-consent__mark" aria-hidden="true">✅</span>
            <span>نصوص الطلبات فقط</span>
          </li>
          <li class="rp-consent__item rp-consent__item--no">
            <span class="rp-consent__mark" aria-hidden="true">❌</span>
            <span>لا بيانات شخصية</span>
          </li>
          <li class="rp-consent__item rp-consent__item--no">
            <span class="rp-consent__mark" aria-hidden="true">❌</span>
            <span>لا أسماء أو أرقام هواتف</span>
          </li>
        </ul>
      </div>

      <!-- كيف بنحمي بياناتك؟ -->
      <div class="rp-consent__details">
        <h3 class="rp-consent__details-title">🔒 كيف بنحمي بياناتك؟</h3>
        <ul class="rp-consent__list">
          <li class="rp-consent__item rp-consent__item--ok">
            <span class="rp-consent__mark" aria-hidden="true">✅</span>
            <span>البيانات مشفرة</span>
          </li>
          <li class="rp-consent__item rp-consent__item--ok">
            <span class="rp-consent__mark" aria-hidden="true">✅</span>
            <span>تُحذف بعد المقارنة</span>
          </li>
          <li class="rp-consent__item rp-consent__item--ok">
            <span class="rp-consent__mark" aria-hidden="true">✅</span>
            <span>لا تُستخدم للتدريب</span>
          </li>
        </ul>
      </div>

      <!-- ملاحظة الأمان (M20) -->
      <div class="rp-consent__note">
        <span aria-hidden="true">🛡️</span>
        <span>بديلك الآمن دائمًا: «شغّل محلياً» — نفس النتيجة بدون أي إرسال.</span>
      </div>
    </div>

    <div class="rp-consent__actions">
      <button class="rp-consent__btn rp-consent__btn--local" type="button" data-rp-consent-local>{localLabel}</button>
      <button class="rp-consent__btn rp-consent__btn--approve" type="button" data-rp-consent-approve>{approveLabel}</button>
      <button class="rp-consent__btn rp-consent__btn--cancel" type="button" data-rp-consent-cancel>{cancelLabel}</button>
    </div>
  </div>
</div>