---
/**
 * KernelRecommendedJourney — P1 (2026-08-04) Role-Based Personalized Journey
 *
 * يعرض رحلة موصى بها (3 خطوات كحد أقصى) حسب الدور المختار.
 * يقرأ الدور من localStorage (`brightai-kernel-role`) — نفس المفتاح
 * اللي يستخدمه kernel-shell.js في السايدبار.
 *
 * التكامل:
 *  - يستمع لحدث `kernel:role-change` (يطلقه KernelRoleSelector) فيحدّث
 *    الرحلة فوراً بدون reload.
 *  - لو ما في دور محفوظ: يعرض رسالة "اختر دورك" بدل الرحلة.
 *  - كل خطوة لها CTA واضح (رابط) + رقم تسلسلي.
 *
 * قواعد:
 *  - 3 خطوات كحد أقصى (لا أكثر).
 *  - RTL كامل + logical properties.
 *  - Accessibility: قائمة روابط حقيقية + aria-label لكل خطوة.
 *  - prefers-reduced-motion محترم.
 *  - لا PII.
 */
const journeys = {
  ciso: [
    { step: 1, label: 'راجع حالة الامتثال', href: '/kernel/compliance/', hint: 'شوف أين تقف من PDPL وNCA ECC' },
    { step: 2, label: 'افحص سجل التدقيق', href: '/kernel/audit/', hint: 'راجع القرارات والـ hash chain' },
    { step: 3, label: 'راجع الأدلة', href: '/kernel/evidence/', hint: 'ملفات جاهزة للجهات الرقابية' },
  ],
  compliance: [
    { step: 1, label: 'راجع الفجوات', href: '/kernel/compliance/', hint: 'تحليل الفجوات حسب الإطار' },
    { step: 2, label: 'ولّد الأدلة', href: '/kernel/evidence/', hint: 'أدلة PDF موقّعة لكل قرار' },
    { step: 3, label: 'أنشئ تقرير', href: '/kernel/reports/', hint: 'تقرير تنفيذي للإدارة' },
  ],
  developer: [
    { step: 1, label: 'اقرأ التوثيق', href: '/kernel/api/', hint: 'نقاط النهاية والـ SDK' },
    { step: 2, label: 'جرب الملعب', href: '/kernel/playground/', hint: 'اختبر السياسات على طلباتك' },
    { step: 3, label: 'اربط نماذجك', href: '/kernel/connectors/', hint: 'اربط الأنظمة والنماذج' },
  ],
  employee: [
    { step: 1, label: 'ابدأ محادثة آمنة', href: '/kernel/chat/', hint: 'استخدم AI بضوابط حوكمة' },
    { step: 2, label: 'جرب الملعب', href: '/kernel/playground/', hint: 'افهم كيف يحمي Kernel طلباتك' },
  ],
};

const roleLabels = {
  ciso: 'CISO / DPO',
  compliance: 'مسؤول امتثال',
  developer: 'مطوّر',
  employee: 'موظف',
};
---

<section class="kernel-recommended-journey" data-kernel-recommended-journey aria-labelledby="kernel-recommended-journey-title">
  <div class="kernel-recommended-journey__head">
    <h2 id="kernel-recommended-journey-title" class="kernel-recommended-journey__title">رحلتك الموصى بها</h2>
    <p class="kernel-recommended-journey__role" data-kernel-journey-role-label>اختر دورك لتبدأ</p>
  </div>

  <ol class="kernel-recommended-journey__list" data-kernel-journey-list role="list">
    <!-- Rendered by JS based on saved role -->
  </ol>

  <p class="kernel-recommended-journey__empty" data-kernel-journey-empty>
    اختر دورك من الأعلى (أو من الشريط الجانبي) عشان نشوف لك المسار الأنسب.
  </p>
</section>

<style>
  .kernel-recommended-journey {
    margin: var(--space-4) 0 var(--space-6);
    padding: var(--space-5) var(--space-4);
    background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-base) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .kernel-recommended-journey__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin: 0 0 var(--space-4);
  }
  .kernel-recommended-journey__title {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--text-primary);
  }
  .kernel-recommended-journey__role {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--interactive-primary);
    font-weight: var(--font-semibold);
  }
  .kernel-recommended-journey__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .kernel-recommended-journey__item {
    display: flex;
    align-items: stretch;
    gap: var(--space-3);
  }
  .kernel-recommended-journey__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 9999px;
    background: var(--brand-soft-strong);
    color: var(--interactive-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    border: 1px solid var(--interactive-primary);
    flex-shrink: 0;
  }
  .kernel-recommended-journey__link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-primary);
    flex: 1;
    min-height: 44px;
    transition: background var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }
  .kernel-recommended-journey__link:hover,
  .kernel-recommended-journey__link:focus-visible {
    background: var(--brand-soft);
    border-color: var(--interactive-primary);
    outline: none;
  }
  .kernel-recommended-journey__link:focus-visible {
    box-shadow: 0 0 0 2px var(--interactive-primary);
  }
  .kernel-recommended-journey__label {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }
  .kernel-recommended-journey__hint {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .kernel-recommended-journey__empty {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  @media (min-width: 640px) {
    .kernel-recommended-journey__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kernel-recommended-journey__link {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    'use strict';
    var ROLE_KEY = 'brightai-kernel-role';

    var JOURNEYS = {
      ciso: [
        { step: 1, label: 'راجع حالة الامتثال', href: '/kernel/compliance/', hint: 'شوف نقاطك في PDPL وNCA ECC' },
        { step: 2, label: 'افحص سجل التدقيق', href: '/kernel/audit/', hint: 'راجع كل قرار والـ hash chain' },
        { step: 3, label: 'راجع الأدلة', href: '/kernel/evidence/', hint: 'ملفات PDF جاهزة للجهات الرقابية' },
      ],
      compliance: [
        { step: 1, label: 'راجع الفجوات', href: '/kernel/compliance/', hint: 'أداء الفجوات لكل إطار' },
        { step: 2, label: 'ولّد الأدلة', href: '/kernel/evidence/', hint: 'أدلة PDF موقّعة لكل قرار' },
        { step: 3, label: 'أنشئ تقرير', href: '/kernel/reports/', hint: 'تقرير تنفيذي للإدارة' },
      ],
      developer: [
        { step: 1, label: 'اقرأ التوثيق', href: '/kernel/api/', hint: 'نقاط API والـ SDK' },
        { step: 2, label: 'جرب الملعب', href: '/kernel/playground/', hint: 'جرّب السياسات على طلباتك' },
        { step: 3, label: 'اربط نماذجك', href: '/kernel/connectors/', hint: 'اربط الأنظمة والنماذج' },
      ],
      employee: [
        { step: 1, label: 'ابدأ محادثة آمنة', href: '/kernel/chat/', hint: 'استخدم AI بضوابط حوكمة' },
        { step: 2, label: 'جرب الملعب', href: '/kernel/playground/', hint: 'افهم كيف يحمي Kernel طلباتك' },
      ],
    };

    var ROLE_LABELS = {
      ciso: 'CISO / DPO',
      compliance: 'مسؤول امتثال',
      developer: 'مطوّر',
      employee: 'موظف',
    };

    function getSavedRole() {
      try { return localStorage.getItem(ROLE_KEY); } catch (e) { return null; }
    }

    function renderJourney(roleId) {
      var root = document.querySelector('[data-kernel-recommended-journey]');
      if (!root) return;
      var list = root.querySelector('[data-kernel-journey-list]');
      var empty = root.querySelector('[data-kernel-journey-empty]');
      var roleLabel = root.querySelector('[data-kernel-journey-role-label]');
      if (!list || !empty || !roleLabel) return;

      var steps = JOURNEYS[roleId];
      if (!steps || !steps.length) {
        list.innerHTML = '';
        list.hidden = true;
        empty.hidden = false;
        roleLabel.textContent = 'اختر دورك لبدء';
        return;
      }

      list.innerHTML = '';
      steps.forEach(function (step) {
        var li = document.createElement('li');
        li.className = 'kernel-recommended-journey__item';

        var num = document.createElement('span');
        num.className = 'kernel-recommended-journey__num';
        num.setAttribute('aria-hidden', 'true');
        num.textContent = String(step.step);

        var a = document.createElement('a');
        a.className = 'kernel-recommended-journey__link';
        a.href = step.href;
        a.setAttribute('aria-label', 'الخطوة ' + step.step + ': ' + step.label + ' — ' + step.hint);

        var label = document.createElement('span');
        label.className = 'kernel-recommended-journey__label';
        label.textContent = step.label;

        var hint = document.createElement('span');
        hint.className = 'kernel-recommended-journey__hint';
        hint.textContent = step.hint;

        a.appendChild(label);
        a.appendChild(hint);
        li.appendChild(num);
        li.appendChild(a);
        list.appendChild(li);
      });

      list.hidden = false;
      empty.hidden = true;
      roleLabel.textContent = 'دورك: ' + (ROLE_LABELS[roleId] || roleId);
    }

    function init() {
      var saved = getSavedRole();
      renderJourney(saved);
    }

    document.addEventListener('kernel:role-change', function (e) {
      if (e && e.detail && e.detail.role) renderJourney(e.detail.role);
    });

    document.addEventListener('astro:page-load', init);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>