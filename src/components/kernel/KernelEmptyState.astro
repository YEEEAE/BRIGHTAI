---
/**
 * KernelEmptyState — Illustrated empty state with optional CTA, demo hint, and onboarding tour.
 */
interface OnboardingStep {
  id: string;
  label: string;
  targetSelector: string;
}

interface Props {
  title: string;
  message?: string;
  ctaLabel?: string;
  ctaHref?: string;
  icon?: string;
  iconSvg?: string;
  align?: 'center' | 'start';
  compact?: boolean;
  demoHint?: boolean;
  onboardingSteps?: OnboardingStep[];
}

const {
  title,
  message = '',
  ctaLabel = '',
  ctaHref = '',
  icon,
  iconSvg = icon || '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>',
  align = 'center',
  compact = false,
  demoHint = false,
  onboardingSteps = [],
} = Astro.props;

const isEmoji = icon && !icon.includes('<svg') && icon.length <= 4;
---

<div
  class:list={['kernel-empty', `kernel-empty--${align}`, compact && 'kernel-empty--compact']}
  role="status"
  aria-live="polite"
>
  <div class="kernel-empty__illustration" aria-hidden="true">
    {isEmoji ? (
      <span class="kernel-empty__icon-emoji">{icon}</span>
    ) : (
      <Fragment set:html={iconSvg} />
    )}
  </div>
  <h3 class="kernel-empty__title">{title}</h3>
  {message && <p class="kernel-empty__message">{message}</p>}
  {ctaLabel && ctaHref && (
    <a href={ctaHref} class="kernel-empty__cta">
      {ctaLabel}
    </a>
  )}
  {demoHint && (
    <p class="kernel-empty__demo-hint">
      💡 هذه بيئة تجريبية. <a href="/kernel/playground/">جرب الملعب</a>
    </p>
  )}
  {onboardingSteps.length > 0 && (
    <details class="kernel-empty__onboarding" name="kernel-tour" open>
      <summary class="kernel-empty__onboarding-summary">جولة سريعة (3 خطوات)</summary>
      <ol class="kernel-empty__onboarding-list">
        {onboardingSteps.map((step, i) => (
          <li>
            <button
              type="button"
              class="kernel-empty__onboarding-step"
              data-tour-step={step.id}
              data-tour-target={step.targetSelector}
              data-tour-index={i}
            >
              {i + 1}. {step.label}
            </button>
          </li>
        ))}
      </ol>
    </details>
  )}
</div>

