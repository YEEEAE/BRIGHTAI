---
/**
 * KernelDateRangePicker — Preset-driven date range picker for Kernel pages.
 *
 * Provides quick presets (today / 7 days / 30 days / quarter / custom) plus
 * keyboard shortcuts (t / w / m / q / c) so users don't have to pick dates
 * manually every time. Preserves custom range: editing the date inputs
 * switches the active preset to "custom" automatically.
 *
 * Design intent (تصميم-صفحات-kernel §4.7 / §4.9):
 *   - RTL-aware: date inputs are dir="ltr" (ISO dates), labels are Arabic.
 *   - Accessibility: aria-pressed on preset buttons, aria-label on inputs,
 *     focus-visible ring, keyboard shortcuts announced via aria-live.
 *   - Vanilla JS only — no React, no jQuery, no GSAP.
 *   - Respects prefers-reduced-motion (no transition on preset switch).
 *
 * Architecture:
 *   - SSR: renders preset buttons + two date inputs + a live region.
 *   - Client script: wires click handlers on presets, input handlers on
 *     date fields, and a single keydown listener scoped to the picker root.
 *   - Integration: the component does NOT own the filter state. It updates
 *     the date input values and dispatches native `input` events so the
 *     existing page engines (audit.js, kernel-time-machine.js) react as if
 *     the user typed the dates manually. This keeps the component drop-in.
 *
 * Props:
 *   - id: unique base id for the picker (used to scope keyboard shortcuts).
 *   - fromId / toId: ids for the two date inputs. Defaults: `${id}-from` / `${id}-to`.
 *   - fromDataAttr / toDataAttr: data attributes the page engine reads.
 *       audit → 'dateFrom' / 'dateTo' (matches data-kernel-audit-filter).
 *       replay → undefined (replay uses id-based selectors data-rp-date-from/to).
 *   - shortcutDataAttr / shortcutDataValue: optional, for pages that read a
 *       preset data attribute (replay reads data-rp-range). When set, clicking
 *       a preset also sets this attribute on the active button.
 *   - defaultPreset: which preset is active on load ('today'|'week'|'month'|'quarter'|'custom').
 *   - defaultFrom / defaultTo: initial date values (ISO yyyy-mm-dd). Required
 *       when defaultPreset is 'custom'; otherwise computed from the preset.
 *   - ariaLabel: group label for the picker.
 *
 * Usage (audit):
 *   <KernelDateRangePicker
 *     id="audit-daterange"
 *     fromDataAttr="dateFrom"
 *     toDataAttr="dateTo"
 *     defaultPreset="custom"
 *   />
 *
 * Usage (replay):
 *   <KernelDateRangePicker
 *     id="rp-daterange"
 *     fromId="rp-date-from"
 *     toId="rp-date-to"
 *     shortcutDataAttr="data-rp-range"
 *     defaultPreset="quarter"
 *     defaultFrom={FROM_DEFAULT}
 *     defaultTo={TO_DEFAULT}
 *   />
 */
interface Preset {
  id: 'today' | 'week' | 'month' | 'quarter' | 'custom';
  label: string;
  /** Days from today (inclusive). today = 0, week = 6 (today - 6 = last 7 days). */
  days?: number;
  /** Keyboard shortcut key (lowercase). */
  key?: string;
  /** Value written to shortcutDataAttr when this preset is active (e.g. replay range). */
  rangeValue?: string;
}

interface Props {
  id: string;
  fromId?: string;
  toId?: string;
  fromDataAttr?: string;
  toDataAttr?: string;
  shortcutDataAttr?: string;
  defaultPreset?: Preset['id'];
  defaultFrom?: string;
  defaultTo?: string;
  ariaLabel?: string;
}

const {
  id,
  fromId = `${id}-from`,
  toId = `${id}-to`,
  fromDataAttr,
  toDataAttr,
  shortcutDataAttr,
  defaultPreset = 'custom',
  defaultFrom = '',
  defaultTo = '',
  ariaLabel = 'مدى التاريخ',
} = Astro.props;

const PRESETS: Preset[] = [
  { id: 'today', label: 'اليوم', days: 0, key: 't', rangeValue: 'today' },
  { id: 'week', label: 'آخر 7 أيام', days: 6, key: 'w', rangeValue: 'week' },
  { id: 'month', label: 'آخر 30 يوم', days: 29, key: 'm', rangeValue: 'month' },
  { id: 'quarter', label: 'الربع الأخير', days: 89, key: 'q', rangeValue: 'quarter' },
  { id: 'custom', label: 'مخصص', key: 'c', rangeValue: 'custom' },
];

const activePreset = PRESETS.find(p => p.id === defaultPreset) ?? PRESETS[4];
---

<div
  class="kernel-daterange"
  data-kernel-daterange
  data-kernel-daterange-id={id}
  data-kernel-daterange-shortcut-attr={shortcutDataAttr}
  role="group"
  aria-label={ariaLabel}
>
  <div class="kernel-daterange__presets" role="group" aria-label="اختصارات سريعة">
    {PRESETS.map(p => (
      <button
        type="button"
        class:list={['kernel-daterange__preset', { 'kernel-daterange__preset--active': p.id === activePreset.id }]}
        data-kernel-daterange-preset={p.id}
        data-kernel-daterange-key={p.key}
        data-kernel-daterange-days={p.days ?? ''}
        data-kernel-daterange-range={p.rangeValue ?? ''}
        aria-pressed={p.id === activePreset.id ? 'true' : 'false'}
      >
        {p.label}
        {p.key && <span class="kernel-daterange__key" aria-hidden="true">{p.key}</span>}
      </button>
    ))}
  </div>

  <div class="kernel-daterange__fields">
    <div class="kernel-daterange__field">
      <label for={fromId} class="kernel-daterange__label">من تاريخ</label>
      <input
        id={fromId}
        type="date"
        class="kernel-daterange__input"
        value={defaultFrom}
        dir="ltr"
        aria-label="من تاريخ"
        {...(fromDataAttr ? { [`data-kernel-audit-filter`]: fromDataAttr } : {})}
        {...(id === 'rp-daterange' ? { 'data-rp-date-from': '' } : {})}
      />
    </div>
    <div class="kernel-daterange__field">
      <label for={toId} class="kernel-daterange__label">إلى تاريخ</label>
      <input
        id={toId}
        type="date"
        class="kernel-daterange__input"
        value={defaultTo}
        dir="ltr"
        aria-label="إلى تاريخ"
        {...(toDataAttr ? { [`data-kernel-audit-filter`]: toDataAttr } : {})}
        {...(id === 'rp-daterange' ? { 'data-rp-date-to': '' } : {})}
      />
    </div>
  </div>

  <span class="kernel-daterange__sr-live" data-kernel-daterange-live role="status" aria-live="polite"></span>
</div>

<style>
  .kernel-daterange {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3);
    background: linear-gradient(180deg, var(--bg-surface) 0%, rgba(19,28,48,0.85) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .kernel-daterange__presets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .kernel-daterange__preset {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-block-size: 36px;
    padding: var(--space-1) var(--space-3);
    background: var(--bg-elevated);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .kernel-daterange__preset:hover {
    background: var(--brand-soft);
    color: var(--text-primary);
  }

  .kernel-daterange__preset:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
  }

  .kernel-daterange__preset--active {
    background: var(--brand-soft);
    border-color: var(--brand-soft-border);
    color: var(--interactive-primary);
  }

  .kernel-daterange__key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 16px;
    block-size: 16px;
    border-radius: var(--radius-sm);
    background: rgba(255,255,255,0.08);
    font-size: 10px;
    font-weight: 700;
    font-family: var(--font-mono, monospace);
    color: inherit;
    opacity: 0.7;
  }

  .kernel-daterange__preset--active .kernel-daterange__key {
    background: rgba(45,212,167,0.18);
    opacity: 1;
  }

  .kernel-daterange__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  @media (max-width: 480px) {
    .kernel-daterange__fields { grid-template-columns: 1fr; }
  }

  .kernel-daterange__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .kernel-daterange__label {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    font-weight: var(--font-semibold);
  }

  .kernel-daterange__input {
    padding: var(--space-2) var(--space-3);
    background: var(--bg-base);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-family: inherit;
    min-block-size: 40px;
    color-scheme: dark;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .kernel-daterange__input:focus {
    outline: none;
    border-color: var(--interactive-primary);
    box-shadow: 0 0 0 3px var(--brand-soft);
  }

  .kernel-daterange__input:focus-visible {
    outline: 2px solid var(--interactive-primary);
    outline-offset: 2px;
  }

  .kernel-daterange__sr-live {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .kernel-daterange__preset,
    .kernel-daterange__input { transition: none; }
  }
</style>

<script>
  // Vanilla JS, runs once per picker instance. Wires:
  //  1. Preset click → compute date range → update inputs → dispatch input events.
  //  2. Date input change → switch active preset to "custom".
  //  3. Keyboard shortcuts (t/w/m/q/c) scoped to the picker root (when focus is
  //     inside the picker). Avoids hijacking global key presses.
  //  4. ARIA live announcement when preset changes.
  (function initKernelDateRangePickers() {
    const pickers = document.querySelectorAll('[data-kernel-daterange]');
    pickers.forEach((picker) => {
      const el = picker as HTMLElement;
      if (el.dataset['kernelDaterangeWired'] === '1') return;
      el.dataset['kernelDaterangeWired'] = '1';

      const id = el.dataset['kernelDaterangeId'] || '';
      const shortcutAttr = el.dataset['kernelDaterangeShortcutAttr'] || '';
      const fromInput = el.querySelector('[data-rp-date-from], [data-kernel-audit-filter="dateFrom"], #' + CSS.escape(id + '-from')) as HTMLInputElement | null;
      const toInput = el.querySelector('[data-rp-date-to], [data-kernel-audit-filter="dateTo"], #' + CSS.escape(id + '-to')) as HTMLInputElement | null;
      const liveRegion = el.querySelector('[data-kernel-daterange-live]') as HTMLElement | null;
      const presetButtons = Array.from(el.querySelectorAll('[data-kernel-daterange-preset]')) as HTMLElement[];

      function isoDate(d: Date): string {
        const p = (n: number) => String(n).padStart(2, '0');
        return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate());
      }

      function setActivePreset(presetId: string): void {
        presetButtons.forEach((btn) => {
          const isActive = btn.dataset['kernelDaterangePreset'] === presetId;
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          btn.classList.toggle('kernel-daterange__preset--active', isActive);
          if (isActive && shortcutAttr && btn.dataset['kernelDaterangeRange']) {
            btn.setAttribute(shortcutAttr, btn.dataset['kernelDaterangeRange']);
          }
        });
        const active = presetButtons.find((b) => b.dataset['kernelDaterangePreset'] === presetId);
        if (liveRegion && active) {
          liveRegion.textContent = 'تم اختيار: ' + (active.textContent || '').trim();
        }
      }

      function applyPreset(presetId: string): void {
        const btn = presetButtons.find((b) => b.dataset['kernelDaterangePreset'] === presetId);
        if (!btn) return;
        const daysAttr = btn.dataset['kernelDaterangeDays'];
        if (daysAttr === '' || daysAttr === undefined) {
          // "custom" — just mark it active, don't touch the inputs.
          setActivePreset(presetId);
          return;
        }
        const days = parseInt(daysAttr, 10);
        const today = new Date();
        const start = new Date(today);
        start.setDate(today.getDate() - days);
        if (fromInput) {
          fromInput.value = isoDate(start);
          fromInput.dispatchEvent(new Event('input', { bubbles: true }));
          fromInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
        if (toInput) {
          toInput.value = isoDate(today);
          toInput.dispatchEvent(new Event('input', { bubbles: true }));
          toInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
        setActivePreset(presetId);
      }

      // 1. Preset click handlers
      presetButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const presetId = btn.dataset['kernelDaterangePreset'] || 'custom';
          applyPreset(presetId);
        });
      });

      // 2. Date input change → switch to "custom" (preserve custom range)
      [fromInput, toInput].forEach((input) => {
        if (!input) return;
        input.addEventListener('input', () => {
          // Only switch to custom if the current active preset isn't already custom
          // and the values don't match a preset (avoids redundant announcements).
          const active = el.querySelector('.kernel-daterange__preset--active') as HTMLElement | null;
          if (active && active.dataset['kernelDaterangePreset'] !== 'custom') {
            setActivePreset('custom');
          }
        });
      });

      // 3. Keyboard shortcuts — scoped to the picker (when focus is inside).
      //    This avoids hijacking t/w/m/q/c while the user is typing elsewhere.
      el.addEventListener('keydown', (e) => {
        const evt = e as KeyboardEvent;
        // Don't trigger when the user is typing in a text field outside the picker,
        // but DO allow it when focus is on a preset button or a date input inside.
        const target = evt.target as HTMLElement | null;
        if (!target || !el.contains(target)) return;
        // Skip if modifier keys are pressed (let the browser handle Ctrl+T etc.)
        if (evt.ctrlKey || evt.metaKey || evt.altKey) return;
        const key = evt.key.toLowerCase();
        const match = presetButtons.find((b) => b.dataset['kernelDaterangeKey'] === key);
        if (match) {
          evt.preventDefault();
          const presetId = match.dataset['kernelDaterangePreset'] || 'custom';
          applyPreset(presetId);
          // Move focus to the matched preset for screen readers
          match.focus();
        }
      });
    });
  })();
</script>