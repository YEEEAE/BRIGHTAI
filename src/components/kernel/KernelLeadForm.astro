---
/**
 * KernelLeadForm — KERNEL-AI-2026-07-14
 *
 * نموذج lead capture موحد (3 حقول: اسم، بريد/جوال، شركة).
 * يُستخدم في نهاية كل صفحة Kernel لتحويل الزائر إلى lead.
 *
 * السلوك:
 *  1. POST /api/lead بـ { name, contact, company, page }
 *  2. لو الـ API رجع 200 → success message
 *  3. لو رجع 404 (Render static) → fallback إلى wa.me مع نص جاهز
 *  4. لو رجع 429/500 → Arabic error message
 *  5. لو رجع 403 csrf_invalid → re-fetch token + retry مرة واحدة
 *
 * الأمان:
 *  - لا يحفظ في localStorage (خصوصية)
 *  - rate limit على مستوى الخادم (5/دقيقة/IP)
 *  - Zod validation على الخادم
 *  - CSRF double-submit pattern (X-CSRF-Token header + cookie)
 *  - data-page attribute يُسجّل الصفحة اللي جاء منها الـ lead
 *
 * Props:
 *  - id: string (افتراضي: 'kernel-lead-form')
 *  - title: string
 *  - subtitle: string
 *  - submitLabel: string
 */

interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  submitLabel?: string;
  /** صفحة الـ lead (تلقائياً من URL) */
  page?: string;
}

const {
  id = 'kernel-lead-form',
  title = 'تبي تطبّق هالشي في منشأتك؟',
  subtitle = 'عبّي بياناتك وفريق الحوكمة يتواصل معك خلال 24 ساعة عبر البريد أو واتساب.',
  submitLabel = 'إرسال الطلب',
  page,
} = Astro.props;

const iconSend = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>';
const iconCheck = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
---

<section
  id={id}
  class="kernel-lead-form"
  aria-labelledby={`${id}-title`}
  data-kernel-lead-form
  data-form-id={id}
  data-page={page || 'kernel'}
>
  <header class="kernel-lead-form__head">
    <h2 class="kernel-lead-form__title" id={`${id}-title`}>{title}</h2>
    <p class="kernel-lead-form__subtitle">{subtitle}</p>
  </header>

  <form
    class="kernel-lead-form__form"
    data-kernel-lead-form-element
    novalidate
    data-prevent-default
  >
    <div class="kernel-lead-form__row">
      <div class="kernel-lead-form__field">
        <label class="kernel-lead-form__label" for={`${id}-name`}>
          الاسم الكامل <span class="kernel-lead-form__req" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id={`${id}-name`}
          name="name"
          class="kernel-lead-form__input"
          required
          aria-required="true"
          aria-describedby={`${id}-name-error`}
          autocomplete="name"
          minlength="2"
          maxlength="100"
          placeholder="مثال: محمد أحمد القحطاني"
        />
        {/* DEC-A11Y-002 (2026-07-14): added id + role + aria-live so the input's
            aria-describedby points to a stable target that announces on change */}
        <span
          id={`${id}-name-error`}
          class="kernel-lead-form__error"
          data-kernel-lead-error="name"
          role="alert"
          aria-live="polite"
          hidden
        ></span>
      </div>

      <div class="kernel-lead-form__field">
        <label class="kernel-lead-form__label" for={`${id}-contact`}>
          البريد الإلكتروني أو رقم الجوال <span class="kernel-lead-form__req" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id={`${id}-contact`}
          name="contact"
          class="kernel-lead-form__input"
          required
          aria-required="true"
          aria-describedby={`${id}-contact-error`}
          autocomplete="email"
          maxlength="120"
          placeholder="example@company.com أو +9665XXXXXXXX"
        />
        <span
          id={`${id}-contact-error`}
          class="kernel-lead-form__error"
          data-kernel-lead-error="contact"
          role="alert"
          aria-live="polite"
          hidden
        ></span>
      </div>
    </div>

    <div class="kernel-lead-form__field">
      <label class="kernel-lead-form__label" for={`${id}-company`}>
        اسم الشركة أو الجهة <span class="kernel-lead-form__req" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id={`${id}-company`}
        name="company"
        class="kernel-lead-form__input"
        required
        aria-required="true"
        aria-describedby={`${id}-company-error`}
        autocomplete="organization"
        minlength="2"
        maxlength="120"
        placeholder="مثال: مجموعة stc، مستشفى الملك فيصل التخصصي، بنك الراجحي"
      />
      <span
        id={`${id}-company-error`}
        class="kernel-lead-form__error"
        data-kernel-lead-error="company"
        role="alert"
        aria-live="polite"
        hidden
      ></span>
    </div>

    <div class="kernel-lead-form__actions">
      <p class="kernel-lead-form__privacy">
        بإرسالك النموذج توافق على <a href="/privacy-policy/" target="_blank" rel="noopener noreferrer">سياسة الخصوصية</a>. نستخدم بياناتك للرد على طلبك فقط.
      </p>
      <button
        type="submit"
        class="kernel-lead-form__submit"
        data-kernel-lead-submit
        aria-busy="false"
      >
        <span class="kernel-lead-form__submit-spinner" aria-hidden="true" data-kernel-lead-spinner hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" width="18" height="18">
            <circle cx="12" cy="12" r="10" stroke-dasharray="31.4 31.4" stroke-dashoffset="0" />
          </svg>
        </span>
        <span class="kernel-lead-form__submit-label">{submitLabel}</span>
        <span class="kernel-lead-form__submit-icon" aria-hidden="true">
          <Fragment set:html={iconSend} />
        </span>
      </button>
    </div>

    {/* error banner — يظهر فوق الـ submit عند الفشل */}
    <div
      class="kernel-lead-form__alert kernel-lead-form__alert--error"
      role="alert"
      aria-live="assertive"
      data-kernel-lead-alert="error"
      hidden
    ></div>

    {/* success banner — يظهر بعد الإرسال الناجح */}
    <div
      class="kernel-lead-form__alert kernel-lead-form__alert--success"
      role="status"
      aria-live="polite"
      data-kernel-lead-alert="success"
      hidden
    >
      <span class="kernel-lead-form__alert-icon" aria-hidden="true">
        <Fragment set:html={iconCheck} />
      </span>
      <p>تم استلام طلبك بنجاح. فريق الحوكمة سيتواصل معك خلال 24 ساعة.</p>
    </div>
  </form>
</section>

<style>
  .kernel-lead-form {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-5);
    max-inline-size: 720px;
    margin-inline: auto;
  }

  .kernel-lead-form__head {
    text-align: center;
    margin-block-end: var(--space-5);
  }

  .kernel-lead-form__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }
  .kernel-lead-form__subtitle {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  .kernel-lead-form__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .kernel-lead-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  @media (max-width: 640px) {
    .kernel-lead-form__row { grid-template-columns: 1fr; }
  }

  .kernel-lead-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .kernel-lead-form__label {
    color: var(--text-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }
  .kernel-lead-form__req {
    color: var(--status-danger);
  }

  .kernel-lead-form__input {
    inline-size: 100%;
    background: var(--bg-base);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    font-family: inherit;
    font-size: var(--text-base);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .kernel-lead-form__input:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
    border-color: var(--interactive-primary);
  }
  .kernel-lead-form__input[aria-invalid="true"] {
    border-color: var(--status-danger);
  }

  .kernel-lead-form__error {
    color: var(--status-danger);
    font-size: var(--text-xs);
  }

  .kernel-lead-form__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-block-start: var(--space-2);
  }
  @media (max-width: 640px) {
    .kernel-lead-form__actions { flex-direction: column; align-items: stretch; }
  }
  .kernel-lead-form__privacy {
    color: var(--text-secondary);
    font-size: var(--text-xs);
    margin: 0;
    flex: 1 1 240px;
    line-height: 1.5;
  }
  .kernel-lead-form__privacy a {
    color: var(--brand-400);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .kernel-lead-form__submit {
    background: var(--brand-500);
    color: var(--text-inverse);
    border: 0;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    font-weight: var(--font-bold);
    font-size: var(--text-base);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 48px;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .kernel-lead-form__submit:hover:not(:disabled),
  .kernel-lead-form__submit:focus-visible {
    background: var(--brand-400);
  }
  .kernel-lead-form__submit:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }
  .kernel-lead-form__submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .kernel-lead-form__submit-icon svg {
    inline-size: 18px;
    block-size: 18px;
  }

  /* BAI-DESIGN-06: submit-button loading state (idle | loading | success | error).
     Spinner replaces the send icon while the request is in flight; the label
     gets a " …" suffix to telegraph progress to assistive tech. The :disabled
     rule above already handles cursor + opacity — the spinner adds a visible
     affordance so the user knows the click registered. */
  .kernel-lead-form__submit-spinner {
    display: none;
    animation: kernel-lead-spin 0.6s linear infinite;
  }
  .kernel-lead-form__submit-spinner[hidden] { display: none; }
  .kernel-lead-form__submit-spinner svg {
    inline-size: 18px;
    block-size: 18px;
  }
  .kernel-lead-form__submit[data-state="loading"] .kernel-lead-form__submit-spinner {
    display: inline-block;
  }
  .kernel-lead-form__submit[data-state="loading"] .kernel-lead-form__submit-icon {
    display: none;
  }
  .kernel-lead-form__submit[data-state="loading"] .kernel-lead-form__submit-label::after {
    content: " …";
  }
  @keyframes kernel-lead-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .kernel-lead-form__submit-spinner { animation: none; }
  }

  .kernel-lead-form__alert {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .kernel-lead-form__alert--error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid var(--status-danger);
    color: var(--text-primary);
  }
  .kernel-lead-form__alert--success {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid var(--status-success);
    color: var(--text-primary);
  }
  .kernel-lead-form__alert--success p { margin: 0; }
  .kernel-lead-form__alert-icon {
    color: var(--status-success);
    display: inline-flex;
  }
</style>

<script defer src="/js/kernel-lead-form.js"></script>
