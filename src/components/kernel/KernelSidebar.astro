---
/**
 * KernelSidebar — Persistent sidebar (desktop ≥1024px) + mobile drawer (<1024px).
 *
 * Desktop (≥1024px): fixed sidebar on inline-end edge, collapsible to 72px.
 * Mobile (<1024px): hidden off-canvas; hamburger button toggles a drawer
 *   overlay with the same content (brand + nav groups + footer). Backdrop
 *   tap + Escape key close the drawer. role="dialog" + aria-modal.
 *
 * - Collapsible (desktop): data-sidebar="collapsed" on <body> → 72px width.
 * - State persisted to localStorage('brightai-kernel-sidebar').
 * - Mobile open state: data-sidebar-open="true" on <body> (not persisted).
 * - ARIA: navigation landmark, current page indicator, dialog semantics on mobile.
 * - Reads nav items from `kernelUnits` (excluding /kernel/ index).
 * - Active route via Astro.url.pathname.
 */

import { kernelUnits } from '../../data/kernel';
import DOMPurify from 'isomorphic-dompurify';

interface Props {
  /** Optional override for active page detection (e.g. /kernel/chat/). */
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

interface NavItem {
  id: string;
  path: string;
  label: string;
  iconSvg: string;
  isNew?: boolean;
  group: 'operations' | 'evidence' | 'admin';
  pendingCount?: number;
}

// Sidebar groups (visual order). Pending count is 7 (canonical demo).
const OPERATIONS = ['chat', 'stats', 'approvals', 'audit'];
const EVIDENCE = ['evidence', 'reports'];
const ADMIN = ['scenarios', 'compliance', 'policies', 'connectors'];

function pickNav(slug: string): NavItem | null {
  const unit = kernelUnits.find(u => u.slug === slug);
  if (!unit) return null;
  let group: NavItem['group'] = 'admin';
  if (OPERATIONS.includes(slug)) group = 'operations';
  else if (EVIDENCE.includes(slug)) group = 'evidence';
  return {
    id: slug,
    path: unit.path,
    label: unit.label === 'الفهرس' ? 'لوحة الحوكمة' : unit.label,
    iconSvg: unit.iconSvg,
    isNew: unit.slug === 'evidence' || unit.slug === 'reports',
    group,
    pendingCount: slug === 'approvals' ? 7 : undefined,
  };
}

const items: NavItem[] = OPERATIONS.concat(EVIDENCE, ADMIN)
  .map(pickNav)
  .filter((x): x is NavItem => x !== null);
---

{/* Mobile hamburger button — fixed, appears only on <1024px.
    Touch target ≥ 44×44px (WCAG SC 2.5.5). aria-expanded reflects open state. */}
<button
  class="kernel-sidebar__hamburger"
  type="button"
  aria-label="فتح قائمة Kernel"
  aria-expanded="false"
  aria-controls="kernel-sidebar"
  data-kernel-sidebar-toggle
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
</button>

{/* Mobile overlay backdrop — tap outside closes the drawer. */}
<div class="kernel-sidebar__overlay" data-kernel-sidebar-overlay aria-hidden="true"></div>

<aside class="kernel-sidebar" id="kernel-sidebar" aria-label="القائمة الرئيسية لـ Kernel" role="dialog" aria-modal="true" aria-labelledby="kernel-sidebar-title">
  <span id="kernel-sidebar-title" class="kernel-sidebar__sr-only">القائمة الرئيسية لـ Kernel</span>
  <header class="kernel-sidebar__brand">
    <span class="kernel-sidebar__logo" aria-hidden="true">ي</span>
    <div class="kernel-sidebar__brand-text">
      <span class="kernel-sidebar__title">نواة BrightAI</span>
      <span class="kernel-sidebar__subtitle">لوحة الحوكمة</span>
    </div>
  </header>

  <span class="kernel-sidebar__section-label">العمليات</span>
  <nav class="kernel-sidebar__nav" aria-label="التنقل الرئيسي لـ Kernel">
    <a href="/kernel/" class="kernel-sidebar__item" data-kernel-nav-id="home" aria-current={currentPath === '/kernel/' ? 'page' : undefined}>
      <span class="kernel-sidebar__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      </span>
      <span class="kernel-sidebar__label">لوحة الحوكمة</span>
    </a>

    {items.filter(i => i.group === 'operations').map(item => (
      <>
        <a href={item.path} class="kernel-sidebar__item" data-kernel-nav-id={item.id} aria-current={currentPath === item.path || currentPath === item.path.replace(/\/$/, '') ? 'page' : undefined}>
          <span class="kernel-sidebar__icon" aria-hidden="true"><Fragment set:html={DOMPurify.sanitize(item.iconSvg)} /></span>
          <span class="kernel-sidebar__label">{item.label}</span>
          {item.pendingCount !== undefined && (
            <span class="kernel-sidebar__badge" aria-label={`${item.pendingCount} طلبات موافقة معلقة`}>{item.pendingCount}</span>
          )}
        </a>
      </>
    ))}

    <span class="kernel-sidebar__section-label">الأدلة والقرارات</span>
    {items.filter(i => i.group === 'evidence').map(item => (
      <a href={item.path} class="kernel-sidebar__item" data-kernel-nav-id={item.id} aria-current={currentPath === item.path || currentPath === item.path.replace(/\/$/, '') ? 'page' : undefined}>
        <span class="kernel-sidebar__icon" aria-hidden="true"><Fragment set:html={DOMPurify.sanitize(item.iconSvg)} /></span>
        <span class="kernel-sidebar__label">{item.label}</span>
        {item.isNew && <span class="kernel-sidebar__badge kernel-sidebar__badge--new">جديد</span>}
      </a>
    ))}

    <span class="kernel-sidebar__section-label">الإدارة</span>
    {items.filter(i => i.group === 'admin').map(item => (
      <a href={item.path} class="kernel-sidebar__item" data-kernel-nav-id={item.id} aria-current={currentPath === item.path || currentPath === item.path.replace(/\/$/, '') ? 'page' : undefined}>
        <span class="kernel-sidebar__icon" aria-hidden="true"><Fragment set:html={DOMPurify.sanitize(item.iconSvg)} /></span>
        <span class="kernel-sidebar__label">{item.label}</span>
      </a>
    ))}
  </nav>

  <footer class="kernel-sidebar__footer">
    <div class="kernel-sidebar__user">
      <span class="kernel-sidebar__avatar" aria-hidden="true">ي</span>
      <div class="kernel-sidebar__user-meta">
        <span class="kernel-sidebar__user-name">يزيد</span>
        <span class="kernel-sidebar__user-role">مدير النظام</span>
      </div>
    </div>
    {/* Desktop collapse button (hidden on mobile — drawer has its own close). */}
    <button class="kernel-sidebar__collapse" type="button" aria-label="طي القائمة الجانبية" data-kernel-sidebar-collapse>
      <span class="kernel-sidebar__collapse-icon" aria-hidden="true">⇤</span>
      <span class="kernel-sidebar__collapse-label">طي القائمة</span>
    </button>
    {/* Mobile close button (hidden on desktop — appears only inside the drawer). */}
    <button class="kernel-sidebar__close" type="button" aria-label="إغلاق القائمة" data-kernel-sidebar-close>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
      <span class="kernel-sidebar__close-label">إغلاق</span>
    </button>
  </footer>
</aside>

<!-- BAI-SEC-18 (2026-07-25): inline script moved to public/js/kernel-sidebar.js
     to enable strict-CSP (no 'unsafe-inline' on script-src). Loaded as ES module. -->
<script type="module" src="/js/kernel-sidebar.js"></script>