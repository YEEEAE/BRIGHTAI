---
/**
 * KernelSidebar — الشِل الجانبي المشترك لكل صفحات /kernel/*.
 *
 * مطابقة لتصميم-صفحات-kernel §2.2 (الشريط الجانبي 264px · مطوي 72px).
 *
 * تحديث 2026-08-09 (KRN-IA-001): Role-aware task groups.
 *  - 6 مجموعات مهام بدل 4 (feature-first): Monitor · Investigate · Govern ·
 *    Evaluate · Integrate · Admin — مصدرها taskGroups في kernel.ts.
 *  - Pinned "top tasks" strip فوق المجموعات (max 3) — يرسمها kernel-sidebar.js
 *    حسب الدور المحفوظ. الـ SSR يرسم دور dpo الافتراضي ويخفي القسم حتى لا
 *    يحدث FOUC، والـ JS يبنيه ويظهره فورًا.
 *  - إعادة ترتيب المجموعات حسب الدور عبر kernel-sidebar.js (يقرأ body[data-role]).
 *  - مجموعة Admin gated بـ role (operator/admin فقط) — ما تظهر للزائر العام.
 *
 * تحديث 2026-07-31 (رفع الشِل المشترك):
 *  - نقطة حالة ملوّنة لكل وحدة (ok/warn/err) عبر data-health.
 *  - مبدّل دور صغير (DPO ▾) أعلى البراند، يُحفظ في localStorage عبر kernel-shell.js.
 *  - شارات عددية: approvals=7 (محايد)، connectors=1 (حمراء).
 *  - CTA «احجز عرضاً» مثبّت أسفل + سطر خصوصية.
 *  - العنصر النشط: bright-900 + شريط منت 3px + text-hi (أنماط kernel.css الموجودة).
 *
 * Mobile (<1024px): درج الموبايل القائم (kernel-sidebar.js) — ما تغيّر.
 * Desktop (≥1024px): sidebar ثابت، قابل للطي 264↔72 (kernel-sidebar.js + data-sidebar).
 *
 * ARIA: navigation landmark + current page. CSP: لا inline script.
 * No-JS fallback: المجموعات الست تظهر بالترتيب الافتراضي كاملة (full
 * discoverability محفوظ)؛ الـ pinned section يختبئ لأنه يحتاج JS لمعرفة الدور.
 */
import { kernelUnits, taskGroups, getRoleConfig } from '../../data/kernel';
import DOMPurify from 'isomorphic-dompurify';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

type Health = 'ok' | 'warn' | 'err';

interface SidebarItem {
  slug: string;
  path: string;
  label: string;
  iconSvg: string;
  health: Health;
  /** شارة عددية محايدة (مثل الموافقات). */
  countBadge?: number;
  /** شارة عددية حمراء (مثل الموصل الفاشل). */
  alertBadge?: number;
}

// صحة كل وحدة (بيانات تجريبية موسومة Demo).
const HEALTH: Record<string, Health> = {
  index: 'ok',
  chat: 'ok',
  scenarios: 'ok',
  redteam: 'ok',
  datasets: 'ok',
  scorers: 'ok',
  eval: 'ok',
  policies: 'ok',
  audit: 'ok',
  approvals: 'warn',   // 7 معلقة
  compliance: 'ok',
  evidence: 'ok',
  reports: 'ok',
  stats: 'ok',
  connectors: 'err',   // موصل فاشل
  models: 'ok',
  api: 'ok',
};

function buildItem(slug: string): SidebarItem | null {
  const unit = kernelUnits.find(u => u.slug === slug);
  if (!unit) return null;
  const item: SidebarItem = {
    slug,
    path: unit.path,
    label: slug === 'index' ? 'لوحة الحوكمة' : unit.label,
    iconSvg: unit.iconSvg,
    health: HEALTH[slug] ?? 'ok',
  };
  if (slug === 'approvals') item.countBadge = 7;
  if (slug === 'connectors') item.alertBadge = 1;
  return item;
}

// SSR: ارسم المجموعات بالترتيب الافتراضي (dpo). Admin group ما تظهر SSR
// لأن الزائر العام ما عنده role يسمح لها — kernel-sidebar.js يضيفها لو
// الدور المحفوظ operator/admin. هذا يمنع تسريب رابط quota في HTML المصدر.
const defaultConfig = getRoleConfig('dpo');
const grouped = defaultConfig.order
  .map(gid => taskGroups.find(g => g.id === gid))
  .filter((g): g is typeof taskGroups[number] => Boolean(g))
  .filter(g => !g.roles) // Admin gated — لا تظهر SSR
  .map(g => ({
    ...g,
    items: g.slugs.map(buildItem).filter((x): x is SidebarItem => x !== null),
  }))
  .filter(g => g.items.length > 0);

const isActive = (path: string) =>
  currentPath === path || currentPath === path.replace(/\/$/, '');
---

{/* Mobile hamburger — يفتح درج الموبايل (<1024px). */}
<button
  class="kernel-sidebar__hamburger"
  type="button"
  aria-label="فتح قائمة Kernel"
  aria-expanded="false"
  aria-controls="kernel-sidebar"
  data-kernel-sidebar-toggle
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
</button>

{/* خلفية الدرج على الموبايل. */}
<div class="kernel-sidebar__overlay" data-kernel-sidebar-overlay aria-hidden="true"></div>

<aside class="kernel-sidebar" id="kernel-sidebar" aria-label="القائمة الرئيسية لـ Kernel" role="dialog" aria-modal="true" aria-labelledby="kernel-sidebar-title">
  <span id="kernel-sidebar-title" class="kernel-sidebar__sr-only">القائمة الرئيسية لـ Kernel</span>

  {/* مبدّل الدور (DPO ▾) — select أصلي يُحفظ في localStorage عبر kernel-shell.js */}
  <div class="kernel-sidebar__role">
    <label for="kernel-role-select" class="kernel-sidebar__role-label">الدور</label>
    <div class="kernel-sidebar__role-select-wrap">
      <span class="kernel-sidebar__role-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </span>
      <select id="kernel-role-select" class="kernel-sidebar__role-select" data-kernel-role aria-label="اختيار الدور">
        <option value="dpo" selected>DPO</option>
        <option value="ciso">CISO</option>
        <option value="compliance">مدير امتثال</option>
        <option value="developer">مطوّر</option>
      </select>
      <span class="kernel-sidebar__role-caret" aria-hidden="true">▾</span>
    </div>
    {/* P1 (2026-08-04): Change Role link — ينقل للفهرس حيث الـ Role Selector الكامل. */}
    <a href="/kernel/" class="kernel-sidebar__role-change" data-kernel-role-change>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <span>غيّر الدور</span>
    </a>
  </div>

  <header class="kernel-sidebar__brand">
    <span class="kernel-sidebar__logo" aria-hidden="true">ي</span>
    <div class="kernel-sidebar__brand-text">
      <span class="kernel-sidebar__title">نواة BrightAI</span>
      <span class="kernel-sidebar__subtitle">لوحة الحوكمة</span>
    </div>
  </header>

  {/* KRN-IA-001 (2026-08-09): Pinned "top tasks" strip — max 3 مهام حسب الدور.
      يُرسم بـ JS (kernel-sidebar.js) حسب body[data-role]. hidden افتراضيًا
      لمنع FOUC لو الدور المحفوظ ≠ الافتراضي. No-JS: يختبئ، والمجموعات
      الست الكاملة تظل متاحة (full discoverability محفوظ). */}
  <section class="kernel-sidebar__pinned" data-kernel-pinned hidden aria-label="مهامك السريعة">
    <span class="kernel-sidebar__section-label">مهامك السريعة</span>
    <div class="kernel-sidebar__pinned-list" data-kernel-pinned-list role="list">
      {/* يُملأ بـ JS */}
    </div>
  </section>

  <nav class="kernel-sidebar__nav" aria-label="التنقل الرئيسي لـ Kernel">
    {grouped.map(group => (
      <section class="kernel-sidebar__group" data-kernel-group={group.id}>
        <span class="kernel-sidebar__section-label">{group.label}</span>
        {group.items.map(item => (
          <a
            href={item.path}
            class="kernel-sidebar__item"
            data-kernel-nav-id={item.slug}
            data-health={item.health}
            aria-current={isActive(item.path) ? 'page' : undefined}
          >
            <span class="kernel-sidebar__icon" aria-hidden="true"><Fragment set:html={DOMPurify.sanitize(item.iconSvg)} /></span>
            <span class="kernel-sidebar__label">{item.label}</span>
            {item.countBadge !== undefined && (
              <span class="kernel-sidebar__badge kernel-sidebar__badge--count" aria-label={`${item.countBadge} معلقة`}>{item.countBadge}</span>
            )}
            {item.alertBadge !== undefined && (
              <span class="kernel-sidebar__badge" aria-label={`${item.alertBadge} موصل متعطّل`}>{item.alertBadge}</span>
            )}
            {/* نقطة حالة الوحدة (لون + شكل). */}
            <span class:list={['kernel-sidebar__dot', `kernel-sidebar__dot--${item.health}`]} aria-label={`صحة الوحدة: ${item.health}`} title={`صحة الوحدة: ${item.health}`}></span>
          </a>
        ))}
      </section>
    ))}
  </nav>

  <footer class="kernel-sidebar__footer">
    <p class="kernel-sidebar__privacy">بيانات تجريبية — لا تخزين، لا تدريب، الجلسة تُمسح.</p>
    <a class="kernel-sidebar__cta" href="/contact/" data-kernel-cta>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      <span>احجز عرضاً</span>
    </a>
    <div class="kernel-sidebar__footer-controls">
      <button class="kernel-sidebar__collapse" type="button" aria-label="طي القائمة الجانبية" data-kernel-sidebar-collapse>
        <span class="kernel-sidebar__collapse-icon" aria-hidden="true">⇤</span>
        <span class="kernel-sidebar__collapse-label">طي القائمة</span>
      </button>
      <button class="kernel-sidebar__close" type="button" aria-label="إغلاق القائمة" data-kernel-sidebar-close>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
        <span class="kernel-sidebar__close-label">إغلاق</span>
      </button>
    </div>
  </footer>
</aside>

<script type="module" src="/js/kernel-sidebar.js"></script>
