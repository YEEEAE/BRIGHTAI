---
/**
 * SectorCard — Card for a single sector on /solutions/ hub.
 *
 * Uses the new `.sector-card` canonical pattern (REPORT-10):
 *   - sector-card__icon          — larger 64x64 brand-soft icon box
 *   - sector-card__title         — bold h3
 *   - sector-card__desc          — lead paragraph
 *   - sector-card__regulations   — bullet-style chip list (PDPL / NCA / SAMA / SFDA)
 *   - sector-card__action        — divider + arrow link, anchored bottom
 *
 * Sectors handled:
 *   - banking-ai-governance          → SAMA, NCA ECC, PDPL
 *   - government-ai-governance       → DGA, PDPL, NCA ECC
 *   - healthcare-ai-governance       → SFDA, ISO 13485, PDPL, NCA ECC
 *   - manufacturing-ai-governance    → NCA ECC, ISO 42001, PDPL
 *
 * NOTE: We intentionally keep this as a separate component from
 * SolutionCard.astro to preserve the typed API surface and the call sites
 * in /solutions/ and /solutions/[sector]/. The visual anatomy
 * (.card card--feature card--interactive) remains shared, but the markup
 * and CSS structure for regulations differs by use case.
 */
import type { SectorData } from '../data/solutions';
import Icon from '../components/Icon.astro';

interface Props { sector: SectorData; }
const { sector } = Astro.props;

const REGULATIONS_BY_SLUG: Record<string, string[]> = {
  'banking-ai-governance':       ['SAMA', 'NCA ECC', 'PDPL'],
  'government-ai-governance':    ['DGA',  'PDPL',    'NCA ECC'],
  'healthcare-ai-governance':    ['SFDA', 'ISO 13485', 'PDPL', 'NCA ECC'],
  'manufacturing-ai-governance': ['NCA ECC', 'ISO 42001', 'PDPL'],
};
const regulations = REGULATIONS_BY_SLUG[sector.slug] ?? ['PDPL', 'NCA ECC'];

// Generate descriptive anchor text based on sector slug
function getDescriptiveAnchor(sector: SectorData): string {
  const slug = sector.slug;
  const anchors: Record<string, string> = {
    'banking-ai-governance': 'اكتشف حوكمة AI للقطاع المالي والبنوك',
    'government-ai-governance': 'تعرّف على حوكمة AI للجهات الحكومية',
    'healthcare-ai-governance': 'اكتشف حوكمة AI للمستشفيات والرعاية الصحية',
    'manufacturing-ai-governance': 'شوف حوكمة AI للجودة والصيانة التنبؤية في المصانع',
  };
  return anchors[slug] ?? 'اعرف المزيد';
}
---

<a
  href={sector.href}
  class="sector-card"
  aria-label={sector.h1}
>
  <span class="sector-card__icon" aria-hidden="true">
    <Icon name={sector.icon} />
  </span>

  <span class="chip chip--neutral">{sector.chip}</span>

  <h3 class="sector-card__title">{sector.h1}</h3>

  <p class="sector-card__desc">{sector.shortDesc}</p>

  <ul class="sector-card__regulations" aria-label="اللوائح المنطبقة على هذا القطاع">
    {regulations.map(r => <li>{r}</li>)}
  </ul>

  <span class="sector-card__action">
    {getDescriptiveAnchor(sector)}
    <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-arrow-left"></use></svg>
  </span>
</a>

<style>
  .sector-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
    padding: var(--space-6);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: var(--radius-xl);
    background: rgba(15, 23, 42, 0.6);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .sector-card:hover,
  .sector-card:focus-visible {
    border-color: var(--interactive-primary);
  }

  .sector-card__icon {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--brand-400), var(--indigo-400));
    display: flex;
    align-items: center;
    justify-content: center;
    margin-block-end: var(--space-4);
  }

  .sector-card__icon svg {
    width: 32px;
    height: 32px;
    color: var(--bg-base);
  }

  .sector-card .chip {
    margin-block-end: var(--space-3);
  }

  .sector-card__title {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
    line-height: var(--leading-snug);
  }

  .sector-card__desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-4);
    flex-grow: 1;
  }

  .sector-card__regulations {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
  }

  .sector-card__regulations li {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--brand-300);
    background: rgba(34, 211, 238, 0.08);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
    border: 1px solid rgba(34, 211, 238, 0.2);
  }

  .sector-card__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--brand-300);
    margin-block-start: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .sector-card { transition: none; }
  }
</style>