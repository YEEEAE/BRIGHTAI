---
/**
 * SiteBackground — the single page-level background for every visible surface.
 *
 * Renders the approved BRIGHTAI DotLottie artwork as the fixed, decorative
 * background for every page shell. The player and its WASM runtime are both
 * self-hosted so the strict same-origin CSP stays intact.
 *
 * The artwork is a 1080x1080 transparent composition, so `contain` + centre
 * alignment keeps it whole and centred at every viewport instead of cropping or
 * stretching it, and the page colour it composites onto is identical in all
 * three apps. apps/dashboard/components/SiteBackground.tsx,
 * apps/qc-task-manager/src/components/SystemBackground.astro and public/500.html
 * carry the same geometry; scripts/qa/verify-background-contract.mjs enforces it.
 */
---

<div class="bai-site-background" aria-hidden="true">
  <canvas class="bai-site-background__canvas" tabindex="-1"></canvas>
</div>

<style is:global>
  /* `body > *` in base.css lifts every body child to z-index 2; the class
     selector wins on specificity and keeps the background behind the content. */
  .bai-site-background {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Pinned, not var(--bg-base): kernel pages re-declare that token, which would
       put the same artwork on a different tone than the rest of the project. */
    background: #0a0e1a;
  }

  .bai-site-background__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
    filter: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .bai-site-background__canvas {
      display: none;
    }
  }

  @media print {
    .bai-site-background {
      display: none !important;
    }
  }
</style>

<script>
  import { DotLottie } from '@lottiefiles/dotlottie-web';

  function mountBackgroundAnimation() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const canvas = document.querySelector('.bai-site-background__canvas');
    if (!(canvas instanceof HTMLCanvasElement) || canvas.dataset.dotlottieMounted) return;

    canvas.dataset.dotlottieMounted = 'true';
    DotLottie.setWasmUrl('/media/dotlottie-player.wasm');
    new DotLottie({
      canvas,
      src: '/media/brightai-background.lottie',
      autoplay: true,
      loop: true,
      layout: { fit: 'contain', align: [0.5, 0.5] },
      renderConfig: {
        autoResize: true,
        devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
        freezeOnOffscreen: false,
      },
    });
  }

  mountBackgroundAnimation();
  document.addEventListener('astro:page-load', mountBackgroundAnimation);
</script>
