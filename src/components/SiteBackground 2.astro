---
/**
 * SiteBackground — the single page-level background for every visible surface.
 *
 * Renders the approved BRIGHTAI DotLottie artwork as the fixed, decorative
 * background for every page shell. The player and its WASM runtime are both
 * self-hosted so the strict same-origin CSP stays intact.
 *
 * The artwork is a 1080x1080 transparent composition, so `contain` + centre
 * alignment keeps it whole and centred at every viewport instead of cropping or
 * stretching it, and the page colour it composites onto is identical in all
 * three apps. apps/dashboard/components/SiteBackground.tsx,
 * apps/qc-task-manager/src/components/SystemBackground.astro and public/500.html
 * carry the same geometry; scripts/qa/verify-background-contract.mjs enforces it.
 */
---

<div class="bai-site-background" aria-hidden="true">
  <canvas class="bai-site-background__canvas" tabindex="-1"></canvas>
</div>

<style is:global>
  /* `body > *` in base.css lifts every body child to z-index 2; the class
     selector wins on specificity and keeps the background behind the content. */
  .bai-site-background {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Pinned, not var(--bg-base): kernel pages re-declare that token, which would
       put the same artwork on a different tone than the rest of the project. */
    background: #0a0e1a;
  }

  .bai-site-background__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* BAI-PERF-LCP-001 (2026-09-03): the canvas fades in only after the
       DotLottie artwork is ready. The boot itself is idle-deferred (see
       script below) so the 1.2MB .lottie + 1.2MB .wasm never compete with
       the text LCP element on constrained mobile. The solid #0a0e1a behind
       it is identical to the artwork composite colour, so first paint is
       visually seamless — no poster swap, no layout change. */
    opacity: 0;
    filter: none;
    transition: opacity 0.8s ease-out;
  }

  .bai-site-background__canvas.is-ready {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .bai-site-background__canvas {
      display: none;
    }
  }

  @media print {
    .bai-site-background {
      display: none !important;
    }
  }
</style>

<script>
  import { DotLottie } from '@lottiefiles/dotlottie-web';

  function mountBackgroundAnimation() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const canvas = document.querySelector('.bai-site-background__canvas');
    if (!(canvas instanceof HTMLCanvasElement) || canvas.dataset.dotlottieMounted) return;

    canvas.dataset.dotlottieMounted = 'true';
    DotLottie.setWasmUrl('/media/dotlottie-player.wasm');
    new DotLottie({
      canvas,
      src: '/media/brightai-background.lottie',
      autoplay: true,
      loop: true,
      layout: { fit: 'contain', align: [0.5, 0.5] },
      renderConfig: {
        autoResize: true,
        devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
        freezeOnOffscreen: false,
      },
    });
    // Fade the canvas in once the player owns it (see CSS .is-ready).
    requestAnimationFrame(() => canvas.classList.add('is-ready'));
  }

  // BAI-PERF-LCP-001 (2026-09-03): idle-deferred boot. The module script
  // itself is deferred by the browser, but fetching the .lottie artwork
  // (1.2MB) + .wasm runtime (1.2MB) immediately still saturates mobile
  // connections inside the LCP window (lab: mobile LCP ~4.7s vs desktop
  // ~0.2s, LCP element is hero text). Waiting for an idle callback keeps
  // the LCP window to fonts + render-blocking CSS only. Timeout caps the
  // delay so the artwork still appears promptly on idle-poor pages.
  // scheduleIdle is inlined because Astro compiles every <script> into an
  // isolated module scope.
  const scheduleIdle =
    typeof window.requestIdleCallback === 'function'
      ? (work: () => void) => window.requestIdleCallback(work, { timeout: 3000 })
      : (work: () => void) => window.setTimeout(work, 1500);

  scheduleIdle(mountBackgroundAnimation);
  document.addEventListener('astro:page-load', () => scheduleIdle(mountBackgroundAnimation));
</script>
