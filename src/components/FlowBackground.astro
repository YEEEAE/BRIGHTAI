---
// خلفية "مجرى الطلب" — تُوضع داخل غلاف يحيط بكل أقسام الصفحة بعد الهيرو
---
<div class="flow-bg" data-lane="0.5" aria-hidden="true"><canvas></canvas></div>

<script>
  type Particle = {
    x0: number; y: number; vy: number; size: number; angle: number; spin: number; off: number;
    pii: boolean; crit: boolean; masked: boolean; approved: boolean; hold: number;
  };
  type Block = { color: string; hash: string };

  function mount(host: HTMLElement) {
    const canvas = host.querySelector('canvas');
    const ctx = canvas?.getContext('2d', { alpha: true });
    if (!canvas || !ctx) return;
    const c = ctx;
    const surface = canvas;

    const COLOR = { iris: '#8052ff', saffron: '#ffb829', verdant: '#3b9e98', mist: '#bdbdbd' };
    const LABELS = ['FIREWALL', 'RISK 0–100', 'HUMAN GATE', 'LEDGER'];
    const GATES = [0.2, 0.4, 0.6, 0.8]; // موضع كل بوابة كنسبة من ارتفاع الشاشة
    const laneFrac = parseFloat(host.dataset.lane ?? '0.5');
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const small = matchMedia('(max-width: 767px)').matches;
    const MAX = small ? 40 : 100;
    const TRAVEL = 9; // ثوانٍ لعبور الشاشة

    let w = 0, h = 0, laneX = 0, laneW = 0;
    let frame = 0, last = 0, visible = false;
    let progress = 0, vel = 0, lastScroll = scrollY, acc = 0;
    let seed = 11;
    const rnd = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const ease = (t: number) => t * t * (3 - 2 * t);
    const gy = (i: number) => h * GATES[i];
    const hex4 = () => Math.floor(rnd() * 65535).toString(16).padStart(4, '0');

    const flash = [0, 0, 0, 0];
    const ps: Particle[] = [];
    const ledger: Block[] = [];
    const ambient = Array.from({ length: small ? 18 : 36 }, () => ({
      x: rnd(), y: rnd(), size: 3 + rnd() ** 3 * 20, angle: rnd() * 6.28,
      color: [COLOR.iris, COLOR.verdant, COLOR.saffron, COLOR.mist][Math.floor(rnd() * 4)],
      depth: 0.03 + rnd() * 0.12,
    }));

    function spawn() {
      const r = rnd();
      ps.push({
        x0: rnd() * w, y: -8, vy: (h / TRAVEL) * (0.75 + rnd() * 0.5),
        size: 3 + rnd() * 4, angle: rnd() * 6.28, spin: (rnd() - 0.5) * 0.8,
        off: rnd() * 2 - 1, pii: r < 0.28, crit: r < 0.07,
        masked: false, approved: false, hold: 0,
      });
    }

    const posX = (p: Particle) => {
      const t = ease(clamp(p.y / (h * 0.28)));
      return p.x0 + (laneX + p.off * laneW - p.x0) * t;
    };

    function colorOf(p: Particle) {
      if (p.approved) return COLOR.verdant;
      if (p.crit && p.y >= gy(1)) return COLOR.saffron;
      if (p.masked) return COLOR.iris;
      if (p.pii) return COLOR.saffron;
      return p.y >= gy(1) ? COLOR.verdant : COLOR.mist;
    }

    function cross(p: Particle, i: number) {
      flash[i] = 1;
      if (i === 0 && p.pii) p.masked = true;
      if (i === 2 && p.crit && !p.approved) { p.y = gy(2); p.hold = 1.5 + rnd() * 1.3; }
      if (i === 3) {
        ledger.push({ color: colorOf(p), hash: `${hex4()}…${hex4()}` });
        if (ledger.length > 14) ledger.shift();
      }
    }

    function step(dt: number, boost: number) {
      acc += dt * (MAX / TRAVEL) * (0.7 + boost * 0.3);
      while (acc >= 1 && ps.length < MAX) { acc -= 1; spawn(); }
      if (acc > 1) acc = 0;
      for (let i = 0; i < 4; i++) flash[i] = Math.max(0, flash[i] - dt * 2.2);
      for (let n = ps.length - 1; n >= 0; n--) {
        const p = ps[n];
        p.angle += p.spin * dt;
        if (p.hold > 0) {
          p.hold -= dt;
          if (p.hold <= 0) p.approved = true;
          continue;
        }
        const prev = p.y;
        p.y += p.vy * dt * boost;
        for (let g = 0; g < 4; g++) if (prev < gy(g) && p.y >= gy(g)) cross(p, g);
        if (p.y > h * 0.95) ps.splice(n, 1);
      }
    }

    function triangle(x: number, y: number, size: number, angle: number, color: string, alpha: number, lw = 0.9) {
      c.globalAlpha = alpha; c.strokeStyle = color; c.lineWidth = lw;
      c.beginPath();
      for (let i = 0; i < 3; i++) {
        const a = angle + (i * Math.PI * 2) / 3;
        const px = x + Math.cos(a) * size, py = y + Math.sin(a) * size;
        i === 0 ? c.moveTo(px, py) : c.lineTo(px, py);
      }
      c.closePath(); c.stroke();
    }

    function draw(time = 0) {
      c.clearRect(0, 0, w, h);
      c.direction = 'ltr'; c.textAlign = 'left';
      const active = Math.min(3, Math.floor(progress * 4));

      // مثلثات جانبية بعمق مختلف (بارالاكس مع التمرير)
      for (const a of ambient) {
        const y = (((a.y * h - scrollY * a.depth + time * 0.003 * a.depth * 10) % h) + h) % h;
        triangle(a.x * w, y, a.size, a.angle + time * 0.00004, a.color, 0.14, a.size > 10 ? 1.4 : 0.8);
      }

      // جدرا المجرى
      c.setLineDash([2, 8]); c.strokeStyle = COLOR.iris; c.lineWidth = 1; c.globalAlpha = 0.09;
      for (const s of [-1, 1]) {
        c.beginPath(); c.moveTo(laneX + s * laneW * 1.15, h * 0.28); c.lineTo(laneX + s * laneW * 1.15, h * 0.86); c.stroke();
      }
      c.setLineDash([]);

      // البوابات
      for (let i = 0; i < 4; i++) {
        const y = gy(i), on = i === active ? 1 : 0;
        c.globalAlpha = 0.14 + flash[i] * 0.55 + on * 0.2;
        c.strokeStyle = i === 2 ? COLOR.saffron : COLOR.iris;
        c.lineWidth = 1 + flash[i] * 1.2;
        c.setLineDash(i === 3 ? [] : [6, 6]);
        c.beginPath(); c.moveTo(laneX - laneW * 1.15, y); c.lineTo(laneX + laneW * 1.15, y); c.stroke();
        c.setLineDash([]);
        if (!small) {
          c.globalAlpha = 0.3 + on * 0.45; c.fillStyle = COLOR.mist;
          c.font = '11px ui-monospace, Menlo, monospace'; c.textBaseline = 'middle';
          c.fillText(`0${i + 1} ${LABELS[i]}`, laneX + laneW * 1.15 + 14, y);
        }
      }

      // الجسيمات
      for (const p of ps) {
        const x = posX(p), col = colorOf(p);
        const fade = (p.y > gy(3) ? 1 - clamp((p.y - gy(3)) / (h * 0.1)) : 1) * clamp(p.y / (h * 0.05) + 0.3);
        if (p.masked) {
          const s = p.size * 1.3;
          c.globalAlpha = 0.9 * fade; c.fillStyle = col; c.fillRect(x - s / 2, p.y - s * 0.35, s, s * 0.7);
        } else {
          triangle(x, p.y, p.size, p.angle, col, 0.6 * fade);
        }
        if (p.hold > 0) {
          c.globalAlpha = 0.55; c.strokeStyle = COLOR.saffron; c.lineWidth = 1;
          c.beginPath(); c.arc(x, p.y, p.size * 2.4 + Math.sin(time * 0.008) * 1.5, 0, 6.283); c.stroke();
        }
      }

      // سلسلة السجل
      if (ledger.length) {
        const bw = small ? 12 : 16, gap = small ? 6 : 8, ly = h * 0.92, n = ledger.length;
        const startX = laneX - (n * (bw + gap) - gap) / 2;
        c.strokeStyle = COLOR.iris; c.globalAlpha = 0.25; c.lineWidth = 1;
        c.beginPath(); c.moveTo(startX, ly + bw * 0.35); c.lineTo(startX + n * (bw + gap) - gap, ly + bw * 0.35); c.stroke();
        ledger.forEach((b, k) => {
          c.globalAlpha = 0.35 + (k / n) * 0.5; c.strokeStyle = b.color; c.fillStyle = '#000';
          c.fillRect(startX + k * (bw + gap), ly, bw, bw * 0.7);
          c.strokeRect(startX + k * (bw + gap), ly, bw, bw * 0.7);
        });
        if (!small) {
          c.globalAlpha = 0.35; c.fillStyle = COLOR.mist; c.textAlign = 'center';
          c.font = '11px ui-monospace, Menlo, monospace';
          c.fillText(ledger[n - 1].hash, laneX, ly + bw + 16);
        }
      }
      c.globalAlpha = 1;
    }

    function measure() {
      const r = host.getBoundingClientRect();
      progress = clamp(-r.top / Math.max(1, r.height - innerHeight));
    }

    function warm() {
      ps.length = 0; ledger.length = 0; acc = 0;
      for (let i = 0; i < 180; i++) step(0.05, 1);
      flash.fill(0);
    }

    function tick(t: number) {
      frame = 0;
      if (!visible || document.hidden || motion.matches) return;
      if (t - last >= 33) {
        const ms = last ? t - last : 16;
        const dy = Math.abs(scrollY - lastScroll); lastScroll = scrollY;
        vel += (dy / ms - vel) * 0.15;
        measure();
        step(Math.min(ms / 1000, 0.06), 1 + Math.min(vel * 0.8, 2));
        draw(t); last = t;
      }
      frame = requestAnimationFrame(tick);
    }

    function sync() {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      if (motion.matches) { measure(); draw(0); }
      else if (visible && !document.hidden) frame = requestAnimationFrame(tick);
    }

    const resize = new ResizeObserver(() => {
      w = surface.clientWidth; h = surface.clientHeight;
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      surface.width = Math.round(w * dpr); surface.height = Math.round(h * dpr);
      c.setTransform(dpr, 0, 0, dpr, 0, 0);
      laneX = w * laneFrac; laneW = Math.min(w * 0.1, 110);
      warm(); measure(); draw(0);
    });
    resize.observe(surface);

    const io = new IntersectionObserver(e => { visible = e[0].isIntersecting; sync(); });
    io.observe(host);
    motion.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    document.addEventListener('astro:before-swap', () => {
      resize.disconnect(); io.disconnect(); cancelAnimationFrame(frame);
      motion.removeEventListener('change', sync);
      document.removeEventListener('visibilitychange', sync);
    }, { once: true });
  }

  document.querySelectorAll<HTMLElement>('.flow-bg').forEach(mount);
</script>

<style>
  .flow-bg {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 6%, #000 94%, transparent);
            mask-image: linear-gradient(to bottom, transparent, #000 6%, #000 94%, transparent);
  }
  canvas {
    position: sticky; top: 0; display: block; width: 100%;
    height: 100vh; height: 100svh;
    opacity: var(--flow-opacity, 0.7);
  }
</style>
