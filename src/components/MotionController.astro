<script>
  // Native document navigation keeps initialization and teardown predictable.
  // Core content stays visible before JS and when motion is reduced.
  const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
  // InteriorMotion owns entrance choreography inside .interior-page; never observe it twice.
  const elements = [...document.querySelectorAll<HTMLElement>('.block,.pillar,.sector,.catalog-row,.experience,.context-route')]
    .filter(element => !element.closest('.interior-page'));
  // One-way reveal: an element animates at most once per page, so toggling the
  // reduced-motion preference can never replay the whole page.
  const pending = new Set(elements);
  let observer: IntersectionObserver | undefined;

  const settle = () => {
    pending.forEach(element => element.classList.remove('motion-enter'));
    pending.clear();
    observer?.disconnect();
    observer = undefined;
  };

  const start = () => {
    if (observer || !pending.size || motionPreference.matches || !('IntersectionObserver' in window)) return;
    observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        if (!motionPreference.matches) entry.target.classList.add('motion-enter');
        pending.delete(entry.target as HTMLElement);
        observer?.unobserve(entry.target);
      });
      if (!pending.size) { observer?.disconnect(); observer = undefined; }
    }, { threshold: .1, rootMargin: '0px 0px -5% 0px' });
    pending.forEach(element => observer?.observe(element));
  };

  const stop = () => { observer?.disconnect(); observer = undefined; };

  const onPreferenceChange = () => {
    if (motionPreference.matches) settle();
    else start();
  };

  motionPreference.addEventListener('change', onPreferenceChange);
  addEventListener('pagehide', () => {
    motionPreference.removeEventListener('change', onPreferenceChange);
    stop();
  }, { once: true });

  start();
</script>
