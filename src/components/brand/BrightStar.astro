---
/**
 * BrightStar.astro — The single visual identity for BrightAI.
 *
 * العنصر البصري الموحّد لـ BrightAI — يجسّد القصة في 5 ثوانٍ:
 *   "نواة أمان تقف بين الموظف والـ AI وبيانات الشركة"
 *
 * Architecture:
 *   - Top layer:    الموظف (Emir / MENA-tone human glyph in cube)
 *   - Middle:       Kernel Shield (hex shield, brand gradient + glow)
 *   - Bottom layer: AI + Data (cube with AI sparkle + data dots)
 *   - Connectors:   dashed lines implying controlled data flow
 *
 * Pure SVG — no JS, no React. SSR-rendered, 0KB hydration cost.
 * Decorative by default (aria-hidden) — title/desc included for AT when meaningful.
 *
 * RTL: uses viewBox + transform-friendly coordinates (no left/right literals).
 * Performance: ~6KB gzipped, no animations on hero (LCP-safe), pulse optional.
 *
 * Variants:
 *   - hero:  full detail, all 3 layers, dashed connectors (default)
 *   - minimal: just shield + halo (for footer / loading)
 *   - mono:   monochromatic brand-400 only (for 404 / dark backgrounds)
 *   - glow:   enhanced glow + concentric rings (loading state)
 */
interface Props {
  variant?: 'hero' | 'minimal' | 'mono' | 'glow';
  size?: number;             // pixel width (height auto via viewBox)
  decorative?: boolean;      // aria-hidden true if decorative
  label?: string;            // accessible label when not decorative
  className?: string;
}

const {
  variant = 'hero',
  size = 320,
  decorative = true,
  label,
  className = '',
} = Astro.props;

const ariaAttrs = decorative
  ? { 'aria-hidden': 'true' as const, role: 'presentation' as const }
  : { role: 'img' as const, 'aria-label': label || 'نواة أمان BrightAI بين الموظف والذكاء الاصطناعي والبيانات' };

const id = `bright-star-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  {...ariaAttrs}
  class={`bright-star bright-star--${variant} ${className}`}
  width={size}
  height={size * 0.75}
  viewBox="0 0 480 360"
  preserveAspectRatio="xMidYMid meet"
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
>
  {!decorative && <title>{label || 'نواة أمان BrightAI'}</title>}
  {!decorative && (
    <desc>رسم توضيحي يبيّن ثلاث طبقات: الموظف في الأعلى، نواة الأمان (Kernel) في الوسط، والذكاء الاصطناعي والبيانات في الأسفل، مع تدفّق حماية متقطع يربط الطبقات.</desc>
  )}

  <defs>
    {/* Brand gradient — cyan → indigo (matches site-wide accent ramp) */}
    <linearGradient id={`${id}-shield`} x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#22d3ee" />
      <stop offset="55%" stop-color="#06b6d4" />
      <stop offset="100%" stop-color="#818cf8" />
    </linearGradient>
    <linearGradient id={`${id}-shield-edge`} x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#155e75" stop-opacity="0.85" />
      <stop offset="100%" stop-color="#3730a3" stop-opacity="0.85" />
    </linearGradient>

    {/* Soft halo glow */}
    <radialGradient id={`${id}-halo`} cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.45" />
      <stop offset="55%" stop-color="#22d3ee" stop-opacity="0.08" />
      <stop offset="100%" stop-color="#22d3ee" stop-opacity="0" />
    </radialGradient>

    {/* Top layer face fill (subtle, light cyan) */}
    <linearGradient id={`${id}-top`} x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#a5f3fc" stop-opacity="0.12" />
      <stop offset="100%" stop-color="#22d3ee" stop-opacity="0.06" />
    </linearGradient>
    {/* Bottom layer face fill (subtle, indigo) */}
    <linearGradient id={`${id}-bottom`} x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#818cf8" stop-opacity="0.10" />
      <stop offset="100%" stop-color="#6366f1" stop-opacity="0.04" />
    </linearGradient>

    {/* Glow filter — kept light, respects prefers-reduced-motion via opacity fallback */}
    <filter id={`${id}-glow`} x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="4" result="b" />
      <feMerge>
        <feMergeNode in="b" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  {/* ── Outer halo (only on hero + glow variants) ── */}
  {(variant === 'hero' || variant === 'glow') && (
    <circle cx="240" cy="180" r="160" fill={`url(#${id}-halo)`} class="bright-star__halo" />
  )}

  {/* ════════════════════════════════════════════════════════
      TOP LAYER — الموظف (Employee)
      Isometric cuboid with a stylized human glyph inside.
      Coordinates chosen so the cube sits visually above the kernel.
      ════════════════════════════════════════════════════════ */}
  <g class="bright-star__layer bright-star__layer--top" data-layer="employee">
    {/* Cube top face (rhombus) */}
    <path
      d="M240 38 L320 78 L240 118 L160 78 Z"
      fill={`url(#${id}-top)`}
      stroke="#22d3ee"
      stroke-width="1.2"
      stroke-opacity="0.55"
    />
    {/* Cube left face */}
    <path
      d="M160 78 L160 122 L240 162 L240 118 Z"
      fill="#0f1525"
      fill-opacity="0.85"
      stroke="#22d3ee"
      stroke-width="1.2"
      stroke-opacity="0.4"
    />
    {/* Cube right face */}
    <path
      d="M320 78 L320 122 L240 162 L240 118 Z"
      fill="#0f1525"
      fill-opacity="0.65"
      stroke="#22d3ee"
      stroke-width="1.2"
      stroke-opacity="0.4"
    />

    {/* Human glyph (simple, abstract): head + shoulders, centered on top face */}
    <g transform="translate(240,78)" stroke="#a5f3fc" stroke-width="1.4" fill="none" stroke-linecap="round">
      <circle cx="0" cy="-8" r="6" fill="#22d3ee" fill-opacity="0.35" />
      <path d="M-10 8 C-7 0 -3 -2 0 -2 C3 -2 7 0 10 8" />
    </g>

    {/* Arabic label below cube (RTL safe — visual only) */}
    {(variant === 'hero') && (
      <text
        x="240" y="180"
        text-anchor="middle"
        font-size="11"
        font-weight="700"
        fill="#a5f3fc"
        fill-opacity="0.75"
        font-family="IBM Plex Sans Arabic, sans-serif"
        letter-spacing="0.02em"
      >الموظف</text>
    )}
  </g>

  {/* ── Connector: Top → Kernel (data flow, dashed) ── */}
  {variant !== 'minimal' && variant !== 'mono' && (
    <line
      x1="240" y1="166" x2="240" y2="200"
      stroke="#22d3ee"
      stroke-width="1.2"
      stroke-opacity="0.7"
      stroke-dasharray="2 4"
      stroke-linecap="round"
    />
  )}

  {/* ════════════════════════════════════════════════════════
      MIDDLE LAYER — Kernel Shield (نواة الأمان)
      Hexagonal shield — the visual centerpiece.
      Brand gradient + glow halo behind it.
      ════════════════════════════════════════════════════════ */}
  <g class="bright-star__layer bright-star__layer--kernel" data-layer="kernel">
    {/* Inner accent — hexagon stroke for "lock" symbolism */}
    <path
      d="M240 200 L300 230 L300 290 L240 320 L180 290 L180 230 Z"
      fill={`url(#${id}-shield)`}
      fill-opacity="0.95"
    />
    {/* Edge dark line for depth */}
    <path
      d="M240 200 L300 230 L300 290 L240 320 L180 290 L180 230 Z"
      fill={`url(#${id}-shield-edge)`}
      fill-opacity="0.4"
    />
    <path
      d="M240 200 L300 230 L300 290 L240 320 L180 290 L180 230 Z"
      fill="none"
      stroke="#67e8f9"
      stroke-width="1.5"
      stroke-opacity="0.85"
      stroke-linejoin="round"
    />

    {/* Lock/center glyph (mdi-lock inspired) — abstract */}
    <g transform="translate(240,260)" stroke="#0a0e1a" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <rect x="-9" y="-2" width="18" height="14" rx="2" fill="#0a0e1a" fill-opacity="0.15" />
      <path d="M-6 -2 V-7 A6 6 0 0 1 6 -7 V-2" />
      <circle cx="0" cy="6" r="1.6" fill="#0a0e1a" fill-opacity="0.8" stroke="none" />
    </g>

    {/* Concentric pulse rings (subtle, only on hero) */}
    {variant === 'hero' && (
      <>
        <path
          d="M240 196 L304 228 L304 292 L240 324 L176 292 L176 228 Z"
          fill="none"
          stroke="#22d3ee"
          stroke-width="1"
          stroke-opacity="0.4"
          class="bright-star__ring bright-star__ring--1"
        />
        <path
          d="M240 192 L308 226 L308 294 L240 328 L172 294 L172 226 Z"
          fill="none"
          stroke="#22d3ee"
          stroke-width="1"
          stroke-opacity="0.25"
          class="bright-star__ring bright-star__ring--2"
        />
      </>
    )}

    {/* Kernel Arabic label */}
    {variant === 'hero' && (
      <text
        x="240" y="354"
        text-anchor="middle"
        font-size="12"
        font-weight="800"
        fill="#22d3ee"
        font-family="IBM Plex Sans Arabic, sans-serif"
        letter-spacing="0.04em"
      >النواة</text>
    )}
  </g>

  {/* ── Connector: Kernel → Bottom (data flow, dashed) ── */}
  {variant !== 'minimal' && variant !== 'mono' && (
    <line
      x1="240" y1="320" x2="240" y2="354"
      stroke="#818cf8"
      stroke-width="1.2"
      stroke-opacity="0.7"
      stroke-dasharray="2 4"
      stroke-linecap="round"
    />
  )}

  {/* ════════════════════════════════════════════════════════
      BOTTOM LAYER — AI + Data (الذكاء الاصطناعي والبيانات)
      Isometric cuboid with abstract AI glyph (sparkle) + data dots.
      ════════════════════════════════════════════════════════ */}
  <g class="bright-star__layer bright-star__layer--bottom" data-layer="ai-data">
    {/* AI sparkle/star glyph */}
    <g transform="translate(96,228)" fill="#818cf8" fill-opacity="0.9" class="bright-star__sparkle">
      <path d="M0 -14 L3 -3 L14 0 L3 3 L0 14 L-3 3 L-14 0 L-3 -3 Z" />
    </g>
    <g transform="translate(388,256)" fill="#a5b4fc" fill-opacity="0.85" class="bright-star__sparkle bright-star__sparkle--2">
      <path d="M0 -9 L2 -2 L9 0 L2 2 L0 9 L-2 2 L-9 0 L-2 -2 Z" />
    </g>

    {/* Data dots scattered (3x4 grid, semi-transparent) */}
    <g fill="#818cf8" fill-opacity="0.55">
      <circle cx="135" cy="248" r="1.5" />
      <circle cx="155" cy="244" r="1.5" />
      <circle cx="175" cy="248" r="1.5" />
      <circle cx="195" cy="244" r="1.5" />
      <circle cx="135" cy="264" r="1.5" />
      <circle cx="155" cy="260" r="1.5" />
      <circle cx="175" cy="264" r="1.5" />
      <circle cx="195" cy="260" r="1.5" />
      <circle cx="285" cy="278" r="1.5" />
      <circle cx="305" cy="274" r="1.5" />
      <circle cx="325" cy="278" r="1.5" />
      <circle cx="345" cy="274" r="1.5" />
    </g>

    {/* Cube — bottom inverted, gives "ground" feeling */}
    <path
      d="M240 286 L320 326 L240 366 L160 326 Z"
      fill={`url(#${id}-bottom)`}
      stroke="#818cf8"
      stroke-width="1.2"
      stroke-opacity="0.6"
      opacity="0.85"
      transform="translate(0,28)"
    />
  </g>

  {/* ── External data-flow arrows (only hero variant, optional accent) ── */}
  {variant === 'hero' && (
    <g class="bright-star__arrows" stroke-linecap="round" stroke-linejoin="round">
      {/* Top arrow (input) */}
      <path d="M340 60 Q360 60 370 80" stroke="#22d3ee" stroke-width="1.4" stroke-opacity="0.6" fill="none" />
      <path d="M370 80 L364 76 M370 80 L364 84" stroke="#22d3ee" stroke-width="1.4" stroke-opacity="0.6" />
      {/* Bottom arrow (output) */}
      <path d="M340 320 Q360 320 370 300" stroke="#818cf8" stroke-width="1.4" stroke-opacity="0.6" fill="none" />
      <path d="M370 300 L364 304 M370 300 L364 296" stroke="#818cf8" stroke-width="1.4" stroke-opacity="0.6" />
    </g>
  )}
</svg>

<style>
  .bright-star {
    display: block;
    max-width: 100%;
    height: auto;
    overflow: visible;
  }

  /* ── Layer reveal animation — staggered, subtle, LCP-safe (CSS only) ── */
  .bright-star__layer {
    transform-origin: center;
    animation: bright-star-reveal 700ms var(--ease-out) backwards;
  }
  .bright-star__layer--top    { animation-delay: 80ms; }
  .bright-star__layer--kernel { animation-delay: 220ms; transform-origin: 240px 260px; }
  .bright-star__layer--bottom { animation-delay: 380ms; }

  @keyframes bright-star-reveal {
    from { opacity: 0; transform: translateY(8px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
  }

  /* ── Halo pulse — subtle, infinite, can be disabled ── */
  .bright-star__halo {
    transform-origin: 240px 180px;
    animation: bright-star-pulse 4s var(--ease-in-out) infinite;
  }
  @keyframes bright-star-pulse {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.04); }
  }

  /* ── Kernel ring expansion — slow, breathes outward ── */
  .bright-star__ring {
    transform-origin: 240px 260px;
    animation: bright-star-ring 3.5s var(--ease-out) infinite;
  }
  .bright-star__ring--1 { animation-delay: 0s; }
  .bright-star__ring--2 { animation-delay: 0.6s; }
  @keyframes bright-star-ring {
    0%   { transform: scale(0.96); opacity: 0.5; }
    100% { transform: scale(1.08); opacity: 0; }
  }

  /* ── Sparkle twinkle — only the small AI glyphs ── */
  .bright-star__sparkle {
    transform-origin: center;
    animation: bright-star-twinkle 3s var(--ease-in-out) infinite;
  }
  .bright-star__sparkle--2 { animation-delay: 1.5s; }
  @keyframes bright-star-twinkle {
    0%, 100% { opacity: 0.4; transform: scale(0.85); }
    50%      { opacity: 1;   transform: scale(1.1); }
  }

  /* ── Reduced motion: kill all animations, show static poster ── */
  @media (prefers-reduced-motion: reduce) {
    .bright-star__halo,
    .bright-star__ring,
    .bright-star__sparkle,
    .bright-star__layer {
      animation: none !important;
    }
    .bright-star__layer { opacity: 1 !important; }
  }

  /* ── Variant: minimal — keep shield + label only, hide sparkles/arrows ── */
  .bright-star--minimal .bright-star__layer--top,
  .bright-star--minimal .bright-star__layer--bottom,
  .bright-star--minimal .bright-star__arrows,
  .bright-star--minimal line {
    display: none;
  }
  .bright-star--minimal {
    width: auto;
  }

  /* ── Variant: mono — single-color (cyan only, for 404) ── */
  .bright-star--mono [stroke] {
    stroke: var(--cyan-bright) !important;
    stroke-opacity: 0.7 !important;
  }
  .bright-star--mono [fill^="url(#"] {
    fill: var(--cyan-bright) !important;
    fill-opacity: 0.25 !important;
  }
  .bright-star--mono .bright-star__halo { display: none; }
  .bright-star--mono .bright-star__arrows,
  .bright-star--mono .bright-star__sparkle { display: none; }

  /* ── Variant: glow — bigger halo + rings ── */
  .bright-star--glow .bright-star__halo {
    transform-origin: center;
    animation: bright-star-pulse 2.2s var(--ease-in-out) infinite;
    r: 180;
  }
</style>
