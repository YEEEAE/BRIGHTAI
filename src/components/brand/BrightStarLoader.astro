---
/**
 * BrightStarLoader.astro — Loading state with The Star in glow variant.
 *
 * العنصر الموحّد لحالات التحميل — نجمة BrightAI مع هالة نابضة.
 *
 * Use cases:
 *   - Place inside any async fetch wrapper while data is being computed
 *   - Use in offline page, status pages, page transitions (briefly)
 *   - Serve as a section placeholder when content is loading
 *
 * Pure CSS — no JS. Pulse animation respects prefers-reduced-motion.
 * The Star logo /assets/star/bright-star-loading.svg is loaded as image
 * (lazy + async decoded) so it stays separate from the critical HTML payload.
 */
interface Props {
  message?: string;
  size?: number;       // pixel width
  className?: string;
}

const {
  message = 'جاري التحميل...',
  size = 220,
  className = '',
} = Astro.props;
---

<div class={`bright-star-loader ${className}`} role="status" aria-live="polite">
  <img src="/assets/star/bright-star-loading.svg" alt="" width={size} height={size * 0.75} class="bright-star-loader__star" loading="lazy" decoding="async" />
  <p class="bright-star-loader__message">{message}</p>
</div>

<style>
  .bright-star-loader {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-4);
    text-align: center;
  }
  .bright-star-loader__star {
    width: 100%;
    max-width: 280px;
    height: auto;
    animation: bright-star-loader-pulse 2.2s var(--ease-in-out) infinite;
    transform-origin: center;
    filter: drop-shadow(0 0 16px rgba(34, 211, 238, 0.35));
  }
  .bright-star-loader__message {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    margin: 0;
  }
  @keyframes bright-star-loader-pulse {
    0%, 100% { transform: scale(1);    opacity: 0.85; }
    50%      { transform: scale(1.06); opacity: 1;    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bright-star-loader__star {
      animation: none;
      filter: none;
    }
  }
</style>
