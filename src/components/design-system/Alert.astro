---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  as?: 'div' | 'section';
  tone?: 'info' | 'success' | 'warning' | 'error';
}
const { as: Tag = 'div', tone = 'info', class: className, ...attrs } = Astro.props;
---
<Tag {...attrs} class:list={['ds-alert', className]} data-tone={tone}><slot /></Tag>
