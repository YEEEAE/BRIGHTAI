<div class="content-extension" data-content-extension><slot /></div>
<style>
  .content-extension { margin-block-start: clamp(48px, 7vw, 96px); border-block-start: 1px solid #303039; padding-block-start: 32px; min-width: 0; }
  .content-extension :global(section + section) { margin-block-start: 48px; }
  .content-extension :global(h2) { font-size: clamp(23px, 3vw, 36px); line-height: 1.5; margin-block: 0 20px; }
  .content-extension :global(h3) { font-size: 20px; line-height: 1.6; }
  .content-extension :global(p), .content-extension :global(li), .content-extension :global(dd) { line-height: 1.95; color: #c6c6cf; overflow-wrap: anywhere; }
  .content-extension :global(a) { text-decoration: underline; text-underline-offset: 5px; }
  .content-extension :global(a:focus-visible), .content-extension :global(summary:focus-visible) { outline: 2px solid #f6b94b; outline-offset: 5px; }
  .content-extension :global(.extension-columns) { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 28px; }
  .content-extension :global(.extension-scroll) { overflow-x: auto; max-width: 100%; }
  .content-extension :global(table) { width: 100%; border-collapse: collapse; font-size: 16px; }
  .content-extension :global(th), .content-extension :global(td) { text-align: start; vertical-align: top; padding: 16px 12px; border-block-end: 1px solid #303039; overflow-wrap: anywhere; }
  .content-extension :global(ol), .content-extension :global(ul) { padding-inline-start: 24px; }
  .content-extension :global(li + li) { margin-block-start: 12px; }
  .content-extension :global(details) { border-block-end: 1px solid #303039; padding-block: 10px; }
  .content-extension :global(summary) { cursor: pointer; min-height: 44px; padding-block: 10px; color: #fff; }
  .content-extension :global(.extension-label) { color: #f6b94b; font-size: 14px; }
  .content-extension :global(.extension-path) { display: grid; gap: 16px; counter-reset: step; list-style: none; padding: 0; }
  .content-extension :global(.extension-path li) { counter-increment: step; border-inline-start: 2px solid #9d7aff; padding-inline-start: 20px; }
  .content-extension :global(.extension-path li::before) { content: '0' counter(step) ' / '; color: #f6b94b; }
  .content-extension :global(blockquote) { border-inline-start: 2px solid #f6b94b; margin-inline: 0; padding-inline-start: 24px; }
</style>
