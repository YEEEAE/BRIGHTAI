<section id="ledger-demo" aria-label="مختبر سلسلة الأحداث">
  <p>DEMO / SYNTHETIC · SHA-256</p><h2>من القرار إلى أثر يمكن فحصه</h2>
  <p>تحقق من مثال تجريبي في المتصفح. بيانات افتراضية في الذاكرة فقط؛ لا تثبت عدم قابلية التعديل إنتاجيًا ولا تتصل بـ production Ledger.</p>
  <div class="tools"><button data-action="add">أضف حدثين</button><button data-action="verify">تحقق من السلسلة</button><button data-action="alter">غيّر حدثًا</button><button data-action="reset">إعادة الضبط</button><button data-action="empty">إفراغ المثال</button><button data-action="export">Export JSON</button></div>
  <p role="status" id="chain-status">جارٍ إنشاء الحدث الافتراضي…</p>
  <div class="evidence-grid"><section><h3>Timeline · تسلسل الأدلة</h3><ol id="chain-timeline"></ol></section><section aria-labelledby="inspector-title"><h3 id="inspector-title">Inspector · تفاصيل السجل</h3><div id="chain-inspector"></div></section></div>
  <p>مسار المثال: Firewall → Human Gate → Ledger. <a href="/demo/firewall/">شاهد Firewall</a> · <a href="/demo/human-gate/">شاهد Human Gate</a> — أمثلة معزولة؛ لا تُنقل بيانات بينها.</p>
</section>
<script>
import {createEvent,verifyChain,exportDemo} from '../shared/ledger-demo.mjs';
const root=document.querySelector('#ledger-demo');
if(root){
let events=[],selected=0,busy=false;
const status=root.querySelector('#chain-status'), timeline=root.querySelector('#chain-timeline'), inspector=root.querySelector('#chain-inspector');
const setStatus=t=>{status.textContent=t;};
function render(){
 timeline.replaceChildren(); inspector.replaceChildren();
 events.forEach((event,i)=>{const li=document.createElement('li'),button=document.createElement('button');button.textContent=`${i+1}. ${event.event} · ${event.actor} · ${event.time} · hash ${event.hash.slice(0,12)}…`;button.setAttribute('aria-pressed',String(i===selected));button.onclick=()=>{selected=i;render();};li.append(button);timeline.append(li);});
 const event=events[selected];if(!event){inspector.textContent='EMPTY · لا توجد أحداث. أضف حدثين أو أعد الضبط.';return;}
 const dl=document.createElement('dl');Object.entries(event).forEach(([key,value])=>{const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=key;dd.textContent=String(value);dd.dir='auto';dl.append(dt,dd);});inspector.append(dl);
}
async function run(action){if(busy)return;busy=true;root.querySelectorAll('.tools button').forEach(b=>b.disabled=true);
try{
if(action==='reset'){events=[await createEvent(0,'GENESIS')];selected=0;setStatus('غير مفحوصة · حدث افتراضي واحد جاهز.');}
if(action==='add'){if(events.length>=3){setStatus('اكتمل المثال: ثلاثة أحداث. أعد الضبط لتكراره.');return;}while(events.length<3){events.push(await createEvent(events.length,events.at(-1)?.hash||'GENESIS'));}setStatus('أُضيف حدثا Firewall وHuman Gate. افتح سجلًا ثم تحقق.');}
if(action==='empty'){events=[];selected=0;setStatus('EMPTY · السلسلة فارغة؛ لا توجد أدلة للتحقق.');}
if(action==='alter'&&events.length){events[selected].reason='سبب معدّل في المثال';setStatus(`تم تغيير سبب الحدث ${selected+1} مع إبقاء hash المحفوظ؛ تحقق لاكتشاف الخلل.`);}
if(action==='verify'){setStatus('جارٍ حساب SHA-256…');const result=await verifyChain(events);setStatus(result.state==='empty'?'EMPTY · لا توجد أحداث للتحقق.':result.state==='valid'?`VALID ✓ · ${events.length} أحداث متسقة في هذا المثال المحلي.`:`ALTERED ✕ · أول خلل في الحدث ${result.index+1}: ${result.reason}. قارن hash المحفوظ بالمحسوب في Inspector.`);if(result.index!==undefined){selected=result.index;render();const p=document.createElement('p');p.textContent=`hash المحسوب: ${result.computed}`;inspector.append(p);return;}}
if(action==='export'){const blob=new Blob([exportDemo(events)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='ledger-demo-synthetic.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);setStatus('تم تصدير JSON محلي بوسم DEMO / SYNTHETIC؛ أحداث اصطناعية فقط.');}
render();
}catch{setStatus('تعذر الحساب. يلزم متصفح يدعم Web Crypto وسياق HTTPS أو localhost.');}finally{busy=false;root.querySelectorAll('.tools button').forEach(b=>b.disabled=false);}}
root.querySelectorAll('[data-action]').forEach(b=>b.addEventListener('click',()=>run(b.dataset.action)));run('reset');
const reset=root.closest('[data-lab-shell]')?.querySelector('[data-lab-reset]');
if(reset){reset.hidden=false;reset.addEventListener('click',()=>run('reset'));}
}
</script>
<style>
#ledger-demo{margin-block:32px;padding:24px;border:1px solid var(--border-strong,#52617d);background:var(--surface-sunken,#151f32);border-radius:16px}.tools{display:flex;flex-wrap:wrap;gap:8px}.evidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.evidence-grid section{min-width:0}button{font:inherit;padding:12px;min-height:48px;cursor:pointer;background:var(--surface-raised,#e1f9f4);color:var(--color-text,#132b32);border:1px solid var(--border-strong,#849ca7);border-radius:8px}button:disabled{opacity:.5}button[aria-pressed=true]{outline:3px solid var(--color-focus,#77e7df)}button:focus-visible{outline:3px solid white;outline-offset:4px}ol{padding-inline-start:24px}li{margin-block:14px}li button{text-align:start;width:100%;overflow-wrap:anywhere}dt{font-weight:700;color:var(--color-focus,#aee6db)}dd{margin:0 0 16px;overflow-wrap:anywhere;font-family:monospace}#chain-status{padding:16px;border-block:1px solid var(--border-strong,#52617d);overflow-wrap:anywhere}@media(max-width:700px){.evidence-grid{grid-template-columns:1fr}#ledger-demo{padding:16px}}
</style>
