---
/**
 * EvidenceFileMockup — Evidence records table → cards on mobile.
 * Static HTML, no JS required. Demo data only.
 */
import KernelBadge from './kernel/KernelBadge.astro';
import { evidenceRecords, riskLevelClass, riskLevelLabel } from '../data/kernel';
import type { EvidenceRecord } from '../data/kernel';

interface Props { records?: EvidenceRecord[] }
const { records = evidenceRecords } = Astro.props;
---

<style>
  .k-evidence-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-xs);
  }
  .k-evidence-table th {
    text-align: start;
    padding: var(--space-3) var(--space-4);
    color: var(--text-soft);
    font-weight: var(--weight-medium);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .k-evidence-table td {
    padding: var(--space-3) var(--space-4);
    color: var(--text);
    border-bottom: 1px solid var(--border-soft);
    vertical-align: top;
  }

  /* Mobile cards */
  .k-evidence-cards { display: none; }
  .k-evidence-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-4);
    margin-bottom: var(--space-3);
  }
  .k-evidence-card__row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-1) 0;
    font-size: var(--text-xs);
  }
  .k-evidence-card__label { color: var(--text-soft); }
  .k-evidence-card__value { color: var(--text); font-weight: var(--weight-medium); }
  .k-evidence-card__demo {
    display: inline-block;
    font-size: 0.625rem;
    color: var(--text-faint);
    background: var(--glass);
    border-radius: var(--radius-xs);
    padding: var(--space-0-5) var(--space-1-5);
    margin-top: var(--space-2);
  }

  /* BAI-SEC-11 (2026-07-25) — hash cell (was inline style) */
  .k-evidence-hash {
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  @media (max-width: 768px) {
    .k-evidence-table { display: none; }
    .k-evidence-cards { display: block; }
  }
</style>

<!-- Desktop table -->
<table class="k-evidence-table" aria-label="سجل الأدلة">
  <thead>
    <tr>
      <th scope="col">المعرّف</th>
      <th scope="col">الاستعلام</th>
      <th scope="col">الحالة</th>
      <th scope="col">المخاطر</th>
      <th scope="col">الدرجة</th>
      <th scope="col">التاريخ</th>
      <th scope="col">البصمة</th>
    </tr>
  </thead>
  <tbody>
    {records.map(r => (
      <tr class={riskLevelClass(r.riskLevel)}>
        <td>{r.id}</td>
        <td>{r.query}</td>
        <td>{r.status}</td>
        <td><KernelBadge level={r.riskLevel as any} label={riskLevelLabel(r.riskLevel)} size="sm" /></td>
        <td>{r.riskScore}/100</td>
        <td><time>{r.createdAt}</time></td>
        <td dir="ltr" class="k-evidence-hash">{r.hash}</td>
      </tr>
    ))}
  </tbody>
</table>

<!-- Mobile cards -->
<div class="k-evidence-cards" aria-label="سجل الأدلة">
  {records.map(r => (
    <article class={`k-evidence-card ${riskLevelClass(r.riskLevel)}`}>
      <div class="k-evidence-card__row">
        <span class="k-evidence-card__label">المعرّف</span>
        <span class="k-evidence-card__value">{r.id}</span>
      </div>
      <div class="k-evidence-card__row">
        <span class="k-evidence-card__label">الاستعلام</span>
        <span class="k-evidence-card__value">{r.query}</span>
      </div>
      <div class="k-evidence-card__row">
        <span class="k-evidence-card__label">الحالة</span>
        <span class="k-evidence-card__value">{r.status}</span>
      </div>
      <div class="k-evidence-card__row">
        <span class="k-evidence-card__label">المخاطر</span>
        <KernelBadge level={r.riskLevel as any} label={riskLevelLabel(r.riskLevel)} size="md" />
      </div>
      <div class="k-evidence-card__row">
        <span class="k-evidence-card__label">التاريخ</span>
        <time class="k-evidence-card__value">{r.createdAt}</time>
      </div>
      {r.demo && <span class="k-evidence-card__demo">بيانات توضيحية</span>}
    </article>
  ))}
</div>