  .sdaia-card, .sdaia-product, .sdaia-source-grid a { border: 1px solid var(--border-subtle); border-radius: 1rem; padding: 1.1rem; background: color-mix(in srgb, var(--surface-raised) 90%, transparent); text-decoration: none; }
  .sdaia-card > span { color: #0d9488; font-weight: 900; font-size: .8rem; }
  .sdaia-card p, .sdaia-product span, .sdaia-source-grid span { margin: .3rem 0 0; font-size: .92rem; }
