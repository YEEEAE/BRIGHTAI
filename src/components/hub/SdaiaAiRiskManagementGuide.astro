---
const toc = [
  ['answer', 'الخلاصة السريعة'],
  ['audience', 'من يهمه الإطار؟'],
  ['framework', 'وش يقول الإطار؟'],
  ['matrix', 'مصفوفة المخاطر'],
  ['workflow', 'التطبيق المؤسسي'],
  ['decision', 'جدول القرار'],
  ['checklist', 'قائمة التحقق'],
  ['brightai', 'وش يساعد فيه BrightAI؟'],
  ['sources', 'المصادر الرسمية'],
];

const phases = [
  { number: '01', title: 'تحديد السياق والنطاق', english: 'Context & scope', text: 'حدد الغرض من استخدام الذكاء الاصطناعي، الجهة المتأثرة، البيانات، والحدود التشغيلية للحالة.' },
  { number: '02', title: 'تحديد المخاطر وتقييمها', english: 'Identify & assess', text: 'احصر المخاطر المحتملة وقدّرها عبر العلاقة بين احتمالية الوقوع وحجم الأثر.' },
  { number: '03', title: 'معالجة المخاطر', english: 'Treat', text: 'اختَر استجابة مناسبة للمخاطر، ثم وثّق الضوابط والقرار والجهة المسؤولة.' },
  { number: '04', title: 'المتابعة والمراجعة المستمرة', english: 'Monitor & review', text: 'راجع الأداء والمخاطر مع الوقت؛ لأن مخرجات أنظمة AI قد تتغير أثناء التشغيل.' },
];

const workflow = [
  ['inventory', 'الجرد', 'وش عندك من نماذج وأدوات ووكلاء وحالات استخدام؟'],
  ['classify', 'التصنيف', 'وش البيانات والأثر والقطاع المرتبط بكل حالة؟'],
  ['assess', 'التقييم', 'كم احتمال الخطر؟ ووش حجم أثره؟'],
  ['assign owner', 'تعيين المالك', 'مين يملك القرار والمتابعة داخل الجهة؟'],
  ['control', 'الضابط', 'وش الإجراء الوقائي أو الكاشف المطلوب؟'],
  ['approve', 'الاعتماد', 'مين يقرر التشغيل أو قبول الخطر المتبقي؟'],
  ['monitor', 'المراقبة', 'وش المؤشرات والمراجعات بعد الإطلاق؟'],
  ['evidence', 'الدليل', 'كيف تثبت كل قرار وضابط ومراجعة؟'],
];

const brightaiLinks = [
  ['/solutions/ai-risk-classification/', 'AI Risk Classification', 'تصنيف استخدامات AI وربطها بمسار تحكم مناسب.'],
  ['/solutions/human-approval-layer/', 'Human Approval Layer', 'رفع القرارات الحساسة للمراجع البشري المخول.'],
  ['/solutions/ai-audit-trail/', 'AI Audit Trail', 'سجل مركزي للأحداث والقرارات والموافقات.'],
  ['/solutions/ai-evidence-file/', 'AI Evidence File', 'جمع الأدلة في ملف قابل للمراجعة والتصدير.'],
  ['/solutions/ai-governance-platform/', 'AI Governance Platform', 'طبقة تشغيل تربط السياسات والمخاطر والضوابط.'],
  ['/assessment/ai-governance-readiness/', 'Readiness Assessment', 'فحص إرشادي لنقاط الجاهزية والفجوات.'],
];
---

<section class="sdaia-hero" aria-labelledby="sdaia-guide-title">
  <div class="sdaia-hero__grid">
    <div>
      <p class="sdaia-kicker">دليل تنظيمي سعودي · SDAIA</p>
      <h1 id="sdaia-guide-title">الإطار الوطني لإدارة مخاطر الذكاء الاصطناعي</h1>
      <p class="sdaia-lede">إذا كانت جهتك تستخدم الذكاء الاصطناعي، فالإطار الوطني لإدارة مخاطر الذكاء الاصطناعي يعطيك منهجية سعودية عملية لتحديد المخاطر وتقييمها ومعالجتها ومراجعتها بشكل مستمر.</p>
      <div class="sdaia-meta" aria-label="بيانات الوثيقة">
        <span>SDAIA-P145</span><span>الإصدار 1.0</span><span>أبريل 2026</span>
      </div>
    </div>
    <div class="sdaia-hero__stamp" aria-label="حالة المصدر">
      <span class="sdaia-stamp__mark">AI<br />RMF</span>
      <span>مرجع إرشادي وطني</span>
      <small>آخر تحديث: 2026-08-24</small>
    </div>
  </div>
</section>

<details class="sdaia-mobile-toc">
  <summary>تنقّل داخل الدليل</summary>
  <nav aria-label="فهرس الدليل للجوال">{toc.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>
</details>

<div class="sdaia-layout">
  <aside class="sdaia-toc" aria-label="فهرس الدليل">
    <p>في هالدليل</p>
    <nav>{toc.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>
  </aside>

  <article class="sdaia-content">
    <section id="answer" class="sdaia-section sdaia-answer" aria-labelledby="answer-title">
      <p class="sdaia-label">الجواب المختصر</p>
      <h2 id="answer-title">وش هو إطار SDAIA لإدارة مخاطر AI؟</h2>
      <p>هو مرجع إرشادي من سدايا يقدّم منهجية موحدة للجهات الحكومية والخاصة في المملكة عشان تعرف مخاطر أنظمة الذكاء الاصطناعي، تقيسها، تعالجها، وتراجعها مع الوقت. الإطار ما يحول كل استخدام إلى نفس مستوى الرقابة؛ الفكرة أن مستوى التعامل يكون متناسبًا مع السياق والاحتمالية والأثر.</p>
      <div class="sdaia-note"><strong>تنبيه مهم:</strong> هذا الدليل يشرح الوثيقة الرسمية ويساعدك على تحويلها إلى تشغيل مؤسسي. ما هو رأيًا قانونيًا، ولا شهادة، ولا إعلان أن BrightAI معتمد أو مؤيد من سدايا.</div>
    </section>

    <section class="sdaia-section" aria-labelledby="sdaia-boundary-title">
      <p class="sdaia-label">المصدر الرسمي</p>
      <h2 id="sdaia-boundary-title">الوثيقة الرسمية أولًا، ثم طريقة التشغيل</h2>
      <p>المصدر الأساسي هو منشور <a href="https://sdaia.gov.sa/" target="_blank" rel="noopener noreferrer">الهيئة السعودية للبيانات والذكاء الاصطناعي (سدايا)</a> للإطار الوطني. راجع الوثيقة الأصلية وحدد ما ينطبق على جهتك قبل اعتماد أي تصنيف أو ضابط.</p>
      <h3>متطلب أو إرشاد رسمي</h3><p>المراحل والمنهجية الواردة هنا شرح للإطار المنشور، وليست قرارًا تنظيميًا فرديًا أو حكمًا قانونيًا على حالة استخدام محددة.</p>
      <h3>منهج BrightAI للتنفيذ</h3><p>الجرد والتصنيف والمالك والضابط والموافقة والدليل هي طريقة تشغيل من BrightAI لترتيب التطبيق، وليست إضافة متطلبات جديدة من سدايا.</p>
    </section>

    <section id="audience" class="sdaia-section" aria-labelledby="audience-title">
      <p class="sdaia-label">مين يبدأ؟</p>
      <h2 id="audience-title">مين يهمه الإطار وليش؟</h2>
      <div class="sdaia-card-grid">
        <div class="sdaia-card"><span>01</span><h3>الجهات الحكومية</h3><p>لأن استخدام AI في خدمة المستفيد أو دعم القرار يحتاج وضوحًا في المسؤولية، البيانات، والمراجعة.</p></div>
        <div class="sdaia-card"><span>02</span><h3>الشركات والقطاعات المنظمة</h3><p>لأن النموذج قد يتعامل مع بيانات عملاء أو قرارات مالية أو صحية أو تشغيلية ذات أثر.</p></div>
        <div class="sdaia-card"><span>03</span><h3>فرق التقنية والمخاطر</h3><p>لأن مخاطر AI قد تظهر بشكل غير متوقع، وتتغير مع البيانات والاستخدام، ويصعب أحيانًا تفسيرها أو إعادة إنتاجها.</p></div>
      </div>
    </section>

    <section id="framework" class="sdaia-section" aria-labelledby="framework-title">
      <p class="sdaia-label">وش تقول الوثيقة الرسمية؟</p>
      <h2 id="framework-title">أربع مراحل مترابطة لإدارة المخاطر</h2>
      <p>أعلنت سدايا أن منهجية إدارة المخاطر تقوم على دورة حياة تبدأ بالسياق والنطاق، ثم تحديد المخاطر وتقييمها، ثم معالجتها، وتختم بالمتابعة والمراجعة المستمرة.</p>
      <div class="sdaia-timeline">
        {phases.map((phase) => <div class="sdaia-phase"><div class="sdaia-phase__number">{phase.number}</div><div><p class="sdaia-phase__english">{phase.english}</p><h3>{phase.title}</h3><p>{phase.text}</p></div></div>)}
      </div>
    </section>

    <section id="matrix" class="sdaia-section" aria-labelledby="matrix-title">
      <p class="sdaia-label">طريقة القياس</p>
      <h2 id="matrix-title">مصفوفة الاحتمالية والأثر</h2>
      <p>يذكر المصدر الرسمي احتساب مستوى الخطر عبر مصفوفة تربط احتمال وقوعه بحجم أثره. الرسم التالي يوضح الفكرة بصريًا فقط؛ الألوان والتسميات التشغيلية الداخلية لازم تعتمدها جهتك ولا تُنسب تلقائيًا لسدايا.</p>
      <div class="sdaia-matrix-wrap" role="img" aria-label="مصفوفة توضيحية تربط احتمالية الوقوع بحجم الأثر">
        <span class="sdaia-matrix-y">احتمالية الوقوع</span>
        <div class="sdaia-matrix"><div class="sdaia-matrix__corner">احتمال<br />× أثر</div>{['أثر 1', 'أثر 2', 'أثر 3', 'أثر 4'].map(label => <span>{label}</span>)}{['احتمال 4', 'احتمال 3', 'احتمال 2', 'احتمال 1'].map((row, rowIndex) => <Fragment><strong>{row}</strong>{[0,1,2,3].map((col) => <i class={`sdaia-cell sdaia-cell--${Math.min(3, Math.max(0, rowIndex + col - 1))}`} aria-hidden="true"></i>)}</Fragment>)}</div>
        <span class="sdaia-matrix-x">حجم الأثر</span>
      </div>
    </section>

    <section id="workflow" class="sdaia-section" aria-labelledby="workflow-title">
      <p class="sdaia-label">من الإطار إلى التشغيل</p>
      <h2 id="workflow-title">كيف تطبق المؤسسة المنهجية يوميًا؟</h2>
      <p>الخطوات الثمان التالية طريقة تشغيلية مقترحة من BrightAI لترجمة دورة المخاطر إلى سجل واضح. هي ليست قائمة متطلبات جديدة من سدايا؛ خذ منها ما يناسب حجم جهتك ونطاقها واربطها بسياساتها والأنظمة الملزمة عليها.</p>
      <div class="sdaia-workflow">{workflow.map(([key, label, text], index) => <div class="sdaia-workflow__item"><span>{String(index + 1).padStart(2, '0')}</span><div><code>{key}</code><h3>{label}</h3><p>{text}</p></div></div>)}</div>
    </section>

    <section id="decision" class="sdaia-section" aria-labelledby="decision-title">
      <p class="sdaia-label">قرارات عملية</p>
      <h2 id="decision-title">جدول يساعدك تبدأ بدون تعقيد</h2>
      <div class="sdaia-table-wrap" tabindex="0" role="region" aria-label="جدول قرارات إدارة مخاطر الذكاء الاصطناعي">
        <table><thead><tr><th>إذا كانت الحالة...</th><th>السؤال اللي تسأله</th><th>أثر تشغيلي مقترح</th></tr></thead><tbody>
          <tr><th>تستخدم بيانات شخصية أو حساسة</th><td>هل البيانات ضرورية؟ ومن يقدر يشوفها؟</td><td>صنّف البيانات، قلّلها، وسجّل قرار المعالجة والمالك.</td></tr>
          <tr><th>تقترح قرارًا يمس عميلًا أو موظفًا</th><td>هل المخرج مسودة أم قرار؟</td><td>ارفع الحالات المؤثرة إلى مسار مراجعة بشرية موثق.</td></tr>
          <tr><th>تعتمد على نموذج خارجي أو مورد</th><td>وش حدود الاستخدام وتغيرات الخدمة؟</td><td>وثّق المورد، النطاق، الضوابط، ونقاط المراجعة الدورية.</td></tr>
          <tr><th>تغيّر سلوكها مع الوقت</th><td>وش المؤشر اللي ينبهنا على الانحراف؟</td><td>حدد مراقبة ومراجعة وإجراء تصعيد قبل الاستمرار.</td></tr>
        </tbody></table>
      </div>
    </section>

    <section id="checklist" class="sdaia-section" aria-labelledby="checklist-title">
      <p class="sdaia-label">قائمة بداية</p>
      <h2 id="checklist-title">Checklist جاهزية إدارة مخاطر AI</h2>
      <div class="sdaia-checklist">
        {['عندي سجل محدث لاستخدامات AI والنماذج والوكلاء والموردين.', 'كل حالة مرتبطة بغرض وبيانات وقطاع ومالك واضح.', 'استخدمت احتمال الوقوع وحجم الأثر لتحديد الأولوية.', 'حددت الضوابط والقرار قبل التشغيل، وليس بعد أول حادثة.', 'الحالات عالية الأثر لها مراجعة بشرية وصلاحية اعتماد معروفة.', 'عندي مؤشرات متابعة ومراجعة بعد الإطلاق.', 'أقدر أطلع سجلًا يشرح القرار والضابط والموافقة والدليل.'].map((item, index) => <label><input type="checkbox" /> <span><b>{String(index + 1).padStart(2, '0')}</b>{item}</span></label>)}
      </div>
    </section>

    <section id="brightai" class="sdaia-section sdaia-brightai" aria-labelledby="brightai-title">
      <p class="sdaia-label">طبقة التشغيل من BrightAI</p>
      <h2 id="brightai-title">وش تقدر BrightAI تساعد فيه؟</h2>
      <p>BrightAI ما يحل محل سدايا أو مسؤول المخاطر أو التقييم النظامي. دوره كطبقة تشغيل يساعدك تربط سجل الاستخدامات بالتصنيف والضوابط والموافقات والأدلة، عشان تصير المنهجية قابلة للتنفيذ والمراجعة.</p>
      <div class="sdaia-product-grid">{brightaiLinks.map(([href, title, text]) => <a href={href} class="sdaia-product"><strong>{title}</strong><span>{text}</span><em>افتح المسار ←</em></a>)}</div>
    </section>

    <section id="sources" class="sdaia-section sdaia-sources" aria-labelledby="sources-title">
      <p class="sdaia-label">مصادر التحقق</p>
      <h2 id="sources-title">المصدر الرسمي أولًا</h2>
      <div class="sdaia-source-grid">
        <a href="https://sdaia.gov.sa/en/MediaCenter/KnowledgeCenter/Pages/SDAIAPublications.aspx" target="_blank" rel="noopener noreferrer"><strong>منشورات سدايا</strong><span>صفحة النشر الرسمية التي تسمي الوثيقة وتاريخها.</span></a>
        <a href="https://sdaia.gov.sa/ar/MediaCenter/KnowledgeCenter/ResearchLibrary/ExecutiveSummaryAr.pdf" target="_blank" rel="noopener noreferrer"><strong>الملخص التنفيذي الرسمي PDF</strong><span>النسخة العربية المنشورة من سدايا، وهي المرجع اللغوي الأساسي.</span></a>
        <a href="https://www.spa.gov.sa/en/N2633725" target="_blank" rel="noopener noreferrer"><strong>إعلان الإطلاق عبر واس</strong><span>الإعلان الحكومي المؤرخ 14 يوليو 2026، وفيه مراحل المنهجية والمصفوفة والمبادئ.</span></a>
      </div>
      <p class="sdaia-source-note">آخر مراجعة تحريرية: 23 أغسطس 2026. راجع النسخة الرسمية الحالية قبل اتخاذ قرار مؤسسي؛ الإطار مرجع إرشادي، والالتزامات النظامية الأخرى تظل قائمة بحسب نطاق جهتك وقطاعها.</p>
    </section>
  </article>
</div>

<style>
  .sdaia-hero { border: 1px solid color-mix(in srgb, var(--brand-400) 32%, transparent); border-radius: 1.5rem; overflow: hidden; background: radial-gradient(circle at 15% 10%, rgba(56,189,248,.18), transparent 34%), linear-gradient(135deg, #0b1728, #112d38 68%, #163f40); color: #f8fafc; padding: clamp(1.4rem, 4vw, 3.5rem); }
  .sdaia-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem; align-items: end; }
  .sdaia-kicker, .sdaia-label, .sdaia-phase__english { color: #68e0ca; text-transform: uppercase; letter-spacing: .08em; font-size: .76rem; font-weight: 800; }
  .sdaia-hero h1 { max-width: 15ch; margin: .75rem 0 1rem; color: #fff; font-size: clamp(2rem, 5vw, 4.5rem); line-height: 1.12; letter-spacing: -.04em; }
  .sdaia-lede { max-width: 60ch; color: #c9d9dc; font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: 1.9; }
  .sdaia-meta { display: flex; gap: .55rem; flex-wrap: wrap; margin-top: 1.4rem; }
  .sdaia-meta span { border: 1px solid rgba(255,255,255,.18); border-radius: 999px; padding: .42rem .72rem; color: #d9f8f2; font-size: .82rem; }
  .sdaia-hero__stamp { min-width: 10rem; display: grid; gap: .6rem; justify-items: center; text-align: center; color: #c9d9dc; font-size: .9rem; }
  .sdaia-stamp__mark { display: grid; place-items: center; width: 7rem; aspect-ratio: 1; border: 1px solid #5eead4; border-radius: 50%; color: #5eead4; font-weight: 900; letter-spacing: .08em; line-height: 1.05; }
  .sdaia-hero__stamp small { color: #92adb3; line-height: 1.5; }
  .sdaia-layout { display: grid; grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr); gap: clamp(1.25rem, 4vw, 4rem); width: min(100%, 74rem); margin: 2.5rem auto 0; }
