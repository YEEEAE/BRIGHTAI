  .agentic-security__hero { max-width: 56rem; }
  .agentic-security h1 { font-size: clamp(2.15rem, 5vw, 4.5rem); line-height: 1.15; }
  .agentic-security h2 { font-size: clamp(1.45rem, 3vw, 2.35rem); }
  .agentic-security p { max-width: 70ch; line-height: 1.9; }
  .agentic-security__eyebrow, .agentic-security__label, .agentic-security__updated { color: var(--brand-300); font-weight: 800; }
  .agentic-security__source { padding-inline: 1.25rem; background: var(--surface-raised); border-radius: 1rem; }
