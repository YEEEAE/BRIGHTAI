---
const boundaries = [
  ['هوية الوكيل', 'عرّف المالك والنسخة والغرض قبل منح أي صلاحية.', 'سجل الوكيل وقرار اعتماده.'],
  ['صلاحيات الأدوات', 'امنح أقل صلاحية لازمة لكل موصل أو إجراء.', 'سجل الصلاحيات وتاريخ المراجعة.'],
  ['حدود البيانات', 'صنّف البيانات وامنع الإرسال غير المعتمد إلى وجهة أو نموذج خارجي.', 'قرار الفحص أو الحجب وسياقه.'],
  ['سلامة الطلب والمخرج', 'افحص prompt injection والمخرجات المخالفة للسياسة ضمن نقطة التكامل المفعّلة.', 'القاعدة المطابقة والتصعيد.'],
  ['المراقبة والحوادث', 'راقب الاستثناءات واحتفظ بمسار احتواء ومراجعة بعد الحادث.', 'سجل الحدث وقرار المعالجة.'],
];

const lifecycle = ['الجرد', 'تقييم الحدود', 'منح الصلاحية', 'الفحص والتنفيذ', 'المراقبة', 'مراجعة الحادث'];
---

<article class="agentic-security" aria-labelledby="agentic-security-title">
  <header class="agentic-security__hero">
    <p class="agentic-security__eyebrow">مركز معرفة · Agentic AI Security</p>
    <h1 id="agentic-security-title">أمن Agentic AI: كيف تحمي الوكيل قبل ما تعطيه أدوات وبيانات؟</h1>
    <p class="agentic-security__lede">أمن الوكلاء في المؤسسة السعودية يبدأ بتحديد هوية الوكيل وصلاحياته وحدود بياناته، ثم فحص مسار العمل ومراقبة الأحداث. الهدف مو منع الوكلاء؛ الهدف إن أي فعل مؤثر يكون داخل حدود قابلة للتفسير والمراجعة.</p>
    <p class="agentic-security__updated">آخر تحديث: 2026-08-24</p>
  </header>

  <section class="agentic-security__answer" aria-labelledby="agentic-security-answer">
    <p class="agentic-security__label">الجواب المختصر</p>
    <h2 id="agentic-security-answer">وش يختلف أمن الوكلاء عن حوكمتهم؟</h2>
    <p>أمن Agentic AI يحمي مسار تنفيذ الوكيل: الهوية، الصلاحيات، الأدوات، البيانات، الطلبات والمراقبة. أما الحوكمة فتحدد المالك والاعتماد وقبول الخطر. تحتاج المؤسسة السعودية الاثنين معًا، خصوصًا إذا الوكيل يقرأ أنظمة داخلية أو ينفذ إرسالًا أو تعديلًا خارج المحادثة.</p>
  </section>

  <section class="agentic-security__source" aria-labelledby="agentic-security-source">
    <p class="agentic-security__label">المصدر الرسمي</p>
    <h2 id="agentic-security-source">ابدأ بضوابط الأمن السيبراني ثم طبّقها على مسار الوكيل</h2>
    <p><a href="https://nca.gov.sa/en/regulatory-documents/controls-list/ecc/" target="_blank" rel="noopener noreferrer">ضوابط الأمن السيبراني الأساسية من الهيئة الوطنية للأمن السيبراني (NCA ECC)</a> هي المرجع الأساسي للضوابط الأمنية التي تنطبق بحسب نطاق الجهة. هذه الصفحة لا تقول إن كل ضابط مخصص للوكلاء أو ينطبق تلقائيًا على كل مؤسسة.</p>
  </section>

  <section aria-labelledby="agentic-security-boundary">
    <p class="agentic-security__label">متطلب أو إرشاد رسمي</p>
    <h2 id="agentic-security-boundary">المرجع الرسمي يحدد الضابط؛ نطاقك يحدد التطبيق</h2>
    <p>راجع النص الرسمي وسياسات جهتك لتحديد متطلبات الهوية والوصول والسجلات والاستجابة للحوادث. حالة استخدام الوكيل، القطاع، البيانات، والربط التقني هي التي تحدد مستوى الضبط المطلوب.</p>
    <div class="agentic-security__table-wrap"><table><caption>مصفوفة حدود أمن الوكيل — قالب توضيحي للمراجعة الداخلية</caption><thead><tr><th>الحد</th><th>سؤال التشغيل</th><th>الدليل المتوقع</th></tr></thead><tbody>{boundaries.map(([boundary, question, evidence]) => <tr><th scope="row">{boundary}</th><td>{question}</td><td>{evidence}</td></tr>)}</tbody></table></div>
  </section>

  <section aria-labelledby="agentic-security-approach">
    <p class="agentic-security__label">منهج BrightAI للتنفيذ</p>
    <h2 id="agentic-security-approach">نحوّل الحدود إلى مسار تشغيل وأدلة</h2>
    <p>BrightAI تقدر تساعد في ربط سجل الوكيل بسياسة الفحص، تصنيف الخطر، الموافقة البشرية، سجل التدقيق وملف الأدلة. هذا منهج تشغيل وليس شهادة أو رأيًا قانونيًا أو ضمانًا لمنع كل هجوم أو تسريب.</p>
    <figure class="agentic-security__lifecycle"><figcaption>مخطط أصلي: مسار مراجعة أمن الوكيل</figcaption><ol>{lifecycle.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{step}</li>)}</ol></figure>
  </section>

  <p class="agentic-security__next">لملكية الوكيل والاعتمادات ودورة حياته، راجع <a href="/hub/agentic-ai-governance/">حوكمة Agentic AI التشغيلية</a>.</p>
</article>

