---
const lifecycle = [
  ['01', 'سجّل', 'عرّف الوكيل، غرضه، مالكه، والمستخدمين والأنظمة اللي يتعامل معها.'],
  ['02', 'صنّف', 'قيّم أثره، استقلاليته، نوع البيانات، وحساسية الأدوات قبل ما تعطيه صلاحيات.'],
  ['03', 'اربط الأدوات والبيانات', 'امنح أقل صلاحية لازمة، وسجّل كل موصل ومصدر بيانات داخل النطاق.'],
  ['04', 'فعّل السياسات', 'حوّل قواعد المؤسسة إلى حدود تشغيل: وش مسموح، وش ممنوع، ومتى يصير تصعيد.'],
  ['05', 'اعتمد الأفعال العالية الخطورة', 'أي حذف أو إرسال خارجي أو قرار يمس عميل يحتاج موافقة واضحة قبل التنفيذ.'],
  ['06', 'سجّل وراقب', 'احتفظ بسياق الطلب، الأداة، القرار، المراجع، والنتيجة — ثم راقب الانحرافات.'],
  ['07', 'راجع', 'أعد التقييم عند تغيير النموذج أو الأدوات أو البيانات، وبجدول مراجعة يناسب الخطر.'],
];

const owners = [
  ['مالك الأعمال', 'Business owner', 'يحدد الغرض والقيمة والنتيجة المقبولة، ويتحمل مسؤولية أن الاستخدام يخدم عملية حقيقية.'],
  ['المالك التقني', 'Technical owner', 'يدير النموذج والتكاملات والصلاحيات، ويثبت كيف يشتغل الوكيل وما حدود فشله.'],
  ['مالك المخاطر والامتثال', 'Risk / compliance owner', 'يضع معيار التصنيف والقبول والتصعيد، ويتأكد أن الأدلة تكفي للمراجعة الداخلية.'],
  ['المعتمد', 'Approver', 'صاحب الصلاحية على الإطلاق أو الفعل عالي الخطورة؛ يعتمد أو يرفض أو يرجع الطلب بسبب مسجل.'],
];

const evidence = [
  ['سجل الوكيل', 'الاسم، الغرض، الإصدار، المالك، النطاق، الأدوات، البيانات، وحالة الاستخدام.'],
  ['سجل الصلاحيات', 'وش الأدوات المسموحة؟ مين وافق؟ ومتى تنتهي أو تحتاج إعادة مراجعة؟'],
  ['سجل القرار', 'الطلب، تصنيفه، السياسة المطابقة، هوية المعتمد، السبب، والوقت.'],
  ['سجل التشغيل', 'الأفعال اللي نفذها الوكيل، النتيجة، حالات الرفض، والتصعيد أو التدخل البشري.'],
  ['حزمة المراجعة', 'تغيرات النموذج، الحوادث، الاستثناءات، وقرار الاستمرار أو الإيقاف.'],
];
---

<article class="agentic-governance" aria-labelledby="agentic-governance-title">
  <header class="agentic-governance__hero">
    <div>
      <p class="agentic-governance__eyebrow">مركز معرفة · Agentic AI Governance</p>
      <h1 id="agentic-governance-title">حوكمة Agentic AI: مين يملك الوكيل ومتى يقدر يتصرف؟</h1>
      <p class="agentic-governance__lede">
        حوكمة Agentic AI هي نموذج تشغيل يحدد ملكية الوكيل، الأدوات والبيانات اللي يقدر يستخدمها، الأفعال اللي تحتاج موافقة، وكيف تثبت المؤسسة وش صار بعد التشغيل. الهدف مو تعطيل الوكلاء؛ الهدف إن كل وكيل يشتغل داخل نطاق معروف، بصلاحيات متناسبة مع الخطر، ومسار مراجعة تقدر تشرحه وقت التدقيق.
      </p>
      <p class="agentic-governance__updated">آخر تحديث: 2026-08-24</p>
      <div class="agentic-governance__meta" aria-label="ملخص الدليل">
        <span>دليل معلوماتي للمؤسسات السعودية</span>
        <span>تركيز: التشغيل والمساءلة والأدلة</span>
        <span>مو شهادة أو رأي قانوني</span>
      </div>
    </div>
    <aside class="agentic-governance__signal" aria-label="مبدأ الحوكمة">
      <span class="agentic-governance__signal-label">Governance signal</span>
      <strong>كل فعل مهم له مالك، قاعدة، ومُثبت.</strong>
      <span>إذا ما قدرت تحدد الثلاثة، الوكيل مو جاهز للتشغيل المستقل.</span>
    </aside>
  </header>

  <section class="agentic-governance__answer" aria-labelledby="agentic-answer-title">
    <p class="agentic-governance__kicker">الجواب المختصر</p>
    <h2 id="agentic-answer-title">وش الفرق بين حوكمة Agentic AI وأمن الوكلاء؟</h2>
    <p>
      أمن الوكلاء يركز على حماية النموذج والبيانات والأدوات من الهجوم أو التسريب. أما الحوكمة فتحدد <strong>من يملك القرار، وش اللي يحتاج اعتماد، ومتى نوقف الوكيل، وكيف نثبت تطبيق القاعدة</strong>. الاثنين يكملون بعض: الأمن يحمي مسار التنفيذ، والحوكمة تضبط سبب التنفيذ وصلاحيته ومسؤوليته.
    </p>
  </section>

  <section class="agentic-governance__source" aria-labelledby="agentic-source-title">
    <p class="agentic-governance__kicker">المصدر الرسمي</p>
    <h2 id="agentic-source-title">راجع المرجع السعودي قبل ما تحدد مسار الاعتماد</h2>
    <p>استند إلى <a href="https://sdaia.gov.sa/" target="_blank" rel="noopener noreferrer">سدايا</a> والنصوص والسياسات التي تنطبق على نطاق جهتك؛ هذه الصفحة لا تجعل كل إرشاد عامًا التزامًا موحدًا لكل وكيل أو مؤسسة.</p>
    <h3>متطلب أو إرشاد رسمي</h3><p>الجهة تحدد ما ينطبق من متطلبات الحوكمة والبيانات والأمن بحسب الاستخدام والقطاع.</p>
    <h3>منهج BrightAI للتنفيذ</h3><p>سجل الوكيل، التصنيف، الموافقات والأدلة هي طريقة تشغيل لتوضيح المسؤولية؛ ليست شهادة أو رأيًا قانونيًا.</p>
  </section>

  <section aria-labelledby="lifecycle-title">
    <div class="agentic-governance__section-heading">
      <p class="agentic-governance__kicker">دورة تشغيل قابلة للمراجعة</p>
      <h2 id="lifecycle-title">من تسجيل الوكيل إلى مراجعته الدورية</h2>
      <p>لا تعتبر الوكيل “مُعتمد” مرة وحدة وخلاص. أي تغيير في النموذج أو الصلاحيات أو البيانات ممكن يغير مستوى الخطر ويعيد دورة الحوكمة.</p>
    </div>
    <ol class="agentic-lifecycle" aria-label="دورة حياة حوكمة Agentic AI">
      {lifecycle.map(([number, title, description], index) => (
        <li class="agentic-lifecycle__step">
          <span class="agentic-lifecycle__number">{number}</span>
          <div><h3>{title}</h3><p>{description}</p></div>
          {index < lifecycle.length - 1 && <span class="agentic-lifecycle__arrow" aria-hidden="true">←</span>}
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="ownership-title">
    <div class="agentic-governance__section-heading">
      <p class="agentic-governance__kicker">Accountability model</p>
      <h2 id="ownership-title">الأدوار الأربعة اللي تمنع ضياع المسؤولية</h2>
      <p>مو لازم تكون أربعة أشخاص مختلفين، لكن لازم تكون الصلاحيات والمسؤوليات واضحة. فصل الدور يهم أكثر كل ما ارتفع أثر الوكيل أو اتسعت استقلاليته.</p>
    </div>
    <div class="agentic-owner-grid">
      {owners.map(([title, english, description]) => (
        <section class="agentic-owner-card">
          <span>{english}</span><h3>{title}</h3><p>{description}</p>
        </section>
      ))}
    </div>
    <div class="agentic-raci-wrap" role="region" aria-label="مصفوفة مسؤوليات حوكمة الوكلاء" tabindex="0">
      <table class="agentic-raci">
        <caption>مصفوفة RACI مبسطة لوكيل ينفذ إجراء عالي الخطورة</caption>
        <thead><tr><th scope="col">النشاط</th><th scope="col">مالك الأعمال</th><th scope="col">المالك التقني</th><th scope="col">المخاطر والامتثال</th><th scope="col">المعتمد</th></tr></thead>
        <tbody>
          <tr><th scope="row">تعريف الغرض والنطاق</th><td data-label="مالك الأعمال">A/R</td><td data-label="المالك التقني">C</td><td data-label="المخاطر والامتثال">C</td><td data-label="المعتمد">I</td></tr>
          <tr><th scope="row">منح الأدوات والبيانات</th><td data-label="مالك الأعمال">C</td><td data-label="المالك التقني">A/R</td><td data-label="المخاطر والامتثال">C</td><td data-label="المعتمد">I</td></tr>
          <tr><th scope="row">تصنيف وقبول الخطر</th><td data-label="مالك الأعمال">R</td><td data-label="المالك التقني">C</td><td data-label="المخاطر والامتثال">A/R</td><td data-label="المعتمد">A</td></tr>
          <tr><th scope="row">اعتماد فعل عالي الخطورة</th><td data-label="مالك الأعمال">C</td><td data-label="المالك التقني">I</td><td data-label="المخاطر والامتثال">C</td><td data-label="المعتمد">A/R</td></tr>
          <tr><th scope="row">مراجعة التشغيل والتغيير</th><td data-label="مالك الأعمال">A/R</td><td data-label="المالك التقني">R</td><td data-label="المخاطر والامتثال">R</td><td data-label="المعتمد">C</td></tr>
        </tbody>
      </table>
      <p class="agentic-raci__legend"><strong>R</strong> ينفذ · <strong>A</strong> يتحمل القرار النهائي · <strong>C</strong> يُستشار · <strong>I</strong> يُبلّغ</p>
    </div>
  </section>

  <section aria-labelledby="approval-title">
    <div class="agentic-governance__section-heading">
      <p class="agentic-governance__kicker">Approval flow</p>
      <h2 id="approval-title">مسار الموافقة: الوكيل يقترح، والإنسان يعتمد عند الحاجة</h2>
      <p>الموافقة ما تعني مراجعة كل خطوة صغيرة. عرّف مسبقًا الأفعال اللي تتطلب توقفًا، وخلي الأفعال منخفضة الأثر تمشي بسياسة واضحة وسجل تلقائي.</p>
    </div>
    <div class="agentic-approval" aria-label="مسار الموافقة على الفعل عالي الخطورة">
      <div><span>01</span><strong>الوكيل يطلب</strong><small>يشرح الفعل والسبب والبيانات المتأثرة.</small></div>
      <b aria-hidden="true">←</b>
      <div><span>02</span><strong>السياسة تفحص</strong><small>تطابق النطاق، التصنيف، والصلاحيات المطلوبة.</small></div>
      <b aria-hidden="true">←</b>
      <div><span>03</span><strong>المعتمد يقرر</strong><small>يعتمد، يرفض، أو يرجع الطلب بسبب واضح.</small></div>
      <b aria-hidden="true">←</b>
      <div><span>04</span><strong>ينفذ ويسجل</strong><small>النتيجة وقرار الإنسان يدخلون ملف الأدلة.</small></div>
    </div>
    <aside class="agentic-callout"><strong>قاعدة عملية:</strong> إذا كان الفعل يرسل بيانات خارج المؤسسة، يغيّر سجلًا، يحذف شيئًا، يصرف مبلغًا، أو يؤثر على حق شخص — اعتبره مرشحًا لمسار موافقة صريح حتى يثبت العكس.</aside>
  </section>

  <section aria-labelledby="checklist-title">
    <div class="agentic-governance__section-heading">
      <p class="agentic-governance__kicker">Governance checklist</p>
      <h2 id="checklist-title">قائمة فحص قبل تشغيل الوكيل</h2>
    </div>
    <div class="agentic-checklist">
      <label><input type="checkbox" disabled /> الوكيل مسجل وله مالك أعمال ومالك تقني.</label>
      <label><input type="checkbox" disabled /> الغرض، المستخدمون، البيانات، والنموذج موصوفة بوضوح.</label>
      <label><input type="checkbox" disabled /> التصنيف يراعي الاستقلالية وأثر الأفعال، مو اسم الأداة فقط.</label>
      <label><input type="checkbox" disabled /> كل أداة وموصل ومصدر بيانات داخل النطاق ومبرر.</label>
      <label><input type="checkbox" disabled /> الأفعال العالية الخطورة لها بوابة موافقة وصلاحية إيقاف.</label>
      <label><input type="checkbox" disabled /> سجل التشغيل يربط الفعل بالسياسة والمالك والنتيجة.</label>
      <label><input type="checkbox" disabled /> فيه trigger لإعادة المراجعة عند التغيير أو الحادث.</label>
    </div>
  </section>

  <section aria-labelledby="evidence-title">
    <div class="agentic-governance__section-heading">
      <p class="agentic-governance__kicker">Evidence by design</p>
      <h2 id="evidence-title">وش الأدلة اللي تجمعها من البداية؟</h2>
      <p>الدليل القوي يجاوب على أربع أسئلة: وش كان الوكيل يعرف؟ وش حاول يسوي؟ مين سمح؟ وش النتيجة؟</p>
    </div>
    <div class="agentic-evidence-grid">
      {evidence.map(([title, description]) => <div class="agentic-evidence-card"><span aria-hidden="true">▦</span><h3>{title}</h3><p>{description}</p></div>)}
    </div>
  </section>

  <section class="agentic-governance__brightai" aria-labelledby="brightai-title">
    <p class="agentic-governance__kicker">كيف تساعد BrightAI؟</p>
    <h2 id="brightai-title">قدرات تشغيلية تدعم النموذج — بدون ادعاء أنها تحل الحوكمة لحالها</h2>
    <p>BrightAI توفر لبنات تساعد الفريق يطبق النموذج: تقييم الجاهزية، سجل المخاطر، تصنيف الاستخدام، الموافقات البشرية، سجل التدقيق، وملف الأدلة. اختيار التغطية الفعلية يعتمد على نطاق مؤسستك وتصميم التكامل؛ المنصة ما تستبدل قرار المالك أو المراجعة القانونية.</p>
    <div class="agentic-capability-links">
      <a href="/tools/ai-risk-register/"><strong>قالب سجل المخاطر</strong><span>ابدأ بجرد الوكيل وتصنيفه</span></a>
      <a href="/solutions/ai-audit-trail/"><strong>سجل تدقيق AI</strong><span>اربط التشغيل بالدليل</span></a>
      <a href="/solutions/human-approval-layer/"><strong>طبقة الموافقة البشرية</strong><span>خلّ القرار عالي الأثر يمر على معتمد مخول</span></a>
      <a href="/solutions/ai-evidence-file/"><strong>ملف الأدلة</strong><span>جهّز مخرجات المراجعة</span></a>
      <a href="/assessment/ai-governance-readiness/"><strong>تقييم الجاهزية</strong><span>حدد الفجوات قبل التوسع</span></a>
    </div>
  </section>

  <footer class="agentic-governance__footer-note">
    <strong>الخلاصة:</strong> الوكيل القابل للتوسع مو بس وكيل “آمن”. هو وكيل معروف المالك، محدود الصلاحيات، واضح التصعيد، وكل فعل مهم فيه قابل للتفسير والمراجعة.
  </footer>
</article>

<style>
  .agentic-governance { width: min(100%, 72rem); margin-inline: auto; color: var(--text-primary); }
  .agentic-governance__hero { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(15rem, .55fr); gap: var(--space-8); align-items: end; padding: clamp(1.5rem, 4vw, 3.5rem); border: 1px solid color-mix(in srgb, var(--brand-400) 35%, transparent); border-radius: 1.5rem; background: radial-gradient(circle at 10% 0%, rgba(45, 212, 191, .14), transparent 42%), linear-gradient(135deg, rgba(9, 24, 40, .98), rgba(16, 35, 50, .82)); }
  .agentic-governance__eyebrow, .agentic-governance__kicker { color: var(--brand-300); font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .agentic-governance h1 { max-width: 16ch; margin: .65rem 0 1rem; font-size: clamp(2rem, 5vw, 4.35rem); line-height: 1.08; letter-spacing: -.045em; }
  .agentic-governance__lede { max-width: 70ch; margin: 0; color: var(--text-secondary); font-size: clamp(1rem, 1.7vw, 1.18rem); line-height: 1.9; }
  .agentic-governance__meta { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.5rem; color: var(--text-muted); font-size: .8rem; }
  .agentic-governance__meta span { padding: .45rem .7rem; border: 1px solid rgba(148, 163, 184, .22); border-radius: 999px; }
  .agentic-governance__signal { padding: 1.25rem; border-inline-start: 3px solid var(--brand-300); background: rgba(15, 23, 42, .5); }
  .agentic-governance__signal-label { display: block; color: var(--text-muted); font: .7rem ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; }
  .agentic-governance__signal strong { display: block; margin: .8rem 0; font-size: 1.35rem; line-height: 1.35; }
  .agentic-governance__signal span:last-child { color: var(--text-secondary); line-height: 1.7; }
  .agentic-governance > section { margin-top: clamp(3rem, 7vw, 6rem); }
  .agentic-governance__answer, .agentic-governance__brightai { padding: clamp(1.25rem, 3vw, 2.25rem); border: 1px solid rgba(45, 212, 191, .22); border-radius: 1rem; background: rgba(15, 23, 42, .48); }
  .agentic-governance h2 { margin: .45rem 0 1rem; font-size: clamp(1.5rem, 3vw, 2.35rem); line-height: 1.2; letter-spacing: -.025em; }
  .agentic-governance h3 { margin: 0; line-height: 1.35; }
  .agentic-governance p { color: var(--text-secondary); line-height: 1.9; }
  .agentic-governance__answer p:last-child { max-width: 75ch; margin-bottom: 0; }
  .agentic-governance__section-heading { max-width: 72ch; margin-bottom: 1.5rem; }
  .agentic-lifecycle { display: grid; grid-template-columns: repeat(7, minmax(8rem, 1fr)); gap: .7rem; padding: 0; margin: 0; list-style: none; }
  .agentic-lifecycle__step { position: relative; min-height: 12rem; padding: 1rem; border: 1px solid rgba(148, 163, 184, .2); border-radius: .85rem; background: linear-gradient(180deg, rgba(30, 41, 59, .72), rgba(15, 23, 42, .55)); }
  .agentic-lifecycle__number { color: var(--brand-300); font: .75rem ui-monospace, monospace; }
  .agentic-lifecycle__step h3 { margin-top: 2.1rem; font-size: 1rem; }
  .agentic-lifecycle__step p { margin: .55rem 0 0; font-size: .86rem; line-height: 1.65; }
  .agentic-lifecycle__arrow { position: absolute; inset-inline-start: -1rem; top: 50%; color: var(--brand-300); font-size: 1.25rem; transform: translateY(-50%); }
  .agentic-owner-grid, .agentic-evidence-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .agentic-owner-card, .agentic-evidence-card { padding: 1.25rem; border: 1px solid rgba(148, 163, 184, .2); border-radius: .85rem; background: rgba(15, 23, 42, .42); }
  .agentic-owner-card > span { color: var(--brand-300); font: .7rem ui-monospace, monospace; }
  .agentic-owner-card h3 { margin-top: 1.4rem; }
  .agentic-owner-card p, .agentic-evidence-card p { margin-bottom: 0; font-size: .9rem; }
  .agentic-raci-wrap { margin-top: 1.5rem; overflow-x: auto; border: 1px solid rgba(148, 163, 184, .2); border-radius: .85rem; }
  .agentic-raci { width: 100%; min-width: 48rem; border-collapse: collapse; text-align: start; }
  .agentic-raci caption { padding: 1rem; color: var(--text-secondary); text-align: start; }
  .agentic-raci th, .agentic-raci td { padding: .9rem 1rem; border-top: 1px solid rgba(148, 163, 184, .14); }
  .agentic-raci thead th { color: var(--brand-300); font-size: .78rem; }
  .agentic-raci tbody th { color: var(--text-primary); font-weight: 700; }
  .agentic-raci td { color: var(--text-secondary); font: .82rem ui-monospace, monospace; }
  .agentic-raci__legend { padding: 0 1rem 1rem; margin: 0; font-size: .8rem; }
