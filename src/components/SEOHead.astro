---
/**
 * SEOHead — Complete SEO meta tags for every page.
 * Props: title, description, canonical, hreflang, ogImage, jsonLd
 * Always: robots is INDEX-FOLLOW (REPORTS-SEO-FOUNDATION, 2026-07-07),
 *         Google tag G-9LMB4PGTWJ, canonical self-reference.
 *
 * IMPORTANT: This component MUST NEVER emit <meta name="robots" content="noindex">
 * per the SEO foundation rule. The `robots` prop is sanitized below — any
 * `noindex` token is dropped and replaced with the canonical "index, follow, …"
 * directive. Pass `robots` only if you have a strong reason to override the
 * default; even then, noindex will be filtered out.
 */
import { SITE } from '../data/site';
import type { SEOProps } from '../data/site';
import { getHreflangLinks } from '../data/hreflang-pairs';
import DOMPurify from 'isomorphic-dompurify';

interface HreflangLink {
  lang: string;
  href: string;
}

interface Props extends SEOProps {
  locale?: 'ar' | 'en';
  /**
   * @deprecated No-index is forbidden. Will be normalized to "index, follow".
   */
  robots?: string;
  hreflang?: HreflangLink[];
  omitHreflang?: boolean;
}

const {
  title,
  description,
  canonical,
  hreflang = [],
  ogImage = SITE.ogImage,
  ogImageAlt = 'BrightAI - Saudi AI Safety OS',
  jsonLd,
  locale = 'ar',
  robots = 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
  omitHreflang = false,
} = Astro.props as Props;

// Robots directive (BAI-SEO-003-S1, 2026-07-18):
//   BaseLayout already owns the allowlist + final coercion (only /thank-you/
//   may emit noindex). SEOHead honors the value passed in as-is so the
//   downstream contract is single-source. If a page is noindex, hreflang
//   + x-default annotations are dropped (Google guidelines: a noindex page
//   must not carry hreflang, otherwise the cluster breaks). All other
//   pages get the foundation "index, follow, max-..." directive.
const isNoindexPage = /noindex/i.test(robots || '');
const safeRobots = robots || 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';

const fullOgImage = ogImage.startsWith('http') ? ogImage : `${SITE.url}${ogImage}`;
const siteName = SITE.name;

// BAI-SEO-003-S2 (2026-07-18): build hreflang from the explicit pair map
// (src/data/hreflang-pairs.ts) instead of deriving /en/ by string replacement.
// getHreflangLinks() guarantees: self-reference + return tag + x-default,
// and never invents an en-SA counterpart for AR-only pages.
const explicitHreflang = canonical ? getHreflangLinks(canonical) : [...hreflang];

// BAI-SEO-003-S1 (2026-07-18): drop hreflang annotations on noindex pages
// (Google cluster contract). When a page is noindex, we keep no
// hreflang links at all — neither the explicit ones from the map nor any
// passed-in prop, and we do not emit x-default. This keeps the
// noindex contract consistent across crawlers.
const validHreflang = explicitHreflang.filter(
  (link) => typeof link.lang === 'string' && link.lang.trim().length > 0 &&
    typeof link.href === 'string' && link.href.trim().length > 0,
);
const uniqueHreflang = Array.from(
  new Map(validHreflang.map((link) => [`${link.lang}:${link.href}`, link])).values(),
);
const finalHreflang = isNoindexPage || omitHreflang ? [] : uniqueHreflang;
const finalHasXDefault = finalHreflang.some((link) => link.lang === 'x-default');
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={safeRobots} />
<link rel="canonical" href={canonical} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale === 'en' ? 'en_SA' : 'ar_SA'} />
<meta property="og:locale:alternate" content={locale === 'en' ? 'ar_SA' : 'en_SA'} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@brightai_sa" />
<meta name="twitter:creator" content="@brightai_sa" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Hreflang -->
{finalHreflang.map((link) => (
  <link rel="alternate" hreflang={link.lang} href={link.href} />
))}
{!finalHasXDefault && finalHreflang.length > 0 && !isNoindexPage && (
  <link rel="alternate" hreflang="x-default" href={canonical} />
)}

<!-- JSON-LD Structured Data -->
{jsonLd && (
  <script id="brightai-production-schema" type="application/ld+json" set:html={DOMPurify.sanitize(JSON.stringify(jsonLd))} />
)}

<!-- Note: Google Analytics (gtag.js) is injected once in BaseLayout.astro to prevent duplicate pageview tracking. -->
