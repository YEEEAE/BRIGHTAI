0,212,255,.2));border:1px solid rgba(37,211,102,.3)\">\n          <svg class=\"inline-icon\" aria-hidden=\"true\"><use href=\"/icons.svg#mdi-check-all\"></use></svg>\n        </div>\n        <div>\n          <div class=\"font-bold mb-1\">Approval Status</div>\n          <p class=\"text-white/60 text-sm\">حالة الموافقة: مُوافَق عليه / قيد المراجعة / مرفوض / يتطلب موافقة بشرية.</p>\n        </div>\n      </div>\n      <div class=\"feature-card glass rounded-2xl p-5 flex items-start gap-4\">\n        <div class=\"w-10 h-10 rounded-xl flex items-center justify-center shrink-0\" style=\"background:linear-gradient(135deg,rgba(124,92,255,.3),rgba(255,92,167,.3));border:1px solid rgba(124,92,255,.3)\">\n          <svg class=\"inline-icon\" aria-hidden=\"true\"><use href=\"/icons.svg#mdi-file-lock\"></use></svg>\n        </div>\n        <div>\n          <div class=\"font-bold mb-1\">Policy Applied</div>\n          <p class=\"text-white/60 text-sm\">السياسة والـ controls المُطبَّقة على هذا التفاعل. ربط مباشر مع Policy to Control Mapping.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ================= MID-PAGE CTA ================= -->\n<section class=\"pb-16 lg:pb-20\">\n  <div class=\"max-w-7xl mx-auto px-5 lg:px-8\">\n    <div class=\"glass rounded-3xl p-8 lg:p-12 text-center\" style=\"background:linear-gradient(135deg,rgba(0,212,255,.06),rgba(124,92,255,.06))\">\n      <div class=\"flex justify-center mb-6\">\n        <div class=\"w-16 h-16 rounded-full flex items-center justify-center glow-btn\">\n          <svg class=\"inline-icon\" aria-hidden=\"true\"><use href=\"/icons.svg#mdi-clipboard-list\"></use></svg>\n        </div>\n      </div>\n      <h2 class=\"text-2xl sm:text-3xl font-black mb-4\">جاهز لتوثيق كل استخدام AI في مؤسستك؟</h2>\n      <p class=\"text-white/60 mb-8 max-w-2xl mx-auto\">AI Audit Trail من BrightAI يبدأ يسجّل من اللحظة الأولى. لا إعداد معقد، لا تكامل مطوّل — فقط توثيق فوري وكامل.</p>\n      <div class=\"flex flex-wrap ju