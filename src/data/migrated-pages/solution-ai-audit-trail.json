2001</span>\n          <span><svg class=\"inline-icon\" aria-hidden=\"true\"><use href=\"/icons.svg#mdi-check\"></use></svg>تصدير PDF/CSV/JSON</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
