{
  "color": {
    "void": {
      "$value": "#000000",
      "$type": "color",
      "$description": "Void — Page canvas, section backgrounds, negative space — pure black is the dominant surface, not dark gray, creating the void that lets chromatic accents float"
    },
    "bone-white": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Bone White — Headlines, body text, icon fills, nav active state — the only typographic color, carrying maximum hierarchy on black"
    },
    "ash-gray": {
      "$value": "#9a9a9a",
      "$type": "color",
      "$description": "Ash Gray — Muted nav text, ghost link color, secondary labels — recedes behind primary text without going invisible"
    },
    "silver-mist": {
      "$value": "#bdbdbd",
      "$type": "color",
      "$description": "Silver Mist — Tertiary body text, caption-level information — the quietest readable gray, for supporting context"
    },
    "electric-iris": {
      "$value": "#8052ff",
      "$type": "color",
      "$description": "Electric Iris — Primary action buttons, logo mark, brand accents — the single saturated violet that signals interactivity and brand identity against the black void"
    },
    "saffron-spark": {
      "$value": "#ffb829",
      "$type": "color",
      "$description": "Saffron Spark — Highlight emphasis text, accent links, attention punctuation — warm yellow against violet creates the brand's chromatic tension"
    },
    "deep-verdant": {
      "$value": "#15846e",
      "$type": "color",
      "$description": "Deep Verdant — Secondary surface tint, logo gradient stop — appears as the deeper end of the brand gradient and in subtle accent washes"
    }
  },
  "semantic": {
    "$description": "Single reference layer used by components. Primitives above are the approved palette; components must read these names, never raw hex values.",
    "surface-canvas": { "$value": "{color.void}", "$type": "color", "$description": "Page canvas" },
    "surface-raised": { "$value": "#0c0b12", "$type": "color", "$description": "Cards and panels above the canvas" },
    "surface-raised-hover": { "$value": "#17121f", "$type": "color", "$description": "Hover state of raised surfaces" },
    "surface-sunken": { "$value": "#08070b", "$type": "color", "$description": "Wells, code blocks, input backgrounds" },
    "text": { "$value": "{color.bone-white}", "$type": "color", "$description": "Primary text" },
    "text-muted": { "$value": "{color.silver-mist}", "$type": "color", "$description": "Secondary and body copy" },
    "text-subtle": { "$value": "{color.ash-gray}", "$type": "color", "$description": "Captions and non-essential labels" },
    "text-copy": { "$value": "#c6c1cf", "$type": "color", "$description": "Long-form Arabic copy; one step above muted silver for 16–18px paragraphs" },
    "border-subtle": { "$value": "#292630", "$type": "color", "$description": "Hairline divider" },
    "border-strong": { "$value": "#3a3442", "$type": "color", "$description": "Field and control outline" },
    "action": { "$value": "{color.electric-iris}", "$type": "color", "$description": "Primary action" },
    "action-hover": { "$value": "#9166ff", "$type": "color", "$description": "Primary action hover" },
    "action-contrast": { "$value": "{color.bone-white}", "$type": "color", "$description": "Text on primary action" },
    "focus": { "$value": "{color.saffron-spark}", "$type": "color", "$description": "Visible focus ring; never the only state cue" },
    "icon-accent": { "$value": "#a88bff", "$type": "color", "$description": "Product glyph tint on dark surfaces" },
    "icon-accent-strong": { "$value": "#b79af5", "$type": "color", "$description": "Interior glyph and marker tint" }
  },
  "state": {
    "$description": "Functional states. Every state must also carry a written label or a shape; colour alone is not a signal.",
    "success": { "$value": "{color.deep-verdant}", "$type": "color", "$description": "Verified success surface/mark (4.55:1 on void)" },
    "success-text": { "$value": "#4ec9aa", "$type": "color", "$description": "Success label text" },
    "warning": { "$value": "{color.saffron-spark}", "$type": "color", "$description": "Attention and review emphasis" },
    "warning-text": { "$value": "{color.saffron-spark}", "$type": "color", "$description": "Warning label text" },
    "error": { "$value": "#ff6b72", "$type": "color", "$description": "Denied/failed border and mark" },
    "error-text": { "$value": "#ff9ba0", "$type": "color", "$description": "Error label text" },
    "info": { "$value": "#9bcaff", "$type": "color", "$description": "Informational/not-configured notes" },
    "info-text": { "$value": "#b7d7ff", "$type": "color", "$description": "Info label text" },
    "disabled": { "$value": "#6f6b7a", "$type": "color", "$description": "Disabled control surface" },
    "disabled-text": { "$value": "{color.ash-gray}", "$type": "color", "$description": "Disabled label text" }
  },
  "font": {
    "arabic": {
      "$value": "Plex Arabic",
      "$type": "fontFamily",
      "$description": "Arabic-first family, served locally as IBM Plex Sans Arabic at weights 200/400/600. Headlines use weight 400 and scale for hierarchy; Arabic text always uses letter-spacing 0 so glyph joining is never broken."
    },
    "latin": {
      "$value": "Plex Arabic, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif",
      "$type": "fontFamily",
      "$description": "Latin and identifier text. Latin-only tracking is allowed; it must never be applied to Arabic runs, which are isolated with bdi."
    },
    "monospace": {
      "$value": "ui-monospace, SFMono-Regular, Menlo, monospace",
      "$type": "fontFamily",
      "$description": "Ledger hashes, IDs and code — always direction:ltr and isolated."
    }
  },
  "type": {
    "$description": "Arabic typographic scale locked to the sizes already in production. Fluid values use clamp() so headings never jump discontinuously.",
    "display": { "$value": "clamp(48px, 7.1vw, 102px)", "$type": "dimension", "$description": "Homepage H1" },
    "h1": { "$value": "clamp(38px, 5.3vw, 78px)", "$type": "dimension", "$description": "Interior page H1" },
    "h2": { "$value": "clamp(36px, 4.6vw, 66px)", "$type": "dimension", "$description": "Section H2" },
    "h3": { "$value": "clamp(27px, 2.7vw, 38px)", "$type": "dimension", "$description": "Card and panel H3" },
    "lead": { "$value": "clamp(18px, 1.7vw, 22px)", "$type": "dimension", "$description": "Lead paragraph" },
    "body": { "$value": "18px", "$type": "dimension", "$description": "Reading body" },
    "body-sm": { "$value": "16px", "$type": "dimension", "$description": "Compact body" },
    "table": { "$value": "16px", "$type": "dimension", "$description": "Table cells; tabular numbers" },
    "label": { "$value": "14px", "$type": "dimension", "$description": "Navigation and field labels" },
    "caption": { "$value": "12px", "$type": "dimension", "$description": "Captions and metadata; never for essential reading" },
    "leading-display": { "$value": 1.28, "$type": "number", "$description": "Arabic display leading" },
    "leading-h1": { "$value": 1.4, "$type": "number", "$description": "Arabic H1 leading" },
    "leading-h2": { "$value": 1.42, "$type": "number", "$description": "Arabic H2 leading" },
    "leading-h3": { "$value": 1.45, "$type": "number", "$description": "Arabic H3 leading" },
    "leading-body": { "$value": 1.85, "$type": "number", "$description": "Arabic body leading" },
    "leading-lead": { "$value": 1.9, "$type": "number", "$description": "Arabic lead leading" },
    "leading-table": { "$value": 1.7, "$type": "number", "$description": "Table leading" },
    "measure-reading": { "$value": "66ch", "$type": "dimension", "$description": "Long-form reading measure" }
  },
