  "motion": {
    "$description": "Single motion source. Hover/press stays within 120–160ms, state within 180–260ms, reveal within 350–480ms.",
    "fast": { "$type": "duration", "$value": { "value": 120, "unit": "ms" }, "$description": "Press and immediate local feedback" },
    "hover": { "$type": "duration", "$value": { "value": 140, "unit": "ms" }, "$description": "Hover/press response for controls and rows" },
    "state": { "$type": "duration", "$value": { "value": 220, "unit": "ms" }, "$description": "State change" },
    "reveal": { "$type": "duration", "$value": { "value": 480, "unit": "ms" }, "$description": "One-shot explanatory reveal" },
    "ease-out": { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1] },
    "transition-control": {
      "$type": "string",
      "$value": "transform var(--motion-hover) var(--ease-out), filter var(--motion-hover) var(--ease-out), background-color var(--motion-hover) var(--ease-out), border-color var(--motion-hover) var(--ease-out)",
      "$description": "Shared control transition; colour and lift use the same timing"
    }
  },
