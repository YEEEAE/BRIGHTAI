---
import { productNavigation, productEntryPath, productContactPath } from '../shared/product-navigation.mjs';
import Badge from '../components/design-system/Badge.astro';
import Breadcrumb from '../components/design-system/Breadcrumb.astro';
import LinkButton from '../components/design-system/LinkButton.astro';
import AccessSteps from '../components/AccessSteps.astro';
import { trialPath } from '../shared/access-journey.mjs';
import { authConfig } from '../server/kernel/auth.mjs';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import BrandLogo from '../components/BrandLogo.astro';
import WorkspaceNavigation from '../components/WorkspaceNavigation.astro';
import MonitoringGate from '../components/MonitoringGate.astro';
import { captureProductEvent } from '../server/observability/index.mjs';
import { productSlug, sectionFor } from '../server/observability/redact.mjs';
import '../styles/variables.css';
import '../styles/kernel.css';
import '../styles/design-system.css';
const { title = 'مساحة العمل', confidential = false } = Astro.props;
const currentProduct = productNavigation.find(product => Astro.url.pathname.startsWith(product.workspacePath));
const intendedProduct = productNavigation.find(product => Astro.url.searchParams.get('returnTo') === product.workspacePath);
const selectedProduct = currentProduct ?? intendedProduct;
const trialPage = Astro.url.pathname.replace(/\/$/, '') === '/app/trial';
const trialProduct = trialPage ? productNavigation.find(product => product.slug === Astro.url.searchParams.get('product')) : null;
const accountsConfigured = Boolean(authConfig());
const portalHome = Astro.url.pathname.replace(/\/$/, '') === '/app/kernel';
const productTrail = [
  { label: 'المنتجات', href: '/products/' },
  ...(selectedProduct ? [{ label: `عن ${selectedProduct.name}`, href: selectedProduct.publicPath }] : []),
  { label: 'لوحة البوابة', href: '/app/kernel/' },
  ...(!portalHome ? [{ label: currentProduct?.name ?? title }] : []),
];
// Server-side, explicit, and disabled unless the analytics approval gates are
// satisfied. Only a fixed section slug and product slug are sent: no user,
// tenant, workspace, email, query string, or page content.
if (!confidential && Astro.request.method === 'GET') {
  const section = sectionFor(Astro.url.pathname);
  if (section) void captureProductEvent('portal_viewed', { section });
  const product = productSlug(Astro.url.pathname);
  if (product) void captureProductEvent('product_opened', { product });
}
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('CDN-Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---
<!doctype html>
<html lang="ar-SA" dir="rtl">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>{title} | BRIGHTAI</title>{!confidential && <GoogleAnalytics />}<link rel="icon" href="/favicon.png" /></head>
  <body class="ds-theme">{!confidential && <MonitoringGate />}<a class="skip ds-skip" href="#main">انتقل للمحتوى</a>
    <div class="app-frame">
      <aside class="app-nav"><BrandLogo /><span class="overline">AIGAS / WORKSPACE</span>{trialPage
        ? <nav aria-label="مساحة التجربة"><a href={trialPath(trialProduct?.slug)} aria-current="page">التجربة المحدودة</a></nav>
        : <WorkspaceNavigation mode="app" current={currentProduct?.slug ?? 'kernel'}/>}<a class="site-link" href="/products/">المختبرات العامة <span aria-hidden="true">↗</span></a></aside>
      <div class="app-body"><header class="app-top"><span><span>مساحة العمل</span><span class="app-breadcrumb-separator" aria-hidden="true">/</span><bdi class="app-page-title" dir="auto">{title}</bdi><Badge id={trialPage ? "trial-access-status" : undefined} tone={accountsConfigured ? "info" : "warning"} data-access-status={accountsConfigured ? "account" : "unavailable"}>{accountsConfigured ? "يتطلب حسابًا" : "غير متاح حاليًا"}</Badge></span><bdi dir="ltr">BRIGHTAI / AIGAS</bdi></header><main id="main" tabindex="-1">
        <AccessSteps current={currentProduct ? "product" : "workspace"} slug={(selectedProduct ?? trialProduct)?.slug} track={trialPage ? "trial" : "beta"} />
        {!trialPage && <div class="journey-nav">
          <Breadcrumb aria-label="مسار المنتج" items={productTrail} />
          {currentProduct && <LinkButton href={productEntryPath(currentProduct.slug)} variant="quiet">الدخول بحسابك</LinkButton>}
        </div>}
        <slot />
        {selectedProduct && <section class="journey-nav" aria-label="الخطوة التالية"><a href={selectedProduct.publicPath}>تفاصيل <bdi dir="ltr">{selectedProduct.name}</bdi></a><a href={productContactPath(selectedProduct.slug, true)}>طلب اشتراك مستقل</a><a href={productContactPath(selectedProduct.slug)}>تواصل بشأن التقييم</a></section>}
      </main><footer class="app-footer"><a href="/status/">حالة النظام</a><a href="/docs/design-system/">نظام التصميم</a></footer></div>
    </div>
  </body>
</html>

<style>
  .journey-nav { display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-6) var(--spacing-18); padding-block: var(--spacing-12); margin-block-end: var(--spacing-18); border-block-end: 1px solid var(--border-subtle); line-height: 1.8; }
  .journey-nav a { display: inline-flex; align-items: center; min-block-size: 44px; overflow-wrap: anywhere; }
  .app-footer { display:flex; flex-wrap:wrap; gap:var(--spacing-6) var(--spacing-18); }
  .app-footer a { display:inline-flex; align-items:center; min-block-size:var(--ds-control-size); text-decoration:underline; }
</style>

<style>
  .app-frame .app-nav { position:sticky; z-index:var(--ds-z-raised); inset-block-start:0; block-size:100dvh; overflow-y:auto; align-self:start; }
  .app-frame .app-nav :global(.workspace-menu) { inline-size:100%; }
  .app-frame .app-nav :global(nav a) { font-size:14px; min-block-size:48px; }
  @media(max-width:999px) {
    .app-frame { display:block; }
    .app-frame .app-nav { position:static; block-size:auto; overflow:visible; display:block; padding:12px 18px; border-inline-end:0; border-block-end:1px solid var(--border-subtle); }
    .app-frame .app-nav :global(.brand-logo) { display:flex; inline-size:fit-content; }
    .app-frame .app-nav>.overline,.app-frame .app-nav>p,.app-frame .app-nav>.site-link { display:none; }
    .app-frame .app-nav :global(nav) { display:grid; overflow:visible; }
    .app-frame .app-nav :global(nav a) { white-space:normal; }
  }
</style>
