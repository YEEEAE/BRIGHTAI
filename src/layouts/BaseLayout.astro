---
import '../styles/variables.css';
import '../styles/site.css';
import '../styles/experience.css';
import MotionController from '../components/MotionController.astro';
import { brand } from '../data/brand';
interface Props {
  title: string;
  description: string;
  robots?: string;
  ogType?: 'website' | 'article';
}

const { title, description, robots: requestedRobots = 'index, follow', ogType = 'website' } = Astro.props;
const sensitiveQueryKeys = new Set(['token', 'access_token', 'refresh_token', 'id_token', 'oauth_token', 'invite_token', 'reset_token', 'code', 'auth_code', 'state', 'invite', 'invitation', 'key', 'secret', 'client_secret', 'session', 'ticket', 'signature', 'credential', 'password', 'verification', 'challenge', 'email']);
const hasSensitiveQuery = [...Astro.url.searchParams.keys()].some((key) => sensitiveQueryKeys.has(key.toLowerCase()));
const isPrivateRoute = Astro.url.pathname.startsWith('/auth/');
const robots = hasSensitiveQuery || isPrivateRoute ? 'noindex, nofollow' : requestedRobots;
const canonical = new URL(Astro.url.pathname, 'https://brightai.live').href;
if (robots.includes('noindex')) Astro.response.headers.set('X-Robots-Tag', robots);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'BRIGHTAI',
  url: 'https://brightai.live',
  logo: new URL(brand.logo, 'https://brightai.live').href,
  areaServed: {
    '@type': 'Country',
    name: 'Saudi Arabia',
  },
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'BRIGHTAI',
  url: 'https://brightai.live',
  inLanguage: 'ar-SA',
};
---

<!doctype html>
<html lang="ar-SA" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="preload" href="/fonts/plex-arabic-400.ttf" as="font" type="font/ttf" crossorigin />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" sizes="192x192" href={brand.favicon} />
    <link rel="apple-touch-icon" sizes="180x180" href={brand.touchIcon} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:site_name" content="BRIGHTAI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(brand.logo, 'https://brightai.live').href} />
    <meta property="og:image:secure_url" content={new URL(brand.logo, 'https://brightai.live').href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(brand.width)} />
    <meta property="og:image:height" content={String(brand.height)} />
    <meta property="og:image:alt" content={brand.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(brand.logo, 'https://brightai.live').href} />
    <meta name="twitter:image:alt" content={brand.alt} />
    <title>{title}</title>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9LMB4PGTWJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-9LMB4PGTWJ');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <slot />
    <MotionController />
  </body>
</html>
