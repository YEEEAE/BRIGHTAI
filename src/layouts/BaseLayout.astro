---
import '../styles/variables.css';
import '../styles/site.css';
import '../styles/experience.css';
import MotionController from '../components/MotionController.astro';
import { brand } from '../data/brand';
interface Props {
  title: string;
  description: string;
  robots?: string;
  ogType?: 'website' | 'article';
}

const { title, description, robots: requestedRobots = 'index, follow', ogType = 'website' } = Astro.props;
const sensitiveQueryKeys = new Set(['token', 'access_token', 'refresh_token', 'id_token', 'oauth_token', 'invite_token', 'reset_token', 'code', 'auth_code', 'state', 'invite', 'invitation', 'key', 'secret', 'client_secret', 'session', 'ticket', 'signature', 'credential', 'password', 'verification', 'challenge', 'email']);
const hasSensitiveQuery = [...Astro.url.searchParams.keys()].some((key) => sensitiveQueryKeys.has(key.toLowerCase()));
const isPrivateRoute = Astro.url.pathname.startsWith('/auth/');
const robots = hasSensitiveQuery || isPrivateRoute ? 'noindex, nofollow' : requestedRobots;
const canonical = new URL(Astro.url.pathname, 'https://brightai.live').href;
if (robots.includes('noindex')) Astro.response.headers.set('X-Robots-Tag', robots);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://brightai.live/#organization',
  alternateName: ['BRIGHT AI', 'مؤسسة مُشرقة'],
  description: 'مؤسسة سعودية متخصصة في حوكمة وأمان الذكاء الاصطناعي (AIGAS).',
  name: 'BRIGHTAI',
  url: 'https://brightai.live',
  logo: new URL(brand.logo, 'https://brightai.live').href,
  areaServed: {
    '@type': 'Country',
    name: 'Saudi Arabia',
  },
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://brightai.live/#website',
  publisher: { '@id': 'https://brightai.live/#organization' },
  name: 'BRIGHTAI',
  url: 'https://brightai.live',
  inLanguage: 'ar-SA',
};
---

<!doctype html>
<html lang="ar-SA" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="preload" href="/fonts/plex-arabic-400.ttf" as="font" type="font/ttf" crossorigin />
    <meta name="robots" content={robots} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" sizes="192x192" href={brand.favicon} />
    <link rel="apple-touch-icon" sizes="180x180" href={brand.touchIcon} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:site_name" content="BRIGHTAI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(brand.logo, 'https://brightai.live').href} />
    <meta property="og:image:secure_url" content={new URL(brand.logo, 'https://brightai.live').href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(brand.width)} />
    <meta property="og:image:height" content={String(brand.height)} />
    <meta property="og:image:alt" content={brand.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(brand.logo, 'https://brightai.live').href} />
    <meta name="twitter:image:alt" content={brand.alt} />
    <title>{title}</title>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9LMB4PGTWJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      // Mirrors src/server/observability/url-policy.mjs: allowlist, not a filter
      // that forwards whatever is left. Unknown query keys and the whole
      // fragment are dropped; an unknown referrer host is omitted entirely.
      const analyticsQueryAllowlist = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
      const analyticsReferrerHosts = ['brightai.live', 'www.brightai.live'];
      function analyticsUrl(value, base) {
        try {
          const url = new URL(value, base);
          if (!/^https?:$/.test(url.protocol) || url.username || url.password) return null;
          const out = new URL(url.protocol + '//' + url.host + url.pathname);
          for (const key of analyticsQueryAllowlist) {
            const candidate = url.searchParams.get(key);
            if (candidate !== null && /^[A-Za-z0-9._~-]{1,64}$/.test(candidate)) out.searchParams.set(key, candidate);
          }
          return out.href;
        } catch {
          return null;
        }
      }
      function analyticsReferrer(value) {
        try {
          const url = new URL(value);
          if (!/^https?:$/.test(url.protocol) || url.username || url.password) return null;
          if (url.origin !== window.location.origin && !analyticsReferrerHosts.includes(url.hostname.toLowerCase())) return null;
          return url.protocol + '//' + url.host + url.pathname;
        } catch {
          return null;
        }
      }
      const analyticsPage = { page_location: analyticsUrl(window.location.href, window.location.href) || (window.location.origin + window.location.pathname) };
      const pageReferrer = document.referrer ? analyticsReferrer(document.referrer) : null;
      if (pageReferrer) analyticsPage.page_referrer = pageReferrer;
      gtag('config', 'G-9LMB4PGTWJ', analyticsPage);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <slot />
    <MotionController />
  </body>
</html>
