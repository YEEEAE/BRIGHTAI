---
/**
 * BlogLayout — Blog article page layout. Used by src/pages/blog/[...slug].astro
 *
 * REPORT-BLOG-2026-07-07:
 *   - Body markdown now rendered via entry.render() + a named slot
 *     (`slot="article"`).
 *   - JSON-LD upgraded to schema.org `BlogPosting` (Google prefers this
 *     type for blog content).
 *   - Breadcrumbs component provided by the page via `slot="header"`.
 *   - Internal links grid driven by an `internalLinks` prop.
 *
 * BAI-LINK-03 (2026-07-29):
 *   - `breadcrumbs` is now an array of `{ name, href }` (without home crumb —
 *     FoundationSchema prepends it). Pages that previously passed `breadcrumbLd`
 *     as a pre-built object must convert to this array shape.
 *   - `hasHeaderBreadcrumbs` toggles the visual breadcrumbs inside the
 *     article-shell (preserves the legacy `<slot name="header">` position).
 *   - When `hasHeaderBreadcrumbs` is true, BlogLayout forwards
 *     `omitBreadcrumbsUI={true}` to BaseLayout to prevent duplicate visual
 *     navigation (BaseLayout would otherwise auto-render the same nav above
 *     the main slot).
 *   - The home crumb is added implicitly by FoundationSchema, so the visual
 *     Breadcrumbs component receives the same shape (home + page items) that
 *     appears in the JSON-LD.
 */
import ArabicLayout from './ArabicLayout.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import BlogToc from '../components/BlogToc.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SpeakableSchema from '../components/SpeakableSchema.astro';
import { SITE } from '../data/site';
import type { BlogPost } from '../data/blog';

interface InternalLink {
  href: string;
  label: string;
}

interface TocHeading {
  depth: 2 | 3;
  slug: string;
  text: string;
}

interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  post: BlogPost;
  relatedPosts: BlogPost[];
  internalLinks?: InternalLink[];
  /**
   * BAI-LINK-03 (2026-07-29): page-level breadcrumbs (without the home crumb —
   * added by FoundationSchema). Order: ancestors first, current last.
   * Replaces the previous `breadcrumbLd` object prop.
   */
  breadcrumbs?: BreadcrumbItem[];
  /**
   * BAI-LINK-03 (2026-07-29): when true, BlogLayout renders the visual
   * `<Breadcrumbs>` inside the article-shell (same position as the legacy
   * `<slot name="header">`). Also forwards `omitBreadcrumbsUI={true}` to
   * BaseLayout so it does NOT also render the same nav above `<main>`.
   */
  hasHeaderBreadcrumbs?: boolean;
  extraSchemaNodes?: Record<string, unknown>[];
  headings?: TocHeading[];
}

const {
  post,
  relatedPosts,
  internalLinks = [],
  breadcrumbs = [],
  hasHeaderBreadcrumbs = false,
  extraSchemaNodes = [],
  headings = [],
} = Astro.props;

const blogPostingLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${post.canonical}#blogPosting`,
  headline: post.title,
  description: post.description,
  image: {
    '@type': 'ImageObject',
    url: `${SITE.url}${post.ogImage}`,
    width: 1200,
    height: 630,
  },
  datePublished: post.pubDate,
  dateModified: post.updatedDate ?? post.pubDate,
  inLanguage: 'ar-SA',
  author: {
    '@type': 'Person',
    '@id': `${SITE.url}/authors/${post.author.slug}#person`,
    name: post.author.name,
    alternateName: post.author.nameEn,
    url: post.author.url,
    jobTitle: post.author.title,
  },
  // BAI-SEO-003-S3 (2026-07-18): publisher is a REFERENCE to the Organization
  // by @id (already emitted by FoundationSchema). The Organization node itself
  // is NOT redeclared here to avoid the duplicate @id=#organization that
  // triggered Google's entity-merge warning (verified via
  // scripts/_check-duplicate-schema-ids.mjs).
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: 'BrightAI',
    url: SITE.url,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE.url}${SITE.logo}`,
      width: 400,
      height: 400,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': post.canonical,
  },
  articleSection: post.category,
  articleBody: post.description,
  keywords: post.tags.join(', '),
  wordCount: post.readingTime * 200,
  url: post.canonical,
  isAccessibleForFree: true,
};

/**
 * BAI-SEO-003-S3 (2026-07-18): the previous BlogLayout emitted its own
 * WebPage@id={post.canonical}#webpage plus a separate ORGANIZATION node
 * in @graph. Both were duplicates of the foundation nodes emitted by
 * Schema.astro (`WebPage @id={canonical}#webpage` and
 * `Organization @id=https://brightai.live/#organization`). The duplicates
 * caused `scripts/_check-duplicate-schema-ids.mjs` to flag every blog
 * post. The speakable is now declared via `extraSpeakableSelectors` on
 * BaseLayout (`<BlogLayout ... extraSpeakableSelectors={['.article-hero__desc']} />`)
 * so FoundationSchema owns the single WebPage node with a unified
 * speakable list.
 *
 * BAI-LINK-03 (2026-07-29): `breadcrumbs` array is forwarded to BaseLayout
 * via ArabicLayout's `breadcrumbs` prop, which FoundationSchema converts
 * into the single BreadcrumbList JSON-LD node. The legacy `breadcrumbLd`
 * object prop is REMOVED to avoid duplicate BreadcrumbList emissions.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    blogPostingLd,
    ...extraSchemaNodes,
  ].filter(Boolean),
};

const visibleTags = (post.tags || []).slice(0, 4);

const authorInitials = post.author.name
  .replace(/^م\.\s*/, '')
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0] ?? '')
  .join('');

/**
 * BAI-LINK-03 (2026-07-29): visual breadcrumb chain used inside article-shell.
 * Home crumb is prepended here (matches what FoundationSchema emits in the
 * JSON-LD). Only rendered when the page opts in via `hasHeaderBreadcrumbs`.
 */
const visualCrumbs = hasHeaderBreadcrumbs
  ? [
      { label: 'الرئيسية', href: '/' },
      ...breadcrumbs.map((c) => ({ label: c.name, href: c.href })),
    ]
  : [];
---

<ArabicLayout
  title={post.metaTitle ?? `${post.title} | BrightAI`}
  description={post.description}
  canonical={post.canonical}
  hreflang={[{ lang: 'ar-SA', href: post.canonical }]}
  ogImage={post.ogImage}
  jsonLd={jsonLd}
  currentPath={`/blog/${post.slug}/`}
  extraSpeakableSelectors={['.speakable-summary']}
  breadcrumbs={breadcrumbs}
>
  <SpeakableSchema canonical={post.canonical} selectors={['h1', '.speakable-summary']} />
  <div class="reading-progress" hidden aria-hidden="true"></div>

  <div class="article-shell">
    {hasHeaderBreadcrumbs && <Breadcrumbs crumbs={visualCrumbs} />}

    <header class="article-hero" data-speakable>
      <a class="chip chip--brand article-hero__category" href={`/blog/category/${encodeURIComponent(post.category)}/`}>
        {post.category}
      </a>
      <h1>{post.title}</h1>
      <p class="article-hero__desc speakable-summary">{post.description}</p>
      <div class="article-hero__meta" aria-label="معلومات المقال">
        <span>
          <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-account"></use></svg>
          <a href={`/authors/${post.author.slug}/`}>{post.author.name}</a>
        </span>
        <span>
          <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-calendar"></use></svg>
          <time datetime={post.pubDate}>{post.pubDate}</time>
        </span>
        <span>
          <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-clock-outline"></use></svg>
          {post.readingTime} دقائق قراءة
        </span>
      </div>
      {visibleTags.length > 0 && (
        <div class="article-hero__tags" aria-label="الوسوم">
          {visibleTags.map((tag) => <span class="article-hero__tag">{tag}</span>)}
        </div>
      )}
    </header>

    {post.updatedDate !== post.pubDate && (
      <div class="article-updated">
        🔄 آخر تحديث: <time datetime={post.updatedDate}>{post.updatedDate}</time>
      </div>
    )}

    <BlogToc headings={headings} />

    <article class="article-content article-content--reading">
      <slot name="article" />
    </article>

    <aside class="author-bio" aria-labelledby="author-bio-name">
      <div class="author-bio__avatar" aria-hidden="true">{authorInitials}</div>
      <div class="author-bio__body">
        <p class="author-bio__role">كاتب المقال</p>
        <h2 id="author-bio-name" class="author-bio__name">
          <a href={`/authors/${post.author.slug}/`}>{post.author.name}</a>
        </h2>
        <p class="author-bio__text">{post.author.bio}</p>
      </div>
    </aside>

    <RelatedPosts posts={relatedPosts} />

    {internalLinks.length > 0 && (
      <section class="article-links" aria-labelledby="article-related-links">
        <p class="article-links__label">استكشف أعمق</p>
        <h2 id="article-related-links">محتوى ذو صلة</h2>
        <div class="article-links__grid">
          {internalLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      </section>
    )}

    <section class="article-demo-cta" aria-labelledby="blog-demo-title">
      <div class="card card--cta article-demo-cta__card">
        <h2 id="blog-demo-title">شاهد حوكمة AI وهي تعمل على حالاتك الفعلية</h2>
        <p>احجز جلسة تعريفية لمراجعة احتياج منشأتك ومسار التطبيق المناسب.</p>
        <a href="/contact/" class="btn btn--glow">
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-calendar-check"></use></svg>
          احجز ديمو
        </a>
      </div>
    </section>
  </div>

  <script>
    function initReadingProgress() {
      const article = document.querySelector('.article-content');
      const bar = document.querySelector('.reading-progress');
      if (!article || !bar || bar.hasAttribute('data-progress-initialized')) return;
      bar.removeAttribute('hidden');
      bar.setAttribute('data-progress-initialized', 'true');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let raf = 0;
      const update = () => {
        raf = 0;
        const rect = (article as HTMLElement).getBoundingClientRect();
        const viewportH = window.innerHeight;
        const scrolled = Math.min(Math.max(-rect.top / Math.max(rect.height - viewportH, 1), 0), 1);
        const percent = Math.round(scrolled * 100);
        (bar as HTMLElement).style.setProperty('--progress', `${percent}%`);
        if (percent > 4 && percent < 96) {
          bar.removeAttribute('hidden');
        } else {
          bar.setAttribute('hidden', '');
        }
      };
      const onScroll = () => { if (raf) return; raf = window.requestAnimationFrame(update); };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      if (reduceMotion) (bar as HTMLElement).style.transition = 'none';
      update();
    }
    document.addEventListener('astro:page-load', initReadingProgress);
    document.addEventListener('astro:before-swap', () => {
      document.querySelectorAll('.reading-progress[data-progress-initialized]').forEach((el) => {
        el.removeAttribute('data-progress-initialized');
      });
    });
  </script>
</ArabicLayout>
