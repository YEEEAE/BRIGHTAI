---
/**
 * EnglishLayout — English (LTR) pages layout.
 * Defaults: lang="en", dir="ltr", locale en-SA.
 */
import BaseLayout from './BaseLayout.astro';
import type { SEOProps } from '../data/site';

interface Props extends SEOProps {
  currentPath?: string;
  languageCounterpart?: string;
  /**
   * Page-level breadcrumbs (without the home crumb — added by FoundationSchema).
   */
  breadcrumbs?: Array<{ name: string; href?: string }>;
}

const {
  title,
  description,
  canonical,
  hreflang = [],
  ogImage,
  jsonLd,
  currentPath = '/',
  languageCounterpart,
  breadcrumbs = [],
} = Astro.props;
---

<BaseLayout
  lang="en"
  dir="ltr"
  title={title}
  description={description}
  canonical={canonical}
  hreflang={hreflang}
  ogImage={ogImage}
  jsonLd={jsonLd}
  currentPath={currentPath}
  languageCounterpart={languageCounterpart}
  breadcrumbs={breadcrumbs}
>
  <slot />
</BaseLayout>
