---
/**
 * KernelLayout — الشِل المشترك لكل صفحات /kernel/*.
 *
 * تحديث 2026-07-31 — رفع الشِل المشترك (مطابقة تصميم-صفحات-kernel §2):
 *  - حذف المتنافي: k-topnav (روابط أفقية) + k-drawer (legacy) + k-bottomnav.
 *    التنقّل صار: KernelSidebar (desktop + درج موبايل) + شريط علوي صادق واحد.
 *  - شريط علوي 56px: بحث Trace ID (320px) + شارات صادقة (Demo عنبري دائم ·
 *    Inference · DB · Latency) + زر ⌘K.
 *  - درج الرحلة (Trace Drawer): ينزلق من اليمين، 6 مراحل + سلسلة هاش + 5 بطاقات.
 *  - لوحة الأوامر ⌘K: مودال 640px بنتائج مجمّعة.
 *  - مبدّل الدور + نظام العرض التوضيحي في KernelSidebar + kernel-shell.js.
 *
 * ما تغيّر: <slot/> محتوى الصفحات محمي، skip-link، KernelJourney، kernel.css layer.
 *
 * PERF: kernel.css يُحمّل هنا فقط (KernelLayout.*.css bundle للـ /kernel/*).
 * CSP: kernel-drawer.js + kernel-shell.js + kernel-eval-store.js تُحمَّل
 * كـ static ES modules من /js/ (لا unsafe-inline). استيراد frontmatter لا
 * يصل للمتصفح (server-side فقط) — لهذا هي في public/js/ تُحمَّل عبر
 * <script type="module" src="/js/..."> بنمط kernel-sidebar.js.
 * RTL-aware، touch ≥44px، aria + keyboard nav.
 */
import BaseLayout from './BaseLayout.astro';
import KernelSidebar from '../components/kernel/KernelSidebar.astro';
import KernelJourneyProgress from '../components/kernel/KernelJourneyProgress.astro';
import KernelJourneyContext from '../components/kernel/KernelJourneyContext.astro';
import { kernelUnits } from '../data/kernel';
import DOMPurify from 'isomorphic-dompurify';

type SEOProps = import('../data/site').SEOProps;

type BreadcrumbItem = { name: string; href: string };

interface Props extends SEOProps {
  currentPath?: string;
  extraSpeakableSelectors?: string[];
  breadcrumbs?: Array<{ name: string; href?: string }>;
  robots?: string;
}

const {
  title,
  description,
  canonical,
  hreflang = [],
  ogImage,
  jsonLd,
  robots,
  currentPath = '/kernel/',
  extraSpeakableSelectors = [],
  breadcrumbs = [],
} = Astro.props;

const normalizedBreadcrumbs: BreadcrumbItem[] = breadcrumbs.map((crumb) => ({
  ...crumb,
  href: crumb.href ?? currentPath,
}));

const omitLocalBusiness = true;

// وحدات للوحة الأوامر (صفحات موجودة فقط).
const cmdkPages = kernelUnits.filter(u => u.slug !== 'index');
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={title}
  description={description}
  canonical={canonical}
  hreflang={hreflang}
  ogImage={ogImage}
  jsonLd={jsonLd}
  currentPath={currentPath}
  robots={robots}
  omitLocalBusiness={omitLocalBusiness}
  extraSpeakableSelectors={extraSpeakableSelectors}
  breadcrumbs={normalizedBreadcrumbs}
>
  <style is:global>
    @layer tokens, base, utilities, color, animations, kernel;
    @import '../styles/kernel.css' layer(kernel);
  </style>
  <style>
    /* Skip-link فقط هنا؛ باقي أنماط الشِل في kernel.css (global، layer kernel). */
    .k-skip-link {
      position: absolute;
      top: -100%;
      inset-inline-start: var(--space-2);
      z-index: 200;
      padding: var(--space-3) var(--space-5);
      background: linear-gradient(135deg, var(--brand-500) 0%, var(--brand-700) 100%);
      color: var(--text-inverse);
      font-weight: var(--font-bold);
      font-size: var(--text-sm);
      border-radius: 0 0 var(--radius-lg) var(--radius-lg);
      text-decoration: none;
      transition: top var(--duration-fast) var(--ease-out);
    }
    .k-skip-link:focus { top: 0; }
  </style>

  <!-- Skip-link -->
  <a href="#k-content" class="k-skip-link">تخطّى إلى المحتوى</a>

  <!-- السايدبار (desktop + درج موبايل) -->
  <KernelSidebar currentPath={currentPath} />

  <!-- ═══ الشريط العلوي الصادق (56px) ═══ -->
  <header class="k-topbar" role="banner">
    <div class="k-topbar__inner">
      <a class="k-topbar__brand" href="/kernel/" aria-label="BrightAI Kernel">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        <span class="k-topbar__brand-text">Kernel</span>
      </a>

      <!-- بحث Trace ID — يفتح الدرج فورًا -->
      <form class="k-topbar__search" role="search" data-kernel-trace-search>
        <svg class="k-topbar__search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input
          type="text"
          class="k-topbar__search-input"
          dir="ltr"
          inputmode="text"
          placeholder="AI-2026-…"
          aria-label="بحث برقم Trace ID"
          autocomplete="off"
          data-kernel-trace-input
        />
        <kbd class="k-topbar__search-kbd" aria-hidden="true">Enter</kbd>
      </form>

      <div class="k-topbar__status" aria-live="polite">
        <!-- Demo Data: عنبري دائم، لا يُخفى -->
        <span class="k-status-chip k-status-chip--demo" title="بيانات تجريبية">
          <span class="k-status-chip__dot k-status-chip__dot--amber" aria-hidden="true"></span>
          <span>Mode: Demo</span>
        </span>
        <span class="k-status-chip" title="محرّك الاستدلال">
          <span class="k-status-chip__label">Inference:</span>
          <strong>محرّك تجريبي</strong>
          <span class="k-status-chip__dot k-status-chip__dot--ok" aria-hidden="true"></span>
        </span>
        <span class="k-status-chip" title="قاعدة البيانات">
          <span class="k-status-chip__label">DB</span>
          <strong dir="ltr">12ms</strong>
          <span class="k-status-chip__dot k-status-chip__dot--ok" aria-hidden="true"></span>
        </span>
        <span class="k-status-chip k-status-chip--lat" title="زمن الاستجابة">
          <span class="k-status-chip__label">Latency</span>
          <strong dir="ltr">86ms</strong>
        </span>

        <!-- مبدّل العرض التوضيحي: بيانات تجريبية / بياناتي -->
        <button class="k-status-chip k-demo-toggle" type="button" data-kernel-demo-toggle aria-pressed="true" title="تبديل مصدر البيانات">
          <span class="k-demo-toggle__state" data-kernel-demo-label>بيانات تجريبية</span>
        </button>

        <!-- زر لوحة الأوامر -->
        <button class="k-topbar__cmdk" type="button" data-kernel-cmdk-open aria-label="فتح لوحة الأوامر">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 4l-2 2M18 20l2-2M4 6v12M20 6v12M6 4h12M6 20h12"/></svg>
          <kbd aria-hidden="true">⌘K</kbd>
        </button>
      </div>
    </div>
  </header>

  <!-- شريط رحلة Kernel (ثابت) -->
  <KernelJourneyProgress
    currentPath={currentPath}
    variant={currentPath === '/kernel/scenarios/' || currentPath === '/kernel/' ? 'full' : 'compact'}
  />

  <!-- المحتوى -->
  <div class="k-content" id="k-content" tabindex="-1">
    <slot />
    <KernelJourneyContext />
  </div>

  <!-- ═══ درج الرحلة (Trace Drawer) ═══ -->
  <!-- بيانات تجريبية موسومة Demo. يفتح فوق أي صفحة بلا تنقل. -->
  <div
    class="k-trace-drawer"
    id="k-trace-drawer"
    role="dialog"
    aria-modal="true"
    aria-labelledby="k-trace-title"
    aria-hidden="true"
  >
    <div class="k-trace-drawer__backdrop" data-kernel-trace-close></div>
    <div class="k-trace-drawer__panel" role="document">
      <header class="k-trace-drawer__head">
        <div class="k-trace-drawer__head-id">
          <h2 id="k-trace-title" class="k-trace-drawer__title">
            <span class="sr-only">رحلة الطلب</span>
            <span class="k-mono" dir="ltr" data-kernel-trace-id>AI-2026-10493</span>
          </h2>
          <span class="k-verdict k-verdict--block" data-kernel-trace-verdict>
            <span class="k-verdict__icon" aria-hidden="true">⊘</span>
            <span>محظور</span>
          </span>
        </div>
        <div class="k-trace-drawer__head-actions">
          <button class="k-icon-btn" type="button" data-kernel-trace-copy aria-label="نسخ Trace ID">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          </button>
          <button class="k-icon-btn" type="button" data-kernel-trace-close aria-label="إغلاق الدرج">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
      </header>

      <!-- شريط ملخص 4 خانات — القيم تعبَّأ من KernelEvalStore عبر kernel-drawer.js -->
      <div class="k-trace-drawer__summary">
        <div class="k-trace-drawer__cell"><span class="k-cell-label">المستخدم</span><strong data-kernel-drawer-user data-label="المستخدم">نورة العتيبي</strong></div>
        <div class="k-trace-drawer__cell"><span class="k-cell-label">القسم</span><strong data-kernel-drawer-dept data-label="القسم">التسويق</strong></div>
        <div class="k-trace-drawer__cell"><span class="k-cell-label">النموذج</span><strong dir="ltr" data-kernel-drawer-model data-label="النموذج">gpt-4o</strong></div>
        <div class="k-trace-drawer__cell"><span class="k-cell-label">الزمن الكلي</span><strong dir="ltr" data-kernel-drawer-time data-label="الزمن الكلي">412ms</strong></div>
      </div>

      <!-- الخط الزمني — 6 مراحل. يعبَّأ من trace.stages عبر kernel-drawer.js -->
      <ol class="k-timeline" aria-label="مراحل الطلب" data-kernel-timeline>
        <li class="k-timeline__item k-timeline__item--done">
          <span class="k-timeline__node" aria-hidden="true"></span>
          <details class="k-timeline__card" open>
            <summary class="k-timeline__head">
              <span class="k-timeline__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3"/></svg></span>
              <span class="k-timeline__name">١. الاستلام</span>
              <span class="k-timeline__time" dir="ltr">8ms</span>
              <span class="k-timeline__result k-timeline__result--ok">مرّ</span>
            </summary>
            <p class="k-timeline__detail">طلب جديد — 142 توكن، لغة: عربي.</p>
          </details>
        </li>
        <li class="k-timeline__item k-timeline__item--done">
          <span class="k-timeline__node k-timeline__node--mask" aria-hidden="true"></span>
          <details class="k-timeline__card">
            <summary class="k-timeline__head">
              <span class="k-timeline__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg></span>
              <span class="k-timeline__name">٢. فحص PII</span>
              <span class="k-timeline__time" dir="ltr">34ms</span>
              <span class="k-timeline__result k-timeline__result--mask">عُمّي</span>
            </summary>
            <p class="k-timeline__detail">اكتُشف 3 كيانات: هوية · جوال · IBAN — عُمّيت قبل الإرسال.</p>
          </details>
        </li>
        <li class="k-timeline__item k-timeline__item--done">
          <span class="k-timeline__node k-timeline__node--critical" aria-hidden="true"></span>
          <details class="k-timeline__card">
            <summary class="k-timeline__head">
              <span class="k-timeline__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></span>
              <span class="k-timeline__name">٣. تقييم المخاطر</span>
              <span class="k-timeline__time" dir="ltr">61ms</span>
              <span class="k-timeline__result k-timeline__result--critical">حرج · 87</span>
            </summary>
            <p class="k-timeline__detail">النقاط: +28 كيانات حساسة، +22 قسم تسويق، +18 ساعات الذروة… المجموع 87/100.</p>
          </details>
        </li>
        <li class="k-timeline__item k-timeline__item--done">
          <span class="k-timeline__node k-timeline__node--block" aria-hidden="true"></span>
          <details class="k-timeline__card">
            <summary class="k-timeline__head">
              <span class="k-timeline__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V17M6 21H18C19.1046 21 20 20.1046 20 19V13C20 11.8954 19.1046 11 18 11H6C4.89543 11 4 11.8954 4 13V19C4 20.1046 4.89543 21 6 21ZM16 11V7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7V11H16Z"/></svg></span>
              <span class="k-timeline__name">٤. مطابقة السياسات</span>
              <span class="k-timeline__time" dir="ltr">22ms</span>
              <span class="k-timeline__result k-timeline__result--block">حُظر</span>
            </summary>
            <p class="k-timeline__detail">اشتعلت: «تعمية الهوية PDPL» — تجاوز عتبة الحظر (70).</p>
          </details>
        </li>
        <li class="k-timeline__item k-timeline__item--skipped">
          <span class="k-timeline__node k-timeline__node--skip" aria-hidden="true"></span>
          <details class="k-timeline__card">
            <summary class="k-timeline__head">
              <span class="k-timeline__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path d="M9 12l2 2 4-4"/></svg></span>
              <span class="k-timeline__name">٥. استدعاء النموذج</span>
              <span class="k-timeline__time" dir="ltr">—</span>
              <span class="k-timeline__result k-timeline__result--skip">لن يُستدعى</span>
            </summary>
            <p class="k-timeline__detail">الطلب حُظر قبل وصوله للنموذج — لا استدعاء.</p>
          </details>
        </li>
        <li class="k-timeline__item k-timeline__item--done">
          <span class="k-timeline__node" aria-hidden="true"></span>
          <details class="k-timeline__card">
            <summary class="k-timeline__head">
              <span class="k-timeline__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
              <span class="k-timeline__name">٦. توليد الدليل</span>
              <span class="k-timeline__time" dir="ltr">19ms</span>
              <span class="k-timeline__result k-timeline__result--ok">EVD-10493</span>
            </summary>
            <p class="k-timeline__detail">وُلّد ملف دليل موقّع رقميًا (EVD-10493) للحظر.</p>
          </details>
        </li>
      </ol>

      <!-- سلسلة الهاش — تعبَّأ من run hashes عبر kernel-drawer.js -->
      <section class="k-hash-chain" aria-label="سلسلة الهاش" data-kernel-hash-chain>
        <h3 class="k-hash-chain__title">سلسلة الهاش</h3>
        <div class="k-hash-chain__boxes">
          <div class="k-hash-box">
            <span class="k-hash-box__label">السابق</span>
            <span class="k-mono k-hash-box__val" dir="ltr" data-kernel-hash-prev>0x9f2a…c1d4</span>
          </div>
          <span class="k-hash-chain__arrow" aria-hidden="true">←</span>
          <div class="k-hash-box k-hash-box--current">
            <span class="k-hash-box__label">الحالي</span>
            <span class="k-mono k-hash-box__val" dir="ltr" data-kernel-hash-curr>0xa7c8…2c1b</span>
            <span class="k-hash-box__ok" aria-label="سليم">✅</span>
          </div>
          <span class="k-hash-chain__arrow" aria-hidden="true">←</span>
          <div class="k-hash-box">
            <span class="k-hash-box__label">التالي</span>
            <span class="k-mono k-hash-box__val" dir="ltr" data-kernel-hash-next>0x3e0b…77fa</span>
          </div>
        </div>
      </section>

      <!-- ═══ تفاصيل موسّعة (M28 — دمج درج التدقيق) ═══
           تُعرض عندما يفتح الدرج من سياق تدقيق (seed) — JSON + snippet + إجراءات.
           تختبئ افتراضيًا؛ kernel-drawer.js يبدّلها حسب المصدر. -->
      <section class="k-trace-drawer__detail" hidden data-kernel-drawer-detail>
        <h3 class="k-hash-chain__title">الحالة والإجراء</h3>
        <dl class="k-trace-drawer__kv">
          <div><dt>الحالة</dt><dd data-kernel-drawer-status>—</dd></div>
          <div><dt>موافقة بشرية</dt><dd data-kernel-drawer-approval>—</dd></div>
          <div><dt>شذوذ</dt><dd data-kernel-drawer-anomaly>—</dd></div>
        </dl>
        <p class="k-trace-drawer__action" data-kernel-drawer-action>—</p>
      </section>

      <section class="k-trace-drawer__detail" hidden data-kernel-drawer-json>
        <h3 class="k-hash-chain__title">Trace JSON</h3>
        <pre class="k-trace-drawer__trace" data-kernel-drawer-json-body>—</pre>
      </section>

      <section class="k-trace-drawer__detail" hidden data-kernel-drawer-snippet>
        <h3 class="k-hash-chain__title">DevTools snippet</h3>
        <pre class="k-trace-drawer__trace" data-kernel-drawer-snippet-body>—</pre>
        <button class="k-trace-drawer__action-btn" type="button" data-kernel-drawer-copy-snippet aria-label="نسخ snippet التدقيق">نسخ الـ snippet</button>
      </section>

      <section class="k-trace-drawer__detail" hidden data-kernel-drawer-actions>
        <h3 class="k-hash-chain__title">إجراءات</h3>
        <div class="k-trace-drawer__action-row">
          <button class="k-trace-drawer__action-btn" type="button" data-kernel-drawer-copy-hash aria-label="نسخ الهاش">نسخ الهاش</button>
          <button class="k-trace-drawer__action-btn" type="button" data-kernel-drawer-export-pdf aria-label="تصدير PDF">تصدير PDF</button>
          <a class="k-trace-drawer__action-btn" href="/kernel/evidence/" data-kernel-drawer-link-evidence>افتح ملف الدليل</a>
        </div>
      </section>

      <!-- بطاقات الوحدات المصغّرة -->
      <section class="k-trace-units" aria-label="وحدات لمست هذا الطلب" data-kernel-trace-units>
        <a class="k-trace-unit" href="/kernel/chat/"><span>المحادثة</span></a>
        <a class="k-trace-unit" href="/kernel/audit/"><span>السجل</span></a>
        <a class="k-trace-unit" href="/kernel/approvals/"><span>الموافقة</span></a>
        <a class="k-trace-unit" href="/kernel/evidence/"><span>الدليل</span></a>
        <a class="k-trace-unit" href="/kernel/reports/"><span>التقرير</span></a>
      </section>
    </div>
  </div>

  <!-- ═══ لوحة الأوامر ⌘K ═══ -->
  <div
    class="k-cmdk"
    id="k-cmdk"
    role="dialog"
    aria-modal="true"
    aria-labelledby="k-cmdk-title"
    aria-hidden="true"
  >
    <div class="k-cmdk__backdrop" data-kernel-cmdk-close></div>
    <div class="k-cmdk__panel" role="document">
      <h2 id="k-cmdk-title" class="sr-only">لوحة الأوامر</h2>
      <div class="k-cmdk__input-wrap">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input
          type="text"
          class="k-cmdk__input"
          placeholder="اكتب أمر أو صفحة…"
          aria-label="بحث لوحة الأوامر"
          autocomplete="off"
          data-kernel-cmdk-input
        />
        <kbd class="k-cmdk__esc" aria-hidden="true">Esc</kbd>
      </div>

      <div class="k-cmdk__results" data-kernel-cmdk-results>
        <div class="k-cmdk__group" data-group="commands">
          <span class="k-cmdk__group-label">أوامر سريعة</span>
          <button class="k-cmdk__item" type="button" data-cmd="run-scenario"><span class="k-cmdk__item-name">شغّل سيناريو</span><kbd>↵</kbd></button>
          <button class="k-cmdk__item" type="button" data-cmd="open-trace"><span class="k-cmdk__item-name">افتح Trace</span><kbd>↵</kbd></button>
          <button class="k-cmdk__item" type="button" data-cmd="gen-report"><span class="k-cmdk__item-name">ولّد تقرير</span><kbd>↵</kbd></button>
          <button class="k-cmdk__item" type="button" data-cmd="toggle-mode"><span class="k-cmdk__item-name">بدّل الوضع (تجريبي / بياناتي)</span><kbd>↵</kbd></button>
        </div>
        <div class="k-cmdk__group" data-group="pages">
          <span class="k-cmdk__group-label">صفحات</span>
          {cmdkPages.map(item => (
            <a class="k-cmdk__item" href={item.path} data-kernel-cmdk-target>
              <span class="k-cmdk__item-name">{item.label}</span>
            </a>
          ))}
        </div>
        <div class="k-cmdk__group" data-group="policies">
          <span class="k-cmdk__group-label">سياسات</span>
          <a class="k-cmdk__item" href="/kernel/policies/"><span class="k-cmdk__item-name">تعمية الهوية (PDPL م.12)</span></a>
          <a class="k-cmdk__item" href="/kernel/policies/"><span class="k-cmdk__item-name">حظر SA-IBAN</span></a>
          <a class="k-cmdk__item" href="/kernel/policies/"><span class="k-cmdk__item-name">حظر الهوية طبيًا (SFDA)</span></a>
        </div>
        <div class="k-cmdk__group" data-group="scenarios">
          <span class="k-cmdk__group-label">سيناريوهات</span>
          <a class="k-cmdk__item" href="/kernel/scenarios/"><span class="k-cmdk__item-name">هوية وطنية</span></a>
          <a class="k-cmdk__item" href="/kernel/scenarios/"><span class="k-cmdk__item-name">حقن أوامر</span></a>
          <a class="k-cmdk__item" href="/kernel/scenarios/"><span class="k-cmdk__item-name">SA-IBAN</span></a>
        </div>
        <div class="k-cmdk__group" data-group="reports">
          <span class="k-cmdk__group-label">تقارير</span>
          <a class="k-cmdk__item" href="/kernel/reports/"><span class="k-cmdk__item-name">PDPL — الربع الثاني</span></a>
          <a class="k-cmdk__item" href="/kernel/reports/"><span class="k-cmdk__item-name">مخاطر يونيو</span></a>
        </div>
        <p class="k-cmdk__empty" hidden data-kernel-cmdk-empty>ما فيه نتائج مطابقة.</p>
      </div>
    </div>
  </div>

  <!-- توست النجاح المشترك -->
  <div class="k-toast" id="k-toast" role="status" aria-live="polite" aria-atomic="true" hidden>
    <span class="k-toast__msg" data-kernel-toast-msg>تم.</span>
    <button class="k-toast__undo" type="button" data-kernel-toast-undo hidden>تراجع</button>
    <button class="k-toast__close" type="button" data-kernel-toast-close aria-label="إغلاق">×</button>
  </div>

  {/* CSP-FIX-2026-07-31: كانت الثلاثة مستوردة من frontmatter (server-side فقط،
      لا تصل للمتصفح). نُقلت إلى public/js/ وتُحمَّل كـ static ES modules هنا —
      بنمط kernel-sidebar.js. الترتيب: eval-store أولاً (بيانات)، ثم shell
      (⌘K + دور + demo)، ثم drawer (درج الرحلة). */}
  <script type="module" src="/js/kernel-eval-store.js"></script>
  <script type="module" src="/js/kernel-shell.js"></script>
  <script type="module" src="/js/kernel-drawer.js"></script>
</BaseLayout>
