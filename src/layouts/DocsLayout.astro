---
/**
 * DocsLayout — Documentation article page layout.
 * Used by src/pages/docs/[...slug].astro
 *
 * REPORT-12: Refreshed visual treatment:
 * - canonical .page-hero style for top (was inline-styled article-hero)
 * - canonical .article-tldr with gradient border + brand icon
 * - reading prose via .article-content + .docs-toc sidebar
 * - canonical .docs-related + .docs-helpful + .docs-prev-next footer
 * - canonical card--cta for demo CTA
 *
 * Content Preservation Rule:
 *   The published `title`, `description`, `tldr`, `category`, `updated` come
 *   from the Markdown frontmatter — we render them verbatim.
 */
import ArabicLayout from './ArabicLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import DocsRelatedLinks from '../components/DocsRelatedLinks.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { ORGANIZATION, getBreadcrumbLd } from '../data/schema-helpers';

interface Heading {
  depth: 2 | 3;
  slug: string;
  text: string;
}

interface RelatedDoc {
  slug: string;
  title: string;
  description: string;
}

interface SiblingDoc {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  canonical: string;
  updated: Date;
  category: string;
  tldr: string;
  headings: Heading[];
  relatedDocs: RelatedDoc[];
  prevDoc?: SiblingDoc | null;
  nextDoc?: SiblingDoc | null;
  currentPath: string;
}

const {
  title,
  metaTitle,
  description,
  canonical,
  updated,
  category,
  tldr,
  headings,
  relatedDocs,
  prevDoc = null,
  nextDoc = null,
  currentPath,
} = Astro.props;

const techArticleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${canonical}#techarticle`,
  headline: title,
  description,
  mainEntityOfPage: canonical,
  dateModified: updated.toISOString().slice(0, 10),
  inLanguage: 'ar-SA',
  author: { '@type': 'Organization', name: 'BrightAI', url: 'https://brightai.site/' },
  publisher: { '@type': 'Organization', name: 'BrightAI', url: 'https://brightai.site/' },
};

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ar-SA',
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['[data-speakable]'],
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    techArticleLd,
    webPageLd,
    ORGANIZATION,
    getBreadcrumbLd([
      { name: 'الرئيسية', href: '/' },
      { name: 'الوثائق', href: '/docs/' },
      { name: title, href: canonical },
    ]),
  ],
};

// Update timestamp formatted for the docs-meta widget (e.g. "2026-06-30").
const updatedAtLabel = updated.toISOString().slice(0, 10);

// GitHub edit link: docs live in src/content/docs/<slug>.md
const editUrl = `https://github.com/brightai-sa/brightai/edit/main/src/content/docs/${currentPath.replace(/^\/docs\//, '').replace(/\/$/, '')}.md`;
---

<ArabicLayout
  title={metaTitle}
  description={description}
  canonical={canonical}
  hreflang={[{ lang: 'ar-SA', href: canonical }]}
  jsonLd={jsonLd}
  currentPath={currentPath}
>
  <div class="docs-page-shell docs-page-shell--with-sidebar">
    <main class="docs-page-shell__main">
      <Breadcrumbs crumbs={[
        { label: 'الرئيسية', href: '/' },
        { label: 'الوثائق', href: '/docs/' },
        { label: title },
      ]} />

      <header class="article-hero" data-speakable>
        <span class="chip chip--brand article-hero__category">{category}</span>
        <h1>{title}</h1>
        <p class="article-hero__desc">{description}</p>

        <div class="docs-meta">
          <span class="docs-meta__updated">
            <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-refresh"></use></svg>
            آخر تحديث: <strong><time datetime={updatedAtLabel}>{updatedAtLabel}</time></strong>
          </span>
          <a class="docs-meta__edit" href={editUrl} target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-pencil-box"></use></svg>
            عدّل على GitHub
          </a>
        </div>
      </header>

      <section class="article-tldr" aria-labelledby="docs-tldr-title">
        <div class="article-tldr__icon" aria-hidden="true">
          <svg width="20" height="20"><use href="/icons.svg#mdi-lightning-bolt"></use></svg>
        </div>
        <div>
          <h2 id="docs-tldr-title">الخلاصة السريعة</h2>
          <p>{tldr}</p>
        </div>
      </section>

      <article class="article-content article-content--reading" data-speakable>
        <slot />
      </article>

      <DocsRelatedLinks docs={relatedDocs} />

      <!-- Helpful? yes/no widget (local-only, respects DNT via no-network) -->
      <section class="docs-helpful" aria-labelledby="docs-helpful-q">
        <p id="docs-helpful-q" class="docs-helpful__question">هل كانت هذه الوثيقة مفيدة؟</p>
        <div class="docs-helpful__buttons" data-docs-helpful>
          <button type="button" class="docs-helpful__btn" data-value="yes" aria-label="نعم، مفيدة">
            <svg aria-hidden="true" width="18" height="18"><use href="/icons.svg#mdi-arrow-up"></use></svg>
            نعم، مفيدة
          </button>
          <button type="button" class="docs-helpful__btn" data-value="no" aria-label="تحتاج تحسين">
            <svg aria-hidden="true" width="18" height="18"><use href="/icons.svg#mdi-arrow-down"></use></svg>
            تحتاج تحسين
          </button>
        </div>
        <p class="docs-helpful__thanks" data-docs-helpful-thanks hidden>شكراً على تقييمك.</p>
      </section>

      <!-- Prev/Next doc footer -->
      <nav class="docs-prev-next" aria-label="وثائق سابقة وتالية">
        {prevDoc ? (
          <a class="docs-prev-next__cell" href={`/docs/${prevDoc.slug}/`}>
            <span class="docs-prev-next__label">
              <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-arrow-right"></use></svg>
              السابق
            </span>
            <span class="docs-prev-next__title">{prevDoc.title}</span>
          </a>
        ) : (
          <span class="docs-prev-next__cell docs-prev-next__cell--empty" aria-hidden="true"></span>
        )}
        {nextDoc ? (
          <a class="docs-prev-next__cell docs-prev-next__cell--next" href={`/docs/${nextDoc.slug}/`}>
            <span class="docs-prev-next__label">
              التالي
              <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-arrow-left"></use></svg>
            </span>
            <span class="docs-prev-next__title">{nextDoc.title}</span>
          </a>
        ) : (
          <span class="docs-prev-next__cell docs-prev-next__cell--empty" aria-hidden="true"></span>
        )}
      </nav>

      <!-- Final CTA — canonical card--cta -->
      <section class="docs-demo-cta" aria-labelledby="docs-demo-title">
        <div class="card card--cta docs-demo-cta__card">
          <h2 id="docs-demo-title">شاهد الحوكمة وهي تعمل على حالاتك الفعلية</h2>
          <p>احجز جلسة تعريفية لمراجعة احتياج منشأتك ومسار التطبيق المناسب.</p>
          <a href="/contact/" class="btn btn--glow">
            <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-calendar-check"></use></svg>
            احجز ديمو
          </a>
        </div>
      </section>
    </main>

    <aside class="docs-page-shell__sidebar">
      <TableOfContents headings={headings} />
    </aside>
  </div>

  <script>
    // REPORT-12: Helpful widget — local-only feedback toggle. Pure DOM,
    // zero network. Stateless across pages (intentional — does not persist).
    function initHelpfulWidget() {
      const widget = document.querySelector('[data-docs-helpful]');
      if (!widget || widget.hasAttribute('data-helpful-initialized')) return;
      widget.setAttribute('data-helpful-initialized', 'true');

      const buttons = Array.from(widget.querySelectorAll('.docs-helpful__btn'));
      const thanks = document.querySelector('[data-docs-helpful-thanks]');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const value = (btn as HTMLElement).dataset.value;
          buttons.forEach((b) => b.classList.remove('is-selected'));
          btn.classList.add('is-selected');
          if (thanks) {
            thanks.textContent =
              value === 'yes' ? 'شكراً — فريق BrightAI فرحان إنها أفادتك.' : 'تم تسجيل ملاحظتك. فريق التوثيق رح يراجع.';
            thanks.removeAttribute('hidden');
          }
        });
      });
    }

    document.addEventListener('astro:page-load', initHelpfulWidget);
  </script>
</ArabicLayout>
