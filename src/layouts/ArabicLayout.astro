---
/**
 * ArabicLayout — Arabic (RTL) pages layout.
 * Defaults: lang="ar", dir="rtl", locale ar-SA.
 */
import BaseLayout from './BaseLayout.astro';
import type { SEOProps } from '../data/site';

interface Props extends SEOProps {
  currentPath?: string;
  languageCounterpart?: string;
  robots?: string;
  /**
   * BAI-VOC-001-B (2026-07-18): forwarded to BaseLayout → FoundationSchema
   * to extend the WebPage `speakable.cssSelector` array. See Schema.astro.
   */
  extraSpeakableSelectors?: string[];
}

const {
  title,
  description,
  canonical,
  hreflang = [],
  ogImage,
  ogImageAlt,
  jsonLd,
  currentPath = '/',
  languageCounterpart,
  robots,
  extraSpeakableSelectors = [],
} = Astro.props;
---

<BaseLayout
  lang="ar"
  dir="rtl"
  title={title}
  description={description}
  canonical={canonical}
  hreflang={hreflang}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  jsonLd={jsonLd}
  currentPath={currentPath}
  languageCounterpart={languageCounterpart}
  robots={robots}
  extraSpeakableSelectors={extraSpeakableSelectors}
>
  <slot />
</BaseLayout>

<style is:global>
  @import '../styles/components.css';
  @import '../styles/pages.css';
</style>
