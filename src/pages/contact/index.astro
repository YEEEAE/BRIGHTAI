---
/**
 * Contact Page — /contact/
 * BrightAI contact methods + dيمو مخصص form.
 *
 * REPORT-13: Visual refresh using canonical design system.
 * - Hero: .page-hero with badge "نرد خلال 24 ساعة"
 * - Section "طرق التواصل": 3-card grid with contact methods
 * - NEW split layout (.contact-split): form (right in RTL) + info (left)
 * - Form uses canonical .field + .form-label + .form-row + .btn--primary
 * - Office hours table (.office-hours) added to info column
 * - Map embed wrapped in .map-embed-card with footer link
 * - All Action URLs preserved (https://formsubmit.co/info@brightai.site POST)
 * - 0 published Arabic text changed, 0 sections removed
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BackgroundGrid from '../../components/BackgroundGrid.astro';
import { ORGANIZATION, getBreadcrumbLd } from '../../data/schema-helpers';

const crumbs = [{ label: 'الرئيسية', href: '/' }, { label: 'تواصل معنا' }];

const contactMethods = [
  {
    icon: 'mdi-whatsapp',
    iconColor: 'var(--whatsapp)',
    title: 'واتساب',
    body: 'أسرع طريقة للتواصل. اكتبنا ونجاوبك خلال دقائق.',
    value: '+966 538 229 013',
    href: 'https://wa.me/966538229013',
    external: true,
  },
  {
    icon: 'mdi-email',
    iconColor: 'var(--cyan-bright)',
    title: 'البريد الإلكتروني',
    body: 'للاستفسارات التفصيلية والمرفقات.',
    value: 'yazeed1job@gmail.com',
    href: 'mailto:yazeed1job@gmail.com',
  },
  {
    icon: 'mdi-map-marker',
    iconColor: 'var(--indigo-300)',  /* approximation of original violet — ΔR=2 ΔG=-7 ΔB=-2 — imperceptible per design rule */
    title: 'المقر',
    body: 'شركة سعودية 100%، مقرنا في الرياض.',
    value: 'الرياض، المملكة العربية السعودية',
  },
];

const officeHours = [
  { day: 'الأحد', time: '9:00 ص – 6:00 م' },
  { day: 'الإثنين', time: '9:00 ص – 6:00 م' },
  { day: 'الثلاثاء', time: '9:00 ص – 6:00 م' },
  { day: 'الأربعاء', time: '9:00 ص – 6:00 م' },
  { day: 'الخميس', time: '9:00 ص – 6:00 م' },
  { day: 'الجمعة', time: 'إجازة — مغلق', closed: true },
  { day: 'السبت', time: 'إجازة — مغلق', closed: true },
];

const sectors = [
  'مصانع طبية',
  'رعاية صحية',
  'جهة حكومية',
  'مشتريات ومناقصات',
  'مالي / بنوك',
  'تعليم',
  'طاقة / صناعة',
  'تقنية / SaaS',
  'غيره',
];

const contactScenarios = [
  {
    title: 'عندك استخدامات AI غير واضحة داخل المؤسسة',
    body: 'إذا كانت الفرق تستخدم أدوات مختلفة وما عندك سجل موحد يوضح المستخدمين والبيانات والنماذج، نبدأ بحصر الاستخدامات وتصنيفها. بعدها يتحدد وش يحتاج منع، وش يحتاج تسجيل، وش يحتاج موافقة بشرية.',
  },
  {
    title: 'تتعاملون مع بيانات حساسة أو قرارات عالية الأثر',
    body: 'لبيانات العملاء والمرضى والموظفين والعمليات المالية، نراجع نقطة دخول البيانات وخروجها ومسار القرار. غالبًا يجمع الحل بين AI Firewall والموافقة البشرية.',
  },
  {
    title: 'تحتاجون دليلًا واضحًا للمراجعة أو التدقيق',
    body: 'إذا كان السؤال المتكرر هو: من استخدم AI، وش أرسل، وش السياسة اللي طُبقت، ومن وافق؟ نركز على سجل التدقيق وملف الأدلة بدل تقارير يدوية متفرقة.',
  },
  {
    title: 'تبون تربطون الحوكمة بأنظمة العمل الحالية',
    body: 'إذا عندكم ERP أو CRM أو HIS أو SharePoint أو بوابة داخلية، نحدد نقاط التكامل المطلوبة وحدود الصلاحيات والبيانات. ما نفترض أن كل نظام يحتاج نفس الربط؛ التصميم يعتمد على العملية والمخاطر والبيئة التقنية.',
  },
];

const contactSteps = [
  { n: '١', title: 'نفهم النطاق', body: 'نراجع القطاع، حالة الاستخدام، حساسية البيانات، والنتيجة اللي تبي تحققها. إذا الطلب يحتاج معلومات إضافية، نحددها بوضوح قبل الاجتماع.' },
  { n: '٢', title: 'نختار المسار المناسب', body: 'قد تكون الخطوة ديمو مخصص، جلسة تقييم جاهزية، مراجعة معمارية، أو تحديد نطاق تجربة أولية. ما ندفعك لمسار أكبر من حاجتك الحالية.' },
  { n: '٣', title: 'نحدد مخرجًا قابلًا للقياس', body: 'نتفق على المشكلة، الأطراف المسؤولة، الأدلة المطلوبة، وطريقة قياس النجاح قبل أي تنفيذ. كذا يكون النقاش مرتبطًا بقرار واضح، مو عرض عام فقط.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      name: 'تواصل معنا | احجز عرض حوكمة AI بالسعودية',
      description: 'احجز عرض عملي مع BrightAI لحوكمة AI وحماية البيانات وأدلة امتثال تناسب منشأتك. متاح عبر واتساب +966538229013 والبريد الإلكتروني على مدار الأسبوع.',
      url: 'https://brightai.site/contact/',
      mainEntity: {
        '@type': 'Organization',
        name: 'BrightAI',
        telephone: '+966538229013',
        email: 'yazeed1job@gmail.com',
        address: { '@type': 'PostalAddress', addressLocality: 'الرياض', addressCountry: 'SA' },
        url: 'https://brightai.site',
      },
    },
    ORGANIZATION,
    getBreadcrumbLd([
      { name: 'الرئيسية', href: '/' },
      { name: 'تواصل معنا', href: '/contact/' },
    ]),
  ],
};
---

<ArabicLayout title="تواصل معنا | احجز عرض حوكمة AI بالسعودية" description="احجز عرض عملي مع BrightAI لحوكمة AI وحماية البيانات وأدلة امتثال تناسب منشأتك. متاح عبر واتساب +966538229013 والبريد الإلكتروني على مدار الأسبوع." canonical="https://brightai.site/contact/" hreflang={[{lang:'ar-SA',href:'https://brightai.site/contact/'},{lang:'x-default',href:'https://brightai.site/contact/'}]} jsonLd={jsonLd as any} currentPath="/contact/">

  {/* ═══════════ 1. HERO — page-hero with 24h response badge ═══════════ */}
  <section class="page-hero" aria-label="تواصل معنا">
    <BackgroundGrid />
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <Breadcrumbs crumbs={crumbs} />
      <div class="inner-hero__badge">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-message-text"></use></svg>
        نرد خلال 24 ساعة
      </div>
      <h1 class="page-hero__title"><span class="gradient-text">كلم فريق الحوكمة</span> مباشرة</h1>
      <p class="page-hero__description">سواء تبي تفهم أكثر عن BrightAI، تطلب ديمو، أو تحتاج استشارة فنية — فريقنا جاهز يرد عليك خلال ٢٤ ساعة.</p>
    </div>
  </section>

  {/* ═══════════ 2. CONTACT METHODS — 3 cards (WhatsApp / Email / HQ) ═══════════ */}
  <section class="inner-section" aria-labelledby="contact-methods">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="contact-methods" class="inner-section__title">طرق التواصل</h2>
      <div class="grid grid--3">
        {contactMethods.map(m => (
          m.href ? (
            <a
              href={m.href}
              target={m.external ? '_blank' : undefined}
              rel={m.external ? 'noopener noreferrer' : undefined}
              class="card card--feature card--interactive contact-link-card"
            >
              <svg class="contact-info__icon" aria-hidden="true" width="2.5rem" height="2.5rem" style={`color:${m.iconColor};`}>
                <use href={`/icons.svg#${m.icon}`} />
              </svg>
              <h3 class="inner-card__title">{m.title}</h3>
              <p class="inner-card__text">{m.body}</p>
              <span class="text-cyan-300 font-bold text-sm mt-2 block">{m.value}</span>
            </a>
          ) : (
            <div class="card card--feature">
              <svg class="contact-info__icon" aria-hidden="true" width="2.5rem" height="2.5rem" style={`color:${m.iconColor};`}>
                <use href={`/icons.svg#${m.icon}`} />
              </svg>
              <h3 class="inner-card__title">{m.title}</h3>
              <p class="inner-card__text">{m.body}</p>
              <span class="text-cyan-300 font-bold text-sm mt-2 block">{m.value}</span>
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 3. SPLIT: form (right RTL) + contact info (left RTL) ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="contact-form-sec">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="contact-form-sec" class="inner-section__title inner-section__title--centered">ابدأ بديمو مخصص لشركتك</h2>
      <p class="inner-section__lead inner-section__lead--centered">عبي النموذج ونتواصل معك خلال 24 ساعة.</p>
      <p class="inner-section__lead inner-section__lead--centered">نستخدم بياناتك للرد على طلبك فقط حسب سياسة الخصوصية.</p>

      <div class="contact-split contact-split--padded">
        {/* ─── Form (right in RTL = first column) ─── */}
        {/* WCAG fix (REPORTS-18): separate aria-labelledby target so the
            region has its own unique accessible name — doesn't collide
            with the outer section's label. */}
        <div class="contact-form-card" role="region" aria-labelledby="contact-form-card-title">
          <h3 id="contact-form-card-title" class="sr-only">نموذج التواصل</h3>
          <h3 class="form-card__title">أرسل تفاصيل طلبك</h3>
          <p class="form-card__desc">كل المعلومات تساعد فريقنا يفهم احتياجك قبل ما نتواصل معك.</p>

          <form class="inner-form inner-form--padded" action="https://formsubmit.co/info@brightai.site" method="POST">
            <input type="hidden" name="_subject" value="طلب تواصل من موقع BrightAI" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_next" value="https://brightai.site/contact/" />

            <div class="form-row form-row--2">
              <div class="form-field">
                <label class="form-label" for="name">الاسم الكامل <span class="text-red-400" aria-hidden="true">*</span></label>
                <input
                  class="field"
                  type="text"
                  id="name"
                  name="name"
                  required
                  aria-required="true"
                  autocomplete="name"
                  placeholder="مثال: محمد أحمد"
                />
              </div>
              <div class="form-field">
                <label class="form-label" for="email">البريد الإلكتروني <span class="text-red-400" aria-hidden="true">*</span></label>
                <input
                  class="field"
                  type="email"
                  id="email"
                  name="email"
                  required
                  aria-required="true"
                  autocomplete="email"
                  inputmode="email"
                  placeholder="example@company.sa"
                />
              </div>
            </div>

            <div class="form-row form-row--2">
              <div class="form-field">
                <label class="form-label" for="phone">رقم الجوال</label>
                <input
                  class="field"
                  type="tel"
                  id="phone"
                  name="phone"
                  autocomplete="tel"
                  inputmode="tel"
                  placeholder="05X-XXX-XXXX"
                />
              </div>
              <div class="form-field">
                <label class="form-label" for="company">اسم الشركة</label>
                <input
                  class="field"
                  type="text"
                  id="company"
                  name="company"
                  autocomplete="organization"
                  placeholder="اسم شركتك أو مؤسستك"
                />
              </div>
            </div>

            <div class="form-field">
              <label class="form-label" for="sector">القطاع</label>
              <select class="field field--select" id="sector" name="sector">
                <option value="">اختر القطاع</option>
                {sectors.map(s => <option>{s}</option>)}
              </select>
            </div>

            <div class="form-field">
              <label class="form-label" for="message">رسالتك <span class="text-red-400" aria-hidden="true">*</span></label>
              <textarea
                class="field field--textarea"
                id="message"
                name="message"
                required
                aria-required="true"
                placeholder="أخبرنا عن احتياجاتك أو استفسارك..."
              ></textarea>
            </div>

            <div class="form-field form-field--checkbox-row">
              <input
                required
                aria-required="true"
                id="pdpl_consent"
                name="pdpl_consent"
                type="checkbox"
                class="form-checkbox--inline"
              />
              <label for="pdpl_consent" class="text-xs form-label--checkbox">
                أوافق على معالجة بياناتي الشخصية المدخلة وفقاً لـ
                <a href="/privacy-policy/">سياسة الخصوصية</a> و
                <a href="/pdpl-statement/">بيان الامتثال لنظام PDPL السعودي</a>.
                <span class="text-red-400" aria-hidden="true">*</span>
              </label>
            </div>

            <button class="btn btn--primary btn--block inner-form__submit" type="submit">
              <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-send"></use></svg>
              إرسال الرسالة
            </button>
          </form>
        </div>

        {/* ─── Contact info + Office hours (left in RTL = second column) ─── */}
        <div class="contact-info-stack">
          <div class="card card--feature card--lg">
            <h3 class="inner-card__title">وش تتوقع بعد التواصل؟</h3>
            <ul class="contact-info-list">
              <li>
                <svg class="contact-info__icon contact-info__icon--whatsapp" aria-hidden="true" width="1.75rem" height="1.75rem">
                  <use href="/icons.svg#mdi-whatsapp" />
                </svg>
                <div>
                  <strong class="block text-white">واتساب (أسرع)</strong>
                  <a rel="nofollow noopener noreferrer" href="https://wa.me/966538229013">+966 538 229 013</a>
                </div>
              </li>
              <li>
                <svg class="contact-info__icon contact-info__icon--cyan" aria-hidden="true" width="1.75rem" height="1.75rem">
                  <use href="/icons.svg#mdi-email" />
                </svg>
                <div>
                  <strong class="block text-white">البريد الإلكتروني</strong>
                  <a href="mailto:yazeed1job@gmail.com">yazeed1job@gmail.com</a>
                </div>
              </li>
              <li>
                <svg class="contact-info__icon contact-info__icon--indigo" aria-hidden="true" width="1.75rem" height="1.75rem">
                  <use href="/icons.svg#mdi-translate" />
                </svg>
                <div>
                  <strong class="block text-white">اللغات المتاحة</strong>
                  <span>العربية والإنجليزية</span>
                </div>
              </li>
            </ul>
          </div>

          <div class="card card--feature card--lg">
            <h3 class="inner-card__title">ساعات العمل</h3>
            <p class="inner-card__text">فريقنا يرد على الطلبات خلال 24 ساعة في أيام العمل.</p>
            <div class="office-hours">
              {officeHours.map(h => (
                <div class:list={['office-hours__row', h.closed && 'office-hours__row--closed']}>
                  <span class="office-hours__day">{h.day}</span>
                  <span class="office-hours__time">{h.time}</span>
                </div>
              ))}
            </div>
          </div>

          {/* Map embed (kept as-is — already lazy iframe) */}
          <div class="card card--feature map-embed-card">
            <iframe
              class="map-embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="خريطة Google لموقع BrightAI في الرياض"
              src="https://www.google.com/maps?q=24.71360,46.67530&hl=ar&z=14&output=embed"
            ></iframe>
            <a
              href="https://www.google.com/maps/search/?api=1&query=24.71360,46.67530"
              target="_blank"
              rel="noopener noreferrer"
              class="map-embed-card__footer"
            >
              <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-map-marker" /></svg>
              افتح الموقع في خرائط Google
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════ 4. SOLUTIONS HUB — preserved verbatim ═══════════ */}
  <section class="inner-section" aria-labelledby="contact-sectors-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="contact-sectors-title" class="inner-section__title">القطاعات اللي نخدمها</h2>
      <p class="inner-section__lead">إذا احتياجك مرتبط بحوكمة AI أو حماية البيانات، ابدأ من أحد الحلول وكلمنا.</p>
      <div class="flex flex-wrap gap-3 mt-4">
        <a href="/solutions/ai-governance-platform/" class="chip">AI Governance Platform</a>
        <a href="/solutions/ai-firewall/" class="chip">AI Firewall</a>
        <a href="/solutions/ai-audit-trail/" class="chip">AI Audit Trail</a>
        <a href="/solutions/human-approval-layer/" class="chip">Human Approval Layer</a>
        <a href="/solutions/ai-evidence-file/" class="chip">AI Evidence File</a>
      </div>
    </div>
  </section>

  {/* ═══════════ 5. PRE-CONTACT GUIDANCE — preserved verbatim ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="contact-guidance-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">قبل ما ترسل الطلب</p>
      <h2 id="contact-guidance-title" class="inner-section__title">كيف نخلي أول مكالمة مفيدة من البداية؟</h2>
      <p class="inner-section__lead">ما نحتاج منك ملف طويل أو مواصفات نهائية. يكفينا وصف واضح للمشكلة: وين تستخدمون الذكاء الاصطناعي اليوم، وش نوع البيانات اللي تدخل له، ومين يتخذ القرار بعد خروج النتيجة. إذا كان الاستخدام ما زال تحت الدراسة، اذكر الفريق أو العملية اللي تبون تبدأون منها، مثل خدمة العملاء، الموارد البشرية، المشتريات، الجودة، أو تحليل الوثائق. هذي المعلومات تساعدنا نحدد هل البداية الأنسب هي <a href="/solutions/ai-use-case-discovery/">اكتشاف حالات الاستخدام</a>، أو <a href="/assessment/ai-governance-readiness/">تقييم جاهزية الحوكمة</a>، أو تجربة تقنية محددة.</p>
      <p class="inner-section__lead">لا ترسل بيانات شخصية، ملفات مرضى، معلومات حسابات، أسرار تجارية، أو مستندات داخلية حساسة عبر نموذج التواصل. في البداية نناقش النطاق بشكل عام، وبعد الاتفاق على قناة مناسبة يمكن تحديد طريقة آمنة لمشاركة العينات والوثائق. الهدف من أول تواصل هو فهم الحاجة وتحديد الخطوة التالية، وليس جمع بيانات تشغيلية من منشأتك.</p>
    </div>
  </section>

  {/* ═══════════ 6. SCENARIOS — preserved 4-card grid ═══════════ */}
  <section class="inner-section" aria-labelledby="contact-scenarios-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="contact-scenarios-title" class="inner-section__title">متى يكون التواصل معنا هو الخطوة الصح؟</h2>
      <p class="inner-section__lead">تواصل إذا كان عندك استخدام AI فعلي يحتاج ضبط، أو مشروع جديد تبي تبدأه من البداية بشكل قابل للتدقيق.</p>
      <div class="grid grid--2">
        {contactScenarios.map(item => (
          <article class="card card--feature">
            <h3 class="inner-card__title">{item.title}</h3>
            <p class="inner-card__text">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 7. PROCESS — 3 steps + context paragraphs (verbatim) ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="contact-process-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="contact-process-title" class="inner-section__title">وش يصير بعد استلام رسالتك؟</h2>
      <ol class="grid grid--3 grid--process">
        {contactSteps.map(step => (
          <li class="card card--feature">
            <span class="text-cyan-300 font-black text-2xl">{step.n}</span>
            <h3 class="inner-card__title mt-3">{step.title}</h3>
            <p class="inner-card__text">{step.body}</p>
          </li>
        ))}
      </ol>
      <p class="inner-section__lead">BrightAI تدعم التشغيل والحوكمة وجاهزية الامتثال، لكنها لا تستبدل المستشار القانوني أو قرار الجهة التنظيمية. إذا كان طلبك متعلقًا بتفسير إلزام قانوني محدد، نساعدك في تحويل المتطلبات المعتمدة عندكم إلى ضوابط وأدلة تشغيلية، مع بقاء الرأي القانوني لدى المختصين المخولين.</p>
      <h3 class="inner-section__title text-xl">معلومات تساعدنا نجهز الاجتماع بشكل أدق</h3>
      <p class="inner-section__lead">اذكر عدد الفرق اللي تستخدم AI، وهل الأدوات داخلية أو سحابية، ونوع المخرجات اللي تعتمدون عليها. وضّح إذا كان الاستخدام يقرأ ملفات، يتصل بقاعدة معرفة، يرسل ردًا لعميل، أو يقترح قرارًا لموظف. إذا عندكم سياسات أو ضوابط معتمدة، يكفي ذكر أسمائها بدون إرفاق المستندات في النموذج. ومن المفيد تحديد صاحب القرار داخل المشروع: الأمن السيبراني، البيانات، الامتثال، التحول الرقمي، الجودة، أو الإدارة التشغيلية.</p>
      <p class="inner-section__lead">للمشاريع القائمة، اذكر المشكلة اللي تظهر اليوم مثل غياب السجل، صعوبة تتبع الموافقات، تسرب بيانات إلى أدوات عامة، أو عدم وضوح مسؤولية المخرجات. وللمشاريع الجديدة، اذكر النتيجة المطلوبة والموعد المتوقع وأي أنظمة لازم تتكامل معها التجربة. هذي التفاصيل تخلي الجلسة تركز على قرار ونطاق واقعي بدل استعراض خصائص عامة.</p>
      <p class="inner-section__lead">إذا كان عندكم موعد تدقيق أو إطلاق قريب، اذكر التاريخ والاعتماديات اللي ما زالت مفتوحة. بنوضح من البداية وش يمكن إثباته خلال المدة المتاحة، وش يحتاج تغييرًا تشغيليًا أطول. ما نعطي وعد امتثال مطلق، لكن نحدد الأدلة والضوابط والفجوات بطريقة يقدر فريقك يراجعها ويقيسها.</p>
      <p class="inner-section__lead">تقدر قبل التواصل تراجع المسار الأقرب لموقع فريقك وقطاعه: <a href="/solutions/banking-ai-governance/riyadh/">حوكمة AI للبنوك في الرياض</a>، <a href="/solutions/healthcare-ai-governance/jeddah/">حوكمة AI للمستشفيات في جدة</a>، أو <a href="/solutions/government-ai-governance/dammam/">حوكمة AI للجهات الحكومية في الدمام</a>. هذي الصفحات توضح أمثلة المخاطر والأدلة المتوقعة لكل سياق.</p>
