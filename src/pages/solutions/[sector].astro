---
import PageShell from '../../components/PageShell.astro';
export const prerender = true;
export function getStaticPaths() {
  return [
    {
      slug: 'government', title: 'الجهات الحكومية', label: 'GOVERNMENT',
      intro: 'ابتكار يخدم المستفيدين، ضمن حدود واضحة وسيادة كاملة على البيانات.',
      context: 'الجهات الحكومية تتعامل مع بيانات مواطنين ومقيمين على نطاق واسع، وتخضع لمبادئ سدايا وضوابط الهيئة الوطنية للأمن السيبراني. والسؤال لا يتعلق بجدوى الذكاء الاصطناعي، بل بطريقة استخدامه دون أن تخرج البيانات عن السيطرة.',
      cases: ['صياغة الردود على استفسارات المستفيدين', 'تلخيص المعاملات والمراسلات الطويلة', 'تحليل الملاحظات والشكاوى', 'إعداد مسودات التقارير والتعاميم'],
      how: ['حجب الهوية والإقامة قبل أي معالجة', 'سجل تدقيق جاهز للمراجعة الداخلية والرقابية', 'موافقة بشرية على أي توصية تمس حقوق مستفيد', 'خيار تشغيل محلي كامل بدون اتصال خارجي'],
      plan: 'Sovereign أو Enterprise', regs: 'مبادئ أخلاقيات الذكاء الاصطناعي، والضوابط الأساسية للأمن السيبراني، وإرشادات الذكاء الاصطناعي التوليدي للجهات الحكومية',
    },
    {
      slug: 'finance', title: 'البنوك والمالية', label: 'FINANCIAL SERVICES',
      intro: 'حماية بيانات العملاء في كل تفاعل، ومساءلة واضحة في كل قرار.',
      context: 'المؤسسات المالية تتعامل يومياً مع أرقام حسابات وآيبانات وهويات، وقراراتها تمس حقوق العملاء مباشرة. خطأ واحد في التعامل مع هذه البيانات قد يكلف غرامة وثقة يصعب استعادتها.',
      cases: ['تلخيص ملفات العملاء لفرق الائتمان', 'صياغة ردود خدمة العملاء', 'مراجعة العقود والسياسات الداخلية', 'دعم فرق الامتثال في تحليل اللوائح'],
      how: ['حجب الآيبان والهوية وبيانات الاعتماد تلقائياً', 'إيقاف التوصيات الائتمانية حتى يعتمدها موظف مخوّل', 'تقييم انحياز دوري لنماذج القرار', 'تكامل SIEM مع مركز العمليات الأمنية'],
      plan: 'Enterprise', regs: 'نظام حماية البيانات الشخصية، والضوابط الأساسية للأمن السيبراني، ومتطلبات الجهة الرقابية لقطاعكم',
    },
    {
      slug: 'healthcare', title: 'الصحة', label: 'HEALTHCARE',
      intro: 'خصوصية المريض أولاً. والقرار السريري يبقى للطبيب.',
      context: 'البيانات الصحية من أكثر البيانات الشخصية حساسية. يستطيع الذكاء الاصطناعي توفير ساعات من العمل الإداري والتوثيق، بشرط ألا يرى رقم مريض واحداً، وألا يتخذ قراراً سريرياً بمفرده.',
      cases: ['تلخيص الملاحظات الطبية للتسليم بين المناوبات', 'صياغة خطابات الإحالة والتقارير', 'الرد على الأسئلة الإدارية للمرضى', 'مراجعة السياسات والبروتوكولات الداخلية'],
      how: ['حجب أرقام المرضى والهوية قبل المعالجة', 'تعريف أنماط أرقام الملفات الخاصة بمنشأتك', 'منع أي توصية سريرية دون مراجعة مختص', 'تتبع كل وصول لأغراض المراجعة'],
      plan: 'Enterprise مع أنماط PII مخصصة', regs: 'نظام حماية البيانات الشخصية (البيانات الصحية بيانات حساسة)، ومتطلبات الجهات الصحية التنظيمية',
    },
    {
      slug: 'enterprise', title: 'الشركات', label: 'ENTERPRISE',
      intro: 'أعطِ فريقك مساحة يبتكر فيها بثقة، وسياسة واضحة تحميه.',
      context: 'موظفوك غالباً يستخدمون الذكاء الاصطناعي اليوم، وغالباً بحسابات شخصية. منعهم لن ينجح، وتركهم مخاطرة. الحل أن تعطيهم أداة أفضل تحميهم وتحمي الشركة.',
      cases: ['كتابة المحتوى والعروض', 'تحليل بيانات المبيعات والعملاء', 'مساعدة فرق التطوير', 'صياغة المراسلات والعقود'],
      how: ['Secure Chat بديل آمن عن الأدوات المجهولة', 'حجب بيانات العملاء والأسرار التجارية', 'تقارير استخدام حسب الإدارة', 'سياسة استخدام مسؤول جاهزة خلال أسبوع'],
      plan: 'Starter أو Business', regs: 'نظام حماية البيانات الشخصية، ومبادئ أخلاقيات الذكاء الاصطناعي',
    },
  ].map(({ slug, ...d }) => ({ params: { sector: slug }, props: d }));
}
const { title, label, intro, context, cases, how, plan, regs } = Astro.props;
---
<PageShell title={`حوكمة الذكاء الاصطناعي — ${title} | BRIGHTAI`} description={intro} crumbs={[{ name: 'الحلول', href: '/#solutions' }, { name: title }]}>
  <p class="eyebrow latin" dir="ltr" style="text-align:right">{label}</p>
  <h1>{title}</h1>
  <p class="note">هذا المحتوى يصف التصور المستهدف للمنصة، ولا يثبت تشغيل القدرات أو التكاملات أو مدد الاحتفاظ المذكورة. المتاح هنا تجربة حجب توضيحية؛ يُحدد نطاق الخدمة والتزاماتها في اتفاق مكتوب.</p>
  <p class="lead">{intro}</p>
  <section class="block"><h2>الواقع</h2><p>{context}</p></section>
  <section class="block"><h2>استخدامات شائعة</h2><ul class="list">{cases.map((c: string) => <li>{c}</li>)}</ul></section>
  <section class="block"><h2>كيف يساعد AIGAS</h2><ul class="list">{how.map((h: string) => <li>{h}</li>)}</ul></section>
  <section class="block"><h2>نقطة البداية المقترحة</h2>
    <p>الباقة الأنسب عادةً: <strong>{plan}</strong>، ويسبقها فحص جاهزية لمدة أسبوعين.</p>
    <p class="note">المرجعيات ذات الصلة: {regs}. نطاق التطبيق يُحدد أثناء التقييم، وهذه الصفحة لا تمثل شهادة امتثال أو اعتماداً تنظيمياً.</p>
    <div class="actions"><a class="button" href={`/contact/?topic=${encodeURIComponent(title)}`}>ناقش احتياج قطاعك <span aria-hidden="true">←</span></a><a class="ghost" href="/pricing/">الأسعار</a></div>
  </section>
</PageShell>
