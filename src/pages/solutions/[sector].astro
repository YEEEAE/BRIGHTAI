---
import PageShell from '../../components/PageShell.astro';
export const prerender = true;
export const sectors = [
  { slug: 'government', title: 'الجهات الحكومية', label: 'GOVERNMENT', intro: 'ابدأ بتحديد الخدمة العامة والقرار والبيانات المتأثرة.', questions: ['ما ضوابط الجهة والسياسات الحكومية المنطبقة؟', 'هل يتأثر مستفيد بقرار أو توصية مولدة؟', 'ما مسار الاعتماد والتصعيد المعتمد؟'] },
  { slug: 'finance', title: 'القطاع المالي', label: 'FINANCIAL SERVICES', intro: 'قيّم أثر استخدام الذكاء الاصطناعي على بيانات العملاء والقرارات المالية.', questions: ['هل تتضمن الحالة بيانات مالية أو شخصية؟', 'ما متطلبات الجهة المنظمة ذات الصلة؟', 'كيف تُراجع التوصية قبل اعتمادها؟'] },
  { slug: 'healthcare', title: 'الرعاية الصحية', label: 'HEALTHCARE', intro: 'ابدأ بتحديد البيانات الصحية والحدود بين الدعم الإداري والقرار السريري.', questions: ['هل تتضمن الحالة بيانات صحية أو معرفات مرضى؟', 'هل قد يؤثر المخرج في قرار سريري؟', 'ما المراجعة المهنية والضوابط المعتمدة؟'] },
  { slug: 'enterprise', title: 'المنشآت والشركات', label: 'ENTERPRISE', intro: 'ضع قواعد لاستخدام الموظفين وحدد البيانات والقنوات المسموح بها.', questions: ['ما الأدوات والحسابات التي اعتمدتها المنشأة؟', 'ما تصنيف البيانات المسموح استخدامها؟', 'كيف يبلغ الموظف عن مشاركة أو مخرج غير مقصود؟'] },
];
export function getStaticPaths() { return sectors.map(({ slug, ...props }) => ({ params: { sector: slug }, props })); }
const { title, label, intro, questions } = Astro.props;
---
<PageShell title={`حوكمة الذكاء الاصطناعي في ${title} | BRIGHTAI`} description={intro} crumbs={[{ name: 'القطاعات', href: '/#solutions' }, { name: title }]}>
  <p class="eyebrow" dir="ltr">{label}</p><h1>{title}</h1>
  <p class="lead">{intro}</p>
  <p class="note">هذه أسئلة للتخطيط وليست توصية تشغيلية أو شهادة امتثال. الالتزامات تختلف بحسب الجهة والقطاع وحالة الاستخدام، والإتاحة التشغيلية لمنتجات AIGAS غير متحققة.</p>
  <section class="block"><h2>أسئلة مناسبة لمرحلة التقييم</h2><ul class="list">{questions.map((question: string) => <li>{question}</li>)}</ul></section>
  <section class="block"><h2>خطوة عملية</h2><p>سجّل الغرض والبيانات والأطراف المتأثرة، ثم اطلب مراجعة الأمن والخصوصية والامتثال والمالك المسؤول قبل اختيار أداة أو إدخال بيانات فعلية.</p><div class="actions"><a class="button" href={`/contact/?topic=${encodeURIComponent(title)}`}>أرسل استفساراً</a><a class="ghost" href="/docs/">أدلة مركز المعرفة</a></div></section>
</PageShell>
