---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
export const prerender = true;
export function getStaticPaths() {
  return [
    { slug: 'government', title: 'الجهات الحكومية', intro: 'استخدام مسؤول للذكاء الاصطناعي في خدمة المستفيدين.', body: 'تحتاج فرق الجهات الحكومية إلى تحديد البيانات التي يمكن مشاركتها، ومن يوافق على الطلبات الحساسة. تبدأ حوكمة الاستخدام بتصنيف البيانات وتحديد المسؤوليات قبل ربط أي نموذج.', points: ['تصنيف بيانات المستفيدين قبل مشاركتها.', 'تحديد مسار الموافقات للقرارات ذات الأثر.', 'تتبّع الطلبات لدعم المراجعة والمساءلة.'] },
    { slug: 'finance', title: 'البنوك والمالية', intro: 'ضع حدوداً واضحة بين بيانات العملاء وأدوات الذكاء الاصطناعي.', body: 'قد تتضمن مهام الفرق المالية بيانات هوية وحسابات ومعلومات تجارية حساسة. ناقش سيناريوهات استخدامكم لتحديد ما يجب حجبه، وما يحتاج مراجعة بشرية، وكيف يوثّق كل قرار.', points: ['تحديد حقول الهوية والحسابات التي تتطلب الحجب.', 'مراجعة بشرية للطلبات والقرارات الحساسة.', 'توثيق استخدام النماذج وفق سياسة المؤسسة.'] },
    { slug: 'healthcare', title: 'الصحة', intro: 'خصوصية المريض في صميم استخدام الذكاء الاصطناعي.', body: 'تحتاج معالجة النصوص الصحية إلى تمييز المعلومات الشخصية عن السياق المطلوب للمهمة. يبدأ التصميم بتحديد البيانات المسموح استخدامها وحدود الدور الذي يؤديه النموذج، مع بقاء القرارات السريرية لدى المختصين.', points: ['تحديد معلومات المريض التي يجب حجبها.', 'رسم حدود الاستخدام ومراجعة المختصين.', 'تتبّع الوصول والطلبات لأغراض المراجعة.'] },
    { slug: 'enterprise', title: 'الشركات', intro: 'أعطِ فريقك مساحة للابتكار، وسياسة واضحة تحميها.', body: 'قد يشارك الموظفون معلومات عملاء أو أسراراً تجارية أثناء إنجاز المهام اليومية. حدد الأدوات المسموح بها، وصنّف البيانات، وضع مساراً واضحاً للتعامل مع الطلبات ذات المخاطر المرتفعة.', points: ['سياسة استخدام مفهومة لكل فريق.', 'حجب البيانات الشخصية قبل مشاركة الطلب.', 'مسؤوليات وموافقات واضحة للمهام الحساسة.'] },
  ].map(({slug, ...data}) => ({ params: { sector: slug }, props: data }));
}
const { title, intro, body, points } = Astro.props;
const schema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://brightai.live/' }, { '@type': 'ListItem', position: 2, name: title, item: Astro.url.href.replace(Astro.url.origin, 'https://brightai.live') }] };
---
<BaseLayout title={`حوكمة الذكاء الاصطناعي — ${title} | BRIGHTAI`} description={intro}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Header />
  <main id="main" class="wrap section subpage">
    <nav class="breadcrumb" aria-label="مسار التنقل"><a href="/">الرئيسية</a> / <a href="/#solutions">الحلول</a> / {title}</nav>
    <h1>{title}</h1><h2>{intro}</h2><p>{body}</p>
    <ul>{points.map((point: string) => <li>{point}</li>)}</ul>
    <p class="scope">نطاق التطبيق ومتطلبات القطاع يُحدّدان أثناء التقييم؛ هذه الصفحة لا تمثل شهادة امتثال أو اعتماداً تنظيمياً.</p>
    <div class="actions"><a class="button" href={`mailto:hello@brightai.live?subject=${encodeURIComponent(`عرض AIGAS — ${title}`)}`}>ناقش احتياج قطاعك <span aria-hidden="true">←</span></a><a class="ghost" href="/kernel/">جرّب مثال الحجب</a></div>
  </main>
  <Footer />
</BaseLayout>
<style>h2 { font-size: 30px; } ul { padding-inline-start: 24px; color: #bdbdbd; } li { margin-block: 18px; } .scope { font-size: 14px; }</style>
