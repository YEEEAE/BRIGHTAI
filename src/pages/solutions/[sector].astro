<!-- BAI-VOC-001-A (2026-07-18): VOC injection في hero lead — يستبدل `sector.description` بـ `sector.vocLead` (per-sector، 5 ركائز) عند التوفر. H1 = `sector.h1` (keyword-rich, unchanged). الـ `<title>`/`<meta description>` JSON-LD يستخدمون `migratedPage?.description ?? sector.description` (لم يتغيّر). -->
<!-- BAI-VOC-001-C (2026-07-18): توحيد CTAs — hero + final: "اطلب عرض توضيحي" → "اطلب عرض توضيحي مخصص" + microcopy. href (wa.me/... + /contact/) لم يتغير. -->
---
/**
 * /solutions/[sector]/ — Sector page (REPORT-10 redesign).
 *
 * Sections (preserved + new اللوائح المنطبقة):
 *   1. Hero (split + sector chip)
 *   2. اللوائح المنطبقة — compliance-grid (NEW per task spec)
 *   3. كيف يشتغل المنصة في هذا القطاع — 4-step flow (NEW)
 *   4. التحديات — preserved (المشكلة السابقة + shortcut)
 *   5. Solutions for this sector — preserved card cluster
 *   6. Local presence — preserved (city cards)
 *   7. Related links — preserved
 *   8. Final CTA — preserved
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BackgroundGrid from '../../components/BackgroundGrid.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import SectorCard from '../../components/SectorCard.astro';
import { sectors, solutions, getRelatedSectors } from '../../data/solutions';
import { migratedSectorPages } from '../../data/migratedSolutionPages';
// KRN-012 / EXEC-12: sanitize migrated HTML
import DOMPurify from 'isomorphic-dompurify';

import Icon from '../../components/Icon.astro';
import { getFaqLd } from '../../data/schema-helpers';
// BAI-SEO-003-S7 (2026-07-18): P0 snippet pack — central contract
import { getP0Snippet, SNIPPET_SELECTOR } from '../../data/snippet-pack';

export function getStaticPaths() {
  return sectors.map(s => ({ params: { sector: s.slug }, props: { sector: s } }));
}
const { sector } = Astro.props;
const migratedPage = migratedSectorPages[sector.slug];
const relatedSols = sector.related.map(r => solutions.find(s => s.slug === r)).filter(Boolean);

const crumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'الحلول', href: '/solutions/' },
  { label: sector.h1 }
];

// BAI-SEO-003-S3 (2026-07-18): BreadcrumbList is emitted by the foundation
// Schema.astro from the layout's `breadcrumbs` prop. We keep only the
// page-specific Service node here to avoid duplicate @id warnings
// (verified via scripts/_check-duplicate-schema-ids.mjs).
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": sector.canonical + "#service",
      "name": sector.h1,
      "description": sector.description,
      "provider": { "@type": "Organization", "name": "BrightAI", "url": "https://brightai.site" },
      "url": sector.canonical,
      "areaServed": "Saudi Arabia"
    }
  ]
};

// BAI-VOC-001-B (2026-07-18): merge the sector's FAQPage (built from the
// exact same array that powers the visible <details> section) into the
// graph so the JSON-LD and the rendered DOM never drift.
const sectorFaqLd = sector.faqs && sector.faqs.length > 0
  ? getFaqLd(sector.faqs.map((f) => ({ q: f.question, a: f.answer })))
  : null;
const sectorJsonLd = sectorFaqLd
  ? { '@context': 'https://schema.org', '@graph': [...jsonLd['@graph'], sectorFaqLd] }
  : jsonLd;

/**
 * BAI-VOC-001-B (2026-07-18): some legacy migrated JSON-LD blocks
 * (sector-banking-ai-governance.json et al.) ship their own FAQPage
 * and/or a redundant WebPage node inside the page-level `@graph`. The
 * FoundationSchema in BaseLayout already emits Organization, WebSite,
 * LocalBusiness, WebPage (with the live SpeakableSpecification) and
 * BreadcrumbList, so a second copy of any of these in the migrated
 * payload produces duplicate @type nodes in the final @graph — which
 * confuses Google Rich Results Test and inflates the JSON-LD payload.
 * We must REPLACE the FAQPage (with `sectorJsonLd`) and DROP the
 * redundant WebPage so the visible <details> and the JSON-LD stay in
 * lockstep — otherwise a drift would surface in Google's Rich Results
 * Test ("FAQPage answer does not match the visible answer") and break
 * the P0 acceptance criterion "no question/answer mismatch".
 */
// BAI-SEO-003-S3 (2026-07-18): BreadcrumbList added — the foundation
// Schema.astro emits a BreadcrumbList (no @id) for every page; the
// migrated JSON-LD also carried a BreadcrumbList with @id, which
// produced a duplicate @id in the merged @graph (verified via
// scripts/_check-duplicate-schema-ids.mjs).
const FOUNDATION_TYPES = new Set(['Organization', 'WebSite', 'LocalBusiness', 'WebPage', 'BreadcrumbList']);

function sanitiseMigratedForFoundation(
  node: unknown,
  seen: WeakSet<object> = new WeakSet(),
): unknown {
  if (!node || typeof node !== 'object') return node;
  if (seen.has(node as object)) return node;
  seen.add(node as object);

  // Helper: does the @type on this node refer to a foundation type?
  // Handles both string @type and @type as array (e.g.
  // `["Organization", "LocalBusiness"]` — the merged form used in some
  // legacy migrated JSON files).
  const isFoundationNode = (n: unknown): boolean => {
    if (!n || typeof n !== 'object') return false;
    const t = (n as Record<string, unknown>)['@type'];
    if (typeof t === 'string') return t === 'FAQPage' || FOUNDATION_TYPES.has(t);
    if (Array.isArray(t)) return t.some((x) => typeof x === 'string' && (x === 'FAQPage' || FOUNDATION_TYPES.has(x)));
    return false;
  };

  if (Array.isArray(node)) {
    return node
      .filter((child) => !isFoundationNode(child))
      .map((child) => sanitiseMigratedForFoundation(child, seen));
  }

  const obj = node as Record<string, unknown>;
  const next: Record<string, unknown> = {};
  for (const [key, value] of Object.entries(obj)) {
    if (key === '@type') {
      if (typeof value === 'string' && (value === 'FAQPage' || FOUNDATION_TYPES.has(value))) continue;
      if (Array.isArray(value) && value.some((x) => typeof x === 'string' && (x === 'FAQPage' || FOUNDATION_TYPES.has(x)))) continue;
    }
    next[key] = sanitiseMigratedForFoundation(value, seen);
  }
  return next;
}

const migratedJsonLdSanitised = migratedPage?.jsonLd
  ? (Array.isArray(migratedPage.jsonLd)
      ? migratedPage.jsonLd.map((entry) => sanitiseMigratedForFoundation(entry))
      : sanitiseMigratedForFoundation(migratedPage.jsonLd))
  : null;

const finalJsonLd = migratedJsonLdSanitised
  ? sectorFaqLd
    ? [...(Array.isArray(migratedJsonLdSanitised) ? migratedJsonLdSanitised : [migratedJsonLdSanitised]), sectorFaqLd]
    : (migratedJsonLdSanitised as unknown as typeof jsonLd)
  : sectorJsonLd;

// BAI-VOC-001-B (2026-07-18): 30-60 word Saudi-dialect answer-first
// summary. Sits immediately after the H1 so AI voice / TTS engines
// (Google Assistant, Siri, Alexa) can quote it verbatim. Also the
// second cssSelector entry for the WebPage SpeakableSpecification.
const sectorAnswerFirst =
  `حوكمة ${sector.chip} مع BrightAI تعني توثيق كل استخدام AI، تصنيف مخاطره، حجب البيانات الحساسة قبل الإرسال للنموذج، وإجبار موافقة بشرية على القرارات عالية الأثر. أداة تشغيلية لا تستبدل التقييم النظامي أو القانوني.`;

// BAI-SEO-003-S7 (2026-07-18): P0 snippet pack — TL;DR / الخلاصة.
// 3 sectors are P0 (banking, government, healthcare). For P0 sectors
// we convert the existing answer-first summary into the central-contract
// aside (new formal-Arabic text from src/data/snippet-pack.ts). For
// the other sectors (manufacturing), the existing Saudi-dialect
// answer-first summary is preserved unchanged.
const p0SectorSnippet = getP0Snippet(sector.href);

/* ------------------------------------------------------------------
 * Per-sector compliance badges + 4-step flow مخصصة لكل قطاع.
 * تستند على نفس البيانات الموجودة في migrated pages + حلول مرتبطة.
 * ------------------------------------------------------------------ */
type Compliance = { abbr: string; name: string; scope: string };
const COMPLIANCE_BY_SLUG: Record<string, Compliance[]> = {
  'banking-ai-governance': [
    { abbr: 'SAMA',     name: 'البنك المركزي السعودي',         scope: 'حوكمة الائتمان، كشف الاحتيال، مكافحة غسل الأموال' },
    { abbr: 'NCA ECC',  name: 'ضوابط الأمن السيبراني',        scope: 'تقييم المخاطر، حماية البيانات' },
    { abbr: 'PDPL',     name: 'نظام حماية البيانات الشخصية', scope: 'موافقة العميل، حق الحذف، الإفصاح' },
    { abbr: 'FATF',     name: 'مكافحة غسل الأموال وتمويل الإرهاب', scope: 'KYC، الإبلاغ عن المعاملات المشبوهة' },
  ],
  'government-ai-governance': [
    { abbr: 'DGA',      name: 'هيئة الحكومة الرقمية',         scope: 'معايير الخدمات الرقمية الحكومية' },
    { abbr: 'PDPL',     name: 'حماية البيانات الشخصية',      scope: 'بيانات المستفيدين من الخدمات' },
    { abbr: 'NCA ECC',  name: 'ضوابط الأمن السيبراني',        scope: 'تطبيقات AI الحكومية، سرية المستندات' },
    { abbr: 'SDAIA',    name: 'سدايا',                        scope: 'إرشادات الذكاء الاصطناعي التوليدي' },
    { abbr: 'Vision 2030', name: 'رؤية 2030',                  scope: 'التحول الرقمي الحكومي' },
  ],
  'healthcare-ai-governance': [
    { abbr: 'SFDA',     name: 'الهيئة العامة للغذاء والدواء', scope: 'تطبيقات AI الطبية، الأجهزة الطبية الذكية' },
    { abbr: 'ISO 13485', name: 'إدارة جودة الأجهزة الطبية',  scope: 'تصميم وتطوير أنظمة AI الطبية' },
    { abbr: 'PDPL',     name: 'حماية البيانات الشخصية',      scope: 'بيانات المرضى (PHI)' },
    { abbr: 'NCA ECC',  name: 'الأمن السيبراني',             scope: 'حماية سجلات المرضى' },
    { abbr: 'CBAHI',    name: 'المركز السعودي لاعتماد المنشآت الصحية', scope: 'معايير الاعتماد المؤسسي' },
  ],
  'manufacturing-ai-governance': [
    { abbr: 'NCA ECC',  name: 'الأمن السيبراني الصناعي',     scope: 'حماية شبكات OT و IoT' },
    { abbr: 'ISO 42001', name: 'إدارة الذكاء الاصطناعي',     scope: 'نظام حوكمة AI متكامل' },
    { abbr: 'PDPL',     name: 'حماية البيانات',              scope: 'بيانات المشغلين والموردين' },
    { abbr: 'SASO/IEC', name: 'الهيئة السعودية للمواصفات', scope: 'الجودة الصناعية' },
  ],
};
const complianceBadges = sector.regulations ?? COMPLIANCE_BY_SLUG[sector.slug] ?? [];

const SECTOR_FLOW: { label: string; desc: string; icon: string }[] = [
  { label: 'تقييم مخاطر AI',           desc: 'مسح شامل لاستخدامات AI في القطاع.',          icon: 'mdi-magnify' },
  { label: 'تطبيق ضوابط مخصصة',         desc: 'سياسات تترجم اللوائح إلى ضوابط تقنية.',     icon: 'mdi-cog' },
  { label: 'تشغيل لحظي',                desc: 'مراقبة القرارات عالية المخاطر تلقائياً.',   icon: 'mdi-heart-pulse' },
  { label: 'تقارير القطاع',             desc: 'تقارير جاهزة للجهات التنظيمية.',            icon: 'mdi-file-document' },
];
---
<ArabicLayout title={migratedPage?.title ?? sector.title} description={migratedPage?.description ?? sector.description} canonical={migratedPage?.canonical ?? sector.canonical} hreflang={migratedPage?.hreflang ?? [{lang:'ar-SA',href:sector.canonical},{lang:'x-default',href:sector.canonical}]} jsonLd={finalJsonLd as any} currentPath={sector.href} ogImage="/assets/images/og/og-solutions.webp" ogImageAlt={migratedPage?.title ?? sector.title} extraSpeakableSelectors={p0SectorSnippet ? ['.answer-first-summary', SNIPPET_SELECTOR] : ['.answer-first-summary']}>
{!sector.regulations ? (
  /* legacy migrated fallback — only لو ما في regulations data */
  <>
    {!/<h1\b/i.test(migratedPage!.html) && <h1 class="sr-only">{sector.h1}</h1>}
    <main class="migrated-legacy-content" set:html={DOMPurify.sanitize(migratedPage!.html)} />
  </>
) : (
<>
{/* ─── Section 1 · Hero ───────────────────────────────────────────── */}
<section class="inner-hero inner-hero--split bg-ambient-teal-top" aria-label={sector.h1}>
  <BackgroundGrid />
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <Breadcrumbs crumbs={crumbs} />
    <div class="grid gap-10 lg:gap-12 lg:grid-cols-2 items-center">
      <div>
        <span class="inner-hero__badge"><Icon name={sector.icon} class="" /> {sector.chip}</span>
        <h1>{sector.h1}</h1>
        {/* BAI-SEO-003-S7 (2026-07-18): P0 snippet pack — TL;DR / الخلاصة.
            For P0 sectors (banking/government/healthcare) we convert
            the existing answer-first summary into the central-contract
            aside; text from src/data/snippet-pack.ts (formal Arabic,
            ≤60 words, no new claims). For non-P0 sectors, the
            BAI-VOC-001-B answer-first summary is preserved unchanged. */}
        {p0SectorSnippet ? (
          <aside data-snippet="tl-dr" aria-label="الخلاصة" class="answer-first-summary">
            <p>{p0SectorSnippet.text}</p>
          </aside>
        ) : (
          <p class="answer-first-summary" data-speakable-target="answer-first">{sectorAnswerFirst}</p>
        )}
        <p class="inner-hero__desc">{sector.vocLead ?? sector.description}</p>
        <div class="inner-hero__actions">
          <div class="cta-actions">
            <a href="/contact/" class="glow-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold" data-cta="hero_cta_click" data-cta-label="اطلب عرض توضيحي مخصص" data-position="inline" data-page-type="unknown" data-offer="assessment"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-calendar-check"></use></svg> اطلب عرض توضيحي مخصص</a>
            <small class="cta-micro" aria-hidden="true">30 دقيقة • نطاق + SLA + milestones</small>
          </div>
<div class="cta-actions">
<a href="https://wa.me/966538229013" target="_blank" rel="nofollow noopener noreferrer" class="btn--whatsapp inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white" data-whatsapp data-cta-label="تواصل عبر واتساب" data-position="inline" data-page-type="unknown"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-whatsapp"></use></svg> تواصل عبر واتساب</a>
  <small class="cta-micro" aria-hidden="true">رد سريع • يردّك مهندس سعودي</small>
</div>
        </div>
      </div>

      <div class="product-mockup" aria-hidden="true">
        <div class="product-mockup__browser-bar">
          <span class="product-mockup__dot"></span>
          <span class="product-mockup__dot"></span>
          <span class="product-mockup__dot"></span>
          <span class="product-mockup__url">kernel.brightai.site{sector.href}</span>
        </div>
        <div class="product-mockup__panel">
          <div class="product-mockup__row">
            <span class="product-mockup__row-icon"><svg width="16" height="16" aria-hidden="true"><use href={`/icons.svg#${sector.icon}`}></use></svg></span>
            <div class="product-mockup__row-text">
              <span class="product-mockup__row-label">{sector.chip} — لوحة الحوكمة</span>
              <span class="product-mockup__row-meta">{relatedSols.length} حلول مطبّقة</span>
            </div>
            <span class="product-mockup__row-status product-mockup__row-status--success">مطابق</span>
          </div>
          <div class="product-mockup__row">
            <span class="product-mockup__row-icon"><svg width="16" height="16" aria-hidden="true"><use href="/icons.svg#mdi-shield-check"></use></svg></span>
            <div class="product-mockup__row-text">
              <span class="product-mockup__row-label">جاهزية اللوائح</span>
              <span class="product-mockup__row-meta">{complianceBadges.length} جهات منطبقة</span>
            </div>
            <span class="product-mockup__row-status product-mockup__row-status--info">قيد المراجعة</span>
          </div>
          <div class="product-mockup__row">
            <span class="product-mockup__row-icon"><svg width="16" height="16" aria-hidden="true"><use href="/icons.svg#mdi-graph-outline"></use></svg></span>
            <div class="product-mockup__row-text">
              <span class="product-mockup__row-label">مخاطر نشطة</span>
              <span class="product-mockup__row-meta">آخر 30 يوم</span>
            </div>
            <span class="product-mockup__row-status product-mockup__row-status--success">صفر</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ─── Section 2 · اللوائح المنطبقة — compliance-grid (NEW) ──────── */}
{complianceBadges.length > 0 && (
  <section class="inner-section inner-section--alt" aria-labelledby="compliance">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="section__header section__header--start">
        <span class="section__eyebrow" lang="en">Applicable regulations</span>
        <h2 id="compliance" class="section__title section__title--start">
          <svg class="inline-block align-middle me-2 icon-indigo" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-shield-check"></use></svg>
          اللوائح المنطبقة
        </h2>
        <p class="section__subtitle section__subtitle--start">الجهات التنظيمية التي يجب أن تلتزم بها أي مؤسسة في هذا القطاع، وكيف يدعم BrightAI كل ضابط.</p>
      </div>

      <div class="compliance-grid">
        {complianceBadges.map(c => (
          <article class="compliance-badge">
            <span class="compliance-badge__abbr">{c.abbr}</span>
            <h3 class="compliance-badge__name">{c.name}</h3>
            <p class="compliance-badge__scope">{c.scope}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{/* ─── Section 3 · كيف يشتغل المنصة في هذا القطاع — 4-step flow ── */}
<section class="inner-section" aria-labelledby="sector-flow">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="section__header section__header--start">
      <span class="section__eyebrow" lang="en">How it works in this sector</span>
      <h2 id="sector-flow" class="section__title section__title--start">كيف يُطبَّق BrightAI في {sector.chip}؟</h2>
    </div>
    <ol class="flow-steps" aria-label="كيف يُطبَّق BrightAI في هذا القطاع">
      {SECTOR_FLOW.map((step, idx) => (
        <li class="flow-step">
          <div class="flow-step__number" aria-hidden="true">{['١','٢','٣','٤'][idx]}</div>
          <span class="flow-step__icon" aria-hidden="true">
            <svg width="32" height="32"><use href={`/icons.svg#${step.icon}`}></use></svg>
          </span>
          <h3 class="flow-step__title">{step.label}</h3>
          <p class="flow-step__desc">{step.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ─── Section 4 · التحدي (preserved) ─────────────────────────────── */}
<section class="inner-section inner-section--alt" aria-labelledby="problem">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="problem" class="inner-section__title"><svg class="text-red-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-alert-circle"></use></svg> التحدي</h2>
    <p class="inner-section__lead">متى تحتاج هذا الحل؟ {sector.whenNeeded}</p>
    <div class="inner-card p-8">
      <p class="inner-card__text text-base leading-loose">{sector.shortDesc} هذا الحل يدعم جاهزية مؤسستك للضوابط التنظيمية السعودية وليس استشارة قانونية.</p>
    </div>
  </div>
</section>

{/* ─── Section 5 · الحلول لهذا القطاع (preserved card cluster) ───── */}
<section class="inner-section" aria-labelledby="solutions-for-sector">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="solutions-for-sector" class="inner-section__title"><svg class="text-cyan-300" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-puzzle"></use></svg> حلول BrightAI لهذا القطاع</h2>
    <div class="inner-grid inner-grid--2">
      {relatedSols.map(sol => (
        <a href={sol!.href} class="inner-card p-6 text-decoration-reset">
          <div class="flex items-center gap-3 mb-3">
            <div class="text-2xl"><Icon name={sol!.icon} class="text-cyan-300" /></div>
            <h3 class="inner-card__title text-base">{sol!.h1.split('(')[0].trim()}</h3>
          </div>
          <p class="inner-card__text text-sm">{sol!.shortDesc}</p>
        </a>
      ))}
    </div>
  </div>
</section>

{/* ─── Section 6 · Local presence (preserved city cards) ─────────── */}
{sector.locals && sector.locals.length > 0 && (
<section class="inner-section inner-section--alt" aria-labelledby="local-presence">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="local-presence" class="inner-section__title"><svg class="text-emerald-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-map-marker"></use></svg> تواجدنا المحلي</h2>
    <div class="inner-grid inner-grid--3">
      {sector.locals.map(loc => (
        <a href={loc.href} class="inner-card p-6 text-center text-decoration-reset">
          <div class="text-3xl mb-3"><svg class="text-emerald-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-map-marker-radius"></use></svg></div>
          <h3 class="inner-card__title">{loc.cityAr}</h3>
          <p class="inner-card__text text-xs mt-2">{loc.h1.split('في')[1]?.trim() || loc.cityAr}</p>
        </a>
      ))}
    </div>
  </div>
</section>
)}

{/* ─── Section 7 · FAQs (extracted from migrated) ──────────────────── */}
{sector.faqs && sector.faqs.length > 0 && (
<section class="inner-section" aria-labelledby="sector-faqs">
  <div class="max-w-4xl mx-auto px-5 lg:px-8">
    <div class="section__header section__header--start">
      <span class="section__eyebrow" lang="en">FAQ</span>
      <h2 id="sector-faqs" class="section__title section__title--start">أسئلة تدور في ذهنك؟</h2>
    </div>
    <div class="inner-faq">
      {sector.faqs.map(faq => (
        <details>
          <summary>{faq.question}</summary>
          <div class="inner-faq__answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
)}

{/* ─── Section 8 · Related links (preserved) ──────────────────────── */}
<RelatedLinks relatedSlugs={sector.related} sectorSlugs={sectors.filter(s => s.slug !== sector.slug).map(s => s.slug)} docs={sector.docs} blog={sector.blog} />

{/* ─── Section 8 · Final CTA (preserved) ──────────────────────────── */}
