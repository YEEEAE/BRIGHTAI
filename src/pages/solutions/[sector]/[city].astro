---
import ArabicLayout from '../../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BackgroundGrid from '../../../components/BackgroundGrid.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import { sectors, solutions } from '../../../data/solutions';
import { migratedLocalPages } from '../../../data/migratedSolutionPages';

import Icon from '../../../components/Icon.astro';
import { ORGANIZATION } from '../../../data/schema-helpers';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const sector of sectors) {
    if (sector.locals) {
      for (const loc of sector.locals) {
        paths.push({
          params: { sector: sector.slug, city: loc.slug },
          props: { sector, loc }
        });
      }
    }
  }
  return paths;
}
const { sector, loc } = Astro.props;
const migratedPage = migratedLocalPages[`${sector.slug}/${loc.slug}`];
const relatedSols = sector.related.map(r => solutions.find(s => s.slug === r)).filter(Boolean);

const crumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'الحلول', href: '/solutions/' },
  { label: sector.h1, href: sector.href },
  { label: loc.cityAr }
];

const wikiId = loc.cityEn === 'Riyadh' ? 'Q3674'
  : loc.cityEn === 'Dammam' ? 'Q41630'
  : loc.cityEn === 'Jeddah' ? 'Q39547'
  : loc.cityEn === 'Mecca' ? 'Q35484'
  : loc.cityEn === 'Madinah' ? 'Q35484'
  : loc.cityEn === 'Khobar' ? 'Q810482'
  : 'Q3674';

const whatsappMsg = encodeURIComponent(`مرحباً، أريد استفسار عن خدمات حوكمة الذكاء الاصطناعي في ${loc.cityAr} (${sector.chip})`);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["LocalBusiness", "Service"],
      "@id": loc.canonical + "#localbusiness",
      "name": `BrightAI — ${sector.h1}`,
      "description": loc.description,
      "url": loc.canonical,
      "telephone": "+966538229013",
      "image": "https://brightai.site/assets/images/og/og-solutions.webp",
      "priceRange": "$$$",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": loc.cityAr,
        "addressRegion": loc.cityEn,
        "addressCountry": "SA"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": loc.geoLat,
        "longitude": loc.geoLng
      },
      "areaServed": { "@type": "City", "name": loc.areaServed, "@id": `https://www.wikidata.org/wiki/${wikiId}` },
      "provider": { "@type": "Organization", "name": "BrightAI", "url": "https://brightai.site" },
      "serviceArea": {
        "@type": "GeoCircle",
        "geoMidpoint": { "@type": "GeoCoordinates", "latitude": loc.geoLat, "longitude": loc.geoLng },
        "geoRadius": "100 km"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": crumbs.map((c: any, i: number) => ({
        "@type": "ListItem", "position": i + 1, "name": c.label,
        "item": c.href ? `https://brightai.site${c.href}` : loc.canonical
      }))
    },
    // SCHEMA-ENHANCEMENT (REPORT-23): canonical Organization node added.
    ORGANIZATION,
  ]
};
---
<ArabicLayout title={migratedPage?.title ?? loc.title} description={migratedPage?.description ?? loc.description} canonical={migratedPage?.canonical ?? loc.canonical} hreflang={migratedPage?.hreflang ?? [{lang:'ar-SA',href:loc.canonical},{lang:'x-default',href:loc.canonical}]} jsonLd={migratedPage?.jsonLd ? { '@context': 'https://schema.org', '@graph': [...(Array.isArray(migratedPage.jsonLd) ? migratedPage.jsonLd : [migratedPage.jsonLd]), ORGANIZATION] } : (jsonLd as any)} currentPath={loc.href} ogImage="/assets/images/og/og-solutions.webp" ogImageAlt={migratedPage?.title ?? loc.title}>
{migratedPage ? (
  <>
    {!/<h1\b/i.test(migratedPage.html) && <h1 class="sr-only">{loc.h1}</h1>}
    <main class="migrated-legacy-content" set:html={migratedPage.html} />
  </>
) : (
<>
<section class="inner-hero" aria-label={loc.h1}>
  <BackgroundGrid />
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <Breadcrumbs crumbs={crumbs} />
    <div class="inner-hero__badge"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-map-marker-radius"></use></svg> {loc.cityAr} — {sector.chip}</div>
    <h1>{loc.h1}</h1>
    <p class="inner-hero__desc">{loc.description}</p>
    <div class="inner-hero__actions">
      <a href="/contact/" class="glow-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-calendar-check"></use></svg> اطلب عرض توضيحي</a>
      <a href={`https://wa.me/966538229013?text=${whatsappMsg}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white" style="background:linear-gradient(135deg,var(--whatsapp),var(--whatsapp-dark))"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-whatsapp"></use></svg> تواصل عبر واتساب</a>
    </div>
  </div>
</section>

<section class="inner-section inner-section--alt" aria-labelledby="local-context">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="local-context" class="inner-section__title"><svg class="text-cyan-300" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-city"></use></svg> خدمات حوكمة الذكاء الاصطناعي في {loc.cityAr}</h2>
    <div class="inner-card p-8">
      <p class="inner-card__text text-base leading-loose">{sector.shortDesc} نقدم خدماتنا محلياً في {loc.cityAr} مع دعم فني ميداني وتكامل مع الأنظمة المحلية. هذا الحل يدعم جاهزية مؤسستك للضوابط التنظيمية السعودية وليس استشارة قانونية.</p>
    </div>
  </div>
</section>

<section class="inner-section" aria-labelledby="solutions-local">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="solutions-local" class="inner-section__title"><svg class="text-cyan-300" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-puzzle"></use></svg> حلول BrightAI المتاحة في {loc.cityAr}</h2>
    <div class="inner-grid inner-grid--2">
      {relatedSols.map(sol => (
        <a href={sol!.href} class="inner-card p-6" style="text-decoration:none;color:inherit">
          <div class="flex items-center gap-3 mb-3">
            <div class="text-2xl"><Icon name={sol!.icon} class="text-cyan-300" /></div>
            <h3 class="inner-card__title text-base">{sol!.h1.split('(')[0].trim()}</h3>
          </div>
          <p class="inner-card__text text-sm">{sol!.shortDesc}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<a href={sector.href} class="block inner-section inner-section--alt" style="text-decoration:none;color:inherit" aria-labelledby="parent-sector">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="inner-card p-8 flex items-center gap-4">
      <div class="text-4xl"><Icon name={sector.icon} class="text-cyan-300" /></div>
      <div>
        <h2 id="parent-sector" class="inner-card__title text-lg">الصفحة الرئيسية: {sector.h1}</h2>
        <p class="inner-card__text text-sm mt-1">اطّلع على التفاصيل الكاملة لحوكمة الذكاء الاصطناعي في {sector.chip} ←</p>
      </div>
    </div>
  </div>
</a>

<RelatedLinks relatedSlugs={sector.related} sectorSlugs={sectors.filter(s => s.slug !== sector.slug).map(s => s.slug)} docs={sector.docs} blog={sector.blog} />

<section class="inner-cta-final">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="inner-cta-final__card">
      <h2 class="inner-cta-final__title">ابدأ بحوكمة الذكاء الاصطناعي في {loc.cityAr} الآن</h2>
      <p class="inner-cta-final__desc">فريقنا في {loc.cityAr} جاهز لمساعدتك. تواصل معنا للحصول على عرض توضيحي مخصص.</p>
      <div class="inner-hero__actions" style="justify-content:center;">
        <a href="/contact/" class="glow-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-calendar-check"></use></svg> اطلب عرض توضيحي</a>
<a href={`https://wa.me/966538229013?text=${whatsappMsg}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white" style="background:linear-gradient(135deg,var(--whatsapp),var(--whatsapp-dark))"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-whatsapp"></use></svg> تواصل عبر واتساب</a>
      </div>
    </div>
  </div>
</section>

{/* Scroll Reveal: centralized in BaseLayout.astro (DEC-015). */}
</>
)}
</ArabicLayout>
