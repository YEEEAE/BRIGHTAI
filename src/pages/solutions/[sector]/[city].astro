---
import ArabicLayout from '../../../layouts/ArabicLayout.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import { sectors, solutions } from '../../../data/solutions';
import { migratedLocalPages } from '../../../data/migratedSolutionPages';
// KRN-012 / EXEC-12: sanitize migrated HTML
import DOMPurify from 'isomorphic-dompurify';

import Icon from '../../../components/Icon.astro';
import { getFaqLd } from '../../../data/schema-helpers';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const sector of sectors) {
    if (sector.locals) {
      for (const loc of sector.locals) {
        paths.push({
          params: { sector: sector.slug, city: loc.slug },
          props: { sector, loc }
        });
      }
    }
  }
  return paths;
}
const { sector, loc } = Astro.props;
const migratedPage = migratedLocalPages[`${sector.slug}/${loc.slug}`];
const relatedSols = sector.related.map((r: string) => solutions.find(s => s.slug === r)).filter(Boolean);

const crumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'الحلول', href: '/solutions/' },
  { label: sector.h1, href: sector.href },
  { label: loc.cityAr, href: loc.href }
];

const wikiId = loc.cityEn === 'Riyadh' ? 'Q3674'
  : loc.cityEn === 'Dammam' ? 'Q41630'
  : loc.cityEn === 'Jeddah' ? 'Q39547'
  : loc.cityEn === 'Mecca' ? 'Q35484'
  : loc.cityEn === 'Madinah' ? 'Q334084'
  : loc.cityEn === 'Khobar' ? 'Q810482'
  : 'Q3674';

const whatsappMsg = encodeURIComponent(`مرحباً، أريد استفسار عن خدمات حوكمة الذكاء الاصطناعي في ${loc.cityAr} (${sector.chip})`);

// BAI-SEO-003-S3 (2026-07-18): BreadcrumbList is emitted by the foundation
// Schema.astro from the layout's `breadcrumbs` prop. We only emit the
// page-specific LocalBusiness node here to avoid duplicate @id warnings
// (verified via scripts/_check-duplicate-schema-ids.mjs).
// BAI-SEO-003-S6 (2026-07-18): SAB honesty — LocalBusiness type is only
// valid for Riyadh (the actual company HQ, رويغب الفيحاء، الرياض —
// unified founder address 2026-08-23). For the other 5 cities (khobar, dammam, jeddah,
// mecca, madinah) we emit plain `Service` — NOT ProfessionalService —
// because ProfessionalService is a LocalBusiness subtype and validators
// (Semrush "Local Business: 1 field invalid") then demand an `address`
// we do not have (no fake branch offices, ever). Plain Service needs no
// address and validates clean with geo + serviceArea (factual reach).
// Only Riyadh carries an `address` block, and its address is
// the real HQ street, NOT a fabricated branch office.
const isHQ = loc.cityEn === 'Riyadh';
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": isHQ ? ["LocalBusiness", "Service"] : "Service",
      "@id": loc.canonical + (isHQ ? "#localbusiness" : "#service"),
      "name": `BrightAI — ${sector.h1}`,
      "description": loc.description,
      "url": loc.canonical,
      "telephone": "+966538229013",
      "image": "https://brightai.live/assets/images/og/og-solutions.webp",
      "priceRange": "$$$",
      ...(isHQ ? {
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "رويغب الفيحاء",
          "addressLocality": "الرياض",
          "addressRegion": "منطقة الرياض",
          "addressCountry": "SA"
        }
      } : {}),
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": loc.geoLat,
        "longitude": loc.geoLng
      },
      "areaServed": { "@type": "City", "name": loc.areaServed, "@id": `https://www.wikidata.org/wiki/${wikiId}` },
      "provider": { "@type": "Organization", "name": "BrightAI", "url": "https://brightai.live" },
      "serviceArea": {
        "@type": "GeoCircle",
        "geoMidpoint": { "@type": "GeoCoordinates", "latitude": loc.geoLat, "longitude": loc.geoLng },
        "geoRadius": "100 km"
      }
    }
  ]
};

// BAI-VOC-001-B (2026-07-18): merge the city-level FAQPage into the
// graph. The visible <details> block and the JSON-LD FAQPage always
// come from the same `loc.faqs` array — single source of truth. If a
// legacy migrated page ships its own FAQPage we strip it (see
// helper below) and replace it with the live locFaqLd so the two
// never drift. The `loc.faqs` is mandatory for cities without a
// migrated page (khobar, mecca, madinah) and optional for migrated
// cities (riyadh, dammam, jeddah) where the legacy 6 questions are
// still considered "in-sync" and pass through untouched.
const locFaqLd = loc.faqs && loc.faqs.length > 0
  ? getFaqLd(loc.faqs.map((f: any) => ({ q: f.question, a: f.answer })))
  : null;

/**
 * BAI-VOC-001-B (2026-07-18): drop every @type:"FAQPage" node AND the
 * redundant foundation types (Organization / WebSite / LocalBusiness /
 * WebPage) from a (potentially nested) migrated JSON-LD payload. The
 * FoundationSchema in BaseLayout already emits those, so keeping the
 * migrated copies would create duplicate @type nodes — which inflate
 * the JSON-LD payload and confuse the Google Rich Results Test.
 * Cycle-safe via WeakSet.
 */
// BAI-SEO-003-S3 (2026-07-18): BreadcrumbList added — the foundation
// Schema.astro emits a BreadcrumbList (no @id) for every page; the
// migrated JSON-LD also carried a BreadcrumbList with @id, which
// produced a duplicate @id in the merged @graph (verified via
// scripts/_check-duplicate-schema-ids.mjs).
const FOUNDATION_TYPES_CITY = new Set(['Organization', 'WebSite', 'LocalBusiness', 'WebPage', 'BreadcrumbList']);
// SEMRUSH-FIX-2026-09-04: legacy migrated city JSONs (dammam, jeddah) carry
// their own `ProfessionalService + Service` node WITHOUT an `address` block.
// ProfessionalService is a LocalBusiness subtype, so validators flag it as
// "Local Business: 1 field invalid". The template above already emits the
// canonical service node for the page (HQ LocalBusiness+Service for Riyadh,
// plain Service for the other cities), so any migrated service-typed node
// is a stale duplicate and must be dropped — same pattern as the
// foundation types above. Plain `Service` needs no address and would be
// valid, but keeping both would duplicate the service entity.
const MIGRATED_SERVICE_TYPES_DROP = new Set(['ProfessionalService', 'Service']);

function stripFoundationTypesFromMigrated(
  node: unknown,
  seen: WeakSet<object> = new WeakSet(),
): unknown {
  if (!node || typeof node !== 'object') return node;
  if (seen.has(node as object)) return node;
  seen.add(node as object);

  // BAI-SEO-003-S3 (2026-07-18): also accept @type as array (e.g.
  // `["Organization", "LocalBusiness"]` — the merged form used in some
  // legacy migrated JSON files). The previous implementation only
  // matched string @type, so merged Organization+LocalBusiness nodes
  // escaped the filter and produced duplicate @id=#organization in
  // the merged @graph.
  const isFoundationNode = (n: unknown): boolean => {
    if (!n || typeof n !== 'object') return false;
    const t = (n as Record<string, unknown>)['@type'];
    if (typeof t === 'string') return t === 'FAQPage' || FOUNDATION_TYPES_CITY.has(t) || MIGRATED_SERVICE_TYPES_DROP.has(t);
    if (Array.isArray(t)) return t.some((x) => typeof x === 'string' && (x === 'FAQPage' || FOUNDATION_TYPES_CITY.has(x) || MIGRATED_SERVICE_TYPES_DROP.has(x)));
    return false;
  };

  if (Array.isArray(node)) {
    return node
      .filter((child) => !isFoundationNode(child))
      .map((child) => stripFoundationTypesFromMigrated(child, seen));
  }

  const obj = node as Record<string, unknown>;
  const next: Record<string, unknown> = {};
  for (const [key, value] of Object.entries(obj)) {
    if (key === '@type') {
      if (typeof value === 'string' && (value === 'FAQPage' || FOUNDATION_TYPES_CITY.has(value) || MIGRATED_SERVICE_TYPES_DROP.has(value))) continue;
      if (Array.isArray(value) && value.some((x) => typeof x === 'string' && (x === 'FAQPage' || FOUNDATION_TYPES_CITY.has(x) || MIGRATED_SERVICE_TYPES_DROP.has(x)))) continue;
    }
    if (key === 'sameAs' && Array.isArray(value)) {
      next[key] = value.filter((entry) => entry !== 'https://github.com/YEEEAE/BRIGHTAI');
      continue;
    }
    next[key] = stripFoundationTypesFromMigrated(value, seen);
  }
  return next;
}

const migratedJsonLdSanitised = migratedPage?.jsonLd
  ? (Array.isArray(migratedPage.jsonLd)
      ? migratedPage.jsonLd.map((entry) => stripFoundationTypesFromMigrated(entry))
      : stripFoundationTypesFromMigrated(migratedPage.jsonLd))
  : null;

const finalJsonLd = migratedJsonLdSanitised
  ? locFaqLd
    ? [...(Array.isArray(migratedJsonLdSanitised) ? migratedJsonLdSanitised : [migratedJsonLdSanitised]), locFaqLd]
    : (migratedJsonLdSanitised as unknown as typeof jsonLd)
  : locFaqLd
    ? { '@context': 'https://schema.org', '@graph': [...jsonLd['@graph'], locFaqLd] }
    : jsonLd;

// BAI-SEO-003-S6 (2026-07-18): answer-first summary is now UNIQUE
// per city + sector, sourced from `loc.answerFirst` (≤60 Saudi-dialect
// words). Replaces the previous generic 26-word paragraph that was
// identical for every city with only the city name substituted. The
// block is emitted in BOTH branches (migrated and non-migrated) so
// every city page has a unique answer-first, and is wired into the
// WebPage SpeakableSpecification selector so AI voice / TTS engines
// can quote it. If `loc.answerFirst` is missing we fall back to a
// very short honest statement rather than fabricating content.
const locAnswerFirst = loc.answerFirst
  ?? `حوكمة AI في ${loc.cityAr} لقطاع ${sector.chip}: توثيق وضوابط قابلة للتدقيق متوافقة مع الجهات السعودية. أداة تشغيلية لا تستبدل التقييم النظامي.`;
---
<ArabicLayout title={migratedPage?.title ?? loc.title} description={migratedPage?.description ?? loc.description} canonical={migratedPage?.canonical ?? loc.canonical} hreflang={migratedPage?.hreflang ?? [{lang:'ar-SA',href:loc.canonical},{lang:'x-default',href:loc.canonical}]} jsonLd={(finalJsonLd as any)} currentPath={loc.href} ogImage="/assets/images/og/og-solutions.webp" ogImageAlt={migratedPage?.title ?? loc.title} extraSpeakableSelectors={['.answer-first-summary']} breadcrumbs={crumbs.slice(1).map(c => ({ name: c.label, href: c.href }))} omitLocalBusiness={!isHQ}>
{migratedPage ? (
  <>
    {!/<h1\b/i.test(migratedPage.html) && <h1 class="sr-only">{loc.h1}</h1>}
    {/* BAI-SEO-003-S6 (2026-07-18): answer-first rendered as the
        first intro paragraph before the migrated content. Not a new
        <section> — a single <p> carrying the unique city+sector
        answer. The migrated HTML below it is unchanged. */}
    <p class="answer-first-summary" data-speakable-target="answer-first">{locAnswerFirst}</p>
    {sector.slug === 'banking-ai-governance' && loc.slug === 'riyadh' && <section class="inner-section" aria-labelledby="riyadh-source-title"><div class="max-w-6xl mx-auto px-5 lg:px-8"><p class="inner-section__label">المصدر الرسمي · آخر تحديث: 2026-08-24</p><h2 id="riyadh-source-title">السياق المصرفي يحدد الضابط؛ لا يكفي اسم الإطار</h2><p><a href="https://www.sama.gov.sa/" target="_blank" rel="noopener noreferrer">البنك المركزي السعودي (SAMA)</a> هو المرجع الأول لسياق القطاع المالي. <strong>متطلب أو إرشاد رسمي:</strong> راجع النصوص الرسمية وفرق البنك لتحديد ما ينطبق. <strong>منهج BrightAI للتنفيذ:</strong> نربط الاستخدام وحدود البيانات والموافقة البشرية والدليل في مسار مراجعة؛ مو اعتماد من SAMA أو ضمان امتثال.</p><table><caption>مصفوفة قرار مصرفية أولية</caption><thead><tr><th>السؤال</th><th>المخرج</th></tr></thead><tbody><tr><td>هل يمس بيانات عميل؟</td><td>فحص وتنقية أو حجب.</td></tr><tr><td>هل يؤثر في قرار عالي الأثر؟</td><td>مراجعة بشرية ودليل.</td></tr></tbody></table></div></section>}
    <main class="migrated-legacy-content" set:html={DOMPurify.sanitize(migratedPage.html)} />
  </>
) : (
<>
<section class="inner-hero" aria-label={loc.h1}>
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="inner-hero__badge"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-map-marker-radius"></use></svg> {loc.cityAr} — {sector.chip}</div>
    <h1>{loc.h1}</h1>
    {/* BAI-SEO-003-S6 (2026-07-18): answer-first always rendered —
        `locAnswerFirst` is now sourced from `loc.answerFirst`
        (unique per city + sector, ≤60 Saudi-dialect words) and is
        no longer conditional on `loc.faqs`. Wired into the WebPage
        SpeakableSpecification selector at the layout level. */}
    <p class="answer-first-summary" data-speakable-target="answer-first">{locAnswerFirst}</p>
    <p class="inner-hero__desc">{loc.description}</p>
    <div class="inner-hero__actions">
      <div class="cta-actions">
        <a href="/contact/" class="glow-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold" data-cta="hero_cta_click" data-cta-label="اطلب عرض توضيحي مخصص" data-position="inline" data-page-type="unknown" data-offer="assessment"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-calendar-check"></use></svg> اطلب عرض توضيحي مخصص</a>
        <small class="cta-micro" aria-hidden="true">30 دقيقة • نطاق + SLA + milestones</small>
      </div>
      <div class="cta-actions">
        <a href={`https://wa.me/966538229013?text=${whatsappMsg}`} target="_blank" rel="noopener noreferrer" class="btn--whatsapp inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-whatsapp"></use></svg> تواصل عبر واتساب</a>
        <small class="cta-micro" aria-hidden="true">رد سريع • يردّك مهندس سعودي</small>
      </div>
    </div>
  </div>
</section>

<section class="inner-section inner-section--alt" aria-labelledby="local-context">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="local-context" class="inner-section__title"><svg class="text-cyan-300" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-city"></use></svg> خدمات حوكمة الذكاء الاصطناعي في {loc.cityAr}</h2>
    <div class="inner-card p-8">
      <p class="inner-card__text text-base leading-loose">{loc.localContext ?? `${sector.shortDesc} نقدم خدماتنا محلياً في ${loc.cityAr} مع دعم فني ميداني وتكامل مع الأنظمة المحلية. هذا الحل يدعم جاهزية مؤسستك للضوابط التنظيمية السعودية وليس استشارة قانونية.`}</p>
    </div>
  </div>
</section>

<section class="inner-section" aria-labelledby="solutions-local">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="solutions-local" class="inner-section__title"><svg class="text-cyan-300" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-puzzle"></use></svg> حلول BrightAI المتاحة في {loc.cityAr}</h2>
    <div class="inner-grid inner-grid--2">
      {relatedSols.map((sol: any) => (
        <a href={sol!.href} class="inner-card p-6 text-decoration-reset">
          <div class="flex items-center gap-3 mb-3">
            <div class="text-2xl"><Icon name={sol!.icon} class="text-cyan-300" /></div>
            <h3 class="inner-card__title text-base">{sol!.h1.split('(')[0].trim()}</h3>
          </div>
          <p class="inner-card__text text-sm">{sol!.shortDesc}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<a href={sector.href} class="block inner-section inner-section--alt text-decoration-reset" aria-labelledby="parent-sector">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="inner-card p-8 flex items-center gap-4">
      <div class="text-4xl"><Icon name={sector.icon} class="text-cyan-300" /></div>
      <div>
        <h2 id="parent-sector" class="inner-card__title text-lg">الصفحة الرئيسية: {sector.h1}</h2>
        <p class="inner-card__text text-sm mt-1">اطّلع على التفاصيل الكاملة لحوكمة الذكاء الاصطناعي في {sector.chip} ←</p>
      </div>
    </div>
  </div>
</a>

<RelatedLinks relatedSlugs={sector.related} sectorSlugs={sectors.filter(s => s.slug !== sector.slug).map(s => s.slug)} docs={sector.docs} blog={sector.blog} />

{/* BAI-VOC-001-B (2026-07-18): city-level FAQ section, only rendered
    when the city carries its own FAQs (khobar / madinah / mecca). The
    same array drives the JSON-LD FAQPage above — single source of
    truth, zero drift between visible UI and structured data. */}
{loc.faqs && loc.faqs.length > 0 && (
  <section class="inner-section" aria-labelledby="city-faqs">
    <div class="max-w-4xl mx-auto px-5 lg:px-8">
      <div class="section__header section__header--start">
        <span class="section__eyebrow" lang="en">FAQ</span>
        <h2 id="city-faqs" class="section__title section__title--start">أسئلة تدور في ذهنك عن {loc.cityAr}؟</h2>
      </div>
      <div class="inner-faq">
        {loc.faqs.map((faq: any) => (
          <details>
            <summary>{faq.question}</summary>
            <div class="inner-faq__answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<section class="inner-cta-final">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="inner-cta-final__card">
      <h2 class="inner-cta-final__title">ابدأ بحوكمة الذكاء الاصطناعي في {loc.cityAr} الآن</h2>
      <p class="inner-cta-final__desc">فريقنا في {loc.cityAr} جاهز لمساعدتك. تواصل معنا للحصول على عرض توضيحي مخصص.</p>
      <div class="inner-hero__actions inner-hero__actions--centered">
        <div class="cta-actions">
          <a href="/contact/" class="glow-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold" data-cta="hero_cta_click" data-cta-label="اطلب عرض توضيحي مخصص" data-position="inline" data-page-type="unknown" data-offer="assessment"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-calendar-check"></use></svg> اطلب عرض توضيحي مخصص</a>
          <small class="cta-micro" aria-hidden="true">30 دقيقة • نطاق + SLA + milestones</small>
        </div>
<div class="cta-actions">
<a href={`https://wa.me/966538229013?text=${whatsappMsg}`} target="_blank" rel="noopener noreferrer" class="btn--whatsapp inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-whatsapp"></use></svg> تواصل عبر واتساب</a>
  <small class="cta-micro" aria-hidden="true">رد سريع • يردّك مهندس سعودي</small>
</div>
      </div>
    </div>
  </div>
</section>

{/* Scroll Reveal: centralized in BaseLayout.astro (DEC-015). */}
</>
)}

{/* ═══════════════ BACK TO SOLUTIONS (BAI-LINK-01) ═══════════════ */}
<div style="display: flex; justify-content: center; margin-block: 2rem; padding: 0 1.5rem;">
  <a href="/solutions/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white border border-white/20 hover:border-cyan-500/40 transition-all">
    <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-arrow-right"></use></svg>
    العودة إلى جميع الحلول
  </a>
</div>

</ArabicLayout>
