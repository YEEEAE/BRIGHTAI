/**
 * BAI-SEO-003-S3 (2026-07-18): the legacy migrated JSON-LD for /solutions/*
 * pages contains Organization / WebSite / LocalBusiness / WebPage /
 * BreadcrumbList nodes that DUPLICATE the foundation Schema.astro
 * emission. Without stripping them, the merged @graph would carry
 * `https://brightai.live/#organization` 2-3× per page (verified via
 * scripts/_check-duplicate-schema-ids.mjs). This helper mirrors the
 * stripping used in /solutions/[sector].astro and /solutions/[sector]/[city].astro.
 */
const FOUNDATION_TYPES_SLUG = new Set(['Organization', 'WebSite', 'LocalBusiness', 'WebPage', 'BreadcrumbList']);

function stripFoundationTypesFromMigratedSlug(
  node: unknown,
  seen: WeakSet<object> = new WeakSet(),
): unknown {
  if (!node || typeof node !== 'object') return node;
  if (seen.has(node as object)) return node;
  seen.add(node as object);

  if (Array.isArray(node)) {
    return node
      .filter((child) => {
        if (!child || typeof child !== 'object') return true;
        const t = (child as Record<string, unknown>)['@type'];
        if (Array.isArray(t) && t.some((x) => FOUNDATION_TYPES_SLUG.has(String(x)))) return false;
        if (typeof t === 'string' && FOUNDATION_TYPES_SLUG.has(t)) return false;
        return true;
      })
      .map((child) => stripFoundationTypesFromMigratedSlug(child, seen));
  }

  const obj = node as Record<string, unknown>;
  const next: Record<string, unknown> = {};
  for (const [key, value] of Object.entries(obj)) {
    if (key === '@type') {
      if (typeof value === 'string' && FOUNDATION_TYPES_SLUG.has(value)) continue;
      if (Array.isArray(value) && value.some((x) => FOUNDATION_TYPES_SLUG.has(String(x)))) continue;
    }
    if (key === 'sameAs' && Array.isArray(value)) {
      next[key] = value.filter((entry) => entry !== 'https://github.com/YEEEAE/BRIGHTAI');
      continue;
    }
    next[key] = stripFoundationTypesFromMigratedSlug(value, seen);
  }
  return next;
}

