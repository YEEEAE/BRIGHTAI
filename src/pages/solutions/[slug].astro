  { label: 'الامتثال والتدقيق الداخلي', text: 'يصل إلى قصة موحدة عن المالك والمخاطر والضابط والدليل، بدل جمعها من ملفات متفرقة.' },
  { label: 'مالك المنتج أو العملية', text: 'يستخدم AI بسرعة داخل حدود واضحة، ويعرف متى يطلب موافقة ومتى يكمل التشغيل.' },
];
const governanceSectors = [
  { title: 'البنوك والخدمات المالية', text: 'مراجعة استخدام AI في الائتمان وخدمة العملاء وكشف الاحتيال مع فصل القرار الحساس عن المرور العادي.' },
  { title: 'الرعاية الصحية', text: 'تتبع استخدامات AI التي تلامس بيانات المرضى أو تؤثر على مسار الخدمة، مع إبقاء المسؤولية البشرية واضحة.' },
  { title: 'الجهات الحكومية', text: 'جرد الاستخدامات وربطها بالسياسات والضوابط الوطنية وسجل مراجعة قابل للتقديم حسب نطاق الجهة.' },
  { title: 'الطاقة والصناعة والتقنية', text: 'ضبط Copilot والنماذج الداخلية والخدمات الخارجية مع حماية الملكية الفكرية وبيانات العملاء.' },
];
const governanceLinks = [
  { href: '/assessment/ai-governance-readiness/', label: 'تقييم جاهزية حوكمة AI', type: 'primary' },
  { href: '/docs/ai-governance-platform/', label: 'اقرأ الدليل التشغيلي', type: 'secondary' },
];
const firewallCapabilities = [
  { label: 'PROMPTS', title: 'يفحص الطلب قبل ما يكمل', text: 'يمرر الطلب عبر نقطة التكامل ويفحص النص أو الحقول التي تدخل في مسار AI حسب الإعدادات المطبقة.' },
  { label: 'SENSITIVE DATA', title: 'يحدد أنماط PII المدعومة', text: 'الكاشفات الحالية تشمل الهوية، الإقامة، IBAN، الجوال، البريد، العنوان الوطني، السجل التجاري، التواريخ، البطاقات/الحسابات، MRN، وبيانات الاعتماد عندما تطابق القواعد.' },
  { label: 'POLICY', title: 'يطبق قرار السياسة', text: 'النتيجة ممكن تكون سماح، تنقية/استبدال، حجب، أو رفع الحالة للمراجعة — القرار يعتمد على السياسة والتكامل.' },
  { label: 'MODEL / ROUTE', title: 'يخلي الوجهة والموديل ضمن النقاش', text: 'المزود أو الموديل والوجهة جزء من إعداد المسار. تقدر تعرّفها في سياستك، لكن خطورة كل مزود أو موديل تحتاج تقييماً منفصلاً.' },
  { label: 'RESPONSES', title: 'فحص الردود مو افتراض تلقائي', text: 'التحقق الموثق هنا يركز على النص الداخل قبل النموذج. فحص المخرج نفسه يتحدد بحسب التكامل والسياسة المفعلة، وما نعدّيه مغطى تلقائياً.' },
  { label: 'EVIDENCE', title: 'يسجل القرار وسياقه التشغيلي', text: 'يحفظ معلومات الحدث والقرار غير الحساسة للمراجعة، بينما يبقى تصميم الاحتفاظ والوصول مسؤولية المؤسسة.' },
];
const firewallFlow = [
  { step: '01', label: 'INPUT', title: 'Prompt أو طلب AI', text: 'موظف، تطبيق، أو مسار chat يرسل طلباً يحتاج نموذجاً.' },
  { step: '02', label: 'INSPECT', title: 'كشف وفحص', text: 'تُطبّق الكاشفات والسياسات على المحتوى والبيانات الموجودة في المسار.' },
  { step: '03', label: 'DECIDE', title: 'قرار قابل للتفسير', text: 'سماح، تنقية، حجب، أو إشارة لمراجعة بحسب القاعدة.' },
  { step: '04', label: 'OUTPUT / EVIDENCE', title: 'المخرج وسياق القرار', text: 'يمر الطلب المسموح أو المنقى لمساره، ويرجع المخرج حسب مزود النموذج. يُحفظ سياق الفحص والقرار للمراجعة؛ فحص المخرج يعتمد على التكامل.' },
];
const firewallPolicies = [
  { state: 'REDACT', tone: 'teal', title: 'بيانات هوية داخل prompt', rule: 'إذا طابق الطلب نمط هوية أو جوال أو بريد', action: 'استبدل القيمة بـ placeholder قبل وصولها للمسار التالي.' },
  { state: 'BLOCK', tone: 'red', title: 'طلب يخالف سياسة البيانات', rule: 'إذا كانت القناة أو البيانات غير مسموحة في سياسة المؤسسة', action: 'أوقف الطلب وأظهر سبب القرار للمستخدم.' },
  { state: 'FLAG', tone: 'amber', title: 'حالة تحتاج نظر بشري', rule: 'إذا تجاوزت الحالة مستوى الخطر أو احتاجت استثناء', action: 'ارفعها للمراجعة بدل تمريرها بصمت.' },
  { state: 'LOG', tone: 'blue', title: 'حدث يحتاج دليل', rule: 'في كل قرار حماية أو استثناء', action: 'سجّل الحدث والقرار والوقت والسياق غير الحساس.' },
];
const firewallNetworkRows = [
  ['يفهم', 'محتوى prompt وإشارات البيانات داخل تفاعل AI', 'IP، منافذ، بروتوكولات، وقواعد مرور الشبكة'],
  ['يتدخل عند', 'حدود تفاعل المستخدم مع النموذج أو الخدمة', 'حدود الشبكة والاتصال بين الأنظمة'],
  ['قراره', 'تنقية، حجب، سماح، أو إشارة لمراجعة حسب السياسة', 'سماح أو منع الاتصال غالباً'],
  ['يكمل ماذا؟', 'سياسة استخدام AI وسياق القرار والدليل', 'حماية مسار الاتصال والبنية التحتية'],
];
const firewallDlpRows = [
  ['النطاق', 'مركز على تفاعل AI: prompt، مخرج، ونقطة النموذج', 'أوسع: بريد، ملفات، أجهزة، قنوات، وتدفقات بيانات'],
  ['التميّز', 'يربط الفحص بسياق النموذج والطلب والسياسة', 'يركز على اكتشاف ونقل البيانات عبر قنوات متعددة'],
  ['العلاقة', 'طبقة متخصصة تكمل DLP في مسار AI', 'ضابط مؤسسي أوسع لا يغني وحده عن فحص تفاعل AI'],
];
---
<ArabicLayout
  title={isAiFirewall ? solution.title : migratedPage?.title ?? solution.title}
  description={isAiFirewall ? solution.description : migratedPage?.description ?? solution.description}
  canonical={migratedPage?.canonical ?? solution.canonical}
  hreflang={migratedPage?.hreflang ?? [{lang:'ar-SA',href:solution.canonical},{lang:'x-default',href:solution.canonical}]}
  jsonLd={isAiFirewall ? (jsonLd as any) : migratedPage?.jsonLd ? { '@context': 'https://schema.org', '@graph': [...(Array.isArray(migratedPage.jsonLd) ? migratedPage.jsonLd : [migratedPage.jsonLd]).map((entry) => stripFoundationTypesFromMigratedSlug(entry))] } : (jsonLd as any)}
  currentPath={solution.href}
  ogImage="/assets/images/og/og-solutions.webp"
  ogImageAlt={isAiFirewall ? solution.title : migratedPage?.title ?? solution.title}
  breadcrumbs={crumbs.slice(1).map(c => ({ name: c.label, href: c.href }))}
>
{!solution.content ? (
  /* legacy migrated fallback — only لو ما في content data */
  <main class="migrated-legacy-content" set:html={DOMPurify.sanitize(migratedHtml)} />
) : (
  isAiFirewall ? (
    <main class="ai-firewall-page">
      <section class="ai-firewall-hero" aria-labelledby="ai-firewall-title">
        <div class="ai-firewall-shell ai-firewall-hero__grid">
          <div class="ai-firewall-hero__copy">
            <p class="ai-firewall-kicker"><span aria-hidden="true"></span> AI SECURITY CONTROL LAYER</p>
            <h1 id="ai-firewall-title">{solution.h1}</h1>
            <p class="ai-firewall-answer"><strong>وش هو AI Firewall؟</strong> هو جدار حماية للذكاء الاصطناعي وطبقة تحكم تُسمى أيضاً LLM Firewall، وتمرر طلبات AI المهيأة عبر فحص وسياسة قبل ما تكمل للنموذج. يكتشف أنماط بيانات حساسة مدعومة، وينقّيها أو يحجب الطلب حسب السياسة، مع تسجيل سياق القرار. فحص الردود وخطورة كل وجهة أو موديل يعتمد على التكامل المفعّل، مو افتراض تلقائي.</p>
            <div class="ai-firewall-actions">
              <a class="ai-firewall-button ai-firewall-button--primary" href="/contact/" data-cta="ai_firewall_demo_click" data-cta-label="اطلب جلسة تصميم ضوابط" data-position="hero" data-page-type="solution">اطلب جلسة تصميم ضوابط <span aria-hidden="true">←</span></a>
              <a class="ai-firewall-button ai-firewall-button--secondary" href="/docs/ai-firewall/">شوف الدليل التقني</a>
            </div>
            <p class="ai-firewall-microcopy">مصمم لفرق الأمن والبيانات والامتثال — يساعدك تقلل المخاطر، مو وعد بمنع كل شيء.</p>
          </div>
          <figure class="ai-firewall-console" aria-labelledby="ai-firewall-console-caption">
            <div class="ai-firewall-console__bar"><span><i aria-hidden="true"></i> CONTROL PLANE / AI FIREWALL</span><b>POLICY ACTIVE</b></div>
            <div class="ai-firewall-console__prompt"><small>INCOMING PROMPT</small><p>لخّص طلب العميل <em>[PERSON_NAME]</em> ورقم الحساب <em>[ACCOUNT_ID]</em></p></div>
            <div class="ai-firewall-console__scan"><span>INSPECTION</span><strong>2 matches</strong><b>PII pattern detected</b></div>
            <div class="ai-firewall-console__decision"><span>DECISION</span><strong>REDACT → ALLOW</strong><small>event_id: fw_••••• · evidence retained</small></div>
            <figcaption id="ai-firewall-console-caption">مثال توضيحي لمسار تنقية: القيم الفعلية ما تظهر في الطلب اللي يكمل للنموذج.</figcaption>
          </figure>
        </div>
      </section>

      <section class="ai-firewall-signal-strip" aria-label="سطح تحكم AI Firewall">
        <div class="ai-firewall-shell"><span>يركز على</span><b>Prompts</b><b>Responses</b><b>Sensitive data</b><b>Policy decisions</b><b>Destinations</b><b>Evidence</b></div>
      </section>

      <section class="ai-firewall-section ai-firewall-section--soft" aria-labelledby="ai-firewall-source-title"><div class="ai-firewall-shell"><p class="ai-firewall-eyebrow">المصدر الرسمي · آخر تحديث: 2026-09-03</p><h2 id="ai-firewall-source-title">افصل متطلبات الجهة عن طريقة تطبيق الضابط</h2><p><a href="https://nca.gov.sa/en/regulatory-documents/controls-list/ecc/" target="_blank" rel="noopener noreferrer">ضوابط NCA ECC</a> مرجع أمني رسمي بحسب نطاق الجهة. <strong>متطلب أو إرشاد رسمي:</strong> راجع النص والجهة المختصة لتحديد ما ينطبق. <strong>منهج BrightAI للتنفيذ:</strong> AI Firewall نقطة تحكم لفحص التفاعلات في التكاملات المفعّلة وتوثيق القرار؛ ليست شهادة امتثال أو ضمانًا لمنع كل تسريب.</p></div></section>

      <section class="ai-firewall-section" aria-labelledby="ai-firewall-capabilities">
        <div class="ai-firewall-shell">
          <div class="ai-firewall-section__heading"><p class="ai-firewall-eyebrow">وش يشوف ووش يسوي؟</p><h2 id="ai-firewall-capabilities">نقطة تحكم واضحة بين بياناتك والنموذج</h2><p>القيمة مو في كلمة “Firewall” لحالها. القيمة إن فريقك يعرف وش دخل المسار، وش القرار اللي صار، ووش الدليل اللي بقى.</p></div>
          <div class="ai-firewall-capability-grid">{firewallCapabilities.map((item, index) => <article class="ai-firewall-card"><span class="ai-firewall-card__index">0{index + 1}</span><span class="ai-firewall-card__label">{item.label}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
        </div>
      </section>

      <section class="ai-firewall-section ai-firewall-section--dark" aria-labelledby="ai-firewall-flow-title">
        <div class="ai-firewall-shell">
          <div class="ai-firewall-section__heading"><p class="ai-firewall-eyebrow">من الطلب إلى الدليل</p><h2 id="ai-firewall-flow-title">Input → inspection → decision → output/evidence</h2><p>هذا هو المسار التشغيلي المختصر. التطبيق الفعلي يتغير حسب نقطة التكامل والسياسات والكاشفات المفعلة عندك.</p></div>
          <ol id="ai-firewall-flow" class="ai-firewall-flow">{firewallFlow.map((item, index) => <li><span class="ai-firewall-flow__number">{item.step}</span><span class="ai-firewall-flow__label">{item.label}</span><h3>{item.title}</h3><p>{item.text}</p>{index < firewallFlow.length - 1 && <span class="ai-firewall-flow__arrow" aria-hidden="true">←</span>}</li>)}</ol>
        </div>
      </section>

      <section class="ai-firewall-section ai-firewall-section--soft" aria-labelledby="ai-firewall-policy-title">
        <div class="ai-firewall-shell">
          <div class="ai-firewall-section__heading"><p class="ai-firewall-eyebrow">سياسات قابلة للتشغيل</p><h2 id="ai-firewall-policy-title">أمثلة على القرار — مو شعارات عامة</h2><p>كل بطاقة تمثل نمط قرار تحتاج فرق الأمن والبيانات تعريفه واعتماده في بيئتها.</p></div>
          <div class="ai-firewall-policy-grid">{firewallPolicies.map(policy => <article class={`ai-firewall-policy ai-firewall-policy--${policy.tone}`}><span>{policy.state}</span><h3>{policy.title}</h3><p><b>إذا:</b> {policy.rule}</p><p><b>الإجراء:</b> {policy.action}</p></article>)}</div>
        </div>
      </section>

      <section id="ai-firewall-scenario" class="ai-firewall-section" aria-labelledby="ai-firewall-scenario-title">
        <div class="ai-firewall-shell ai-firewall-scenario">
          <div class="ai-firewall-section__heading"><p class="ai-firewall-eyebrow">سيناريو قبل / بعد</p><h2 id="ai-firewall-scenario-title">من طلب عشوائي إلى مسار قابل للمراجعة</h2><p>خذ مثال فريق خدمة عملاء يستخدم نموذجاً خارجياً لتلخيص شكوى. الحماية هنا تضبط المسار، لكنها ما تلغي مسؤولية اختيار الأداة والسياسة المناسبة.</p></div>
          <div class="ai-firewall-before-after"><article><span>قبل</span><h3>النص يطلع كما هو</h3><p>موظف يلصق اسم العميل ورقم جواله وتفاصيل الشكوى في prompt. ما فيه نقطة مركزية توضّح وش خرج أو ليه.</p></article><div aria-hidden="true">→</div><article><span>بعد</span><h3>تنقية + قرار + أثر</h3><p>المسار يطابق الأنماط المدعومة، يستبدل المعرفات، يطبق القرار، ويحفظ حدثاً يقدر فريق الأمن يرجع له.</p></article></div>
        </div>
      </section>

      <section class="ai-firewall-section ai-firewall-section--dark" aria-labelledby="ai-firewall-vs-network-firewall">
        <div class="ai-firewall-shell">
          <div class="ai-firewall-section__heading"><p class="ai-firewall-eyebrow">لا تخلط الطبقات</p><h2 id="ai-firewall-vs-network-firewall">AI Firewall vs traditional firewall</h2><p>الجدار التقليدي يحمي الاتصال والبنية التحتية. AI Firewall يضيف طبقة تفهم تفاعل AI والبيانات اللي داخله.</p></div>
          <div class="ai-firewall-table-wrap"><table class="ai-firewall-table"><thead><tr><th>السؤال</th><th>AI Firewall</th><th>Traditional firewall</th></tr></thead><tbody>{firewallNetworkRows.map(row => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>
        </div>
      </section>

      <section class="ai-firewall-section ai-firewall-section--soft" aria-labelledby="ai-firewall-vs-dlp">
        <div class="ai-firewall-shell">
          <div class="ai-firewall-section__heading"><p class="ai-firewall-eyebrow">AI Firewall vs DLP</p><h2 id="ai-firewall-vs-dlp">مو بديل عن DLP — طبقة متخصصة تكمله</h2><p>DLP يغطي حركة البيانات عبر المؤسسة. AI Firewall يركز على معنى وسياق تفاعل AI. الاثنين ممكن يشتغلون مع بعض، وكل واحد له نطاقه.</p></div>
          <div class="ai-firewall-table-wrap"><table class="ai-firewall-table ai-firewall-table--light"><thead><tr><th>المحور</th><th>AI Firewall</th><th>DLP</th></tr></thead><tbody>{firewallDlpRows.map(row => <tr>{row.map((cell, index) => index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>
        </div>
      </section>

      <section class="ai-firewall-section" aria-labelledby="ai-firewall-alignment-title">
        <div class="ai-firewall-shell ai-firewall-alignment"><div><p class="ai-firewall-eyebrow">جاهزية مسؤولة</p><h2 id="ai-firewall-alignment-title">يدعم تطبيق السياسات — ما يعطيك شهادة جاهزة</h2><p>تقدر تستخدم طبقة التحكم كجزء من تنفيذ متطلبات حماية البيانات والتسجيل وإدارة المخاطر المرتبطة بـ PDPL وNCA، ومع سياق مبادئ SDAIA. لكن مو كل بيئة مثل الثانية: لازم فريقك يراجع نطاق البيانات، الوجهات، النماذج، الصلاحيات، والاحتفاظ مع المستشار القانوني والجهة المختصة.</p></div><a class="ai-firewall-text-link" href="/assessment/ai-governance-readiness/">قيّم جاهزية الضوابط عندك <span aria-hidden="true">←</span></a></div>
      </section>

      <section class="ai-firewall-faq" aria-labelledby="ai-firewall-faq-title"><div class="ai-firewall-shell ai-firewall-shell--narrow"><p class="ai-firewall-eyebrow">أسئلة قبل الشراء</p><h2 id="ai-firewall-faq-title">وش يحتاج يعرفه فريق الأمن؟</h2><div class="ai-firewall-faq__list">{firewallFaqs.map(faq => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></div></section>

      <RelatedLinks relatedSlugs={solution.related} sectorSlugs={relSectors.map(s=>s.slug)} docs={solution.docs} blog={solution.blog} kernel={solution.kernel} />
      <section class="ai-firewall-final" aria-labelledby="ai-firewall-final-title"><div class="ai-firewall-shell ai-firewall-final__inner"><p class="ai-firewall-eyebrow">الخطوة الجاية</p><h2 id="ai-firewall-final-title">اعرف وين تحتاج أول نقطة تحكم</h2><p>في جلسة مخصصة، نراجع حالة استخدام واحدة، نوع البيانات، الوجهة، ومسار القرار — ونطلع بنطاق ضوابط واقعي قابل للتنفيذ.</p><a class="ai-firewall-button ai-firewall-button--primary" href="/contact/" data-cta="ai_firewall_contact_click" data-cta-label="اطلب جلسة تصميم ضوابط" data-position="final" data-page-type="solution">اطلب جلسة تصميم ضوابط <span aria-hidden="true">←</span></a></div></section>
    </main>
  ) : isGovernancePlatform ? (
    <main class="governance-page">
      <section class="governance-hero" aria-labelledby="governance-title">
        <div class="governance-shell governance-hero__grid">
          <div class="governance-hero__copy">
            <p class="governance-kicker"><span class="governance-kicker__mark" aria-hidden="true"></span> AI governance operating layer</p>
            <h1 id="governance-title">{solution.h1}</h1>
            <p class="governance-hero__value">خلّ كل استخدام AI يمر من سياسة واضحة إلى قرار قابل للتنفيذ ودليل قابل للمراجعة.</p>
            <p class="governance-hero__desc">{solution.shortDesc} تشبك الموظف ونظام AI والبيانات والسياسة والموافقة والدليل في مسار واحد.</p>
            <div class="governance-hero__actions">
              <a class="governance-button governance-button--primary" href={governanceLinks[0].href} data-cta="governance_readiness_click" data-cta-label={governanceLinks[0].label} data-position="hero" data-page-type="solution">
                {governanceLinks[0].label}<span aria-hidden="true">←</span>
              </a>
