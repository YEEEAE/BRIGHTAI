    </div>
  </section>
)}

{/* ─── Section 9 · مقالات ذات صلة (BAI-LINK-05) ──────────────────── */}
{(() => {
  const blogSlugs = getRelatedBlogSlugs(solution.slug);
  if (blogSlugs.length === 0) return null;
  const blogLinks = blogSlugs.map((bSlug) => {
    const label = bSlug
      .replace(/-/g, ' ');
    return { href: `/blog/${bSlug}/`, label };
  });
  return (
    <section class="inner-section" aria-labelledby="related-blog-posts">
      <div class="max-w-7xl mx-auto px-5 lg:px-8">
        <h2 id="related-blog-posts" class="inner-section__title">مقالات ذات صلة</h2>
