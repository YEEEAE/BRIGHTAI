<!-- BAI-VOC-001-C (2026-07-18): توحيد CTAs في final CTA — "ابدأ التجربة المجانية" → "ابدأ تجربة Kernel المجانية" + microcopy. "احجز ديمو مخصص" → "احجز ديمو مخصص 30 دقيقة" + microcopy. href (/kernel/ + /contact/) لم يتغير. -->
---
/**
 * /solutions/ — Hub page (REPORT-10 redesign)
 *
 * Sections (all 9 products + 4 sectors preserved verbatim):
 *   1. Inner hero              — pattern background + brand badge
 *   2. الإجابة المختصرة         — gradient-border featured card with icon
 *   3. كيف يشتغلون مع بعض      — horizontal flow steps (4 stages)
 *   4. الحلول كلها             — 3-col grid (9 SolutionCard components)
 *   5. الحلول القطاعية          — 2-col grid (4 SectorCard components)
 *   6. أي حل يناسبني؟          — scenario cards (decision tree visual)
 *   7. كيف تختار الحل         — narrative (preserved)
 *   8. CTA النهائي             — gradient banner
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import BackgroundGrid from '../../components/BackgroundGrid.astro';
import SolutionCard from '../../components/SolutionCard.astro';
import SectorCard from '../../components/SectorCard.astro';
import { solutions, sectors } from '../../data/solutions';

// BAI-SEO-003-S3 (2026-07-18): WebPage and BreadcrumbList are emitted
// by the foundation Schema.astro. The solutions index page has no
// page-specific schema nodes — every entity (Organization, WebSite,
// BreadcrumbList, WebPage) is owned by the foundation.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": []
};
---
<ArabicLayout title="حلول حوكمة AI | AI Firewall + سجل تدقيق + ملف أدلة" description="كل حلول BrightAI التقنية لحوكمة AI بالسعودية في مكان واحد: AI Firewall، سجل التدقيق، الموافقات البشرية، ملف الأدلة، وأنظمة الحوكمة المتوافقة مع PDPL وNCA. اكتشف الحل المناسب لجهتك." canonical="https://brightai.site/solutions/" hreflang={[{lang:'ar-SA',href:'https://brightai.site/solutions/'},{lang:'x-default',href:'https://brightai.site/solutions/'}]} jsonLd={jsonLd as any} currentPath="/solutions/" breadcrumbs={[{ name: 'الحلول التقنية', href: '/solutions/' }]}>

{/* ─── Section 1 · Hero ─────────────────────────────────────────────────────── */}
<section class="inner-hero bg-ambient-teal-top" aria-label="حلول BrightAI">
  <BackgroundGrid />
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <span class="inner-hero__badge"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-wrench"></use></svg> مركز محتوى تقني · Solutions Hub</span>
    <h1>حلول <span class="gradient-text">حوكمة وأمان</span> الذكاء الاصطناعي</h1>
    <p class="inner-hero__desc">كل حلول BrightAI التقنية في صفحة واحدة. اشرحنا لك كل حل بالتفصيل: متى تحتاجه، كيف يشتغل، وش الفايدة اللي يجيبها لشركتك. مرجعك السريع لاختيار الحل المناسب.</p>
  </div>
</section>

{/* ─── Section 2 · الإجابة المختصرة — featured gradient-border card ──────── */}
<section class="inner-section inner-section--alt" aria-labelledby="quick-answer">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="section__header section__header--start">
      <span class="section__eyebrow" lang="en">الإجابة المختصرة</span>
      <h2 id="quick-answer" class="section__title section__title--start">
        <svg class="inline-block align-middle me-2 text-amber-300" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-lightning-bolt"></use></svg>
        الإجابة المختصرة
      </h2>
    </div>

    <div class="gradient-border-card">
      <div class="gradient-border-card__icon" aria-hidden="true">
        <svg width="24" height="24"><use href="/icons.svg#mdi-shield-heart"></use></svg>
      </div>
      <h3 class="gradient-border-card__title">كيف تشتغل الحلول مع بعض؟</h3>
      <p class="gradient-border-card__body">
        BrightAI تقدم حلول تقنية وقطاعية مترابطة، كل واحد يحل مشكلة محددة في رحلة استخدام AI. الفكرة بسيطة: <strong>AI Firewall</strong> يحمي البيانات قبل ما توصل للنموذج، <strong>Audit Trail</strong> يوثّق كل شي، <strong>Human Approval</strong> يوقف القرارات الخطرة، و<strong>Evidence File</strong> يعطيك ملف جاهز للمدقق. والصفحات القطاعية تربط نفس الضوابط بسياق المستشفيات والبنوك والجهات الحكومية والمصانع. كلهم يشتغلون سوا تحت <strong>BrightAI Kernel</strong>.
      </p>
    </div>
  </div>
</section>

{/* ─── Section 3 · كيف يشتغلون مع بعض — flow steps timeline ─────────────── */}
<section class="inner-section" aria-labelledby="how-together">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="section__header section__header--start">
      <span class="section__eyebrow" lang="en">How it works together</span>
      <h2 id="how-together" class="section__title section__title--start">كيف يشتغلون مع بعض؟</h2>
      <p class="section__subtitle section__subtitle--start">رحلة طلب AI واحد داخل شركتك مع BrightAI — من كتابة الطلب حتى ملف التدقيق.</p>
    </div>

    <ol class="flow-steps" aria-label="رحلة طلب AI">
      <li class="flow-step">
        <div class="flow-step__number" aria-hidden="true">١</div>
        <h3 class="flow-step__title">الموظف يكتب طلب</h3>
        <p class="flow-step__desc">طلب AI عادي من شات أو نظام داخلي.</p>
      </li>
      <li class="flow-step">
        <div class="flow-step__number" aria-hidden="true">٢</div>
        <h3 class="flow-step__title">AI Firewall يفحص</h3>
        <p class="flow-step__desc">يخفي البيانات الحساسة قبل ما تطلع برا.</p>
      </li>
      <li class="flow-step">
        <div class="flow-step__number" aria-hidden="true">٣</div>
        <h3 class="flow-step__title">Audit Trail يسجل</h3>
        <p class="flow-step__desc">كل حركة محفوظة بهاش غير قابل للتعديل.</p>
      </li>
      <li class="flow-step">
        <div class="flow-step__number" aria-hidden="true">٤</div>
        <h3 class="flow-step__title">Evidence File يصدر</h3>
        <p class="flow-step__desc">PDF موقّع جاهز للمدقق.</p>
      </li>
    </ol>
  </div>
</section>

{/* ─── Section 4 · الحلول كلها (3-col grid · SolutionCard) ──────────────── */}
<section class="inner-section inner-section--alt" aria-labelledby="all-solutions">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="section__header section__header--start">
      <span class="section__eyebrow" lang="en">{solutions.length} Products</span>
      <h2 id="all-solutions" class="section__title section__title--start">الحلول كلها</h2>
      <p class="section__subtitle section__subtitle--start">كل حل يغطي طبقة معيّنة في رحلة حوكمة AI — من رصد Shadow AI إلى ملف التدقيق.</p>
    </div>
    <div class="inner-grid inner-grid--3">
      {solutions.map(s => <SolutionCard solution={s} />)}
    </div>
  </div>
</section>

{/* ─── Section 5 · الحلول القطاعية (2-col grid · SectorCard) ────────────── */}
<section class="inner-section" aria-labelledby="sector-solutions">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="section__header section__header--start">
      <span class="section__eyebrow" lang="en">{sectors.length} Sectors</span>
      <h2 id="sector-solutions" class="section__title section__title--start">الحلول القطاعية</h2>
      <p class="section__subtitle section__subtitle--start">ضوابط حوكمة AI مطبّقة على سياق كل قطاع: بنوك، جهات حكومية، صحة، صناعة.</p>
    </div>
    <div class="inner-grid inner-grid--2">
      {sectors.map(s => <SectorCard sector={s} />)}
    </div>
  </div>
</section>

{/* ─── Section 6 · أي حل يناسبني؟ — scenario cards (decision tree visual) ── */}
<section class="inner-section inner-section--alt" aria-labelledby="guide-title">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="section__header section__header--start">
      <span class="section__eyebrow" lang="en">Decision Tree</span>
      <h2 id="guide-title" class="section__title section__title--start">أي حل يناسبني؟ دليل سريع</h2>
      <p class="section__subtitle section__subtitle--start">اختر السيناريو الأقرب لواقعك، وستجد التوصية مع روابط مباشرة لكل منتج.</p>
    </div>

    <div class="scenario-grid">

      <article class="scenario-card">
        <span class="scenario-card__question">
          <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-office-building"></use></svg>
          شركة صغيرة
        </span>
        <h3 class="scenario-card__answer">ابدأ بـ <strong>AI Firewall</strong> + <strong>Audit Trail</strong></h3>
        <p class="scenario-card__detail">إذا استخدام AI عندك أساسي وتبي حماية البيانات + توثيق بدون مشروع كبير.</p>
        <div class="scenario-card__links">
          <a href="/solutions/ai-firewall/">AI Firewall</a>
          <a href="/solutions/ai-audit-trail/">Audit Trail</a>
        </div>
      </article>

      <article class="scenario-card">
        <span class="scenario-card__question">
          <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-domain"></use></svg>
          شركة متوسطة
        </span>
        <h3 class="scenario-card__answer"><strong>منصة الحوكمة</strong> + الموافقة البشرية</h3>
        <p class="scenario-card__detail">إذا عندك حالات استخدام متعددة، تحتاج رؤية موحّدة وقرارات بشرية للحالات الحساسة.</p>
        <div class="scenario-card__links">
          <a href="/solutions/ai-governance-platform/">منصة الحوكمة</a>
          <a href="/solutions/human-approval-layer/">الموافقة البشرية</a>
        </div>
      </article>

      <article class="scenario-card">
        <span class="scenario-card__question">
          <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-shield-check"></use></svg>
          جهة حكومية / طبية
        </span>
        <h3 class="scenario-card__answer">الحزمة <strong>الكاملة</strong> + Evidence File</h3>
        <p class="scenario-card__detail">تدقيق NCA / SDAIA قادم. تحتاج كل الأدلة موقّعة ومُرتّبة في ملف جاهز.</p>
        <div class="scenario-card__links">
          <a href="/solutions/ai-evidence-file/">Evidence File</a>
          <a href="/hub/compliance/">حزم الامتثال</a>
        </div>
      </article>

      <article class="scenario-card">
        <span class="scenario-card__question">
          <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-help-circle"></use></svg>
          مو متأكد
        </span>
        <h3 class="scenario-card__answer">ابدأ بـ <strong>اكتشاف الاستخدامات</strong></h3>
        <p class="scenario-card__detail">ما عندك صورة كاملة عن استخدامات AI؟ نبدأ بالتقييم ثم نبني الباقي على الاحتياج الفعلي.</p>
        <div class="scenario-card__links">
          <a href="/solutions/ai-use-case-discovery/">اكتشاف الاستخدامات</a>
          <a href="/solutions/ai-risk-classification/">تصنيف المخاطر</a>
        </div>
      </article>

    </div>
  </div>
</section>

{/* ─── Section 7 · كيف تختار الحل (narrative · preserved verbatim) ────── */}
<section class="inner-section" aria-labelledby="solution-choice-detail">
  <div class="max-w-4xl mx-auto px-5 lg:px-8">
    <h2 id="solution-choice-detail" class="inner-section__title">كيف تختار الحل بدون ما تبدأ بمشروع أكبر من حاجتك؟</h2>
    <p class="inner-section__lead">ابدأ من الخطر التشغيلي، مو من اسم التقنية. إذا المشكلة هي خروج بيانات حساسة إلى نموذج غير مصرح به، الأولوية تكون لـ <a href="/solutions/ai-firewall/">AI Firewall</a>. إذا البيانات تحت السيطرة لكن ما تقدر تشرح من استخدم النموذج وش صار بعد النتيجة، تحتاج <a href="/solutions/ai-audit-trail/">AI Audit Trail</a>. وإذا النتيجة قد تؤثر على عميل أو مريض أو موظف أو قرار مالي، أضف <a href="/solutions/human-approval-layer/">طبقة الموافقة البشرية</a> قبل التنفيذ.</p>
    <p class="inner-section__lead">المؤسسات اللي عندها أكثر من إدارة أو أكثر من نموذج تحتاج غالبًا طبقة تجمع الملكية والسياسات والمخاطر في مكان واحد، وهنا تبدأ قيمة <a href="/solutions/ai-governance-platform/">منصة حوكمة الذكاء الاصطناعي</a>. أما إذا ما عندك صورة واضحة للاستخدامات الحالية، فلا تبدأ بسياسات كثيرة؛ ابدأ بـ <a href="/solutions/ai-use-case-discovery/">اكتشاف حالات استخدام AI</a> ثم صنفها عبر <a href="/solutions/ai-risk-classification/">تصنيف المخاطر</a>.</p>
    <p class="inner-section__lead">القطاع يغيّر شكل الضوابط المطلوبة. الجهات الحكومية تحتاج مسارًا يراعي بيانات المستفيدين والسياسات والمساءلة؛ المصانع تحتاج ربط التوصيات بالجودة والأصول وسلامة التشغيل؛ المستشفيات تحتاج فصلًا واضحًا بين المساعدة الإدارية والقرار السريري؛ والبنوك تحتاج أثرًا تدقيقيًا للقرارات والبيانات المالية. لذلك راجع صفحات <a href="/solutions/government-ai-governance/">الحكومة</a> و<a href="/solutions/manufacturing-ai-governance/">التصنيع</a> و<a href="/solutions/healthcare-ai-governance/">الصحة</a> و<a href="/solutions/banking-ai-governance/">القطاع المالي</a> قبل تحديد نطاق التنفيذ.</p>
    <p class="inner-section__lead">مخرج الاختيار الصحيح لازم يكون واضحًا: حالة استخدام محددة، مالك مسؤول، بيانات معروفة، مستوى خطر، ضابط قابل للاختبار، ودليل يثبت وش صار. إذا ما قدرت تربط الحل بهذي العناصر، ارجع خطوة وابدأ بالتقييم بدل شراء مكونات متفرقة.</p>
    <p class="inner-section__lead">للمقارنة المنظمة بين المكونات، افتح <a href="/hub/solutions/">مركز الحلول</a>. وللبدء من العملية التجارية بدل اسم المنتج، استخدم <a href="/hub/use-cases/">مركز حالات الاستخدام</a> عشان تربط كل سيناريو بالسياسة والموافقة والدليل المناسب.</p>
  </div>
</section>

{/* ─── Section 8 · CTA النهائي ───────────────────────────────────────────── */}
<section class="inner-cta-final">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="inner-cta-final__card">
      <h2 class="inner-cta-final__title">جرّب BrightAI Kernel مجاناً</h2>
      <p class="inner-cta-final__desc">تجربة تفاعلية كاملة لكل الحلول، بدون التزام. شوف كيف يشتغلون مع بعض على بيانات تجريبية.</p>
      <div class="inner-hero__actions inner-hero__actions--centered">
        <div class="cta-actions">
          <a href="/kernel/" class="glow-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold" data-cta="hero_cta_click" data-cta-label="ابدأ تجربة Kernel المجانية" data-position="inline" data-page-type="solutions"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-gauge"></use></svg> ابدأ تجربة Kernel المجانية</a>
          <small class="cta-micro" aria-hidden="true">8 دقائق • بدون تسجيل • Sandbox معزول</small>
        </div>
        <div class="cta-actions">
          <a href="/contact/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white border border-white/20" data-cta="secondary_cta_click" data-cta-label="احجز ديمو مخصص 30 دقيقة" data-position="inline" data-page-type="solutions" data-offer="assessment"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-calendar-check"></use></svg> احجز ديمو مخصص 30 دقيقة</a>
          <small class="cta-micro" aria-hidden="true">بدون التزام • سرية بياناتك مضمونة</small>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ═══════════════ BACK TO HOME + RELATED (BAI-LINK-01) ═══════════════ */}
<section class="inner-section" aria-labelledby="solutions-back-home">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div style="display: flex; justify-content: center; margin-bottom: 2rem;">
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white border border-white/20 hover:border-cyan-500/40 transition-all">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-arrow-right"></use></svg>
        العودة إلى الرئيسية
      </a>
    </div>
  </div>
</section>

<section class="inner-section inner-section--alt" aria-labelledby="solutions-related">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="section__header section__header--start">
      <h2 id="solutions-related" class="section__title section__title--start">محتويات ذات صلة</h2>
      <p class="section__subtitle section__subtitle--start">استكشف مقالاتنا ووثائقنا لتعميق فهمك لحوكمة الذكاء الاصطناعي.</p>
    </div>
    <div class="inner-grid inner-grid--2">
      <a href="/blog/" class="card card--feature rounded-2xl p-7 flex flex-col justify-between hover:border-cyan-500/40 transition-all">
        <div>
          <span class="w-12 h-12 rounded-xl glow-btn flex items-center justify-center text-xl font-bold mb-4"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-newspaper"></use></svg></span>
          <h3 class="text-xl font-bold mb-2">المدونة</h3>
          <p class="text-white/70 leading-loose text-sm">مقالات تنفيذية عن حوكمة AI وPDPL وNCA ECC وسدايا وISO 42001 وAI Firewall، مخصصة للسوق السعودي.</p>
        </div>
      </a>
      <a href="/docs/" class="card card--feature rounded-2xl p-7 flex flex-col justify-between hover:border-cyan-500/40 transition-all">
        <div>
          <span class="w-12 h-12 rounded-xl glow-btn flex items-center justify-center text-xl font-bold mb-4"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-book"></use></svg></span>
          <h3 class="text-xl font-bold mb-2">الوثائق</h3>
          <p class="text-white/70 leading-loose text-sm">أكثر من ٣٠ وثيقة شاملة تغطي الحوكمة، الامتثال، إدارة المخاطر، والتطبيق التقني.</p>
        </div>
      </a>
    </div>
  </div>
</section>

{/* Scroll Reveal: centralized in BaseLayout.astro (DEC-015). */}
</ArabicLayout>
