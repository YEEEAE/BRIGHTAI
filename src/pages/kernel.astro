---
import PageShell from '../components/PageShell.astro';
import WorkspaceNavigation from '../components/WorkspaceNavigation.astro';
import ScenarioContext from '../components/ScenarioContext.astro';
import '../styles/experience-hub.css';
export const prerender = true;
---
<PageShell crumbs={[{name:"Kernel"}]} title="Kernel | مسار السياسة إلى الدليل — BRIGHTAI" description="مختبر حوكمة عام: اختر أصلًا وسياسة افتراضية، وتتبع القرار والمراجعة والدليل دون بيانات مؤسسة.">
<section id="lab" class="kernel-lab" data-kernel-demo>
  <aside class="kernel-nav"><p class="eyebrow">AIGAS / CONTROL CENTER</p><WorkspaceNavigation current="kernel"/><p>Kernel بنية مشتركة لا تُفوتر منفصلًا.</p><p>مختبر ضيف مجهول · بيانات اصطناعية فقط.</p></aside>
  <div class="kernel-main"><header><p class="eyebrow">سياسة واحدة. أثر مفهوم.</p><h1>من السياسة<br/>إلى الدليل.</h1><p>اختر أصلًا خياليًا، واتبع أثر السياسة على الطلب. كل ما هنا محاكاة محلية؛ لا اتصال بمؤسسة أو نموذج.</p></header>
    <ScenarioContext next="firewall"/>
    <div class="kernel-workspace"><div>
      <form data-kernel-form><h2>01 / حدّد سياق الطلب</h2><label for="kernel-asset">الأصل الاصطناعي</label><select id="kernel-asset" name="asset"><option value="summary">مساعد تلخيص افتراضي</option><option value="publication">مساعد نشر افتراضي</option></select><label for="kernel-policy">سياسة المثال</label><select id="kernel-policy" name="policy"><option value="redact">تنقيح المعرّف الخيالي</option><option value="review">مراجعة النشر</option><option value="deny">منع المشاركة الخارجية</option></select><p>طلب ثابت: لخّص مادة خيالية تحمل [معرّف خيالي] للنشر.</p><button type="submit">طبّق سياسة المثال ←</button></form>
      <section aria-labelledby="flow-title"><h2 id="flow-title">02 / مسار القرار</h2><ol class="kernel-flow" data-kernel-flow><li>السياسة ← فحص Firewall ← المراجعة عند الحاجة ← دليل محلي</li></ol></section>
      <section data-kernel-review hidden><h2>03 / مراجعة مستقلة افتراضية</h2><p>مقدم الطلب: دور خيالي أ · المراجع: دور خيالي ب. اختيارك يحاكي المراجع ولا يمنحك أي صلاحية.</p><button type="button" data-review="approved">محاكاة موافقة محددة</button><button type="button" data-review="rejected">محاكاة رفض مسبب</button></section>
    </div><aside class="kernel-inspector"><p class="eyebrow">INSPECTOR / دليل المثال</p><h2>لماذا هذا القرار؟</h2><div role="status" aria-live="polite" aria-atomic="true"><strong data-kernel-decision>بانتظار تطبيق السياسة</strong><p data-kernel-reason>اختر سياسة ثم شغّل المثال.</p></div><dl><dt>نسخة السياسة</dt><dd>demo-v1</dd><dt>طبيعة الدليل</dt><dd>اصطناعي · ليس سجل Tenant أو توقيعًا مشفرًا</dd><dt>التنفيذ التشغيلي</dt><dd>لا يوجد</dd></dl><pre data-kernel-evidence hidden tabindex="0" aria-label="دليل السيناريو الاصطناعي"></pre><a href="/products/firewall/#lab">جرب المنتج التالي ←</a><a href="/auth/sign-up/?returnTo=%2Fapp%2Ffirewall%2F">ابدأ 48 ساعة ↗</a><p>التشغيل يتطلب حسابًا وعضوية وصلاحيات وتهيئة واعتمادًا من الخادم. يبدأ العداد عند التفعيل فقط؛ لا شراء أو تحويل تلقائي. أدوار OWNER / ADMIN / MEMBER لا تمنح Operator authority.</p></aside></div>
    <button type="button" data-kernel-reset>إعادة ضبط الرحلة</button><p data-kernel-storage></p>
    <noscript>يلزم JavaScript لتشغيل المسار. مثال ثابت: سياسة التنقيح ← REDACT ← استبدال المعرّف ← دليل اصطناعي demo-v1. روابط المختبرات متاحة دون تسجيل.</noscript>
  </div>
</section>
</PageShell>
<script src="../scripts/kernel-demo.ts"></script>
<style>
.kernel-lab{display:grid;grid-template-columns:210px minmax(0,1fr);border:1px solid var(--border-strong);border-radius:16px;overflow:hidden;background:var(--surface-sunken)}.kernel-nav{padding:24px 16px;border-inline-end:1px solid var(--border-subtle)}.kernel-nav p{font-size:13px;color:var(--color-text-muted)}.kernel-main{min-width:0;padding:clamp(18px,3vw,40px)}header{margin-bottom:24px}h1{font-size:clamp(36px,5vw,64px);line-height:1.2;margin:16px 0}h2{font-size:20px;margin:0 0 20px}.kernel-workspace{display:grid;grid-template-columns:minmax(0,1fr) minmax(230px,.8fr);gap:24px;margin:28px 0}.kernel-workspace section,form,.kernel-inspector{border:1px solid var(--border-strong);padding:24px;border-radius:12px;background:var(--surface-raised);margin-bottom:20px;min-width:0}label{display:block;margin-block:16px 8px}select{width:100%;padding:12px;background:var(--surface-sunken);color:var(--color-text);font:inherit;border:1px solid var(--border-strong);border-radius:8px}button{font:inherit;padding:12px 16px;min-height:48px;background:var(--surface-raised-hover);color:var(--color-text);border:1px solid var(--icon-accent);border-radius:8px;cursor:pointer;margin:6px}button:focus-visible,select:focus-visible,a:focus-visible,pre:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}.kernel-inspector strong{color:var(--color-focus);font-size:24px}.kernel-inspector p,dt,.kernel-flow{font-size:14px;color:var(--color-text-muted)}dd{margin:4px 0 18px;font-size:14px}.kernel-inspector a{display:flex;align-items:center;min-height:48px;color:var(--color-focus)}pre{white-space:pre-wrap;overflow-wrap:anywhere;direction:ltr;text-align:left;font-size:12px}.kernel-flow{padding-inline-start:24px}.kernel-flow li{padding:12px 0;border-bottom:1px solid var(--border-subtle)}[hidden]{display:none!important}@media(max-width:1100px){.kernel-workspace{grid-template-columns:1fr}}@media(max-width:999px){.kernel-lab{grid-template-columns:1fr}.kernel-nav{border-inline-end:0;border-bottom:1px solid var(--border-subtle)}.kernel-nav>p{margin:8px}.kernel-workspace section,form,.kernel-inspector{padding:18px}}
</style>
