---
/**
 * Thank-You Page — /thank-you/
 * Post-lead-submit confirmation. Includes conditional conversion-pixel hooks
 * (HubSpot / Bing UET / Mixpanel) so ad platforms can attribute conversions.
 *
 * CRO audit 2026-07-18 (Prompt 4): when the URL carries a `?id=<lead_id>`
 * (set by the LeadForm success handler), the page acknowledges the
 * specific submission. Without it, the page still works for users who
 * arrived via the no-JS native POST fallback (formsubmit.co redirects
 * here with no query string).
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import BackgroundGrid from '../../components/BackgroundGrid.astro';

const nextSteps = [
  {
    icon: 'mdi-email-fast',
    title: 'تأكيد الإرسال',
    body: 'لو ما وصلك إيميل تأكيد، تفقد مجلد السبام أو ارجع للنموذج وأعد الإرسال.',
  },
  {
    icon: 'mdi-clock-fast',
    title: 'الرد خلال 24 ساعة',
    body: 'فريق الحوكمة بيراجع طلبك ويرد عليك على نفس وسيلة التواصل اللي ذكرتها.',
  },
  {
    icon: 'mdi-file-document-outline',
    title: 'حضّر قبل الاتصال',
    body: 'لو تبي تسرّع الاجتماع، جهّز: عدد الفرق اللي تستخدم AI، نوع البيانات الحساسة، وأي ضوابط معتمدة عندكم.',
  },
];
---

<ArabicLayout
  title="شكراً لتواصلك معنا | BrightAI"
  description="وصل طلبك لـ BrightAI بنجاح. فريق الحوكمة والامتثال لدينا سيتواصل معك خلال 24 ساعة لمناقشة احتياجات مؤسستك من PDPL وNCA وحلول حوكمة الذكاء الاصطناعي في السعودية."
  canonical="https://brightai.site/thank-you/"
  currentPath="/thank-you/"
  robots="noindex, follow"
>

  <section class="page-hero page-hero--centered" aria-label="تأكيد الاستلام">
    <BackgroundGrid />
    <div class="max-w-3xl mx-auto px-5 lg:px-8">
      <div class="inner-hero__badge inner-hero__badge--centered">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-check-circle"></use></svg>
        وصلنا طلبك
      </div>
      <h1 class="page-hero__title"><span class="gradient-text">شكراً لك</span></h1>
      <p class="page-hero__description">تواصلنا وصلنا بنجاح. فريق BrightAI للحوكمة والامتثال بيرد عليك خلال ٢٤ ساعة على نفس وسيلة التواصل اللي ذكرتها.</p>
      <p class="page-hero__description" data-thank-you-id hidden>رقم الطلب: <code data-thank-you-id-value></code></p>
      <div class="about-hero__actions about-hero__actions--centered">
        <a href="/" class="btn btn--glow">العودة للرئيسية</a>
        <a href="/solutions/ai-governance-platform/" class="btn btn--whatsapp">استكشف الحلول</a>
      </div>
    </div>
  </section>

  <section class="inner-section" aria-labelledby="thank-you-next-steps">
    <div class="max-w-5xl mx-auto px-5 lg:px-8">
      <h2 id="thank-you-next-steps" class="inner-section__title inner-section__title--centered">وش يصير الحين؟</h2>
      <div class="grid grid--3">
        {nextSteps.map((s) => (
          <article class="card card--feature">
            <div class="avatar-tile avatar-tile--sm avatar-tile--gradient" aria-hidden="true">
              <svg class="avatar-tile__icon avatar-tile__icon--white" aria-hidden="true" width="1.5rem" height="1.5rem"><use href={`/icons.svg#${s.icon}`} /></svg>
            </div>
            <h3 class="inner-card__title mt-3">{s.title}</h3>
            <p class="inner-card__text">{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- BAI-SEC-18 (2026-07-25): inline script moved to public/js/thank-you-id.js
       to enable strict-CSP (no 'unsafe-inline' on script-src). -->
  <script type="module" src="/js/thank-you-id.js"></script>
</ArabicLayout>

<style>
  .mt-3 { margin-block-start: var(--space-3); }
  [data-thank-you-id] {
    margin-block-start: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  [data-thank-you-id] code {
    font-family: var(--font-mono, monospace);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
    font-size: 0.95em;
    color: var(--brand-300);
  }
</style>
