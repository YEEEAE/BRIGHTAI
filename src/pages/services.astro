---
import ContentExtension from '../components/ContentExtension.astro';
import PageShell from '../components/PageShell.astro';
import { organization } from '../data/organization';
export const prerender = true;
const workshop = {
  '@type': 'Service',
  '@id': 'https://brightai.live/services/#workshop',
  url: 'https://brightai.live/services/#workshop',
  name: 'ورشة الرد على شكاوى العملاء بالذكاء الاصطناعي',
  description: 'ورشة عربية عن بُعد لفريق خدمة العملاء، تتناول تنقيح الشكوى وصياغة الرد ومراجعته وفق سياسة المنشأة.',
  provider: { '@id': organization['@id'] },
};
---
<PageShell title="ورشة شكاوى العملاء وخدمات حوكمة الذكاء الاصطناعي | BRIGHTAI" description="اطّلع على عينة من ورشة عربية عن بُعد لفريق خدمة العملاء: تنقيح الشكوى وصياغة الرد ومراجعته. استفسر أيضًا عن سياسة استخدام الذكاء الاصطناعي وتقييم المخاطر." crumbs={[{ name: 'الخدمات' }]} structuredData={workshop}>
  <p class="eyebrow">الدعم والنطاق</p><h1>ورش وخدمات حوكمة الذكاء الاصطناعي</h1>
  <p class="lead">اختر ورشة لفريق خدمة العملاء، أو ناقش احتياج منشأتك إلى سياسة استخدام أو تقييم مخاطر. نحدد معك المخرجات والسعر والموعد قبل الاتفاق.</p>
  <section id="workshop" class="card workshop" aria-labelledby="workshop-title">
    <h2 id="workshop-title">ورشة الرد على شكاوى العملاء بالذكاء الاصطناعي</h2>
    <p><strong>٩٠ دقيقة عن بُعد</strong> لفريق خدمة عملاء واحد. يتدرّب الفريق على تنقيح الشكوى، وصياغة رد بالعربية، ومراجعته وفق سياسة المنشأة قبل الإرسال.</p>
    <h3>ما يستلمه فريقك</h3>
    <ul class="list">
      <li>قالب قابل للتحرير لتنقيح الشكوى وصياغة الرد.</li>
      <li>قائمة فحص وسجل قرار للمشرف لتوثيق الاعتماد أو التعديل أو التصعيد.</li>
      <li>مثال محلول من التمرين يوضح الرد وسبب قرار المشرف.</li>
    </ul>
    <a class="button" href="/contact/#workshop">استفسر عن ورشة لفريقي</a>
    <p class="note">نراجع النطاق والسعر وموعد الجلسة معك قبل الاتفاق.</p>
    <section class="workshop-sample" aria-labelledby="workshop-sample-title">
      <h3 id="workshop-sample-title">كيف يراجع المشرف ردًا على طلب استرجاع؟</h3>
      <dl>
        <dt>الشكوى بعد التنقيح</dt><dd>تأخرت الشحنة يومين، وهي قيد النقل. يطلب العميل الإلغاء والاسترجاع.</dd>
        <dt>مسودة الرد</dt><dd>نعتذر عن التأخير. بنتحقق مع الناقل من إمكانية إيقاف التسليم، وبنوضح لك خطوة الاسترجاع المتاحة بعد التحقق.</dd>
        <dt>قرار المشرف وسببه</dt><dd>يعتمد الرد ويحيل طلب الإيقاف إلى فريق الشحن. يبقى الاسترجاع معلّقًا حتى يؤكد الناقل إيقاف التسليم أو عودة الشحنة.</dd>
      </dl>
      <a class="ghost" href="/products/firewall/complaint/">جرّب مراجعة شكوى تأخر الشحنة في المختبر ←</a>
    </section>
  </section>
  <section class="block"><h2>موضوعات للاستفسار</h2><ul class="list"><li>تحديد حالة استخدام ومخاطرها الأولية.</li><li>إعداد مسودة سياسة داخلية تحتاج اعتماد الجهة.</li><li>فهم متطلبات توثيق الاستخدام والضوابط.</li><li>الاستفسار عن التصور المستهدف لمنتجات AIGAS.</li></ul><p>هذه أمثلة لموضوعات نقاش وليست قائمة خدمات متعاقد عليها. يتحدد أي نطاق عمل وسعر ومسؤولية واتفاق بعد مراجعة مكتوبة.</p><a class="button" href="/contact/">جهّز استفسارك واختر قناة التواصل</a></section>

    <ContentExtension>

<section><h2>حوّل الاستفسار إلى نطاق قابل للمراجعة</h2><ol class="extension-path"><li><strong>المشكلة:</strong> هل تحتاج سياسة موظفين، أو مراجعة مخاطر، أو فهماً لمسار قرار؟ اختر غرضاً محدداً.</li><li><strong>المخرج المطلوب:</strong> ورقة عمل أو مسودة سياسة أو مادة تدريب تحتاج اعتماد الجهة؛ حدّد من يراجعها.</li><li><strong>حدود المسؤولية:</strong> اتفق على النطاق والبيانات والمدخلات وما يحتاج مختصاً قانونياً أو أمنياً مستقلاً.</li></ol><p>هذه طريقة لتجهيز النقاش، وليست تعهداً بتقديم خدمة متاحة أو تسليم في موعد محدد. التدريب والاستشارات في Blueprint خدمات مساندة للمنتجات المتخصصة.</p></section>
<section><h2>ابدأ بمواد متاحة للقراءة</h2><p>يمكن لفريقك قراءة <a href="/knowledge/ai-use-policy-employees/">دليل سياسة استخدام AI للموظفين</a> و<a href="/knowledge/ai-risk-assessment/">ورقة عمل المخاطر</a> قبل مناقشة نطاق مؤسسي. صف الاحتياج بصورة عامة عبر <a href="/contact/">صفحة التواصل</a>؛ لا ترسل ملفات عملاء أو بيانات حساسة.</p></section>
    </ContentExtension>
</PageShell>
<style>
  .workshop { scroll-margin-block-start: 6rem; }
  .workshop .button { min-block-size: 48px; }
  .workshop-sample { margin-block-start: 1.5rem; padding-inline-start: 1rem; border-inline-start: 2px solid var(--border-strong); }
  .workshop-sample dl { margin-block-end: 0; }
  .workshop-sample dt { font-weight: 600; }
  .workshop-sample dd { margin: .25rem 0 1rem; }
  .workshop-sample dd:last-child { margin-block-end: 0; }
</style>
