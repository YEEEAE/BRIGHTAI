---
import PageShell from '../components/PageShell.astro';
export const prerender = true;
const services = [
  { id: 'readiness-scan', name: 'فحص الجاهزية السريع', dur: 'أسبوعان', price: '18,000 ر.س', text: 'نحصر استخدامات الذكاء الاصطناعي لديكم، ونحدد الفجوات الأهم مقارنةً بمبادئ سدايا ونظام حماية البيانات الشخصية، ونسلمكم خارطة طريق مرتبة حسب الأولوية.', out: ['حصر الأدوات والاستخدامات', 'تقرير فجوات مختصر', 'خارطة طريق 90 يوماً'], note: 'يُخصم كامل المبلغ إذا تعاقدتم على التقييم الشامل خلال 60 يوماً.' },
  { id: 'compliance-assessment', name: 'تقييم الامتثال الشامل', dur: '4–8 أسابيع', price: '65,000–120,000 ر.س', text: 'تقييم معمّق لأنظمة الذكاء الاصطناعي مقابل مبادئ سدايا ونظام حماية البيانات الشخصية وضوابط الهيئة الوطنية للأمن السيبراني.', out: ['مصفوفة امتثال لكل نظام', 'تقييم أثر على الخصوصية', 'خطة معالجة بالمسؤوليات والمدد'], note: 'النطاق القياسي يشمل حتى 3 أنظمة.' },
  { id: 'iso-42001', name: 'التهيئة لشهادة ISO/IEC 42001', dur: '3–6 أشهر', price: '90,000–220,000 ر.س', text: 'نبني معكم نظام إدارة الذكاء الاصطناعي حسب المعيار الدولي: السياسات، وتقييم المخاطر، والأدوار، والتدقيق الداخلي، حتى تكونوا جاهزين للتدقيق الخارجي.', out: ['نظام إدارة موثق', 'سجل مخاطر وضوابط', 'تدقيق داخلي قبل الشهادة'], note: 'رسوم جهة منح الشهادة غير مشمولة.' },
  { id: 'ai-red-teaming', name: 'اختبار الاختراق للذكاء الاصطناعي (Red Teaming)', dur: '2–3 أسابيع', price: 'من 45,000 ر.س لكل نظام', text: 'نختبر أنظمتكم ضد حقن التعليمات وتسريب البيانات وتجاوز الضوابط والمخرجات الضارة، ونسلمكم النتائج مرتبة حسب الخطورة.', out: ['تقرير ثغرات مصنف', 'توصيات معالجة', 'إعادة اختبار واحدة'], note: 'يُنفذ حصراً على أنظمة العميل وبتفويض كتابي.' },
  { id: 'bias-impact-assessment', name: 'تقييم الانحياز والأثر', dur: '3–4 أسابيع', price: 'من 55,000 ر.س لكل نظام', text: 'نقيس هل يعامل النظام الفئات المختلفة بإنصاف، حسب الجنس والعمر والجنسية والمنطقة، ونبين أثر ذلك على القرارات.', out: ['مقاييس إنصاف موثقة', 'تحليل الأسباب', 'خطة تخفيف'], note: 'نستخدم إخفاء الهوية بطريقة تحفظ القدرة على اكتشاف الانحياز.' },
  { id: 'model-registry', name: 'سجل النماذج وتتبع النسب', dur: '3 أسابيع', price: 'من 40,000 ر.س', text: 'نحصر كل نماذج الذكاء الاصطناعي لديكم: مصدرها، وبيانات تدريبها، ومالكها، ومستوى مخاطرها، وإصداراتها.', out: ['سجل نماذج مركزي', 'بطاقة لكل نموذج', 'ربط مع AIGAS Ledger'], note: '' },
  { id: 'responsible-ai-policy', name: 'سياسة الاستخدام المسؤول', dur: 'أسبوع', price: 'من 12,000 ر.س', text: 'سياسة واضحة بالعربية لموظفيكم: ما المسموح، وما الممنوع، ومن يوافق، وكيف يُبلَّغ عن المشكلات.', out: ['وثيقة السياسة', 'ملخص من صفحة واحدة للموظفين', 'نموذج إقرار'], note: 'ننصح بمراجعتها قانونياً قبل الاعتماد.' },
  { id: 'managed-governance-office', name: 'مكتب الحوكمة المُدار', dur: 'اشتراك شهري (12 شهراً حد أدنى)', price: '25,000 ر.س (أساسي) / 60,000 ر.س (متقدم) شهرياً', text: 'فريقنا يعمل كمكتب حوكمة ذكاء اصطناعي لديكم: مراجعات دورية، ومتابعة السجلات، وتحديث السياسات، وتقارير للإدارة العليا.', out: ['تقرير شهري للإدارة', 'مراجعة ربعية للمخاطر', 'المتقدم: تقييم الأنظمة الجديدة واختبار اختراق سنوي'], note: '' },
];
const training = [
  ['ورشة القيادات', 'يوم واحد', '15,000 ر.س للمجموعة (حتى 12)'],
  ['مسؤول حوكمة الذكاء الاصطناعي', '3 أيام', '6,500 ر.س للمتدرب، أو 45,000 ر.س للمجموعة (حتى 15)'],
  ['التطوير الآمن لتطبيقات الذكاء الاصطناعي', 'يومان', '4,500 ر.س للمتدرب'],
  ['توعية الموظفين', 'ساعتان عن بُعد', '150 ر.س للموظف (حد أدنى 50 موظفاً)'],
];
const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem', position: index + 1,
    item: {
      '@type': 'Service', name: service.name, description: service.text,
      url: `https://brightai.live/services/#${service.id}`,
      provider: { '@type': 'Organization', name: 'BRIGHTAI', url: 'https://brightai.live/' },
      areaServed: { '@type': 'Country', name: 'Saudi Arabia' },
    },
  })),
};
---
<PageShell title="خدمات حوكمة الذكاء الاصطناعي — BRIGHTAI" description="فحص جاهزية، تقييم امتثال، تهيئة ISO 42001، اختبار اختراق للذكاء الاصطناعي، تقييم انحياز، ومكتب حوكمة مُدار." crumbs={[{ name: 'الخدمات' }]}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <p class="eyebrow">الخدمات / الاستشارات والتدريب</p>
  <h1>المنصة تحمي.<br /><span class="muted">والخبرة تبني الحوكمة.</span></h1>
  <p class="lead">الأداة وحدها لا تصنع حوكمة. تحتاج أيضاً سياسات وأدواراً وتقييمات. نقدّم ذلك بأسعار ومدد معلنة.</p>
  <div class="grid">{services.map(s => <article class="card" id={s.id}>
    <h3>{s.name}</h3><span class="tag">{s.dur}</span><span class="price" style="font-size:24px">{s.price}</span>
    <p>{s.text}</p><ul>{s.out.map(o => <li>{o}</li>)}</ul>{s.note && <span class="note" style="margin:0">{s.note}</span>}
    <a class="ghost" href={`/contact/?topic=${encodeURIComponent(s.name)}`}>اطلب الخدمة <span aria-hidden="true">←</span></a>
  </article>)}</div>
  <section class="block"><h2>التدريب</h2>
    <div class="table-wrap"><table><thead><tr><th>البرنامج</th><th>المدة</th><th>السعر</th></tr></thead><tbody>{training.map(([a, b, c]) => <tr><td>{a}</td><td>{b}</td><td>{c}</td></tr>)}</tbody></table></div>
    <p class="note">جميع الأسعار بالريال ولا تشمل ضريبة القيمة المضافة 15%. التدريب الحضوري خارج الرياض تُضاف إليه تكاليف السفر.</p>
  </section>
</PageShell>
