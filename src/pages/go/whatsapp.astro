---
/**
 * /go/whatsapp/ — internal WhatsApp redirect hub (noindex utility page).
 *
 * WHATSAPP-HUB (2026-09-08): wa.me answers HTTP 429 to bot traffic, so every
 * direct wa.me anchor site-wide was flagged by Semrush as a broken external
 * link (318 warnings, Sep-2026 audit). All HTML anchors now point here with
 * an optional ?text= message; this page forwards the visitor to wa.me.
 *
 * SEMRUSH-DUP-001 (2026-09-08): Semrush reported 11 duplicate-content errors
 * — every ?text=… variant was served the identical prerendered HTML (static
 * file serving matches by pathname and ignores the query string), all with
 * the same canonical. Fix: this page is now server-rendered on demand.
 *   - /go/whatsapp/?text=…  → 301 to wa.me with the message preserved
 *     (visitor reaches WhatsApp one hop earlier, no duplicate document).
 *   - /go/whatsapp/?other=… → 301 to the clean /go/whatsapp/ canonical.
 *   - /go/whatsapp/ (no query) → renders the hub page below (meta refresh +
 *     fallback anchor cover no-JS visitors; go-whatsapp.js handles JS).
 *
 * - robots: noindex, follow (utility page, same class as /thank-you/).
 * - Excluded from sitemap.xml automatically (noindex).
 * - TITLE-DUP-FIX (2026-09-08): /go/ is crawlable in robots.txt so audit
 *   crawlers see these 301s; noindex meta still blocks indexing.
 * - Zero inline JS (strict CSP): redirect logic lives in /js/go-whatsapp.js.
 */
export const prerender = false;

const canonical = 'https://brightai.live/go/whatsapp/';
const WA_NUMBER_URL = 'https://wa.me/966538229013';

// SEMRUSH-DUP-001: canonicalize query-string variants before rendering.
// Only reached in SSR mode; the static build never renders this page.
const text = Astro.url.searchParams.get('text');
if (text !== null) {
  const target =
    WA_NUMBER_URL + '?text=' + encodeURIComponent(text.slice(0, 500));
  return Astro.redirect(target, 301);
}
if ([...Astro.url.searchParams.keys()].length > 0) {
  return Astro.redirect(canonical, 301);
}

---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>جاري تحويلك إلى واتساب | BrightAI</title>
    <meta
      name="description"
      content="صفحة تحويل داخلية تنقلك مباشرة إلى واتساب BrightAI لمتابعة استفسارك عن حوكمة وأمان الذكاء الاصطناعي."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <!--
      SEMRUSH-META-REFRESH (2026-09-08): the previous <meta http-equiv="refresh">
      was flagged as "meta refresh tag" errors (11 pages) by Semrush. Removed —
      JS redirect (go-whatsapp.js) covers browsers, the fallback anchor below
      covers no-JS visitors, and ?text= variants get a server-side 301.
    -->
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #0a0e1a;
        color: #e2e8f0;
        font-family: system-ui, 'IBM Plex Sans Arabic', Tahoma, sans-serif;
        line-height: 1.8;
        padding: 1.5rem;
        box-sizing: border-box;
      }
      main { max-width: 34rem; text-align: center; }
      h1 { font-size: 1.35rem; margin: 0 0 0.75rem; color: #fff; }
      p { margin: 0 0 1.25rem; color: #94a3b8; }
      a {
        display: inline-block;
        min-height: 44px;
        line-height: 44px;
        padding: 0 1.75rem;
        border-radius: 0.9rem;
        background: #075e54;
        color: #fff;
        font-weight: 700;
        text-decoration: none;
      }
      a:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    </style>
  </head>
  <body>
    <main>
      <h1>جاري تحويلك إلى واتساب BrightAI…</h1>
      <p>
        هذي صفحة تحويل داخلية تنقلك مباشرة لمحادثة واتساب مع فريق BrightAI
        لمتابعة استفسارك عن حوكمة وأمان وامتثال الذكاء الاصطناعي في السعودية.
        إذا ما تم التحويل تلقائيًا خلال ثوانٍ، اضغط الزر بالأسفل.
      </p>
      <p>
        <a
          href={WA_NUMBER_URL}
          rel="nofollow noopener"
          data-whatsapp-fallback
        >فتح واتساب الآن</a>
      </p>
    </main>
    <script src="/js/go-whatsapp.js" defer></script>
  </body>
</html>
