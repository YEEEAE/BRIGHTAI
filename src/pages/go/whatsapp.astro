---
/**
 * /go/whatsapp/ — internal WhatsApp redirect hub (noindex utility page).
 *
 * WHATSAPP-HUB (2026-09-08): wa.me answers HTTP 429 to bot traffic, so every
 * direct wa.me anchor site-wide was flagged by Semrush as a broken external
 * link. All HTML anchors point here with an optional ?text= message.
 * SEMRUSH-UNBLOCK (2026-09-08): user decision — /go/ is NO LONGER robots-
 * disallowed and this page is index, follow + sitemap-included. The page
 * still contains no direct wa.me href in its HTML payload (redirect is bound
 * client-side by /js/go-whatsapp.js), so audit crawlers fetching this page
 * never see a wa.me link to misreport.
 *
 * SEMRUSH-EXT-429-FIX (2026-09-08):
 *   - Prerendered as a static page so all internal links resolve in dist/client/
 *     and pass seo:gate.
 *   - No direct `href="https://wa.me/..."` in the HTML payload. The fallback
 *     anchor points to `#whatsapp-chat` and /js/go-whatsapp.js dynamically
 *     binds the destination URL and click handler.
 *   - Browser navigation is handled via client-side location.replace in /js/go-whatsapp.js.
 *   - SEMRUSH-UNBLOCK (2026-09-08): /go/ is allowed in robots.txt again; the
 *     page is index, follow and included in sitemap.xml.
 *
 * - robots: index, follow (user decision SEMRUSH-UNBLOCK 2026-09-08:
 *   all previously blocked pages are now publicly indexable).
 * - Included in sitemap.xml (noindex removed).
 * - Zero inline JS (strict CSP): redirect logic lives in /js/go-whatsapp.js.
 */
const canonical = 'https://brightai.live/go/whatsapp/';
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>جاري تحويلك إلى واتساب | BrightAI</title>
    <meta
      name="description"
      content="صفحة تحويل داخلية تنقلك مباشرة إلى واتساب BrightAI لمتابعة استفسارك عن حوكمة وأمان الذكاء الاصطناعي."
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #0a0e1a;
        color: #e2e8f0;
        font-family: system-ui, 'IBM Plex Sans Arabic', Tahoma, sans-serif;
        line-height: 1.8;
        padding: 1.5rem;
        box-sizing: border-box;
      }
      main { max-width: 34rem; text-align: center; }
      h1 { font-size: 1.35rem; margin: 0 0 0.75rem; color: #fff; }
      p { margin: 0 0 1.25rem; color: #94a3b8; }
      a {
        display: inline-block;
        min-height: 44px;
        line-height: 44px;
        padding: 0 1.75rem;
        border-radius: 0.9rem;
        background: #075e54;
        color: #fff;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
      }
      a:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    </style>
  </head>
  <body>
    <main>
      <h1>جاري تحويلك إلى واتساب BrightAI…</h1>
      <p>
        هذي صفحة تحويل داخلية تنقلك مباشرة لمحادثة واتساب مع فريق BrightAI
        لمتابعة استفسارك عن حوكمة وأمان وامتثال الذكاء الاصطناعي في السعودية.
        إذا ما تم التحويل تلقائيًا خلال ثوانٍ، اضغط الزر بالأسفل.
      </p>
      <p>
        <a
          href="#whatsapp-chat"
          rel="nofollow noopener"
          data-whatsapp-fallback
        >فتح واتساب الآن</a>
      </p>
    </main>
    <script src="/js/go-whatsapp.js" defer></script>
  </body>
</html>
