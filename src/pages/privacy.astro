---
import PageShell from '../components/PageShell.astro';
export const prerender = true;
const sections = [
  ['من نحن', 'BRIGHTAI، المملكة العربية السعودية. للاستفسار عن هوية الجهة المسؤولة عن المعالجة وبياناتها النظامية: hello@brightai.live.'],
  ['تحليلات الموقع', 'يستخدم الموقع Google Analytics لقياس الزيارات والتفاعل. لا تضف بيانات شخصية أو حساسة إلى عناوين الروابط. تفاصيل المعالجة والاحتفاظ والنقل تحتاج مراجعة سياسة الخصوصية وإعدادات الخدمة قبل اعتمادها.'],
  ['البيانات التي نجمعها من زوار الموقع', 'لا يتطلب الموقع تسجيلاً. تجربة الحجب في صفحة Kernel تعمل داخل متصفحك ولا ترسل أي بيانات. وعند مراسلتنا نستلم ما تكتبه في رسالتك فقط. وقد تُسجّل بيانات اتصال تقنية لأغراض الحماية من الهجمات.'],
  ['بيانات عملاء المنصة', 'عند استخدام AIGAS تكون جهتكم هي المتحكم بالبيانات، ونحن جهة معالجة نعمل بناءً على تعليماتكم وفق اتفاقية معالجة البيانات.'],
  ['الغرض', 'تقديم الخدمة، والرد على استفساراتكم، والأمن، والوفاء بالالتزامات النظامية. لا نبيع البيانات ولا نستخدم محتوى طلبات العملاء لتدريب النماذج.'],
  ['المشاركة والنقل', 'نشارك البيانات مع الجهات الفرعية المعالِجة المذكورة في مركز الثقة فقط. في الباقات السحابية قد يُعالج النص المحجوب لدى مزودين خارج المملكة، ونطبق في ذلك ضوابط النقل الواردة في نظام حماية البيانات الشخصية.'],
  ['الاحتفاظ', 'سياقات المحادثة 10 دقائق، وسجلات التدقيق حسب الباقة، والمراسلات حتى انتهاء الغرض منها.'],
  ['حقوقك', 'وفق نظام حماية البيانات الشخصية لك الحق في العلم بكيفية معالجة بياناتك، والوصول إليها، وطلب تصحيحها، وطلب إتلافها، والرجوع عن موافقتك. راسلنا لممارسة أي من هذه الحقوق.'],
  ['التحديثات', 'ننشر أي تعديل على هذه الصفحة مع تاريخه، ونبلغ العملاء بالتغييرات الجوهرية.'],
];
---
<PageShell title="سياسة الخصوصية | BRIGHTAI" description="كيف تجمع BRIGHTAI البيانات الشخصية وتستخدمها وتحميها وفق نظام حماية البيانات الشخصية." crumbs={[{ name: 'سياسة الخصوصية' }]}>
  <p class="note">تفاصيل معالجة بيانات عملاء المنصة أدناه وصف مقترح يحتاج مراجعة واعتماداً قبل تقديم خدمة فعلية، ولا يثبت تفعيل التكاملات أو مدد الاحتفاظ.</p>
  <h1>سياسة الخصوصية</h1><p class="note">آخر تحديث: 2026-10-30</p>
  {sections.map(([t, d]) => <section class="block"><h2>{t}</h2><p>{d}</p></section>)}
</PageShell>
