<!-- BAI-VOC-001-A (2026-07-18): VOC injection في H1 + lead — 5 ركائز (جرد AI، مالك مسؤول، سجل مخاطر، أدلة جاهزة للتدقيق، إشراف بشري). H1 suffix بـ inline style (display:block, font-size:0.5em) يحافظ على SEO anchor "Saudi AI Safety OS" ويضيف VOC تحت. tone = "يدعم الجاهزية" لا "مضمون". -->
<!-- BAI-VOC-001-C (2026-07-18): توحيد CTAs — service cards: 14 بطاقة vague → action-oriented + microcopy ≤12 كلمة. Final CTA: "واتساب" → "احصل على رد عبر واتساب" + microcopy. href/action لم يتغير. -->
---
import ArabicLayout from '../../layouts/ArabicLayout.astro';

import Icon from '../../components/Icon.astro';
import { getFaqLd } from '../../data/schema-helpers';
// BAI-VOC-001-C (2026-07-18): CTAs موحدة حسب intent — كل بطاقة عندها CTA action-oriented + microcopy ≤12 كلمة. 0 href متغير.
const servicePaths = [
  { icon: 'mdi:scale-balance', title: 'AI Governance Platform', desc: 'منصة تنظّم سياسات استخدام الذكاء الاصطناعي، الصلاحيات، المخاطر، وسجلات المراجعة داخل المؤسسة.', href: '/solutions/ai-governance-platform/', cta: 'استكشف منصة الحوكمة', ctaMicro: '8 دقائق • عرض منتج حي' },
  { icon: 'mdi:shield-half-full', title: 'AI Firewall & Data Protection', desc: 'طبقة تفحص الطلبات قبل وصولها للنماذج وتساعد في تقليل تسرب البيانات الحساسة أو غير المصرح بها.', href: '/solutions/ai-firewall/', cta: 'اختبر منع تسرب PII', ctaMicro: 'ببيانات وهمية • دون رفع أسرار' },
  { icon: 'mdi:file-sign', title: 'AI Audit Trail', desc: 'توثيق من استخدم AI، ماذا أرسل، ما الرد، وما الإجراء المتخذ، بطريقة تسهّل المراجعة الداخلية.', href: '/solutions/ai-audit-trail/', cta: 'افهم سجل التدقيق', ctaMicro: 'append-only • Hash مقاوم' },
  { icon: 'mdi:account-check', title: 'Human Approval Workflow', desc: 'مسارات موافقة بشرية للقرارات العالية المخاطر قبل التنفيذ أو إرسال مخرجات حساسة للعميل النهائي.', href: '/solutions/human-approval-layer/', cta: 'شاهد مسار الموافقة', ctaMicro: 'risk-based • قرارات عالية الأثر' },
  { icon: 'mdi:folder-open', title: 'AI Evidence File', desc: 'ملف أدلة يجمع المدخلات، السياسة المطبقة، نتيجة الفحص، الاعتمادات، والتوصيات للمراجعة والامتثال.', href: '/solutions/ai-evidence-file/', cta: 'افتح ملف الأدلة', ctaMicro: 'PDF موقّع رقمياً' },
  { icon: 'mdi:account-cog', title: 'Enterprise AI Assistants', desc: 'مساعدون داخليون للموارد البشرية، المبيعات، المشتريات، الجودة، والدعم، مبنيون على بيانات وسياسات الشركة.', href: '/demo/', cta: 'افتح ديمو تفاعلي', ctaMicro: 'مجاناً • بدون تسجيل' },
  { icon: 'mdi:robot-industrial', title: 'AI Automation for Operations', desc: 'أتمتة مهام تشغيلية مثل الفرز، التلخيص، التصنيف، متابعة الطلبات، وإعداد التقارير اليومية.', href: '/contact/', cta: 'ابدأ تقييم جاهزية', ctaMicro: '20 دقيقة • تقرير فجوات' },
  { icon: 'mdi:certificate', title: 'Compliance Packs for Saudi Market', desc: 'حزم تساعد فرقك على رفع جاهزية الخصوصية والأمن والامتثال، دون ادعاء استبدال المستشار القانوني.', href: '/contact/', cta: 'ناقش حزمة امتثال', ctaMicro: 'PDPL/NCA/SFDA • خارطة ضوابط' },
  { icon: 'mdi:connection', title: 'ERP / CRM / HIS Integrations', desc: 'ربط آمن مع أنظمة المؤسسة وواجهات APIs وقواعد المعرفة الداخلية حسب بيئة العميل ونطاق المشروع.', href: '/contact/', cta: 'خطط تكامل ERP/HIS/SIEM', ctaMicro: 'بدون إعادة بناء أنظمتك' },
  { icon: 'mdi:workflow', title: 'Controlled AI Workflows', desc: 'تصميم مسارات AI خاصة بالقطاع لكن داخل نفس طبقة الأمان والحوكمة والتدقيق، بدل بناء حلول منفصلة عن Saudi AI Safety OS.', href: '/contact/', cta: 'صمّم مسار AI محكوم', ctaMicro: 'KPI واضح + قسم واحد' },
  { icon: 'mdi:alert-decagram', title: 'تصنيف مخاطر الذكاء الاصطناعي', desc: 'تصنيف تلقائي لمخاطر استخدامات AI حسب نوع البيانات، القرار، والتأثير المحتمل على المؤسسة.', href: '/solutions/ai-risk-classification/', cta: 'استكشف تصنيف المخاطر', ctaMicro: 'بيانات • قرار • أثر' },
  { icon: 'mdi:lightbulb-search', title: 'اكتشاف حالات استخدام AI', desc: 'تحديد الفرص الحقيقية لتطبيق الذكاء الاصطناعي داخل عمليات المؤسسة بطريقة آمنة وقابلة للقياس.', href: '/solutions/ai-use-case-discovery/', cta: 'اكتشف حالات استخدام AI', ctaMicro: 'قابلة للقياس وآمنة' },
  { icon: 'mdi:sync', title: 'حوكمة مستمرة للذكاء الاصطناعي', desc: 'مراقبة وتحديث مستمر لسياسات وضوابط الذكاء الاصطناعي بناءً على التغيرات التنظيمية والتشغيلية.', href: '/solutions/continuous-ai-governance/', cta: 'اعرف الحوكمة المستمرة', ctaMicro: 'تحديث ربع سنوي • مربوط بالأنظمة' },
  { icon: 'mdi:link-variant', title: 'ربط السياسات بالضوابط', desc: 'تحويل سياسات الذكاء الاصطناعي المكتوبة إلى ضوابط تقنية وإجرائية قابلة للتنفيذ والمراجعة.', href: '/solutions/policy-to-control-mapping/', cta: 'شاهد ربط السياسات بالضوابط', ctaMicro: 'PDF/تنفيذ/تدقيق' },
];
const faqItems = [
  { q: 'ما هي Saudi AI Safety OS؟', a: 'Saudi AI Safety OS تشمل حوكمة الذكاء الاصطناعي، AI Firewall، سجلات التدقيق، الموافقات البشرية، ملفات الأدلة، الأتمتة، التكاملات، وبناء مساعدين AI داخليين للشركات.' },
  { q: 'هل BrightAI مناسب للشركات السعودية؟', a: 'نعم. BrightAI مصمم لاحتياجات الشركات والجهات السعودية، مع دعم العربية وRTL، وتركيز على الخصوصية والأمان وجاهزية الامتثال حسب نطاق المشروع.' },
  { q: 'هل يمكن ربط BrightAI مع ERP أو CRM؟', a: 'نعم. يمكن ربط BrightAI مع ERP وCRM وHIS وSharePoint والأنظمة الداخلية عبر APIs أو تكاملات مخصصة بعد تقييم البنية الحالية.' },
  { q: 'هل النظام يحمي البيانات الحساسة؟', a: 'يمكن تطبيق ضوابط مثل AI Firewall، إخفاء PII، صلاحيات الوصول، وسجلات التدقيق حسب طبيعة البيانات واتفاقية المشروع.' },
  { q: 'هل التنفيذ مخصص لكل شركة؟', a: 'نعم. يتم تخصيص السياسات والتكاملات ومسارات الموافقة حسب القطاع والأنظمة والبيانات، لكن ضمن نفس Saudi AI Safety OS حتى يبقى intent الأمان والحوكمة واضحاً.' },
  { q: 'كيف أبدأ؟', a: 'ابدأ بتقييم جاهزية الذكاء الاصطناعي أو حجز ديمو. بعدها نحلل الوضع الحالي، نحدد المخاطر، ونقترح نطاق تنفيذ واضح.' },
];

// SCHEMA-ENHANCEMENT (REPORT-23): wrap original Service schema + Organization + FAQPage (extracted from faqItems) + BreadcrumbList.
// Original inline JSON-LD fields (Service.name, Service.description, provider, areaServed) are preserved exactly.
const servicesJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'خدمات حوكمة AI | تقييم، حماية، تدقيق — BrightAI',
      description: 'خدمات BrightAI الـ 15 تغطي تقييم جاهزية AI، حماية البيانات، سجلات التدقيق، والموافقات البشرية. خدمات مخصصة للسوق السعودي وفق PDPL وNCA ECC بكل احترافية.',
      provider: { '@type': 'Organization', name: 'BrightAI', url: 'https://brightai.live' },
      url: 'https://brightai.live/services/',
      areaServed: 'SA',
    },
    getFaqLd(faqItems),
  ].filter((n) => Boolean(n)) as Record<string, unknown>[],
};
---

<ArabicLayout title="خدمات حوكمة AI | تقييم، حماية، تدقيق — BrightAI" description="خدمات BrightAI الـ 15 تغطي تقييم جاهزية AI وحماية البيانات وسجلات التدقيق. خدمات مخصصة للسوق السعودي وفق PDPL وNCA ECC. اكتشف الخدمة المناسبة لشركتك." canonical="https://brightai.live/services/" hreflang={[{lang:'ar-SA',href:'https://brightai.live/services/'},{lang:'x-default',href:'https://brightai.live/services/'}]} jsonLd={servicesJsonLd as any} currentPath="/services/" extraSpeakableSelectors={['.inner-hero__desc', 'aside[data-snippet="tl-dr"]']} breadcrumbs={[{ name: 'الخدمات', href: '/services/' }]}>
<section class="inner-hero" aria-label="خدمات BrightAI">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="inner-hero__badge"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-cogs"></use></svg> تنفيذ Saudi AI Safety OS للسوق السعودي</div>
    <h1>خدمات تنفيذ <span class="gradient-text">Saudi AI Safety OS</span> داخل شركتك <span class="inner-hero__h1-suffix">بجرد AI ومالك مسؤول ومسار إشراف بشري</span></h1>
    <p class="inner-hero__desc">نركّب لك طبقة حماية وحوكمة تشغيلية متكاملة داخل المؤسسة: من تقييم جاهزية AI، لتصميم ضوابط الحماية والتدقيق والموافقة البشرية، ثم الربط الآمن مع أنظمتك الداخلية وتشغيل حالات الاستخدام. يبدأ المسار بـ<strong>جرد AI</strong> شامل وتعيين <strong>مالك مسؤول</strong>، ويُستكمل بـ<strong>سجل مخاطر</strong> محدّث و<strong>أدلة جاهزة للتدقيق</strong> وإشراف بشري فعّال على القرارات عالية المخاطر.</p>
    {/* BAI-SEO-003-S7 (2026-07-18): P0 snippet pack — TL;DR / الخلاصة.
       Answer-first, self-contained, ≤60 words. Single source of truth:
       src/data/snippet-pack.ts. */}
    <aside data-snippet="tl-dr" aria-label="الخلاصة" class="answer-first-summary">
      <p>خدمات حوكمة الذكاء الاصطناعي من برايت أيه آي تغطي تقييم الجاهزية وحماية البيانات وتدقيق الاستخدامات والموافقات البشرية وإدارة المخاطر، ضمن نظام تشغيل واحد. مصممة للسوق السعودي وتدعم تطبيق ضوابط نظام حماية البيانات الشخصية والهيئة الوطنية للأمن السيبراني. لا تستبدل الاستشارة النظامية أو القانونية المتخصصة.</p>
    </aside>
    <div class="inner-hero__actions">
      <a href="/contact/" class="glow-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold" data-cta="hero_cta_click" data-cta-label="ابدأ تقييم مجاني" data-position="inline" data-page-type="services" data-offer="assessment"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-calendar-check"></use></svg> ابدأ تقييم مجاني</a>
      <a href="https://wa.me/966538229013" target="_blank" rel="nofollow noopener noreferrer" class="wa-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white" data-whatsapp data-cta-label="تواصل عبر واتساب" data-position="inline" data-page-type="services"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-whatsapp"></use></svg> تواصل عبر واتساب</a>
    </div>
  </div>
</section>

<section class="inner-section" aria-labelledby="service-paths">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <p class="inner-section__label">مسارات التنفيذ</p>
    <h2 id="service-paths" class="inner-section__title">مسارات تنفيذ واضحة لنظام واحد</h2>
    <p class="inner-section__lead">كل مسار يخدم نفس intent: تشغيل AI داخل المؤسسة بأمان، حوكمة، سجل تدقيق، وموافقة بشرية عند الحاجة.</p>
    <div class="inner-grid inner-grid--3">
      {servicePaths.map(s => (
        <a href={s.href} class="inner-card text-decoration-reset">
          <div class="inner-card__icon"><Icon name={s.icon} class="" /></div>
          <h3 class="inner-card__title">{s.title}</h3>
          <p class="inner-card__text">{s.desc}</p>
          <span class="inner-card__cta">{s.cta}</span>
          <small class="inner-card__cta-micro" aria-hidden="true">{s.ctaMicro}</small>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="inner-section" aria-labelledby="teams-title">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="teams-title" class="inner-section__title">للفرق التي تحتاج AI قابل للتشغيل لا للاستعراض</h2>
    <div class="inner-grid inner-grid--4">
      <a class="inner-card" href="/solutions/government-ai-governance/" data-cta="hero_cta_click" data-cta-label="الجهات الحكومية" data-position="inline" data-page-type="services"><h3 class="inner-card__title">الجهات الحكومية</h3></a>
      <a class="inner-card" href="/solutions/manufacturing-ai-governance/" data-cta="hero_cta_click" data-cta-label="المصانع والقطاع الصناعي" data-position="inline" data-page-type="services"><h3 class="inner-card__title">المصانع والقطاع الصناعي</h3></a>
      <div class="inner-card"><h3 class="inner-card__title">المستشفيات</h3></div>
      <div class="inner-card"><h3 class="inner-card__title">القطاع المالي</h3></div>
      <div class="inner-card"><h3 class="inner-card__title">الموارد البشرية</h3></div>
      <div class="inner-card"><h3 class="inner-card__title">المشتريات والمناقصات</h3></div>
      <div class="inner-card"><h3 class="inner-card__title">الجودة والامتثال</h3></div>
      <div class="inner-card"><h3 class="inner-card__title">الشركات المتوسطة والكبيرة</h3></div>
    </div>
  </div>
</section>

<section class="inner-section inner-section--alt" aria-labelledby="impl-steps">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <p class="inner-section__label">كيف نشتغل؟</p>
    <h2 id="impl-steps" class="inner-section__title">مسار تنفيذ واضح من التقييم إلى التشغيل</h2>
    <p class="inner-section__lead">نحوّل الاحتياج من فكرة أو استخدام متفرق إلى نظام واضح ومسؤوليات وأدلة تشغيل.</p>
    <div class="inner-grid inner-grid--4">
      <div class="inner-card"><h3 class="inner-card__title">تحليل الوضع الحالي</h3><p class="inner-card__text">نفهم الأنظمة، المستخدمين، البيانات، وحالات استخدام AI الموجودة أو المخطط لها.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">تحديد المخاطر</h3><p class="inner-card__text">نصنّف مخاطر الذكاء الاصطناعي والبيانات والقرارات العالية الحساسية.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">تصميم الحل</h3><p class="inner-card__text">نحدد الضوابط، مسارات الموافقة، السجلات، والتكاملات المطلوبة.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">بناء النموذج أو النظام</h3><p class="inner-card__text">نبني طبقة التشغيل أو المساعد الداخلي أو الأتمتة المطلوبة حسب النطاق.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">التكامل مع الأنظمة</h3><p class="inner-card__text">نربط الحل مع ERP أو CRM أو HIS أو SharePoint أو قواعد المعرفة الداخلية.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">الاختبار والمراجعة</h3><p class="inner-card__text">نختبر السيناريوهات، الصلاحيات، التجاوب، وسجلات التدقيق قبل الإطلاق.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">التشغيل والتدريب</h3><p class="inner-card__text">نجهز الفرق على الاستخدام، الاعتماد، والتعامل مع الحالات الاستثنائية.</p></div>
      <div class="inner-card"><h3 class="inner-card__title">تقارير امتثال ومتابعة</h3><p class="inner-card__text">نرتب تقارير دورية ومخرجات قابلة للمراجعة حسب الاتفاق.</p></div>
    </div>
  </div>
</section>

<section class="inner-section" aria-labelledby="real-operation">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <h2 id="real-operation" class="inner-section__title">لأن الشركات ما تحتاج ديمو جميل فقط؛ تحتاج طبقة تشغيل حقيقية</h2>
    <ul>
      <li>مبني للسوق السعودي واحتياجات المؤسسات المحلية.</li>
      <li>يدعم اللغة العربية وبيئات RTL من البداية.</li>
      <li>يركز على الأمان والامتثال بدون وعود قانونية مطلقة.</li>
      <li>قابل للتدقيق والمراجعة عبر سجلات وملفات أدلة.</li>
      <li>مناسب للبيانات الحساسة عند ضبط نطاق الحماية والصلاحيات.</li>
      <li>قابل للتكامل مع أنظمة المؤسسة الحالية.</li>
      <li>ينقل AI من تجربة فردية إلى تشغيل مؤسسي منضبط.</li>
    </ul>
  </div>
</section>

<section class="inner-section" aria-labelledby="sector-sel">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <p class="inner-section__label">القطاعات</p>
    <h2 id="sector-sel" class="inner-section__title">اختر المسار الأقرب لقطاعك وقرارك</h2>
    <p class="inner-section__lead">راجع مركز اختيار الحلول ومركز حالات الاستخدام، أو انتقل مباشرة إلى الصفحات المحلية للقطاع المالي في الرياض، والقطاع الصحي في جدة، والجهات الحكومية في الدمام.</p>
    <p><a href="/hub/solutions/">مركز اختيار الحلول</a> · <a href="/hub/use-cases/">مركز حالات الاستخدام</a> · <a href="/solutions/banking-ai-governance/riyadh/">الرياض</a> · <a href="/solutions/healthcare-ai-governance/jeddah/">جدة</a> · <a href="/solutions/government-ai-governance/dammam/">الدمام</a> · <a href="/events/ai-governance-day/">الفعاليات</a> · <a href="/newsletter/">النشرة الأسبوعية</a> · <a href="/customers/">قصص النجاح</a> · <a href="/partners/">الشراكات</a> · <a href="/referral/">الإحالة</a></p>
    <div class="inner-grid inner-grid--4">
      <div class="inner-card"><svg class="inner-card__icon" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-flask"></use></svg><h3 class="inner-card__title">المصانع الطبية</h3><p class="inner-card__text">SFDA · ISO 13485 · CAPA · المرفوضات</p></div>
