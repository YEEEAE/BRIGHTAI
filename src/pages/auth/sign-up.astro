---
import PageShell from '../../components/PageShell.astro';
import { env, isPortalEnabled } from '../../server/kernel/env.mjs';

export const prerender = false;
const authUrl = env('NEON_AUTH_BASE_URL') ?? '';
const portalEnabled = isPortalEnabled();
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
---

<PageShell
  title="إنشاء حساب | BRIGHTAI"
  description="أنشئ حساب BRIGHTAI باستخدام بريدك الإلكتروني وكلمة المرور."
  crumbs={[{ name: 'إنشاء حساب' }]}
  robots="noindex, nofollow"
>
  <p class="eyebrow">حساب BRIGHTAI</p>
  <h1>ابدأ بحسابك</h1>
  <p class="lead">سجّل بالبريد الإلكتروني وكلمة المرور. تُدار بيانات الدخول عبر Neon Managed Auth.</p>

  {authUrl ? (
    <section class="card auth-card" data-auth-url={authUrl} aria-labelledby="auth-heading">
      <div data-auth-form-view>
        <h2 id="auth-heading">إنشاء حساب</h2>
        <form data-auth-form>
          <div class="auth-field" data-name-field>
            <label for="auth-name">الاسم</label>
            <input id="auth-name" name="name" type="text" autocomplete="name" dir="auto" required maxlength="80" />
            <p class="field-error" id="auth-name-error" data-field-error="name" hidden></p>
          </div>
          <div class="auth-field">
            <label for="auth-email">البريد الإلكتروني</label>
            <input id="auth-email" name="email" type="email" autocomplete="email" dir="ltr" required maxlength="254" aria-describedby="auth-email-error" />
            <p class="field-error" id="auth-email-error" data-field-error="email" hidden></p>
          </div>
          <div class="auth-field">
            <label for="auth-password">كلمة المرور</label>
            <div class="password-control"><input id="auth-password" name="password" type="password" autocomplete="new-password" dir="ltr" required minlength="8" maxlength="128" aria-describedby="auth-password-error" /><button type="button" data-password-toggle aria-pressed="false" aria-controls="auth-password">إظهار كلمة المرور</button></div>
            <p class="field-error" id="auth-password-error" data-field-error="password" hidden></p>
          </div>
          <button class="button" type="submit" data-submit disabled>إنشاء الحساب</button>
        </form>
        <p class="auth-switch">
          <span data-switch-label>عندك حساب؟</span>
          <button class="auth-link" type="button" data-switch>تسجيل الدخول</button>
        </p>
      </div>

      <div data-auth-session hidden>
        <h2>أنت مسجل دخول</h2>
        <p>الحساب الحالي: <bdi data-current-user></bdi></p>
        {portalEnabled ? (
          <a class="button" href="/app/kernel/">فتح مساحة العمل</a>
        ) : (
          <p role="status">بوابة مساحة العمل غير متاحة حاليًا. <a href="/contact/?topic=بوابة%20مساحة%20العمل">استفسر عن إتاحتها</a></p>
        )}
        <button class="button" type="button" data-sign-out>تسجيل الخروج</button>
      </div>

      <p class="auth-status" data-auth-status role="status" aria-live="polite">جارٍ التحقق من جلسة الدخول…</p>
    </section>
  ) : (
    <p class="card auth-unavailable" role="status">التسجيل غير متاح حالياً؛ لم يُضبط عنوان Neon Auth لهذا التشغيل.</p>
  )}
</PageShell>

<script>
  import { createWorkspaceAuth as createAuthClient } from '../../scripts/workspace-context';

  const card = document.querySelector<HTMLElement>('.auth-card');
  const form = card?.querySelector<HTMLFormElement>('[data-auth-form]');
  const formView = card?.querySelector<HTMLElement>('[data-auth-form-view]');
  const sessionView = card?.querySelector<HTMLElement>('[data-auth-session]');
  const nameField = card?.querySelector<HTMLElement>('[data-name-field]');
  const nameInput = card?.querySelector<HTMLInputElement>('#auth-name');
  const emailInput = card?.querySelector<HTMLInputElement>('#auth-email');
  const passwordInput = card?.querySelector<HTMLInputElement>('#auth-password');
  const submitButton = card?.querySelector<HTMLButtonElement>('[data-submit]');
  const switchButton = card?.querySelector<HTMLButtonElement>('[data-switch]');
  const switchLabel = card?.querySelector<HTMLElement>('[data-switch-label]');
  const signOutButton = card?.querySelector<HTMLButtonElement>('[data-sign-out]');
  const currentUser = card?.querySelector<HTMLElement>('[data-current-user]');
  const status = card?.querySelector<HTMLElement>('[data-auth-status]');
  const passwordToggle = card?.querySelector<HTMLButtonElement>('[data-password-toggle]');
  const authUrl = card?.dataset.authUrl;

  if (
    card && form && formView && sessionView && nameField && nameInput && emailInput && passwordInput &&
    submitButton && switchButton && switchLabel && signOutButton && currentUser && status && authUrl
  ) {
    const auth = createAuthClient(authUrl);
    let mode: 'sign-up' | 'sign-in' = 'sign-up';

    const setStatus = (message: string) => {
      status.textContent = message;
    };

    const fieldErrors = new Map<string, HTMLElement>(
      [...card.querySelectorAll<HTMLElement>('[data-field-error]')].map((error) => [error.dataset.fieldError ?? '', error]),
    );
    const setFieldError = (field: 'name' | 'email' | 'password', message = '') => {
      const input = field === 'name' ? nameInput : field === 'email' ? emailInput : passwordInput;
      const error = fieldErrors.get(field);
      if (!error) return;
      error.textContent = message;
      error.hidden = !message;
      input.setAttribute('aria-invalid', message ? 'true' : 'false');
      input.setAttribute('aria-describedby', error.id);
    };
    const validate = (field: 'name' | 'email' | 'password') => {
      const signingUp = mode === 'sign-up';
      if (field === 'name' && !signingUp) return true;
      const input = field === 'name' ? nameInput : field === 'email' ? emailInput : passwordInput;
      let message = '';
      if (field === 'name' && !input.value.trim()) message = 'اكتب اسمك.';
      else if (field === 'email' && !input.value.trim()) message = 'اكتب بريدك الإلكتروني.';
      else if (field === 'email' && input.validity.typeMismatch) message = 'تحقق من صيغة البريد الإلكتروني.';
      else if (field === 'password' && !input.value) message = 'اكتب كلمة المرور.';
      else if (field === 'password' && signingUp && input.value.length < 8) message = 'استخدم 8 أحرف على الأقل.';
      setFieldError(field, message);
      return !message;
    };
    const clearFieldErrors = () => {
      (['name', 'email', 'password'] as const).forEach((field) => setFieldError(field));
    };

    const showUser = (email: string) => {
      currentUser.textContent = email;
      formView.hidden = true;
      sessionView.hidden = false;
      setStatus('عُثر على جلسة لدى Neon Auth. يتحقق الخادم من الهوية والعضوية عند فتح مساحة العمل.');
    };

    const showForm = () => {
      sessionView.hidden = true;
      formView.hidden = false;
    };

    const setMode = (nextMode: 'sign-up' | 'sign-in') => {
      mode = nextMode;
      const signingUp = mode === 'sign-up';
      nameField.hidden = !signingUp;
      nameInput.required = signingUp;
      nameInput.autocomplete = signingUp ? 'name' : 'off';
      passwordInput.autocomplete = signingUp ? 'new-password' : 'current-password';
      passwordInput.minLength = signingUp ? 8 : 0;
      passwordInput.type = 'password'; passwordInput.value = '';
      if (passwordToggle) { passwordToggle.textContent = 'إظهار كلمة المرور'; passwordToggle.setAttribute('aria-pressed', 'false'); }
      submitButton.textContent = signingUp ? 'إنشاء الحساب' : 'تسجيل الدخول';
      switchLabel.textContent = signingUp ? 'عندك حساب؟' : 'ما عندك حساب؟';
      switchButton.textContent = signingUp ? 'تسجيل الدخول' : 'إنشاء حساب';
      setStatus('');
      clearFieldErrors();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearFieldErrors();
      const valid = [validate('name'), validate('email'), validate('password')].every(Boolean);
      if (!valid) {
        [nameInput, emailInput, passwordInput].find((input) => input.getAttribute('aria-invalid') === 'true')?.focus();
        return;
      }
      if (!form.reportValidity()) return;

      submitButton.disabled = true;
      switchButton.disabled = true;
      form.querySelectorAll<HTMLInputElement | HTMLButtonElement>('input,button').forEach((control) => { control.disabled = true; });
      form.setAttribute('aria-busy', 'true');
      setStatus(mode === 'sign-up' ? 'جارٍ إنشاء الحساب…' : 'جارٍ تسجيل الدخول…');
      let authSucceeded = false;

      try {
        const email = emailInput.value.trim();
        const password = passwordInput.value;
        const result = mode === 'sign-up'
          ? await auth.signUp.email({
              name: nameInput.value.trim(),
              email,
              password,
            })
          : await auth.signIn.email({ email, password });

        if (result.error) {
          const code = String((result.error as { code?: unknown }).code ?? '').toUpperCase();
          if (['INVALID_EMAIL', 'INVALID_EMAIL_ADDRESS'].includes(code)) setFieldError('email', 'تحقق من صيغة البريد الإلكتروني.');
          if (['PASSWORD_TOO_SHORT', 'PASSWORD_TOO_LONG', 'INVALID_PASSWORD'].includes(code)) setFieldError('password', mode === 'sign-up' ? 'راجع متطلبات كلمة المرور وحاول مرة ثانية.' : 'تعذر التحقق من كلمة المرور. حاول مرة ثانية.');
          setStatus(mode === 'sign-up'
            ? 'تعذر إنشاء الحساب. راجع الحقول وحاول مرة ثانية.'
            : 'تعذر تسجيل الدخول. تحقق من البريد وكلمة المرور وحاول مرة ثانية.');
          return;
        }
        authSucceeded = true;

        const sessionResult = await auth.getSession();
        if (sessionResult.error) {
          setStatus('تم إرسال الطلب، لكن تعذر قراءة الجلسة الآن. حدّث الصفحة وحاول مرة ثانية.');
          return;
        }

        if (sessionResult.data?.user?.email) {
          showUser(sessionResult.data.user.email);
        } else if (mode === 'sign-up') {
          setMode('sign-in');
          setStatus('تم إنشاء الحساب. أكمل تأكيد البريد الإلكتروني إذا وصلك طلب تحقق، ثم سجّل الدخول.');
        } else {
          setStatus('لم تُنشأ جلسة. تحقق من البريد وكلمة المرور وحاول مرة ثانية.');
        }
      } catch {
        setStatus('تعذر إكمال الطلب. راجع إعداد خدمة الحسابات أو حاول مرة ثانية.');
      } finally {
        form.querySelectorAll<HTMLInputElement | HTMLButtonElement>('input,button').forEach((control) => { control.disabled = false; });
        form.removeAttribute('aria-busy');
        if (emailInput.getAttribute('aria-invalid') === 'true') emailInput.focus();
        else if (passwordInput.getAttribute('aria-invalid') === 'true') passwordInput.focus();
        if (authSucceeded) passwordInput.value = '';
      }
    });

    switchButton.addEventListener('click', () => {
      showForm();
      setMode(mode === 'sign-up' ? 'sign-in' : 'sign-up');
    });

    for (const [field, input] of [['name', nameInput], ['email', emailInput], ['password', passwordInput]] as const) {
      input.addEventListener('blur', () => { if (input.value) validate(field); });
      input.addEventListener('input', () => { if (!fieldErrors.get(field)?.hidden) validate(field); });
    }
    passwordToggle?.addEventListener('click', () => {
      const visible = passwordInput.type === 'password';
      passwordInput.type = visible ? 'text' : 'password';
      passwordToggle.textContent = visible ? 'إخفاء كلمة المرور' : 'إظهار كلمة المرور';
      passwordToggle.setAttribute('aria-pressed', String(visible));
    });

    signOutButton.addEventListener('click', async () => {
      signOutButton.disabled = true;
      setStatus('جارٍ تسجيل الخروج…');
      try {
        const result = await auth.signOut();
        if (result.error) {
          setStatus('تعذر تسجيل الخروج. حاول مرة ثانية.');
          return;
        }
        showForm();
        form.reset();
        setMode('sign-up');
        setStatus('تم تسجيل الخروج.');
      } catch {
        setStatus('تعذر الاتصال بخدمة الحسابات. حاول مرة ثانية.');
      } finally {
        signOutButton.disabled = false;
      }
    });

    auth.getSession().then(({ data, error }) => {
      if (error) {
        setStatus('تعذر التحقق من الجلسة. تقدر تتابع بتسجيل الدخول.');
      } else if (data?.user?.email) {
        showUser(data.user.email);
      } else {
        setStatus('أكمل الحقول لإنشاء حساب، أو سجّل الدخول إذا كان لديك حساب.');
      }
      submitButton.disabled = false;
    }).catch(() => {
      setStatus('تعذر الاتصال بخدمة الحسابات. تحقق من اتصالك وحاول مرة ثانية.');
      submitButton.disabled = false;
    });
  }
</script>

<style>
  .auth-card { max-width: 640px; margin-block-start: 36px; }
  .auth-card h2 { font-size: clamp(28px, 4vw, 42px); margin-block-end: 24px; }
  .auth-card form { display: grid; gap: 18px; }
  .auth-field { display: grid; gap: 8px; color: var(--color-silver-mist); font-size: 15px; }
  .auth-field label { color: #c6c1cf; font-size: 14px; line-height: 1.7; letter-spacing: 0; }
  .auth-field input { width: 100%; min-height: 48px; padding: 11px 14px; border: 1px solid #302a39; border-radius: 10px; background: #0b0910; color: #f4f1f8; font: inherit; font-size: 16px; line-height: 1.6; transition: border-color 140ms ease, background-color 140ms ease; }
  .password-control { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px; }
  .password-control button { min-height: 44px; padding-inline: 10px; border: 1px solid #302a39; border-radius: 8px; background: #111018; color: #e7dcc6; font: inherit; cursor: pointer; }
  .field-error { margin: 0; color: #ffb4a9; font-size: 13px; line-height: 1.7; }
  .auth-field input[aria-invalid="true"] { border-color: #d56c60; }
  .auth-field input:hover { border-color: #413a4d; }
  .auth-field input:focus { border-color: var(--color-saffron-spark); background: #0e0b14; }
  .auth-field input:focus-visible, .auth-link:focus-visible, .password-control button:focus-visible { outline: 2px solid var(--color-saffron-spark); outline-offset: 3px; }
  .auth-field input:user-invalid { border-color: #c25a5a; }
  .auth-card .button { transition: filter 140ms ease, transform 140ms ease, background-color 140ms ease; }
  .auth-card .button:not([disabled]):hover { filter: brightness(1.08); transform: translateY(-1px); }
  .auth-card .button:not([disabled]):active { transform: translateY(0); }
  .auth-card .button[disabled] { background: #241a33; border: 1px solid #3a3346; color: #b9b3c4; opacity: 1; cursor: not-allowed; }
  .auth-switch { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-block-start: 18px; color: var(--color-silver-mist); font-size: 14px; line-height: 1.8; }
  .auth-link { min-height: 44px; border: 0; padding: 6px 8px; background: transparent; color: var(--color-saffron-spark); font: inherit; cursor: pointer; }
  .auth-link:hover { color: #ffd27a; text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .auth-status { min-height: 1.8em; margin-block-start: 16px; color: var(--color-silver-mist); font-size: 14px; line-height: 1.8; }
  .auth-status:not(:empty) { padding: 10px 12px; border: 1px solid #241f2d; border-inline-start: 2px solid #3a3346; border-radius: 8px; background: #0b0910; color: #d8d3e4; }
  .auth-unavailable { max-width: 640px; margin-block-start: 36px; border-inline-start: 3px solid var(--color-saffron-spark); background: #141007; color: #e7dcc6; }
  @media (max-width: 390px) { .auth-card { margin-block-start: 24px; } .auth-card h2 { margin-block-end: 18px; } .auth-field input { padding: 10px 12px; } .auth-status:not(:empty) { padding: 9px 10px; } }
  [hidden] { display: none !important; }
</style>
