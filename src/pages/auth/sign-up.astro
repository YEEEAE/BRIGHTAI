---
import AccessBadge from '../../components/AccessBadge.astro';
import AccessSteps from '../../components/AccessSteps.astro';
import { accessPath } from '../../shared/access-journey.mjs';
import { authDestination } from '../../shared/auth-navigation.mjs';
import PageShell from '../../components/PageShell.astro';
import MonitoringGate from '../../components/MonitoringGate.astro';
import { isPortalEnabled } from '../../server/kernel/env.mjs';
import { authConfig } from '../../server/kernel/auth.mjs';
import { getSignUpAvailability } from '../../shared/sign-up-availability.mjs';

export const prerender = false;
const authUrl = authConfig()?.base ?? '';
const portalEnabled = isPortalEnabled();
const signUpAvailability = getSignUpAvailability(authUrl, portalEnabled);
const destination = authDestination(Astro.url.searchParams);
const trial = destination.path.startsWith('/app/trial/');
const track = trial ? 'trial' : Astro.url.searchParams.get('access') === 'production' ? 'production' : 'beta';
const requestPath = accessPath(destination.product?.slug, track);
const signingIn = Astro.url.searchParams.get('mode') === 'sign-in';
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
---

<PageShell
  title={signingIn ? "تسجيل الدخول | BRIGHTAI" : "إنشاء حساب | BRIGHTAI"}
  description="أنشئ حساب BRIGHTAI باستخدام بريدك الإلكتروني وكلمة المرور."
  crumbs={[{ name: signingIn ? "تسجيل الدخول" : "إنشاء حساب" }]}
  robots="noindex, nofollow"
>
  <MonitoringGate />
  <AccessSteps current="account" slug={destination.product?.slug} track={track} />
  <AccessBadge status={signUpAvailability.available ? "account" : "unavailable"} />
  <h1>{signingIn ? "تسجيل الدخول" : "إنشاء حساب"}</h1>
  {signUpAvailability.available ? (
    <>
    <p class="lead">استخدم بريدك الإلكتروني وكلمة المرور.</p>
    <p class="auth-status" id="auth-status" data-auth-status role="status">جارٍ التحقق من جلسة الدخول…</p>
    <section aria-describedby="auth-status" class="card auth-card" data-workspace-path={destination.path} data-auto-return={destination.auto} data-mode={signingIn ? "sign-in" : "sign-up"} aria-labelledby="auth-heading">
      <div data-auth-form-view hidden>
        <h2 id="auth-heading">إنشاء حساب</h2>
        <form data-auth-form method="post" novalidate>
          <div class="auth-field" data-name-field>
            <label for="auth-name">الاسم</label>
            <input id="auth-name" name="name" type="text" autocomplete="name" dir="auto" required maxlength="80" />
          </div>
          <div class="auth-field">
            <label for="auth-email">البريد الإلكتروني</label>
            <input id="auth-email" name="email" type="email" autocomplete="email" dir="ltr" required maxlength="254" />
          </div>
          <div class="auth-field">
            <label for="auth-password">كلمة المرور</label>
            <div class="password-control"><input id="auth-password" name="password" type="password" autocomplete="new-password" dir="ltr" required minlength="8" maxlength="128" /><button type="button" data-password-toggle aria-pressed="false" aria-controls="auth-password">إظهار كلمة المرور</button></div>

          </div>
          <button class="button" type="submit" data-submit disabled>إنشاء الحساب</button>
        </form>
        <p class="auth-switch">
          <span data-switch-label>عندك حساب؟</span>
          <button class="auth-link" type="button" data-switch>تسجيل الدخول</button>
        </p>
      </div>

      <div data-auth-session hidden>
        <h2>أنت مسجل دخول</h2>
        <p>الحساب الحالي: <bdi data-current-user></bdi></p>
        <a class="button" href={destination.path} data-continue hidden>{destination.path.startsWith("/auth/") ? "العودة إلى الدعوات" : "فتح مساحة العمل"}</a>
        <button class="button" type="button" data-refresh>تحديث الجلسة</button>
        <button class="button" type="button" data-sign-out>تسجيل الخروج</button>
      </div>

      <form data-verify-form method="post" hidden>
        <h2>توثيق البريد أو الدخول برمز</h2><p>أدخل بريدك لطلب رمز توثيق أو لتسجيل الدخول برمز من ستة أرقام.</p>
        <label for="otp-purpose">غرض الرمز</label><select id="otp-purpose"><option value="email-verification">توثيق البريد</option><option value="sign-in">تسجيل الدخول برمز</option></select>
        <label for="verify-email">البريد الإلكتروني</label><input id="verify-email" type="email" autocomplete="email" required dir="ltr" maxlength="254" />
        <button type="button" data-send-otp>إرسال الرمز</button>
        <label for="verify-otp">رمز الرسالة</label><input id="verify-otp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required dir="ltr" />
        <button type="submit">التحقق من الرمز</button>
      </form>
      <button class="auth-link" type="button" data-auth-retry hidden>إعادة التحقق من الجلسة</button>
      <noscript>فعّل JavaScript لاستخدام خدمة الحسابات.</noscript>
    </section>
    </>
  ) : (
    <div class="card auth-unavailable"><p>{signUpAvailability.message}</p><a href={requestPath}>خيارات طلب الوصول</a> · <a href="/contact/">تواصل معنا</a> · <a href="/status/">حالة النظام</a></div>
  )}
</PageShell>

<script>
  import '../../scripts/auth-page';
</script>

<style>
  .auth-card { max-width: 640px; margin-block-start: 36px; }
  .auth-card h2 { font-size: clamp(28px, 4vw, 42px); margin-block-end: 24px; }
  .auth-card form { display: grid; gap: 18px; }
  .auth-field { display: grid; gap: 8px; color: var(--color-silver-mist); font-size: 15px; }
  .auth-field label { color: #c6c1cf; font-size: 14px; line-height: 1.7; letter-spacing: 0; }
  .auth-field input { width: 100%; min-height: 48px; padding: 11px 14px; border: 1px solid #302a39; border-radius: 10px; background: #0b0910; color: #f4f1f8; font: inherit; font-size: 16px; line-height: 1.6; transition: border-color 140ms ease, background-color 140ms ease; }
  .password-control { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 8px; }
  .password-control button { min-height: 44px; padding-inline: 10px; border: 1px solid #302a39; border-radius: 8px; background: #111018; color: #e7dcc6; font: inherit; cursor: pointer; }
  .auth-field input:hover { border-color: #413a4d; }
  .auth-field input:focus { border-color: var(--color-saffron-spark); background: #0e0b14; }
  .auth-field input:focus-visible, .auth-link:focus-visible, .password-control button:focus-visible { outline: 2px solid var(--color-saffron-spark); outline-offset: 3px; }
  .auth-field input[aria-invalid="true"], .auth-field input:user-invalid { border-color: #c25a5a; }
  .auth-card .button { transition: filter 140ms ease, transform 140ms ease, background-color 140ms ease; }
  .auth-card .button:not([disabled]):hover { filter: brightness(1.08); transform: translateY(-1px); }
  .auth-card .button:not([disabled]):active { transform: translateY(0); }
  .auth-card .button[disabled] { background: #241a33; border: 1px solid #3a3346; color: #b9b3c4; opacity: 1; cursor: not-allowed; }
  .auth-switch { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-block-start: 18px; color: var(--color-silver-mist); font-size: 14px; line-height: 1.8; }
  .auth-link { min-height: 44px; border: 0; padding: 6px 8px; background: transparent; color: var(--color-saffron-spark); font: inherit; cursor: pointer; }
  .auth-link:hover { color: #ffd27a; text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .auth-status { min-height: 1.8em; margin-block-start: 16px; color: var(--color-silver-mist); font-size: 14px; line-height: 1.8; }
  .auth-status:not(:empty) { padding: 10px 12px; border: 1px solid #241f2d; border-inline-start: 2px solid #3a3346; border-radius: 8px; background: #0b0910; color: #d8d3e4; }
  .auth-unavailable { max-width: 640px; margin-block-start: 36px; border-inline-start: 3px solid var(--color-saffron-spark); background: #141007; color: #e7dcc6; }
  @media (max-width: 390px) { .auth-card { margin-block-start: 24px; } .auth-card h2 { margin-block-end: 18px; } .auth-field input { padding: 10px 12px; } .auth-status:not(:empty) { padding: 9px 10px; } }
  [hidden] { display: none !important; }
</style>
