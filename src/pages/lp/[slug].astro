---
/**
 * /lp/[slug]/ — Landing pages for Saudi keyword clusters.
 * CHAMPION-03 (2026-07-30): 5 LPs targeting PDPL, ECC, banking, healthcare, government.
 * Each LP: 800-1200 words, Hero + Trust signals + CTA + FAQ + internal links.
 * Schema: Service + FAQPage. In sitemap + llms.txt.
 *
 * Architecture:
 *   - Dynamic route reads src/data/landing-pages.ts (source of truth).
 *   - Service + FAQPage JSON-LD inline.
 *   - Mobile-first scoped style block (mirrors answer/[slug].astro baseline).
 *   - Logical properties for RTL. min-height: 44px touch targets.
 *
 * Performance:
 *   - No client-side JS (static HTML). Zero client hydrations.
 *   - Scoped <style> block — no render-blocking external CSS.
 *
 * Accessibility:
 *   - <main> landmark, <h1> unique, heading hierarchy preserved.
 *   - prefers-reduced-motion respected.
 *
 * Content Preservation Rule:
 *   LP content is original content written for BrightAI — no published
 *   Arabic text from the live site is touched or preserved here.
 */
import { landingPages, type LandingPage } from '../../data/landing-pages';
import { getFaqLd } from '../../data/schema-helpers';
import type { FaqItem } from '../../data/schema-helpers';
import { getHreflangLinks } from '../../data/hreflang-pairs';

export function getStaticPaths() {
  return landingPages.map((lp) => ({
    params: { slug: lp.slug },
    props: { lp },
  }));
}

const { lp } = Astro.props as { lp: LandingPage };
const canonical = `https://brightai.live/lp/${lp.slug}/`;
const hreflangLinks = getHreflangLinks(canonical);

const faqItems: FaqItem[] = lp.faq.map((f) => ({ q: f.q, a: f.a }));
const faqLd = getFaqLd(faqItems);

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: lp.title,
  description: lp.description,
  url: canonical,
  provider: { '@id': 'https://brightai.live/#organization' },
  areaServed: { '@type': 'Country', name: 'المملكة العربية السعودية' },
};

const jsonLd = [serviceLd, faqLd].filter(Boolean);
import SiteBackground from '../../components/SiteBackground.astro';
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Google tag (gtag.js) — OWNER REQUEST (2026-08-28): literal Google snippet,
        verbatim, same as BaseLayout. These standalone static pages have no
        Layout, so without this block the /lp/* pages would carry no GA4 tag. */}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9LMB4PGTWJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-9LMB4PGTWJ');
    </script>
    <title>{lp.metaTitle}</title>
    <meta name="description" content={lp.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    {hreflangLinks.map(({ lang, href }) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    {jsonLd.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}
  </head>
  <body>
    <SiteBackground />
    <main id="main-content" class="lp-page">
      <section class="lp-hero" aria-label={lp.title}>
        <h1 class="lp-hero__h1">{lp.h1}</h1>
        <p class="lp-hero__subtitle">{lp.heroSubtitle}</p>
        <a href={lp.ctaHref} class="lp-hero__cta">{lp.ctaLabel}</a>
      </section>

      <section class="lp-trust" aria-label="إشارات الثقة">
        <h2 class="lp-trust__heading">إشارات الثقة</h2>
        <ul class="lp-trust__list">
          {lp.trustSignals.map((signal) => (
            <li class="lp-trust__item">{signal}</li>
          ))}
        </ul>
      </section>

      {lp.bodySections.map((section) => (
        <section class="lp-body" aria-label={section.heading}>
          <h2 class="lp-body__heading">{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p class="lp-body__p">{p}</p>
          ))}
        </section>
      ))}

      <section class="lp-faq" aria-label="أسئلة شائعة">
        <h2 class="lp-faq__heading">أسئلة شائعة</h2>
        {lp.faq.map((item) => (
          <details class="lp-faq__item">
            <summary class="lp-faq__q">{item.q}</summary>
            <p class="lp-faq__a">{item.a}</p>
          </details>
        ))}
      </section>

      <section class="lp-links" aria-label="روابط ذات صلة">
        <h2 class="lp-links__heading">روابط ذات صلة</h2>
        <ul class="lp-links__list">
          {lp.internalLinks.map((link) => (
            <li class="lp-links__item">
              <a href={link.href} class="lp-links__a">{link.label}</a>
            </li>
          ))}
        </ul>
      </section>

      <section class="lp-cta" aria-label="الخطوة التالية">
        <h2 class="lp-cta__heading">جاهز تبدأ؟</h2>
        <a href={lp.ctaHref} class="lp-cta__btn">{lp.ctaLabel}</a>
      </section>
    </main>

    <style>
      /* BAI-BG-VIDEO-001 (2026-08-29): this page owns its own <html> shell, so it
         needs its own stacking rule — the fixed background layer sits at z-index 0
         and every other body child has to paint above it. */
      :global(body > *:not([aria-hidden='true'])) {
        position: relative;
        z-index: 2;
      }
      .lp-page {
        max-inline-size: 72ch;
        margin-inline: auto;
        padding-block: var(--space-8);
        padding-inline: var(--space-4);
        color: var(--text-primary);
        /* Page-level fill removed so the background video shows through. .lp-hero
           and the section surfaces below still carry --bg-surface, which is what
           keeps the text readable. */
        background: transparent;
      }
      .lp-hero {
        padding-block: var(--space-10);
        padding-inline: var(--space-6);
        background: var(--bg-surface);
        border-radius: var(--radius-lg);
        margin-block-end: var(--space-8);
        text-align: center;
      }
      .lp-hero__h1 {
        margin: 0 0 var(--space-4);
        font-size: var(--text-3xl);
        color: var(--text-primary);
        line-height: 1.3;
      }
      .lp-hero__subtitle {
        margin: 0 0 var(--space-6);
        color: var(--text-secondary);
        line-height: 1.7;
        font-size: var(--text-lg);
      }
      .lp-hero__cta,
      .lp-cta__btn {
        display: inline-block;
        min-height: 44px;
        padding-inline: var(--space-6);
        padding-block: var(--space-3);
        background: var(--interactive-primary);
        color: var(--bg-base);
        border-radius: var(--radius-md);
        text-decoration: none;
        font-weight: 700;
      }
      .lp-hero__cta:hover,
      .lp-cta__btn:hover {
        background: var(--brand-400);
      }
      .lp-trust {
        margin-block-end: var(--space-8);
        padding: var(--space-6);
        background: var(--bg-elevated);
        border-radius: var(--radius-lg);
      }
      .lp-trust__heading {
        margin: 0 0 var(--space-4);
        font-size: var(--text-xl);
        color: var(--text-primary);
      }
      .lp-trust__list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .lp-trust__item {
        padding-block: var(--space-2);
        padding-inline-start: var(--space-4);
        border-inline-start: 3px solid var(--interactive-primary);
        margin-block-end: var(--space-2);
        color: var(--text-secondary);
      }
      .lp-body {
        margin-block-end: var(--space-8);
      }
      .lp-body__heading {
        margin: 0 0 var(--space-4);
        font-size: var(--text-2xl);
        color: var(--text-primary);
      }
      .lp-body__p {
        margin: 0 0 var(--space-4);
        color: var(--text-primary);
        line-height: 1.8;
      }
      .lp-faq {
        margin-block-end: var(--space-8);
      }
      .lp-faq__heading {
        margin: 0 0 var(--space-4);
        font-size: var(--text-2xl);
        color: var(--text-primary);
      }
      .lp-faq__item {
        margin-block-end: var(--space-3);
        padding: var(--space-4);
        background: var(--bg-surface);
        border-radius: var(--radius-md);
      }
      .lp-faq__q {
        font-weight: 700;
        color: var(--text-primary);
        cursor: pointer;
        min-height: 44px;
      }
      .lp-faq__a {
        margin: var(--space-3) 0 0;
        color: var(--text-secondary);
        line-height: 1.7;
      }
      .lp-links {
        margin-block-end: var(--space-8);
      }
      .lp-links__heading {
        margin: 0 0 var(--space-4);
        font-size: var(--text-xl);
        color: var(--text-primary);
      }
      .lp-links__list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: var(--space-2);
      }
      .lp-links__a {
        color: var(--interactive-primary);
        text-decoration: none;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }
      .lp-links__a:hover {
        text-decoration: underline;
      }
      .lp-cta {
        text-align: center;
        padding: var(--space-8);
        background: var(--bg-elevated);
        border-radius: var(--radius-lg);
      }
      .lp-cta__heading {
        margin: 0 0 var(--space-4);
        font-size: var(--text-2xl);
        color: var(--text-primary);
      }
      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </body>
</html>