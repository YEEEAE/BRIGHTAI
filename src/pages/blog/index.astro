---
/**
 * Blog listing page — /blog/
 *
 * REPORT-BLOG-2026-07-07: Server-rendered pagination (9/page) + server-side
 * category filter via query string. SSR-friendly:
 *   - `?page=2`     → second page (same listing).
 *   - `?category=X` → narrow the listing to the named category enum value.
 *   Combined: `/blog/?category=أمن-البيانات&page=2`.
 *
 *   All 22 published posts are exposed via static pagination URLs
 *   `/blog/`, `/blog/2/`, `/blog/3/`. Filtering is additive (no extra
 *   routes emitted). The page is data-derived (Content Collection).
 *
 *   Visual: preserves the existing 16-section RTL chip + listing-card
 *   design system. Categories render with the same tints as the article
 *   listing section. Reading-paths grid and featured cluster reflect
 *   the new 5-category enum.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  getPublishedPosts,
  getCategories,
  paginate,
  categoryTint,
  categoryFromSlug,
} from '../../data/blog';
import { SITE } from '../../data/site';
// BAI-SEO-003-S3 (2026-07-18): Organization import removed — foundation
// Schema.astro emits the canonical Organization @id. We keep this comment
// so future agents don't re-introduce the duplicate.

const PAGE_SIZE = 100;

const allPosts = await getPublishedPosts();
const categories = await getCategories();

// URL query → state.
const url = Astro.url;
const requestedPage = Math.max(1, parseInt(url.searchParams.get('page') ?? '1', 10) || 1);
const requestedCategory = url.searchParams.get('category');

// Filter by category (server-side); fall back to "all".
const filteredPosts = requestedCategory && categoryFromSlug(requestedCategory)
  ? allPosts.filter((p) => p.category === requestedCategory)
  : allPosts;
const activeCategory = requestedCategory && categoryFromSlug(requestedCategory) || null;

const pagination = paginate(filteredPosts, requestedPage, PAGE_SIZE, '/blog/');

// Featured (top of page) — first 3 newest, only when on page 1 with no
// category filter (so category pages feel lean and focused).
const featured = (activeCategory === null && requestedPage === 1)
  ? allPosts.slice(0, 3)
  : [];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'المدونة', item: `${SITE.url}/blog/` },
  ],
};

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'مدونة BrightAI | مقالات حوكمة AI والامتثال السعودي',
  description: 'مقالات تنفيذية من BrightAI عن حوكمة AI وPDPL وNCA ECC وسدايا وISO 42001 وAI Firewall، مخصصة للسوق السعودي وقطاعاته.',
  url: `${SITE.url}/blog/`,
  inLanguage: 'ar-SA',
  isPartOf: { '@id': 'https://brightai.site/#website' },
  publisher: { '@id': 'https://brightai.site/#organization' },
};

// BAI-SEO-003-S3 (2026-07-18): Organization and BreadcrumbList are
// emitted by the foundation Schema.astro. We keep only the page-specific
// CollectionPage node here to avoid duplicate @id warnings (verified
// via scripts/_check-duplicate-schema-ids.mjs).
const blogJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [collectionLd],
};

// Count per category (always over ALL posts, never the filtered list).
const categoryCounts = { all: allPosts.length } as Record<string, number>;
for (const cat of categories) {
  categoryCounts[cat] = allPosts.filter((p) => p.category === cat).length;
}

void categoryTint;

// Helper: build a paginated/filtered URL.
function pageUrl(page: number): string {
  const params = new URLSearchParams();
  if (activeCategory) params.set('category', activeCategory);
  if (page > 1) params.set('page', String(page));
  const qs = params.toString();
  return qs ? `/blog/?${qs}` : '/blog/';
}
---

<ArabicLayout
  title="مدونة BrightAI | مقالات حوكمة AI والامتثال السعودي"
  description="مقالات تنفيذية من BrightAI عن حوكمة AI وPDPL وNCA ECC وسدايا وISO 42001 وAI Firewall، مخصصة للسوق السعودي وقطاعاته."
  canonical={`${SITE.url}/blog/`}
  hreflang={[{ lang: 'ar-SA', href: `${SITE.url}/blog/` }]}
  jsonLd={blogJsonLd as any}
  currentPath="/blog/"
>
  <header class="blog-index__hero">
    <span class="chip chip--brand blog-index__eyebrow">
      <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-post"></use></svg>
      المدونة
    </span>
    <h1 class="blog-index__title">مقالات تخدم قرارك في حوكمة الذكاء الاصطناعي</h1>
    <p class="blog-index__lead">وش تبي تعرف عن حوكمة AI في السعودية؟ مدوّنتنا تجمع أدلة تنفيذية مختصرة — من السياسات إلى التطبيق — تساعدك تتخذ قرار أفضل لشركتك في الحوكمة، حماية البيانات، والامتثال.</p>
    <p class="blog-index__count">
      <strong>{allPosts.length}</strong>
      مقال منشور، محدث بصفة مستمرة
    </p>
    <div class="blog-index__hero-actions">
      <a href="/authors/nasser-alabdullah/">
        <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-account"></use></svg>
        ملف المؤلف ومقالاته
      </a>
      <a href="/rss.xml" target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-share"></use></svg>
        اشترك عبر RSS
      </a>
    </div>
  </header>

  {featured.length > 0 && (
    <section class="blog-section" aria-labelledby="featured-posts">
      <h2 id="featured-posts">مقالات مختارة</h2>
      <p>أفضل نقطة بداية لو كنت تبني برنامج حوكمة أو تراجع جاهزية استخدام AI داخل المؤسسة.</p>
      <div class="blog-featured">
        {featured.map((post, i) => (
          <a href={`/blog/${post.slug}/`}>
            <span class="blog-featured__tag">
              {i === 0 ? '⭐ مقال مميز' : `مقال ${i + 1}`}
            </span>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="blog-section" aria-labelledby="all-posts">
    <h2 id="all-posts">
      {activeCategory
        ? `مقالات في تصنيف «${activeCategory}»`
        : 'كل المقالات'}
    </h2>
    <p>
      {activeCategory
        ? `${filteredPosts.length} مقال في هذا التصنيف.`
        : 'مجموعة مرتبة من الأدلة والمقالات العملية المنشورة على BrightAI. فلتر بالفئة لو تبي تركيز أسرع.'}
    </p>

    <nav class="blog-filters" aria-label="تصفية بالفئة">
      <a
        href="/blog/"
        class={`blog-filters__btn ${activeCategory === null ? 'is-active' : ''}`}
      >
        الكل
        <span class="blog-filters__count">{categoryCounts.all}</span>
      </a>
      {categories.map((cat) => (
        <a
          href={`/blog/category/${cat}/`}
          class={`blog-filters__btn ${activeCategory === cat ? 'is-active' : ''}`}
          data-category={cat}
        >
          {cat}
          <span class="blog-filters__count">{categoryCounts[cat] ?? 0}</span>
        </a>
      ))}
    </nav>
  </section>

  <div class="blog-section blog-section--no-top-pad">
    <article class="listing-grid" id="blog-grid">
      {pagination.items.length === 0 && (
        <p class="listing-grid__empty">لا توجد مقالات في هذا التصنيف حتى الآن.</p>
      )}
      {pagination.items.map((post) => (
        <a href={`/blog/${post.slug}/`} class="listing-card" data-category={post.category} data-tint={categoryTint[post.category]}>
          <div class="listing-card__image" aria-hidden="true"></div>
          <div class="listing-card__body">
            <span class="listing-card__category">{post.category}</span>
            <h2>{post.title}</h2>
            <p class="listing-card__desc">{post.description}</p>
            <div class="listing-card__meta">
              <span>
                <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-calendar"></use></svg>
                {post.pubDate}
              </span>
              <span>
                <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-clock-outline"></use></svg>
                {post.readingTime} دقائق
              </span>
            </div>
          </div>
        </a>
      ))}
    </article>

    {pagination.pageCount > 1 && (
      <nav class="blog-pagination" aria-label="تصفح المقالات">
        <span class="blog-pagination__info">
          عرض {pagination.items.length} من {pagination.totalItems} مقال
          (صفحة {pagination.page} من {pagination.pageCount})
        </span>
        <div class="blog-pagination__actions">
          {pagination.hasPrev ? (
            <a href={pageUrl(pagination.page - 1)} class="blog-pagination__btn" aria-label="الصفحة السابقة" rel="prev">
              <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-arrow-right"></use></svg>
              السابق
            </a>
          ) : (
            <span class="blog-pagination__btn" aria-disabled="true">
              <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-arrow-right"></use></svg>
              السابق
            </span>
          )}
          {Array.from({ length: pagination.pageCount }, (_, i) => i + 1).map((p) => (
            <a
              href={pageUrl(p)}
              class={`blog-pagination__btn ${p === pagination.page ? 'is-active' : ''}`}
              aria-current={p === pagination.page ? 'page' : undefined}
            >
              {p}
            </a>
          ))}
          {pagination.hasNext ? (
            <a href={pageUrl(pagination.page + 1)} class="blog-pagination__btn" aria-label="الصفحة التالية" rel="next">
              التالي
              <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-arrow-left"></use></svg>
            </a>
          ) : (
            <span class="blog-pagination__btn" aria-disabled="true">
              التالي
              <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-arrow-left"></use></svg>
            </span>
          )}
        </div>
      </nav>
    )}
  </div>

  <Breadcrumbs crumbs={[{ label: 'الرئيسية', href: '/' }, { label: 'المدونة' }]} />

  <section class="blog-final-cta" aria-labelledby="blog-cta">
    <div class="card card--cta">
      <h2 id="blog-cta">تبي تحوّل القراءة لخطة حوكمة قابلة للتنفيذ؟</h2>
      <p>ابدأ بتقييم جاهزية حوكمة الذكاء الاصطناعي أو تواصل مع الفريق لترتيب جلسة تشخيص قصيرة. لمتابعة كل جديد في الحوكمة والامتثال، اشترك في <a href="/newsletter/">النشرة الأسبوعية لـ BrightAI</a>، أو تعرّف أكثر على <a href="/authors/brightai-team/">خلفية كتّاب المدونة</a>.</p>
      <div class="blog-final-cta__actions">
        <a href="/assessment/ai-governance-readiness/" class="btn btn--primary">
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-gauge"></use></svg>
          تقييم الجاهزية
        </a>
        <a href="/contact/" class="btn btn--outline">
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-email"></use></svg>
          تواصل مع الفريق
        </a>
      </div>
    </div>
  </section>

  {/* ═══════════════ BACK TO HOME + RELATED (BAI-LINK-01) ═══════════════ */}
  <section class="blog-section" aria-labelledby="back-to-home">
    <div class="blog-final-cta__actions" style="justify-content: center; margin-bottom: 2rem;">
      <a href="/" class="btn btn--outline">
        <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-arrow-right"></use></svg>
        العودة إلى الرئيسية
      </a>
    </div>
  </section>

  <section class="blog-section" aria-labelledby="related-content">
    <h2 id="related-content">محتويات ذات صلة</h2>
    <p>استكشف حلولنا ووثائقنا لتعميق فهمك لحوكمة الذكاء الاصطناعي.</p>
    <div class="blog-featured" style="grid-template-columns: repeat(2, 1fr);">
      <a href="/solutions/">
        <span class="blog-featured__tag">💡 الحلول</span>
        <h3>حلول حوكمة وأمان الذكاء الاصطناعي</h3>
        <p>كل حلول BrightAI التقنية: AI Firewall، سجل التدقيق، الموافقات البشرية، ملف الأدلة، وأنظمة الحوكمة.</p>
      </a>
      <a href="/docs/">
        <span class="blog-featured__tag">📚 الوثائق</span>
        <h3>مركز الوثائق — 30+ دليل حوكمة AI</h3>
        <p>أكثر من ٣٠ وثيقة شاملة تغطي الحوكمة، الامتثال، إدارة المخاطر، والتطبيق التقني.</p>
      </a>
    </div>
  </section>
</ArabicLayout>

<style>
  .listing-grid__empty {
    color: var(--text-secondary);
    padding: var(--space-12) var(--space-4);
    text-align: center;
    border: 1px dashed var(--text-muted);
    border-radius: var(--radius-lg);
    margin-block: var(--space-6);
  }
  .blog-pagination__btn[aria-disabled='true'] {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }
  .blog-pagination__btn.is-active {
    background: var(--interactive-primary);
    color: var(--bg-base);
    font-weight: 700;
  }
  .blog-filters__btn.is-active {
    background: var(--interactive-primary);
    color: var(--bg-base);
    border-color: transparent;
  }
  /* Make <a> filter buttons look identical to <button> ones. */
  .blog-filters__btn {
    text-decoration: none;
  }
</style>
