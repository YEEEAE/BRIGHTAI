      {
        q: 'ما هي أبرز التحديات التي واجهتها المنشآت في دراسات الحالة الميدانية؟',
        a: 'أبرز التحديات تمثلت في مكافحة استخدام أدوات الذكاء الاصطناعي غير المصرح بها من الموظفين (Shadow AI)، وصعوبة موازنة سرعة الابتكار مع متطلبات الامتثال والتوثيق، وغياب سجلات التدقيق للمخرجات الذكية.',
      },
      {
        q: 'هل توفر BrightAI دراسات حالة مفصلة حسب كل قطاع تنظيمي؟',
        a: 'نعم، نوفر دراسات حالة تفصيلية تشتمل على المخططات المعمارية، وتوزيع الصلاحيات، ومصفوفة المخاطر المعتمدة لقطاعات البنوك، والصحة، والأدوية، والقطاع الحكومي.',
      },
    ],
  },
  'أمن-البيانات': {
    title: 'أمن البيانات وحمايتها في عصر الذكاء الاصطناعي وفق الأنظمة السعودية',
    intro: 'تمثل البيانات الوقود الأساسي لنماذج الذكاء الاصطناعي، ولكنها في الوقت ذاته النقطة الأكثر حساسية وتعرضاً للمخاطر. يختص هذا القسم باستعراض استراتيجيات تأمين البيانات، وتطبيق نظام حماية البيانات الشخصية السعودي (PDPL)، وضوابط الأمن السيبراني للهيئة الوطنية للأمن السيبراني (NCA).',
    pillars: [
      {
        title: 'نظام حماية البيانات الشخصية السعودي (PDPL) والذكاء الاصطناعي',
        content: 'يفرض نظام PDPL شروطاً صارمة على جمع ومعالجة ومشاركة البيانات الشخصية للمواطنين والمقيمين. نوضح هنا كيفية تدريب ونشر النماذج الذكية دون انتهاك الخصوصية، وآليات معالجة طلبات أصحاب البيانات كحق الوصول والمسح والتصحيح عند استخدام البيانات في النماذج التحليلية والتوليدية.',
      },
      {
        title: 'ضوابط الأمن السيبراني الأساسية (NCA ECC) وضوابط الحوسبة السحابية (CSCC)',
        content: 'متطلبات تطبيق ضوابط الهيئة الوطنية للأمن السيبراني لحماية أصول الذكاء الاصطناعي ومراكز البيانات؛ بما يشمل إدارة الثغرات الخوارزمية، والتشفير أثناء النقل والتخزين، وتأمين المفاتيح التشفيرية، وتطبيق سياسات المصادقة متعددة العوامل والتحكم الدقيق بالوصول المبني على الأدوار (RBAC).',
      },
      {
        title: 'تقنيات التعمية وإخفاء الهوية اللحظية (PII Masking & Anonymization)',
        content: 'كيفية استخدام خوارزميات الذكاء الاصطناعي المتقدمة في اكتشاف البيانات المعرفة للشخصية وتعميتها آلياً قبل إرسالها إلى النماذج اللغوية، بما يحقق الاستفادة القصوى من قوة الاستدلال والتحليل الذكي دون تعريض الهويات الوطنية أو البيانات المصرفية والطبية لأي مخاطر كشف.',
      },
      {
        title: 'إدارة مخاطر سلاسل الإمداد ومزودي نماذج الذكاء الاصطناعي',
        content: 'تقييم المخاطر السيبرانية المرتبطة بالاعتماد على مزودي النماذج السحابية الخارجيين، وفحص شروط الاستخدام وسياسات الاحتفاظ بالبيانات (Data Retention)، وضمان عدم استخدام استعلامات المنشأة الحساسة في إعادة تدريب النماذج العامة لدى الشركات الأجنبية.',
      },
    ],
    faq: [
      {
        q: 'هل يعتبر إرسال بيانات العمل لنماذج الذكاء الاصطناعي السحابية انتهاكاً لنظام PDPL؟',
        a: 'إذا كانت البيانات تتضمن معلومات شخصية أو حساسة ولم يحصل المستفيد على الموافقات النظامية أو تم نقلها لسيرفرات خارج المملكة دون الالتزام بضوابط نقل البيانات عبر الحدود، فإن ذلك يعد مخالفة صريحة لنظام PDPL قد تعرض المنشأة لعقوبات صارمة.',
      },
      {
        q: 'كيف يساعد جدار حماية الذكاء الاصطناعي (AI Firewall) في الامتثال لنظام PDPL؟',
        a: 'يقوم جدار الحماية بفحص كل استعلام قبل خروجه، وتعمية أو حجب الأسماء، وأرقام الهوية، وأرقام الجوالات، والبطاقات البنكية، والبيانات الحساسة آلياً، مما يضمن معالجة الاستعلام بأمان دون تسريب أي بيانات شخصية.',
      },
      {
        q: 'ما هي أفضل الممارسات لتخزين سجلات الاستعلامات الذكية دون انتهاك الخصوصية؟',
        a: 'تخزين السجلات في قواعد بيانات مشفرة سيادياً مع تعمية البيانات الشخصية، وتحديد فترات احتفاظ متوافقة مع السياسات الداخلية، وتقييد صلاحيات الاطلاع على السجلات لموظفي الامتثال والتدقيق المعتمدين فقط.',
      },
    ],
  },
};

const guide = CATEGORY_GUIDES[category] || CATEGORY_GUIDES['ذكاء-اصطناعي'];

const descriptionByCategory: Record<typeof category, string> = {
  'ذكاء-اصطناعي': 'مقالات عن حوكمة الذكاء الاصطناعي ومنصات BrightAI وأخلاقيات AI. محتوى تنفيذي مخصص للسوق السعودي.',
  'رؤية-2030': 'مقالات عن الذكاء الاصطناعي في إطار رؤية 2030 والتحول الرقمي السعودي.',
  'تحول-رقمي': 'مقالات عن مسارات التحول الرقمي، ISO/IEC 42001، وسجلات تدقيق AI.',
  'دراسات-حالة': 'دراسات حالة سعودية عن تطبيق AI في قطاعات الصحة والبنوك والحكومة.',
  'أمن-البيانات': 'مقالات عن حماية البيانات في AI، PDPL، NCA ECC، SDAIA، AI Firewall، Red Teaming.',
};

const categoryLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category} | مدونة BrightAI`,
  description: descriptionByCategory[category],
  url: `${SITE.url}/blog/category/${category}/`,
  inLanguage: 'ar-SA',
  isPartOf: { '@id': 'https://brightai.live/#website' },
  publisher: { '@id': 'https://brightai.live/#organization' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [categoryLd, faqLd],
};

void categoryTint;
---

<ArabicLayout
  title={`${category} | مدونة BrightAI`}
  description={descriptionByCategory[category]}
  canonical={`${SITE.url}/blog/category/${category}/`}
  hreflang={[{ lang: 'ar-SA', href: `${SITE.url}/blog/category/${category}/` }]}
  jsonLd={jsonLd as any}
  currentPath={`/blog/category/${category}/`}
  breadcrumbs={[
    { name: 'المدونة', href: '/blog/' },
    { name: category, href: `/blog/category/${category}/` },
  ]}
>
  <header class="blog-index__hero">
    <span class="chip chip--brand blog-index__eyebrow">
      <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-tag"></use></svg>
      تصنيف
    </span>
    <h1 class="blog-index__title">{category}</h1>
    <p class="blog-index__lead">{descriptionByCategory[category]}</p>
    <p class="blog-index__count">
      <strong>{postsInCategory.length}</strong>
      مقال في هذا التصنيف
    </p>
    <div class="blog-index__hero-actions">
      <a href="/blog/">
        <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-arrow-right"></use></svg>
        كل المقالات
      </a>
      <a href="/rss.xml" target="_blank" rel="noopener noreferrer">
        <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-share"></use></svg>
        اشترك عبر RSS
      </a>
    </div>
  </header>

  <div class="blog-section">
    <article class="listing-grid">
      {pagination.items.length === 0 && (
        <p class="listing-grid__empty">لا توجد مقالات في هذا التصنيف حتى الآن.</p>
      )}
      {pagination.items.map((post) => (
        <a href={`/blog/${post.slug}/`} class="listing-card" data-category={post.category}>
          <div class="listing-card__image" aria-hidden="true"></div>
          <div class="listing-card__body">
            <span class="listing-card__category">{post.category}</span>
            <h2>{post.title}</h2>
            <p class="listing-card__desc">{post.description}</p>
            <div class="listing-card__meta">
              <span>
                <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-calendar"></use></svg>
                {post.pubDate}
              </span>
              <span>
                <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-clock-outline"></use></svg>
                {post.readingTime} دقائق
              </span>
            </div>
          </div>
        </a>
      ))}
    </article>

    {pagination.pageCount > 1 && (
      <nav class="blog-pagination" aria-label="تصفح المقالات">
        <span class="blog-pagination__info">
          صفحة {pagination.page} من {pagination.pageCount}
        </span>
        <div class="blog-pagination__actions">
          {pagination.hasPrev ? (
            <a href={pageUrl(pagination.page - 1)} class="blog-pagination__btn" rel="prev">السابق</a>
          ) : (
            <span class="blog-pagination__btn" aria-disabled="true">السابق</span>
          )}
          {Array.from({ length: pagination.pageCount }, (_, i) => i + 1).map((p) => (
            <a
              href={pageUrl(p)}
              class={`blog-pagination__btn ${p === pagination.page ? 'is-active' : ''}`}
              aria-current={p === pagination.page ? 'page' : undefined}
            >{p}</a>
          ))}
          {pagination.hasNext ? (
            <a href={pageUrl(pagination.page + 1)} class="blog-pagination__btn" rel="next">التالي</a>
          ) : (
            <span class="blog-pagination__btn" aria-disabled="true">التالي</span>
          )}
        </div>
      </nav>
    )}
  </div>

  <!-- Authoritative Pillar Guide for Category -->
  <section class="cat-guide-section" aria-labelledby="cat-guide-title">
    <div class="cat-guide-box">
      <div class="cat-guide-header">
        <span class="chip chip--brand">دليل مرجعي تحليلي</span>
        <h2 id="cat-guide-title" class="cat-guide-title">{guide.title}</h2>
        <p class="cat-guide-intro">{guide.intro}</p>
      </div>

      <div class="cat-pillars-grid">
        {guide.pillars.map((pillar, idx) => (
          <div class="cat-pillar-card">
            <div class="cat-pillar-badge">{idx + 1}</div>
            <h3 class="cat-pillar-card-title">{pillar.title}</h3>
            <p class="cat-pillar-card-content">{pillar.content}</p>
          </div>
        ))}
      </div>

      <div class="cat-faq-block">
        <h3 class="cat-faq-header">أسئلة شائعة حول {category} في السعودية</h3>
        <div class="cat-faq-grid">
          {guide.faq.map((item) => (
            <div class="cat-faq-card">
              <h4 class="cat-faq-q">{item.q}</h4>
              <p class="cat-faq-a">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="blog-final-cta" aria-labelledby="cat-cta">
    <div class="card card--cta">
      <h2 id="cat-cta">تبي تتعمق في {category}؟</h2>
      <p>ابدأ بتقييم جاهزية حوكمة الذكاء الاصطناعي أو تواصل مع الفريق لترتيب جلسة تشخيص قصيرة.</p>
      <div class="blog-final-cta__actions">
        <a href="/assessment/ai-governance-readiness/" class="btn btn--primary">
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-gauge"></use></svg>
          تقييم الجاهزية
        </a>
        <a href="/contact/" class="btn btn--outline">
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-email"></use></svg>
          تواصل مع الفريق
        </a>
      </div>
    </div>
  </section>
</ArabicLayout>

<style>
  .listing-grid__empty {
    color: var(--text-secondary);
    padding: var(--space-12) var(--space-4);
    text-align: center;
    border: 1px dashed var(--text-muted);
    border-radius: var(--radius-lg);
    margin-block: var(--space-6);
  }
  .blog-pagination__btn[aria-disabled='true'] {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }
  .blog-pagination__btn.is-active {
    background: var(--interactive-primary);
    color: var(--bg-base);
    font-weight: 700;
  }

  .cat-guide-section {
    max-width: 80rem;
    margin: var(--space-12) auto;
    padding: 0 var(--space-5);
  }
  .cat-guide-box {
    background: var(--surface-subtle, rgba(255,255,255,0.02));
    border: 1px solid var(--border-subtle, rgba(255,255,255,0.08));
    border-radius: var(--radius-xl, 1rem);
    padding: var(--space-8);
  }
  .cat-guide-title {
    font-size: var(--text-2xl, 1.75rem);
    font-weight: 800;
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }
  .cat-guide-intro {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.8;
    max-width: 65ch;
  }
  .cat-pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
    margin-bottom: var(--space-10);
  }
  .cat-pillar-card {
    background: var(--surface-card, rgba(255,255,255,0.03));
    border: 1px solid var(--border-subtle, rgba(255,255,255,0.06));
    border-radius: var(--radius-lg, 0.75rem);
    padding: var(--space-6);
    position: relative;
  }
  .cat-pillar-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--brand-soft, rgba(20,184,166,0.15));
    color: var(--interactive-primary, #14b8a6);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }
  .cat-pillar-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }
  .cat-pillar-card-content {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .cat-faq-block {
    border-top: 1px solid var(--border-subtle, rgba(255,255,255,0.08));
    padding-top: var(--space-8);
  }
  .cat-faq-header {
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: var(--space-6);
    color: var(--text-primary);
  }
  .cat-faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }
  .cat-faq-card {
    background: var(--surface-card, rgba(255,255,255,0.02));
    border: 1px solid var(--border-subtle, rgba(255,255,255,0.05));
    border-radius: var(--radius-md, 0.5rem);
    padding: var(--space-5);
  }
  .cat-faq-q {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .cat-faq-a {
    font-size: 0.925rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
</style>
