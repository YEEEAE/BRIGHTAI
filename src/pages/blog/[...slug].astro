const faqNode = FAQ_BY_SLUG[post.slug]
  ? { ...getFaqLd(FAQ_BY_SLUG[post.slug]), '@id': `${post.canonical}#faq` }
  : null;

const extraSchemaNodes: Record<string, unknown>[] = [itemListNode, faqNode].filter(
  (n): n is Record<string, unknown> => Boolean(n),
);

// BAI-SEO-003-S7 (2026-07-18): P0 snippet pack — TL;DR / الخلاصة.
// The aside is rendered inside the `article` slot (below the
// article-hero, above the main content). The post-build
// apply-speakable-schema.mjs picks up the new selector from the HTML
// and wires it into the WebPage SpeakableSpecification — so the
// source-time FoundationSchema stays untouched for non-P0 blog
// posts (no schema references a non-existent element).
const p0Snippet = getP0Snippet(`/blog/${post.slug}/`);
---

<BlogLayout
  post={post}
  relatedPosts={relatedPosts}
  internalLinks={internalLinks}
  breadcrumbLd={breadcrumbLd}
  extraSchemaNodes={extraSchemaNodes}
  headings={tocHeadings}
>
  <Fragment slot="header">
    <Breadcrumbs crumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'المدونة', href: '/blog/' },
      { label: post.title },
    ]} />
  </Fragment>

  <Fragment slot="article">
    {p0Snippet && (
      <aside data-snippet="tl-dr" aria-label="الخلاصة" class="answer-first-summary">
        <p>{p0Snippet.text}</p>
      </aside>
    )}
    <Content />
  </Fragment>
  <Fragment slot="footer">
    <div style="display: flex; justify-content: center; margin-block: 2rem;">
      <a href="/blog/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white border border-white/20 hover:border-cyan-500/40 transition-all">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-arrow-right"></use></svg>
        العودة إلى المدونة
      </a>
    </div>
  </Fragment>
</BlogLayout>
