/**
 * Blog article dynamic page — /blog/<slug>/
 *
 * REPORT-BLOG-2026-07-07: rewrite against the Content Collection.
 *   - Data lookup via collection helpers.
 *   - Body markdown rendered with entry.render() into a named slot.
 *   - BlogPosting JSON-LD.
 *   - Same-category first related posts, then tag-overlap.
 *
 * REPORTS-AEO-FAQ-2026-07-08: Pillar blog posts now attach a `FAQPage`
 * JSON-LD node via the existing `extraSchemaNodes` prop on BlogLayout.
 * The FAQ content is AEO-tuned (40-60 word answers derived from the
 * article body) for Google AI Overviews / Perplexity citation.
 */
import BlogLayout from '../../layouts/BlogLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPostBySlug, getRelatedPosts } from '../../data/blog';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../data/site';
import { getFaqLd } from '../../data/schema-helpers';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  return entries
    .filter((e) => !e.data.draft)
    .map((entry) => ({
      params: { slug: entry.data.slug || entry.id.replace(/\.md$/, '') },
      props: { entry },
    }));
}

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<'blog'>>>[number];
}

const { entry } = Astro.props as Props;
const slug = Astro.params.slug as string;
const post = (await getPostBySlug(slug))!;
const { Content } = await render(entry);

