---
/**
 * Blog article dynamic page — /blog/<slug>/
 *
 * REPORT-BLOG-2026-07-07: rewrite against the Content Collection.
 *   - Data lookup via collection helpers.
 *   - Body markdown rendered with entry.render() into a named slot.
 *   - BlogPosting JSON-LD.
 *   - Same-category first related posts, then tag-overlap.
 *
 * REPORTS-AEO-FAQ-2026-07-08: Pillar blog posts now attach a `FAQPage`
 * JSON-LD node via the existing `extraSchemaNodes` prop on BlogLayout.
 * The FAQ content is AEO-tuned (40-60 word answers derived from the
 * article body) for Google AI Overviews / Perplexity citation.
 */
import BlogLayout from '../../layouts/BlogLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPostBySlug, getRelatedPosts } from '../../data/blog';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../data/site';
import { getFaqLd } from '../../data/schema-helpers';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  return entries
    .filter((e) => !e.data.draft)
    .map((entry) => ({
      params: { slug: entry.data.slug || entry.id.replace(/\.md$/, '') },
      props: { entry },
    }));
}

interface Props {
  entry: Awaited<ReturnType<typeof getCollection<'blog'>>>[number];
}

const { entry } = Astro.props as Props;
const slug = Astro.params.slug as string;
const post = (await getPostBySlug(slug))!;
const { Content } = await render(entry);

const INTERNAL_LINKS_BY_CATEGORY: Record<string, Array<{ href: string; label: string }>> = {
  'ذكاء-اصطناعي': [
    { href: '/solutions/ai-governance-platform/', label: 'حل حوكمة AI' },
    { href: '/docs/ai-audit-trail/', label: 'توثيق سجل التدقيق' },
    { href: '/hub/ai-governance/', label: 'مركز حوكمة AI' },
    { href: '/hub/compliance/', label: 'مركز الامتثال' },
  ],
  'رؤية-2030': [
    { href: '/hub/', label: 'مركز المعرفة' },
    { href: '/solutions/ai-governance-platform/', label: 'حل حوكمة AI' },
    { href: '/assessment/ai-governance-readiness/', label: 'تقييم الجاهزية' },
    { href: '/contact/', label: 'تواصل مع الفريق' },
  ],
  'تحول-رقمي': [
    { href: '/solutions/ai-audit-trail/', label: 'سجل التدقيق' },
    { href: '/docs/ai-audit-trail/', label: 'توثيق سجل التدقيق' },
    { href: '/hub/compliance/', label: 'مركز الامتثال' },
    { href: '/assessment/ai-governance-readiness/', label: 'تقييم الجاهزية' },
  ],
  'دراسات-حالة': [
    { href: '/solutions/healthcare-ai-governance/', label: 'قطاع الصحة' },
    { href: '/solutions/banking-ai-governance/', label: 'قطاع البنوك' },
    { href: '/hub/', label: 'مركز المعرفة' },
    { href: '/contact/', label: 'تواصل مع الفريق' },
  ],
  'أمن-البيانات': [
    { href: '/solutions/ai-firewall/', label: 'جدار حماية AI' },
    { href: '/solutions/ai-audit-trail/', label: 'سجل التدقيق' },
    { href: '/solutions/ai-risk-classification/', label: 'تصنيف مخاطر AI' },
    { href: '/hub/security/', label: 'مركز الأمان' },
  ],
};

const internalLinks = INTERNAL_LINKS_BY_CATEGORY[post.category] || [];

// Prefer same-category related posts; fall back to broader tag-overlap.
const allRelated = await getRelatedPosts(post.slug, 20);
const sameCategory = allRelated.filter((p) => p.category === post.category).slice(0, 3);
const relatedPosts = sameCategory.length > 0 ? sameCategory : allRelated.slice(0, 3);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'المدونة', item: `${SITE.url}/blog/` },
    { '@type': 'ListItem', position: 3, name: post.title, item: post.canonical },
  ],
};

// REPORT-SEO-KEYWORDS-2026-07-08: ItemList schema for the best-AI-companies
// article. The page is a comparison list, so we expose the curated list of
// provider archetypes as an ItemList of ListItem nodes. Google reads this
// directly from the @graph in the page JSON-LD. The items mirror the
// numbered list rendered in the article body.
const itemListNode: Record<string, unknown> | null =
  post.slug === 'best-ai-companies-saudi-2026'
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        '@id': `${post.canonical}#itemlist`,
        name: 'أنواع مزودي خدمات الذكاء الاصطناعي في السعودية',
        description:
          'قارنة مرقّمة لأنواع مزودي الذكاء الاصطناعي في السوق السعودي 2026: شركات عالمية كبرى، شركات محلية متخصصة، شركات ناشئة، ومزودو قطاعات.',
        itemListOrder: 'https://schema.org/ItemListOrderAscending',
        numberOfItems: 6,
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'الشركات العالمية الكبرى',
            description:
              'منصات سحابية ونماذج لغوية كبيرة — قوية في البنية التحتية ومحدودة في الفهم العميق للبيئة التنظيمية السعودية.',
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'الشركات المحلية المتخصصة في حوكمة AI',
            description:
              'شركات سعودية تركز على حوكمة وأمن وتطبيقات AI المتوافقة مع PDPL وNCA ECC وإرشادات سدايا.',
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: 'الشركات الناشئة والشركات الصغيرة',
            description:
              'تركيز على حالات استخدام محددة مثل الرؤية الحاسوبية ومعالجة اللغة العربية والذكاء الاصطناعي التوليدي المتخصص.',
          },
          {
            '@type': 'ListItem',
            position: 4,
            name: 'الشركات المتخصصة في القطاعات المنظمة',
            description:
              'تركيز على قطاعات محددة مثل الصحة والبنوك والحكومة مع فهم عميق لمتطلبات SFDA وSAMA وDGA.',
          },
          {
            '@type': 'ListItem',
            position: 5,
            name: 'فِرَق داخلية (In-house AI teams)',
            description:
              'فِرَق مؤسسية تبني حلول AI داخلية تحت إشراف حوكمة محلية وداعمة للامتثال الكامل.',
          },
          {
            '@type': 'ListItem',
            position: 6,
            name: 'الجامعات ومراكز البحث',
            description:
              'مراكز بحثية سعودية (مثل جامعة الملك عبدالله للعلوم والتقنية) تنتج أبحاث AI تطبيقية قابلة للتطبيق التجاري.',
          },
        ],
      }
    : null;

// REPORTS-AEO-FAQ-2026-07-08: AEO FAQ schemas for pillar blog posts.
// Each entry is {q, a} where a is a 40-60 word Saudi-dialect answer
// derived from the article body (no fabrication).
const FAQ_BY_SLUG: Record<string, Array<{ q: string; a: string }>> = {
  'pdpl-compliance-guide-saudi-companies': [
    {
      q: 'ما هي متطلبات نظام حماية البيانات الشخصية السعودي للشركات؟',
      a: 'PDPL يفرض خمس متطلبات أساسية: (1) أساس نظامي واضح لكل معالجة بيانات شخصية (موافقة، عقد، مصلحة مشروعة)، (2) حقوق أصحاب البيانات الستة (العلم، الوصول، التصحيح، الحذف، الاعتراض، النقل)، (3) سجل معالجات شامل، (4) تقييم أثر خصوصية DPIA للمعالجات عالية المخاطر، (5) إخطار سدايا عند الاختراق خلال فترات محددة.',
    },
    {
      q: 'ما عقوبات مخالفة نظام حماية البيانات الشخصية السعودي؟',
      a: 'العقوبات تتراوح بين الإنذار الكتابي وغرامات مالية تصل إلى 18 مليون ريال سعودي أو 2.5% من الإيرادات السنوية للمنشأة (أيهما أعلى)، إضافة إلى تعليق عمليات المعالجة جزئياً أو كلياً. تشديد العقوبات يأخذ منحى تصاعدياً مع ازدياد حالات التفتيش الميداني من سدايا، والسنوات الأخيرة شهدت غرامات فعلية.',
    },
    {
      q: 'كيف يؤثر PDPL على أنظمة الذكاء الاصطناعي والتعلم الآلي؟',
      a: 'يطبَّق PDPL على أي نظام AI يعالج بيانات شخصية. يتطلب توثيق الأساس النظامي لكل عملية تدريب أو استدلال، وحظر نقل البيانات للخوادم الخارجية بدون ضوابط، ومنع حفظ النموذج لبيانات شخصية بدون موافقة. كما يستلزم تسجيل جميع القرارات الآلية في سجل تدقيق قابل للمراجعة من الجهة المختصة عند الطلب.',
    },
  ],
  'what-is-ai-governance-saudi-companies': [
    {
      q: 'ما هي حوكمة الذكاء الاصطناعي ولماذا تحتاجها المنشآت السعودية؟',
      a: 'حوكمة الذكاء الاصطناعي هي منظومة من الأدوار والسياسات والضوابط والأدلة التي تنظم كيفية اختيار واستخدام ومراقبة AI داخل المنشأة. تحتاجها المنشآت السعودية لأنها: (1) تمكّن الابتكار المتحكم به، (2) تحقق الامتثال لـ PDPL وNCA وSDAIA، (3) تثبت المسؤولية عند الحوادث، (4) تبني ثقة العملاء والمستثمرين، (5) تحمي البيانات الحساسة من التسريب.',
    },
    {
      q: 'ما مكونات إطار حوكمة الذكاء الاصطناعي الفعّال؟',
      a: 'إطار الحوكمة الفعّال يتكون من: (1) جرد حالات الاستخدام والموردين، (2) تصنيف المخاطر حسب نوع البيانات والأثر، (3) سياسات استخدام واضحة، (4) ضوابط تقنية (جدار AI، فحص بيانات)، (5) موافقات بشرية للقرارات الحساسة، (6) سجل تدقيق شامل، (7) ملف أدلة قابل للمراجعة، (8) مؤشرات أداء وتقارير دورية للإدارة العليا.',
    },
    {
      q: 'كيف تبدأ منشأتك في تطبيق حوكمة الذكاء الاصطناعي؟',
      a: 'ابدأ بخمس خطوات: (1) جرد حالات الاستخدام والموردين، (2) تصنيف المخاطر حسب نوع البيانات والأثر، (3) تعيين مسؤول حوكمة AI، (4) صياغة سياسات استخدام قصيرة ومحددة، (5) تطبيق الضوابط التقنية (جدار، سجل تدقيق، موافقات بشرية). ثم وسّع تدريجياً: تدريب الموظفين، ربط بـ PDPL وNCA وSDAIA، قياس النضج، التحسين المستمر كل ربع سنة.',
    },
  ],
  'best-ai-companies-saudi-2026': [
    {
      q: 'ما أفضل شركات الذكاء الاصطناعي في السعودية للمؤسسات؟',
      a: 'السوق السعودي 2026 يضم ستة أنواع من الشركات: (1) عالمية كبرى (Google, Microsoft, AWS) بقوة بنية تحتية وفهم تنظيمي محدود، (2) محلية متخصصة بحوكمة AI (مثل BrightAI) بفهم عميق للسوق السعودي، (3) ناشئة صغيرة بمرونة عالية، (4) متخصصة قطاعية (صحة، بنوك، تعليم)، (5) فِرَق داخلية، (6) جامعات ومراكز بحث. الاختيار يعتمد على القطاع والحجم ومتطلبات الامتثال.',
    },
    {
      q: 'ما معايير اختيار شركة حوكمة ذكاء اصطناعي في السعودية؟',
      a: 'خمسة معايير أساسية: (1) الامتثال لـ PDPL وضوابط NCA ECC (شهادات ISO 42001 و27001)، (2) السجل في السوق السعودي ودراسات حالة موثقة، (3) الفهم العميق للغة العربية واللهجات، (4) القدرة على التكامل مع ERP وCRM وSAP، (5) سجلات تدقيق شفافة قابلة للمراجعة. اطلب مراجع من 3 عملاء سابقين واختبر النماذج على بياناتك الحقيقية.',
    },
    {
      q: 'ما الفرق بين شركات حوكمة AI ومزودي النماذج اللغوية؟',
      a: 'شركات حوكمة AI (مثل BrightAI) تركز على السياسات والضوابط والامتثال والتدقيق — تبني طبقة وسيطة تحمي المؤسسة. مزودو النماذج اللغوية (مثل OpenAI, Anthropic, علام) يقدمون النماذج وقدرات المعالجة. كلاهما ضروري: النموذج بدون حوكمة خطر امتثالي، والحوكمة بدون نموذج قوي محدودة الأثر. التكامل بينهما هو الحل الأمثل.',
    },
  ],
  'iso-42001-saudi-implementation-guide': [
    {
      q: 'ما هو معيار ISO 42001 وكيف يختلف عن ISO 27001؟',
      a: 'ISO/IEC 42001 هو أول معيار دولي لنظام إدارة الذكاء الاصطناعي (AIMS)، صدر في 2023. يحدد إطاراً شاملاً لإدارة مخاطر AI وتوثيقها والتحكم بها عبر دورة الحياة. ISO 27001 معيار أمن المعلومات العام. الـ 42001 مكمل لـ 27001 وليس بديلاً: يضيف حوكمة AI على البنية الأمنية الموجودة. المنشآت السعودية تستخدمهما معاً للامتثال الشامل.',
    },
    {
      q: 'كيف تحصل منشأة سعودية على شهادة ISO 42001؟',
      a: 'خمس مراحل: (1) فجوة تحليل (Gap Analysis) لتقييم الوضع الحالي، (2) بناء نظام AIMS بسياسات وأهداف ومؤشرات، (3) تطبيق الضوابط التشغيلية (جدار AI، سجل تدقيق، موافقات)، (4) تدريب الموظفين والتدقيق الداخلي، (5) تدقيق خارجي من جهة معتمدة. المدة الإجمالية 6-12 شهراً. الشهادة صالحة 3 سنوات مع تدقيقات مراقبة سنوية.',
    },
    {
      q: 'هل ISO 42001 إلزامي في السعودية؟',
      a: 'حالياً ISO 42001 تطوعي في السعودية، لكنه متوافق مع متطلبات SDAIA وNCA. يكتسب قوة من: (1) كونه مرجعاً دولياً معتمداً لجهات التدقيق، (2) قبوله كدليل امتثال في المناقصات الحكومية الكبرى، (3) ربطه مع PDPL ونظام NCA ECC. المنشآت التي تستهدف أسواقاً دولية أو عملاء كباراً (بنوك، اتصالات) تجد فيه ميزة تنافسية قوية.',
    },
  ],
};

const faqNode = FAQ_BY_SLUG[post.slug]
  ? { ...getFaqLd(FAQ_BY_SLUG[post.slug]), '@id': `${post.canonical}#faq` }
  : null;

const extraSchemaNodes: Record<string, unknown>[] = [itemListNode, faqNode].filter(
  (n): n is Record<string, unknown> => Boolean(n),
);
---

<BlogLayout
  post={post}
  relatedPosts={relatedPosts}
  internalLinks={internalLinks}
  breadcrumbLd={breadcrumbLd}
  extraSchemaNodes={extraSchemaNodes}
>
  <Fragment slot="header">
    <Breadcrumbs crumbs={[
      { label: 'الرئيسية', href: '/' },
      { label: 'المدونة', href: '/blog/' },
      { label: post.title },
    ]} />
  </Fragment>

  <Fragment slot="article">
    <Content />
  </Fragment>
</BlogLayout>
