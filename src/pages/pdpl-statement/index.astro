---
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { getLanguageCounterpart, getLegalAlternates } from '../../data/i18n-pairs';
import { legal_pdpl_statement } from '../../data/legal-content-inline';
import DOMPurify from 'isomorphic-dompurify';
const route = '/pdpl-statement/';
const canonical = `https://brightai.live${route}`;
const legalContent = legal_pdpl_statement;
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
  { '@type': 'Article', headline: legalContent.h1, url: canonical, inLanguage: 'ar-SA', author: { '@type': 'Organization', name: 'BrightAI', url: 'https://brightai.live' }, datePublished: '2025-09-15', dateModified: '2026-06-29', publisher: { '@type': 'Organization', name: 'BrightAI' } },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://brightai.live/' }, { '@type': 'ListItem', position: 2, name: legalContent.h1, item: canonical }] },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
]};
---
<ArabicLayout title="نظام حماية البيانات الشخصية وPDPL | بيان BRIGHTAI" description="اقرأ بيان BRIGHTAI عن نظام حماية البيانات الشخصية وPDPL والذكاء الاصطناعي ودعمنا لحماية البيانات ضمن خدمات الحوكمة (ليس شهادة امتثال)." canonical={canonical} hreflang={getLegalAlternates(route, 'ar')} jsonLd={jsonLd} currentPath={route} languageCounterpart={getLanguageCounterpart(route)} breadcrumbs={[{ name: 'نظام حماية البيانات الشخصية وPDPL', href: '/pdpl-statement/' }]}>
  <div class="legal-page" set:html={DOMPurify.sanitize(legalContent.html)} />
</ArabicLayout>
