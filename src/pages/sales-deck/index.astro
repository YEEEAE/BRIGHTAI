---
/**
 * Sales Deck (AR) — /sales-deck/
 * Printable slide deck for the BrightAI sales team.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import SalesDeck from '../../components/SalesDeck.astro';

const slides = [
  { kicker: 'المشكلة', title: 'الذكاء الاصطناعي ينتشر… بس مين يراقبه؟', bullets: ['فرق تستخدم أدوات متفرقة بلا سجل موحد', 'بيانات حساسة تخرج لأدوات عامة', 'لا أدلة تشغيلية للتدقيق أمام الجهات التنظيمية'] },
  { kicker: 'الحل', title: 'BrightAI — نظام حماية الذكاء الاصطناعي السعودي', bullets: ['AI Firewall يمنع تسرب البيانات', 'سجل تدقيق مشفر غير قابل للتعديل', 'ملف أدلة جاهز للامتثال لـ PDPL وضوابط NCA'] },
  { kicker: 'الطبقات', title: '٥ طبقات حماية', bullets: ['منع PII + موافقة بشرية', 'سجل تدقيق + أدلة', 'تصنيف مخاطر + سياسات', 'تكامل مع ERP/CRM/HIS', 'استضافة محلية ١٠٠٪'] },
  { kicker: 'الأمان', title: 'سيادة بيانات كاملة', bullets: ['استضافة داخل المملكة', 'البيانات ما تخرج حدود السعودية', 'فريق هندسي سعودي'] },
  { kicker: 'العائد', title: 'قيمة مُثبتة', bullets: ['٩٤٪ انخفاض Shadow AI غير مرصود', '١٠٠٪ تغطية بيانات حساسة بالتدقيق', '٣ أسابيع لجاهزية تدقيق داخلي'], note: 'أرقام من case studies مجهولة المصدر — راجع /customers/' },
  { kicker: 'الخطوة الجاية', title: 'نبدأ بتقييم جاهزية', bullets: ['تقييم مجاني في أيام', 'خارطة طريق لـ ٩٠ يوم', 'عرض سعر حسب النطاق'], note: 'تواصل: +966 538 229 013' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'عرض مبيعات BrightAI',
      description: 'عرض شرائح BrightAI لحوكمة الذكاء الاصطناعي: المشكلة، الحل، الطبقات، الأمان، العائد.',
      url: 'https://brightai.live/sales-deck/',
      inLanguage: 'ar-SA',
    },
  ],
};
---

<ArabicLayout
  title="عرض مبيعات BrightAI | حوكمة الذكاء الاصطناعي"
   description="عرض شرائح BrightAI لحوكمة الذكاء الاصطناعي في السعودية: المشكلة، الحل، الطبقات التقنية، الأمان، العائد على الاستثمار. احصل على العرض الكامل وشاركه مع فريقك."
  canonical="https://brightai.live/sales-deck/"
  hreflang={[{ lang: 'ar-SA', href: 'https://brightai.live/sales-deck/' }, { lang: 'en-SA', href: 'https://brightai.live/en/sales-deck/' }]}
  jsonLd={jsonLd as any}
  currentPath="/sales-deck/"
  breadcrumbs={[{ name: 'عرض المبيعات', href: 'https://brightai.live/sales-deck/' }]}
>

  <section class="page-hero" aria-label="عرض المبيعات">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="inner-hero__badge">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-presentation"></use></svg>
        عرض المبيعات
      </div>
      <h1 class="page-hero__title"><span class="gradient-text">عرض BrightAI</span> للمبيعات</h1>
      <p class="page-hero__description">عرض شرائح قابل للطباعة يلخّص قيمة BrightAI في ٦ شرائح. استخدمه في الاجتماعات أو شاركه كـ PDF. النسخة الإنجليزية متاحة في <a href="/en/sales-deck/">عرض الشرائح بالإنجليزية</a> للفرق متعددة الجنسيات. اطّلع على <a href="/customers/">قصص نجاح العملاء</a> و<a href="/partners/">برنامج الشراكة</a>.</p>
      <div class="about-hero__actions about-hero__actions--centered">
        <a href="/contact/" class="btn btn--glow">اطلب عرضاً</a>
      </div>
    </div>
  </section>

  <SalesDeck slides={slides} />

  <!-- تفاصيل العرض التنفيذي وخارطة طريق التطبيق المؤسسي -->
  <section class="sales-deck-details max-w-5xl mx-auto px-5 lg:px-8 py-16 text-slate-300 space-y-12">
    <div class="p-8 rounded-3xl bg-slate-900/50 border border-slate-800">
      <h2 class="text-2xl font-bold text-white mb-4">الملخص التنفيذي لحلول حوكمة الذكاء الاصطناعي</h2>
      <p class="text-slate-400 text-sm lg:text-base leading-relaxed">
        تُمكّن منصة BrightAI المؤسسات الحكومية والشركات الكبرى في المملكة العربية السعودية من تسريع تبني نماذج الذكاء الاصطناعي التوليدي بأمان تام، عبر فرض ضوابط مؤسسية مؤتمتة تمنع تسريب البيانات السرية وتضمن الامتثال الصارم لنظام حماية البيانات الشخصية (PDPL) وضوابط الهيئة الوطنية للأمن السيبراني (NCA ECC-1:2018).
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800">
          <h3 class="font-bold text-cyan-400 mb-2">سرعة التكامل الفني</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            ربط فوري خلال ساعات عبر بوابة استدلال وسيطة (Reverse Proxy) متوافقة مع واجهات برمجية قياسية دون تعديل أنظمتكم الحالية.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800">
          <h3 class="font-bold text-emerald-400 mb-2">سيادة وطنية كاملة</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            استضافة سحابية معتمدة داخل مراكز بيانات المملكة فئة (ج)، تضمن بقاء البيانات التشغيلية وسجلات التدقيق داخل الحدود الجغرافية.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800">
          <h3 class="font-bold text-purple-400 mb-2">وفورات تشغيلية مُثبتة</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            تخفيض تكاليف المراجعة اليدوية بنسبة 70% وتفادي الغرامات التنظيمية الناتجة عن المعالجة غير المصرحة للبيانات الحساسة.
          </p>
        </div>
      </div>
    </div>

    <!-- خارطة طريق التطبيق خلال 90 يوم -->
    <div class="p-8 rounded-3xl bg-slate-900/50 border border-slate-800">
      <h2 class="text-2xl font-bold text-white mb-6">خارطة طريق النشر والاعتماد المؤسسي (٩٠ يوماً)</h2>
      <div class="space-y-6 text-sm">
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-bold shrink-0">٣٠</div>
          <div>
            <h3 class="font-bold text-white mb-1">المرحلة الأولى: التقييم واكتشاف الذكاء الاصطناعي الخفي (Shadow AI)</h3>
            <p class="text-slate-400 leading-relaxed">
              جرد شامل لكافة أدوات الذكاء الاصطناعي المستخدمة، وتحليل حركة البيانات، وتحديد الفجوات التنظيمية مع متطلبات سدايا والأمن السيبراني.
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold shrink-0">٦٠</div>
          <div>
            <h3 class="font-bold text-white mb-1">المرحلة الثانية: تفعيل جدار الحماية وسجل التدقيق المشفر</h3>
            <p class="text-slate-400 leading-relaxed">
              توجيه استعلامات النماذج عبر بوابة BrightAI، تفعيل قواعد تنقية البيانات الشخصية (PII Masking)، وربط بوابات الموافقة البشرية على القرارات الحساسة.
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold shrink-0">٩٠</div>
          <div>
            <h3 class="font-bold text-white mb-1">المرحلة الثالثة: استخراج ملفات الإثبات والجاهزية الدائمة للتدقيق</h3>
            <p class="text-slate-400 leading-relaxed">
              أتمتة تقارير الامتثال الدورية، وتدريب مديري الحوكمة على محاكاة السياسات، وتقديم ملف الأدلة الجاهز للجهات الرقابية والمراجعين الداخليين.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- أسئلة المبيعات الشائعة -->
    <div class="p-8 rounded-3xl bg-slate-900/50 border border-slate-800">
      <h2 class="text-2xl font-bold text-white mb-6">الأسئلة الشائعة لفرق المشتريات والتقنية</h2>
      <div class="space-y-6 text-sm">
        <div>
          <h3 class="font-bold text-white mb-1">ما هو نموذج التسعير المعتمد لمنصة BrightAI؟</h3>
          <p class="text-slate-400 leading-relaxed">
            نقدم اشتراكات سنوية مرنة تعتمد على حجم المنشأة وعدد المستخدمين ونطاق المعالجة، مع خطط مخصصة للجهات الحكومية والقطاعات الحساسة تشمل الدعم الفني المحلي وخدمات التهيئة الاستشارية.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-white mb-1">هل تدعم المنصة نماذج الذكاء الاصطناعي المستضافة محلياً (On-Premise)؟</h3>
          <p class="text-slate-400 leading-relaxed">
            نعم، يمكن نشر BrightAI Kernel بالكامل داخل بيئة الخوادم الخاصة بمنشأتكم (On-Premises / Private Cloud) لتوفير أقصى درجات العزل الأمني للجهات الدفاعية والأمنية والمصرفية.
          </p>
        </div>
      </div>
    </div>
  </section>
</ArabicLayout>
