---
import PageShell from '../components/PageShell.astro';
export const prerender = true;
const flow = [
  ['ما الذي يخرج من بيئتكم؟', 'في الباقات السحابية يصل نص الطلب إلى مزود النموذج بعد حجب البيانات الحساسة. وفي الباقة السيادية لا يخرج أي شيء.'],
  ['من يرى بياناتكم؟', 'مزودو النماذج يستقبلون النص المحجوب فقط. فريقنا لا يطّلع على محتوى طلباتكم إلا بطلب دعم مكتوب منكم.'],
  ['كم نحتفظ بها؟', 'سياقات المحادثة تُحذف بعد 10 دقائق. وسجلات التدقيق تُحفظ حسب باقتكم ولا تتضمن قيم البيانات المحجوبة.'],
  ['أين تُحفظ المفاتيح؟', 'مفاتيح المزودين تُقرأ من متغيرات البيئة وقت التشغيل، ولا تُضمّن في الكود أو ملفات البناء.'],
];
const subs = [
  ['Groq', 'تشغيل النموذج الأساسي', 'نص محجوب'], ['Google (Gemini)', 'تشغيل النموذج البديل', 'نص محجوب'],
  ['Render', 'استضافة التطبيق', 'بيانات تشغيلية'], ['Cloudflare', 'الشبكة والحماية', 'بيانات الاتصال'], ['Redis', 'الجلسات المؤقتة (10 دقائق)', 'معرّف الجلسة وسياق مؤقت'],
];
---
<PageShell title="مركز الثقة — كيف نتعامل مع بياناتكم | BRIGHTAI" description="كيف يتعامل AIGAS مع بياناتكم: ما الذي يخرج، ومن يراه، وكم نحتفظ به، والجهات الفرعية المعالِجة." crumbs={[{ name: 'مركز الثقة' }]}>
  <p class="eyebrow">مركز الثقة</p>
  <h1>نطلب منكم الثقة.<br /><span class="muted">فأقل شيء أن نكون واضحين.</span></h1>
  <p class="note">هذا المحتوى يصف التصور المستهدف للمنصة، ولا يثبت تشغيل القدرات أو التكاملات أو مدد الاحتفاظ المذكورة. المتاح هنا تجربة حجب توضيحية؛ يُحدد نطاق الخدمة والتزاماتها في اتفاق مكتوب.</p>
  <p class="lead">منصة تحاسب الذكاء الاصطناعي ينبغي أن تقبل المحاسبة أولاً. هنا نوضح بالضبط ما يحدث لبياناتكم.</p>
  <section class="block"><h2>رحلة البيانات</h2>{flow.map(([q, a]) => <details open><summary>{q}</summary><p>{a}</p></details>)}</section>
  <section class="block"><h2>الجهات الفرعية المعالِجة</h2>
    <div class="table-wrap"><table><thead><tr><th>الجهة</th><th>الغرض</th><th>البيانات</th></tr></thead><tbody>{subs.map(r => <tr>{r.map(c => <td>{c}</td>)}</tr>)}</tbody></table></div>
    <p class="note">نبلغ العملاء قبل 30 يوماً من إضافة أي جهة معالِجة جديدة.</p>
  </section>
  <section class="block"><h2>الشهادات</h2><p>نعلن عن أي شهادة أو اعتماد فور حصولنا عليه، ولا نعرض شعار أي جهة لم تعتمدنا رسمياً.</p></section>
  <section class="block"><h2>الإبلاغ عن ثغرة</h2><p>إذا اكتشفت ثغرة أمنية، راسلنا ولا تنشرها قبل أن نعالجها. نرد خلال يومي عمل.</p>
    <a class="button" href="mailto:hello@brightai.live?subject=Security%20Report">أبلغ عن ثغرة <span aria-hidden="true">←</span></a></section>
</PageShell>
