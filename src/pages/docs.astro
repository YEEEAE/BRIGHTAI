---
import PageShell from '../components/PageShell.astro';
import BrandLogo from '../components/BrandLogo.astro';
import Icon from '../components/KnowledgeIcon.astro';
import { topics, products } from '../data/knowledge';
import { knowledgeCatalog } from '../server/knowledge/catalog';
import '../styles/knowledge-center.css';
export const prerender = true;
const articles = await knowledgeCatalog();
const types = [...new Set(articles.map(a => a.tag))];
---
<PageShell title="مركز المعرفة | حوكمة الذكاء الاصطناعي" description="أدلة عربية عملية عن حوكمة الذكاء الاصطناعي وحماية البيانات وتقييم المخاطر والسياسات في بيئة العمل السعودية." crumbs={[{ name: 'مركز المعرفة' }]}>
  <div class="kc" data-knowledge-center>
    <details class="kc-sidebar" open>
      <summary>التصنيفات ومساحة المعرفة</summary>
      <div class="kc-sidebar-inner">
        <div class="kc-brand"><BrandLogo/><span>AIGAS / مساحة المعرفة</span></div>
        <nav aria-label="مساحة المعرفة" class="kc-nav">
          <button disabled data-space="guides" aria-pressed="true"><Icon/> الأدلة <span>{articles.length}</span></button>
          <button disabled data-space="products" aria-pressed="false">معرفة منظومة <bdi>AIGAS</bdi></button>
          <button disabled data-topic="faq" aria-pressed="false">الأسئلة الشائعة</button>
        </nav>
        <p class="kc-label">تصفّح الموضوعات</p>
        <nav class="kc-topics" aria-label="الموضوعات">
          <button disabled data-topic="" aria-pressed="true">كل الموضوعات <span>{articles.length}</span></button>
          {topics.map(([id, label]) => <button disabled data-topic={id} aria-pressed="false"><span>{label}</span><bdi>{articles.filter(a => a.topics.includes(id)).length}</bdi></button>)}
        </nav>
        <p class="kc-sidebar-note"><span aria-hidden="true">●</span> معرفة مفتوحة للجميع<br/>محتوى تعليمي، لا يثبت امتثالًا.</p>
      </div>
    </details>
    <div class="kc-main">
      <header class="kc-heading"><div><p class="kc-kicker">ابحث. افهم. طبّق.</p><h1>المعلومة المناسبة،<br/><em>في مكان واحد.</em></h1><p>أدلة عربية لقرارات أوضح في حوكمة وأمان الذكاء الاصطناعي.</p></div><div class="kc-total"><b>{articles.length}</b><span>دليلًا من محتوى الموقع<br/>للفهم والتطبيق</span></div></header>
      <section aria-label="البحث وتصفية الأدلة" class="kc-controls">
        <label class="kc-search" for="kc-query"><Icon kind="search"/><span class="kc-sr">ابحث في عناوين الأدلة وأوصافها وموضوعاتها</span><input disabled id="kc-query" type="search" placeholder="ابحث في الحوكمة، البيانات، والأدلة التقنية…" autocomplete="off"/><kbd aria-hidden="true">/</kbd></label>
        <div class="kc-suggestions"><span>ابدأ من:</span>{['حماية البيانات', 'المخاطر', 'Prompt Injection'].map(term => <button disabled data-query={term}>{term}<span aria-hidden="true"> ↖</span></button>)}</div>
        <fieldset class="kc-products"><legend>المنتج المرتبط <span>— حسب الروابط داخل الدليل</span></legend>{products.map(([id, label]) => <button disabled data-product={id} aria-pressed="false"><bdi>{label}</bdi></button>)}</fieldset>
        <div class="kc-filterbar"><label>نوع المحتوى<select disabled id="kc-type"><option value="">كل الأنواع</option>{types.map(type => <option>{type}</option>)}</select></label><label>الموضوع<select disabled id="kc-topic"><option value="">كل الموضوعات</option>{topics.map(([id, label]) => <option value={id}>{label}</option>)}</select></label><button disabled id="kc-view" aria-pressed="false">عرض موسع</button><button disabled data-reset>مسح الفلاتر</button></div>
        <div class="kc-active" aria-label="الفلاتر النشطة" data-active></div>
      </section>
      <section class="kc-product-space" data-product-space hidden aria-label="معرفة منظومة AIGAS"><h2>المعرفة المرتبطة بمنظومة AIGAS</h2><p>Kernel هو الأساس المشترك. الروابط التالية تصنّف المعرفة التعليمية؛ ليست توثيق API أو دليل إتاحة تشغيلية.</p><div>{products.map(([id, label]) => <button disabled data-product-only={id}><bdi>{label}</bdi><span>{id === 'kernel' ? 'الأساس المشترك · ' : ''}{articles.filter(a => a.products.includes(id)).length} أدلة مرتبطة</span></button>)}</div></section>
      <div class="kc-results-bar"><p role="status" aria-live="polite" aria-atomic="true" data-result-count>{articles.length} نتائج من {articles.length} أدلة</p><span>قراءة تقديرية · 180 كلمة / دقيقة</span></div>
      <div class="kc-workspace">
        <section aria-label="نتائج الأدلة" class="kc-results">
          {articles.map((a, i) => <article class="kc-row" data-entry={i}>
            <div class="kc-row-icon"><Icon kind={a.topic}/></div>
            <div class="kc-row-copy"><div class="kc-row-meta"><span>{a.tag}</span><bdi>DOC / {String(i + 1).padStart(2, '0')}</bdi></div><h2><a href={a.href} data-article-link>{a.title}</a></h2><p class="kc-description">{a.text}</p><div class="kc-tags">{a.products.map(id => <span><bdi>{products.find(p => p[0] === id)?.[1]}</bdi></span>)}<span>{topics.find(t => t[0] === a.topic)?.[1]}</span><span>{a.minutes} دقائق</span></div><div class="kc-row-actions"><button disabled data-preview={i} aria-controls="kc-preview" aria-expanded="false">معاينة سريعة</button><a href={a.href} data-article-link>افتح المقال <span aria-hidden="true">←</span></a></div></div>
          </article>)}
          <div class="kc-empty" data-empty hidden><Icon kind="search"/><h2>ما لقينا دليلًا يطابق اختيارك</h2><p>جرّب كلمة أقصر أو خفّف الفلاتر. بعض التصنيفات ما لها محتوى مرتبط حاليًا.</p><button data-reset>إعادة ضبط البحث والفلاتر</button></div>
        </section>
        <aside id="kc-preview" class="kc-preview" aria-label="معاينة الدليل" tabindex="-1"><div class="kc-preview-top"><span>معاينة سريعة</span><button data-close-preview hidden aria-label="إغلاق المعاينة">×</button></div><div data-preview-content><div class="kc-preview-art"><Icon kind="guide"/></div><h2>خذ نظرة قبل القراءة</h2><p>اختر «معاينة سريعة» من أي دليل لعرض وصفه وأقسامه الفعلية هنا.</p><span class="kc-label">العناوين من المقال الأصلي</span></div></aside>
      </div>
      <noscript><p class="kc-notice">كل الأدلة وروابطها متاحة. فعّل JavaScript لاستخدام البحث والفلاتر والمعاينة.</p></noscript>
      <p class="kc-notice">المواد توعوية ولا تمثل استشارة قانونية أو اعتمادًا تنظيميًا. راجع المصدر الرسمي الساري قبل اتخاذ قرار مؤسسي.</p>
    </div>
    <script type="application/json" id="kc-data" set:html={JSON.stringify(articles).replace(/</g, '\\u003c')}/>
  </div>
</PageShell>
<script>import '../scripts/knowledge-center';</script>
