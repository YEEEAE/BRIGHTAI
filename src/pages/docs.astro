---
import ContentExtension from '../components/ContentExtension.astro';
import PageShell from '../components/PageShell.astro';
export const prerender = true;
const articles = [
  { href: '/knowledge/ai-governance-saudi/', tag: 'إطار عمل', title: 'حوكمة الذكاء الاصطناعي في السعودية', text: 'مسار عملي يبدأ بتحديد الاستخدام والمسؤوليات، ويمر بتقييم المخاطر والمعالجة، وينتهي بالمراجعة والتحسين.' },
  { href: '/knowledge/protect-company-data-chatgpt/', tag: 'قائمة قرار', title: 'حماية بيانات المنشأة عند استخدام ChatGPT', text: 'أسئلة قصيرة تساعد الموظف على التمييز بين المعلومات العامة والداخلية والشخصية قبل إدخالها في أداة خارجية.' },
  { href: '/knowledge/ai-risk-assessment/', tag: 'مصفوفة تعليمية', title: 'تقييم مخاطر الذكاء الاصطناعي', text: 'طريقة مبسطة لتوثيق الخطر والأثر والضوابط والمالك؛ ليست تصنيفاً رسمياً أو نتيجة تقييم آلي.' },
  { href: '/knowledge/prompt-injection/', tag: 'شرح تقني', title: 'Prompt Injection وطبقات الحماية', text: 'كيف قد تحاول مدخلات غير موثوقة تغيير سلوك النموذج، وأين توضع ضوابط التحقق والمراجعة.' },
  { href: '/knowledge/ai-use-policy-employees/', tag: 'سياسة داخلية', title: 'سياسة استخدام الذكاء الاصطناعي للموظفين', text: 'خطوات لبناء سياسة مفهومة تشمل الاستخدام المسموح والمشروط والمحظور وآلية التصعيد.' },
];
---
<PageShell title="مركز المعرفة | حوكمة الذكاء الاصطناعي" description="أدلة عربية عملية عن حوكمة الذكاء الاصطناعي وحماية البيانات وتقييم المخاطر والسياسات في بيئة العمل السعودية." crumbs={[{ name: 'مركز المعرفة' }]}>
  <p class="eyebrow">المعرفة قبل الأداة</p>
  <h1>مركز المعرفة</h1>
  <p class="lead">أدلة عملية تساعد الفرق على طرح الأسئلة الصحيحة قبل استخدام الذكاء الاصطناعي. المواد توعوية ولا تمثل استشارة قانونية أو اعتماداً تنظيمياً.</p>
  <section class="block"><h2>ابدأ من احتياجك</h2><div class="catalog">
    {articles.map((article, i) => <a class="catalog-row" href={article.href}><span class="index-number">0{i + 1}</span><div><small>{article.tag}</small><h3>{article.title}</h3></div><p>{article.text}</p><span aria-hidden="true">←</span></a>)}
  </div></section>
  <p class="note">تاريخ إعداد هذه المواد: 31 أكتوبر 2026. راجع المصدر الرسمي والنص النظامي الساري قبل اتخاذ قرار مؤسسي.</p>

    <ContentExtension>

<section><h2>مساران للقراءة حسب مسؤوليتك</h2><div class="extension-columns"><div><h3>للمالك ومدير الحوكمة</h3><ol><li><a href="/knowledge/ai-governance-saudi/">حدد المسؤوليات ودورة الحوكمة</a>.</li><li><a href="/knowledge/ai-risk-assessment/">اكتب الخطر والضابط والدليل</a>.</li><li><a href="/knowledge/ai-use-policy-employees/">حوّل القرارات إلى سياسة للموظفين</a>.</li></ol></div><div><h3>للأمن والتقنية</h3><ol><li><a href="/knowledge/protect-company-data-chatgpt/">راجع البيانات والقناة والمورد</a>.</li><li><a href="/knowledge/prompt-injection/">افصل التعليمات عن المحتوى الخارجي</a>.</li><li><a href="/products/">قارن أدوار المنتجات وحدود تكاملها</a>.</li></ol></div></div></section>
<section><h2>كيف تستخدم الأدلة داخل منشأتك؟</h2><p>حوّل الأسئلة إلى ورقة عمل لحالة استخدام محددة، ثم اعرضها على المالك المختص. الأمثلة اصطناعية ولا تمثل نتائج تشغيل أو سياسات معتمدة لعميل. تاريخ إعداد الإضافات: 31 أكتوبر 2026؛ اعتماد المراجع البشري المختص قبل النشر النهائي ما زال مطلوباً.</p></section>
    </ContentExtension>
</PageShell>
