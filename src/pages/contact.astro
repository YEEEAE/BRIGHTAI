---
import AccessBadge from '../components/AccessBadge.astro';
import PageShell from '../components/PageShell.astro';
export const prerender = true;
---
<PageShell title="تواصل مع BRIGHTAI | ناقش احتياجك أو عرض السعر" description="جهّز استفسارك محليًا ثم أرسله بنفسك عبر البريد أو واتساب. لا يستقبل الموقع الطلبات ولا يؤكد وصولها." crumbs={[{ name: 'تواصل معنا' }]}>
  <AccessBadge status="local" />
  <h1>ما القرار الذي تحتاج مساعدة فيه؟</h1>
  <p class="lead">يمكنك الآن الاستفسار عن منتج، أو مناقشة نطاق دعم، أو طلب عرض سعر للمراجعة. أي سعر أو موعد أو تشغيل مؤسسي يحتاج اتفاقًا مكتوبًا؛ الاستفسار لا يحجز موعدًا ولا يفعّل تجربة.</p>
  <div class="actions"><a class="button" href="#contact-draft">جهّز مسودة</a><a class="ghost" href="#contact-channels">اختر قناة التواصل</a></div>
  <section id="contact" class="card contact-form ph-no-capture" aria-labelledby="draft-title" data-ph-no-capture data-ph-mask>
    <span class="draft-anchor" id="workshop"></span>
    <span class="draft-anchor" id="workshop-lab"></span>
    <h2 id="draft-title">1. جهّز رسالتك — اختياري</h2>
    <p id="draft-help">اكتب الهدف والمخرج المطلوب، والمنتج أو بيئة النشر إن عرفتها. لا نحتاج اسمك أو اسم الجهة هنا. المسودة تبقى في الصفحة ولا يرسلها الموقع أو يحفظها على خادم.</p>
    <label for="contact-draft">مسودة الاستفسار</label>
    <textarea id="contact-draft" rows="6" maxlength="2000" autocomplete="off" aria-describedby="draft-help draft-limit" placeholder="نريد مناقشة تقييم مخاطر استخدام الذكاء الاصطناعي، والمخرج المطلوب ورقة عمل يراجعها فريقنا."></textarea>
    <p id="draft-limit" class="note">الحد الأقصى 2000 حرف. لا تكتب بيانات عملاء أو أسرارًا أو مفاتيح وصول.</p>
    <button id="copy-draft" class="button" type="button" hidden>انسخ المسودة</button>
    <p id="contact-status" class="contact-feedback" role="status" aria-atomic="true"></p>
    <a id="return-to-access" href="/request-access/" hidden>العودة إلى خيارات الوصول</a>
    <noscript><p>يمكنك الكتابة هنا وتحديد النص ونسخه يدويًا، ثم لصقه في البريد أو واتساب. لا تحتاج JavaScript.</p></noscript>
  </section>
  <section id="contact-channels" tabindex="-1" class="card contact-options" aria-labelledby="channel-title">
    <h2 id="channel-title">2. افتح القناة والصق الرسالة</h2>
    <p id="contact-network" class="contact-feedback" role="status"></p>
    <p><a class="button" data-measure-channel="email" href="mailto:yzeed1job@gmail.com">افتح تطبيق البريد</a></p>
    <p>الوجهة: <bdi dir="ltr">yzeed1job@gmail.com</bdi>. إذا لم يفتح التطبيق، انسخ العنوان واستخدم بريدك المعتاد.</p>
    <p><a class="button" data-measure-channel="whatsapp" href="https://wa.me/966538229013" target="_blank" rel="noopener noreferrer">افتح واتساب (نافذة جديدة)</a></p>
    <p>الرقم: <bdi dir="ltr">+966 53 822 9013</bdi>. إذا تعذر فتحه، استخدم البريد. لا ينقل أي رابط مسودتك تلقائيًا؛ القناة الخارجية تعالج ما ترسله وفق سياستها.</p>
  </section>
  <section class="block"><h2>3. أرسل من تطبيقك وانتظر تأكيدًا</h2>
    <p>راجع الوجهة والنص، ثم أرسل من التطبيق. رد الفريق يؤكد الاستلام.</p>
    <p>إذا لم يصلك رد، تابع عبر القناة الأخرى.</p>
    <a id="return-to-result" class="button" href="/products/ledger/complaint/#lab" hidden>ارجع إلى نتيجة المختبر</a>
  </section>
  <section class="block"><h2>تريد الاطلاع أولًا؟</h2><p><a href="/products/#lab">افتح المختبر العام بلا حساب</a> ببيانات اصطناعية، أو راجع <a href="/services/">موضوعات الدعم</a> و<a href="/pricing/">ما يحدد عرض السعر</a>. التشغيل المؤسسي منفصل ويحتاج مراجعة وموافقة.</p></section>
</PageShell>
<style>
  .contact-form { position: relative; }
  :is(#contact, #contact-draft, #contact-channels) { scroll-margin-block-start: 6rem; }
  .contact-feedback[data-state] { border-inline-start: 3px solid currentColor; padding: .65rem .85rem; background: var(--surface-sunken); }
  [data-state="success"] { color: #a8e5cf; }
  [data-state="loading"] { color: #bddbff; }
  :is([data-state="empty"], [data-state="denied"], [data-state="offline"]) { color: #f6d29a; }
  [data-state="error"] { color: #ffbdbd; }
  .draft-anchor { position: absolute; inset-block-start: 0; scroll-margin-block-start: 6rem; }
  .contact-form .button, .contact-options .button, #return-to-result { min-block-size: 48px; }
  #copy-draft[hidden], #return-to-result[hidden], #return-to-access[hidden] { display: none !important; }
</style>
<script>
  import { accessPath, accessTrack, accessTracks } from '../shared/access-journey.mjs';
  import { productForSlug } from '../shared/product-navigation.mjs';
  const draft = document.querySelector<HTMLTextAreaElement>('#contact-draft');
  const copy = document.querySelector<HTMLButtonElement>('#copy-draft');
  const status = document.querySelector('#contact-status');
  const network = document.querySelector<HTMLElement>('#contact-network');
  if (network) {
    const updateNetwork = () => {
      if (navigator.onLine) {
        network.removeAttribute('data-state');
        network.textContent = '';
      } else {
        network.dataset.state = 'offline';
        network.textContent = 'أنت غير متصل. يمكنك تحرير المسودة الآن وإرسالها بعد عودة الاتصال.';
      }
    };
    addEventListener('online', updateNetwork);
    addEventListener('offline', updateNetwork);
    updateNetwork();
  }
  if (draft && copy && status instanceof HTMLElement) {
    const feedback = (state: string, message: string) => {
      status.dataset.state = state;
      status.textContent = message;
    };
    copy.hidden = false;
    const query = new URLSearchParams(location.search);
    if (query.has('access') && location.hash === '#contact') {
      const track = accessTrack(query.get('access'));
      const product = productForSlug(query.get('product'));
      if (!draft.value) draft.value = `أرغب في ${accessTracks[track].request}${product ? ` لمنتج ${product.name}` : ''}.
هدف الاستخدام: `;
      const back = document.querySelector<HTMLAnchorElement>('#return-to-access')!;
      back.href = accessPath(product?.slug, track);
      back.hidden = false;
    }
    const fromLab = location.hash === '#workshop-lab';
    if (fromLab || location.hash === '#workshop') {
      if (!draft.value) {
        draft.value = 'أرغب في الاستفسار عن ورشة الرد على شكاوى العملاء بالذكاء الاصطناعي لفريق خدمة العملاء لدينا. أود معرفة النطاق والسعر والمواعيد المتاحة.';
      }
      if (fromLab) {
        document.querySelector<HTMLAnchorElement>('#return-to-result')!.hidden = false;
      }
    }
    copy.addEventListener('click', async () => {
      if (copy.getAttribute('aria-disabled') === 'true') return;
      if (!draft.value.trim()) {
        feedback('empty', 'اكتب وصفًا عامًا أولًا، أو افتح قناة التواصل مباشرة.');
        draft.setAttribute('aria-invalid', 'true');
        draft.setAttribute('aria-errormessage', 'contact-status');
        draft.focus();
        return;
      }
      copy.setAttribute('aria-disabled', 'true');
      feedback('loading', 'جارٍ نسخ المسودة…');
      try {
        await navigator.clipboard.writeText(draft.value);
        feedback('success', 'نُسخت المسودة. الصقها في تطبيقك وراجعها قبل الإرسال.');
      } catch (error) {
        const denied = error instanceof DOMException && error.name === 'NotAllowedError';
        feedback(denied ? 'denied' : 'error', denied
          ? 'المتصفح رفض الوصول إلى الحافظة. انسخ النص المحدد يدويًا.'
          : 'تعذر النسخ التلقائي. انسخ النص المحدد يدويًا.');
        draft.focus();
        draft.select();
      } finally {
        copy.removeAttribute('aria-disabled');
      }
    });
    draft.addEventListener('input', () => {
      draft.removeAttribute('aria-invalid');
      draft.removeAttribute('aria-errormessage');
      if (status.dataset.state === 'loading') return;
      status.removeAttribute('data-state');
      status.textContent = '';
    });
  }
</script>
