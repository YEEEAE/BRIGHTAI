---
import '../styles/theme.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Constellation from '../components/Constellation.astro';
export const prerender = true;
const pillarPaths = ['safety', 'transparency', 'privacy'];
const pillars = [
  { number: '01', icon: 'shield', title: 'السلامة والموثوقية', text: 'نمنع الأنظمة من التسبب في أي ضرر للأفراد أو الممتلكات أو البيئة، ونضمن أنها تعمل ضمن حدود واضحة ومدروسة. كل طلب يُقيَّم من 0 إلى 100، والقرارات الحرجة تحتاج موافقة بشرية.', note: 'حدود واضحة. والقرار الأخير للإنسان.' },
  { number: '02', icon: 'eye', title: 'الشفافية والمساءلة', text: 'تعرف مصدر كل بيان، وتتبع تاريخ كل نموذج، وتحدد من المسؤول عن كل قرار. سجل التدقيق عندنا غير قابل للتعديل.', note: 'كل طلب له أثر. وكل قرار له مسؤول.' },
  { number: '03', icon: 'lock', title: 'الخصوصية وحماية البيانات', text: 'نكتشف البيانات الشخصية ونحجبها قبل أن تصل للنموذج، وبطريقة ما تمنعك من اكتشاف الانحياز في بياناتك.', note: 'بياناتك تبقى تحت سيطرتك.' },
];
const steps = ['يكتب الموظف طلبه', 'يفحص جدار الحماية البيانات الحساسة ويحجبها', 'يقيّم محرك المخاطر الطلب ويطبق سياستكم', 'يصل الرد بأمان ويُسجَّل الحدث'];
const sectors = [
  { slug: 'government', title: 'الجهات الحكومية', label: 'GOVERNMENT', description: 'ابتكار يخدم الناس، ضمن حدود واضحة.' },
  { slug: 'finance', title: 'البنوك والمالية', label: 'FINANCIAL SERVICES', description: 'حماية البيانات في كل تفاعل وقرار.' },
  { slug: 'healthcare', title: 'الصحة', label: 'HEALTHCARE', description: 'خصوصية المريض أولاً. دائماً.' },
  { slug: 'enterprise', title: 'الشركات', label: 'ENTERPRISE', description: 'مساحة لفريقك يبتكر فيها بثقة.' },
];
---
<BaseLayout title="AIGAS — ذكاء اصطناعي تثق به... وتحاسبه | BRIGHTAI" description="AIGAS طبقة حوكمة وأمان بين موظفيك ونماذج الذكاء الاصطناعي: حجب البيانات الحساسة، تقييم المخاطر، موافقات بشرية وسجل تدقيق.">
  <Header />
  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> AIGAS <span class="eyebrow-separator">/</span> حوكمة الذكاء الاصطناعي</p>
        <h1 id="hero-title">ذكاء اصطناعي<br />تثق به<span class="ellipsis">...</span><br /><span class="hero-last">وتحاسبه</span></h1>
        <p class="hero-description">AIGAS طبقة حوكمة وأمان تقف بين موظفيك ونماذج الذكاء الاصطناعي. تحجب البيانات الحساسة قبل خروجها، وتقيّم مخاطر كل طلب، وتوقف القرارات الحرجة لين يوافق عليها إنسان، وتوثّق كل شيء في سجل لا يمكن تعديله.</p>
        <div class="actions"><a class="button" href="/kernel/">جرّب Kernel مجاناً <span aria-hidden="true">↖</span></a><a class="ghost" href="/contact/">احجز عرضاً توضيحياً <span aria-hidden="true">←</span></a></div>
      </div>
      <div class="hero-art"><Constellation /></div>
      <div class="hero-bottom"><span class="latin" dir="ltr">SAUDI AI SAFETY OS</span><a class="ghost" href="#problem">الثقة تبدأ من هنا <span aria-hidden="true">↓</span></a><span class="latin" dir="ltr">01 — 06</span></div>
    </section>
    <section class="trust wrap" aria-label="مراجع التصميم">
      <p>مصمم وفق</p><div><span>مبادئ أخلاقيات الذكاء الاصطناعي من سدايا</span><i aria-hidden="true">·</i><span>نظام حماية البيانات الشخصية</span><i aria-hidden="true">·</i><span>إرشادات الهيئة الوطنية للأمن السيبراني</span></div>
    </section>
    <section class="problem section wrap" id="problem" aria-labelledby="problem-title">
      <div><p class="eyebrow">01 / السؤال الذي يستحق إجابة</p><h2 id="problem-title">موظفوك يستخدمون<br />الذكاء الاصطناعي اليوم.<br /><span class="muted">السؤال: هل تعرف<br />ماذا يرسلون؟</span></h2></div>
      <div class="problem-copy"><span class="asterisk" aria-hidden="true">✳</span><p>كل محادثة مع نموذج ذكاء اصطناعي ممكن تكون نقطة تسريب: رقم هوية عميل، أو آيبان، أو ملف مريض، أو كلمة مرور. ومع بدء تطبيق نظام حماية البيانات الشخصية فعلياً، ما عاد ينفع نترك الموضوع للاجتهاد الشخصي.</p><a class="ghost" href="#principles">هنا يأتي دور AIGAS <span aria-hidden="true">↓</span></a></div>
    </section>
    <section class="section wrap" id="principles" aria-labelledby="pillars-title">
      <p class="eyebrow">02 / ثلاثة أركان. أساس واحد للثقة.</p><h2 id="pillars-title" class="pillars-heading">ذكاء أقوى.<br /><span class="muted">وضوابط أوضح.</span></h2>
      <div class="pillars">{pillars.map((p, i) => <article class="pillar"><div class="pillar-symbol" aria-hidden="true"><span class="latin">{p.number}</span><svg width="72" height="72" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">{p.icon === 'shield' ? <><path d="m24 5 15 6v11c0 10-6 17-15 21C15 39 9 32 9 22V11L24 5Z"/><path d="m17 24 5 5 10-12"/></> : p.icon === 'eye' ? <><path d="M3 24s8-13 21-13 21 13 21 13-8 13-21 13S3 24 3 24Z"/><circle cx="24" cy="24" r="6"/></> : <><rect x="10" y="20" width="28" height="23" rx="4"/><path d="M16 20v-7a8 8 0 0 1 16 0v7m-8 9v6"/></>}</svg></div><div class="pillar-copy"><h3>{p.title}</h3><p>{p.text}</p><span class="pillar-note">{p.note}</span><a class="ghost" href={`/pillars/${pillarPaths[i]}/`}>اكتشف هذا الركن <span aria-hidden="true">←</span></a></div></article>)}</div>
    </section>
    <section class="section wrap workflow" id="how-it-works" aria-labelledby="workflow-title">
      <div class="workflow-intro"><p class="eyebrow">03 / من الطلب إلى الرد</p><h2 id="workflow-title">أربع خطوات.<br />ولا تفصيلة<br /><span class="muted">خارج الصورة.</span></h2><p class="muted">طبقة حماية بين فريقك والنموذج،<br />تعمل في كل تفاعل.</p></div>
      <ol class="steps">{steps.map((step, i) => <li><span class="step-number" aria-hidden="true">{['١', '٢', '٣', '٤'][i]}</span><h3>{step}</h3>{i < 3 && <span class="step-arrow" aria-hidden="true">↓</span>}</li>)}</ol>
    </section>
    <section class="section wrap" id="solutions" aria-labelledby="solutions-title">
      <div class="solutions-heading"><div><p class="eyebrow">04 / صُمّم لمسؤولياتكم</p><h2 id="solutions-title">مهما كان قطاعك،<br /><span class="muted">الثقة ليست خياراً.</span></h2></div><p class="muted">حوكمة تراعي طبيعة عملك.<br />وحماية تبدأ من بياناتك.</p></div>
      <div class="sectors">{sectors.map((s, i) => <a class="sector" href={`/solutions/${s.slug}/`}><span class="latin" dir="ltr">0{i + 1} / {s.label}</span><h3>{s.title} <span aria-hidden="true">↖</span></h3><p>{s.description}</p><span class="sector-link">اكتشف الحل <span aria-hidden="true">←</span></span></a>)}</div>
    </section>
    <section class="closing section wrap" aria-labelledby="closing-title"><p class="eyebrow">05 / شوف الحماية بنفسك</p><span class="closing-star" aria-hidden="true">✳</span><h2 id="closing-title">شاهد Kernel وهو يحجب<br />رقم هوية <span class="muted">في أقل من ثانية</span></h2><p>بدون تسجيل وبدون بطاقة ائتمان. جرّب البيئة التجريبية الآن.</p><a class="button" href="/kernel/">ابدأ التجربة <span aria-hidden="true">↖</span></a></section>
  </main>
  <Footer />
</BaseLayout>
<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 0 24px; padding-top: 48px; min-height: 790px; position: relative; }
  .hero-copy { min-width: 0; position: relative; z-index: 1; }
  .hero .eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 30px; }
  .eyebrow-separator { color: #9a9a9a; padding-inline: 6px; }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: #ffb829; }
  .ellipsis { color: #9a9a9a; }
  .hero-last { color: #fff; }
  .hero-description { color: #bdbdbd; max-width: 525px; margin-block: 30px; font-size: 18px; }
  .hero-art { margin-inline: -24px; }
  .hero-bottom { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; color: #9a9a9a; margin-top: 54px; padding-bottom: 24px; }
  .trust { padding-block: 36px 60px; text-align: center; color: #bdbdbd; font-size: 14px; }
  .trust > p { color: #9a9a9a; margin-bottom: 18px; }
  .trust > div { display: flex; justify-content: center; align-items: center; gap: 24px; flex-wrap: wrap; }
  .trust i { color: #8052ff; font-style: normal; }
  .problem { display: grid; grid-template-columns: 1.1fr .9fr; gap: 96px; align-items: center; }
  .problem-copy { max-width: 440px; padding-top: 48px; color: #bdbdbd; }
  .asterisk { font: 400 72px/1 Arial,sans-serif; color: #ffb829; display: block; margin-bottom: 36px; }
  .problem-copy .ghost { margin-top: 30px; }
  .pillars-heading { margin-bottom: 72px; }
  .pillar { display: grid; grid-template-columns: .8fr 1fr; gap: 96px; align-items: center; padding-block: 42px; }
  .pillar:nth-child(2) .pillar-symbol { order: 2; }
  .pillar:nth-child(2) .pillar-copy { order: 1; }
  .pillar-symbol { display: flex; gap: 60px; align-items: center; justify-content: center; color: #a988ff; }
  .pillar-symbol .latin { color: #9a9a9a; align-self: flex-start; }
  .pillar-copy { max-width: 550px; }
  .pillar-copy p { color: #bdbdbd; margin-block: 24px; }
  .pillar-note { color: #ffb829; font-size: 14px; }
  .workflow { display: grid; grid-template-columns: 1fr 1fr; gap: 96px; }
  .workflow-intro > p:last-child { margin-top: 30px; }
  .steps { list-style: none; margin: 0; padding: 0; }
  .steps li { position: relative; display: grid; grid-template-columns: 48px 1fr; gap: 24px; padding-block: 18px 48px; }
  .step-number { color: #ffb829; font-size: 27px; }
  .steps h3 { font-size: 24px; max-width: 360px; }
  .step-arrow { position: absolute; inset-block-end: 0; inset-inline-start: 18px; color: #8052ff; }
  .solutions-heading { display: flex; justify-content: space-between; align-items: end; gap: 48px; }
  .solutions-heading > p { margin-bottom: 12px; }
  .sectors { display: grid; grid-template-columns: 1fr 1fr; gap: 60px 96px; margin-top: 72px; }
  .sector { display: block; padding-block: 12px; }
  .sector .latin { color: #9a9a9a; }
  .sector h3 { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-block: 18px; }
  .sector h3 span { color: #8052ff; transition: transform .2s; }
  .sector:hover h3 span { transform: translate(-4px, -4px); }
  .sector p { color: #bdbdbd; }
  .sector-link { display: inline-flex; align-items: center; gap: 18px; color: #ffb829; font-size: 14px; margin-top: 24px; }
  .closing { text-align: center; padding-block: 120px; }
  .closing-star { display: block; color: #8052ff; font: 96px/1 Arial,sans-serif; margin-block: 36px; }
  .closing h2 { font-size: clamp(36px, 4.6vw, 66px); }
  .closing > p:not(.eyebrow) { color: #bdbdbd; margin-block: 30px; }
  @media (min-width: 1600px) { .hero { min-height: 850px; } }
  @media (max-width: 1023px) { .hero { grid-template-columns: 1.1fr .9fr; } .hero-art { margin-inline: -24px; } .problem, .workflow, .pillar { gap: 48px; } .hero h1 { font-size: 72px; } .hero .actions { gap: 12px; } .trust > div { gap: 18px; } }
  @media (max-width: 767px) { .hero { grid-template-columns: 1fr; padding-top: 36px; min-height: auto; } .hero h1 { font-size: clamp(52px, 12vw, 78px); } .hero-description { margin-block: 24px; } .hero-art { width: 100%; max-width: 480px; margin: 12px auto 0; } .hero-bottom { margin-top: 24px; } .hero-bottom > .latin:last-child { display: none; } .hero-bottom .latin { font-size: 10px; } .hero-bottom .ghost { font-size: 12px; } .trust { padding-block: 30px; } .trust > div { flex-direction: column; gap: 12px; } .trust i { display: none; } .problem, .workflow, .pillar { grid-template-columns: 1fr; gap: 30px; } .problem-copy { padding-top: 0; } .asterisk { font-size: 54px; margin-bottom: 24px; } .pillars-heading { margin-bottom: 30px; } .pillar { padding-block: 36px; } .pillar-symbol { justify-content: flex-start; gap: 24px; } .pillar-symbol svg { width: 54px; height: 54px; } .pillar:nth-child(2) .pillar-symbol, .pillar:nth-child(2) .pillar-copy { order: initial; } .pillar-copy p { margin-block: 18px; } .solutions-heading { display: block; } .solutions-heading > p { margin-top: 24px; } .sectors { grid-template-columns: 1fr; gap: 36px; margin-top: 36px; } .closing { padding-block: 72px; } .steps li { gap: 12px; } }
</style>
