---
import '../styles/theme.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SystemMap from '../components/SystemMap.astro';
export const prerender = true;
const pillarPaths = ['safety', 'transparency', 'privacy'];
const pillars = [
  { number: '01', icon: 'shield', title: 'السلامة والموثوقية', text: 'حدد حدود الاستخدام والأضرار المحتملة ومسار المراجعة والإيقاف قبل اعتماد أي حالة استخدام.', note: 'حدود واضحة ومسؤوليات محددة.' },
  { number: '02', icon: 'eye', title: 'الشفافية والمساءلة', text: 'وثّق الغرض والمالك والضوابط والقرارات لتسهيل المراجعة والمحاسبة.', note: 'لكل استخدام مالك ودليل.' },
  { number: '03', icon: 'lock', title: 'الخصوصية وحماية البيانات', text: 'حدد البيانات والغرض والمستلمين والقناة المعتمدة قبل استخدام أي خدمة خارجية.', note: 'تحقق قبل مشاركة البيانات.' },
];
const steps = ['حدد حالة الاستخدام ومالكها', 'صنّف البيانات والأطراف المتأثرة', 'قيّم المخاطر واختر الضوابط', 'راقب النتائج وراجع القرار'];
const sectors = [
  { slug: 'government', title: 'الجهات الحكومية', label: 'GOVERNMENT', description: 'ابتكار يخدم الناس، ضمن حدود واضحة.' },
  { slug: 'finance', title: 'البنوك والمالية', label: 'FINANCIAL SERVICES', description: 'حماية البيانات في كل تفاعل وقرار.' },
  { slug: 'healthcare', title: 'الصحة', label: 'HEALTHCARE', description: 'خصوصية المريض أولاً. دائماً.' },
  { slug: 'enterprise', title: 'الشركات', label: 'ENTERPRISE', description: 'مساحة لفريقك يبتكر فيها بثقة.' },
];
---
<BaseLayout title="حوكمة وأمان الذكاء الاصطناعي | BRIGHTAI" description="تعرّف على توجه BRIGHTAI لحوكمة الذكاء الاصطناعي ومخاطره، واستكشف الأدلة العربية والتصور المستهدف لمنتجات AIGAS غير المتحققة تشغيلياً.">
  <Header />
  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">


        <p class="eyebrow hero-kicker">مؤسسة مُشرقة BRIGHT AI / السعودية</p><h1 id="hero-title">لكل طلب<br />حدود.<br /><span class="hero-last">ولكل قرار أثر.</span></h1>
        <p class="eyebrow hero-tagline">AIGAS / حوكمة وأمان الذكاء الاصطناعي</p>
        <p class="hero-description">AIGAS تصور لحوكمة وأمان الذكاء الاصطناعي، يضم Kernel كمكوّن مشترك وخمسة منتجات مستقلة وظيفياً وتجاريًا وفق الـBlueprint. الإتاحة التشغيلية للمنتجات غير متحققة حالياً.</p>
        <div class="actions"><a class="button" href="/products/">استكشف المنتجات <span aria-hidden="true">↖</span></a><a class="ghost" href="/contact/">اطلب معلومات أو عرض سعر <span aria-hidden="true">←</span></a></div>
      </div>
      <div class="hero-art"><SystemMap /></div>

    </section>
    <section class="governance-statement wrap" aria-label="حوكمة وحماية البيانات">
      <p data-reveal-02="lines" data-scroll="scrub"><span data-reveal-line>حوكمة تراعي طبيعة عملك.</span><span class="statement-accent" data-reveal-line>وحماية تبدأ من بياناتك.</span></p>
    </section>
    <section class="problem section wrap" id="problem" aria-labelledby="problem-title">
      <div><p class="eyebrow">01 / السؤال الذي يستحق إجابة</p><h2 id="problem-title">موظفوك يستخدمون<br />الذكاء الاصطناعي اليوم.<br /><span class="muted">السؤال: هل تعرف<br />ماذا يرسلون؟</span></h2></div>
      <div class="problem-copy"><span class="asterisk" aria-hidden="true">✳</span><p>قد تتضمن المحادثة معلومات شخصية أو داخلية. قبل استخدام أي أداة، حدّد البيانات والغرض والحساب وشروط الخدمة والضوابط المصرح بها. تختلف الالتزامات حسب الجهة والسياق؛ لا تكفي عبارة عامة لإثبات الامتثال.</p><a class="ghost" href="/docs/">اقرأ إرشادات الاستخدام <span aria-hidden="true">↓</span></a></div>
    </section>
    <section class="section wrap" id="principles" aria-labelledby="pillars-title">
      <p class="eyebrow">02 / ثلاثة أركان. أساس واحد للثقة.</p><h2 id="pillars-title" class="pillars-heading">ذكاء أقوى.<br /><span class="muted">وضوابط أوضح.</span></h2>
      <div class="pillars">{pillars.map((p, i) => <article class="pillar"><div class="pillar-symbol" aria-hidden="true"><span class="latin">{p.number}</span><svg width="72" height="72" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">{p.icon === 'shield' ? <><path d="m24 5 15 6v11c0 10-6 17-15 21C15 39 9 32 9 22V11L24 5Z"/><path d="m17 24 5 5 10-12"/></> : p.icon === 'eye' ? <><path d="M3 24s8-13 21-13 21 13 21 13-8 13-21 13S3 24 3 24Z"/><circle cx="24" cy="24" r="6"/></> : <><rect x="10" y="20" width="28" height="23" rx="4"/><path d="M16 20v-7a8 8 0 0 1 16 0v7m-8 9v6"/></>}</svg></div><div class="pillar-copy"><h3>{p.title}</h3><p>{p.text}</p><span class="pillar-note">{p.note}</span><a class="ghost" href={`/pillars/${pillarPaths[i]}/`}>اكتشف هذا الركن <span aria-hidden="true">←</span></a></div></article>)}</div>
    </section>
    <section class="section wrap workflow" id="how-it-works" aria-labelledby="workflow-title">
      <div class="workflow-intro"><p class="eyebrow">03 / من الطلب إلى الرد</p><h2 id="workflow-title">حوكمة واضحة.<br />من تحديد الاستخدام<br /><span class="muted">حتى المراجعة.</span></h2><p class="muted">مراحل مقترحة للتصميم؛<br />وليست دليلاً على تشغيل منتج.</p></div>
      <ol class="steps">{steps.map((step, i) => <li><span class="step-number" aria-hidden="true">{['١', '٢', '٣', '٤'][i]}</span><h3>{step}</h3>{i < 3 && <span class="step-arrow" aria-hidden="true">↓</span>}</li>)}</ol>
    </section>
    <section class="section wrap" aria-labelledby="products-title">
      <p class="eyebrow">04 / التصور المستهدف</p><h2 id="products-title">خمسة منتجات مستقلة.<br /><span class="muted">وKernel أساس مشترك.</span></h2>
      <p class="note">الإتاحة التشغيلية للمنتجات غير متحققة. القائمة تصف نطاق الـBlueprint ولا تعني توفر خدمات حالياً.</p>
      <div class="sectors home-products">
        <a class="sector" href="/products/firewall/"><h3>AIGAS Firewall</h3><p>تصور لفحص المدخلات والمخرجات وفق سياسة الجهة.</p></a>
        <a class="sector" href="/products/risk-engine/"><h3>AIGAS Risk Engine</h3><p>تصور لتقييم مخاطر حالات الاستخدام وربطها بالضوابط.</p></a>
        <a class="sector" href="/products/human-gate/"><h3>AIGAS Human Gate</h3><p>تصور لمسارات المراجعة البشرية والاعتماد.</p></a>
        <a class="sector" href="/products/ledger/"><h3>AIGAS Ledger</h3><p>تصور لحوكمة الأدلة التشغيلية والوصول إليها.</p></a>
        <a class="sector" href="/products/secure-chat/"><h3>AIGAS Secure Chat</h3><p>تصور لواجهة مؤسسية لمساعدات الذكاء الاصطناعي.</p></a>
      </div>
      <a class="ghost" href="/products/">تفاصيل المنتجات وحالتها <span aria-hidden="true">←</span></a>
    </section>
    <section class="section wrap" id="solutions" aria-labelledby="solutions-title">
      <div class="solutions-heading"><div><p class="eyebrow">05 / أسئلة حسب القطاع</p><h2 id="solutions-title">ابدأ من مسؤولياتك<br /><span class="muted">وسياقك التنظيمي.</span></h2></div></div>
      <div class="sectors">{sectors.map((s, i) => <a class="sector" href={`/solutions/${s.slug}/`}><span class="latin" dir="ltr">0{i + 1} / {s.label}</span><h3>{s.title} <span aria-hidden="true">↖</span></h3><p>{s.description}</p><span class="sector-link">اكتشف الحل <span aria-hidden="true">←</span></span></a>)}</div>
    </section>
    <section class="closing section wrap" aria-labelledby="closing-title"><p class="eyebrow">06 / المعرفة أولاً</p><span class="closing-star" aria-hidden="true">✳</span><h2 id="closing-title">ابدأ بفهم المخاطر<br /><span class="muted">قبل اختيار الأداة.</span></h2><p>أدلة عربية عن السياسات وتقييم المخاطر وحماية بيانات المنشأة.</p><a class="button" href="/docs/">تصفح مركز المعرفة <span aria-hidden="true">↖</span></a></section>
  </main>
  <Footer />
</BaseLayout>
<script>
  // Native line-by-line opacity scrub; keep Arabic shaping and static HTML intact.
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const reveals = [...document.querySelectorAll<HTMLElement>('[data-reveal-02="lines"][data-scroll="scrub"]')].map(element => ({
    element, lines: [...element.querySelectorAll<HTMLElement>('[data-reveal-line]')],
  }));
  let frame = 0;
  const clamp = (value: number) => Math.min(1, Math.max(0, value));
  function updateReveal() {
    frame = 0;
    for (const { element, lines } of reveals) {
      const rect = element.getBoundingClientRect();
      // Reveal from top 80% to bottom 50%, one full line at a time.
      const progress = clamp((innerHeight * .8 - rect.top) / (innerHeight * .3 + rect.height));
      lines.forEach((line, index) => {
        line.style.opacity = motion.matches ? '1' : String(.1 + .9 * clamp(progress * lines.length - index));
      });
    }
  }
  function scheduleReveal() {
    if (!frame) frame = requestAnimationFrame(updateReveal);
  }
  addEventListener('scroll', scheduleReveal, { passive: true });
  addEventListener('resize', scheduleReveal);
  motion.addEventListener('change', scheduleReveal);
  document.fonts.ready.then(scheduleReveal);
  scheduleReveal();
  document.addEventListener('astro:before-swap', () => {
    cancelAnimationFrame(frame);
    removeEventListener('scroll', scheduleReveal);
    removeEventListener('resize', scheduleReveal);
    motion.removeEventListener('change', scheduleReveal);
  }, { once: true });
</script>
<style>
  main { overflow: clip; }
  .hero { position: relative; min-height: min(1050px, calc(100svh - 108px)); display: flex; align-items: center; padding-block: 110px 120px; }
  .hero-copy { position: relative; z-index: 2; width: 580px; max-width: 50%; }
  .hero h1 { font-size: clamp(72px, 7vw, 100px); line-height: 1.16; letter-spacing: -.04em; }
  .ellipsis { color: #fff; }
  .hero .hero-tagline { display: block; margin-block: 30px 12px; font-size: 14px; font-weight: 600; }
  .hero-description { max-width: 440px; color: #d0ced2; font-size: 18px; line-height: 1.65; margin-bottom: 24px; }
  .hero .actions { gap: 18px; }
  .hero .button { font-size: 14px; padding: 9px 20px; min-height: 44px; }
  .hero .ghost { font-size: 14px; }
  .hero-art { position: absolute; z-index: 0; width: 83vw; height: 108%; inset-inline-end: -17vw; inset-block-start: -2%; mask-image: linear-gradient(to right, #000 63%, transparent 89%); }
  .governance-statement { padding-block: 72px 96px; text-align: center; }
  .governance-statement p { font-size: clamp(24px, 3.6vw, 48px); line-height: 1.65; font-weight: 400; }
  .governance-statement span { display: block; }
  @media (prefers-reduced-motion: reduce) {
    .governance-statement [data-reveal-line] { opacity: 1 !important; }
  }
  .governance-statement .statement-accent { color: var(--color-saffron-spark); font-weight: 200; }
  .section { padding-block: 120px; }
  .section h2 { font-size: clamp(42px, 5.4vw, 78px); line-height: 1.2; }
  .problem { display: grid; grid-template-columns: 1.1fr .9fr; gap: 120px; min-height: 720px; align-items: center; }
  .problem h2 { font-size: clamp(36px, 3.4vw, 48px); line-height: 1.4; }
  .problem-copy { color: #bdbdbd; max-width: 410px; }
  .asterisk { display: none; }
  .problem-copy .ghost { margin-top: 24px; }
  .pillars-heading { margin-bottom: 90px; }
  .pillar { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 120px; min-height: 400px; padding-block: 60px; }
  .pillar:nth-child(2) .pillar-symbol { order: 2; }
  .pillar:nth-child(2) .pillar-copy { order: 1; }
  .pillar-symbol { display: flex; align-items: center; justify-content: center; gap: 30px; color: #8052ff; }
  .pillar-symbol svg { width: 150px; height: 150px; stroke-width: .65; }
  .pillar-symbol .latin { color: #9a9a9a; align-self: flex-start; }
  .pillar-copy { max-width: 430px; }
  .pillar h3 { font-size: 42px; }
  .pillar-copy p { color: #bdbdbd; margin-block: 24px; }
  .pillar-note { display: block; font-size: 14px; color: #ffb829; }
  .pillar-copy .ghost { margin-top: 18px; }
  .workflow { display: grid; grid-template-columns: 1fr 1fr; gap: 120px; }
  .workflow-intro > p:last-child { margin-top: 30px; }
  .steps { list-style: none; margin: 0; padding: 0; }
  .steps li { position: relative; display: grid; grid-template-columns: 48px 1fr; gap: 24px; padding-block: 18px 48px; }
  .step-number { color: #ffb829; font-size: 27px; }
  .steps h3 { font-size: 24px; max-width: 360px; }
  .step-arrow { position: absolute; inset-block-end: 0; inset-inline-start: 18px; color: #8052ff; }
  .solutions-heading { display: flex; justify-content: space-between; align-items: end; gap: 48px; }
  .sectors { display: grid; grid-template-columns: 1fr 1fr; gap: 90px 120px; margin-top: 90px; }
  .sector { display: block; padding-block: 12px; }
  .sector .latin { color: #9a9a9a; }
  .sector h3 { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-block: 18px; }
  .sector h3 span { color: #8052ff; }
  .sector p { color: #bdbdbd; }
  .sector-link { display: inline-flex; gap: 18px; color: #ffb829; font-size: 14px; margin-top: 24px; }
  .closing { text-align: center; padding-block: 180px; }
  .closing-star { display: none; }
  .closing h2 { font-size: clamp(36px, 4.6vw, 66px); }
  .closing > p:not(.eyebrow) { color: #bdbdbd; margin-block: 30px; }
  @media (min-width: 1024px) { .wrap { width: min(1200px, calc(100% - 160px)); } }
  @media (max-width: 1100px) and (min-width: 768px) { .hero-copy { max-width: 53%; } .hero h1 { font-size: 76px; } .hero-art { width: 85vw; inset-inline-end: -25vw; } .hero { padding-block: 70px 90px; min-height: 850px; } .problem, .pillar, .workflow { gap: 60px; } }
  @media (max-width: 767px) {
    .hero { display: flex; flex-direction: column; align-items: stretch; padding-block: 36px 0; min-height: auto; }
    .hero-copy { width: 100%; max-width: none; }
    .hero h1 { font-size: clamp(54px, 12.5vw, 86px); line-height: 1.17; letter-spacing: -.025em; }
    .hero-description { font-size: 17px; line-height: 1.8; max-width: 470px; }
    .hero .hero-tagline { margin-top: 24px; font-size: 13px; }
    .hero-art { position: relative; width: calc(100% + 80px); height: 460px; inset: auto; margin-inline: -40px; margin-top: -10px; mask-image: linear-gradient(#000 85%, transparent); }
    .hero .actions { gap: 12px; }
    .governance-statement { padding-block: 36px 60px; }
    .section { padding-block: 72px; }
    .section h2 { font-size: 40px; line-height: 1.4; }
    .problem, .pillar, .workflow { grid-template-columns: 1fr; gap: 30px; min-height: auto; }
    .problem h2 { font-size: 32px; }
    .pillars-heading { margin-bottom: 30px; }
    .pillar { padding-block: 48px; }
    .pillar-symbol { justify-content: flex-start; }
    .pillar-symbol svg { width: 80px; height: 80px; }
    .pillar:nth-child(2) .pillar-symbol, .pillar:nth-child(2) .pillar-copy { order: initial; }
    .pillar h3 { font-size: 30px; }
    .solutions-heading { display: block; }
    .sectors { grid-template-columns: 1fr; gap: 48px; margin-top: 48px; }
    .closing { padding-block: 96px; }
  }
</style>

<style>
  .hero { display: grid; grid-template-columns: minmax(0,.95fr) minmax(0,1.05fr); gap: 60px; min-height: auto; padding-block: 76px 96px; }
  .hero-copy { width: auto; max-width: none; }
  .hero h1 { font-size: clamp(58px,6.2vw,88px); line-height: 1.35; letter-spacing: 0; }
  .hero-last { color: #b79aff; }
  .hero .hero-kicker { font-size: 12px; margin-bottom: 26px; color: #beb7c9; }
  .hero .hero-tagline { font-size: 12px; margin-block: 24px 16px; }
  .hero-description { font-size: 16px; line-height: 1.95; }
  .hero-art { position: relative; width: 100%; height: auto; inset: auto; mask-image: none; margin: 0; }
  .hero .actions { gap: 14px 24px; }
  .hero .button { padding: 12px 20px; }
  .section { padding-block: clamp(64px,8vw,112px); }
  .problem { min-height: auto; padding-block: 100px; border-block: 1px solid #2c2334; gap: 100px; }
  .problem-copy { border-inline-start: 2px solid #8052ff; padding-inline-start: 30px; }
  .pillar { gap: 80px; min-height: 330px; border-top: 1px solid #2c2334; }
  .pillar-symbol { background: radial-gradient(ellipse,#2a164080,transparent 65%); min-height: 240px; }
  .pillar-symbol svg { width: 125px; height: 125px; stroke-width: .9; transition: transform var(--motion-normal); }
  .pillar:is(:hover,:focus-within) .pillar-symbol svg { transform: translateY(-6px); }
  .workflow-intro { position: sticky; top: 40px; align-self: start; }
  .steps li { border-bottom: 1px solid #33263e; padding-block: 28px 40px; }
  .steps li:last-child { border-bottom: 0; }
  .home-products { display: block; margin-top: 48px; }
  .home-products .sector { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; border-top: 1px solid #33263e; padding-block: 24px; }
  .home-products .sector h3 { font-size: 28px; direction: ltr; text-align: right; margin: 0; }
  .home-products .sector p { font-size: 16px; }
  .sectors:not(.home-products) { gap: 0 72px; }
  .sectors:not(.home-products) .sector { border-top: 1px solid #33263e; padding-block: 30px; }
  .closing { border-block-start: 1px solid #33263e; background: radial-gradient(ellipse at 50% 100%,#2d154580,transparent 65%); }
  @media(max-width: 900px) { .hero { gap: 30px; }.hero h1 { font-size: 60px; }.workflow-intro { position: static; } }
  @media(max-width: 767px) { .hero { display: grid; grid-template-columns: 1fr; padding-block: 40px 56px; }.hero h1 { font-size: clamp(50px,12vw,76px); }.hero-art { margin-block-start: 16px; width: 100%; height: auto; }.hero .hero-kicker { font-size: 11px; }.home-products .sector { grid-template-columns: 1fr; gap: 12px; }.problem { padding-block: 56px; gap: 36px; }.pillar { gap: 24px; }.pillar-symbol { min-height: 160px; }.pillar-symbol svg { width: 90px; height: 90px; }.home-products .sector h3 { font-size: 26px; } }
  @media(prefers-reduced-motion:reduce) { .pillar:hover .pillar-symbol svg { transform: none; } }
</style>
