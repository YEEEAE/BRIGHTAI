<!-- BAI-VOC-001-C (2026-07-18): توحيد CTAs حسب intent — "تحدث مع فريق X" → "احجز جلسة جاهزية 30 دقيقة" (action-oriented، href=/contact/ نفسه). microcopy "بدون التزام • سرية بياناتك مضمونة" مضاف في SplitHero.astro. 0 href/action متغير. -->
---
/**
 * BrightAI Homepage — Phase 5
 * All 11+ sections preserved in original order.
 * Dark Enterprise SaaS design with CSS-only animations.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SplitHero from '../components/SplitHero.astro';
import LeadForm from '../components/LeadForm.astro';
import { FORM_TAXONOMY, DEFAULT_CONTACT_FIELDS } from '../data/marketing';
import DOMPurify from 'isomorphic-dompurify';

const faqItems = [
  { q: 'وش هي BrightAI؟', a: '<p><strong class="text-white">الجواب:</strong> BrightAI هي <strong>Saudi AI Safety OS</strong> — نظام تشغيل أمان وحوكمة للذكاء الاصطناعي داخل المؤسسات السعودية. تشتغل كطبقة وسيطة بين الموظف والـ AI وبيانات الشركة، وتضمن إن كل طلب ذكاء اصطناعي يكون آمن وموثّق وقابل للمراجعة.</p><p>عكس شات بوت عادي، BrightAI تركّب تحت أي نظام AI في شركتك وتفعّل AI Firewall وإخفاء البيانات الشخصية وسجل التدقيق والموافقات البشرية وملفات الأدلة — كلها مصممة لدعم متطلبات PDPL وNCA وSDAIA.</p>' },
  { q: 'هل BrightAI متوافقة مع نظام حماية البيانات الشخصية PDPL؟', a: '<p><strong class="text-white">الجواب:</strong> لا نقدر نؤكد امتثال BrightAI أو أي عميل لـ PDPL من الميزة وحدها. توفر المنصة أدوات تشغيلية مثل إخفاء بعض البيانات الشخصية وتوثيق الإجراءات، وقد تساعد المؤسسة في الاستعداد لمراجعة متطلباته.</p><p>يعتمد الامتثال النهائي على نطاق المؤسسة وبيئة النشر والضوابط المطبقة، ويحتاج تقييمًا مستقلًا. BrightAI ليست جهة اعتماد أو استشارة قانونية.</p>' },
  { q: 'هل BrightAI يشتغل مع المصانع الطبية؟', a: '<p><strong class="text-white">الجواب:</strong> نعم، <strong>BrightAI QMS AI</strong> مصمم خصيصاً للمصانع الطبية السعودية. يدير المرفوضات (Nonconformities) وCAPA والتدقيق الداخلي مع ربط مباشر مع أنظمة ERP.</p><p>يولّد Evidence File PDF جاهز للمدققين يدعم متطلبات SFDA وISO 13485، مع توقيع رقمي وتتبع كامل لكل إجراء.</p>' },
  { q: 'هل الذكاء الاصطناعي يقدر يتخذ قرار خطير بدون موافقة بشرية؟', a: '<p><strong class="text-white">الجواب:</strong> لا، الـ AI في BrightAI <strong>يقترح فقط</strong>. القرارات الخطيرة والعالية المخاطر تتطلب موافقة بشرية موثّقة من المدير المختص عبر <strong>Human Approval Layer</strong>، مع توقيع رقمي وتاريخ وإشعار فوري عبر واتساب أو البريد.</p><p>هذا يضمن بقاء السيطرة في أيدي البشر (Human-in-the-Loop) وعدم تفويض القرارات الحيوية للذكاء الاصطناعي بشكل كامل.</p>' },
  { q: 'هل ينفع نركّب BrightAI On-Premise داخل سيرفراتنا؟', a: '<p><strong class="text-white">الجواب:</strong> نعم، BrightAI يدعم <strong>3 أوضاع نشر</strong> تناسب احتياجات المؤسسات السعودية:</p><ul class="mt-2 space-y-1 list-disc list-inside"><li><strong>Cloud:</strong> مستضاف داخل السعودية</li><li><strong>Hybrid:</strong> نشر هجين بين السحابة والسيرفرات المحلية</li><li><strong>Air-Gapped:</strong> معزول بالكامل داخل شبكتك بدون أي اتصال خارجي — مثالي للجهات الحكومية والمصانع الحساسة</li></ul>' },
  { q: 'وش يميز BrightAI عن شات بوت AI العادي أو منصات الحوكمة الأجنبية؟', a: '<p><strong class="text-white">الجواب:</strong> BrightAI مو شات بوت ولا منصة حوكمة أجنبية. هي <strong>نظام تشغيل أمان سعودي</strong> (Saudi AI Safety OS) تركّب تحت أي نظام AI في شركتك وتفعّل:</p><ul class="mt-2 space-y-1 list-disc list-inside"><li><strong>AI Firewall</strong> مع إخفاء PII تلقائي</li><li><strong>سجل تدقيق</strong> غير قابل للتعديل محمي بـ Hash</li><li><strong>موافقات بشرية</strong> للقرارات عالية المخاطر</li><li><strong>ملفات أدلة PDF</strong> موقّعة رقمياً جاهزة للمدققين</li><li><strong>حزم امتثال</strong> جاهزة لـ PDPL وNCA وSFDA وISO 13485</li></ul><p>كل هذا مصنوع في السعودية، بالعربي، وبدعم سعودي مؤسسي.</p>' },
  { q: 'وش هي حزم الامتثال المتوفرة في BrightAI؟', a: '<p><strong class="text-white">الجواب:</strong> BrightAI يوفر <strong>6 حزم امتثال جاهزة</strong> مصممة للسوق السعودي:</p><ul class="mt-2 space-y-1 list-disc list-inside"><li><strong>PDPL Pack:</strong> حماية البيانات الشخصية وإخفاء PII</li><li><strong>NCA ECC Pack:</strong> ضوابط الأمن السيبراني 2-2024</li><li><strong>SFDA/ISO 13485 Pack:</strong> المصانع الطبية والجودة</li><li><strong>SAMA/ZATCA Pack:</strong> القطاع المالي والمصرفي</li><li><strong>Healthcare Pack:</strong> المستشفيات والرعاية الصحية</li><li><strong>Procurement Pack:</strong> المشتريات والمناقصات واعتماد</li></ul>' },
  { q: 'كم ياخذ وقت التركيب؟', a: '<p>الـ Pilot يطلع خلال <strong>30 يوم</strong> على قسم واحد. والنشر الكامل من 60 إلى 120 يوم حسب حجم الشركة.</p>' },
  { q: 'كم التكلفة؟', a: '<p>عندنا باقات حسب حجم الشركة وعدد المستخدمين. كلمنا عبر <a href="/go/whatsapp/" target="_blank" rel="noopener noreferrer" class="text-green-400 hover:underline" data-whatsapp data-cta-label="الواتساب" data-position="inline" data-page-type="home">الواتساب</a> للحصول على عرض سعر خلال 24 ساعة.</p>' },
];

// PERF-FIX (2026-07-07): Removed duplicate Organization / WebSite / WebPage /
// BreadcrumbList nodes. FoundationSchema (src/components/seo/Schema.astro) already
// emits the canonical versions of all four with the same @id. schema.org resolves
// entities by @id, so emitting the full node twice is wasted bytes.
// PERF-FIX (2026-07-14): Also removed the 5 LocalBusiness nodes (Jeddah, Dammam,
// Khobar, Mecca, Madinah) from the homepage. They are duplicated on each
// /solutions/<sector>/<city>/ page, and including them on the homepage bloats
// HTML by ~30KB. Each city page has its own canonical LocalBusiness @id, so
// search engines get the same entity information without the homepage bloat.
// We keep only entities that FoundationSchema does NOT emit:
//   - Service (Kernel product — Service, not SoftwareApplication:
//     no fabricated ratings, see SEMRUSH-FIX-2026-09-04 below)
//   - FAQPage (homepage Q&A)
//   - DefinedTermSet (technical AI governance terms)
// See /BRIGHTAI/.agents/brain.md Section 5.8 for the schema-helpers contract.
// BAI-SEO-003-S3 (2026-07-18): aggregateRating was removed (4.8/47 was
// fabricated — no source-backed reviews for Kernel). Re-add when a real
// review source is integrated (e.g. verified G2 / Capterra listing).
// SEMRUSH-FIX-2026-09-04: @type was WebApplication (SoftwareApplication
// subtype) — Google requires aggregateRating/review for Software App rich
// results, so every rating-less page flagged "Software App: 1 field
// invalid" in Semrush. Service carries the same commercial meaning with
// NO rating requirement. Never re-add a rating without a real source.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://brightai.live/#product",
    "name": "BrightAI Kernel",
    "serviceType": "AI Governance Platform",
    "description": "نواة حوكمة الذكاء الاصطناعي للمنشآت السعودية — تدعم جاهزية الامتثال وتشغيل AI Firewall وسجل التدقيق والموافقات البشرية وملفات الأدلة. ليست استشارة قانونية.",
    "url": "https://brightai.live/kernel/",
    "provider": {"@id": "https://brightai.live/#organization"},
    "areaServed": {"@type": "Country", "name": "المملكة العربية السعودية"},
    "offers": {
      "@type": "Offer",
      "priceCurrency": "SAR",
      "price": 0,
      "availability": "https://schema.org/InStock",
      "url": "https://brightai.live/contact/",
      "description": "تواصل عبر /contact/ للحصول على عرض سعر مخصص لحجم المنشأة"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a.replace(/<[^>]*>/g, '')
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    "@id": "https://brightai.live/#technical-ai-governance-terms",
    "name": "BrightAI technical AI governance terms",
    "inLanguage": ["en", "ar-SA"],
    "hasDefinedTerm": [
      { "@type": "DefinedTerm", "name": "AI Firewall", "alternateName": "جدار حماية الذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "Audit Trail", "alternateName": "سجل تدقيق الذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "Human Approval Layer", "alternateName": "طبقة الموافقة البشرية للذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "Evidence File", "alternateName": "ملف أدلة الامتثال" },
      { "@type": "DefinedTerm", "name": "Risk Scoring", "alternateName": "تقييم وتصنيف مخاطر الذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "PII Redaction", "alternateName": "إخفاء البيانات الشخصية في الذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "Compliance Packs", "alternateName": "حزم الامتثال التنظيمي" },
      { "@type": "DefinedTerm", "name": "Shadow AI", "alternateName": "الاستخدام الخفي للذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "Human-in-the-Loop", "alternateName": "الإنسان في الحلقة" }
    ]
  }
];

// SCHEMA-ENHANCEMENT (REPORT-23): City LocalBusiness nodes for Jeddah/Dammam/
// Khobar/Mecca/Madinah were previously appended here. REMOVED 2026-07-14
// (PERF-FIX): each city has its own page (/solutions/<sector>/<city>/) with
// its canonical LocalBusiness @id. The homepage FoundationSchema retains
// only the Riyadh LocalBusiness (the HQ, geo.region SA-01). Search engines
// resolve entities by @id, so removing duplicates from the homepage has no
// SEO downside and drops ~30KB of HTML.
// SEO-DEDUP (2026-08-23): the schema-only governance FAQPage that used to live
// here was REMOVED. Its 3 questions + answers were byte-identical to the
// FAQPage emitted by /blog/what-is-ai-governance-saudi-companies/ (see
// FAQ_BY_SLUG in src/pages/blog/[...slug].astro), and neither was visible on
// the page — invisible FAQ markup violates Google's structured-data policy
// (content must be visible) and the duplicate split entity signals between
// the homepage and the blog post. The blog post (the content owner) keeps the
// FAQ, now rendered visibly next to its schema. The general BrightAI FAQPage
// below stays — its questions ARE rendered visibly in section 11 (#faq).
const enhancedJsonLd = jsonLd;
---

{/* REPORTS-SEO-KEYWORDS-2026-07-08: Homepage re-targeted to the AI Governance
    keyword cluster. Title now leads with the canonical Saudi search term
    "حوكمة الذكاء الاصطناعي" + location phrase. Description carries the same
    anchor + the "الذكاء الاصطناعي في السعودية" variant + a clear CTA.
    hreflang enriched with en-SA (placeholder EN homepage) + x-default so the
    page signals bilingual availability to Google. Foundation schema (Org +
    WebSite + LocalBusiness + WebPage) is emitted by FoundationSchema — no
    duplicate @id emitted here (see PERF-FIX comment above). */}
<BaseLayout
  title="حوكمة الذكاء الاصطناعي في السعودية | BrightAI"
   description="BRIGHTAI شركة ذكاء اصطناعي في السعودية تقدم حوكمة وأمان AI للشركات: حماية بيانات، سجل تدقيق، وموافقات بشرية لدعم الجاهزية وفق PDPL وNCA."
  canonical="https://brightai.live/"
  hreflang={[
    {lang:'ar-SA',href:'https://brightai.live/'},
    {lang:'en-SA',href:'https://brightai.live/en/'},
    {lang:'x-default',href:'https://brightai.live/'}
  ]}
  jsonLd={enhancedJsonLd as any}
  extraSpeakableSelectors={['.home-citable-definition', 'aside[data-snippet="tl-dr"]']}
>
{/* ═══════════════ 1. HERO (SplitHero — page background is SiteBackground in BaseLayout) ═══════════════ */}
<SplitHero />

{/* REPORTS-AEO-CITABLE-2026-07-08: Citability paragraph (40-50 words).
   AEO-tuned definition placed at the very top of the page body so Google
   AI Overviews / Perplexity can quote it verbatim. Tagged data-speakable
   to opt in to the foundation speakable schema (currently h1-only, future-
   ready). The block is visually subtle and does NOT count as a new
   section in the 16-section rule. */}
<section class="home-citable-definition" aria-label="تعريف حوكمة الذكاء الاصطناعي" data-speakable>
  <div class="max-w-4xl mx-auto px-5 lg:px-8 py-6 text-center">
    {/* SEO-TRUST (2026-08-23): the regulatory entities named in the citable
        definition now link to their official sources — the same verified
        URLs already referenced by /hub/ai-governance/ (PDPL via سدايا،
        سدايا regulations page، NCA ECC controls) plus the official
        ISO/IEC 42001 catalogue page. External authority links from the
        entity-defining paragraph strengthen E-E-A-T; no claims added. */}
    <p class="text-base lg:text-lg leading-loose text-white/85">
      <strong>حوكمة الذكاء الاصطناعي</strong> هي مجموعة السياسات والإجراءات والأدوات التي تضمن استخدام الذكاء الاصطناعي بشكل آمن وأخلاقي ومتوافق مع الأنظمة داخل المنشأة. BRIGHTAI شركة ذكاء اصطناعي في السعودية تركّز على تشغيل هذه الحوكمة داخل المؤسسة، مو على تقديم نموذج عام أو شات بوت فقط. لذلك، إذا كنت تقارن بين شركات الذكاء الاصطناعي في السعودية أو تبحث عن الذكاء الاصطناعي في السعودية، فابحث عن قدرة عملية على حماية البيانات وتوثيق الاستخدام وربط القرار بمسؤول بشري. ومن المراجع المهمة معيار <a href="https://www.iso.org/standard/42001" target="_blank" rel="noopener noreferrer" class="underline decoration-white/30 hover:decoration-white/70 underline-offset-4">ISO/IEC 42001</a> لإدارة أنظمة الذكاء الاصطناعي. في السعودية، تساعد حوكمة البيانات وحماية البيانات الشخصية الشركات على تشغيل AI بوضوح، مع مراعاة <a href="https://dgp.sdaia.gov.sa/wps/portal/pdp/knowledgecenter/details/PDPL/" target="_blank" rel="noopener noreferrer" class="underline decoration-white/30 hover:decoration-white/70 underline-offset-4">PDPL</a> وإرشادات <a href="https://sdaia.gov.sa/en/SDAIA/about/Pages/RegulationsAndPolicies.aspx" target="_blank" rel="noopener noreferrer" class="underline decoration-white/30 hover:decoration-white/70 underline-offset-4">سدايا</a> و<a href="https://nca.gov.sa/ar/regulatory-documents/controls-list/ecc/" target="_blank" rel="noopener noreferrer" class="underline decoration-white/30 hover:decoration-white/70 underline-offset-4">NCA ECC</a>.
    </p>
  </div>
</section>

{/* BAI-SEO-003-S7 (2026-07-18): P0 snippet pack — TL;DR / الخلاصة.
   Answer-first, self-contained, ≤60 words, formal Arabic. Visual
   surface reuses .answer-first-summary (pages.css) — no new CSS.
   Single source of truth: src/data/snippet-pack.ts. */}
<aside data-snippet="tl-dr" aria-label="الخلاصة" class="answer-first-summary">
  <p>برايت أيه آي هي نظام تشغيل أمان وحوكمة للذكاء الاصطناعي مصمم للشركات السعودية. تركّب تحت أي نموذج داخل المنشأة وتفعّل جدار حماية للبيانات وسجل تدقيق غير قابل للتعديل وموافقات بشرية على القرارات عالية الأثر، وتدعم جاهزية الامتثال لنظام حماية البيانات الشخصية وضوابط الأمن السيبراني وإرشادات سدايا. أداة تشغيلية لا تعد استشارة قانونية.</p>
</aside>

{/* ═══════════════ 2. PROBLEM ═══════════════ */}
<section id="problem" aria-labelledby="problem-title" class="home-section--padded bg-ambient-dots">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="max-w-3xl section__header section__header--start">
      <span class="section__eyebrow" lang="ar">المشكلة</span>
      <h2 id="problem-title" class="section__title section__title--start">شركات الذكاء الاصطناعي في السعودية تواجه نفس أسئلة الأمان والحوكمة</h2>
      <p class="section__subtitle section__subtitle--start">السعودية ماشية بسرعة نحو الذكاء الاصطناعي، وفي نفس الوقت <strong>NCA</strong> حدّثت الضوابط، و<strong>SDAIA</strong> أصدرت إرشادات، و<strong>PDPL</strong> صار إلزامي. النتيجة؟ <span class="text-white">الكل يبي AI، بس يبيه آمن.</span></p>
    </div>
    <ul class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      <li class="feature-card rounded-2xl p-6"><svg class="text-2xl text-cyan-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-incognito"></use></svg><h3 class="mt-3 font-bold text-lg">هل الموظف يرفع بيانات حساسة؟</h3><p class="text-white/60 text-sm mt-1">أرقام هويات، ملفات مرضى، عقود، أسعار... تروح وين؟</p></li>
      <li class="feature-card rounded-2xl p-6"><svg class="text-2xl text-cyan-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-bug"></use></svg><h3 class="mt-3 font-bold text-lg">وش لو الـ AI أعطى جواب غلط؟</h3><p class="text-white/60 text-sm mt-1">خطأ في النموذج يوصل لقرار خاطئ = خسارة فعلية.</p></li>
      <li class="feature-card rounded-2xl p-6"><svg class="text-2xl text-cyan-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-clipboard-list"></use></svg><h3 class="mt-3 font-bold text-lg">وين سجل التدقيق؟</h3><p class="text-white/60 text-sm mt-1">لما يجي المدقق ويسأل: مين سأل، متى، وش رد؟</p></li>
      <li class="feature-card rounded-2xl p-6"><svg class="text-2xl text-cyan-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-scale-balance"></use></svg><h3 class="mt-3 font-bold text-lg">هل متوافق مع PDPL؟</h3><p class="text-white/60 text-sm mt-1">نظام حماية البيانات ما يمزح. غرامات تصل لملايين.</p></li>
      <li class="feature-card rounded-2xl p-6"><svg class="text-2xl text-cyan-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-database"></use></svg><h3 class="mt-3 font-bold text-lg">هل AI يعدّل في الـ ERP بالغلط؟</h3><p class="text-white/60 text-sm mt-1">خصم مخزون، تحديث عقد... بدون موافقة؟</p></li>
      <li class="feature-card rounded-2xl p-6"><svg class="text-2xl text-cyan-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-handshake"></use></svg><h3 class="mt-3 font-bold text-lg">هل الطبيب/المحاسب يثق فيه؟</h3><p class="text-white/60 text-sm mt-1">بدون شفافية ومصادر، ما حد بيستخدمه.</p></li>
    </ul>
  </div>
</section>

<div class="ambient-separator" aria-hidden="true"></div>

{/* ═══════════════ GOVERNANCE CENTER ═══════════════ */}
<section id="ai-governance-center" aria-labelledby="ai-governance-center-title" class="home-section--padded bg-ambient-teal-top">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="card card--glass rounded-3xl p-7 lg:p-10">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">
        <div class="max-w-3xl">
