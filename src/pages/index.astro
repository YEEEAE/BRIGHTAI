---
/**
 * BrightAI Homepage — Phase 5
 * All 11+ sections preserved in original order.
 * Dark Enterprise SaaS design with CSS-only animations.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SplitHero from '../components/SplitHero.astro';
import {
  LOCAL_BUSINESS_BY_CITY,
  appendLd,
} from '../data/schema-helpers';

const faqItems = [
  { q: 'وش هي BrightAI؟', a: '<p><strong class="text-white">الجواب:</strong> BrightAI هي <strong>Saudi AI Safety OS</strong> — نظام تشغيل أمان وحوكمة للذكاء الاصطناعي داخل المؤسسات السعودية. تشتغل كطبقة وسيطة بين الموظف والـ AI وبيانات الشركة، وتضمن إن كل طلب ذكاء اصطناعي يكون آمن وموثّق وقابل للمراجعة.</p><p>عكس شات بوت عادي، BrightAI تركّب تحت أي نظام AI في شركتك وتفعّل AI Firewall وإخفاء البيانات الشخصية وسجل التدقيق والموافقات البشرية وملفات الأدلة — كلها متوافقة مع PDPL وNCA وSDAIA.</p>' },
  { q: 'هل BrightAI متوافقة مع نظام حماية البيانات الشخصية PDPL؟', a: '<p><strong class="text-white">الجواب:</strong> نعم، BrightAI متوافقة مع نظام حماية البيانات الشخصية السعودي PDPL من اليوم الأول. يتوفر <strong>PDPL Compliance Pack</strong> جاهز يتضمن إخفاء البيانات الشخصية تلقائياً (PII Redaction)، سجل الموافقات، سجل مشاركة البيانات، وإشعارات أصحاب البيانات.</p><p>النظام ينتج تقارير امتثال جاهزة لتقديمها مباشرة للمدققين أو هيئة سدايا (SDAIA)، مع توقيع رقمي يمنع التعديل.</p>' },
  { q: 'هل BrightAI يشتغل مع المصانع الطبية؟', a: '<p><strong class="text-white">الجواب:</strong> نعم، <strong>BrightAI QMS AI</strong> مصمم خصيصاً للمصانع الطبية السعودية. يدير المرفوضات (Nonconformities) وCAPA والتدقيق الداخلي مع ربط مباشر مع أنظمة ERP.</p><p>يولّد Evidence File PDF جاهز للمدققين متوافق مع متطلبات SFDA وISO 13485، مع توقيع رقمي وتتبع كامل لكل إجراء.</p>' },
  { q: 'هل الذكاء الاصطناعي يقدر يتخذ قرار خطير بدون موافقة بشرية؟', a: '<p><strong class="text-white">الجواب:</strong> لا، الـ AI في BrightAI <strong>يقترح فقط</strong>. القرارات الخطيرة والعالية المخاطر تتطلب موافقة بشرية موثّقة من المدير المختص عبر <strong>Human Approval Layer</strong>، مع توقيع رقمي وتاريخ وإشعار فوري عبر واتساب أو البريد.</p><p>هذا يضمن بقاء السيطرة في أيدي البشر (Human-in-the-Loop) وعدم تفويض القرارات الحيوية للذكاء الاصطناعي بشكل كامل.</p>' },
  { q: 'هل ينفع نركّب BrightAI On-Premise داخل سيرفراتنا؟', a: '<p><strong class="text-white">الجواب:</strong> نعم، BrightAI يدعم <strong>3 أوضاع نشر</strong> تناسب احتياجات المؤسسات السعودية:</p><ul class="mt-2 space-y-1 list-disc list-inside"><li><strong>Cloud:</strong> مستضاف داخل السعودية</li><li><strong>Hybrid:</strong> نشر هجين بين السحابة والسيرفرات المحلية</li><li><strong>Air-Gapped:</strong> معزول بالكامل داخل شبكتك بدون أي اتصال خارجي — مثالي للجهات الحكومية والمصانع الحساسة</li></ul>' },
  { q: 'وش يميز BrightAI عن شات بوت AI العادي أو منصات الحوكمة الأجنبية؟', a: '<p><strong class="text-white">الجواب:</strong> BrightAI مو شات بوت ولا منصة حوكمة أجنبية. هي <strong>نظام تشغيل أمان سعودي</strong> (Saudi AI Safety OS) تركّب تحت أي نظام AI في شركتك وتفعّل:</p><ul class="mt-2 space-y-1 list-disc list-inside"><li><strong>AI Firewall</strong> مع إخفاء PII تلقائي</li><li><strong>سجل تدقيق</strong> غير قابل للتعديل محمي بـ Hash</li><li><strong>موافقات بشرية</strong> للقرارات عالية المخاطر</li><li><strong>ملفات أدلة PDF</strong> موقّعة رقمياً جاهزة للمدققين</li><li><strong>حزم امتثال</strong> جاهزة لـ PDPL وNCA وSFDA وISO 13485</li></ul><p>كل هذا مصنوع في السعودية، بالعربي، وبدعم سعودي 24/7.</p>' },
  { q: 'وش هي حزم الامتثال المتوفرة في BrightAI؟', a: '<p><strong class="text-white">الجواب:</strong> BrightAI يوفر <strong>6 حزم امتثال جاهزة</strong> مصممة للسوق السعودي:</p><ul class="mt-2 space-y-1 list-disc list-inside"><li><strong>PDPL Pack:</strong> حماية البيانات الشخصية وإخفاء PII</li><li><strong>NCA ECC Pack:</strong> ضوابط الأمن السيبراني 2-2024</li><li><strong>SFDA/ISO 13485 Pack:</strong> المصانع الطبية والجودة</li><li><strong>SAMA/ZATCA Pack:</strong> القطاع المالي والمصرفي</li><li><strong>Healthcare Pack:</strong> المستشفيات والرعاية الصحية</li><li><strong>Procurement Pack:</strong> المشتريات والمناقصات واعتماد</li></ul>' },
  { q: 'كم ياخذ وقت التركيب؟', a: '<p>الـ Pilot يطلع خلال <strong>30 يوم</strong> على قسم واحد. والنشر الكامل من 60 إلى 120 يوم حسب حجم الشركة.</p>' },
  { q: 'كم التكلفة؟', a: '<p>عندنا باقات حسب حجم الشركة وعدد المستخدمين. كلمنا عبر <a href="https://wa.me/966538229013" target="_blank" rel="nofollow noopener noreferrer" class="text-green-400 hover:underline">الواتساب</a> للحصول على عرض سعر خلال 24 ساعة.</p>' },
];

// PERF-FIX (2026-07-07): Removed duplicate Organization / WebSite / WebPage /
// BreadcrumbList nodes. FoundationSchema (src/components/seo/Schema.astro) already
// emits the canonical versions of all four with the same @id. schema.org resolves
// entities by @id, so emitting the full node twice is wasted bytes.
// We keep only entities that FoundationSchema does NOT emit:
//   - SoftwareApplication (Kernel product)
//   - FAQPage (homepage Q&A)
//   - DefinedTermSet (technical AI governance terms)
//   - 5 LocalBusiness nodes (Jeddah, Dammam, Khobar, Mecca, Madinah).
//     The Riyadh LocalBusiness is in FoundationSchema already, so we omit it here.
// See /BRIGHTAI/.agents/brain.md Section 5.8 for the schema-helpers contract.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": ["SoftwareApplication", "WebApplication"],
    "@id": "https://brightai.site/#product",
    "name": "BrightAI Kernel",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Cloud, Hybrid, On-Premise",
    "description": "نواة حوكمة الذكاء الاصطناعي للمنشآت السعودية — تدعم جاهزية الامتثال وتشغيل AI Firewall وسجل التدقيق والموافقات البشرية وملفات الأدلة. ليست استشارة قانونية.",
    "url": "https://brightai.site/kernel/",
    "provider": {"@id": "https://brightai.site/#organization"},
    "featureList": [
      "AI Firewall — فحص الطلبات ومنع تسريب البيانات",
      "PII Redaction — إخفاء البيانات الشخصية تلقائياً",
      "Audit Trail — سجل تدقيق غير قابل للتعديل",
      "Human Approval Layer — موافقات بشرية للقرارات عالية المخاطر",
      "AI Evidence File — ملفات أدلة PDF موقّعة رقمياً",
      "Risk Scoring — تصنيف مخاطر كل طلب",
      "Compliance Packs — حزم امتثال PDPL وNCA وSFDA وSAMA",
      "Policy Editor — محرر سياسات بدون تعقيد تقني",
      "Enterprise Connectors — ربط آمن مع ERP وCRM وHIS"
    ],
    "offers": {
      "@type": "Offer",
      "priceCurrency": "SAR",
      "price": 0,
      "availability": "https://schema.org/InStock",
      "url": "https://brightai.site/contact/",
      "description": "تواصل عبر /contact/ للحصول على عرض سعر مخصص لحجم المنشأة"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.8",
      "ratingCount": "47",
      "bestRating": "5",
      "worstRating": "1"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a.replace(/<[^>]*>/g, '')
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    "@id": "https://brightai.site/#technical-ai-governance-terms",
    "name": "BrightAI technical AI governance terms",
    "inLanguage": ["en", "ar-SA"],
    "hasDefinedTerm": [
      { "@type": "DefinedTerm", "name": "AI Firewall", "alternateName": "جدار حماية الذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "Audit Trail", "alternateName": "سجل تدقيق الذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "Human Approval Layer", "alternateName": "طبقة الموافقة البشرية للذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "Evidence File", "alternateName": "ملف أدلة الامتثال" },
      { "@type": "DefinedTerm", "name": "Risk Scoring", "alternateName": "تقييم وتصنيف مخاطر الذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "PII Redaction", "alternateName": "إخفاء البيانات الشخصية في الذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "Compliance Packs", "alternateName": "حزم الامتثال التنظيمي" },
      { "@type": "DefinedTerm", "name": "Shadow AI", "alternateName": "الاستخدام الخفي للذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "Human-in-the-Loop", "alternateName": "الإنسان في الحلقة" }
    ]
  }
];

// SCHEMA-ENHANCEMENT (REPORT-23): append the 5 LocalBusiness nodes for cities
// other than Riyadh (Riyadh LocalBusiness is in FoundationSchema).
// FoundationSchema emits Organization + WebSite + LocalBusiness (Riyadh) +
// WebPage + BreadcrumbList — those are referenced by @id where applicable.
// See /BRIGHTAI/.agents/brain.md Section 5.8 for the schema-helpers contract.
// REPORTS-AEO-FAQ-2026-07-08: also append an AEO FAQPage node with the
// canonical "حوكمة الذكاء الاصطناعي" pillar answers (40-60 words each,
// Saudi dialect, derived from the existing pillar blog post). This second
// FAQPage is scoped to AI Governance topic and tagged with its own @id so
// the existing BrightAI-product FAQPage stays untouched.
const aiGovernanceFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://brightai.site/#faq-ai-governance',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'ما هي حوكمة الذكاء الاصطناعي ولماذا تحتاجها المنشآت السعودية؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'حوكمة الذكاء الاصطناعي هي منظومة من الأدوار والسياسات والضوابط والأدلة التي تنظم كيفية اختيار واستخدام ومراقبة AI داخل المنشأة. تحتاجها المنشآت السعودية لأنها: (1) تمكّن الابتكار المتحكم به، (2) تحقق الامتثال لـ PDPL وNCA وSDAIA، (3) تثبت المسؤولية عند الحوادث، (4) تبني ثقة العملاء والمستثمرين، (5) تحمي البيانات الحساسة من التسريب.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما مكونات إطار حوكمة الذكاء الاصطناعي الفعّال؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'إطار الحوكمة الفعّال يتكون من: (1) جرد حالات الاستخدام والموردين، (2) تصنيف المخاطر حسب نوع البيانات والأثر، (3) سياسات استخدام واضحة، (4) ضوابط تقنية (جدار AI، فحص بيانات)، (5) موافقات بشرية للقرارات الحساسة، (6) سجل تدقيق شامل، (7) ملف أدلة قابل للمراجعة، (8) مؤشرات أداء وتقارير دورية للإدارة العليا.',
      },
    },
    {
      '@type': 'Question',
      name: 'كيف تبدأ منشأتك في تطبيق حوكمة الذكاء الاصطناعي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ابدأ بخمس خطوات: (1) جرد حالات الاستخدام والموردين، (2) تصنيف المخاطر حسب نوع البيانات والأثر، (3) تعيين مسؤول حوكمة AI، (4) صياغة سياسات استخدام قصيرة ومحددة، (5) تطبيق الضوابط التقنية (جدار، سجل تدقيق، موافقات بشرية). ثم وسّع تدريجياً: تدريب الموظفين، ربط بـ PDPL وNCA وSDAIA، قياس النضج، التحسين المستمر كل ربع سنة.',
      },
    },
  ],
};

const enhancedJsonLd = appendLd(jsonLd, [
  LOCAL_BUSINESS_BY_CITY.jeddah,
  LOCAL_BUSINESS_BY_CITY.dammam,
  LOCAL_BUSINESS_BY_CITY.khobar,
  LOCAL_BUSINESS_BY_CITY.mecca,
  LOCAL_BUSINESS_BY_CITY.madinah,
  aiGovernanceFaq,
]);
---

<BaseLayout
  title="BrightAI | حوكمة وأمان AI للشركات السعودية — PDPL"
  description="منصة سعودية متكاملة لحوكمة وأمان AI. تجمع AI Firewall، سجلات التدقيق، والموافقات البشرية في نظام واحد متوافق مع PDPL وNCA ECC لتأمين مؤسستك اليوم."
  canonical="https://brightai.site/"
  hreflang={[{lang:'ar-SA',href:'https://brightai.site/'}]}
  jsonLd={enhancedJsonLd as any}
>
{/* ═══════════════ 1. HERO (SplitHero — DottedBackground now in BaseLayout) ═══════════════ */}
<SplitHero />

{/* REPORTS-AEO-CITABLE-2026-07-08: Citability paragraph (40-50 words).
   AEO-tuned definition placed at the very top of the page body so Google
   AI Overviews / Perplexity can quote it verbatim. Tagged data-speakable
   to opt in to the foundation speakable schema (currently h1-only, future-
   ready). The block is visually subtle and does NOT count as a new
   section in the 16-section rule. */}
<section class="home-citable-definition" aria-label="تعريف حوكمة الذكاء الاصطناعي" data-speakable>
  <div class="max-w-4xl mx-auto px-5 lg:px-8 py-6 text-center">
    <p class="text-base lg:text-lg leading-loose text-white/85">
      <strong>حوكمة الذكاء الاصطناعي</strong> هي مجموعة السياسات والإجراءات والأدوات التي تضمن استخدام الذكاء الاصطناعي بشكل آمن وأخلاقي ومتوافق مع الأنظمة داخل المنشأة. في السعودية، تشمل الامتثال لـ PDPL وسدايا وNCA ECC.
    </p>
  </div>
</section>

{/* ═══════════════ 2. PROBLEM ═══════════════ */}
<section id="problem" aria-labelledby="problem-title" class="home-section--padded bg-ambient-dots">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="max-w-3xl section__header section__header--start">
      <span class="section__eyebrow" lang="ar">المشكلة</span>
      <h2 id="problem-title" class="section__title section__title--start">كل شركة تبي AI… بس كلهم خايفين من نفس الأسئلة</h2>
      <p class="section__subtitle section__subtitle--start">السعودية ماشية بسرعة نحو الذكاء الاصطناعي، وفي نفس الوقت <strong>NCA</strong> حدّثت الضوابط، و<strong>SDAIA</strong> أصدرت إرشادات، و<strong>PDPL</strong> صار إلزامي. النتيجة؟ <span class="text-white">الكل يبي AI، بس يبيه آمن.</span></p>
    </div>
    <ul class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      <li class="feature-card rounded-2xl p-6"><svg class="text-2xl text-cyan-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-incognito"></use></svg><h3 class="mt-3 font-bold text-lg">هل الموظف يرفع بيانات حساسة؟</h3><p class="text-white/60 text-sm mt-1">أرقام هويات، ملفات مرضى، عقود، أسعار... تروح وين؟</p></li>
      <li class="feature-card rounded-2xl p-6"><svg class="text-2xl text-cyan-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-bug"></use></svg><h3 class="mt-3 font-bold text-lg">وش لو الـ AI أعطى جواب غلط؟</h3><p class="text-white/60 text-sm mt-1">خطأ في النموذج يوصل لقرار خاطئ = خسارة فعلية.</p></li>
      <li class="feature-card rounded-2xl p-6"><svg class="text-2xl text-cyan-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-clipboard-list"></use></svg><h3 class="mt-3 font-bold text-lg">وين سجل التدقيق؟</h3><p class="text-white/60 text-sm mt-1">لما يجي المدقق ويسأل: مين سأل، متى، وش رد؟</p></li>
      <li class="feature-card rounded-2xl p-6"><svg class="text-2xl text-cyan-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-scale-balance"></use></svg><h3 class="mt-3 font-bold text-lg">هل متوافق مع PDPL؟</h3><p class="text-white/60 text-sm mt-1">نظام حماية البيانات ما يمزح. غرامات تصل لملايين.</p></li>
      <li class="feature-card rounded-2xl p-6"><svg class="text-2xl text-cyan-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-database"></use></svg><h3 class="mt-3 font-bold text-lg">هل AI يعدّل في الـ ERP بالغلط؟</h3><p class="text-white/60 text-sm mt-1">خصم مخزون، تحديث عقد... بدون موافقة؟</p></li>
      <li class="feature-card rounded-2xl p-6"><svg class="text-2xl text-cyan-400" aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-handshake"></use></svg><h3 class="mt-3 font-bold text-lg">هل الطبيب/المحاسب يثق فيه؟</h3><p class="text-white/60 text-sm mt-1">بدون شفافية ومصادر، ما حد بيستخدمه.</p></li>
    </ul>
  </div>
</section>

<div class="ambient-separator" aria-hidden="true"><span class="ambient-separator-node"></span></div>

{/* ═══════════════ GOVERNANCE CENTER ═══════════════ */}
<section id="ai-governance-center" aria-labelledby="ai-governance-center-title" class="home-section--padded bg-ambient-teal-top">
  <div class="max-w-7xl mx-auto px-5 lg:px-8">
    <div class="card card--glass rounded-3xl p-7 lg:p-10">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">
        <div class="max-w-3xl">
          <span class="section__eyebrow" lang="ar">Saudi AI Safety OS</span>
          <h2 id="ai-governance-center-title" class="section__title section__title--start mt-4">مركز حوكمة الذكاء الاصطناعي</h2>
          <p class="section__subtitle section__subtitle--start mt-4">BrightAI تساعد المؤسسات السعودية على تحويل سياسات الذكاء الاصطناعي إلى ضوابط تشغيلية قابلة للتدقيق، عبر طبقة تربط الموظف، بيانات المؤسسة، نموذج AI، والمراجعة البشرية، لتضمن تفعيلاً متكاملاً لـ AI Firewall وسجل تدقيق وموافقات بشرية وملفات أدلة متوافقة.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href="/solutions/ai-governance-platform/" class="glow-btn inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-white font-bold"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-scale-balance"></use></svg> استكشف حلول الحوكمة</a>
          <a href="/contact/" class="card card--glass inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-white font-bold hover:border-cyan-500/40 transition-all"><svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-message-text"></use></svg> تحدث مع فريق BrightAI</a>
        </div>
