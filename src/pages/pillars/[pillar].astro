---
import PillarContentExtension from '../../components/PillarContentExtension.astro';
import PageShell from '../../components/PageShell.astro';
export const prerender = true;
export const pillars = [
  { slug: 'safety', no: '01', title: 'السلامة والموثوقية', intro: 'صمّم الاستخدام بحيث يعرف الفريق حدود النظام، ومتى يحتاج إلى تحقق أو مراجعة أو إيقاف.', prompts: ['ما الضرر المحتمل ومن قد يتأثر؟', 'من يملك قرار إيقاف الاستخدام؟', 'كيف تتحقق من المخرجات قبل الاعتماد؟'], products: [['risk-engine', 'Risk Engine'], ['human-gate', 'Human Gate']] },
  { slug: 'transparency', no: '02', title: 'الشفافية والمساءلة', intro: 'اربط كل استخدام بغرض ومالك ومسؤولية واضحة، ووثق القرار والضوابط التي اعتمدتها الجهة.', prompts: ['من يملك حالة الاستخدام؟', 'ما الدليل اللازم للمراجعة؟', 'كيف يُسجل التغيير والاعتماد؟'], products: [['ledger', 'Ledger'], ['human-gate', 'Human Gate']] },
  { slug: 'privacy', no: '03', title: 'الخصوصية وحماية البيانات', intro: 'حدد أنواع البيانات والغرض والقناة والمستلمين قبل إدخالها في أداة ذكاء اصطناعي.', prompts: ['هل توجد بيانات شخصية أو حساسة؟', 'هل هناك غرض وصلاحية وقناة معتمدة؟', 'ما سياسة الاحتفاظ والحذف المثبتة؟'], products: [['firewall', 'Firewall'], ['secure-chat', 'Secure Chat']] },
];
export function getStaticPaths() { return pillars.map(({ slug, ...props }) => ({ params: { pillar: slug }, props })); }
const { no, title, intro, prompts, products } = Astro.props;
---
<PageShell title={`${title} | حوكمة الذكاء الاصطناعي — BRIGHTAI`} description={intro} crumbs={[{ name: 'الأركان', href: '/#principles' }, { name: title }]}>
  <div class="pillar-manifesto"><span class="pillar-number" aria-hidden="true">{no}</span><div><p class="eyebrow">ركن من أركان الحوكمة</p><h1>{title}</h1><p class="lead">{intro}</p></div></div>
  <p class="note">هذه مبادئ توجيهية لا تثبت تطبيقها بواسطة منتج. منتجات AIGAS مخططة والإتاحة التشغيلية غير متحققة. قيّم كل حالة وفق متطلبات الجهة المختصة.</p>
  <section class="block review-questions"><h2>حوّل المبدأ<br/>إلى أسئلة عملية.</h2><ol>{prompts.map((question: string) => <li>{question}</li>)}</ol></section>
  <section class="block"><h2>منتجات مرتبطة في التصور</h2><p>الأسماء التالية توضح اتجاه الـBlueprint فقط، وليست قائمة خدمات متاحة.</p><div class="actions">{products.map(([slug, name]: string[]) => <a class="ghost" href={`/products/${slug}/`} dir="ltr">{name}</a>)}<a class="button" href="/docs/">مركز المعرفة</a></div></section>
  <PillarContentExtension kind={no}/>
</PageShell>
