---
import PageShell from '../../components/PageShell.astro';
export const prerender = true;
export function getStaticPaths() {
  return [
    {
      slug: 'safety', no: '01', title: 'السلامة والموثوقية', line: 'حدود واضحة. والقرار الأخير للإنسان.',
      intro: 'نظام الذكاء الاصطناعي الآمن لا يسبب ضرراً للأفراد أو الممتلكات أو البيئة، ويعمل ضمن حدود مدروسة ومعروفة مسبقاً، لا حسب ما يقرره النموذج في لحظتها.',
      means: ['تحديد ما يُسمح للنظام فعله وما لا يُسمح، قبل تشغيله', 'تصنيف الطلبات حسب أثرها، فلا يُعامل التلخيص مثل قرار تمويل', 'إيقاف القرارات عالية الأثر حتى يراجعها إنسان', 'استمرار الخدمة عند تعطل مزود، دون أن تُتجاوز الضوابط'],
      questions: ['هل تعرف أي القرارات في جهتك يشارك فيها الذكاء الاصطناعي اليوم؟', 'من يملك صلاحية إيقاف نظام يتصرف بشكل غير متوقع؟', 'ماذا يحدث لو توقف مزود النموذج فجأة؟'],
      how: 'تقييم كل طلب من 0 إلى 100 عبر Risk Engine، وإيقاف الحرج منها عبر Human Gate، والتحويل التلقائي بين المزودين مع قاطع الدائرة في K4.',
      sdaia: 'الموثوقية والسلامة، والإنسانية',
      products: [['risk-engine', 'Risk Engine'], ['human-gate', 'Human Gate']],
    },
    {
      slug: 'transparency', no: '02', title: 'الشفافية والمساءلة', line: 'كل طلب له أثر. وكل قرار له مسؤول.',
      intro: 'الشفافية أن تعرف من أين جاءت البيانات، وأي نموذج أجاب، وبأي إصدار. والمساءلة أن يكون لكل قرار خوارزمي جهة أو شخص مسؤول بالاسم.',
      means: ['معرفة مصدر البيانات التي دخلت النموذج', 'تتبع تاريخ النموذج (Model Lineage): الإصدار والقالب والسياسة السارية وقت القرار', 'تحديد المسؤول عن كل قرار تم بمساعدة الخوارزمية', 'سجل لا يمكن تعديله دون أن ينكشف التعديل'],
      questions: ['لو طلبت منك جهة رقابية سجل قرارات الشهر الماضي، كم يوماً تحتاج؟', 'هل تعرف أي إصدار نموذج أنتج توصية معينة؟', 'من وقّع على آخر قرار حساس صدر بمساعدة الذكاء الاصطناعي؟'],
      how: 'AIGAS Ledger يسجل كل طلب في سلسلة بصمات تشفيرية، ويوثق Model Lineage في Enterprise، وتقدم خدمة سجل النماذج حصراً لكل الأنظمة لديكم.',
      sdaia: 'الشفافية والقابلية للتفسير، والمساءلة والمسؤولية',
      products: [['ledger', 'Ledger'], ['human-gate', 'Human Gate']],
    },
    {
      slug: 'privacy', no: '03', title: 'الخصوصية وحماية البيانات', line: 'بياناتك تبقى تحت سيطرتك.',
      intro: 'حماية البيانات الشخصية تعني ألا تتسرب لطرف لا يحق له رؤيتها. لكن الإخفاء المبالغ فيه يمنعك من رؤية الانحياز. نحن نحمي الفرد ونترك لك رؤية النمط.',
      means: ['اكتشاف البيانات الشخصية وحجبها قبل خروجها من بيئتك', 'منع تسرب بيانات الاعتماد والأسرار', 'إبقاء نوع البيان ظاهراً حتى بعد حجب قيمته، لتمكين تحليل الانحياز', 'حذف سياقات المحادثة تلقائياً، والاحتفاظ بالسجلات وفق المدة المعتمدة فقط'],
      questions: ['هل تعرف ما الذي يلصقه موظفوك في أدوات الذكاء الاصطناعي؟', 'هل يمكنك إثبات أن أرقام الهويات لم تُرسل لمزود خارجي؟', 'هل تستطيع اختبار الانحياز في بيانات محجوبة؟'],
      how: 'AIGAS Firewall يحجب الهوية والإقامة والآيبان وبيانات الاعتماد وأرقام المرضى برموز تحفظ السياق، والباقة السيادية تبقي كل شيء داخل بنيتكم.',
      sdaia: 'الخصوصية والأمن، والنزاهة والإنصاف',
      products: [['firewall', 'Firewall'], ['secure-chat', 'Secure Chat']],
    },
  ].map(({ slug, ...p }) => ({ params: { pillar: slug }, props: p }));
}
const { no, title, line, intro, means, questions, how, sdaia, products } = Astro.props;
---
<PageShell title={`${title} — أركان حوكمة الذكاء الاصطناعي | BRIGHTAI`} description={intro} crumbs={[{ name: 'الأركان', href: '/#principles' }, { name: title }]}>
  <p class="eyebrow">{no} / ركن من أركان الحوكمة</p>
  <h1>{title}</h1>
  <p class="note">هذا المحتوى يصف التصور المستهدف للمنصة، ولا يثبت تشغيل القدرات أو التكاملات أو مدد الاحتفاظ المذكورة. المتاح هنا تجربة حجب توضيحية؛ يُحدد نطاق الخدمة والتزاماتها في اتفاق مكتوب.</p>
  <p class="lead">{line}</p>
  <p class="lead">{intro}</p>
  <section class="block"><h2>ماذا يعني عملياً</h2><ul class="list">{means.map((m: string) => <li>{m}</li>)}</ul></section>
  <section class="block"><h2>أسئلة تستحق إجابة</h2><ul class="list">{questions.map((q: string) => <li>{q}</li>)}</ul></section>
  <section class="block"><h2>كيف يطبّقه AIGAS</h2><p>{how}</p><p class="note">يرتبط بمبادئ سدايا: {sdaia}.</p>
    <div class="actions">{products.map(([s, n]: string[]) => <a class="ghost" href={`/products/${s}/`} dir="ltr">{n} ←</a>)}<a class="button" href="/services/">ابدأ بفحص الجاهزية</a></div>
  </section>
</PageShell>
