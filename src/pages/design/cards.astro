---
/**
 * BrightAI — Internal Card System Showcase
 * ─────────────────────────────────────────────────
 * REPORT-07 / DEC-2026-034: Internal preview page for the unified card
 * system (.card + variants + sizes + anatomy + aliases).
 *
 * Purpose: review every card variant, size, and anatomy sub-element in
 * one place. Used by the design team and the agent to validate visual
 * decisions before shipping any redesign that touches cards.
 *
 * Constraints:
 *   - Page is INDEXABLE (REPORTS-SEO-FOUNDATION, 2026-07-07).
 *   - /design/* paths are excluded from sitemap via astro.config.mjs filter.
 *   - All sample text is intentionally generic so the page serves as a
 *     card reference, not a content sample.
 *   - No published Arabic text from any production page is used here.
 *   - Icons are rendered via Icon.astro using mdi-* sprite references.
 *
 * Access: This page is published (builds to /design/cards/) but not
 * indexed. Internal team use only.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';

// Sample content for the live examples (kept generic on purpose).
const featureSample = {
  chip: 'ENTERPRISE',
  title: 'حوكمة الذكاء الاصطناعي',
  desc: 'طبقة تشغيلية تحمي بياناتك الحساسة قبل ما توصل للنموذج، وتوثّق كل خطوة بشكل غير قابل للتعديل.',
  meta1: 'حالة الاستخدام',
  meta2: 'مؤسسات +500 موظف',
};

const sectorSample = {
  chip: 'GOVERNMENT',
  title: 'الجهات الحكومية',
  desc: 'ضوابط NCA وSDAIA جاهزة للتفعيل. سجلات تدقيق قابلة للمراجعة، ومسارات موافقة مدمجة.',
  meta1: 'القطاع',
  meta2: 'حكومي',
};

const metricSamples = [
  { value: '127', label: 'صفحة منشورة', trend: 'up', delta: '+12 هذا الشهر' },
  { value: '99.9%', label: 'جاهزية الخدمة', trend: 'flat', delta: 'ثابت' },
  { value: '< 1.8s', label: 'LCP — الجوال', trend: 'down', delta: '-200ms (تحسّن)' },
];

const glassSample = {
  title: 'لوحة Kernel الحية',
  desc: 'مراقبة لحظية لكل طلب AI مع تنبيهات فورية وتقرير امتثال تلقائي.',
};

const interactiveSample = {
  title: 'بطاقة تفاعلية',
  desc: 'مرّر الفأرة فوقها: تكبر قليلاً. اضغط: تنكمش قليلاً. feedback لمسي للضغط.',
};
---
<ArabicLayout
  title="نظام البطاقات الموحّد | BrightAI Design System"
  description="مرجع نظام البطاقات الموحّد في BrightAI: 6 أنواع للبطاقة، 3 أحجام، وتشريح البطاقة مع aliases للتوافق."
  canonical="https://brightai.live/design/cards/"
  robots="index, follow"
  hreflang={[
    { lang: 'ar-SA', href: 'https://brightai.live/design/cards/' },
    { lang: 'x-default', href: 'https://brightai.live/design/cards/' },
  ]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'نظام البطاقات الموحّد — BrightAI Design System',
    url: 'https://brightai.live/design/cards/',
    inLanguage: 'ar-SA',
    description: 'Internal card system reference for the BrightAI design system.',
  }}
  currentPath="/design/cards/"
  breadcrumbs={[{ name: 'دليل التصميم', href: '/design/typography/' }, { name: 'نظام البطاقات', href: '/design/cards/' }]}
>
  <main class="cards-page" aria-label="Card system reference">
    <header class="cards-page__header">
      <span class="section__eyebrow" lang="ar">مرجع داخلي — Internal reference</span>
      <h1 class="cards-page__title">Card System</h1>
      <p class="lead">
        The unified card system for BrightAI — every card on the production
        site resolves to <code>.card</code> + one of the variants documented
        below. All variants share the same base (surface-2 + border-soft +
        radius-xl + 250ms transition). All aliases below still resolve to
        the canonical patterns. Page is fully indexable (REPORTS-SEO-FOUNDATION).
      </p>
      <p class="cards-page__ar-lead" lang="ar" dir="rtl">
        نظام البطاقات الموحّد في BrightAI. كل بطاقة على الموقع تستخدم
        <code>.card</code> كنقطة بداية مع variant واحد من القائمة تحت.
        الـaliases القديمة (مثل <code>.inner-card</code>) كلها لا تزال تشتغل.
        الصفحة قابلة للفهرسة بالكامل — مرجع تصميمي مفتوح للزوار.
      </p>
    </header>

    <!-- ============================================================
         SECTION 1 — BASE CARD
         ============================================================ -->
    <section class="cards-page__section" aria-labelledby="base-heading">
      <header class="cards-page__section-head">
        <span class="section__eyebrow">01 · Base</span>
        <h2 id="base-heading" class="section__title">Base card</h2>
        <p class="section__subtitle">
          <code>.card</code> — surface-2 + border-soft + radius-xl + padding-6 + transition.
          Default state. Hover elevates to surface-3 with border-strong and shadow-elevated.
        </p>
      </header>

      <div class="cards-page__grid">
        <article class="card">
          <span class="card__eyebrow">BASE</span>
          <h3 class="card__title">بطاقة أساسية</h3>
          <p class="card__desc">
            هذه البطاقة تستخدم <code>.card</code> فقط بدون أي variant. الـ
            hover يرفّع الخلفية من surface-2 إلى surface-3.
          </p>
        </article>

        <article class="card card--md">
          <h3 class="card__title">حجم md (افتراضي)</h3>
          <p class="card__desc">
            البطاقة التلقائية تستخدم padding-6 (1.5rem) — هذا هو الـdefault.
            صرّح <code>card--md</code> لو تبي توضّح النية.
          </p>
        </article>
      </div>
    </section>

    <!-- ============================================================
         SECTION 2 — SIZES (sm / md / lg)
         ============================================================ -->
    <section class="cards-page__section" aria-labelledby="sizes-heading">
      <header class="cards-page__section-head">
        <span class="section__eyebrow">02 · Sizes</span>
        <h2 id="sizes-heading" class="section__title">Size variants</h2>
        <p class="section__subtitle">
          <code>.card--sm</code> (padding-4 / 1rem) · <code>.card--md</code> (padding-6 / 1.5rem, default) ·
          <code>.card--lg</code> (padding-8 / 2rem). استخدم الـsize لتعديل
          كثافة المحتوى بدون تغيير الـvariant.
        </p>
      </header>

      <div class="cards-page__grid cards-page__grid--sizes">
        <article class="card card--feature card--sm">
          <span class="card__icon" aria-hidden="true">
            <svg width="24" height="24" aria-hidden="true"><use href="/icons.svg#mdi-shield-check"></use></svg>
          </span>
          <h3 class="card__title">card--sm</h3>
          <p class="card__desc">Compact. للـdense grids أو sidebar cards.</p>
          <span class="card__action">المزيد</span>
        </article>

        <article class="card card--feature card--md">
          <span class="card__icon" aria-hidden="true">
            <svg width="24" height="24" aria-hidden="true"><use href="/icons.svg#mdi-shield-check"></use></svg>
          </span>
          <h3 class="card__title">card--md</h3>
          <p class="card__desc">الـdefault. استخدمه للـfeature/solution cards العادية.</p>
          <span class="card__action">المزيد</span>
        </article>

        <article class="card card--feature card--lg">
          <span class="card__icon" aria-hidden="true">
            <svg width="24" height="24" aria-hidden="true"><use href="/icons.svg#mdi-shield-check"></use></svg>
          </span>
          <h3 class="card__title">card--lg</h3>
          <p class="card__desc">Spacious. للـhero cards أو marketing tiles اللي تحتاج مساحة تنفّس.</p>
          <span class="card__action">المزيد</span>
        </article>
      </div>
    </section>

    <!-- ============================================================
         SECTION 3 — VARIANTS
         ============================================================ -->
    <section class="cards-page__section" aria-labelledby="variants-heading">
      <header class="cards-page__section-head">
        <span class="section__eyebrow">03 · Variants</span>
        <h2 id="variants-heading" class="section__title">Card variants</h2>
        <p class="section__subtitle">
          خمسة variants + واحد إضافي (solid). كل variant يضيف طبقة
          visual على الـbase بدون كسر الـlayout أو الـanatomy.
        </p>
      </header>

      <!-- 3.1 feature -->
      <div class="cards-page__variant">
        <div class="cards-page__variant-meta">
          <span class="section__eyebrow">3.1</span>
          <h3 class="cards-page__variant-name">.card--feature</h3>
          <p class="cards-page__variant-desc">
            للـfeature/service/solution cards. أيقونة فوق + hover lift
            <code>translateY(-4px)</code> + brand-tinted glow.
            الـaliases: <code>.feature-card</code>, <code>.inner-card</code>.
          </p>
        </div>
        <div class="cards-page__variant-demo">
          <article class="card card--feature">
            <span class="card__icon" aria-hidden="true">
              <svg width="24" height="24" aria-hidden="true"><use href="/icons.svg#mdi-shield-lock"></use></svg>
            </span>
            <span class="card__eyebrow">{featureSample.chip}</span>
            <h3 class="card__title">{featureSample.title}</h3>
            <p class="card__desc">{featureSample.desc}</p>
            <p class="card__meta">
              <span class="card__meta-label">{featureSample.meta1}</span>
              <span class="card__meta-value">{featureSample.meta2}</span>
            </p>
            <span class="card__action">اعرف المزيد</span>
          </article>
        </div>
      </div>

      <!-- 3.2 metric -->
      <div class="cards-page__variant">
        <div class="cards-page__variant-meta">
          <span class="section__eyebrow">3.2</span>
          <h3 class="cards-page__variant-name">.card--metric</h3>
          <p class="cards-page__variant-desc">
            للأرقام والإحصائيات. قيمة كبيرة بـgradient text + label +
            trend indicator (up/down/flat). الـaliases:
            <code>.home-stat-card</code>, <code>.inner-stat</code>.
          </p>
        </div>
        <div class="cards-page__variant-demo cards-page__variant-demo--metric">
          {metricSamples.map((m) => (
            <article class="card card--metric">
              <span class="card__metric-value">{m.value}</span>
              <span class="card__metric-label">{m.label}</span>
              <span class={`card__metric-trend card__metric-trend--${m.trend}`}>
                {m.delta}
              </span>
            </article>
          ))}
        </div>
      </div>

      <!-- 3.3 glass -->
      <div class="cards-page__variant">
        <div class="cards-page__variant-meta">
          <span class="section__eyebrow">3.3</span>
          <h3 class="cards-page__variant-name">.card--glass</h3>
          <p class="cards-page__variant-desc">
            شفافة مع backdrop-filter blur(16px) + saturate(140%) +
            surface-2@60%. الـalias: <code>.glass</code>. تظهر أحسن
            فوق hero مع dotted-surface.
          </p>
        </div>
        <div class="cards-page__variant-demo cards-page__variant-demo--glass">
          <article class="card card--glass">
            <span class="card__eyebrow">KERNEL</span>
            <h3 class="card__title">{glassSample.title}</h3>
            <p class="card__desc">{glassSample.desc}</p>
            <span class="card__action">افتح اللوحة</span>
          </article>
        </div>
      </div>

      <!-- 3.4 gradient -->
      <div class="cards-page__variant">
        <div class="cards-page__variant-meta">
          <span class="section__eyebrow">3.4</span>
          <h3 class="cards-page__variant-name">.card--gradient</h3>
          <p class="cards-page__variant-desc">
            حدود متدرّجة cyan → indigo باستخدام mask-composite trick.
            الـcontent جوّا الـinner يظل بـsurface-2. الـgradient هو
            الـborder فقط.
          </p>
        </div>
        <div class="cards-page__variant-demo">
          <article class="card card--gradient">
            <span class="card__eyebrow">PREMIUM</span>
            <h3 class="card__title">حوكمة AI مؤسسية</h3>
            <p class="card__desc">
              حل شامل مع ضوابط NCA ECC جاهزة وتكامل مع أنظمتك
              الداخلية. مدعوم بـKernel للأمان.
            </p>
            <span class="card__action">ابدأ التقييم</span>
          </article>
        </div>
      </div>

      <!-- 3.5 interactive -->
      <div class="cards-page__variant">
        <div class="cards-page__variant-meta">
          <span class="section__eyebrow">3.5</span>
          <h3 class="cards-page__variant-name">.card--interactive</h3>
          <p class="cards-page__variant-desc">
            feedback لمسي للضغط. <code>cursor: pointer</code> + hover
            <code>scale(1.01)</code> + active <code>scale(0.99)</code>.
            مثال حي: مرّر الفأرة فوق البطاقة، ثم اضغط.
          </p>
        </div>
        <div class="cards-page__variant-demo">
          <a class="card card--feature card--interactive" href="#interactive" style="text-decoration:none;color:inherit;">
            <span class="card__icon" aria-hidden="true">
              <svg width="24" height="24" aria-hidden="true"><use href="/icons.svg#mdi-cursor-default-click"></use></svg>
            </span>
            <h3 class="card__title">{interactiveSample.title}</h3>
            <p class="card__desc">{interactiveSample.desc}</p>
            <span class="card__action">اضغطني</span>
          </a>
        </div>
      </div>

      <!-- 3.6 solid (existing) -->
      <div class="cards-page__variant">
        <div class="cards-page__variant-meta">
          <span class="section__eyebrow">3.6</span>
          <h3 class="cards-page__variant-name">.card--solid</h3>
          <p class="cards-page__variant-desc">
            خلفية مرفوعة (--bg-elevated) + border-default. للـcards اللي
            تحتاج وزن بصري أكثر من default (مثل CTA panels داخل sections).
          </p>
        </div>
        <div class="cards-page__variant-demo">
          <article class="card card--solid">
            <h3 class="card__title">بطاقة صلبة</h3>
            <p class="card__desc">
              خلفية --bg-elevated مع border-default. أثقل من الـdefault
              وأخف من الـcta gradient.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 4 — ANATOMY
         ============================================================ -->
    <section class="cards-page__section" aria-labelledby="anatomy-heading">
      <header class="cards-page__section-head">
        <span class="section__eyebrow">04 · Anatomy</span>
        <h2 id="anatomy-heading" class="section__title">Card sub-elements</h2>
        <p class="section__subtitle">
          BEM sub-elements تكوّن البطاقة. كل واحد له دور محدد:
          <code>__icon</code> (top) · <code>__eyebrow</code> (tag) ·
          <code>__title</code> (h3) · <code>__desc</code> (lead) ·
          <code>__meta</code> (bottom row) · <code>__action</code> (cta).
        </p>
      </header>

      <div class="cards-page__grid">
        <article class="card card--feature card--lg cards-page__anatomy">
          <span class="card__eyebrow" data-label="__eyebrow">{sectorSample.chip}</span>
          <span class="card__icon" aria-hidden="true" data-label="__icon">
            <svg width="24" height="24" aria-hidden="true"><use href="/icons.svg#mdi-bank"></use></svg>
          </span>
          <h3 class="card__title" data-label="__title">{sectorSample.title}</h3>
          <p class="card__desc" data-label="__desc">{sectorSample.desc}</p>
          <p class="card__meta" data-label="__meta">
            <span class="card__meta-label">{sectorSample.meta1}</span>
            <span class="card__meta-value">{sectorSample.meta2}</span>
          </p>
          <span class="card__action" data-label="__action">اعرف المزيد</span>
        </article>
      </div>
    </section>

    <!-- ============================================================
         SECTION 5 — LEGACY ALIASES
         ============================================================ -->
    <section class="cards-page__section" aria-labelledby="aliases-heading">
      <header class="cards-page__section-head">
        <span class="section__eyebrow">05 · Aliases</span>
        <h2 id="aliases-heading" class="section__title">Legacy aliases (still active)</h2>
        <p class="cards-page__section-subtitle">
          كل class قديم يستهدفه canonical واحد. الـHTML القديم ما يحتاج
          يتغيّر — الـCSS الجديد يضمن نفس السلوك البصري.
        </p>
      </header>

      <div class="cards-page__alias-table">
        <table>
          <thead>
            <tr>
              <th>Alias (HTML قديم)</th>
              <th>Canonical</th>
              <th>Usage count</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>.inner-card</code></td>
              <td><code>.card--feature</code></td>
              <td>191</td>
              <td><span class="chip chip--success">active</span></td>
            </tr>
            <tr>
              <td><code>.home-stat-card</code></td>
              <td><code>.card--metric</code></td>
              <td>~24</td>
              <td><span class="chip chip--success">active</span></td>
            </tr>
            <tr>
              <td><code>.feature-card</code></td>
              <td><code>.card--feature</code></td>
              <td>~6</td>
              <td><span class="chip chip--success">active</span></td>
            </tr>
            <tr>
              <td><code>.pricing-card</code></td>
              <td><code>.card--pricing</code></td>
              <td>~9</td>
              <td><span class="chip chip--success">active</span></td>
            </tr>
            <tr>
              <td><code>.home-cta-card</code></td>
              <td><code>.card--cta</code></td>
              <td>~3</td>
              <td><span class="chip chip--success">active</span></td>
            </tr>
            <tr>
              <td><code>.inner-card__icon</code></td>
              <td><code>.card__icon</code></td>
              <td>~38</td>
              <td><span class="chip chip--success">active</span></td>
            </tr>
            <tr>
              <td><code>.inner-card__title</code></td>
              <td><code>.card__title</code></td>
              <td>~80</td>
              <td><span class="chip chip--success">active</span></td>
            </tr>
            <tr>
              <td><code>.inner-card__text</code></td>
              <td><code>.card__desc</code></td>
              <td>~52</td>
              <td><span class="chip chip--success">active</span></td>
            </tr>
            <tr>
              <td><code>.inner-card__footer</code></td>
              <td><code>.card__meta</code></td>
              <td>~20</td>
              <td><span class="chip chip--success">active</span></td>
            </tr>
            <tr>
              <td><code>.glass</code></td>
              <td><code>.card--glass</code></td>
              <td>~5</td>
              <td><span class="chip chip--success">active</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="cards-page__alias-note">
        <strong>سياسة الـaliases:</strong> الـclasses القديمة لا تزال تعمل
        بدون أي تعديل في الـHTML. الـcanonical classes (الموثّقة فوق) هي
        المفضّلة للكود الجديد فقط — الـlegacy HTML يبقى كما هو لتفادي
        كسر 191 استخدام في الإنتاج.
      </p>
    </section>

    <!-- ============================================================
         SECTION 6 — DESIGN TOKENS USED
         ============================================================ -->
    <section class="cards-page__section" aria-labelledby="tokens-heading">
      <header class="cards-page__section-head">
        <span class="section__eyebrow">06 · Tokens</span>
        <h2 id="tokens-heading" class="section__title">Design tokens used</h2>
        <p class="section__subtitle">
          الـcards تستخدم tokens فقط — صفر hex values. هذا يضمن
          consistency عبر الموقع كله.
        </p>
      </header>

      <div class="cards-page__alias-table">
        <table>
          <thead>
            <tr>
              <th>Token</th>
              <th>Value</th>
              <th>Used by</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>--surface-2</code></td>
              <td><code>#0f1525</code> (--bg-surface)</td>
              <td>base · feature · solid · glass inner</td>
            </tr>
            <tr>
              <td><code>--surface-3</code></td>
              <td><code>#151c30</code> (--bg-elevated)</td>
              <td>hover state · solid variant</td>
            </tr>
            <tr>
              <td><code>--border-soft</code></td>
              <td>rgba(148,163,184,0.1)</td>
              <td>base border</td>
            </tr>
            <tr>
              <td><code>--border-strong</code></td>
              <td>rgba(148,163,184,0.35)</td>
              <td>hover state · focus-visible</td>
            </tr>
            <tr>
              <td><code>--border-brand</code></td>
              <td>var(--interactive-primary)</td>
              <td>__icon border · gradient border</td>
            </tr>
            <tr>
              <td><code>--radius-xl</code></td>
              <td>1rem</td>
              <td>all variants (unified)</td>
            </tr>
            <tr>
              <td><code>--ease-emphasized</code></td>
              <td>cubic-bezier(0.2, 0, 0, 1)</td>
              <td>transitions</td>
            </tr>
            <tr>
              <td><code>--shadow-glow-brand</code></td>
              <td>0 0 24px -4px rgba(42,138,126,0.4)</td>
              <td>feature hover · gradient hover</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</ArabicLayout>

<style>
  /* ============================================================
     Page-local styles. Uses tokens from base.css/tokens.css.
     No published Arabic text. Internal reference only.
     ============================================================ */

  .cards-page {
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--space-16) var(--space-4);
  }

  .cards-page__header {
    margin-bottom: var(--space-12);
    text-align: start;
  }

  .cards-page__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--font-extrabold);
    line-height: 1.1;
    margin-block: var(--space-3) var(--space-4);
    letter-spacing: -0.02em;
  }

  .cards-page__ar-lead {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

