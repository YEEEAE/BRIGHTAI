---
/**
 * BrightAI — Internal Color System Showcase
 * ─────────────────────────────────────────────────
 * DEC-2026-033: Internal preview page for the unified color token system.
 *
 * Purpose: review the full v3.1 color vocabulary in one place — surface
 * layers, borders, text colors, glow backgrounds, brand scale, status
 * colors, and live component examples using the new color-usage.css
 * utilities. Used by the design team and the agent to validate visual
 * decisions before shipping.
 *
 * Constraints:
 *   - Page is INDEXABLE (REPORTS-SEO-FOUNDATION, 2026-07-07).
 *   - /design/* paths are excluded from sitemap via astro.config.mjs filter.
 *   - All sample text is intentionally generic so the page serves as a
 *     color reference, not a content sample.
 *   - No published Arabic text from any production page is used here.
 *
 * Access: This page is published (builds to /design/colors/) but not
 * indexed. Internal team use only.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';

// Live sample components to show the token system in action
const surfaceTokens = [
  { name: 'surface-1', token: '--surface-1', value: '#0a0e1a (--bg-base)', use: 'body · sections · page-wide' },
  { name: 'surface-2', token: '--surface-2', value: '#0f1525 (--bg-surface)', use: 'default cards · most surfaces' },
  { name: 'surface-3', token: '--surface-3', value: '#151c30 (--bg-elevated)', use: 'elevated cards · modals · popovers' },
  { name: 'surface-4', token: '--surface-4', value: '#1c2540', use: 'hover/active surface · interactive' },
];

const borderTokens = [
  { name: 'border-soft', token: '--border-soft', value: 'rgba(148,163,184,0.1)', use: 'default card border' },
  { name: 'border-strong', token: '--border-strong', value: 'rgba(148,163,184,0.2)', use: 'hover/active state' },
  { name: 'border-brand', token: '--border-brand', value: 'var(--interactive-primary)', use: 'focus ring · selected' },
];

const textTokens = [
  { name: 'text-brand', token: 'var(--interactive-primary)', value: '#2a8a7e', use: 'CTAs · links · brand emphasis' },
  { name: 'text-accent', token: 'var(--accent-warm)', value: '#c08a5a', use: 'sparingly · warm highlights' },
  { name: 'text-success', token: 'var(--status-success)', value: '#22c55e', use: 'confirmed · compliance pass' },
  { name: 'text-danger', token: 'var(--status-danger)', value: '#ef4444', use: 'tier-3 risks · errors · blocking' },
];

const glowTokens = [
  { name: 'bg-brand-glow', token: 'rgba(42,138,126,0.12)', value: 'var(--brand-soft)', use: 'hero highlights · featured CTAs' },
  { name: 'bg-accent-glow', token: 'var(--accent-warm-soft)', value: 'rgba(192,138,90,0.15)', use: 'warm featured moments · quotes' },
];

const brandScale = [
  { stop: '50',  hex: '#e6f3f2', use: 'lightest wash · badges on dark' },
  { stop: '100', hex: '#c2e1de', use: 'hover backgrounds' },
  { stop: '200', hex: '#87c3bd', use: 'borders on tinted cards' },
  { stop: '300', hex: '#4ba69c', use: 'secondary CTAs · chip text' },
  { stop: '400', hex: '#3ba395', use: 'decorative focus' },
  { stop: '500', hex: '#2a8a7e', use: 'PRIMARY · buttons · links' },
  { stop: '600', hex: '#1f6f64', use: 'hover on primary · depth' },
  { stop: '700', hex: '#19574f', use: 'pressed · active · borders' },
  { stop: '800', hex: '#14433d', use: 'tinted dark backgrounds' },
  { stop: '900', hex: '#0a201e', use: 'deepest brand-tinted dark' },
];

const statusTokens = [
  { name: 'success', token: 'var(--status-success)', value: '#22c55e', semantic: 'confirmations · compliance pass', forbidden: 'NEVER for marketing copy' },
  { name: 'warning', token: 'var(--status-warning)', value: '#f59e0b', semantic: 'tier-2 risks · cautions', forbidden: 'NEVER for blocking actions' },
  { name: 'danger',  token: 'var(--status-danger)',  value: '#ef4444', semantic: 'tier-3 risks · blocking · destructive', forbidden: 'NEVER for general emphasis' },
  { name: 'info',    token: 'var(--status-info)',    value: '#6366f1', semantic: 'informational tips · neutral notes', forbidden: 'NEVER for warnings/errors' },
];
---

<ArabicLayout
  title="نظام الألوان والـ Tokens | BrightAI Design System"
  description="مرجع نظام الألوان الموحّد في BrightAI: 3 طبقات سطح، 4 ألوان نص، 6 ألوان حالة، وتدرّج brand. متوافق مع WCAG."
  canonical="https://brightai.site/design/colors/"
  robots="noindex, follow"
  hreflang={[
    { lang: 'ar-SA', href: 'https://brightai.site/design/colors/' },
    { lang: 'x-default', href: 'https://brightai.site/design/colors/' },
  ]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'نظام الألوان والـ Tokens الموحّد — BrightAI Design System',
    url: 'https://brightai.site/design/colors/',
    inLanguage: 'ar-SA',
    description: 'Internal color reference for the BrightAI design system.',
  }}
  currentPath="/design/colors/"
>
  <main class="colors-page" aria-label="Color system reference">
    <header class="colors-page__header">
      <span class="section__eyebrow" lang="ar">مرجع داخلي — Internal reference</span>
      <h1 class="colors-page__title">Color System</h1>
      <p class="lead">
        The unified color token system for BrightAI. Every visual surface,
        border, text color, and glow effect in production is bound to one
        of the tokens shown on this page. <strong>Zero hex values in
        components</strong> — everything resolves through CSS custom
        properties. Page is fully indexable (REPORTS-SEO-FOUNDATION).
      </p>
      <p class="colors-page__ar-lead" lang="ar" dir="rtl">
        نظام الألوان الموحّد في BrightAI. كل سطح وحد ونص وتأثير بصري
        في الإنتاج مربوط بأحد الـ tokens المعروضة هنا. <strong>صفر hex
        في المكونات</strong> — كله عبر CSS variables. الصفحة
        الصفحة قابلة للفهرسة بالكامل — مرجع مفتوح للألوان والـ tokens.
      </p>
    </header>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 1 — SURFACE LAYERS
         ═══════════════════════════════════════════════════════════ -->
    <section class="colors-section" aria-labelledby="surfaces">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم الأول</span>
        <h2 id="surfaces" class="section__title">Surface Layers</h2>
        <p class="section__subtitle">
          4 layered backgrounds that establish visual depth.
          <code>.surface-1</code> → <code>.surface-4</code> = page → card → elevated → hover.
        </p>
      </div>

      <div class="colors-grid">
        {surfaceTokens.map((s) => (
          <article class="colors-card" data-surface={s.name}>
            <div class={`colors-card__swatch surface-${s.name.split('-')[1]}`}></div>
            <div class="colors-card__meta">
              <h3 class="colors-card__name">.{s.name}</h3>
              <code class="colors-card__token">{s.token}</code>
              <p class="colors-card__value">{s.value}</p>
              <p class="colors-card__use">{s.use}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 2 — BORDERS
         ═══════════════════════════════════════════════════════════ -->
    <section class="colors-section" aria-labelledby="borders">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم الثاني</span>
        <h2 id="borders" class="section__title">Border Scale</h2>
        <p class="section__subtitle">
          3 emphasis levels — soft for resting state, strong for hover, brand for focus.
        </p>
      </div>

      <div class="colors-grid colors-grid--three">
        {borderTokens.map((b) => (
          <article class="colors-card" data-border={b.name}>
            <div class={`colors-card__border-swatch border-${b.name.split('-')[1]}`}></div>
            <div class="colors-card__meta">
              <h3 class="colors-card__name">.{b.name}</h3>
              <code class="colors-card__token">{b.token}</code>
              <p class="colors-card__value">{b.value}</p>
              <p class="colors-card__use">{b.use}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 3 — TEXT COLORS
         ═══════════════════════════════════════════════════════════ -->
    <section class="colors-section" aria-labelledby="text-colors">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم الثالث</span>
        <h2 id="text-colors" class="section__title">Text Colors</h2>
        <p class="section__subtitle">
          4 semantic text colors. Brand for CTAs/links, accent sparingly, success/danger for status only.
        </p>
      </div>

      <div class="colors-grid colors-grid--four">
        {textTokens.map((t) => (
          <article class="colors-card text-color-card">
            <p class={`colors-card__sample text-${t.name.split('-')[1]}`}>أبجد هوز</p>
            <div class="colors-card__meta">
              <h3 class="colors-card__name">.{t.name}</h3>
              <code class="colors-card__token">{t.token}</code>
              <p class="colors-card__value">{t.value}</p>
              <p class="colors-card__use">{t.use}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 4 — GLOW BACKGROUNDS
         ═══════════════════════════════════════════════════════════ -->
    <section class="colors-section" aria-labelledby="glows">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم الرابع</span>
        <h2 id="glows" class="section__title">Glow Backgrounds</h2>
        <p class="section__subtitle">
          Tinted backgrounds for hero highlights and featured moments. Use sparingly — never as page-wide backgrounds.
        </p>
      </div>

      <div class="colors-grid colors-grid--two">
        {glowTokens.map((g) => (
          <article class="colors-card glow-card">
            <div class={`colors-card__glow-swatch bg-${g.name.split('-').slice(1, 3).join('-')}-glow`}></div>
            <div class="colors-card__meta">
              <h3 class="colors-card__name">.{g.name}</h3>
              <code class="colors-card__token">{g.token}</code>
              <p class="colors-card__value">{g.value}</p>
              <p class="colors-card__use">{g.use}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 5 — BRAND SCALE (DEEP TEAL — DEC-SovB-001)
         ═══════════════════════════════════════════════════════════ -->
    <section class="colors-section" aria-labelledby="brand-scale">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم الخامس</span>
        <h2 id="brand-scale" class="section__title">Brand Scale (Deep Teal)</h2>
        <p class="section__subtitle">
          10 stops from <code>--brand-50</code> to <code>--brand-900</code>.
          Migrated from Cyan to Deep Teal in <strong>DEC-SovB-001</strong> for the "Sovereign Calm" direction.
          Primary CTAs use <code>--brand-500</code>.
        </p>
      </div>

      <div class="brand-scale">
        {brandScale.map((b) => (
          <div class="brand-scale__stop" data-stop={b.stop}>
            <div class="brand-scale__swatch" style={`background: var(--brand-${b.stop})`}></div>
            <div class="brand-scale__meta">
              <code class="brand-scale__token">--brand-{b.stop}</code>
              <span class="brand-scale__hex">{b.hex}</span>
              <span class="brand-scale__use">{b.use}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 6 — STATUS COLORS
         ═══════════════════════════════════════════════════════════ -->
    <section class="colors-section" aria-labelledby="status-colors">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم السادس</span>
        <h2 id="status-colors" class="section__title">Status Colors</h2>
        <p class="section__subtitle">
          4 semantic colors. Each has a specific meaning — <strong>do not mix</strong>.
        </p>
      </div>

      <div class="colors-grid colors-grid--four">
        {statusTokens.map((s) => (
          <article class="colors-card status-color-card" data-status={s.name}>
            <div class="status-color-card__dot"></div>
            <div class="colors-card__meta">
              <h3 class="colors-card__name">{s.name}</h3>
              <code class="colors-card__token">{s.token}</code>
              <p class="colors-card__value">{s.value}</p>
              <p class="colors-card__use"><strong>Use:</strong> {s.semantic}</p>
              <p class="colors-card__forbidden"><strong>Don't:</strong> {s.forbidden}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════
         SECTION 7 — LIVE COMPONENT EXAMPLES
         ═══════════════════════════════════════════════════════════ -->
    <section class="colors-section" aria-labelledby="live-examples">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم السابع</span>
        <h2 id="live-examples" class="section__title">Live Component Examples</h2>
        <p class="section__subtitle">
          Real components using the new token system. Hover the cards and buttons to see state transitions.
        </p>
      </div>

      <div class="live-examples">
        <!-- Card examples -->
        <article class="live-examples__group">
          <h3 class="live-examples__group-title">Cards (.surface-2 → .surface-3 on hover)</h3>
          <div class="live-examples__cards">
            <div class="live-card">
              <span class="chip chip--brand">Brand</span>
              <h4 class="live-card__title">Sample feature card</h4>
              <p class="live-card__desc">Rests on surface-2, lifts to surface-3 on hover with brand-tinted glow.</p>
            </div>
            <div class="live-card live-card--elevated">
              <span class="chip chip--info">Info</span>
              <h4 class="live-card__title">Elevated card</h4>
              <p class="live-card__desc">Permanent surface-3, used for popovers and featured panels.</p>
            </div>
          </div>
        </article>

        <!-- Button examples -->
        <article class="live-examples__group">
          <h3 class="live-examples__group-title">Buttons</h3>
          <div class="live-examples__buttons">
            <button type="button" class="btn btn--primary">Primary CTA</button>
            <button type="button" class="btn btn--ghost">Ghost button</button>
            <span class="text-brand">This is a brand link</span>
            <span class="text-accent">Copper accent</span>
            <span class="text-success">Success message</span>
            <span class="text-danger">Danger alert</span>
          </div>
        </article>

        <!-- Glow backgrounds -->
        <article class="live-examples__group">
          <h3 class="live-examples__group-title">Glow Backgrounds</h3>
          <div class="live-examples__glows">
            <div class="live-glow bg-brand-glow">
              <strong>.bg-brand-glow</strong>
              <span>Teal-tinted featured area</span>
            </div>
            <div class="live-glow bg-accent-glow">
              <strong>.bg-accent-glow</strong>
              <span>Copper-tinted warm moment</span>
            </div>
          </div>
        </article>

        <!-- Focus ring -->
        <article class="live-examples__group">
          <h3 class="live-examples__group-title">Focus Ring (Tab into the next field to see)</h3>
          <div class="live-examples__focus">
            <button type="button" class="btn btn--primary">Tab to focus me</button>
            <input type="text" placeholder="Or focus this input" class="field" />
          </div>
        </article>
      </div>
    </section>
  </main>
</ArabicLayout>

<style>
  /* ═══════════════════════════════════════════════════════════
     PAGE LAYOUT — local styles only, all colors via tokens
     ═══════════════════════════════════════════════════════════ */
  .colors-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-24);
  }

  .colors-page__header {
    text-align: start;
    margin-bottom: var(--space-16);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-soft);
  }

  .colors-page__title {
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--text-primary);
    margin-block: var(--space-4) var(--space-6);
  }

  .colors-page__ar-lead {
    margin-top: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .colors-section {
    margin-block: var(--space-20);
  }

  .colors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .colors-grid--two   { grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
  .colors-grid--three { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .colors-grid--four  { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }

  .colors-card {
    background: var(--surface-2);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    transition:
      background var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .colors-card:hover {
    background: var(--surface-3);
    border-color: var(--border-strong);
  }

  .colors-card__name {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin-block: var(--space-3) var(--space-2);
  }

  .colors-card__token {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--brand-300);
    background: var(--brand-soft);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-2);
  }

  .colors-card__value {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }

  .colors-card__use {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Section 1: Surface swatches */
  .colors-card__swatch {
    height: 80px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-soft);
  }

  /* Section 2: Border swatches */
  .colors-card__border-swatch {
    height: 80px;
    background: var(--surface-2);
    border-radius: var(--radius-md);
  }

  .border-soft {
    border: 1px solid var(--border-soft);
  }

  .border-strong {
    border: 2px solid var(--border-strong);
  }

  .border-brand {
    border: 2px solid var(--border-brand);
  }

  /* Section 3: Text color samples */
  .text-color-card {
    text-align: center;
  }

  .colors-card__sample {
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: 1.2;
    margin-block: var(--space-3) var(--space-6);
    text-align: center;
  }

  /* Section 4: Glow swatches */
  .colors-card__glow-swatch {
    height: 100px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-soft);
  }

  /* Section 5: Brand scale */
  .brand-scale {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .brand-scale__stop {
    background: var(--surface-2);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .brand-scale__stop:hover {
    border-color: var(--border-strong);
  }

  .brand-scale__swatch {
    height: 60px;
  }

  .brand-scale__meta {
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .brand-scale__token {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--brand-300);
    font-weight: 700;
  }

  .brand-scale__hex {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--text-secondary);
  }

  .brand-scale__use {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    line-height: 1.4;
  }

  /* Section 6: Status colors */
  .status-color-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .status-color-card__dot {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-2);
  }

  [data-status="success"] .status-color-card__dot { background: var(--status-success); }
  [data-status="warning"] .status-color-card__dot { background: var(--status-warning); }
  [data-status="danger"]  .status-color-card__dot { background: var(--status-danger); }
  [data-status="info"]    .status-color-card__dot { background: var(--status-info); }

  .colors-card__forbidden {
    font-size: var(--text-xs);
    color: var(--text-muted);
    line-height: 1.5;
    padding-block-start: var(--space-2);
    border-block-start: 1px solid var(--border-soft);
    margin-block-start: var(--space-3);
  }

  /* Section 7: Live examples */
  .live-examples {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin-top: var(--space-8);
  }

  .live-examples__group-title {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-5);
    padding-block-end: var(--space-3);
    border-block-end: 1px solid var(--border-soft);
  }

  .live-examples__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .live-card {
    background: var(--surface-2);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    transition:
      background var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .live-card--elevated {
    background: var(--surface-3);
  }

  .live-card:hover {
    background: var(--surface-3);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .live-card__title {
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
