---
/**
 * BrightAI — Internal Typography Showcase
 * ─────────────────────────────────────────────────
 * DEC-2026-032: Internal preview page for the typography system.
 *
 * Purpose: review all heading levels, weights, line-heights, tracking,
 * utility classes (.lead, .tabular-nums, .section__eyebrow), and
 * gradient-text variants in one place. Used by the design team and
 * the agent to validate changes before they ship to production pages.
 *
 * Constraints:
 *   - Page is INDEXABLE (REPORTS-SEO-FOUNDATION, 2026-07-07).
 *   - All sample text is intentionally generic (Lorem-style or descriptive)
 *     so the page serves as a typography reference, not a content sample.
 *   - No published Arabic text from any production page is used here.
 *
 * Access: This page is published (builds to /design/typography/) but not
 * indexed. Internal team use only.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
---

<ArabicLayout
  title="نظام الخطوط الموحّد | BrightAI Design System"
  description="مرجع نظام الخطوط الموحّد في BrightAI: 6 مستويات عناوين، 4 أوزان، 3 أحجام نص، وgradient-text للتمييز."
  canonical="https://brightai.live/design/typography/"
  robots="noindex, follow"
  hreflang={[
    { lang: 'ar-SA', href: 'https://brightai.live/design/typography/' },
    { lang: 'x-default', href: 'https://brightai.live/design/typography/' },
  ]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'نظام الخطوط الموحّد — BrightAI Design System',
    url: 'https://brightai.live/design/typography/',
    inLanguage: 'ar-SA',
    description: 'Internal typography reference for the BrightAI design system.',
  }}
  currentPath="/design/typography/"
  breadcrumbs={[{ name: 'دليل التصميم', href: '/design/typography/' }, { name: 'نظام الخطوط', href: '/design/typography/' }]}
>
  <main class="typography-page" aria-label="Typography reference">
    <header class="typography-page__header">
      <span class="section__eyebrow" lang="ar">مرجع داخلي — Internal reference</span>
      <h1 class="typography-page__title">Typography System</h1>
      <p class="lead">
        This page is a complete reference for the BrightAI typography system.
        Every heading level, weight, line-height, tracking value, and utility class
        is shown below. Used by the design team to verify changes before shipping.
        Page is fully indexable (REPORTS-SEO-FOUNDATION).
      </p>
      <p class="typography-page__ar-lead" lang="ar" dir="rtl">
        هذه الصفحة مرجع كامل لنظام الطباعة في BrightAI. كل مستوى عنوان،
        وزن، ارتفاع سطر، تباعد حروف، وكل class مساعد معروض هنا.
        الصفحة قابلة للفهرسة بالكامل — مرجع الخطوط الموحّد.
      </p>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 1 — HEADING HIERARCHY (DEC-2026-032)
         ═══════════════════════════════════════════════════════════════ -->
    <section class="typography-section" aria-labelledby="heading-hierarchy">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم الأول</span>
        <h2 id="heading-hierarchy" class="section__title">Heading Hierarchy</h2>
        <p class="section__subtitle">
          Six levels of responsive headings. clamp() sizing + weight-tiered (800/800/700/700/600/600).
        </p>
      </div>

      <div class="typography-grid">
        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">h1</span>
            <span class="typography-card__spec">36px → 72px · 800 · tight · tracking-tight</span>
          </div>
          <p class="typography-specimen typography-specimen--h1">منصة أمان وحوكمة الذكاء الاصطناعي</p>
          <p class="typography-card__caption" lang="ar">display — يستخدم مرة واحدة في الصفحة</p>
        </article>

        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">h2</span>
            <span class="typography-card__spec">30px → 48px · 800 · tight · tracking-tight</span>
          </div>
          <p class="typography-specimen typography-specimen--h2">حوكمة الذكاء الاصطناعي للمؤسسات السعودية</p>
          <p class="typography-card__caption" lang="ar">section title — استعمل في أقسام الصفحة</p>
        </article>

        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">h3</span>
            <span class="typography-card__spec">24px → 36px · 700 · tight</span>
          </div>
          <p class="typography-specimen typography-specimen--h3">ضوابط PDPL و NCA و SDAIA جاهزة من اليوم</p>
          <p class="typography-card__caption" lang="ar">subsection</p>
        </article>

        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">h4</span>
            <span class="typography-card__spec">20px → 24px · 700 · tight</span>
          </div>
          <p class="typography-specimen typography-specimen--h4">حماية البيانات وإخفاء الهوية تلقائياً</p>
          <p class="typography-card__caption" lang="ar">card title</p>
        </article>

        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">h5</span>
            <span class="typography-card__spec">18px · 600 · snug</span>
          </div>
          <p class="typography-specimen typography-specimen--h5">ملصقات ثانوية وأقسام فرعية</p>
          <p class="typography-card__caption" lang="ar">minor label</p>
        </article>

        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">h6</span>
            <span class="typography-card__spec">16px · 600 · snug</span>
          </div>
          <p class="typography-specimen typography-specimen--h6">تسمية صغرى — تستخدم في الجداول والقوائم</p>
          <p class="typography-card__caption" lang="ar">micro label</p>
        </article>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 2 — FONT WEIGHTS
         ═══════════════════════════════════════════════════════════════ -->
    <section class="typography-section" aria-labelledby="font-weights">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم الثاني</span>
        <h2 id="font-weights" class="section__title">Font Weights</h2>
        <p class="section__subtitle">Five weight tokens (400 / 500 / 600 / 700 / 800).</p>
      </div>

      <div class="typography-weight-grid">
        <div class="typography-weight-row">
          <span class="typography-weight__label">400 · normal</span>
          <p class="typography-weight__sample" style="font-weight: 400;">منصة BrightAI للأمان والحوكمة</p>
        </div>
        <div class="typography-weight-row">
          <span class="typography-weight__label">500 · medium</span>
          <p class="typography-weight__sample" style="font-weight: 500;">منصة BrightAI للأمان والحوكمة</p>
        </div>
        <div class="typography-weight-row">
          <span class="typography-weight__label">600 · semibold</span>
          <p class="typography-weight__sample" style="font-weight: 600;">منصة BrightAI للأمان والحوكمة</p>
        </div>
        <div class="typography-weight-row">
          <span class="typography-weight__label">700 · bold</span>
          <p class="typography-weight__sample" style="font-weight: 700;">منصة BrightAI للأمان والحوكمة</p>
        </div>
        <div class="typography-weight-row">
          <span class="typography-weight__label">800 · extrabold</span>
          <p class="typography-weight__sample" style="font-weight: 800;">منصة BrightAI للأمان والحوكمة</p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 3 — LINE HEIGHTS
         ═══════════════════════════════════════════════════════════════ -->
    <section class="typography-section" aria-labelledby="line-heights">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم الثالث</span>
        <h2 id="line-heights" class="section__title">Line Heights</h2>
        <p class="section__subtitle">Arabic needs 1.75 (relaxed) for breathing room. Display headings use 1.2 (tight).</p>
      </div>

      <div class="typography-grid typography-grid--2">
        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">leading-tight · 1.2</span>
            <span class="typography-card__spec">للعناوين display</span>
          </div>
          <p style="line-height: 1.2; font-size: 1.25rem; max-width: 32ch;" lang="ar">
            هذا نص تجريبي لقياس المسافة بين السطور في وضع tight.
            يستخدم مع العناوين الكبيرة ليعطي إحساساً متماسكاً ومقتضباً.
          </p>
        </article>

        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">leading-snug · 1.35</span>
            <span class="typography-card__spec">للـ dense UI</span>
          </div>
          <p style="line-height: 1.35; max-width: 32ch;" lang="ar">
            هذا نص تجريبي لقياس المسافة بين السطور في وضع snug.
            يستخدم مع الواجهات الكثيفة (dashboard، kernel) حيث نحتاج توفر مساحة عمودية.
          </p>
        </article>

        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">leading-normal · 1.5</span>
            <span class="typography-card__spec">للنصوص الإنجليزية</span>
          </div>
          <p style="line-height: 1.5; max-width: 32ch;">
            This is sample text for normal line-height. Used for English body copy
            where Latin script doesn't need extra diacritic breathing room.
          </p>
        </article>

        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">leading-relaxed · 1.75</span>
            <span class="typography-card__spec">للنصوص العربية (default)</span>
          </div>
          <p style="line-height: 1.75; max-width: 32ch;" lang="ar">
            هذا نص تجريبي لقياس المسافة بين السطور في وضع relaxed.
            يستخدم مع النصوص العربية لإعطاء الخط مساحة تنفس كافية، خاصة مع الحركات والتشكيل.
          </p>
        </article>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 4 — TRACKING (letter-spacing)
         ═══════════════════════════════════════════════════════════════ -->
    <section class="typography-section" aria-labelledby="tracking">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم الرابع</span>
        <h2 id="tracking" class="section__title">Tracking</h2>
        <p class="section__subtitle">Three tracking tokens. Arabic display benefits from -0.02em optical tightening.</p>
      </div>

      <div class="typography-grid typography-grid--3">
        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">tracking-tight · -0.02em</span>
            <span class="typography-card__spec">default for h1–h4</span>
          </div>
          <h3 style="letter-spacing: -0.02em;">حوكمة ذكاء اصطناعي مؤسسية</h3>
        </article>

        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">tracking-normal · 0</span>
            <span class="typography-card__spec">default for body</span>
          </div>
          <h3 style="letter-spacing: 0;">حوكمة ذكاء اصطناعي مؤسسية</h3>
        </article>

        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">tracking-wide · 0.05em</span>
            <span class="typography-card__spec">uppercase labels</span>
          </div>
          <p style="letter-spacing: 0.05em; text-transform: uppercase; font-size: 0.875rem; font-weight: 600;">
            Compliance · PDPL · NCA
          </p>
        </article>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 5 — UTILITY CLASSES (.lead, .tabular-nums)
         ═══════════════════════════════════════════════════════════════ -->
    <section class="typography-section" aria-labelledby="utilities">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم الخامس</span>
        <h2 id="utilities" class="section__title">Utility Classes</h2>
        <p class="section__subtitle">.lead for opening paragraphs · .tabular-nums for stable digits · .text-mono-nums for telemetry.</p>
      </div>

      <div class="typography-grid">
        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">.lead</span>
            <span class="typography-card__spec">18px (lg) on mobile → 20px (xl) on tablet · relaxed · secondary color</span>
          </div>
          <p class="lead" lang="ar">
            BrightAI هي Saudi AI Safety OS — نظام تشغيل أمان وحوكمة للذكاء الاصطناعي داخل المؤسسات السعودية.
            تركّب تحت أي نظام AI في شركتك وتفعّل AI Firewall وإخفاء البيانات الشخصية وسجل التدقيق.
          </p>
          <p class="typography-card__caption">بدون .lead: تصبح الفقرة بحجم 16px (--text-base)</p>
        </article>

        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">.tabular-nums</span>
            <span class="typography-card__spec">font-feature-settings: tnum · for stats/dashboards/pricing</span>
          </div>
          <div class="typography-stats">
            <div class="typography-stat">
              <span class="typography-stat__value tabular-nums">12,580</span>
              <span class="typography-stat__label">طلبات مدققة</span>
            </div>
            <div class="typography-stat">
              <span class="typography-stat__value tabular-nums">2,341</span>
              <span class="typography-stat__label">موافقات بشرية</span>
            </div>
            <div class="typography-stat">
              <span class="typography-stat__value tabular-nums">99.7%</span>
              <span class="typography-stat__label">معدل النجاح</span>
            </div>
          </div>
          <p class="typography-card__caption">.tabular-nums تثبت عرض الأرقام — لا تتزحزح عند التحديث</p>
        </article>

        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">.text-mono-nums</span>
            <span class="typography-card__spec">monospace family + tabular figures</span>
          </div>
          <div class="typography-mono">
            <code class="text-mono-nums">2026-06-30T20:36:59+03:00</code>
            <code class="text-mono-nums">latency: 142ms</code>
            <code class="text-mono-nums">audit_log_hash: 0x4f3a8b</code>
          </div>
          <p class="typography-card__caption">للـ telemetry و timestamps و hashes</p>
        </article>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 6 — SECTION COMPOSITION (eyebrow → title → subtitle → lead)
         ═══════════════════════════════════════════════════════════════ -->
    <section class="typography-section" aria-labelledby="composition">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم السادس</span>
        <h2 id="composition" class="section__title">Section Composition</h2>
        <p class="section__subtitle">How eyebrow + title + subtitle + lead combine into a complete section header.</p>
      </div>

      <div class="typography-composition">
        <header class="section__header">
          <span class="section__eyebrow" lang="ar">كيف نشتغل</span>
          <h2 class="section__title">حوكمة واضحة، حماية بيانات، وأدلة جاهزة للمدقق</h2>
          <p class="section__subtitle">
            نظام تشغيل سعودي يركّب تحت أي نظام AI في شركتك ويضمن إن كل طلب ذكاء اصطناعي يكون آمن وموثّق.
          </p>
        </header>

        <p class="lead" lang="ar">
          BrightAI ليست منصة أجنبية ولا شات بوت. هي طبقة أمان وحوكمة مصممة للسوق السعودي،
          تدعم PDPL و NCA و SDAIA من اليوم الأول.
        </p>

        <p lang="ar">
          نخدم المؤسسات الكبيرة في القطاعات الحكومية والمالية والطبية والصناعية. كل طلب يمر عبر Kernel
          يخضع لفحص PII وتطبيق السياسات وتسجيل التدقيق والموافقات البشرية للقرارات عالية المخاطر.
        </p>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 7 — GRADIENT TEXT (DEC-2026-032 smoother stops)
         ═══════════════════════════════════════════════════════════════ -->
    <section class="typography-section" aria-labelledby="gradient-text">
      <div class="section__header">
        <span class="section__eyebrow" lang="ar">القسم السابع</span>
        <h2 id="gradient-text" class="section__title">Gradient Text</h2>
        <p class="section__subtitle">3-stop gradient at 145° for smoother reading on Arabic.</p>
      </div>

      <div class="typography-grid typography-grid--2">
        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">.gradient-text</span>
            <span class="typography-card__spec">145° · 3 stops · Teal → Teal-300 → Indigo</span>
          </div>
          <h2 class="gradient-text" lang="ar">حوكمة ذكاء اصطناعي سعودية</h2>
          <p class="typography-card__caption">الـ default — يستخدم في العناوين الرئيسية للفت الانتباه للكلمات المميزة</p>
        </article>

        <article class="typography-card">
          <div class="typography-card__meta">
            <span class="typography-card__tag">.gradient-text--soft</span>
            <span class="typography-card__spec">145° · 2 stops · Teal-300 → Indigo-300</span>
          </div>
          <h2 class="gradient-text--soft" lang="ar">حوكمة ذكاء اصطناعي سعودية</h2>
          <p class="typography-card__caption">للأماكن التي يكون فيها الـ gradient القوي ثقيل (badges، inline labels)</p>
        </article>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         FOOTER — Quick links back to docs
         ═══════════════════════════════════════════════════════════════ -->
    <footer class="typography-page__footer">
      <p class="text-center">
        <a href="/" class="section-mini-link">← العودة للرئيسية</a>
      </p>
      <p class="typography-page__meta" lang="ar">
        مرجع داخلي — لا يظهر في sitemap · DEC-2026-032 · آخر تحديث 2026-06-30
      </p>
    </footer>
  </main>
</ArabicLayout>

<style>
  /* ─────────────────────────────────────────────────
     Page-scoped styles for /design/typography
     All typography uses canonical classes from base.css
     and components.css — these rules only provide the
     reference page layout (cards, grids, meta tags).
     ───────────────────────────────────────────────── */

  .typography-page {
    max-width: 1280px;
    margin-inline: auto;
    padding: var(--space-16) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .typography-page__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-12);
  }

  .typography-page__title {
    font-size: clamp(2.5rem, 4vw + 1rem, 4rem);
    font-weight: var(--font-extrabold);
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
    background: linear-gradient(145deg, var(--brand-400), var(--indigo-400));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .typography-page__ar-lead {
    font-size: var(--text-base);
    color: var(--text-muted);
    max-width: 42rem;
    line-height: var(--leading-relaxed);
  }

  .typography-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .typography-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .typography-grid--2 { grid-template-columns: repeat(2, 1fr); }
  .typography-grid--3 { grid-template-columns: repeat(3, 1fr); }

  @media (max-width: 767px) {
    .typography-grid--2,
    .typography-grid--3 {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 1024px) {
    .typography-grid--3 { grid-template-columns: repeat(3, 1fr); }
  }

  .typography-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .typography-card:hover {
    border-color: var(--border-default);
  }

  .typography-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .typography-card__tag {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    background: rgba(42, 138, 126, 0.15);
    color: var(--brand-300);
    border-radius: var(--radius-sm);
    font-size: var(--text-2xs);
    font-weight: var(--font-semibold);
    font-family: var(--font-mono);
    letter-spacing: 0;
  }

  .typography-card__spec {
    font-size: var(--text-2xs);
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .typography-card__caption {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-top: auto;
  }

  .typography-weight-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .typography-weight-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
