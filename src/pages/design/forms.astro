---
/**
 * BrightAI — Internal Form System Showcase
 * ─────────────────────────────────────────────────
 * REPORT-08 / DEC-2026-035: Internal preview page for the unified form
 * system (.input + variants + sizes + states + .form-* helpers).
 *
 * Purpose: review every form input variant, size, and state in one place.
 * Used by the design team and the agent to validate visual decisions
 * before shipping any form changes.
 *
 * Sections:
 *   1. Base input
 *   2. Size modifiers (sm / md / lg)
 *   3. Input types (text, email, tel, password, url, number, search)
 *   4. Textarea
 *   5. Select (custom arrow)
 *   6. Checkboxes & radio
 *   7. File input
 *   8. States (default / hover / focus / disabled / readonly / error)
 *   9. Form layout (form-field, form-row, form-label, form-helper, form-error)
 *   10. Complete form (real-world example)
 *   11. Legacy aliases reference
 *
 * Constraints:
 *   - Page is INDEXABLE (REPORTS-SEO-FOUNDATION, 2026-07-07).
 *   - /design/* paths are excluded from sitemap via astro.config.mjs filter.
 *   - All sample text is intentionally generic.
 *   - No published Arabic text from any production page is used here.
 *
 * Access: This page is published (builds to /design/forms/) but not
 * indexed. Internal team use only.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
---

<ArabicLayout
  title="نظام النماذج الموحّد | BrightAI Design System"
  description="مرجع نظام النماذج الموحّد في BrightAI: 7 أنواع للحقل، 4 حالات، helpers للتخطيط، ودعم كامل لـ aria."
  canonical="https://brightai.site/design/forms/"
  robots="noindex, follow"
  hreflang={[
    { lang: 'ar-SA', href: 'https://brightai.site/design/forms/' },
    { lang: 'x-default', href: 'https://brightai.site/design/forms/' },
  ]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'نظام النماذج الموحّد — BrightAI Design System',
    url: 'https://brightai.site/design/forms/',
    inLanguage: 'ar-SA',
    description: 'Internal form system reference for the BrightAI design system.',
  }}
  currentPath="/design/forms/"
>
  <main class="forms-page" aria-label="Form system reference">
    <header class="forms-page__header">
      <span class="section__eyebrow" lang="ar">مرجع داخلي — Internal reference</span>
      <h1 class="forms-page__title">Form System</h1>
      <p class="lead">
        The unified form system for BrightAI — every input resolves to
        <code>.input</code> + a variant (text, email, textarea, select,
        checkbox, radio, file) + a size (sm 36 / md 44 / lg 52). All
        controls share the same focus state (brand border + 3px tinted
        ring) and the same error pattern (danger border + helper text).
        Page is fully indexable (REPORTS-SEO-FOUNDATION).
      </p>
      <p class="forms-page__ar-lead" lang="ar" dir="rtl">
        نظام الـ forms الموحّد في BrightAI. كل حقل يستخدم <code>.input</code>
        كنقطة بداية. أحجام: sm 36px، md 44px (الافتراضي)، lg 52px.
        الـ focus موحّد: brand border + 3px ring. الـ error موحّد:
        danger border + helper text. الـ layout helpers:
        <code>.form-field</code> + <code>.form-row</code> + <code>.form-label</code> + <code>.form-helper</code> + <code>.form-error</code>.
      </p>
    </header>

    <!-- ============================================================
         SECTION 1 — BASE INPUT
         ============================================================ -->
    <section class="forms-page__section" aria-labelledby="base-heading">
      <header class="forms-page__section-head">
        <span class="section__eyebrow">01 · Base</span>
        <h2 id="base-heading" class="section__title">Base input</h2>
        <p class="section__subtitle">
          The foundation: <code>.input</code> alone gives you an accessible
          text input. Background <code>--bg-elevated</code>, border
          <code>--border-default</code>, focus → brand border + 3px ring.
        </p>
      </header>
      <div class="forms-page__demo forms-page__demo--narrow">
        <div class="form-field">
          <label for="base-text" class="form-label">نص بسيط</label>
          <input id="base-text" type="text" class="input" placeholder="اكتب هنا…" />
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 2 — SIZE MODIFIERS
         ============================================================ -->
    <section class="forms-page__section" aria-labelledby="sizes-heading">
      <header class="forms-page__section-head">
        <span class="section__eyebrow">02 · Sizes</span>
        <h2 id="sizes-heading" class="section__title">Size ladder</h2>
        <p class="section__subtitle">
          Three sizes — sm 36px (compact in-row), md 44px (default, AAA),
          lg 52px (prominent forms). Height doubles as the tap target.
        </p>
      </header>

      <div class="forms-page__demo forms-page__demo--narrow">
        <div class="form-field">
          <label for="size-sm" class="form-label"><code>.input--sm</code> · 36px</label>
          <input id="size-sm" type="text" class="input input--sm" placeholder="حجم صغير" />
        </div>

        <div class="form-field">
          <label for="size-md" class="form-label"><code>.input--md</code> · 44px (default)</label>
          <input id="size-md" type="text" class="input input--md" placeholder="حجم متوسط" />
        </div>

        <div class="form-field">
          <label for="size-lg" class="form-label"><code>.input--lg</code> · 52px</label>
          <input id="size-lg" type="text" class="input input--lg" placeholder="حجم كبير" />
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 3 — INPUT TYPES
         ============================================================ -->
    <section class="forms-page__section" aria-labelledby="types-heading">
      <header class="forms-page__section-head">
        <span class="section__eyebrow">03 · Types</span>
        <h2 id="types-heading" class="section__title">Input types</h2>
        <p class="section__subtitle">
          Native HTML5 input types — the same <code>.input</code> class
          adapts to all of them. Type-specific validation runs on the
          browser (no JS needed).
        </p>
      </header>

      <div class="forms-page__demo forms-page__demo--narrow">
        <div class="form-field">
          <label for="type-text" class="form-label">النص (text)</label>
          <input id="type-text" type="text" class="input" placeholder="محمد أحمد" />
        </div>

        <div class="form-field">
          <label for="type-email" class="form-label">البريد الإلكتروني (email)</label>
          <input id="type-email" type="email" class="input" placeholder="example@company.sa" />
          <span class="form-helper">نرد عليك خلال 24 ساعة</span>
        </div>

        <div class="form-field">
          <label for="type-tel" class="form-label">رقم الجوال (tel)</label>
          <input id="type-tel" type="tel" class="input" placeholder="05X-XXX-XXXX" dir="ltr" />
        </div>

        <div class="form-field">
          <label for="type-password" class="form-label">كلمة المرور (password)</label>
          <input id="type-password" type="password" class="input" placeholder="••••••••" dir="ltr" />
        </div>

        <div class="form-field">
          <label for="type-url" class="form-label">الموقع (url)</label>
          <input id="type-url" type="url" class="input" placeholder="https://example.com" dir="ltr" />
        </div>

        <div class="form-field">
          <label for="type-number" class="form-label">العدد (number)</label>
          <input id="type-number" type="number" class="input" placeholder="0" min="0" max="100" dir="ltr" />
        </div>

        <div class="form-field">
          <label for="type-search" class="form-label">البحث (search)</label>
          <input id="type-search" type="search" class="input" placeholder="ابحث في الموقع…" dir="ltr" />
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 4 — TEXTAREA
         ============================================================ -->
    <section class="forms-page__section" aria-labelledby="textarea-heading">
      <header class="forms-page__section-head">
        <span class="section__eyebrow">04 · Textarea</span>
        <h2 id="textarea-heading" class="section__title">Textarea</h2>
        <p class="section__subtitle">
          Multi-line input with <code>.input--textarea</code> modifier.
          Min-height 150px, vertical resize, relaxed line-height for
          Arabic breathing room.
        </p>
      </header>

      <div class="forms-page__demo forms-page__demo--narrow">
        <div class="form-field">
          <label for="ta-message" class="form-label">رسالتك <span aria-hidden="true">*</span></label>
          <textarea id="ta-message" class="input input--textarea" required placeholder="اكتب رسالتك هنا…"></textarea>
          <span class="form-helper">الحد الأقصى 2000 حرف</span>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 5 — SELECT
         ============================================================ -->
    <section class="forms-page__section" aria-labelledby="select-heading">
      <header class="forms-page__section-head">
        <span class="section__eyebrow">05 · Select</span>
        <h2 id="select-heading" class="section__title">Select dropdown</h2>
        <p class="section__subtitle">
          Native select with custom SVG arrow (RTL-aware). Use
          <code>.input--select</code> to swap the OS-default chrome.
        </p>
      </header>

      <div class="forms-page__demo forms-page__demo--narrow">
        <div class="form-field">
          <label for="sel-sector" class="form-label">القطاع</label>
          <select id="sel-sector" class="input input--select">
            <option value="">اختر القطاع</option>
            <option>جهات حكومية</option>
            <option>مالي / بنوك</option>
            <option>رعاية صحية</option>
            <option>تعليم</option>
            <option>طاقة / صناعة</option>
            <option>تقنية / SaaS</option>
            <option>غيره</option>
          </select>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 6 — CHECKBOX & RADIO
         ============================================================ -->
    <section class="forms-page__section" aria-labelledby="check-heading">
      <header class="forms-page__section-head">
        <span class="section__eyebrow">06 · Checkbox &amp; radio</span>
        <h2 id="check-heading" class="section__title">Selection controls</h2>
        <p class="section__subtitle">
          Native checkboxes and radios styled with <code>accent-color</code>
          (brand color, no JS, no SVG). Always wrap with a real
          <code>&lt;label&gt;</code> for accessibility.
        </p>
      </header>

      <div class="forms-page__demo forms-page__demo--narrow">
        <div class="form-field">
          <span class="form-label">الاهتمامات</span>
          <div class="forms-page__check-group">
            <label class="forms-page__check">
              <input type="checkbox" class="input input--checkbox" checked />
              <span>حوكمة الذكاء الاصطناعي</span>
            </label>
            <label class="forms-page__check">
              <input type="checkbox" class="input input--checkbox" />
              <span>حماية البيانات (PDPL)</span>
            </label>
            <label class="forms-page__check">
              <input type="checkbox" class="input input--checkbox" />
              <span>تدقيق ومراجعة</span>
            </label>
          </div>
        </div>

        <div class="form-field">
          <span class="form-label">حجم الشركة</span>
          <div class="forms-page__check-group">
            <label class="forms-page__check">
              <input type="radio" name="size" class="input input--radio" checked />
              <span>1–50 موظف</span>
            </label>
            <label class="forms-page__check">
              <input type="radio" name="size" class="input input--radio" />
              <span>51–500 موظف</span>
            </label>
            <label class="forms-page__check">
              <input type="radio" name="size" class="input input--radio" />
              <span>+500 موظف</span>
            </label>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 7 — FILE INPUT
         ============================================================ -->
    <section class="forms-page__section" aria-labelledby="file-heading">
      <header class="forms-page__section-head">
        <span class="section__eyebrow">07 · File</span>
        <h2 id="file-heading" class="section__title">File input</h2>
        <p class="section__subtitle">
          Styled file picker with <code>.input--file</code> — the
          <code>::file-selector-button</code> pseudo-element gets a
          secondary-button look that matches the rest of the system.
        </p>
      </header>

      <div class="forms-page__demo forms-page__demo--narrow">
        <div class="form-field">
          <label for="file-upload" class="form-label">رفع ملف</label>
          <input id="file-upload" type="file" class="input input--file" />
          <span class="form-helper">PDF, DOCX, XLSX — حتى 10MB</span>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 8 — STATES
         ============================================================ -->
    <section class="forms-page__section" aria-labelledby="states-heading">
      <header class="forms-page__section-head">
        <span class="section__eyebrow">08 · States</span>
        <h2 id="states-heading" class="section__title">Input states</h2>
        <p class="section__subtitle">
          Six states — default, hover, focus, disabled, readonly, error.
          The error state uses <code>--status-danger</code> border + 3px
          red-tinted ring + <code>.form-error</code> helper text.
        </p>
      </header>

      <div class="forms-page__demo forms-page__demo--narrow">
        <div class="form-field">
          <label for="state-default" class="form-label">افتراضي (default)</label>
          <input id="state-default" type="text" class="input" placeholder="نص افتراضي" />
        </div>

        <div class="form-field">
          <label for="state-hover" class="form-label">عند التمرير (hover)</label>
          <input id="state-hover" type="text" class="input is-hover-demo" value="مرر الفأرة فوقي" />
        </div>

        <div class="form-field">
          <label for="state-focus" class="form-label">عند التركيز (focus)</label>
          <input id="state-focus" type="text" class="input is-focus-demo" value="مركّز الآن" />
        </div>

        <div class="form-field">
          <label for="state-disabled" class="form-label">معطّل (disabled)</label>
          <input id="state-disabled" type="text" class="input" disabled value="غير مفعّل" />
        </div>

        <div class="form-field">
          <label for="state-readonly" class="form-label">قراءة فقط (readonly)</label>
          <input id="state-readonly" type="text" class="input" readonly value="نص للقراءة فقط" />
        </div>

        <div class="form-field">
          <label for="state-error" class="form-label">خطأ (error)</label>
          <input id="state-error" type="email" class="input input--error" aria-invalid="true" value="بريد غير صالح" />
          <span class="form-error">صيغة البريد الإلكتروني غير صحيحة. مثال: name@company.sa</span>
        </div>

        <div class="form-field">
          <label for="state-success" class="form-label">صحيح (success — via :valid CSS)</label>
          <input id="state-success" type="email" class="input" required value="valid@example.com" />
          <span class="form-helper">✓ بريد صحيح</span>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 9 — FORM LAYOUT
         ============================================================ -->
    <section class="forms-page__section" aria-labelledby="layout-heading">
      <header class="forms-page__section-head">
        <span class="section__eyebrow">09 · Layout</span>
        <h2 id="layout-heading" class="section__title">Form layout helpers</h2>
        <p class="section__subtitle">
          Five canonical helpers: <code>.form-field</code> (wrapper),
          <code>.form-row</code> (grid for 2+ inputs in a row),
          <code>.form-label</code>, <code>.form-helper</code>,
          <code>.form-error</code>. Stack vertically by default,
          responsive grid on <code>--2</code> modifier.
        </p>
      </header>

      <div class="forms-page__demo forms-page__demo--narrow">
        <div class="form-field">
          <span class="form-label">Layout anatomy</span>
          <div class="forms-page__anatomy">
            <code>.form-field</code> — wrapper (flex column, gap 8px)
            <code>.form-label</code> — input label
            <code>.input</code> — the control itself
            <code>.form-helper</code> — hint text (muted, optional)
            <code>.form-error</code> — error text (danger, optional)
          </div>
        </div>
      </div>

      <h3 class="forms-page__subhead">form-row (2-column grid)</h3>
      <div class="forms-page__demo">
        <div class="form-row form-row--2">
          <div class="form-field">
            <label for="row-name" class="form-label">الاسم <span aria-hidden="true">*</span></label>
            <input id="row-name" type="text" class="input" required placeholder="محمد أحمد" />
          </div>
          <div class="form-field">
            <label for="row-email" class="form-label">البريد <span aria-hidden="true">*</span></label>
            <input id="row-email" type="email" class="input" required placeholder="name@company.sa" dir="ltr" />
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 10 — COMPLETE FORM (real-world)
         ============================================================ -->
    <section class="forms-page__section" aria-labelledby="complete-heading">
      <header class="forms-page__section-head">
        <span class="section__eyebrow">10 · Complete</span>
        <h2 id="complete-heading" class="section__title">Complete form</h2>
        <p class="section__subtitle">
          Real-world example — the same pattern used in
          <code>/contact/</code>. Stacks vertically on mobile, 2-column
          on tablet+, submit button uses <code>.inner-form__submit</code>.
        </p>
      </header>

      <div class="forms-page__demo">
        <form class="inner-form" onsubmit="event.preventDefault();">
          <div class="form-row form-row--2">
            <div class="form-field">
              <label for="cf-name" class="form-label">الاسم الكامل <span aria-hidden="true">*</span></label>
              <input id="cf-name" type="text" class="input" required placeholder="مثال: محمد أحمد" />
            </div>
            <div class="form-field">
              <label for="cf-email" class="form-label">البريد الإلكتروني <span aria-hidden="true">*</span></label>
              <input id="cf-email" type="email" class="input" required placeholder="example@company.sa" dir="ltr" />
            </div>
          </div>

          <div class="form-row form-row--2">
            <div class="form-field">
              <label for="cf-phone" class="form-label">رقم الجوال</label>
              <input id="cf-phone" type="tel" class="input" placeholder="05X-XXX-XXXX" dir="ltr" />
            </div>
            <div class="form-field">
              <label for="cf-company" class="form-label">اسم الشركة</label>
              <input id="cf-company" type="text" class="input" placeholder="اسم شركتك" />
            </div>
          </div>

          <div class="form-field">
            <label for="cf-sector" class="form-label">القطاع</label>
            <select id="cf-sector" class="input input--select">
              <option value="">اختر القطاع</option>
              <option>جهات حكومية</option>
              <option>مالي / بنوك</option>
              <option>رعاية صحية</option>
              <option>تعليم</option>
              <option>غيره</option>
            </select>
          </div>

          <div class="form-field">
            <label for="cf-message" class="form-label">رسالتك <span aria-hidden="true">*</span></label>
            <textarea id="cf-message" class="input input--textarea" required placeholder="أخبرنا عن احتياجاتك أو استفسارك..."></textarea>
            <span class="form-helper">الحد الأقصى 2000 حرف</span>
          </div>

          <div class="form-field">
            <label class="forms-page__check">
              <input type="checkbox" class="input input--checkbox" required />
              <span>أوافق على معالجة بياناتي الشخصية وفقاً لـ <a href="#">سياسة الخصوصية</a> <span aria-hidden="true">*</span></span>
            </label>
          </div>

          <button type="submit" class="inner-form__submit">
            <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-send"></use></svg>
            إرسال الرسالة
          </button>
        </form>
      </div>
    </section>

    <!-- ============================================================
         SECTION 11 — LEGACY ALIASES
         ============================================================ -->
    <section class="forms-page__section" aria-labelledby="aliases-heading">
      <header class="forms-page__section-head">
        <span class="section__eyebrow">11 · Legacy</span>
        <h2 id="aliases-heading" class="section__title">Legacy aliases</h2>
        <p class="section__subtitle">
          Old class names preserved for HTML compatibility. All aliases
          resolve to the canonical <code>.input</code> + variant +
          <code>.form-field</code> layout.
        </p>
      </header>
      <div class="forms-page__alias-table">
        <table>
          <thead>
            <tr><th>Legacy class</th><th>Canonical</th><th>Status</th></tr>
          </thead>
          <tbody>
            <tr><td><code>.field</code></td><td><code>.input</code></td><td>✅ preserved (used in pages.css)</td></tr>
            <tr><td><code>.home-form-input</code></td><td><code>.input</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.inner-form__input</code></td><td><code>.input</code></td><td>✅ preserved (contact form)</td></tr>
            <tr><td><code>.inner-form__textarea</code></td><td><code>.input.input--textarea</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.inner-form__select</code></td><td><code>.input.input--select</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.inner-form__group</code></td><td><code>.form-field</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.inner-form__label</code></td><td><code>.form-label</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.inner-form__submit</code></td><td><code>.btn.btn--primary</code></td><td>✅ preserved (custom styling)</td></tr>
            <tr><td><code>.field-group</code></td><td><code>.form-field</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.field-label</code></td><td><code>.form-label</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.field-help</code></td><td><code>.form-helper</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.field-error</code></td><td><code>.form-error</code></td><td>✅ preserved</td></tr>
          </tbody>
        </table>
        <p class="forms-page__alias-note">
          Aliases are kept indefinitely for HTML compatibility — they're
          used in 30+ existing form elements across contact, demo, and
          assessment pages. New code should use canonical names
          (<code>.input</code> + <code>.form-field</code>).
        </p>
      </div>
    </section>
  </main>
</ArabicLayout>

<style>
  .forms-page {
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--space-12) var(--space-4);
    color: var(--text-primary);
  }

  .forms-page__header {
    text-align: center;
    margin-block-end: var(--space-16);
  }

  .forms-page__title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: var(--font-extrabold);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin-block: var(--space-4) var(--space-6);
    text-wrap: balance;
  }

  .forms-page__ar-lead {
    font-size: var(--text-base);
