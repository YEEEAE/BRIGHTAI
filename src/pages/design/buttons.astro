---
/**
 * BrightAI — Internal Button System Showcase
 * ─────────────────────────────────────────────────
 * REPORT-08 / DEC-2026-035: Internal preview page for the unified button
 * system (.btn + variants + sizes + states + icon buttons).
 *
 * Purpose: review every button variant, size, and state in one place.
 * Used by the design team and the agent to validate visual decisions
 * before shipping any redesign that touches buttons.
 *
 * Sections:
 *   1. Base button
 *   2. Variants (primary / secondary / ghost / outline / whatsapp / danger / glow)
 *   3. Sizes (sm / md / lg / xl)
 *   4. States (default / hover / active / focus / disabled / loading)
 *   5. Icon buttons (icon-only + icon+label)
 *   6. Real-world combinations (in-row, full-width, hero)
 *   7. Legacy aliases reference
 *
 * Constraints:
 *   - Page is INDEXABLE (REPORTS-SEO-FOUNDATION, 2026-07-07).
 *   - All sample text is intentionally generic.
 *   - No published Arabic text from any production page is used here.
 *
 * Access: Published as /design/buttons/ for team reference and searchability.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
---

<ArabicLayout
  title="نظام الأزرار الموحّد | BrightAI Design System"
  description="مرجع نظام الأزرار الموحّد في BrightAI: 8 أنواع للزر، 4 أحجام من 36px إلى 60px، و6 حالات تفاعل."
  canonical="https://brightai.live/design/buttons/"
  robots="noindex, follow"
  hreflang={[
    { lang: 'ar-SA', href: 'https://brightai.live/design/buttons/' },
    { lang: 'x-default', href: 'https://brightai.live/design/buttons/' },
  ]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'نظام الأزرار الموحّد — BrightAI Design System',
    url: 'https://brightai.live/design/buttons/',
    inLanguage: 'ar-SA',
    description: 'مرجع نظام الأزرار الموحّد في BrightAI: 8 أنواع للزر و4 أحجام و6 حالات، متوافق مع WCAG 2.5.5 AAA.',
  }}
  currentPath="/design/buttons/"
  breadcrumbs={[{ name: 'دليل التصميم', href: '/design/typography/' }, { name: 'نظام الأزرار', href: '/design/buttons/' }]}
>
  <main class="buttons-page" aria-label="Button system reference">
    <header class="buttons-page__header">
      <span class="section__eyebrow" lang="ar">مرجع داخلي — Internal reference</span>
      <h1 class="buttons-page__title">Button System</h1>
      <p class="lead">
        The unified button system for BrightAI — every button on the production
        site resolves to <code>.btn</code> + a variant + a size + a state. All
        variants share the same base (44px height, 350ms transition, 2px
        focus ring offset 2px). Tap targets ≥ 44px on every size to meet
        WCAG 2.5.5 AAA. Page is fully indexable (REPORTS-SEO-FOUNDATION).
      </p>
      <p class="buttons-page__ar-lead" lang="ar" dir="rtl">
        نظام الأزرار الموحّد في BrightAI. كل زر على الموقع يستخدم
        <code>.btn</code> كنقطة بداية مع variant واحد من القائمة تحت.
        أحجام: sm 36px، md 44px (الافتراضي)، lg 52px، xl 60px.
        الـ focus ring موحّد: 2px brand color مع offset 2px.
      </p>
    </header>

    <!-- ============================================================
         SECTION 1 — BASE BUTTON
         ============================================================ -->
    <section class="buttons-page__section" aria-labelledby="base-heading">
      <header class="buttons-page__section-head">
        <span class="section__eyebrow">01 · Base</span>
        <h2 id="base-heading" class="section__title">Base button</h2>
        <p class="section__subtitle">
          The foundation: <code>.btn</code> alone gives you a neutral, accessible
          button with no variant color. Rarely used directly — start with a
          variant below.
        </p>
      </header>
      <div class="buttons-page__row">
        <button type="button" class="btn">نص زر افتراضي</button>
        <button type="button" class="btn" disabled>نص زر معطل</button>
        <a href="#base-heading" class="btn">رابط بستايل زر</a>
      </div>
    </section>

    <!-- ============================================================
         SECTION 2 — VARIANTS
         ============================================================ -->
    <section class="buttons-page__section" aria-labelledby="variants-heading">
      <header class="buttons-page__section-head">
        <span class="section__eyebrow">02 · Variants</span>
        <h2 id="variants-heading" class="section__title">Button variants</h2>
        <p class="section__subtitle">
          Six semantic variants plus the legacy <code>.btn--glow</code>.
          Each variant defines background, text color, and border —
          never override these manually.
        </p>
      </header>

      <div class="buttons-page__variant-grid">
        <article class="buttons-page__variant">
          <header class="buttons-page__variant-head">
            <code>.btn--primary</code>
            <span class="buttons-page__variant-use">الـ CTA الأساسي</span>
          </header>
          <button type="button" class="btn btn--primary">ابدأ الآن</button>
        </article>

        <article class="buttons-page__variant">
          <header class="buttons-page__variant-head">
            <code>.btn--secondary</code>
            <span class="buttons-page__variant-use">إجراء ثانوي</span>
          </header>
          <button type="button" class="btn btn--secondary">اعرف أكثر</button>
        </article>

        <article class="buttons-page__variant">
          <header class="buttons-page__variant-head">
            <code>.btn--ghost</code>
            <span class="buttons-page__variant-use">إجراء خفيف</span>
          </header>
          <button type="button" class="btn btn--ghost">إلغاء</button>
        </article>

        <article class="buttons-page__variant">
          <header class="buttons-page__variant-head">
            <code>.btn--outline</code>
            <span class="buttons-page__variant-use">حد فقط</span>
          </header>
          <button type="button" class="btn btn--outline">استعرض</button>
        </article>

        <article class="buttons-page__variant">
          <header class="buttons-page__variant-head">
            <code>.btn--whatsapp</code>
            <span class="buttons-page__variant-use">تواصل واتساب</span>
          </header>
          <a rel="noopener noreferrer" href="/go/whatsapp/" class="btn btn--whatsapp">
            <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-whatsapp"></use></svg>
            تواصل واتساب
          </a>
        </article>

        <article class="buttons-page__variant">
          <header class="buttons-page__variant-head">
            <code>.btn--danger</code>
            <span class="buttons-page__variant-use">إجراء مدمر</span>
          </header>
          <button type="button" class="btn btn--danger">احذف الحساب</button>
        </article>

        <article class="buttons-page__variant">
          <header class="buttons-page__variant-head">
            <code>.btn--glow</code>
            <span class="buttons-page__variant-use">legacy — gradient + glow</span>
          </header>
          <button type="button" class="btn btn--glow">زر متوهج</button>
        </article>

        <article class="buttons-page__variant">
          <header class="buttons-page__variant-head">
            <code>.btn--accent</code>
            <span class="buttons-page__variant-use">success / confirm</span>
          </header>
          <button type="button" class="btn btn--accent">تأكيد العملية</button>
        </article>
      </div>
    </section>

    <!-- ============================================================
         SECTION 3 — SIZES
         ============================================================ -->
    <section class="buttons-page__section" aria-labelledby="sizes-heading">
      <header class="buttons-page__section-head">
        <span class="section__eyebrow">03 · Sizes</span>
        <h2 id="sizes-heading" class="section__title">Size ladder</h2>
        <p class="section__subtitle">
          Four sizes — sm 36px, md 44px (default, AAA), lg 52px, xl 60px
          (hero). Every size meets WCAG 2.5.5 AAA tap target on the
          height axis; horizontal padding scales proportionally.
        </p>
      </header>

      <div class="buttons-page__size-row">
        <div class="buttons-page__size-cell">
          <code>.btn--sm</code>
          <span class="buttons-page__size-label">36px / 12px</span>
          <button type="button" class="btn btn--primary btn--sm">زر صغير</button>
        </div>

        <div class="buttons-page__size-cell">
          <code>.btn--md</code>
          <span class="buttons-page__size-label">44px / 16px (default)</span>
          <button type="button" class="btn btn--primary btn--md">زر متوسط</button>
        </div>

        <div class="buttons-page__size-cell">
          <code>.btn--lg</code>
          <span class="buttons-page__size-label">52px / 24px</span>
          <button type="button" class="btn btn--primary btn--lg">زر كبير</button>
        </div>

        <div class="buttons-page__size-cell">
          <code>.btn--xl</code>
          <span class="buttons-page__size-label">60px / 32px (hero)</span>
          <button type="button" class="btn btn--primary btn--xl">زر heroes</button>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 4 — STATES
         ============================================================ -->
    <section class="buttons-page__section" aria-labelledby="states-heading">
      <header class="buttons-page__section-head">
        <span class="section__eyebrow">04 · States</span>
        <h2 id="states-heading" class="section__title">Button states</h2>
        <p class="section__subtitle">
          Five states — default, hover (mouse over), active (pressed),
          focus (keyboard), disabled, and loading (in-flight async). The
          loading state shows a spinner and disables clicks.
        </p>
      </header>

      <div class="buttons-page__state-grid">
        <div class="buttons-page__state-cell">
          <span class="buttons-page__state-label">default</span>
          <button type="button" class="btn btn--primary">زر افتراضي</button>
        </div>

        <div class="buttons-page__state-cell">
          <span class="buttons-page__state-label">hover (mouse over)</span>
          <button type="button" class="btn btn--primary is-hover-demo">مرر الفأرة</button>
        </div>

        <div class="buttons-page__state-cell">
          <span class="buttons-page__state-label">active (pressed)</span>
          <button type="button" class="btn btn--primary is-active-demo">اضغط معي</button>
        </div>

        <div class="buttons-page__state-cell">
          <span class="buttons-page__state-label">focus (keyboard)</span>
          <button type="button" class="btn btn--primary is-focus-demo">Tab للوصول</button>
        </div>

        <div class="buttons-page__state-cell">
          <span class="buttons-page__state-label">disabled</span>
          <button type="button" class="btn btn--primary" disabled>غير مفعّل</button>
        </div>

        <div class="buttons-page__state-cell">
          <span class="buttons-page__state-label">loading (with spinner)</span>
          <button type="button" class="btn btn--primary btn--loading" disabled>
            <span class="btn__label">جاري الإرسال…</span>
          </button>
        </div>

        <div class="buttons-page__state-cell">
          <span class="buttons-page__state-label">loading + outline</span>
          <button type="button" class="btn btn--outline btn--loading" disabled>
            <span class="btn__label">جاري التحميل…</span>
          </button>
        </div>

        <div class="buttons-page__state-cell">
          <span class="buttons-page__state-label">loading + ghost</span>
          <button type="button" class="btn btn--ghost btn--loading" disabled>
            <span class="btn__label">جاري المعالجة…</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SECTION 5 — ICON BUTTONS
         ============================================================ -->
    <section class="buttons-page__section" aria-labelledby="icons-heading">
      <header class="buttons-page__section-head">
        <span class="section__eyebrow">05 · Icon buttons</span>
        <h2 id="icons-heading" class="section__title">Icon + label + icon-only</h2>
        <p class="section__subtitle">
          Three patterns: icon+label (button text with leading icon), icon
          trailing (chevron after text), and icon-only (square aspect for
          compact toolbars). Every pattern respects the same size ladder.
        </p>
      </header>

      <h3 class="buttons-page__subhead">Icon + label (in-row)</h3>
      <div class="buttons-page__row">
        <button type="button" class="btn btn--primary">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-send"></use></svg>
          إرسال
        </button>
        <button type="button" class="btn btn--secondary">
          تحميل
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-download"></use></svg>
        </button>
        <button type="button" class="btn btn--ghost">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-pencil"></use></svg>
          تعديل
        </button>
      </div>

      <h3 class="buttons-page__subhead">Icon-only (square aspect)</h3>
      <div class="buttons-page__row">
        <button type="button" class="btn btn--icon btn--primary" aria-label="إرسال">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-send"></use></svg>
        </button>
        <button type="button" class="btn btn--icon btn--secondary" aria-label="تحميل">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-download"></use></svg>
        </button>
        <button type="button" class="btn btn--icon btn--ghost" aria-label="مشاركة">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-share-variant"></use></svg>
        </button>
        <button type="button" class="btn btn--icon btn--outline" aria-label="إعدادات">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-cog"></use></svg>
        </button>
        <button type="button" class="btn btn--icon btn--icon btn--sm btn--ghost" aria-label="حذف">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-trash-can-outline"></use></svg>
        </button>
        <button type="button" class="btn btn--icon btn--icon btn--lg btn--primary" aria-label="إضافة">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-plus"></use></svg>
        </button>
      </div>
    </section>

    <!-- ============================================================
         SECTION 6 — REAL-WORLD COMBINATIONS
         ============================================================ -->
    <section class="buttons-page__section" aria-labelledby="realworld-heading">
      <header class="buttons-page__section-head">
        <span class="section__eyebrow">06 · Real-world</span>
        <h2 id="realworld-heading" class="section__title">Real-world combinations</h2>
        <p class="section__subtitle">
          The system in context — hero CTAs, in-row actions, full-width
          mobile stacks, and dialog confirmations.
        </p>
      </header>

      <h3 class="buttons-page__subhead">Hero CTA pair (xl + md)</h3>
      <div class="buttons-page__demo buttons-page__demo--center">
        <button type="button" class="btn btn--primary btn--xl">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-rocket-launch"></use></svg>
          ابدأ تجربتك المجانية
        </button>
        <a href="#contact" class="btn btn--ghost btn--md">تحدث مع المبيعات</a>
      </div>

      <h3 class="buttons-page__subhead">In-row actions (sm)</h3>
      <div class="buttons-page__demo">
        <button type="button" class="btn btn--secondary btn--sm">حفظ كمسودة</button>
        <button type="button" class="btn btn--primary btn--sm">نشر</button>
        <button type="button" class="btn btn--ghost btn--sm">إلغاء</button>
      </div>

      <h3 class="buttons-page__subhead">Full-width mobile stack (md + block)</h3>
      <div class="buttons-page__demo buttons-page__demo--narrow">
        <button type="button" class="btn btn--primary btn--block">متابعة</button>
        <button type="button" class="btn btn--ghost btn--block">رجوع</button>
      </div>

      <h3 class="buttons-page__subhead">WhatsApp CTA (lg)</h3>
      <div class="buttons-page__demo buttons-page__demo--center">
        <a rel="noopener noreferrer" href="/go/whatsapp/" class="btn btn--whatsapp btn--lg">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-whatsapp"></use></svg>
          تواصل مباشر عبر واتساب
        </a>
      </div>

      <h3 class="buttons-page__subhead">Loading state in context (form submit)</h3>
      <div class="buttons-page__demo buttons-page__demo--narrow">
        <form class="buttons-page__form" data-prevent-default>
          <div class="form-field">
            <label for="demo-name" class="form-label">الاسم <span aria-hidden="true">*</span></label>
            <input id="demo-name" type="text" class="input" required placeholder="اكتب اسمك" />
          </div>
          <button type="submit" class="btn btn--primary btn--loading" disabled>
            <span class="btn__label">جاري الإرسال…</span>
          </button>
        </form>
      </div>
    </section>

    <!-- ============================================================
         SECTION 7 — LEGACY ALIASES
         ============================================================ -->
    <section class="buttons-page__section" aria-labelledby="aliases-heading">
      <header class="buttons-page__section-head">
        <span class="section__eyebrow">07 · Legacy</span>
        <h2 id="aliases-heading" class="section__title">Legacy aliases</h2>
        <p class="section__subtitle">
          Old class names preserved for HTML compatibility. All aliases
          resolve to the canonical <code>.btn</code> + variant + size.
        </p>
      </header>
      <div class="buttons-page__alias-table">
        <table>
          <thead>
            <tr><th>Legacy class</th><th>Canonical</th><th>Status</th></tr>
          </thead>
          <tbody>
            <tr><td><code>.btn-primary</code> (single dash)</td><td><code>.btn--primary</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.btn-secondary</code></td><td><code>.btn--secondary</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.btn-ghost</code></td><td><code>.btn--ghost</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.btn-accent</code></td><td><code>.btn--accent</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.glow-btn</code></td><td><code>.btn--glow</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.home-cta-primary</code></td><td><code>.btn--glow .btn--primary</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.home-cta-secondary</code></td><td><code>.btn--secondary</code></td><td>✅ preserved</td></tr>
            <tr><td><code>.wa-btn</code></td><td><code>.btn--whatsapp</code></td><td>✅ preserved</td></tr>
          </tbody>
        </table>
        <p class="buttons-page__alias-note">
          Aliases are kept indefinitely for HTML compatibility — they're
          used in 81+ existing page elements. New code should use canonical
          names (<code>.btn--primary</code> over <code>.btn-primary</code>).
        </p>
      </div>
    </section>
  </main>
</ArabicLayout>

<style>
  .buttons-page {
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--space-12) var(--space-4);
    color: var(--text-primary);
  }

  .buttons-page__header {
    text-align: center;
    margin-block-end: var(--space-16);
  }

  .buttons-page__title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: var(--font-extrabold);
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin-block: var(--space-4) var(--space-6);
    text-wrap: balance;
  }

  .buttons-page__ar-lead {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
    margin-inline: auto;
    text-wrap: pretty;
  }

  .buttons-page__section {
    margin-block-end: var(--space-20);
  }

  .buttons-page__section-head {
    text-align: center;
    margin-block-end: var(--space-10);
  }

  .buttons-page__subhead {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    margin-block: var(--space-8) var(--space-4);
  }

  .buttons-page__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    align-items: center;
  }

  .buttons-page__variant-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--space-6);
  }

  .buttons-page__variant {
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    text-align: center;
  }

  .buttons-page__variant-head {
    margin-block-end: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .buttons-page__variant-head code {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: var(--text-sm);
    color: var(--brand-300);
    direction: ltr;
  }

  .buttons-page__variant-use {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .buttons-page__size-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--space-6);
  }

  .buttons-page__size-cell {
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .buttons-page__size-cell code {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: var(--text-sm);
    color: var(--brand-300);
    direction: ltr;
  }

  .buttons-page__size-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .buttons-page__state-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-4);
  }

  .buttons-page__state-cell {
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .buttons-page__state-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-align: center;
  }

  /* Demo hover/active/focus states (visual aid — not real interaction) */
  .is-hover-demo {
    background: var(--brand-600);
    border-color: var(--brand-600);
    box-shadow: var(--shadow-cta-glow-lg);
    transform: translateY(-2px);
  }
  .is-active-demo {
    background: var(--brand-700);
    border-color: var(--brand-700);
    transform: scale(0.98);
  }
  .is-focus-demo {
    outline: 2px solid var(--brand-300);
    outline-offset: 2px;
  }

  .buttons-page__demo {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    background: var(--surface-2);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .buttons-page__demo--center {
    justify-content: center;
  }

  .buttons-page__demo--narrow {
    max-width: 400px;
    flex-direction: column;
    align-items: stretch;
