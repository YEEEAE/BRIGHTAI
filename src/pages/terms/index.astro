---
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { getLanguageCounterpart, getLegalAlternates } from '../../data/i18n-pairs';
import { legal_terms } from '../../data/legal-content-inline';
import DOMPurify from 'isomorphic-dompurify';
const route = '/terms/';
const canonical = `https://brightai.site${route}`;
const legalContent = legal_terms;
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
]};
---
<ArabicLayout title="شروط الاستخدام | حوكمة AI من BrightAI" description="شروط استخدام موقع وخدمات BrightAI: مسؤوليات المستخدم وحدود الخدمة ومتطلبات الاستخدام المقبول لحلول حوكمة AI في السعودية وفق الأنظمة المحلية." canonical={canonical} hreflang={getLegalAlternates(route, 'ar')} jsonLd={jsonLd} currentPath={route} languageCounterpart={getLanguageCounterpart(route)} breadcrumbs={[{ name: 'الشروط والأحكام', href: '/terms/' }]}>
  <div class="legal-page" set:html={DOMPurify.sanitize(legalContent.html)} />
</ArabicLayout>
