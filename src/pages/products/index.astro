---
import PageShell from '../../components/PageShell.astro';
export const prerender = true;
const layers = [
  { code: 'K1', title: 'الهوية والصلاحيات', text: 'يتعرف على المستخدم والجهة قبل أي شيء، ويحدد القوالب والنماذج المسموحة لكل دور.' },
  { code: 'K2', title: 'قوالب السياسات', text: 'الطلبات تمر عبر قوالب معتمدة فقط (promptId)، ولا يُقبل أي system prompt من الخارج. هكذا نغلق باب حقن التعليمات.' },
  { code: 'K3', title: 'جدار حماية البيانات', text: 'يكتشف الهوية الوطنية والإقامة والآيبان وبيانات الاعتماد وأرقام المرضى، ويحجبها قبل خروج الطلب.' },
  { code: 'K4', title: 'الحصص وقاطع الدائرة', text: 'يحدد معدل الطلبات لكل جهة، ويعزل المزود الذي يتكرر فشله وينقل الطلبات تلقائياً للمزود البديل.' },
];
const products = [
  { slug: 'firewall', name: 'AIGAS Firewall', text: 'يحجب البيانات الحساسة قبل وصولها للنموذج.', plans: 'كل الباقات' },
  { slug: 'risk-engine', name: 'AIGAS Risk Engine', text: 'يعطي كل طلب درجة مخاطر من 0 إلى 100 ويطبق سياستكم.', plans: 'كل الباقات' },
  { slug: 'human-gate', name: 'AIGAS Human Gate', text: 'يوقف القرارات الحرجة إلى أن يعتمدها إنسان.', plans: 'Business فأعلى' },
  { slug: 'ledger', name: 'AIGAS Ledger', text: 'سجل تدقيق بسلسلة بصمات تشفيرية يكشف أي تعديل.', plans: 'كل الباقات' },
  { slug: 'secure-chat', name: 'AIGAS Secure Chat', text: 'مساعد عربي آمن مع بث مباشر للردود.', plans: 'كل الباقات' },
];
---
<PageShell title="منصة AIGAS Kernel والمنتجات | BRIGHTAI" description="Kernel طبقة حوكمة وأمان بين موظفيك ونماذج الذكاء الاصطناعي، وتتكون من خمسة منتجات: Firewall وRisk Engine وHuman Gate وLedger وSecure Chat." crumbs={[{ name: 'المنتجات' }]}>
  <p class="eyebrow">AIGAS KERNEL / المنصة</p>
  <h1>طبقة واحدة بين فريقك<br /><span class="muted">وكل نماذج الذكاء الاصطناعي.</span></h1>
  <p class="note">هذا المحتوى يصف التصور المستهدف للمنصة، ولا يثبت تشغيل القدرات أو التكاملات أو مدد الاحتفاظ المذكورة. المتاح هنا تجربة حجب توضيحية؛ يُحدد نطاق الخدمة والتزاماتها في اتفاق مكتوب.</p>
  <p class="lead">Kernel لا يستبدل النماذج التي تستخدمها. يقف قبلها، فيفحص كل طلب ويقيّمه ويسجله، ثم يقرر: هل يمر، أو يمر بعد الحجب، أو يتوقف بانتظار موافقة بشرية.</p>
  <div class="actions"><a class="button" href="/kernel/">جرّب الحجب الآن <span aria-hidden="true">↖</span></a><a class="ghost" href="/pricing/">شاهد الأسعار <span aria-hidden="true">←</span></a></div>

  <section class="block" aria-labelledby="layers">
    <h2 id="layers">أربع طبقات. كل طلب يمر عليها كلها.</h2>
    <p>الترتيب مقصود. نتحقق من هوية المرسل أولاً، ثم من القالب، ثم من البيانات، ثم من الحصة، وبعدها فقط يصل الطلب للنموذج.</p>
    <div class="grid">{layers.map(l => <article class="card"><span class="tag latin" dir="ltr">{l.code}</span><h3>{l.title}</h3><p>{l.text}</p></article>)}</div>
  </section>

  <section class="block" aria-labelledby="mods">
    <h2 id="mods">خمسة منتجات. منصة واحدة.</h2>
    <p>تشتريها كلها ضمن باقة واحدة، وتفعّل منها ما يناسب مرحلتك.</p>
    <div class="grid">{products.map(p => <article class="card"><h3 dir="ltr" style="text-align:right">{p.name}</h3><p>{p.text}</p><span class="note" style="margin:0">متاح في: {p.plans}</span><a class="ghost" href={`/products/${p.slug}/`}>التفاصيل <span aria-hidden="true">←</span></a></article>)}</div>
  </section>

  <section class="block" aria-labelledby="providers">
    <h2 id="providers">بدون تعطّل، وبدون ارتباط بمزود واحد.</h2>
    <p>في الوضع التلقائي يذهب الطلب إلى Groq أولاً، وإذا فشل ينتقل إلى Gemini بدون أي تدخل منك. وإذا أردت مزوداً بعينه تحدده في الطلب. وعند تكرار فشل أي مزود، يعزله قاطع الدائرة في K4 تلقائياً.</p>
    <p>وللجهات التي لا تسمح بخروج أي بيانات، تعمل الباقة السيادية داخل بنيتكم التحتية مع نماذج محلية.</p>
  </section>
</PageShell>
