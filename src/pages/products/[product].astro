---
import PageShell from '../../components/PageShell.astro';
export const prerender = true;
export function getStaticPaths() {
  return [
    {
      slug: 'firewall', name: 'AIGAS Firewall', layer: 'K3', plans: 'متاح في كل الباقات',
      headline: 'البيانات الحساسة ما تطلع من عندك.',
      intro: 'يفحص Firewall كل طلب قبل أن يغادر بيئتك، ويستبدل البيانات الشخصية برموز واضحة. النموذج يفهم السياق ويجيب، لكنه لا يرى الرقم الحقيقي أبداً.',
      problem: 'الموظف الذي يلصق جدول عملاء في أداة ذكاء اصطناعي غالباً لا يقصد الضرر، لكنه يكون قد نقل بيانات شخصية لطرف خارجي. ومع تطبيق نظام حماية البيانات الشخصية، صار هذا خطراً نظامياً وليس مجرد خطأ.',
      features: ['رقم الهوية الوطنية ← [SAUDI_ID]', 'رقم الإقامة ← [IQAMA]', 'الآيبان السعودي ← [IBAN]', 'كلمات المرور ومفاتيح API والرموز ← [CREDENTIAL]', 'أرقام ملفات المرضى ← [PATIENT_ID]', 'أنماط خاصة بمنشأتك (رقم موظف، رقم عقد) كإضافة'],
      example: 'قبل: حوّل المبلغ للآيبان SA0380000000608010167519\n      للعميل صاحب الهوية 1000000000\nبعد: حوّل المبلغ للآيبان [IBAN]\n      للعميل صاحب الهوية [SAUDI_ID]',
      why: 'إخفاء الهوية عندنا لا يحذف السياق. يبقى نوع البيان ظاهراً، فيستطيع فريق المراجعة اكتشاف الانحياز مثلاً عندما تعامل القرارات أصحاب الإقامة بشكل مختلف، بدون كشف أي فرد.',
    },
    {
      slug: 'risk-engine', name: 'AIGAS Risk Engine', layer: 'K2 + K3', plans: 'متاح في كل الباقات',
      headline: 'كل طلب له درجة. وكل درجة لها إجراء.',
      intro: 'يقيّم Risk Engine كل طلب على مقياس من 0 إلى 100 بناءً على محتواه والقالب المستخدم ودور المرسل، ثم يطبق سياسة جهتك تلقائياً.',
      problem: 'ليست كل الطلبات متساوية. تلخيص محضر اجتماع شيء، والتوصية برفض طلب تمويل شيء آخر تماماً. بدون تصنيف، إما أن تمنع كل شيء وتخسر الفائدة، أو تسمح بكل شيء وتتحمل المخاطرة.',
      features: ['0–39 آمن: يمر الطلب مباشرة', '40–69 انتباه: يمر الطلب مع تنبيه وتسجيل مفصل', '70–100 حرج: يتوقف الطلب ويُحال لمعتمد بشري', 'يرفع الدرجة: بيانات حساسة، قرار يمس حقوق فرد، ذكر خصائص قد تسبب تمييزاً كالجنسية والعمر والجنس، محاولة تجاوز التعليمات', 'عتبات قابلة للتعديل حسب سياسة كل جهة وكل إدارة'],
      example: '{\n  "riskScore": 72,\n  "level": "critical",\n  "reasons": ["قرار يمس حقوق فرد", "بيانات مالية"],\n  "action": "hold_for_approval"\n}',
      why: 'كل درجة يصاحبها سبب مكتوب. فإذا سأل المدقق لماذا توقف طلب معين، تكون الإجابة موجودة ولا تعتمد على ذاكرة أحد.',
    },
    {
      slug: 'human-gate', name: 'AIGAS Human Gate', layer: 'K1 + K2', plans: 'متاح في Business وEnterprise وSovereign',
      headline: 'القرار الأخير للإنسان.',
      intro: 'عندما يصنّف Risk Engine طلباً كحرج، يوقفه Human Gate ويرسله للمعتمد المحدد في سياستكم. المعتمد يرى الطلب محجوباً مع الدرجة وأسبابها، ثم يوافق أو يرفض أو يعدّل.',
      problem: 'مبادئ أخلاقيات الذكاء الاصطناعي من سدايا تؤكد بقاء الإنسان في مركز القرار. والقرارات التي تمس حقوق الأفراد، مثل التمويل والتوظيف والتشخيص، لا ينبغي أن تُتخذ آلياً بالكامل.',
      features: ['إيقاف تلقائي للطلبات الحرجة', 'توجيه حسب الإدارة ونوع القرار', 'ثلاثة خيارات للمعتمد: موافقة، رفض، تعديل', 'سبب إلزامي مع كل قرار', 'تسجيل كل قرار في Ledger باسم المعتمد ووقت القرار'],
      example: 'الطلب ← Risk Engine (72 حرج) ← إيقاف وإشعار المعتمد\n      ← موافقة / رفض / تعديل ← تسجيل في Ledger ← الرد',
      why: 'المساءلة تحتاج اسماً. Human Gate يجعل لكل قرار حساس شخصاً معروفاً اعتمده، ووقتاً موثقاً، وسبباً مكتوباً.',
    },
    {
      slug: 'ledger', name: 'AIGAS Ledger', layer: 'كل الطبقات', plans: 'متاح في كل الباقات (Model Lineage في Enterprise فأعلى)',
      headline: 'سجل تقدر تحاسب عليه.',
      intro: 'كل طلب يمر عبر Kernel يُسجَّل في سجل يقبل الإضافة فقط. كل سجل يحمل بصمة تشفيرية مرتبطة بالسجل الذي قبله، فإذا عُدّل أي سجل انكسرت السلسلة وظهر التعديل فور التحقق.',
      problem: 'عندما يحدث خطأ، يأتي السؤال الأول دائماً: من أرسل ماذا، ومتى، ولأي نموذج، ومن وافق؟ أغلب الجهات لا تملك إجابة لأن الاستخدام يحدث في متصفحات الموظفين.',
      features: ['الوقت والمستخدم والإدارة', 'القالب المستخدم ودرجة المخاطر', 'أنواع البيانات التي حُجبت (بدون قيمها)', 'المزود والنموذج الذي رد', 'المعتمد البشري وقراره', 'Model Lineage: أي إصدار نموذج، وأي قالب، وأي سياسة كانت سارية', 'تصدير للمدققين والجهات الرقابية'],
      example: '2026-10-30T09:14:22Z  u-4821 / المالية\ntemplate: compliance   risk: 72 (critical)\nmasked: [IBAN]         model: groq/llama-3.3-70b-versatile\napproved_by: u-1103    hash: a3f9…c21e  prev: 7be0…91d4',
      why: 'مدة الاحتفاظ: 7 أيام في التجربة، و90 يوماً في Starter، وسنة في Business، و5 سنوات في Enterprise، وحسب سياستكم في Sovereign.',
    },
    {
      slug: 'secure-chat', name: 'AIGAS Secure Chat', layer: 'K1–K4', plans: 'متاح في كل الباقات',
      headline: 'أعطِ فريقك مساعداً يستخدمونه بدل الأدوات المجهولة.',
      intro: 'واجهة محادثة عربية وإنجليزية تمر عبر Kernel بالكامل، والرد يظهر كلمة بكلمة عبر البث المباشر. الموظف يعمل كما تعوّد، والحوكمة تحدث في الخلفية.',
      problem: 'منع أدوات الذكاء الاصطناعي لا ينجح غالباً، فالموظفون يلجؤون إلى حساباتهم الشخصية. الحل الأنجح أن تعطيهم بديلاً أفضل وآمناً.',
      features: ['تصميم يبدأ من العربية واتجاه RTL', 'بث مباشر للرد (SSE) مع مهلة 25 ثانية', 'قوالب جاهزة حسب المهمة، مثل الامتثال والتلخيص والصياغة', 'حذف سياق المحادثة تلقائياً بعد 10 دقائق', 'تحويل تلقائي بين المزودين عند الفشل'],
      example: 'event: token  data: "حسب"\nevent: token  data: " نظام"\nevent: token  data: " حماية البيانات..."\nevent: done   data: {"provider":"groq"}',
      why: 'كل محادثة تمر على Firewall وRisk Engine وتُسجَّل في Ledger، فلا يحتاج فريقك تدريباً على الحوكمة ليكون محكوماً.',
    },
  ].map(({ slug, ...p }) => ({ params: { product: slug }, props: p }));
}
const { name, layer, plans, headline, intro, problem, features, example, why } = Astro.props;
---
<PageShell title={`${name} — ${headline} | BRIGHTAI`} description={intro} crumbs={[{ name: 'المنتجات', href: '/products/' }, { name }]}>
  <p class="eyebrow" dir="ltr" style="text-align:right">{name} / {layer}</p>
  <h1>{headline}</h1>
  <p class="note">هذا المحتوى يصف التصور المستهدف للمنصة، ولا يثبت تشغيل القدرات أو التكاملات أو مدد الاحتفاظ المذكورة. المتاح هنا تجربة حجب توضيحية؛ يُحدد نطاق الخدمة والتزاماتها في اتفاق مكتوب.</p>
  <p class="lead">{intro}</p>
  <span class="tag">{plans}</span>
  <section class="block"><h2>المشكلة</h2><p>{problem}</p></section>
  <section class="block"><h2>ماذا يقدّم</h2><ul class="list">{features.map((f: string) => <li>{f}</li>)}</ul></section>
  <section class="block"><h2>مثال</h2><pre>{example}</pre><p class="note">بيانات افتراضية للتوضيح فقط.</p></section>
  <section class="block"><h2>لماذا يهم</h2><p>{why}</p>
    <div class="actions"><a class="button" href="/pricing/">الأسعار والباقات <span aria-hidden="true">←</span></a><a class="ghost" href="/kernel/">جرّب التجربة</a><a class="ghost" href="/products/">كل المنتجات</a></div>
  </section>
</PageShell>
