---
import PageShell from '../../components/PageShell.astro';
export const prerender = true;
export const products = [
  { slug: 'firewall', name: 'AIGAS Firewall', purpose: 'تصور منتج لفحص مدخلات ومخرجات الذكاء الاصطناعي بحثاً عن معلومات أو تعليمات قد تتطلب معالجة وفق سياسة المنشأة.', questions: ['ما فئات المعلومات التي تحتاج إلى ضوابط؟', 'كيف تُراجع نتيجة الفحص وحدودها؟', 'ما الإجراء عند اكتشاف مادة حساسة؟'] },
  { slug: 'risk-engine', name: 'AIGAS Risk Engine', purpose: 'تصور لتقييم مخاطر حالة الاستخدام وربطها بضوابط ومراجعات يحددها مالك المنشأة.', questions: ['من يحدد منهج التقييم ومعاييره؟', 'كيف تُوثق أسباب القرار؟', 'متى يُعاد التقييم؟'] },
  { slug: 'human-gate', name: 'AIGAS Human Gate', purpose: 'تصور لمسار مراجعة بشرية قبل اعتماد مخرجات محددة وفق سياسة الجهة، مع تحديد صاحب الصلاحية ومسار التصعيد.', questions: ['أي قرارات تتطلب مراجعة؟', 'من المخول بالاعتماد أو الرفض؟', 'كيف تسجل المراجعة والاعتراض؟'] },
  { slug: 'ledger', name: 'AIGAS Ledger', purpose: 'تصور لحفظ أدلة تشغيلية مرتبطة بالاستخدام والقرارات وفق ضوابط وصول واحتفاظ تعتمدها الجهة.', questions: ['ما الحد الأدنى اللازم من الأدلة؟', 'من يستطيع الاطلاع عليها؟', 'ما أساس ومدة الاحتفاظ المعتمدة؟'] },
  { slug: 'secure-chat', name: 'AIGAS Secure Chat', purpose: 'تصور لواجهة محادثة مؤسسية يمكن أن تخضع لسياسات اختيار الأدوات والمراجعة بعد إثبات البنية والتكاملات.', questions: ['ما الخدمات والنماذج التي ستُعتمد؟', 'ما إعدادات الحساب والعقد؟', 'كيف يتحقق الموظف من الإجابة؟'] },
];
export function getStaticPaths() { return products.map(({ slug, ...props }) => ({ params: { product: slug }, props })); }
const { name, purpose, questions } = Astro.props;
---
<PageShell title={`${name} — تصور المنتج | BRIGHTAI`} description={`${name}: وصف للتوجه والقدرات المستهدفة، مع توضيح أن الإتاحة التشغيلية غير متحققة.`} crumbs={[{ name: 'المنتجات', href: '/products/' }, { name }]}>
  <p class="eyebrow" dir="ltr" style="text-align:right">{name}</p>
  <h1>{name}</h1>
  <p class="tag">مخطط — الإتاحة التشغيلية غير متحققة</p>
  <p class="lead">{purpose}</p>
  <p class="note">هذه الصفحة تصف نطاقاً مستهدفاً وفق Blueprint، ولا تثبت وجود خدمة عاملة أو تكامل أو مستوى حماية أو اعتماد. لا توجد أسعار نهائية معتمدة. يُحدد أي عرض أو اتفاق بعد التحقق والمراجعة.</p>
  <section class="block"><h2>أسئلة يجب حسمها قبل الاستخدام</h2><ul class="list">{questions.map((question: string) => <li>{question}</li>)}</ul></section>
  <section class="block"><h2>مكان المنتج في التصور</h2><p>AIGAS Kernel مكوّن مشترك يوفر الحد الأدنى اللازم للمنتجات، ولا يُباع كمنتج مرخص مستقل. أما المنتجات الخمسة فتُصمم كوحدات مستقلة وظيفياً وتجارياً وفق الـBlueprint؛ وهذا لا يعني أنها متاحة حالياً.</p><div class="actions"><a class="button" href="/contact/">اطلب معلومات أو عرض سعر</a><a class="ghost" href="/products/">استعراض المنتجات</a></div></section>
</PageShell>
