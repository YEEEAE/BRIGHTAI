---
import ProductContentExtension from '../../components/ProductContentExtension.astro';
import PageShell from '../../components/PageShell.astro';
import ProductExperience from '../../components/ProductExperience.astro';
import ProductIcon from '../../components/ProductIcon.astro';
import LabShell from '../../components/LabShell.astro';
import { organization } from '../../data/organization';
export const prerender = true;
export const products = [
  { slug: 'firewall', name: 'AIGAS Firewall', purpose: 'تصور منتج لفحص مدخلات ومخرجات الذكاء الاصطناعي بحثاً عن معلومات أو تعليمات قد تتطلب معالجة وفق سياسة المنشأة.', questions: ['ما فئات المعلومات التي تحتاج إلى ضوابط؟', 'كيف تُراجع نتيجة الفحص وحدودها؟', 'ما الإجراء عند اكتشاف مادة حساسة؟'] },
  { slug: 'risk-engine', name: 'AIGAS Risk Engine', purpose: 'تصور لتقييم مخاطر حالة الاستخدام وربطها بضوابط ومراجعات يحددها مالك المنشأة.', questions: ['من يحدد منهج التقييم ومعاييره؟', 'كيف تُوثق أسباب القرار؟', 'متى يُعاد التقييم؟'] },
  { slug: 'human-gate', name: 'AIGAS Human Gate', purpose: 'تصور لمسار مراجعة بشرية قبل اعتماد مخرجات محددة وفق سياسة الجهة، مع تحديد صاحب الصلاحية ومسار التصعيد.', questions: ['أي قرارات تتطلب مراجعة؟', 'من المخول بالاعتماد أو الرفض؟', 'كيف تسجل المراجعة والاعتراض؟'] },
  { slug: 'ledger', name: 'AIGAS Ledger', purpose: 'تصور لحفظ أدلة تشغيلية مرتبطة بالاستخدام والقرارات وفق ضوابط وصول واحتفاظ تعتمدها الجهة.', questions: ['ما الحد الأدنى اللازم من الأدلة؟', 'من يستطيع الاطلاع عليها؟', 'ما أساس ومدة الاحتفاظ المعتمدة؟'] },
  { slug: 'secure-chat', name: 'AIGAS Secure Chat', purpose: 'تصور لواجهة محادثة مؤسسية يمكن أن تخضع لسياسات اختيار الأدوات والمراجعة بعد إثبات البنية والتكاملات.', questions: ['ما الخدمات والنماذج التي ستُعتمد؟', 'ما إعدادات الحساب والعقد؟', 'كيف يتحقق الموظف من الإجابة؟'] },
];
export function getStaticPaths() { return products.map(({ slug, ...props }) => ({ params: { product: slug }, props: { ...props, slug } })); }
const { name, purpose, questions, slug } = Astro.props;
const roles: Record<string,string> = { firewall: 'من الطلب إلى القرار', 'risk-engine': 'المخاطر في سياقها', 'human-gate': 'مراجعة لها صاحب صلاحية', ledger: 'لكل قرار أثر', 'secure-chat': 'محادثة ضمن حدود واضحة' };
const searchTopics: Record<string, string> = {
  firewall: 'جدار حماية الذكاء الاصطناعي',
  'risk-engine': 'تقييم مخاطر الذكاء الاصطناعي',
  'human-gate': 'الموافقات البشرية على قرارات AI',
  ledger: 'سجل تدقيق الذكاء الاصطناعي',
  'secure-chat': 'محادثة ذكاء اصطناعي مؤسسية',
};
const description = `${searchTopics[slug]} للمنشآت السعودية: ${purpose}`;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description,
  category: 'حوكمة وأمان الذكاء الاصطناعي',
  brand: { '@id': organization['@id'] },
  url: new URL(`/products/${slug}/`, 'https://brightai.live').href,
};
---
<PageShell title={`${searchTopics[slug]} | ${name} — BRIGHTAI`} description={description} crumbs={[{ name: 'المنتجات', href: '/products/' }, { name }]} structuredData={productSchema}>
  <LabShell kind={slug}><ProductExperience kind={slug}/></LabShell>
  <div class="product-intro" id="product-details">
    <div><p class="eyebrow"><bdi dir="ltr">AIGAS</bdi> / جرّب إمكانيات المنتج</p><h2><bdi dir="ltr">{name}</bdi></h2><p class="product-role">{roles[slug]}</p><p class="lead">{purpose}</p></div>
    <aside class="product-meta"><span class="product-mark"><ProductIcon kind={slug}/></span><div><p>منتج مستقل ضمن المنظومة</p><a class="ghost" href="/products/">كل المنتجات ←</a></div></aside>
  </div>
  <p class="note">استخدم بيانات اصطناعية في المختبر. راجع <a href="/trust/">حالة الأدلة التشغيلية</a> قبل مشاركة بيانات فعلية أو اعتماد المنتج.</p>
  <section class="block review-questions"><div><p class="eyebrow">قبل أي استخدام فعلي</p><h2>ثلاثة أسئلة<br/>تستحق المراجعة.</h2></div><ol>{questions.map((question: string) => <li>{question}</li>)}</ol></section>
  <section class="block"><h2>مكان المنتج في التصور</h2><p><bdi dir="ltr">AIGAS Kernel</bdi> مكوّن مشترك يوفر الحد الأدنى اللازم للمنتجات، ولا يُباع كمنتج مرخص مستقل. أما المنتجات الخمسة فتُصمم كوحدات مستقلة وظيفياً وتجارياً وفق الـBlueprint.</p></section>
  <ProductContentExtension kind={slug}/>
</PageShell>
