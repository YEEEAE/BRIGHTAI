---
import { organization, identityLimit } from '../data/organization';
import ContentExtension from '../components/ContentExtension.astro';
import PageShell from '../components/PageShell.astro';
export const prerender = true;
---
<PageShell title="عن BRIGHTAI | حوكمة وأمان الذكاء الاصطناعي" description="تعرف على توجه BRIGHTAI في حوكمة وأمان الذكاء الاصطناعي، وما هو مخطط وما لم يتم التحقق من تشغيله." crumbs={[{ name: 'عن BRIGHTAI' }]}>
  <p class="eyebrow">من نحن</p><h1>حوكمة وأمان الذكاء الاصطناعي</h1>
  <p class="lead">{organization.description}</p>
  <section class="block" aria-label="هوية الناشر"><h2>{organization.name}</h2><p>{organization.description}</p><a href={organization.url}>{organization.url}</a><p class="note">{identityLimit}</p></section>
  <p class="note">لا تؤكد هذه الصفحة الشكل القانوني للكيان أو حالة تشغيل المنتجات أو وجود اعتماد تنظيمي. هوية الكيان القانونية وتفاصيل الخدمات تحتاج إلى تحقق واعتماد من المالك.</p>
  <section class="block"><h2>هوية المشروع</h2><p>الاسم المتداول في مرجع المشروع هو «مؤسسة مُشرقة BRIGHT AI». ويُستخدم BRIGHTAI بصريًا في اسم الموقع والعلامة المختصرة؛ لا يغيّر اختلاف المسافة هذا الصيغة القانونية، التي لم تُثبت بمستند رسمي.</p><p>AIGAS اختصار <span lang="en">AI Governance &amp; Safety</span> واسم مجال العمل ومنظومة المنتجات، وليس اسم المؤسسة أو شهادة اعتماد.</p></section>
  <section class="block"><h2>ما الذي نعمل على تصميمه؟</h2><p>يتضمن التصور AIGAS Kernel كمكوّن مشترك وخمسة منتجات مستقلة وظيفيًا وتجاريًا وفق مرجع المشروع. لا تثبت صفحات الموقع وحدها جاهزية المنتجات للتشغيل أو توافرها للعملاء. يشرح <a href="/products/">مركز المنتجات</a> الفرق بين التصور والحالة المتحققة.</p></section>
  <section class="block"><h2>مبدأنا في المحتوى</h2><p>نوضح الفرق بين المتطلب والتصميم والتنفيذ المثبت. لا نقدم مواءمة تنظيمية أو شهادة أو ضماناً تشغيلياً ما لم توجد أدلة صالحة ومراجعة معتمدة.</p><p><a href="/docs/">تصفح مركز المعرفة</a></p><p><a href="/authors/">اطّلع على سجل الناشر والمساهمين</a></p></section>

    <ContentExtension>

<section><h2>كيف نعرض ما تحقق؟</h2><p>نربط أي وصف للتنفيذ بإصدار ونطاق ودليل يمكن مراجعته، مثل نتائج اختبار أو مثال اصطناعي أو مواصفة منشورة. ونوضح إن كان الدليل من تطوير محلي أو بيئة اختبار أو تشغيل فعلي؛ فلا تحل المحاكاة أو خطة العمل محل دليل تشغيل.</p><p>لا تنسب هذه الصفحة للمؤسسة عملاء أو نتائج أو شهادات أو شراكات غير موثقة. ويظل كل ادعاء عن منتج أو مواءمة تنظيمية مقيدًا بنطاق الدليل المنشور ومراجعته.</p></section>
<section><h2>ما الذي تعنيه حالات التوفر؟</h2><dl><dt>Available / متاح</dt><dd>وصف لا نستخدمه لمنتج دون دليل تشغيل ونطاق إصدار واضح.</dd><dt>Beta / تجريبي</dt><dd>يتطلب نسخة فعلية وحدوداً معلنة وموافقة مشاركة؛ المحاكاة التعليمية ليست Beta.</dd><dt>Planned / مخطط</dt><dd>متطلب أو تصميم لم تثبت إتاحته بعد؛ هذه هي الحالة المعلنة حالياً لمنتجات الموقع.</dd></dl><p><a href="/products/">تعرّف على المنتجات وأدوارها</a> أو <a href="/trust/">راجع حدود الأدلة المعلنة</a>.</p></section>
    </ContentExtension>
</PageShell>
