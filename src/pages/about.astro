---
import PageShell from '../components/PageShell.astro';
export const prerender = true;
const values = [
  ['الشفافية أولاً', 'ننشر أسعارنا، ونوضح حدود منتجنا، ونخبرك بما لا نستطيع فعله.'],
  ['الدقة لا الوعود', 'لا نقول «امتثال 100%». نقول ماذا يفعل كل ضابط بالضبط.'],
  ['السيادة', 'بياناتك تبقى تحت سيطرتك، وإذا أردت تبقى داخل جدرانك.'],
  ['الإنسان في مركز القرار', 'الذكاء الاصطناعي يساعد، والإنسان يقرر ويتحمل المسؤولية.'],
];
---
<PageShell title="من نحن — BRIGHTAI" description="BRIGHTAI شركة سعودية متخصصة في حوكمة وأمان الذكاء الاصطناعي، وتطور منصة AIGAS." crumbs={[{ name: 'من نحن' }]}>
  <p class="eyebrow">BRIGHTAI / من نحن</p>
  <h1>نؤمن بالذكاء الاصطناعي.<br /><span class="muted">ولهذا نصرّ على حوكمته.</span></h1>
  <p class="lead">BRIGHTAI شركة سعودية تبني أدوات وخدمات تساعد الجهات على استخدام الذكاء الاصطناعي بثقة: تحمي البيانات، وتوضح المسؤوليات، وتجعل كل قرار قابلاً للمراجعة.</p>
  <section class="block"><h2>لماذا بدأنا</h2><p>رأينا جهات تمنع الذكاء الاصطناعي خوفاً من التسريب فتخسر فائدته، وأخرى تفتحه بلا ضوابط فتتحمل مخاطرة لا تراها. أردنا طريقاً ثالثاً: ابتكار بحدود واضحة.</p></section>
  <section class="block"><h2>مهمتنا</h2><p>أن يكون كل استخدام للذكاء الاصطناعي في المملكة آمناً وشفافاً وقابلاً للمساءلة، دعماً لمستهدفات رؤية 2030 في بناء اقتصاد رقمي موثوق.</p></section>
  <section class="block"><h2>قيمنا</h2><div class="grid">{values.map(([t, d]) => <article class="card"><h3>{t}</h3><p>{d}</p></article>)}</div></section>
  <div class="actions" style="margin-top:48px"><a class="button" href="/contact/">تواصل معنا <span aria-hidden="true">←</span></a><a class="ghost" href="/trust/">مركز الثقة</a></div>
</PageShell>
