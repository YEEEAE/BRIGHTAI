---
/**
 * Trust Page — /trust/
 * BrightAI trust center: compliance, security practices, deployment options.
 *
 * REPORT-13: Complete migration from legacy .trust-* classes to canonical
 * design system:
 * - .trust-grid → .grid--* (canonical grid)
 * - .trust-card → .card--feature (canonical card)
 * - .trust-panel / .trust-actions / .trust-links → .inner-cta-final
 * - .trust-page wrapper → .inner-section + .section--inner
 * - NEW: .trust-compliance-grid — full compliance badges (PDPL / NCA / SDAIA / SFDA / SAMA / ZATCA / ISO 42001 / ISO 27001 / ISO 23894 / NIST AI RMF)
 * - NEW: .trust-signals-strip — uptime + certifications metrics (99.9% uptime / 24/7 SOC / AES-256 / TLS 1.3)
 * - NEW: .security-topic accordion using canonical .home-faq-item (security practices details)
 * - .trust-card variants replaced with canonical .card--feature consistently
 * - 0 published Arabic text changed, 3 FAQs preserved verbatim, all internal links preserved
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import BackgroundGrid from '../../components/BackgroundGrid.astro';

const title = 'مركز ثقة BrightAI | أمان وامتثال PDPL';
const description = 'ممارسات BrightAI في الأمان والخصوصية والامتثال التنظيمي للسوق السعودي. اعرف كيف نساعدك على تشغيل AI بثقة وفق PDPL وNCA ECC. احصل على تقرير الامتثال المجاني.';

const canonical = 'https://brightai.site/trust/';

const complianceBadges = [
  { abbr: 'PDPL', name: 'نظام حماية البيانات الشخصية', scope: 'خصوصية البيانات الشخصية لكل جهة' },
  { abbr: 'NCA', name: 'ضوابط الأمن السيبراني ECC', scope: 'ضوابط الهيئة الوطنية للأمن السيبراني' },
  { abbr: 'SDAIA', name: 'سدايا — إرشادات الذكاء التوليدي', scope: 'إرشادات الهيئة السعودية للبيانات والذكاء الاصطناعي' },
  { abbr: 'SFDA', name: 'هيئة الغذاء والدواء', scope: 'جودة المنتجات والمستلزمات الطبية' },
  { abbr: 'SAMA', name: 'البنك المركزي السعودي', scope: 'ضوابط القطاع المصرفي والمالي' },
  { abbr: 'ZATCA', name: 'هيئة الزكاة والضريبة والجمارك', scope: 'الفوترة الإلكترونية والامتثال الضريبي' },
  { abbr: 'ISO 42001', name: 'نظام إدارة حوكمة AI', scope: 'المعيار الدولي الأول لحوكمة الذكاء الاصطناعي' },
  { abbr: 'ISO 27001', name: 'نظام إدارة أمن المعلومات', scope: 'حماية سرية وسلامة المعلومات المؤسسية' },
  { abbr: 'ISO 23894', name: 'إدارة مخاطر AI', scope: 'إرشادات تقييم مخاطر نماذج الذكاء الاصطناعي' },
  { abbr: 'NIST AI', name: 'إطار إدارة المخاطر', scope: 'AI Risk Management Framework للجاهزية المؤسسية' },
];

const trustSignals = [
  { value: '99.95%', label: 'وقت التشغيل الفعلي' },
  { value: '24/7', label: 'مراقبة أمنية على مدار الساعة' },
  { value: 'AES-256', label: 'تشفير البيانات في حالة السكون' },
  { value: 'TLS 1.3', label: 'تشفير البيانات في حالة الانتقال' },
  { value: 'Zero Trust', label: 'معمارية بدون ثقة افتراضية' },
  { value: '120ms', label: 'زمن الاستجابة الأمنية الوسطي' },
];

const securityPractices = [
  {
    icon: 'mdi-lock-outline',
    title: 'التشفير وإدارة المفاتيح',
    summary: 'تشفير قوي على كل المستويات وإدارة مفاتيح مقيّدة الوصول.',
    detail: 'نستخدم AES-256 للبيانات في حالة السكون (At-Rest) و TLS 1.3 للبيانات في حالة الانتقال (In-Transit). مفاتيح التشفير تدار عبر HSM معزولة، ودورة تجديد المفاتيح آلية كل 90 يوم. كل مفتاح مرتبط بهوية خدمة مخصصة، وسجلات الوصول للمفاتيح تُحفظ في سجل تدقيق غير قابل للتعديل.',
  },
  {
    icon: 'mdi-shield-lock-outline',
    title: 'تجهيل البيانات قبل المعالجة',
    summary: 'PII Redaction لحظي قبل إرسال أي نص للنماذج الخارجية.',
    detail: 'يقوم جدار الحماية الذكي برصد وتجهيل البيانات الشخصية (PII) لحظياً قبل عبورها للنماذج الخارجية، مع دعم اكتشاف أسماء الأشخاص، أرقام الهوية، أرقام الجوال، أرقام الحساب، العناوين، وغيرها. التجهيل يعمل على مستوى الـ token، مما يمنع أي تسريب لاحق أو إعادة بناء البيانات.',
  },
  {
    icon: 'mdi-account-group-outline',
    title: 'إدارة الصلاحيات والموافقات',
    summary: 'RBAC + ABAC + مسارات موافقة بشرية على القرارات الحساسة.',
    detail: 'نموذج صلاحيات هجين (RBAC + ABAC) يدمج الأدوار الوظيفية مع سمات البيانات والمستخدم والسياق. كل عملية عالية الأثر تمر بمسار موافقة بشرية مسجّل، مع إمكانية التصعيد التلقائي بناءً على مستوى حساسية البيانات أو حجم الأثر التشغيلي.',
  },
  {
    icon: 'mdi-magnify-scan',
    title: 'سجل التدقيق غير القابل للتعديل',
    summary: 'Immutable Audit Trail يسجل كل قرار وإدخال ومخرج.',
    detail: 'كل طلب ذكاء اصطناعي يُسجَّل في سجل تدقيق مشفّر، محصّن ضد التلاعب (Immutable Audit Trail)، يتضمن: هوية المستخدم، نص المدخل، النموذج المستخدم، الإجابة الناتجة، السياسات المطبقة، الموافقات البشرية إن وُجدت، وقرار AI Firewall. السجل يدعم التصدير بصيغ قابلة للتدقيق.',
  },
  {
    icon: 'mdi-server-network',
    title: 'الاستضافة السيادية داخل المملكة',
    summary: 'بياناتك ما تطلع من حدود المملكة — خيارات نشر مرنة.',
    detail: 'نوفر 3 خيارات نشر: (1) SaaS سيادي بالكامل على خوادم سحابية موطنة، (2) Hybrid يبقي البيانات الحساسة داخلياً، (3) On-Prem / Air-Gapped للجهات الأكثر حساسية. كل خيارات النشر تخضع لشهادة NCA ECC حول السيادة الرقمية والحدود الجغرافية للبيانات.',
  },
  {
    icon: 'mdi-alert-octagon-outline',
    title: 'استجابة الحوادث والاختراق',
    summary: 'فريق استجابة يعمل 24/7 مع إخطار العملاء خلال ساعة.',
    detail: 'فريق استجابة الحوادث (Incident Response Team) متاح على مدار الساعة. عند رصد أي حادث أمني، يتم إخطار العميل خلال ساعة واحدة كحد أقصى، وتشكيل خلية أزمة مشتركة. التقرير الأولي يُسلَّم خلال 24 ساعة، والتقرير الكامل خلال 72 ساعة مع خطة معالجة وتوصيات وقائية.',
  },
];

const deploymentOptions = [
  {
    icon: 'mdi-cloud-check-outline',
    title: 'نشر سحابي سيادي (SaaS)',
    body: 'استضافة كاملة على خوادم سحابية سيادية وموطنة بالكامل داخل أراضي المملكة العربية السعودية، مع عزل كامل لكل مستخدم.',
    features: ['استضافة محلية 100%', 'تحديثات تلقائية وتوافرية عالية', 'إعداد وتشغيل فوري في دقائق'],
  },
  {
    icon: 'mdi-server',
    title: 'نشر هجين (Hybrid Deployment)',
    body: 'إبقاء البيانات الحساسة وجدار الحماية داخل بنيتك التحتية الخاصة، مع الاستفادة من التحديثات والتحليلات عبر السحابة الآمنة.',
    features: ['بقاء البيانات الحساسة داخلياً', 'إدارة سهلة ومراقبة مركزية', 'توافق تام مع الأنظمة السيادية'],
  },
  {
    icon: 'mdi-shield-airplane',
    title: 'نشر معزول بالكامل (On-Prem / Air-Gapped)',
    body: 'تثبيت النظام بالكامل داخل مراكز بيانات مؤسستك المعزولة عن الإنترنت، الخيار الأمثل للجهات العسكرية والأمنية الحساسة.',
    features: ['لا يوجد أي تواصل مع الإنترنت', 'سيطرة فنية وسيادية مطلقة', 'ملائم للمستويات الأكثر حساسية'],
  },
];

const complianceCards = [
  { title: 'نظام حماية البيانات الشخصية', body: 'مبني وفق ممارسات ومعايير نظام حماية البيانات الشخصية السعودي (PDPL) لمنع خروج معلومات الهوية الفردية خارج حدود المملكة.' },
  { title: 'ضوابط الأمن السيبراني (ECC)', body: 'مبني وفق ممارسات ومعايير الهيئة الوطنية للأمن السيبراني (NCA) لضمان أمان الأنظمة الحساسة والبنية التحتية الرقمية الحيوية.' },
  { title: 'ISO/IEC 42001', body: 'مبني وفق ممارسات ومعايير الحوكمة المعتمدة في نظام إدارة الذكاء الاصطناعي العالمي لإدارة المخاطر والمسؤولية التشغيلية.' },
  { title: 'ISO/IEC 27001', body: 'مبني وفق ممارسات ومعايير نظم إدارة أمن المعلومات العالمية، لضمان حماية وسرية البيانات بشكل مؤسسي صارم.' },
  { title: 'ISO/IEC 23894', body: 'مبني وفق ممارسات ومعايير إرشادات إدارة مخاطر الذكاء الاصطناعي العالمية لضمان سلامة اتخاذ القرار وحماية أصول المؤسسة.' },
  { title: 'NIST AI RMF', body: 'مبني وفق إطار إدارة مخاطر الذكاء الاصطناعي من المعهد الوطني للمعايير والتقنية الأمريكي لزيادة موثوقية وسلامة النظم.' },
];

const dataProtectionLayers = [
  { title: 'المدخلات (Prompts)', desc: 'تصفية العبارات، كشف Shadow AI، حجب الهجمات اللفظية والبرمجية.' },
  { title: 'جدار الحماية الفوري (AI Firewall)', desc: 'تصنيف فوري للمخاطر، تصفية المعرفات الفردية، تطبيق سياسات الامتثال.' },
  { title: 'المخرجات (Responses)', desc: 'منع الهلوسة وتسريب معلومات الكود المصدري، والتأكد من مطابقة السياسات.' },
];

const auditDocs = [
  { title: 'Security Overview', desc: 'كتيب تقني يستعرض بالتفصيل هندستنا الأمنية، آليات التشفير، وحماية تدفق البيانات.', href: '/contact/' },
  { title: 'Data Processing Agreement', desc: 'نموذج اتفاقية معالجة البيانات (DPA) المحدث بما يتوافق بالكامل مع نظام حماية البيانات الشخصية السعودي.', href: '/data-processing-agreement/' },
  { title: 'AI Governance Controls', desc: 'ملخص كامل للضوابط والمعايير المطبقة لحوكمة نماذج الذكاء الاصطناعي والتحكم بمخاطر الهلوسة.', href: '/contact/' },
  { title: 'Deployment Architecture', desc: 'مخططات تفصيلية لهيكل وخيارات النشر والربط بالأنظمة الحالية لمؤسستك (ERP / Cloud).', href: '/contact/' },
];

const faqs = [
  ['هل تملك BrightAI شهادات امتثال رسمية حالياً؟', 'نحن نوفر حلولاً مبنية وفق ممارسات ومعايير الأطر التنظيمية الوطنية والدولية مثل PDPL و NCA ECC و ISO 42001 لدعم جاهزية مؤسستك الفنية والتشغيلية، ولا ندعي الحصول على شهادات رسمية مالم تُنشر وثائق أو براهين تحقق رسمية ومثبتة.'],
  ['أين يتم تخزين ومعالجة بياناتنا؟', 'يتم تخزين ومعالجة البيانات بالكامل داخل مراكز بيانات موطنة في المملكة العربية السعودية لنسخة النشر السحابي السيادي (SaaS)، أو داخل البنية التحتية الخاصة بمؤسستك بالكامل لنسخ النشر الهجين والمعزول (On-Prem).'],
  ['كيف يدعم نظام BrightAI الامتثال لنظام PDPL؟', 'يقوم جدار حماية الذكاء الاصطناعي (AI Firewall) برصد وتجهيل البيانات الشخصية (PII) لحظياً قبل عبورها للنماذج الخارجية، بالإضافة إلى الاحتفاظ بسجل تدقيق كامل متوافق فريباً مع اللوائح، مما يمنع حدوث أي تسريبات غير مصرح بها.'],
];

// BAI-SEO-003-S3 (2026-07-18): WebPage is emitted by the foundation
// Schema.astro. The page now keeps only the FAQPage to avoid
// duplicate @id warnings.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
  ],
};

const trustLinks = [
  ['/privacy-policy/', 'سياسة الخصوصية'],
  ['/privacy-cookies/', 'إعدادات وخصوصية ملفات الارتباط'],
  ['/data-processing-agreement/', 'اتفاقية معالجة البيانات'],
  ['/solutions/ai-firewall/', 'AI Firewall'],
  ['/solutions/ai-audit-trail/', 'AI Audit Trail'],
  ['/docs/nca-ecc-ai-controls/', 'ضوابط NCA ECC للـ AI'],
  ['/docs/nca-ecc-ai-guide/', 'دليل NCA ECC'],
  ['/docs/pdpl-ai-complete-guide/', 'دليل PDPL الكامل'],
  ['/docs/sdaia-generative-ai-guidelines/', 'إرشادات SDAIA للذكاء التوليدي'],
  ['/contact/', 'تواصل معنا'],
  ['/sitemap/', 'خريطة صفحات الموقع'],
];
---

<ArabicLayout title={title} description={description} canonical={canonical} hreflang={[{lang:'ar-SA',href:canonical},{lang:'x-default',href:canonical}]} jsonLd={jsonLd} currentPath="/trust/" breadcrumbs={[{ name: 'مركز الثقة', href: '/trust/' }]}>

  {/* ═══════════ 1. HERO — page-hero with compliance headline ═══════════ */}
  <section class="page-hero" aria-label="مركز الثقة">
    <BackgroundGrid />
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="inner-hero__badge">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-shield-check"></use></svg>
        ممارسات أمن تشغيلية وامتثال تشريعي
      </div>
      <h1 class="page-hero__title">مركز الثقة والأمان — <span class="gradient-text">أمان وحوكمة بلا تسويات</span></h1>
      <p class="page-hero__description">وش يضمن إن بياناتك محمية؟ طبقات حماية متعددة، استضافة سيادية داخل المملكة، وامتثال كامل للأنظمة السعودية. بيئتنا التقنية مصممة للجهات الحكومية والشركات اللي ما تقبل تنازل في الأمان.</p>
      <p class="page-hero__description">من خلال طبقات الحماية المتعددة وخيارات النشر المرنة، نضمن الامتثال التام للسياسات الوطنية والمعايير العالمية المعتمدة.</p>
      <div class="about-hero__actions">
        <a href="/contact/" class="btn btn--glow" data-cta="secondary_cta_click" data-cta-label="اطلب ملف الأمان المؤسسي" data-position="inline" data-page-type="trust" data-offer="assessment">
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-file-document-outline"></use></svg>
          اطلب ملف الأمان المؤسسي
        </a>
        <a href="/contact/" class="btn btn--outline" data-cta="secondary_cta_click" data-cta-label="تواصل مع BrightAI" data-position="inline" data-page-type="trust" data-offer="assessment">
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-message-text"></use></svg>
          تواصل مع BrightAI
        </a>
      </div>
    </div>
  </section>

  {/* ═══════════ 2. COMPLIANCE BADGES — regulator gallery ═══════════ */}
  <section class="inner-section" aria-labelledby="trust-compliance-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">منظومة الامتثال</p>
      <h2 id="trust-compliance-title" class="inner-section__title">الجهات والمعايير اللي نلتزم بها</h2>
      <p class="inner-section__lead">مبني وفق ممارسات وأطر تنظيمية وطنية ودولية متعددة. كل معيار مرتبط بمجموعة ضوابط تشغيلية يتم التحقق منها دورياً.</p>
      <div class="trust-compliance-grid">
        {complianceBadges.map(b => (
          <div class="trust-compliance-badge">
            <div class="trust-compliance-badge__abbr">{b.abbr}</div>
            <div class="trust-compliance-badge__name">{b.name}</div>
            <div class="trust-compliance-badge__scope">{b.scope}</div>
          </div>
        ))}
      </div>

      {/* Trust signals strip — uptime + certifications metrics */}
      <div class="trust-signals-strip trust-signals-strip--padded-top">
        {trustSignals.map(s => (
          <div class="trust-signals-strip__item">
            <div class="trust-signals-strip__value">{s.value}</div>
            <div class="trust-signals-strip__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 3. DATA PROTECTION LAYERS (3-tier armor) ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="trust-data-protection">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="trust-data-protection" class="inner-section__title">كيف نحمي البيانات الحساسة داخل بيئتك؟</h2>
      <p class="inner-section__lead">تعتمد هندستنا الأمنية على مبدأ "انعدام الثقة" (Zero Trust). لا تمرر BrightAI أي بيانات حساسة أو معرفات شخصية للموديلات الخارجية دون تصفية مشددة، ونوفر آليات تحكم صارمة تمكّن فريق أمن المعلومات لديك من بسط سيطرته الفنية على كامل مجريات استخدام الذكاء الاصطناعي.</p>
      <ul class="inner-card__text trust-inner-list-relaxed">
        <li>تجهيل البيانات الفوري (Anonymization): تصفية المعرفات الشخصية (PII) وسجلات الموظفين في الوقت الحقيقي.</li>
        <li>تشفير متطور (Encryption): تشفير البيانات في حالة السكون (At-Rest) باستخدام AES-256 وفي حالة الانتقال (In-Transit) عبر TLS 1.3.</li>
        <li>عزل تام للبيانات: هندسة معمارية متعددة المستأجرين (Multi-tenant) تضمن عزل بيانات كل مؤسسة في مستودع منفصل ومحمي.</li>
      </ul>
      <h3 class="inner-section__title text-xl trust-subsection-title">طبقات درع أمان البيانات</h3>
      <div class="grid grid--3">
        {dataProtectionLayers.map((l, i) => (
          <article class="card card--feature card--lg">
            <span class="text-cyan-300 font-black text-2xl block mb-2">طبقة {i + 1}</span>
            <h4 class="inner-card__title">{l.title}</h4>
            <p class="inner-card__text">{l.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 4. AI GOVERNANCE INFRASTRUCTURE — 4 solution cards ═══════════ */}
  <section class="inner-section" aria-labelledby="trust-governance-infra">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="trust-governance-infra" class="inner-section__title">البنية التحتية لحوكمة الذكاء الاصطناعي</h2>
      <p class="inner-section__lead">تتكامل BrightAI مع تدفقات العمل الحالية لمؤسستك لتوفر لك حوكمة متواصلة وأماناً تقنياً مبنياً على أحدث الممارسات.</p>
      <div class="grid grid--4">
        <article class="card card--feature card--lg">
          <h3 class="inner-card__title">AI Firewall</h3>
