---
/**
 * /answer/[slug]/ — lightweight AEO answer pages for Saudi SERP.
 * Each page answers exactly ONE target query (EN or AR).
 *
 * ANSWER-TEMPLATE (2026-09-03): direct answer → why it matters in Saudi →
 * key points → source links → one next-step link. No marketing layout.
 * Data: src/data/answers.ts (source of truth). Arabic `answer` strings
 * are published content — never rewritten by the template.
 *
 * Schema: FAQPage + WebPage + BreadcrumbList + SpeakableSpecification.
 *
 * Architecture:
 *   - Dynamic route reads src/data/answers.ts (source of truth).
 *   - Zero client-side JS (static HTML). Zero client hydrations.
 *   - Scoped <style> block — no render-blocking external CSS.
 *
 * Accessibility:
 *   - <main> landmark, <h1> unique, heading hierarchy preserved.
 *   - prefers-reduced-motion respected. Touch targets ≥44px.
 */
import { getFaqLd } from '../../data/schema-helpers';
import type { FaqItem } from '../../data/schema-helpers';
import { answers, type AnswerUnit } from '../../data/answers';
import { getHreflangLinks } from '../../data/hreflang-pairs';

export function getStaticPaths() {
  return answers.map((a) => ({
    params: { slug: a.slug },
    props: { answer: a },
  }));
}

const { answer } = Astro.props as { answer: AnswerUnit };
const canonical = `https://brightai.live/answer/${answer.slug}/`;
const ENGLISH_ANSWER_SLUGS = new Set([
  'ai-governance-saudi-arabia',
  'ai-firewall-saudi',
  'pdpl-ai-compliance',
  'ai-safety-platform-enterprise',
  'saudi-ai-safety-os',
]);
const isEnglish = ENGLISH_ANSWER_SLUGS.has(answer.slug);
const hreflangLinks = isEnglish
  ? [{ lang: 'en-SA', href: canonical }, { lang: 'x-default', href: canonical }]
  : getHreflangLinks(canonical);

const faqItems: FaqItem[] = [{ q: answer.question, a: answer.answer }];
const faqLd = getFaqLd(faqItems);
const ownerCrumb = answer.furtherReading
  ? { name: answer.furtherReading.label, href: answer.furtherReading.href }
  : null;
const speakableSpec = {
  '@type': 'SpeakableSpecification',
  cssSelector: ['.answer-lead', '.answer-keypoints li'],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      url: canonical,
      name: answer.query,
      speakable: speakableSpec,
    },
    faqLd,
    ...(ownerCrumb
      ? [{
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://brightai.live/' },
            { '@type': 'ListItem', position: 2, name: ownerCrumb.name, item: `https://brightai.live${ownerCrumb.href}` },
            { '@type': 'ListItem', position: 3, name: answer.query, item: canonical },
          ],
        }]
      : []),
  ],
};
import SiteBackground from '../../components/SiteBackground.astro';
---
<!DOCTYPE html>
<html lang={isEnglish ? 'en' : 'ar'} dir={isEnglish ? 'ltr' : 'rtl'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Google tag (gtag.js) — OWNER REQUEST (2026-08-28): literal Google snippet,
        verbatim, same as BaseLayout. These standalone static pages have no
        Layout, so without this block the /answer/* pages would carry no GA4 tag. */}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9LMB4PGTWJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-9LMB4PGTWJ');
    </script>
    <title>{answer.question} | إجابات BrightAI</title>
    <meta name="description" content={answer.answer.slice(0, 155)} />
    {/* SEO (2026-08-23): explicit robots matches the site-wide BaseLayout
        policy — these standalone pages previously emitted no robots meta. */}
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    {hreflangLinks.map(({ lang, href }) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <SiteBackground />
    <main id="main-content" class="answer-page">
      {ownerCrumb && (
        <nav class="answer-breadcrumbs" aria-label="مسار التنقل">
          <a href="/">الرئيسية</a>
          <span aria-hidden="true">/</span>
          <a href={ownerCrumb.href}>{ownerCrumb.name}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{answer.query}</span>
        </nav>
      )}
      {/* 1 — Direct answer (speakable, first paint) */}
      <section class="answer-hero" aria-label="Answer">
        <h1 class="answer-hero__q">{answer.question}</h1>
        <p class="answer-lead">{answer.answer}</p>
      </section>

      {/* 2 — Why it matters in Saudi Arabia */}
      {answer.saudiNote && (
        <section class="answer-why" aria-label="ليش يهمك بالسعودية">
          <h2 class="answer-h2">ليش يهمك بالسعودية؟</h2>
          <p>{answer.saudiNote}</p>
        </section>
      )}

      {/* 3 — Key points */}
      {answer.keyPoints && answer.keyPoints.length > 0 && (
        <section class="answer-points" aria-label="أهم النقاط">
          <h2 class="answer-h2">أهم النقاط</h2>
          <ul class="answer-keypoints">
            {answer.keyPoints.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </section>
      )}

      {/* 4 — Source links */}
      {answer.sources && answer.sources.length > 0 && (
        <section class="answer-sources" aria-label="المصادر">
          <h2 class="answer-h2">المصادر</h2>
          <ul>
            {answer.sources.map((source) => (
              <li>
                {source.href.startsWith('http') ? (
                  <a href={source.href} rel="noopener noreferrer">{source.label}</a>
                ) : (
                  <a href={source.href}>{source.label}</a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* 5 — One next step (canonical owner + readiness check) */}
      {answer.furtherReading && (
        <section class="answer-next" aria-label="الخطوة الجاية">
          <p>
            للشرح الموسّع — <a href={answer.furtherReading.href}>{answer.furtherReading.label}</a>.
          </p>
          <p>
            <a href="/assessment/ai-governance-readiness/">قيّم جاهزية منشأتك في 5 دقائق →</a>
          </p>
        </section>
      )}
    </main>

    <style>
      /* BAI-BG-VIDEO-001 (2026-08-29): this page owns its own <html> shell, so it
         needs its own stacking rule — the fixed background layer sits at z-index 0
         and every other body child has to paint above it. */
      :global(body > *:not([aria-hidden='true'])) {
        position: relative;
        z-index: 2;
      }
      /* Mobile-first + RTL baseline for /answer/* pages (BAI-SAID-03). */
      .answer-breadcrumbs { display: flex; flex-wrap: wrap; gap: .45rem; max-width: 54rem; margin: 1rem auto 0; padding: 0 1rem; color: #64748b; font-size: .875rem; line-height: 1.7; }
      .answer-breadcrumbs a { color: #0f766e; text-decoration: none; }
      .answer-breadcrumbs a:hover, .answer-breadcrumbs a:focus-visible { color: #115e59; text-decoration: underline; }
      /* Page-specific layout — lightweight, single column */
      .answer-page {
        max-inline-size: 72ch;
        margin-inline: auto;
        padding-block: var(--space-8);
        padding-inline: var(--space-4);
      }
      .answer-hero {
        padding-block: var(--space-8);
        padding-inline: var(--space-6);
        background: var(--bg-surface);
        border-radius: var(--radius-lg);
        margin-block-end: var(--space-6);
      }
      .answer-hero__q {
        margin: 0 0 var(--space-3);
        font-size: var(--text-2xl);
        color: var(--text-primary);
      }
      .answer-lead {
        margin: 0;
        color: var(--text-secondary);
        line-height: 1.8;
      }
      .answer-h2 {
        margin: 0 0 var(--space-3);
        font-size: var(--text-xl);
        color: var(--text-primary);
      }
      .answer-why,
      .answer-points,
      .answer-sources {
        padding-block: var(--space-5);
        padding-inline: var(--space-6);
        margin-block-end: var(--space-4);
        background: var(--surface-on-media);
        border: 1px solid var(--surface-on-media-border);
        border-radius: var(--surface-on-media-radius);
        -webkit-backdrop-filter: var(--surface-on-media-blur);
        backdrop-filter: var(--surface-on-media-blur);
      }
      .answer-why p { margin: 0; color: var(--text-primary); line-height: 1.8; }
      .answer-keypoints { margin: 0; padding-inline-start: 1.25rem; color: var(--text-primary); line-height: 1.9; }
      .answer-keypoints li { margin-block-end: .35rem; }
      .answer-sources ul { margin: 0; padding-inline-start: 1.25rem; line-height: 2; }
      .answer-sources a { color: var(--interactive-primary); font-weight: 600; }
      .answer-next {
        padding-block: var(--space-4);
        padding-inline: var(--space-6);
        background: var(--bg-elevated);
        border-radius: var(--radius-md);
      }
      .answer-next p { margin: 0 0 .5rem; line-height: 1.8; color: var(--text-secondary); }
      .answer-next p:last-child { margin-block-end: 0; }
      .answer-next a {
        display: inline-block;
        min-height: 44px;
        line-height: 44px;
        color: var(--interactive-primary);
        font-weight: 600;
      }
      @media (prefers-reduced-transparency: reduce) {
        .answer-why, .answer-points, .answer-sources { background: var(--bg-surface); -webkit-backdrop-filter: none; backdrop-filter: none; }
      }
      @media print {
        .answer-why, .answer-points, .answer-sources { background: transparent; border-color: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; }
      }
    </style>
  </body>
</html>
