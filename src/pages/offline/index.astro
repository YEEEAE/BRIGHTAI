---
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import BackgroundGrid from '../../components/BackgroundGrid.astro';
---

<ArabicLayout
  title="BrightAI غير متصل | خيارات المتابعة"
  description="الاتصال بخدمات BrightAI غير متاح مؤقتاً. ارجع لاحقاً لاستعادة السياق والبيانات. خيارات متابعة واضحة أثناء فترة الانقطاع لمستخدمي حوكمة AI والامتثال بالسعودية. فريق الدعم متاح عبر واتساب."
  canonical="https://brightai.live/offline/"
  robots="noindex, follow"
  hreflang={[
    { lang: 'ar-SA', href: 'https://brightai.live/offline/' },
    { lang: 'x-default', href: 'https://brightai.live/offline/' },
  ]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'الاتصال مقطوع',
    url: 'https://brightai.live/offline/',
    inLanguage: 'ar-SA',
  }}
  currentPath="/offline/"
>
  <section class="inner-hero offline-page" aria-labelledby="offline-title">
    <BackgroundGrid />
    <div class="max-w-3xl mx-auto px-5 lg:px-8 text-center">
      <div class="offline-page__icon" aria-hidden="true">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-wifi-off"></use></svg>
      </div>
      <div class="inner-hero__badge">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-cloud-off-outline"></use></svg>
        وضع عدم الاتصال
      </div>
      <h1 id="offline-title">الاتصال مقطوع</h1>
      <p class="inner-hero__desc mx-auto">
        ما قدرنا نحمّل الصفحة. جرب مرة ثانية لما يرجع النت، أو ارجع للصفحة الرئيسية.
      </p>

      <div class="offline-page__note">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-archive-check-outline"></use></svg>
        <p>الصفحات اللي زرتها سابقًا قد تظل متاحة من الذاكرة المؤقتة.</p>
      </div>

      <div class="inner-hero__actions offline-page__actions">
        <button type="button" class="glow-btn offline-page__retry inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-refresh"></use></svg>
          حاول الاتصال من جديد
        </button>
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white border border-white/20">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-home-outline"></use></svg>
          الرئيسية
        </a>
      </div>
    </div>
  </section>

  <script>
    function initOfflineRetry() {
      const btn = document.querySelector('.offline-page__retry');
      if (!btn || btn.hasAttribute('data-retry-initialized')) return;

      btn.addEventListener('click', () => {
        window.location.reload();
      });

      btn.setAttribute('data-retry-initialized', 'true');
    }

    document.addEventListener('astro:page-load', initOfflineRetry);
  </script>

</ArabicLayout>
