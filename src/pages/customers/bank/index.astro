<!-- BAI-VOC-001-A (2026-07-18): VOC injection في title (suffix) + summary (5 ركائز: جرد AI، مالك مسؤول، سجل مخاطر، أدلة جاهزة للتدقيق، إشراف بشري). tone = "يدعم الجاهزية" لا "مضمون/كامل".

BAI-SEO-003-S1 (2026-07-18): page is an indexable case study, not a pre-purchase sample.
Decision documented in worklog.md under BAI-SEO-003-S1 → "Customer pages indexable policy".
Removed `robots="noindex"` (was being silently dropped by BaseLayout). Page is now
indexable + receives the standard ar-SA + x-default hreflang contract. -->
---
import ArabicLayout from '../../../layouts/ArabicLayout.astro';
import CaseStudy from '../../../components/CaseStudy.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: 'حالة استخدام: بنك سعودي رائد — حوكمة الذكاء الاصطناعي',
      description: 'كيف بنى بنك سعودي رائد حوكمة لاستخدامات الذكاء الاصطناعي عبر فروعه مع تقليل مخاطر Shadow AI وتسرب بيانات العملاء.',
      url: 'https://brightai.site/customers/bank/',
      inLanguage: 'ar-SA',
    },
  ],
};
---

<ArabicLayout
  title="حالة استخدام: بنك سعودي رائد | حوكمة الذكاء الاصطناعي"
  description="كيف بنى بنك سعودي رائد حوكمة لاستخدامات الذكاء الاصطناعي عبر فروعه مع تقليل مخاطر Shadow AI وتسرب بيانات العملاء."
  canonical="https://brightai.site/customers/bank/"
  hreflang={[{ lang: 'ar-SA', href: 'https://brightai.site/customers/bank/' }, { lang: 'x-default', href: 'https://brightai.site/customers/bank/' }]}
  jsonLd={jsonLd as any}
  currentPath="/customers/bank/"
  extraSpeakableSelectors={['aside[data-snippet="tl-dr"]']}
>
  <CaseStudy
    sector="مصرفي"
    breadcrumbLabel="بنك سعودي رائد"
    title="بنك سعودي رائد | حوكمة AI بجرد ومالك مسؤول"
    summary="البنك كان يوسّع استخدام أدوات الذكاء الاصطناعي عبر ١٢ فرعاً رقمياً، لكن ما كان عنده رؤية موحدة لوش تُستخدم الأدوات ووش البيانات تخرج منها. بنى على BrightAI حوكمة تغطي كل مخرجات النماذج مع تقليل مخاطر تسرب بيانات العملاء، عبر جرد AI شامل ومالك مسؤول للامتثال في كل فرع، وسجل مخاطر محدّث، وأدلة جاهزة للجهات التنظيمية (SAMA / NCA)، مع إشراف بشري على القرارات عالية المخاطر."
    metrics={[
      { value: '٩٤٪', label: 'انخفاض في حالات Shadow AI غير المرصودة' },
      { value: '١٠٠٪', label: 'تغطية لبيانات العملاء الحساسة ضمن التدقيق' },
      { value: '٢ أسبوع', label: 'الزمن لإطلاق أول لوحة تدقيق للامتثال' },
    ]}
    challenge="الفروع الرقمية كانت تستخدم عدة أدوات ذكاء اصطناعي لخدمة العملاء وتحليل المخاطر، لكن الفريق الأمني ما كان يملك رؤية موحدة: ما ينُشر من بيانات عملاء؟ وش السياسات المطبقة؟ ومن وافق على كل مخرج؟ غياب السجل الموحد جعل أي تدقيق داخلي أو خارجي عملية يدوية بطيئة."
    solutionPoints={[
      { title: 'رصد شامل لـ Shadow AI', body: 'تحديد كل الأدوات والنماذج المستخدمة عبر الفروع مع تصنيفها حسب مستوى الخطورة وحساسية البيانات.' },
      { title: 'جدار حماية للبيانات', body: 'منع خروج بيانات العملاء الحساسة إلى أدوات عامة مع مسار موافقة بشري مرن للحالات العالية الأثر.' },
      { title: 'سجل تدقيق غير قابل للتعديل', body: 'توثيق كل قرار وتفاعل في سجل تشغيلي مشفر يدعم جاهزية التدقيق أمام الجهات التنظيمية.' },
    ]}
    results={[
      'انخفاض ٩٤٪ في حالات استخدام الذكاء الاصطناعي غير المرصودة عبر الفروع.',
      'تغطية ١٠٠٪ لبيانات العملاء الحساسة ضمن سجل التدقيق.',
      'إطلاق أول لوحة امتثال للإدارة خلال أسبوعين بدل أشهر من العمل اليدوي.',
      'تقليل وقت الرد على طلبات التدقيق الداخلي من أيام إلى دقائق.',
    ]}
    quote={{ text: 'أول مرة نقدر نجاوب مفتش الامتثال بثانية: من استخدم AI، وش أرسل، وش السياسة اللي طُبقت، ومن وافق.', author: 'رئيس قطاع الامتثال — بنك سعودي رائد' }}
    nextSlug="hospital"
    nextTitle="مستشفى كبير"
  />
  {/* BAI-SEO-003-S7 (2026-07-18): P0 snippet pack — TL;DR / الخلاصة.
     Answer-first, self-contained, ≤60 words. Single source of truth:
     src/data/snippet-pack.ts. */}
  <aside data-snippet="tl-dr" aria-label="الخلاصة" class="answer-first-summary">
    <p>بنك سعودي رائد بنى حوكمة لاستخدامات الذكاء الاصطناعي عبر فروعه الرقمية مع التركيز على رصد أدوات الذكاء الاصطناعي غير المرصودة ومنع تسرب بيانات العملاء الحساسة. النتيجة انخفاض كبير في حالات الاستخدام غير المرصودة وتغطية كاملة لبيانات العملاء ضمن سجل التدقيق، ولوحة امتثال جاهزة في أسبوعين بدل أشهر من العمل اليدوي.</p>
  </aside>
  <section class="inner-section" aria-labelledby="cs-related-links">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="cs-related-links" class="inner-section__title">موارد ذات صلة</h2>
      <p>اطّلع على <a href="/solutions/banking-ai-governance/">حوكمة AI للقطاع المالي</a> و<a href="/solutions/banking-ai-governance/riyadh/">الرياض</a> أو اقرأ <a href="/customers/hospital/">حالة مستشفى كبير</a>.</p>
    </div>
  </section>
</ArabicLayout>
