---
import ArabicLayout from '../../../layouts/ArabicLayout.astro';
import CaseStudy from '../../../components/CaseStudy.astro';

const bankFaq = [
  {
    question: 'كيف يتوافق حل حوكمة الذكاء الاصطناعي مع ضوابط البنك المركزي السعودي (SAMA)؟',
    answer: 'تم تصميم BrightAI Kernel ليتوافق بدقة مع تعليمات البنك المركزي السعودي وإطار الأمن السيبراني للمؤسسات المالية؛ حيث يوفر سجلاً غير قابل للتعديل لجميع الاستعلامات والمخرجات، مع تطبيق مسارات مراجعة بشرية مشروطة على القرارات الائتمانية والتقييمات المالية.',
  },
  {
    question: 'كيف يتم منع تسرب أرقام الآيبان (IBAN) والحسابات البنكية؟',
    answer: 'يعمل جدار حماية الذكاء الاصطناعي (AI Firewall) على فحص النصوص محلياً قبل مغادرتها حدود البنك، ويقوم باكتشاف وتعمية أرقام الآيبان السعودية (SA...) والبطاقات الائتمانية والبيانات الشخصية تلقائياً لمنع خروجها لأي نموذج خارجي.',
  },
  {
    question: 'هل يمكن تشغيل النظام في بيئة محلية بالكامل (On-Premises)؟',
    answer: 'نعم، تدعم المنصة النشر الكامل داخل مراكز بيانات البنك المحلية أو السحابة السيادية الخاصة المعتمدة في المملكة العربية السعودية دون الحاجة لأي اتصال خارجي.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: 'حالة استخدام: بنك سعودي رائد — حوكمة الذكاء الاصطناعي في القطاع المصرفي',
      description: 'كيف بنى بنك سعودي رائد حوكمة لاستخدامات الذكاء الاصطناعي عبر فروعه مع تقليل مخاطر Shadow AI وتسرب بيانات العملاء والامتثال لضوابط SAMA وNCA.',
      url: 'https://brightai.live/customers/bank/',
      inLanguage: 'ar-SA',
    },
    {
      '@type': 'FAQPage',
      mainEntity: bankFaq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<ArabicLayout
  title="حالة استخدام: بنك سعودي رائد | حوكمة الذكاء الاصطناعي المصرفية"
  description="كيف بنى بنك سعودي رائد حوكمة لاستخدامات الذكاء الاصطناعي عبر فروعه مع تقليل مخاطر Shadow AI وتسرب بيانات العملاء والامتثال لـ SAMA وPDPL."
  canonical="https://brightai.live/customers/bank/"
  hreflang={[{ lang: 'ar-SA', href: 'https://brightai.live/customers/bank/' }, { lang: 'x-default', href: 'https://brightai.live/customers/bank/' }]}
  jsonLd={jsonLd as any}
  currentPath="/customers/bank/"
  extraSpeakableSelectors={['aside[data-snippet="tl-dr"]']}
  breadcrumbs={[{ name: 'عملاؤنا', href: '/customers/' }, { name: 'بنك سعودي رائد', href: '/customers/bank/' }]}
>
  <CaseStudy
    sector="القطاع المصرفي والمالي"
    breadcrumbLabel="بنك سعودي رائد"
    title="بنك سعودي رائد | حوكمة AI بجرد شامل وضوابط SAMA"
    summary="البنك كان يوسّع استخدام أدوات الذكاء الاصطناعي عبر 12 فرعاً رقمياً لخدمة العملاء وأتمتة العمليات، لكن واجه تحدي غياب الرؤية الموحدة لحركة البيانات. بنى على BrightAI حوكمة تغطي كل مخرجات النماذج مع تقليل مخاطر تسرب بيانات العملاء، عبر جرد AI شامل ومالك مسؤول للامتثال في كل فرع، وسجل مخاطر محدّث، وأدلة جاهزة للجهات التنظيمية (SAMA / NCA / سدايا)، مع إشراف بشري صارم على القرارات الائتمانية والمالية."
    metrics={[
      { value: '94%', label: 'انخفاض في حالات Shadow AI غير المرصودة' },
      { value: '100%', label: 'تغطية لبيانات العملاء الحساسة والآيبان' },
      { value: '2 أسبوع', label: 'الزمن لإطلاق أول لوحة تدقيق للامتثال' },
    ]}
    challenge="الفروع الرقمية كانت تستخدم عدة أدوات ذكاء اصطناعي لخدمة العملاء وتحليل المخاطر، لكن الفريق الأمني ما كان يملك رؤية موحدة: ما ينُشر من بيانات عملاء؟ وش السياسات المطبقة؟ ومن وافق على كل مخرج؟ غياب السجل الموحد جعل أي تدقيق داخلي أو خارجي عملية يدوية بطيئة تعرض البنك لمخاطر عدم الامتثال."
    solutionPoints={[
      { title: 'رصد شامل لـ Shadow AI', body: 'تحديد كل الأدوات والنماذج المستخدمة عبر الفروع مع تصنيفها حسب مستوى الخطورة وحساسية البيانات المالية.' },
      { title: 'جدار حماية البيانات المالية (AI Firewall)', body: 'منع خروج بيانات العملاء الحساسة والآيبان وأرقام البطاقات إلى أدوات عامة مع مسار موافقة بشري مرن للحالات العالية الأثر.' },
      { title: 'سجل تدقيق مشفر غير قابل للتعديل', body: 'توثيق كل قرار وتفاعل في سجل تشغيلي يدعم جاهزية التدقيق الفوري أمام مفتشي البنك المركزي وهيئة البيانات.' },
    ]}
    results={[
      'انخفاض 94% في حالات استخدام الذكاء الاصطناعي غير المرصودة عبر الفروع الرقمية.',
      'تغطية 100% لبيانات العملاء الحساسة وأرقام الحسابات ضمن سجل التدقيق الرقمي.',
      'إطلاق أول لوحة امتثال للإدارة العليا خلال أسبوعين بدل أشهر من الإجراءات اليدوية.',
      'تقليص وقت الرد على متطلبات التدقيق الداخلي والتنظيمي من أيام إلى دقائق معدودة.',
    ]}
    quote={{ text: 'أول مرة نقدر نجاوب مفتش الامتثال بثانية واحدة: من استخدم AI، وش أرسل، وش السياسة اللي طُبقت، ومن وافق عليها.', author: 'رئيس قطاع الامتثال ومخاطر التقنية — بنك سعودي رائد' }}
    nextSlug="hospital"
    nextTitle="مستشفى ومجمع طبي رائد"
  />

  <aside data-snippet="tl-dr" aria-label="الخلاصة" class="answer-first-summary">
    <p>بنك سعودي رائد بنى حوكمة متكاملة لاستخدامات الذكاء الاصطناعي عبر فروعه الرقمية، مما مكنه من القضاء على 94% من استخدامات Shadow AI، وحماية كافة بيانات العملاء المصرفية من التسرب، وتحقيق الجاهزية الكاملة لمتطلبات البنك المركزي السعودي (SAMA) ونظام حماية البيانات الشخصية (PDPL) في أسبوعين فقط.</p>
  </aside>

  <!-- تحليل تفصيلي لبيئة الامتثال المصرفي -->
  <section class="inner-section" aria-label="التحليل التقني والتنظيمي">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="card card--feature" style="padding: var(--space-6);">
        <h2 style="font-size: var(--text-2xl); color: var(--text-primary); margin-bottom: var(--space-3);">الهندسة المعمارية للامتثال المصرفي في السعودية</h2>
        <p style="color: var(--text-secondary); line-height: var(--leading-relaxed); font-size: var(--text-base); margin-bottom: var(--space-4);">
          يتطلب القطاع المالي في المملكة العربية السعودية معايير أمان سيبراني فائقة الصرامة وفق أطر <strong>الهيئة الوطنية للأمن السيبراني (NCA ECC)</strong> والبنك المركزي السعودي. قامت منصة BRIGHTAI بدمج موصلات ذكية تربط واجهات النماذج اللغوية مع أنظمة البنك الأساسية (Core Banking Systems) دون إتاحة أي وصول مباشر للبيانات الخام.
        </p>
        <div class="grid grid--3" style="gap: var(--space-4);">
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <h3 style="color: var(--text-primary); font-size: var(--text-base); margin-bottom: var(--space-2);">كشف وتعمية الآيبان التلقائي</h3>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">خوارزميات فحص محلية ترصد تركيب الآيبان السعودي (SA + 22 خانة) وتستبدله بترميز اصطناعي مشفر قبل المعالجة.</p>
          </div>
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <h3 style="color: var(--text-primary); font-size: var(--text-base); margin-bottom: var(--space-2);">الموافقات البشرية الائتمانية</h3>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">اشتراط موافقة ضابط ائتمان بشري معتمد على أي قرار تمويلي تقترحه النماذج الذكية لمنع التحيز.</p>
          </div>
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <h3 style="color: var(--text-primary); font-size: var(--text-base); margin-bottom: var(--space-2);">سجل التدقيق المشفر</h3>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">تسجيل سلاسل البيانات وربط كل عملية بختم رقمي فريد يمنع التلاعب بأدلة التدقيق التاريخية.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- أسئلة شائعة مصرفية -->
  <section class="inner-section inner-section--alt" aria-labelledby="bank-faq-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div style="max-width: 48rem; margin: 0 auto var(--space-6); text-align: center;">
        <h2 id="bank-faq-heading" style="font-size: var(--text-2xl); font-weight: var(--font-bold); color: var(--text-primary); margin-bottom: var(--space-2);">الأسئلة الشائعة حول حوكمة AI المصرفية</h2>
        <p style="color: var(--text-secondary); font-size: var(--text-base);">أهم التساؤلات التنظيمية والتقنية لمدراء المخاطر والامتثال في القطاع المصرفي.</p>
      </div>

      <div style="display: flex; flex-direction: column; gap: var(--space-3); max-width: 52rem; margin: 0 auto;">
        {
          bankFaq.map((item) => (
            <details class="card card--feature" style="padding: var(--space-4); cursor: pointer;">
              <summary style="font-weight: var(--font-bold); font-size: var(--text-base); color: var(--text-primary); list-style: none; display: flex; justify-content: space-between; align-items: center;">
                <span>{item.question}</span>
                <span style="color: var(--brand); font-size: 1.25rem;">+</span>
              </summary>
              <div style="margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--border-subtle); color: var(--text-secondary); line-height: var(--leading-relaxed); font-size: var(--text-sm);">
                {item.answer}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="inner-section" aria-labelledby="cs-related-links">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="cs-related-links" class="inner-section__title">موارد وحلول ذات صلة</h2>
      <p style="color: var(--text-secondary);">اطّلع على <a href="/solutions/banking-ai-governance/">منصة حوكمة AI للقطاع المالي</a> و<a href="/solutions/ai-firewall/">جدار حماية الذكاء الاصطناعي</a> أو اقرأ دراسة الحالة التالية: <a href="/customers/hospital/">حالة مستشفى كبير</a>.</p>
    </div>
  </section>
</ArabicLayout>
