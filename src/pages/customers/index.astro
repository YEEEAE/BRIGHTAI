---
/**
 * Customers Hub — /customers/
 * Showcases BrightAI outcomes via anonymized case studies.
 * Enriched with full Saudi AI governance context, keywords, and FAQ.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';

const caseStudies = [
  {
    slug: 'bank',
    sector: 'القطاع المصرفي والمالي',
    icon: 'mdi-bank',
    title: 'بنك سعودي رائد',
    summary: 'حوكمة استخدامات الذكاء الاصطناعي عبر 12 فرعاً رقمياً مع تقليل مخاطر تسرب بيانات العملاء إلى أدوات عامة والامتثال لضوابط البنك المركزي السعودي SAMA.',
    metric: '94%',
    metricLabel: 'انخفاض في حالات Shadow AI غير المرصودة',
  },
  {
    slug: 'hospital',
    sector: 'الرعاية الصحية والمستشفيات',
    icon: 'mdi-hospital-building',
    title: 'مستشفى ومجمع طبي رائد',
    summary: 'حماية بيانات المرضى والملفات السريرية في مخرجات النماذج اللغوية الكبيرة مع سجل تدقيق طبي غير قابل للتعديل يتوافق مع معايير وزارة الصحة وسدايا.',
    metric: '100%',
    metricLabel: 'تغطية لسجلات المرضى الحساسة ضمن التدقيق',
  },
  {
    slug: 'pharma',
    sector: 'صناعة الأدوية والبحوث',
    icon: 'mdi-flask',
    title: 'مصنع ومركز أبحاث أدوية',
    summary: 'امتثال لنظام حماية البيانات الشخصية (PDPL) وضوابط هيئة الغذاء والدواء (SFDA) في عمليات البحث والتطوير المدعومة بالذكاء الاصطناعي مع حفظ الأدلة التشغيلية.',
    metric: '3 أسابيع',
    metricLabel: 'الزمن للوصول إلى جاهزية تدقيق تنظيمي داخلي',
  },
];

const customerFaq = [
  {
    question: 'كيف تساعد BRIGHTAI شركات الذكاء الاصطناعي في السعودية والمؤسسات الكبرى؟',
    answer: 'توفر BRIGHTAI منصة حوكمة الذكاء الاصطناعي الأولى في السعودية التي تمكن الشركات من اكتشاف أدوات الذكاء الاصطناعي المستخدمة (Shadow AI)، وتطبيق ضوابط حماية البيانات الشخصية (PDPL)، وتفعيل جدار حماية الذكاء الاصطناعي (AI Firewall)، وتوليد سجل تدقيق تشغيلي يثبت الامتثال أمام الجهات الرقابية مثل سدايا (SDAIA) والهيئة الوطنية للأمن السيبراني (NCA).',
  },
  {
    question: 'ما هو دور منصة حوكمة الذكاء الاصطناعي في الامتثال لنظام حماية البيانات الشخصية (PDPL)؟',
    answer: 'تعمل المنصة كطبقة حماية تفصل بين مدخلات الموظفين ونماذج الذكاء الاصطناعي؛ حيث تقوم برصد وتعمية البيانات الشخصية الحساسة (مثل أرقام الهوية الوطنية، الآيبان، والبيانات الصحية) محلياً قبل وصولها إلى النماذج السحابية، مما يمنع تسريب البيانات ويحمي المنشأة من العقوبات النظامية.',
  },
  {
    question: 'هل تناسب حلول BRIGHTAI المتطلبات الأمنية الحساسة للقطاعين الحكومي والمصرفي؟',
    answer: 'نعم، تم تصميم معمارية BrightAI Kernel لتدعم النشر المحلي (On-Premises) أو السحابة الخاصة داخل المملكة العربية السعودية وفق تصنيفات الأمن السيبراني المعتمدة من NCA ECC ولوائح البنك المركزي السعودي (SAMA).',
  },
  {
    question: 'كيف يتم قياس عائد الاستثمار (ROI) من تطبيق حوكمة الذكاء الاصطناعي؟',
    answer: 'يتحقق العائد من خلال تجنب الغرامات النظامية التي قد تصل إلى ملايين الريالات نتيجة مخالفة نظام حماية البيانات الشخصية، وخفض زمن تدقيق الامتثال بنسبة تفوق 80%، وأتمتة مسارات المراجعة والموافقات البشرية، بالإضافة إلى حماية الأصول المعرفية والبيانات المالية الحساسة للمنشأة.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'عملاؤنا | قصص نجاح حوكمة الذكاء الاصطناعي في السعودية',
      description: 'قصص نجاح واقعية لمنشآت ومؤسسات سعودية استخدمت منصة BrightAI لحوكمة الذكاء الاصطناعي، حوكمة البيانات، والامتثال لـ PDPL وضوابط NCA ECC.',
      url: 'https://brightai.live/customers/',
      inLanguage: 'ar-SA',
    },
    {
      '@type': 'FAQPage',
      mainEntity: customerFaq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<ArabicLayout
  title="عملاؤنا | قصص نجاح حوكمة الذكاء الاصطناعي في السعودية"
  description="قصص نجاح واقعية لمنشآت ومؤسسات سعودية استخدمت BrightAI لحوكمة الذكاء الاصطناعي، حوكمة البيانات، والامتثال لنظام PDPL وضوابط NCA ECC وسدايا."
  canonical="https://brightai.live/customers/"
  hreflang={[{ lang: 'ar-SA', href: 'https://brightai.live/customers/' }, { lang: 'x-default', href: 'https://brightai.live/customers/' }]}
  jsonLd={jsonLd as any}
  currentPath="/customers/"
  breadcrumbs={[{ name: 'عملاؤنا', href: '/customers/' }]}
>

  <section class="page-hero" aria-label="عملاؤنا">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="inner-hero__badge">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-account-group"></use></svg>
        شراكات الثقة والتميز المؤسسي
      </div>
      <h1 class="page-hero__title"><span class="gradient-text">عملاؤنا يثقون</span> بمنصة حوكمة وأمان الذكاء الاصطناعي</h1>
      <p class="page-hero__description">تعتمد كبرى المنشآت المصرفية، الصحية، والصناعية في المملكة العربية السعودية على BRIGHTAI لبناء حوكمة تشغيلية متكاملة تضمن الامتثال التام لنظام حماية البيانات الشخصية (PDPL) وضوابط الأمن السيبراني الصادرة عن الهيئة الوطنية للأمن السيبراني (NCA) وهيئة البيانات والذكاء الاصطناعي (سدايا).</p>
    </div>
  </section>

  <section class="inner-section" aria-label="كيف تدعم BRIGHTAI المنشآت السعودية">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="card card--feature" style="padding: var(--space-6); border-inline-start: 4px solid var(--brand);">
        <h2 style="font-size: var(--text-2xl); margin-bottom: var(--space-3); color: var(--text-primary);">تمكين التحول الرقمي الآمن مع منصة حوكمة الذكاء الاصطناعي</h2>
        <p style="color: var(--text-secondary); line-height: var(--leading-relaxed); font-size: var(--text-base); margin-bottom: var(--space-4);">
          في ظل تسارع تبني <strong>تطبيقات الذكاء الاصطناعي</strong> ضمن مستهدفات رؤية السعودية 2030، تواجه الشركات والمؤسسات تحدياً مضاعفاً يتمثل في الاستفادة من حلول الذكاء الاصطناعي التوليدي دون المخاطرة بتسريب أسرار الأعمال أو انتهاك متطلبات <strong>حوكمة البيانات</strong> المحلية. تقدم BRIGHTAI كإحدى أبرز <strong>شركات الذكاء الاصطناعي في السعودية</strong> منظومة دفاعية وتنظيمية متكاملة تشمل <strong>جدار حماية الذكاء الاصطناعي (AI Firewall)</strong>، وسجل تدقيق القرارات غير القابل للتعديل، ومسارات الموافقة البشرية المشروطة لتقليل <strong>مخاطر الذكاء الاصطناعي</strong> إلى الحد الأدنى.
        </p>
        <div class="grid grid--3" style="gap: var(--space-4); margin-top: var(--space-4);">
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <strong style="color: var(--text-primary); display: block; margin-bottom: var(--space-2);">رصد Shadow AI</strong>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">جرد تلقائي لكافة أدوات الذكاء الاصطناعي المستخدمة داخل بيئة العمل المؤسسية وتصنيف خطورتها.</p>
          </div>
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <strong style="color: var(--text-primary); display: block; margin-bottom: var(--space-2);">حماية الخصوصية (PDPL)</strong>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">تعمية وحجب البيانات الشخصية الحساسة والهويات الوطنية قبل وصولها إلى نماذج LLM الخارجية.</p>
          </div>
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <strong style="color: var(--text-primary); display: block; margin-bottom: var(--space-2);">أدلة جاهزة للتدقيق</strong>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">توليد ملفات أدلة رقمية مشفرة بختم SHA-256 تثبت الامتثال أمام المراجعين والجهات الرقابية.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="inner-section" aria-labelledby="cs-grid-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div style="margin-bottom: var(--space-6);">
        <h2 id="cs-grid-title" class="inner-section__title">دراسات حالة وقصص نجاح قيادية في القطاعات السعودية</h2>
        <p class="inner-section__lead">حفاظاً على سرية بيانات عملائنا، تُنشر القصص التالية ببيانات مجهولة الهوية مع الحفاظ على دقة الأرقام والنتائج التشغيلية الموثقة.</p>
      </div>

      <div class="grid grid--3">
        {
          caseStudies.map((c) => (
            <article class="card card--feature card--lg">
              <div class="avatar-tile avatar-tile--sm avatar-tile--gradient" aria-hidden="true">
                <svg class="avatar-tile__icon" aria-hidden="true" width="1.5rem" height="1.5rem"><use href={`/icons.svg#${c.icon}`} /></svg>
              </div>
              <span class="assessment-tag">{c.sector}</span>
              <h3 class="inner-card__title mt-3">{c.title}</h3>
              <p class="inner-card__text">{c.summary}</p>
              <div class="assessment-result-preview">
                <span class="assessment-result-preview__label">{c.metricLabel}</span>
                <div class="assessment-result-preview__score">{c.metric}</div>
              </div>
              <a href={`/customers/${c.slug}/`} class="btn btn--glow btn--block mt-4">اقرأ دراسة الحالة الكاملة</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="inner-section inner-section--alt" aria-label="مقارنة الأثر التشغيلي لحوكمة الذكاء الاصطناعي">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div style="max-width: 48rem; margin: 0 auto var(--space-8); text-align: center;">
        <h2 style="font-size: var(--text-2xl); font-weight: var(--font-bold); color: var(--text-primary); margin-bottom: var(--space-3);">الأثر المؤسسي لمنظومة الحوكمة: قبل وبعد التنفيذ</h2>
        <p style="color: var(--text-secondary); font-size: var(--text-base);">مقارنة واقعية توضح كيف غيرت BRIGHTAI الواقع التشغيلي لإدارة مخاطر التقنية والامتثال في المنشآت المستفيدة.</p>
      </div>

      <div style="overflow-x: auto; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: var(--space-4);">
        <table style="width: 100%; border-collapse: collapse; text-align: start; font-size: var(--text-sm);">
          <thead>
            <tr style="border-bottom: 2px solid var(--border-subtle); background: var(--bg-surface-raised);">
              <th style="padding: var(--space-3); color: var(--text-primary);">المجال التشغيلي</th>
              <th style="padding: var(--space-3); color: #f87171;">قبل تطبيق BrightAI</th>
              <th style="padding: var(--space-3); color: #34d399;">بعد تطبيق BrightAI</th>
              <th style="padding: var(--space-3); color: var(--brand-300);">الأثر المحقق</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border-subtle);">
              <td style="padding: var(--space-3); font-weight: bold; color: var(--text-primary);">حماية البيانات والخصوصية</td>
              <td style="padding: var(--space-3); color: var(--text-muted);">تسرب محتمل لبيانات العملاء وأرقام الهوية إلى أدوات الذكاء الاصطناعي العامة دون مراقبة.</td>
              <td style="padding: var(--space-3); color: var(--text-secondary);">فحص فوري وتعصيب تلقائي لكافة عناصر PII والبيانات الشخصية وفق نظام PDPL.</td>
              <td style="padding: var(--space-3); color: var(--brand-400); font-weight: bold;">تغطية 100% وحماية كاملة من الغرامات</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-subtle);">
              <td style="padding: var(--space-3); font-weight: bold; color: var(--text-primary);">جاهزية التدقيق التنظيمي</td>
              <td style="padding: var(--space-3); color: var(--text-muted);">جمع يدوي مجهد للأدلة يستغرق أسابيع للإجابة عن أسئلة مفتشي الأمن السيبراني وسدايا.</td>
              <td style="padding: var(--space-3); color: var(--text-secondary);">سجل تدقيق فوري مشفر (Evidence File) يُنشئ تقارير الامتثال بضغطة زر واحدة.</td>
              <td style="padding: var(--space-3); color: var(--brand-400); font-weight: bold;">تقليص زمن التدقيق من 3 أسابيع إلى دقائق</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-subtle);">
              <td style="padding: var(--space-3); font-weight: bold; color: var(--text-primary);">إدارة المخاطر والاعتماد البشري</td>
              <td style="padding: var(--space-3); color: var(--text-muted);">اعتماد عشوائي للقرارات الآلية في خدمة العملاء والائتمان والتشخيص الطبي.</td>
              <td style="padding: var(--space-3); color: var(--text-secondary);">تفعيل حلقة الموافقة البشرية (Human-in-the-Loop) للقرارات عالية الخطورة آلياً.</td>
              <td style="padding: var(--space-3); color: var(--brand-400); font-weight: bold;">صفر أخطاء ذات أثر عالي غير معتمدة</td>
            </tr>
            <tr>
              <td style="padding: var(--space-3); font-weight: bold; color: var(--text-primary);">رؤية الإدارة وسجل المخاطر</td>
              <td style="padding: var(--space-3); color: var(--text-muted);">غياب الرؤية المركزية حول ما يستخدمه الموظفون من أدوات ذكاء اصطناعي (Shadow AI).</td>
              <td style="padding: var(--space-3); color: var(--text-secondary);">لوحة تحكم حية ترصد كافة النماذج والطلبات ومعدلات الخطورة ومؤشرات الأمان.</td>
              <td style="padding: var(--space-3); color: var(--brand-400); font-weight: bold;">انخفاض 94% في الاستخدامات غير المرصودة</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="inner-section" aria-labelledby="customers-faq-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div style="max-width: 48rem; margin: 0 auto var(--space-8); text-align: center;">
        <h2 id="customers-faq-heading" style="font-size: var(--text-2xl); font-weight: var(--font-bold); color: var(--text-primary); margin-bottom: var(--space-3);">الأسئلة الشائعة لمسؤولي التقنية والامتثال</h2>
        <p style="color: var(--text-secondary); font-size: var(--text-base);">إجابات مباشرة وواضحة عن تساؤلات الشركات السعودية حول تبني حوكمة الذكاء الاصطناعي ومتطلبات الامتثال التنظيمي.</p>
      </div>

      <div style="display: flex; flex-direction: column; gap: var(--space-4); max-width: 52rem; margin: 0 auto;">
        {
          customerFaq.map((item) => (
            <details class="card card--feature" style="padding: var(--space-5); cursor: pointer;">
              <summary style="font-weight: var(--font-bold); font-size: var(--text-lg); color: var(--text-primary); list-style: none; display: flex; justify-content: space-between; align-items: center;">
                <span>{item.question}</span>
                <span style="color: var(--brand); font-size: 1.25rem;">+</span>
              </summary>
              <div style="margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--border-subtle); color: var(--text-secondary); line-height: var(--leading-relaxed); font-size: var(--text-base);">
                {item.answer}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="inner-section inner-section--alt inner-section--centered" aria-labelledby="cs-cta">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="cs-cta" class="inner-section__title">هل ترغب في بناء قصة نجاح موثقة لمنشأتك؟</h2>
      <p class="inner-section__lead">تواصل مع خبرائنا في حوكمة وأمان الذكاء الاصطناعي لتحليل الفجوات وتقديم عرض عملي مخصص لقطاعك خلال 24 ساعة.</p>
      <div class="about-hero__actions about-hero__actions--centered">
        <div class="cta-actions">
          <a href="/contact/" class="btn btn--glow" data-cta="secondary_cta_click" data-cta-label="اطلب عرضاً مفصّلاً لقطاعك" data-position="inline" data-page-type="customers" data-offer="assessment">اطلب استشارة مجانية لقطاعك</a>
          <small class="cta-micro" aria-hidden="true">جلسة تحليل فجوات + توصيات امتثال مخصصة</small>
        </div>
        <div class="cta-actions">
          <a href="/assessment/ai-governance-readiness/" class="btn btn--whatsapp" data-cta="assessment_start" data-cta-label="ابدأ تقييم جاهزية AI" data-position="inline" data-page-type="customers">ابدأ تقييم جاهزية حوكمة الذكاء الاصطناعي</a>
          <small class="cta-micro" aria-hidden="true">20 دقيقة • تقرير فجوات تنفيذي بصيغة PDF</small>
        </div>
      </div>
    </div>
  </section>
</ArabicLayout>

<style>
  .assessment-tag {
    font-size: var(--text-xs);
    padding: 2px 10px;
    border-radius: var(--radius-lg);
    background: rgba(0, 212, 255, 0.08);
    border: 1px solid rgba(0, 212, 255, 0.25);
    color: var(--assessment-tag-color);
    display: inline-block;
    margin-block-start: var(--space-3);
  }
  .assessment-result-preview {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5);
    background: linear-gradient(135deg, rgba(0, 212, 255, 0.10), rgba(124, 92, 255, 0.08));
    border: 1px solid rgba(0, 212, 255, 0.25);
    border-radius: var(--radius-lg);
    margin-block-start: var(--space-4);
  }
  .assessment-result-preview__label {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
  .assessment-result-preview__score {
    font-size: var(--text-4xl);
    font-weight: var(--font-extrabold);
    color: var(--brand-300);
    line-height: 1;
  }
  .mt-4 { margin-block-start: var(--space-4); }

  .avatar-tile--gradient {
    background: linear-gradient(135deg, var(--cyan-bright), var(--accent-purple-deep));
  }
  .avatar-tile--gradient .avatar-tile__icon { color: var(--white); }
</style>
