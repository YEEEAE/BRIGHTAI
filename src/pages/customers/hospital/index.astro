---
import ArabicLayout from '../../../layouts/ArabicLayout.astro';
import CaseStudy from '../../../components/CaseStudy.astro';

const hospitalFaq = [
  {
    question: 'كيف يتم حماية بيانات المرضى الصحية والسريرية من التسرب للذكاء الاصطناعي؟',
    answer: 'تقوم طبقة حماية الخصوصية في BrightAI بفحص كل طلب قبل إرساله للنماذج، وتتعرف على أرقام السجلات الطبية (MRN)، وأسماء المرضى، والتشخيصات الحساسة، وتقوم بإخفائها أو استبدالها ببيانات وهمية مشفرة محلياً.',
  },
  {
    question: 'هل تتوافق المنصة مع معايير وزارة الصحة السعودية ونظام حماية البيانات الشخصية (PDPL)؟',
    answer: 'نعم، تم إعداد سياسات الحوكمة لتطابق متطلبات نظام PDPL للبيانات الصحية الحساسة ولائحة المركز الوطني للمعلومات الصحية، مع توليد سجلات تدقيق تثبت عدم خروج بيانات المرضى خارج الخوادم الوطنية المصرحة.',
  },
  {
    question: 'ما هو دور التدقيق البشري في القرارات والتوصيات السريرية؟',
    answer: 'تمنع المنصة اعتماد أي توصية علاجية أو تشخيصية صادرة عن الذكاء الاصطناعي دون مراجعة وتوقيع إلكتروني موثق من الطبيب الاستشاري المعالج، مما يحفظ المسؤولية الطبية ويمنع الأخطاء العلاجية.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: 'حالة استخدام: مستشفى كبير — حماية بيانات المرضى والامتثال الصحي في الذكاء الاصطناعي',
      description: 'كيف نجح مستشفى سعودي رائد في حماية سجلات المرضى والامتثال لنظام PDPL عند توظيف الذكاء الاصطناعي في الأبحاث والعمليات السريرية.',
      url: 'https://brightai.live/customers/hospital/',
      inLanguage: 'ar-SA',
      // TECH-SEO-09 (2026-09-10): completed with truthful values only —
      // site OG image (real asset), Organization author (no invented person),
      // git-verified publish/modified dates.
      image: 'https://brightai.live/assets/images/og/brightai-og-1200x630.png',
      author: { '@type': 'Organization', '@id': 'https://brightai.live/#organization' },
      datePublished: '2026-07-08',
      dateModified: '2026-09-10',
    },
    {
      '@type': 'FAQPage',
      mainEntity: hospitalFaq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<ArabicLayout
  title="حالة استخدام: مستشفى كبير | حماية بيانات المرضى وحوكمة الذكاء الاصطناعي"
  description="كيف نجح مستشفى ومجمع طبي سعودي في حماية سجلات المرضى والامتثال لـ PDPL وتوفير سجل تدقيق سريري غير قابل للتعديل مع BrightAI."
  canonical="https://brightai.live/customers/hospital/"
  hreflang={[{ lang: 'ar-SA', href: 'https://brightai.live/customers/hospital/' }, { lang: 'x-default', href: 'https://brightai.live/customers/hospital/' }]}
  jsonLd={jsonLd as any}
  currentPath="/customers/hospital/"
  extraSpeakableSelectors={['aside[data-snippet="tl-dr"]']}
  breadcrumbs={[{ name: 'عملاؤنا', href: '/customers/' }, { name: 'مستشفى كبير', href: '/customers/hospital/' }]}
>
  <CaseStudy
    sector="الرعاية الصحية والطبية"
    breadcrumbLabel="مستشفى كبير"
    title="مستشفى ومجمع طبي رائد | حماية بيانات المرضى وحوكمة الذكاء الاصطناعي"
    summary="المستشفى كان يستعين بنماذج الذكاء الاصطناعي لتلخيص التقارير السريرية وتفريغ الملاحظات الطبية، لكن كان يواجه خطورة بالغة في تسريب بيانات المرضى الحساسة ونظام حماية البيانات الشخصية (PDPL). مع منصة BrightAI، تم تفعيل جدار حماية آلي يمنع خروج المعرفات الطبية، مع تدقيق بنسبة 100% لكل مدخل ومخرج، وسجل تدقيق سريري مشفر يدعم التحقق من القرارات الطبية. (مثال توضيحي بأرقام تقريبية، وليس نتائج عميل موثق.)"
    metrics={[
      { value: '100%', label: 'تغطية لسجلات المرضى الحساسة ضمن التدقيق' },
      { value: 'صفر', label: 'حوادث تسرب بيانات صحية خارج المنشأة' },
      { value: '70%', label: 'تقليص زمن كتابة التقارير الطبية السريرية' },
    ]}
    challenge="احتاج الأطباء والباحثون إلى استخدام الذكاء الاصطناعي لتحليل الأشعة وصياغة تقارير الخروج، ولكن كانت السجلات تحتوي على أسماء المرضى، أرقام الهوية، والسجل الدوائي. أي انتهاك للخصوصية يعرض المستشفى لعقوبات نظامية وغرامات كبرى وفق نظام PDPL، مع صعوبة متابعة عشرات الاستخدامات اليومية يدوياً."
    solutionPoints={[
      { title: 'تعمية المعرفات الصحية الحساسة (Medical PII Redaction)', body: 'عزل أرقام الملفات الطبية وأسماء المرضى واستبدالها بمعرفات مشفرة فورياً قبل إرسال النصوص لنماذج الذكاء الاصطناعي.' },
      { title: 'حلقة التحقق والموافقة السريرية المشروطة', body: 'إلزامية مراجعة واعتماد الطبيب المعالج لأي ملخص طبي صادر عن النماذج الذكية قبل دمجه في الملف الإلكتروني.' },
      { title: 'سجل تدقيق صحي مشفر للأدلة', body: 'حفظ سجل كامل لكل مسودة وتعديل واعتماد مع بصمة زمنية مشفرة بـ SHA-256 للمطابقة مع متطلبات سدايا ووزارة الصحة.' },
    ]}
    results={[
      'حماية كاملة 100% لسجلات المرضى وبيانات الهوية من التسرب إلى نماذج الذكاء الاصطناعي الخارجية.',
      'صفر مخالفات لنظام حماية البيانات الشخصية (PDPL) خلال عمليات التدقيق التنظيمية الدورية.',
      'تسريع صياغة التقارير السريرية وتفريغ الملاحظات بنسبة 70% دون التفريط في معايير الأمان.',
      'امتلاك سجل أدلة رقمي معتمد يثبت التزام المستشفى بأخلاقيات الذكاء الاصطناعي المسؤولة.',
    ]}
    quote={{ text: 'الذكاء الاصطناعي ساعدنا نسرّع خدمة المرضى، لكن منصة BrightAI هي اللي عطتنا راحة البال والاطمئنان القانوني والأخلاقي.', author: 'مدير المعلوماتية الطبية — مستشفى سعودي رائد' }}
    nextSlug="pharma"
    nextTitle="مصنع أدوية"
  />

  <aside data-snippet="tl-dr" aria-label="الخلاصة" class="answer-first-summary">
    <p>مستشفى سعودي رائد قام بتطبيق منصة BrightAI لحوكمة الذكاء الاصطناعي، ونجح في حماية 100% من بيانات وسجلات المرضى الشخصية، وألغى تماماً مخاطر تسرب البيانات الصحية، وسرّع كتابة التقارير الطبية بنسبة 70% مع الالتزام الكامل بنظام حماية البيانات الشخصية السعودي (PDPL).</p>
  </aside>

  <!-- تفاصيل حوكمة البيانات الصحية -->
  <section class="inner-section" aria-label="حوكمة البيانات الصحية">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="card card--feature" style="padding: var(--space-6);">
        <h2 style="font-size: var(--text-2xl); color: var(--text-primary); margin-bottom: var(--space-3);">حماية الخصوصية الطبية وامتثال PDPL في الرعاية الصحية</h2>
        <p style="color: var(--text-secondary); line-height: var(--leading-relaxed); font-size: var(--text-base); margin-bottom: var(--space-4);">
          تُصنف البيانات الصحية في المملكة كبيانات حساسة ذات أثر فائق الحرج وفق <strong>نظام حماية البيانات الشخصية</strong>. تضمن BrightAI للمستشفيات والمراكز السريرية العمل بأمان تام عبر معمارية الحماية متعددة الطبقات.
        </p>
        <div class="grid grid--3" style="gap: var(--space-4);">
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <h3 style="color: var(--text-primary); font-size: var(--text-base); margin-bottom: var(--space-2);">فحص التشخيصات السريرية</h3>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">كشف فوري للأمراض والبيانات الجينية واستبعاد ربطها بالهويات الوطنية للأفراد.</p>
          </div>
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <h3 style="color: var(--text-primary); font-size: var(--text-base); margin-bottom: var(--space-2);">الاستقلالية وعدم التدريب</h3>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">ضمان عقدي وتقني يمنع مزودي النماذج من استخدام البيانات الصحية في إعادة تدريب نماذجهم.</p>
          </div>
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <h3 style="color: var(--text-primary); font-size: var(--text-base); margin-bottom: var(--space-2);">التكامل مع EHR / EMR</h3>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">ربط آمن عبر واجهات API مع أنظمة السجلات الطبية الإلكترونية المعتمدة في المملكة.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- أسئلة شائعة صحية -->
  <section class="inner-section inner-section--alt" aria-labelledby="hosp-faq-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div style="max-width: 48rem; margin: 0 auto var(--space-6); text-align: center;">
        <h2 id="hosp-faq-heading" style="font-size: var(--text-2xl); font-weight: var(--font-bold); color: var(--text-primary); margin-bottom: var(--space-2);">الأسئلة الشائعة حول حوكمة AI في المستشفيات</h2>
        <p style="color: var(--text-secondary); font-size: var(--text-base);">توضيحات هامة لقيادات الرعاية الصحية وضباط حماية البيانات الشخصية.</p>
      </div>

      <div style="display: flex; flex-direction: column; gap: var(--space-3); max-width: 52rem; margin: 0 auto;">
        {
          hospitalFaq.map((item) => (
            <details class="card card--feature" style="padding: var(--space-4); cursor: pointer;">
              <summary style="font-weight: var(--font-bold); font-size: var(--text-base); color: var(--text-primary); list-style: none; display: flex; justify-content: space-between; align-items: center;">
                <span>{item.question}</span>
                <span style="color: var(--brand); font-size: 1.25rem;">+</span>
              </summary>
              <div style="margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--border-subtle); color: var(--text-secondary); line-height: var(--leading-relaxed); font-size: var(--text-sm);">
                {item.answer}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="inner-section" aria-labelledby="cs-related-links">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="cs-related-links" class="inner-section__title">موارد وحلول ذات صلة</h2>
      <p style="color: var(--text-secondary);">استكشف <a href="/solutions/healthcare-ai-governance/">حوكمة AI للقطاع الصحي</a> ودليل <a href="/docs/pdpl-ai-governance/">الامتثال لنظام PDPL</a> أو اقرأ دراسة الحالة التالية: <a href="/customers/pharma/">حالة مصنع أدوية</a>.</p>
    </div>
  </section>
</ArabicLayout>
