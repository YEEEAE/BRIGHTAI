<!-- BAI-VOC-001-A (2026-07-18): VOC injection في title (suffix) + summary (5 ركائز: جرد AI، مالك مسؤول، سجل مخاطر، أدلة جاهزة للتدقيق، إشراف بشري). tone = "يدعم الجاهزية" لا "مضمون/كامل".

BAI-SEO-003-S1 (2026-07-18): page is an indexable case study, not a pre-purchase sample.
Decision documented in worklog.md under BAI-SEO-003-S1 → "Customer pages indexable policy".
Removed `robots="noindex"` (was being silently dropped by BaseLayout). Page is now
indexable + receives the standard ar-SA + x-default hreflang contract. -->
---
import ArabicLayout from '../../../layouts/ArabicLayout.astro';
import CaseStudy from '../../../components/CaseStudy.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: 'حالة استخدام: مستشفى كبير — حماية بيانات المرضى في مخرجات الذكاء الاصطناعي',
      description: 'كيف يبني مستشفى كبير حماية لبيانات المرضى ضمن استخدامات النماذج اللغوية الكبيرة مع سجل تدقيق طبي غير قابل للتعديل.',
      url: 'https://brightai.site/customers/hospital/',
      inLanguage: 'ar-SA',
    },
  ],
};
---

<ArabicLayout
  title="حالة استخدام: مستشفى كبير | حماية بيانات المرضى"
  description="كيف يبني مستشفى كبير حماية لبيانات المرضى ضمن استخدامات النماذج اللغوية الكبيرة مع سجل تدقيق طبي غير قابل للتعديل."
  canonical="https://brightai.site/customers/hospital/"
  hreflang={[{ lang: 'ar-SA', href: 'https://brightai.site/customers/hospital/' }, { lang: 'x-default', href: 'https://brightai.site/customers/hospital/' }]}
  jsonLd={jsonLd as any}
  currentPath="/customers/hospital/"
  extraSpeakableSelectors={['aside[data-snippet="tl-dr"]']}
  breadcrumbs={[{ name: 'عملاؤنا', href: '/customers/' }, { name: 'مستشفى كبير', href: '/customers/hospital/' }]}
>
  <CaseStudy
    sector="صحي"
    breadcrumbLabel="مستشفى كبير"
    title="مستشفى كبير | حوكمة AI بسجل مخاطر وإشراف بشري"
    summary="المستشفى استخدم النماذج اللغوية الكبيرة في تحليل التقارير الطبية ودعم القرار السريري، لكن حماية بيانات المرضى كانت التحدي الأكبر. بنى على BrightAI سجلاً تشغيلياً يغطي كل مخرجات الذكاء الاصطناعي، مع جرد AI للأدوات السريرية، ومالك مسؤول للقرارات الطبية، وسجل مخاطر محدّث، وأدلة جاهزة للمدققين (SFDA / CBAHI)، وإشراف بشري من المختصين على التوصيات الحساسة."
    metrics={[
      { value: '١٠٠٪', label: 'تغطية لسجلات المرضى الحساسة ضمن التدقيق' },
      { value: '٠', label: 'حالات تسرب بيانات مرضى مؤكدة بعد التطبيق' },
      { value: '٣ أسابيع', label: 'الزمن للوصول إلى جاهزية تدقيق داخلي' },
    ]}
    challenge="الأطباء والإداريون كانوا يستخدمون أدوات ذكاء اصطناعي لتبسيط التقارير ودعم القرار، لكن بدون ضوابط واضحة كانت بيانات المرضى (أسماء، تشخيصات، نتائج) قد تخرج إلى أدوات خارجية. أي تسرب يشكّل مخالفة لـ PDPL وأضراراً بالسمعة."
    solutionPoints={[
      { title: 'كشف بيانات المرضى آلياً', body: 'تصنيف وتحديد البيانات الصحية الحساسة قبل وبعد خروج مخرجات النموذج مع منع التسريب التلقائي.' },
      { title: 'مسار موافقة سريري', body: 'ربط القرارات عالية الأثر بموافقة بشريّة من المختصين مع توثيق السبب والسياسة المطبقة.' },
      { title: 'سجل تدقيق طبي', body: 'حفظ كل تفاعل في سجل مشفر غير قابل للتعديل يدعم التفتيش الصحي والتنظيمي.' },
    ]}
    results={[
      'تغطية ١٠٠٪ لسجلات المرضى الحساسة ضمن سجل التدقيق التشغيلي.',
      'صفر حالات تسرب بيانات مؤكدة بعد تفعيل الجدار الوقائي.',
      'جاهزية تدقيق داخلي خلال ٣ أسابيع بدل مشاريع امتثال ممتدة.',
      'ثقة أعلى من الأطباء باستخدام الأدوات بعد ما عرفوا إن بياناتهم محمية.',
    ]}
    quote={{ text: 'صرنا نستفيد من الذكاء الاصطناعي في دعم القرار بدون ما نقلق من تسرب ملف المريض. هذا غير شكل العمل السريري عندنا.', author: 'مدير تقنية المعلومات — مستشفى كبير' }}
    nextSlug="pharma"
    nextTitle="مصنع أدوية"
  />
  {/* BAI-SEO-003-S7 (2026-07-18): P0 snippet pack — TL;DR / الخلاصة.
     Answer-first, self-contained, ≤60 words. Single source of truth:
     src/data/snippet-pack.ts. */}
  <aside data-snippet="tl-dr" aria-label="الخلاصة" class="answer-first-summary">
    <p>مستشفى كبير بنى حوكمة لاستخدامات النماذج اللغوية في تحليل التقارير ودعم القرار. ركز على حماية بيانات المرضى ومنع خروجها إلى أدوات خارجية. النتيجة تغطية كاملة لسجلات المرضى الحساسة ضمن سجل التدقيق التشغيلي، وصفر حالات تسرب مؤكدة بعد تفعيل الجدار الوقائي، وجاهزية تدقيق داخلي خلال ثلاثة أسابيع.</p>
  </aside>
  <section class="inner-section" aria-labelledby="cs-related-links">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="cs-related-links" class="inner-section__title">موارد ذات صلة</h2>
      <p>اطّلع على <a href="/solutions/healthcare-ai-governance/">حوكمة AI للرعاية الصحية</a> و<a href="/solutions/healthcare-ai-governance/jeddah/">جدة</a> أو اقرأ <a href="/customers/pharma/">حالة مصنع أدوية</a>.</p>
    </div>
  </section>
</ArabicLayout>
