---
import ArabicLayout from '../../../layouts/ArabicLayout.astro';

const dimensions = [
  ['inventory', 'حصر الاستخدامات', 'هل عندكم قائمة محدثة بأدوات وحالات استخدام AI؟'],
  ['ownership', 'الملكية والمسؤوليات', 'هل كل استخدام مهم له مالك واضح؟'],
  ['risk', 'إدارة المخاطر', 'هل تراجعون المخاطر قبل الاستخدامات عالية الأثر؟'],
  ['policy', 'السياسات', 'هل عندكم سياسة واضحة لاستخدام الذكاء الاصطناعي؟'],
  ['data', 'البيانات والخصوصية', 'هل تعرفون البيانات المسموح إدخالها لكل استخدام؟'],
  ['approvals', 'الموافقات', 'هل توجد مراجعة بشرية للقرارات عالية الأثر؟'],
  ['evidence', 'التسجيل والأدلة', 'هل تقدرون تثبتون كيف ولماذا اتخذت القرارات؟'],
  ['monitoring', 'المراقبة', 'هل تراجعون الاستخدامات والمخاطر والتغييرات دوريًا؟'],
];
const groups = [
  { title: 'الصورة الحالية', helper: 'وش تستخدمون ومن المسؤول؟', ids: ['inventory', 'ownership'] },
  { title: 'القرار والسياسة', helper: 'كيف تُدار المخاطر والقواعد التشغيلية؟', ids: ['risk', 'policy'] },
  { title: 'البيانات والاعتمادات', helper: 'وش حدود البيانات ومتى يتدخل الإنسان؟', ids: ['data', 'approvals'] },
  { title: 'الأدلة والاستمرار', helper: 'كيف تثبتون وتراجعون عمل الحوكمة؟', ids: ['evidence', 'monitoring'] },
];
const answers = [['established', 'مطبق وواضح'], ['partial', 'موجود جزئيًا أو غير ثابت'], ['not_started', 'ما بدأنا فيه']];
const faqs = [
  ['هل هذا التقييم شهادة أو موافقة من جهة تنظيمية؟', 'لا. هذا فحص إرشادي من BrightAI يساعدكم ترتبون نقاش الجاهزية. ما يمنح شهادة، ولا يثبت امتثالًا، ولا يحل محل مراجعة قانونية أو تنظيمية.'],
  ['وش أحصل عليه بعد الإجابة؟', 'بتشوف ملخصًا وصفيًا يفصل نقاط القوة والفجوات وخطوات ضبط مقترحة. ما نطلع درجة رقمية ولا نزعم منهجية تنظيمية معتمدة.'],
  ['هل تُرسل إجاباتي لكم؟', 'لا. الأسئلة والنتيجة تُعالج داخل متصفحك. التحليلات تقيس مسار الاستخدام على مستوى الحدث فقط، بدون نص الإجابات أو بيانات شخصية.'],
];
const jsonLd = { '@context': 'https://schema.org', '@graph': [{ '@type': 'WebPage', name: 'تقييم جاهزية حوكمة الذكاء الاصطناعي للشركات السعودية', url: 'https://brightai.live/assessment/ai-governance-readiness/', description: 'تقييم إرشادي لحوكمة الذكاء الاصطناعي للمؤسسات السعودية يغطي الاستخدامات والملكية والمخاطر والسياسات والبيانات والموافقات والأدلة والمراقبة.', inLanguage: 'ar-SA' }] };
---

<ArabicLayout title="تقييم جاهزية حوكمة AI للمؤسسات السعودية | BrightAI" description="فحص إرشادي لحوكمة الذكاء الاصطناعي: الاستخدامات، الملكية، المخاطر، السياسات، البيانات، الموافقات، الأدلة والمراقبة. نتائج وصفية على جهازك بدون شهادة أو ادعاء امتثال." canonical="https://brightai.live/assessment/ai-governance-readiness/" hreflang={[{lang:'ar-SA',href:'https://brightai.live/assessment/ai-governance-readiness/'},{lang:'x-default',href:'https://brightai.live/assessment/ai-governance-readiness/'}]} jsonLd={jsonLd as any} currentPath="/assessment/ai-governance-readiness/" breadcrumbs={[{ name: 'تقييم الجاهزية', href: '/assessment/ai-governance-readiness/' }]}>
  <section class="page-hero assessment-hero" aria-labelledby="assessment-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8 assessment-hero__grid">
      <div>
        <p class="inner-section__label">فحص إرشادي للمؤسسات السعودية</p>
        <h1 id="assessment-title" class="page-hero__title"><span class="gradient-text">قيّم جاهزية حوكمة AI</span><br />قبل ما تكبر المخاطر</h1>
        <p class="page-hero__description">هذا التقييم مناسب لقادة التقنية والمخاطر والبيانات والامتثال اللي يبغون صورة مشتركة عن استخدامات الذكاء الاصطناعي داخل مؤسستهم. جاوب على 8 محاور تشغيلية وخذ ملخصًا واضحًا لنقاط القوة والفجوات وأول الضوابط المقترحة.</p>
        <aside data-snippet="tl-dr" aria-label="الخلاصة" class="answer-first-summary"><p>تقييم جاهزية حوكمة الذكاء الاصطناعي من BrightAI هو فحص إرشادي يغطي الحصر والملكية والمخاطر والسياسات والبيانات والموافقات والأدلة والمراقبة. تظهر النتيجة في متصفحك كنقاط قوة وفجوات وخطوات تالية؛ ليست شهادة أو موافقة تنظيمية أو حكم امتثال.</p></aside>
        <p class="inner-section__label">آخر تحديث: 2026-08-24</p>
      </div>
      <aside class="assessment-trust-card" aria-label="حدود التقييم وخصوصيته">
        <strong>واضح من البداية</strong>
        <ul><li>بدون درجة رقمية أو ادعاء منهجية معتمدة.</li><li>بدون طلب اسم أو إيميل أو بيانات حساسة.</li><li>إجاباتك تبقى داخل متصفحك.</li></ul>
        <a href="#assessment" class="btn btn--glow btn--lg" data-cta="assessment_start_click" data-cta-label="ابدأ تقييم الجاهزية" data-position="hero" data-page-type="ai-governance-readiness" data-offer="assessment">ابدأ التقييم</a>
      </aside>
    </div>
  </section>

  <section class="inner-section" aria-labelledby="assessment-source-title"><div class="max-w-6xl mx-auto px-5 lg:px-8"><p class="inner-section__label">المصدر الرسمي</p><h2 id="assessment-source-title" class="inner-section__title">التقييم يرتب الحوار؛ النص الرسمي يحدد ما ينطبق</h2><p class="inner-section__lead">استخدم <a href="https://dgp.sdaia.gov.sa/" target="_blank" rel="noopener noreferrer">منصة حوكمة البيانات الوطنية التابعة لسدايا</a> والنصوص الرسمية ذات الصلة لتحديد المتطلبات التي تنطبق على جهتك. محاور التقييم الثمانية لا تحول الإرشاد العام إلى حكم تنظيمي آلي.</p><h3>متطلب أو إرشاد رسمي</h3><p>راجع المرجع الرسمي والقطاع ونطاق البيانات قبل اعتماد أي قرار امتثال.</p><h3>منهج BrightAI للتنفيذ</h3><p>الأسئلة الثمانية قالب تشخيصي من BrightAI يجمع الصورة التشغيلية، ولا يمنح شهادة أو رأيًا قانونيًا.</p><ol><li>اجمع الاستخدامات والملاك.</li><li>حدد المخاطر والبيانات والضوابط.</li><li>وثّق الفجوات والخطوة التالية.</li></ol></div></section>

  <section id="assessment" class="inner-section inner-section--alt" aria-labelledby="assessment-form-title">
    <div class="max-w-4xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">8 محاور · 4 مراحل</p><h2 id="assessment-form-title" class="inner-section__title">خلنا نرتب الصورة مع بعض</h2>
      <p class="inner-section__lead">اختر الوصف الأقرب لواقعكم اليوم. النتيجة تساعدكم تبدأون نقاشًا مرتبًا مع الفريق، وليست تدقيقًا أو قرارًا تنظيميًا.</p>
      <form data-readiness-assessment class="assessment-form" novalidate>
        <p data-assessment-status class="sr-only" aria-live="polite"></p>
        <progress data-assessment-progress class="assessment-progress" max="4" value="1">الخطوة 1 من 4</progress>
        <div data-assessment-error class="assessment-error" role="alert" tabindex="-1" hidden></div>
        {groups.map((group, groupIndex) => (
          <fieldset data-assessment-group class="assessment-group">
            <legend tabindex="-1"><span>المرحلة {groupIndex + 1}</span>{group.title}</legend><p>{group.helper}</p>
            {group.ids.map((id) => {
              const dimension = dimensions.find(([dimensionId]) => dimensionId === id)!;
              return <div class="assessment-question"><h3>{dimension[1]}</h3><p>{dimension[2]}</p><div class="assessment-options">{answers.map(([value, label]) => <label><input type="radio" name={id} value={value} required /><span>{label}</span></label>)}</div></div>;
            })}
          </fieldset>
        ))}
        <div class="assessment-actions"><button data-assessment-back type="button" class="btn btn--secondary btn--lg" hidden>السابق</button><button data-assessment-next type="button" class="btn btn--glow btn--lg">حفظ والانتقال للمرحلة التالية</button><button data-assessment-submit type="submit" class="btn btn--glow btn--lg" hidden>اعرض ملخص الجاهزية</button></div>
      </form>
    </div>
  </section>

  <section data-assessment-results class="inner-section assessment-results" aria-labelledby="results-title" hidden>
    <div class="max-w-6xl mx-auto px-5 lg:px-8"><p class="inner-section__label">ملخصك الإرشادي</p><h2 id="results-title" class="inner-section__title" tabindex="-1">من وين تبدأون؟</h2><p class="inner-section__lead">هذا تلخيص من إجاباتكم فقط؛ راجعوه مع أصحاب المصلحة قبل اعتماد أي قرار أو ادعاء امتثال.</p>
      <div class="grid grid--3 assessment-results__grid"><article class="card card--feature assessment-result assessment-result--strength"><h3>نقاط قوة معلنة</h3><ul data-result-strengths></ul></article><article class="card card--feature assessment-result assessment-result--gap"><h3>فجوات تحتاج نقاش</h3><ul data-result-gaps></ul></article><article class="card card--feature assessment-result assessment-result--control"><h3>ضوابط تالية مقترحة</h3><ul data-result-controls></ul></article></div>
      <div class="assessment-results__cta"><h3>تبي تحوّل الملخص لخطة مناسبة لنطاقكم؟</h3><p>احجز جلسة استكشافية مع الفريق. نبدأ من واقع استخداماتكم ونوضح نطاق العمل قبل أي التزام.</p><a href="/contact/" class="btn btn--glow btn--lg" data-cta="assessment_completion_cta" data-cta-label="احجز جلسة استكشافية" data-position="results" data-page-type="ai-governance-readiness" data-offer="assessment">احجز جلسة استكشافية</a></div>
    </div>
  </section>

  <section class="inner-section" aria-labelledby="dimensions-title"><div class="max-w-7xl mx-auto px-5 lg:px-8"><p class="inner-section__label">وش يغطي التقييم؟</p><h2 id="dimensions-title" class="inner-section__title">ثمانية محاور للحوار العملي</h2><p class="inner-section__lead">المحاور ظاهرة قبل بدء النموذج عشان يقدر فريقك يراجعها ويشارك الإجابة على نفس الفهم.</p><div class="grid grid--4">{dimensions.map(([, title, description]) => <article class="card card--feature"><h3 class="inner-card__title">{title}</h3><p class="inner-card__text">{description}</p></article>)}</div></div></section>

  <section class="inner-section inner-section--alt" aria-labelledby="receive-title"><div class="max-w-6xl mx-auto px-5 lg:px-8"><p class="inner-section__label">بعد الإكمال</p><h2 id="receive-title" class="inner-section__title">وش تستلم من التقييم؟</h2><div class="grid grid--3"><article class="card card--feature"><h3 class="inner-card__title">ملخص مباشر</h3><p class="inner-card__text">تقسيم واضح بين النقاط المعلنة كنقاط قوة والفجوات التي تحتاج مراجعة.</p></article><article class="card card--feature"><h3 class="inner-card__title">خطوات ضبط مبدئية</h3><p class="inner-card__text">توصيات تشغيلية عامة تربط كل فجوة بإجراء أول قابل للنقاش.</p></article><article class="card card--feature"><h3 class="inner-card__title">طريق لجلسة أعمق</h3><p class="inner-card__text">لو احتجت، تقدر تحجز جلسة لاستكشاف النطاق؛ بدون وعود شهادة أو موافقة تنظيمية.</p></article></div><p class="inner-section__lead">وقبل التقييم أو بعده، يفيدك تعبئة <a href="/tools/ai-risk-register/">قالب سجل مخاطر AI</a> — يجمع الاستخدامات والتصنيف والضوابط والأدلة بجدول واحد يسهل نقاشه مع الفريق.</p></div></section>

  <section class="inner-section" aria-labelledby="faq-title"><div class="max-w-4xl mx-auto px-5 lg:px-8"><p class="inner-section__label">أسئلة مهمة</p><h2 id="faq-title" class="inner-section__title">قبل ما تبدأ</h2><div class="inner-faq" role="list">{faqs.map(([question, answer], index) => <details class="card card--glass home-faq-item" role="listitem" open={index === 0}><summary><span>{question}</span><svg class="home-faq-chevron" aria-hidden="true" width="1.25em" height="1.25em"><use href="/icons.svg#mdi-chevron-down"></use></svg></summary><div class="home-faq-answer"><p>{answer}</p></div></details>)}</div></div></section>
  <script is:inline type="module" src="/js/ai-governance-readiness.js"></script>
</ArabicLayout>

<style>
.assessment-hero__grid{display:grid;gap:var(--space-6);align-items:center}.assessment-trust-card{background:color-mix(in srgb,var(--surface-2) 88%,transparent);border:1px solid var(--border);border-radius:var(--radius-xl);padding:var(--space-6);box-shadow:var(--shadow-lg)}.assessment-trust-card strong{color:var(--brand-200);font-size:var(--text-lg)}.assessment-trust-card ul{margin:var(--space-4) 0;padding-inline-start:var(--space-5);display:grid;gap:var(--space-3)}.assessment-form{display:grid;gap:var(--space-5)}.assessment-progress{width:100%;height:12px;accent-color:var(--brand-400)}.assessment-group{border:1px solid var(--border);border-radius:var(--radius-xl);padding:clamp(1rem,4vw,2rem);background:var(--surface-1)}.assessment-group legend{padding-inline:var(--space-2);color:var(--text-primary);font-size:var(--text-xl);font-weight:800}.assessment-group legend span{color:var(--brand-300);margin-inline-end:var(--space-2);font-size:var(--text-sm)}.assessment-group>p,.assessment-question p{color:var(--text-muted)}.assessment-question{border-block-start:1px solid var(--border);margin-block-start:var(--space-5);padding-block-start:var(--space-5)}.assessment-question h3{margin:0}.assessment-options{display:grid;gap:var(--space-3)}.assessment-options label{min-height:48px;display:flex;align-items:center;gap:var(--space-3);border:1px solid var(--border);border-radius:var(--radius-md);padding:var(--space-3) var(--space-4);cursor:pointer}.assessment-options label:has(input:checked){border-color:var(--brand-300);background:color-mix(in srgb,var(--brand-500) 12%,transparent)}.assessment-options input{inline-size:20px;block-size:20px;accent-color:var(--brand-400)}.assessment-options label:focus-within,.assessment-group legend:focus,.assessment-results h2:focus{outline:3px solid var(--focus-ring);outline-offset:4px}.assessment-actions{display:flex;flex-wrap:wrap;gap:var(--space-3);justify-content:space-between}.assessment-error{border-inline-start:4px solid var(--danger-400);background:color-mix(in srgb,var(--danger-500) 13%,transparent);border-radius:var(--radius-md);padding:var(--space-4)}.assessment-result{border-block-start:4px solid var(--brand-300)}.assessment-result--gap{border-block-start-color:var(--danger-400)}.assessment-result--control{border-block-start-color:var(--accent-400)}.assessment-result ul{padding-inline-start:var(--space-5);display:grid;gap:var(--space-3)}.assessment-results__cta{text-align:center;margin-block-start:var(--space-8);padding:var(--space-7);border-radius:var(--radius-xl);background:var(--surface-2)}.assessment-results__cta p{color:var(--text-muted);max-inline-size:60ch;margin-inline:auto;margin-block:var(--space-3) var(--space-5)}@media(min-width:900px){.assessment-hero__grid{grid-template-columns:1.5fr .75fr}.assessment-options{grid-template-columns:repeat(3,1fr)}}@media(prefers-reduced-motion:reduce){.assessment-results{scroll-behavior:auto}}
</style>
