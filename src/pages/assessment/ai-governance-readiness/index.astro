---
import ArabicLayout from '../../../layouts/ArabicLayout.astro';

const dimensions = [
  ['inventory', 'حصر الاستخدامات', 'هل عندكم قائمة محدثة بأدوات وحالات استخدام AI؟'],
  ['ownership', 'الملكية والمسؤوليات', 'هل كل استخدام مهم له مالك واضح؟'],
  ['risk', 'إدارة المخاطر', 'هل تراجعون المخاطر قبل الاستخدامات عالية الأثر؟'],
  ['policy', 'السياسات', 'هل عندكم سياسة واضحة لاستخدام الذكاء الاصطناعي؟'],
  ['data', 'البيانات والخصوصية', 'هل تعرفون البيانات المسموح إدخالها لكل استخدام؟'],
  ['approvals', 'الموافقات', 'هل توجد مراجعة بشرية للقرارات عالية الأثر؟'],
  ['evidence', 'التسجيل والأدلة', 'هل تقدرون تثبتون كيف ولماذا اتخذت القرارات؟'],
  ['monitoring', 'المراقبة', 'هل تراجعون الاستخدامات والمخاطر والتغييرات دوريًا؟'],
];
const groups = [
  { title: 'الصورة الحالية', helper: 'وش تستخدمون ومن المسؤول؟', ids: ['inventory', 'ownership'] },
  { title: 'القرار والسياسة', helper: 'كيف تُدار المخاطر والقواعد التشغيلية؟', ids: ['risk', 'policy'] },
  { title: 'البيانات والاعتمادات', helper: 'وش حدود البيانات ومتى يتدخل الإنسان؟', ids: ['data', 'approvals'] },
  { title: 'الأدلة والاستمرار', helper: 'كيف تثبتون وتراجعون عمل الحوكمة؟', ids: ['evidence', 'monitoring'] },
];
const answers = [['established', 'مطبق وواضح'], ['partial', 'موجود جزئيًا أو غير ثابت'], ['not_started', 'ما بدأنا فيه']];
const faqs = [
  ['كم ياخذ مني التقييم؟', 'حوالي خمس دقائق: ثمانية أسئلة على أربع مراحل قصيرة، وتشوف ملخصك مباشرة بدون تسجيل أو انتظار.'],
  ['هل هذا التقييم شهادة أو موافقة من جهة تنظيمية؟', 'لا. هذا فحص إرشادي من BrightAI يساعدكم ترتبون نقاش الجاهزية. ما يمنح شهادة، ولا يثبت امتثالًا، ولا يحل محل مراجعة قانونية أو تنظيمية.'],
  ['وش أحصل عليه بعد الإجابة؟', 'بتشوف ملخصًا وصفيًا يفصل نقاط القوة والفجوات وخطوات ضبط مقترحة. ما نطلع درجة رقمية ولا نزعم منهجية تنظيمية معتمدة.'],
  ['هل تُرسل إجاباتي لكم؟', 'لا. الأسئلة والنتيجة تُعالج داخل متصفحك. التحليلات تقيس مسار الاستخدام على مستوى الحدث فقط، بدون نص الإجابات أو بيانات شخصية.'],
];
const jsonLd = { '@context': 'https://schema.org', '@graph': [{ '@type': 'WebPage', name: 'تقييم جاهزية حوكمة الذكاء الاصطناعي للشركات السعودية', url: 'https://brightai.live/assessment/ai-governance-readiness/', description: 'تقييم إرشادي لحوكمة الذكاء الاصطناعي للمؤسسات السعودية يغطي الاستخدامات والملكية والمخاطر والسياسات والبيانات والموافقات والأدلة والمراقبة.', inLanguage: 'ar-SA', dateModified: '2026-09-03' }, { '@type': 'Service', '@id': 'https://brightai.live/assessment/ai-governance-readiness/#service', name: 'تقييم جاهزية حوكمة الذكاء الاصطناعي', url: 'https://brightai.live/assessment/ai-governance-readiness/', serviceType: 'AI Governance Readiness Assessment', provider: { '@id': 'https://brightai.live/#organization' }, areaServed: { '@type': 'Country', name: 'المملكة العربية السعودية' }, offers: { '@type': 'Offer', priceCurrency: 'SAR', price: 0, availability: 'https://schema.org/InStock', url: 'https://brightai.live/assessment/ai-governance-readiness/' }, inLanguage: 'ar-SA', description: 'فحص إرشادي تفاعلي من ثمانية محاور يساعد المؤسسات السعودية على ترتيب نقاش جاهزية حوكمة الذكاء الاصطناعي. النتيجة وصفية وتُعالج داخل المتصفح.' }] };
---

<ArabicLayout title="تقييم جاهزية حوكمة AI للمؤسسات السعودية | BrightAI" description="فحص إرشادي لحوكمة الذكاء الاصطناعي: الاستخدامات، الملكية، المخاطر، السياسات، البيانات، الموافقات، الأدلة والمراقبة. نتائج وصفية على جهازك بدون شهادة أو ادعاء امتثال." canonical="https://brightai.live/assessment/ai-governance-readiness/" hreflang={[{lang:'ar-SA',href:'https://brightai.live/assessment/ai-governance-readiness/'},{lang:'x-default',href:'https://brightai.live/assessment/ai-governance-readiness/'}]} jsonLd={jsonLd as any} currentPath="/assessment/ai-governance-readiness/" extraSpeakableSelectors={['[data-snippet="tl-dr"]']} breadcrumbs={[{ name: 'تقييم الجاهزية', href: '/assessment/ai-governance-readiness/' }]}>
  <section class="page-hero assessment-hero" aria-labelledby="assessment-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8 assessment-hero__grid">
      <div>
        <p class="inner-section__label">فحص إرشادي للمؤسسات السعودية</p>
        <h1 id="assessment-title" class="page-hero__title"><span class="gradient-text">قيّم جاهزية حوكمة AI</span><br />قبل ما تكبر المخاطر</h1>
        <p class="page-hero__description">هذا التقييم مناسب لقادة التقنية والمخاطر والبيانات والامتثال اللي يبغون صورة مشتركة عن استخدامات الذكاء الاصطناعي داخل مؤسستهم. ثمانية أسئلة على أربع مراحل، تاخذ منك حوالي خمس دقائق، وتطلع بملخص واضح لنقاط القوة والفجوات وأول الضوابط المقترحة — بدون تسجيل وبدون انتظار.</p>
        <aside data-snippet="tl-dr" aria-label="الخلاصة" class="answer-first-summary"><p>تقييم جاهزية حوكمة الذكاء الاصطناعي من BrightAI هو فحص إرشادي يغطي الحصر والملكية والمخاطر والسياسات والبيانات والموافقات والأدلة والمراقبة. تظهر النتيجة في متصفحك كنقاط قوة وفجوات وخطوات تالية؛ ليست شهادة أو موافقة تنظيمية أو حكم امتثال.</p></aside>
        <p class="inner-section__label">آخر تحديث: 2026-09-03</p>
      </div>
      <aside class="assessment-trust-card" aria-label="حدود التقييم وخصوصيته">
        <strong>واضح من البداية</strong>
        <ul><li>بدون درجة رقمية أو ادعاء منهجية معتمدة.</li><li>بدون طلب اسم أو إيميل أو بيانات حساسة.</li><li>إجاباتك تبقى داخل متصفحك.</li></ul>
        <a href="#assessment" class="btn btn--glow btn--lg" data-cta="assessment_start_click" data-cta-label="ابدأ تقييم الجاهزية" data-position="hero" data-page-type="ai-governance-readiness" data-offer="assessment">ابدأ التقييم</a>
      </aside>
    </div>
  </section>

  <section class="inner-section" aria-labelledby="who-title"><div class="max-w-7xl mx-auto px-5 lg:px-8"><p class="inner-section__label">لمن هذا التقييم؟</p><h2 id="who-title" class="inner-section__title">مصمم لأصحاب القرار — مو للفضول العام</h2><p class="inner-section__lead">لو واحد من هالأدوار عندك، فالتقييم هذا يتكلم لغتك ويرتب لك النقاش مع بقية الفريق.</p><div class="grid grid--4"><article class="card card--feature"><h3 class="inner-card__title">قادة التقنية</h3><p class="inner-card__text">مدراء التقنية والتحول الرقمي اللي يبغون يعرفون وين وصل استخدام AI فعليًا داخل الإدارات، قبل ما يتحول لظل تقني ما حد يدري عنه.</p></article><article class="card card--feature"><h3 class="inner-card__title">المخاطر والامتثال</h3><p class="inner-card__text">مسؤولو المخاطر والحوكمة اللي يحتاجون صورة مرتبة عن الضوابط الموجودة والفجوات، عشان يجهزون النقاش الداخلي بثقة.</p></article><article class="card card--feature"><h3 class="inner-card__title">البيانات والخصوصية</h3><p class="inner-card__text">مدراء البيانات وحماية البيانات اللي يسألون: وش البيانات اللي تدخل النماذج؟ ومن سمح؟ وكيف نوثق الإجابة؟</p></article><article class="card card--feature"><h3 class="inner-card__title">أصحاب المنتجات</h3><p class="inner-card__text">قادة المنتجات والعمليات اللي يطلقون مزايا تعتمد على AI ويبغون يتأكدون أن الموافقات والأدلة ماشية مع السرعة.</p></article></div><p class="assessment-note">ولو تبغى تدقيقًا رسميًا أو شهادة أو رأيًا قانونيًا، فهذا التقييم مو بديل عنها — هو نقطة البداية اللي ترتب لك الطريق لها.</p></div></section>

  <section class="inner-section inner-section--alt" aria-labelledby="how-title"><div class="max-w-6xl mx-auto px-5 lg:px-8"><p class="inner-section__label">كيف يشتغل؟</p><h2 id="how-title" class="inner-section__title">ثلاث خطوات وتطلع بالصورة كاملة</h2><div class="grid grid--3"><article class="card card--feature"><h3 class="inner-card__title">1. جاوب بصدق</h3><p class="inner-card__text">ثمانية أسئلة على أربع مراحل: الصورة الحالية، القرار والسياسة، البيانات والاعتمادات، ثم الأدلة والاستمرار. اختر الوصف الأقرب لواقعكم اليوم.</p></article><article class="card card--feature"><h3 class="inner-card__title">2. شف ملخصك فورًا</h3><p class="inner-card__text">أول ما تخلص، يظهر لك ملخص وصفي يفصل نقاط القوة المعلنة والفجوات اللي تحتاج نقاش والضوابط التالية المقترحة.</p></article><article class="card card--feature"><h3 class="inner-card__title">3. قرر خطوتك الجاية</h3><p class="inner-card__text">خذ الملخص لاجتماعك الداخلي، أو احجز جلسة استكشافية نحول فيها الملخص لنطاق عمل مناسب لجهتك — بدون أي التزام.</p></article></div><p class="assessment-note">خصوصيتك محفوظة: ما نطلب اسم ولا إيميل، وإجاباتك تُعالج داخل متصفحك ولا تُرسل لخوادمنا.</p></div></section>

  <section class="inner-section" aria-labelledby="assessment-source-title"><div class="max-w-6xl mx-auto px-5 lg:px-8"><p class="inner-section__label">المصدر الرسمي</p><h2 id="assessment-source-title" class="inner-section__title">التقييم يرتب الحوار؛ النص الرسمي يحدد ما ينطبق</h2><p class="inner-section__lead">استخدم <a href="https://dgp.sdaia.gov.sa/" target="_blank" rel="noopener noreferrer">منصة حوكمة البيانات الوطنية التابعة لسدايا</a> والنصوص الرسمية ذات الصلة لتحديد المتطلبات التي تنطبق على جهتك. محاور التقييم الثمانية لا تحول الإرشاد العام إلى حكم تنظيمي آلي.</p><h3>متطلب أو إرشاد رسمي</h3><p>راجع المرجع الرسمي والقطاع ونطاق البيانات قبل اعتماد أي قرار امتثال.</p><h3>منهج BrightAI للتنفيذ</h3><p>الأسئلة الثمانية قالب تشخيصي من BrightAI يجمع الصورة التشغيلية، ولا يمنح شهادة أو رأيًا قانونيًا.</p><ol><li>اجمع الاستخدامات والملاك.</li><li>حدد المخاطر والبيانات والضوابط.</li><li>وثّق الفجوات والخطوة التالية.</li></ol></div></section>

  <section id="assessment" class="inner-section inner-section--alt" aria-labelledby="assessment-form-title">
    <div class="max-w-4xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">8 محاور · 4 مراحل · حوالي 5 دقائق</p><h2 id="assessment-form-title" class="inner-section__title">خلنا نرتب الصورة مع بعض</h2>
      <p class="inner-section__lead">اختر الوصف الأقرب لواقعكم اليوم. النتيجة تساعدكم تبدأون نقاشًا مرتبًا مع الفريق، وليست تدقيقًا أو قرارًا تنظيميًا.</p>
      <form data-readiness-assessment class="assessment-form" novalidate>
        <p data-assessment-status class="sr-only" aria-live="polite"></p>
        <div class="assessment-progress-wrap">
          <p data-assessment-step-label class="assessment-step-label" aria-hidden="true">المرحلة 1 من 4: الصورة الحالية</p>
          <progress data-assessment-progress class="assessment-progress" max="4" value="1">الخطوة 1 من 4</progress>
        </div>
        <div data-assessment-error class="assessment-error" role="alert" tabindex="-1" hidden></div>
        {groups.map((group, groupIndex) => (
          <fieldset data-assessment-group data-group-title={group.title} class="assessment-group">
            <legend tabindex="-1"><span>المرحلة {groupIndex + 1}</span>{group.title}</legend><p>{group.helper}</p>
            {group.ids.map((id) => {
              const dimension = dimensions.find(([dimensionId]) => dimensionId === id)!;
              return <div class="assessment-question" role="radiogroup" aria-labelledby={`q-${id}-label`}><h3 id={`q-${id}-label`}>{dimension[1]}</h3><p>{dimension[2]}</p><div class="assessment-options">{answers.map(([value, label]) => <label><input type="radio" name={id} value={value} required /><span>{label}</span></label>)}</div></div>;
            })}
          </fieldset>
        ))}
        <div class="assessment-actions"><button data-assessment-back type="button" class="btn btn--secondary btn--lg" hidden>السابق</button><button data-assessment-next type="button" class="btn btn--glow btn--lg">حفظ والانتقال للمرحلة التالية</button><button data-assessment-submit type="submit" class="btn btn--glow btn--lg" hidden>اعرض ملخص الجاهزية</button></div>
      </form>
    </div>
  </section>

  <section data-assessment-results class="inner-section assessment-results" aria-labelledby="results-title" hidden>
    <div class="max-w-6xl mx-auto px-5 lg:px-8"><p class="inner-section__label">ملخصك الإرشادي</p><h2 id="results-title" class="inner-section__title" tabindex="-1">من وين تبدأون؟</h2><p class="inner-section__lead">هذا تلخيص من إجاباتكم فقط؛ راجعوه مع أصحاب المصلحة قبل اعتماد أي قرار أو ادعاء امتثال.</p>
      <div class="grid grid--3 assessment-results__grid"><article class="card card--feature assessment-result assessment-result--strength"><h3><span aria-hidden="true" class="assessment-result__icon">✓</span>نقاط قوة معلنة</h3><ul data-result-strengths></ul></article><article class="card card--feature assessment-result assessment-result--gap"><h3><span aria-hidden="true" class="assessment-result__icon">!</span>فجوات تحتاج نقاش</h3><ul data-result-gaps></ul></article><article class="card card--feature assessment-result assessment-result--control"><h3><span aria-hidden="true" class="assessment-result__icon">→</span>ضوابط تالية مقترحة</h3><ul data-result-controls></ul></article></div>
      <div class="assessment-results__cta"><h3>تبي تحوّل الملخص لخطة مناسبة لنطاقكم؟</h3><p>احجز جلسة استكشافية مع الفريق. نبدأ من واقع استخداماتكم ونوضح نطاق العمل قبل أي التزام.</p><p><a href="/contact/" class="btn btn--glow btn--lg" data-cta="assessment_completion_cta" data-cta-label="احجز جلسة استكشافية" data-position="results" data-page-type="ai-governance-readiness" data-offer="assessment">احجز جلسة استكشافية</a></p><p class="assessment-results__alt">مو مستعجل؟ <a href="/solutions/ai-governance-platform/" data-cta="assessment_completion_secondary" data-cta-label="استكشف منصة الحوكمة" data-position="results" data-page-type="ai-governance-readiness">استكشف منصة الحوكمة</a> وشف كيف تتحول الضوابط لتشغيل يومي.</p></div>
    </div>
  </section>

  <section class="inner-section" aria-labelledby="dimensions-title"><div class="max-w-7xl mx-auto px-5 lg:px-8"><p class="inner-section__label">وش يغطي التقييم؟</p><h2 id="dimensions-title" class="inner-section__title">ثمانية محاور للحوار العملي</h2><p class="inner-section__lead">المحاور ظاهرة قبل بدء النموذج عشان يقدر فريقك يراجعها ويشارك الإجابة على نفس الفهم.</p><div class="grid grid--4">{dimensions.map(([, title, description]) => <article class="card card--feature"><h3 class="inner-card__title">{title}</h3><p class="inner-card__text">{description}</p></article>)}</div></div></section>

  <section class="inner-section inner-section--alt" aria-labelledby="receive-title"><div class="max-w-6xl mx-auto px-5 lg:px-8"><p class="inner-section__label">بعد الإكمال</p><h2 id="receive-title" class="inner-section__title">وش تستلم من التقييم؟</h2><div class="grid grid--3"><article class="card card--feature"><h3 class="inner-card__title">ملخص مباشر</h3><p class="inner-card__text">تقسيم واضح بين النقاط المعلنة كنقاط قوة والفجوات التي تحتاج مراجعة.</p></article><article class="card card--feature"><h3 class="inner-card__title">خطوات ضبط مبدئية</h3><p class="inner-card__text">توصيات تشغيلية عامة تربط كل فجوة بإجراء أول قابل للنقاش.</p></article><article class="card card--feature"><h3 class="inner-card__title">طريق لجلسة أعمق</h3><p class="inner-card__text">لو احتجت، تقدر تحجز جلسة لاستكشاف النطاق؛ بدون وعود شهادة أو موافقة تنظيمية.</p></article></div><p class="inner-section__lead">وقبل التقييم أو بعده، يفيدك تعبئة <a href="/tools/ai-risk-register/">قالب سجل مخاطر AI</a> — يجمع الاستخدامات والتصنيف والضوابط والأدلة بجدول واحد يسهل نقاشه مع الفريق. ولو تبي الصورة الكاملة، اقرأ <a href="/hub/ai-governance/">مرجع حوكمة الذكاء الاصطناعي</a> وشف <a href="/solutions/ai-governance-platform/">منصة الحوكمة</a> اللي تحول هالضوابط لتشغيل يومي.</p></div></section>

  <section class="inner-section" aria-labelledby="limits-title"><div class="max-w-6xl mx-auto px-5 lg:px-8"><p class="inner-section__label">الشفافية أولًا</p><h2 id="limits-title" class="inner-section__title">وش اللي ما يسويه هذا التقييم؟</h2><div class="grid grid--3"><article class="card card--feature"><h3 class="inner-card__title">مو شهادة</h3><p class="inner-card__text">لا يمنح شهادة جاهزية ولا يثبت امتثالًا لأي نظام أو جهة. النتيجة ملخص وصفي لإجاباتك فقط.</p></article><article class="card card--feature"><h3 class="inner-card__title">مو موافقة تنظيمية</h3><p class="inner-card__text">لا يغني عن مراجعة المتطلبات الرسمية مع الجهات المختصة أو المستشار القانوني لجهتك.</p></article><article class="card card--feature"><h3 class="inner-card__title">مو درجة نهائية</h3><p class="inner-card__text">ما فيه درجة رقمية ولا ترتيب ولا مقارنة مع غيرك — عمدًا، عشان التركيز يبقى على النقاش العملي مو على رقم يضلل.</p></article></div></div></section>

  <section class="inner-section inner-section--alt" aria-labelledby="faq-title"><div class="max-w-4xl mx-auto px-5 lg:px-8"><p class="inner-section__label">أسئلة مهمة</p><h2 id="faq-title" class="inner-section__title">قبل ما تبدأ</h2><div class="inner-faq" role="list">{faqs.map(([question, answer], index) => <details class="card card--glass home-faq-item" role="listitem" open={index === 0}><summary><span>{question}</span><svg class="home-faq-chevron" aria-hidden="true" width="1.25em" height="1.25em"><use href="/icons.svg#mdi-chevron-down"></use></svg></summary><div class="home-faq-answer"><p>{answer}</p></div></details>)}</div></div></section>
  <script is:inline type="module" src="/js/ai-governance-readiness.js"></script>
</ArabicLayout>

<style>
