      <h2 id="assessment-form-visual" class="inner-section__title">أربع مراحل للاجتياز، من السؤال إلى ملف الأدلة</h2>
      <p class="inner-section__lead">تقدر تختبر الجاهزية بنفسك قبل ما تتواصل معنا. كل مرحلة من المراحل الأربع تركّز على محور مختلف.</p>

      <div class="assessment-progress" aria-hidden="true">
        <div class="assessment-progress__bar">
          <div class="assessment-progress__fill assessment-progress__fill--full"></div>
        </div>
        <ol class="assessment-progress__steps assessment-progress__steps--reset">
          {formSteps.map(s => (
            <li><span>{s.label}</span></li>
          ))}
        </ol>
      </div>

      {/* Sample question group (visual only — no actual handler; marketing preview) */}
      {assessmentQuestions.map(group => (
        <div class="assessment-question-group">
          <h3 class="assessment-question-group__title">{group.title}</h3>
          <p class="assessment-question-group__helper">{group.helper}</p>
          <div class="form-row form-row--2">
            {group.fields.map(f => (
              <div class="form-field">
                <label class="form-label" for={f.id}>{f.label}</label>
                {f.type === 'select' ? (
                  <select class="field field--select" id={f.id} name={f.id} disabled>
                    <option value="">— اختر —</option>
                    {f.options.map(o => <option>{o}</option>)}
                  </select>
                ) : null}
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="assessment-actions-centered">
        <button type="button" class="btn btn--glow btn--lg" disabled>
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-arrow-right"></use></svg>
          ابدأ التقييم الكامل (متاح بعد التواصل)
        </button>
      </div>
    </div>
  </section>

  {/* ═══════════ 3. TARGET AUDIENCE — 3 cards ═══════════ */}
  <section class="inner-section" aria-labelledby="target-audience-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">الفئات المستهدفة</p>
      <h2 id="target-audience-title" class="inner-section__title">لمن هذا التقييم؟</h2>
      <p class="inner-section__lead">تم تصميم تقييم الجاهزية خصيصاً للقادة التنفيذيين وصناع القرار في المؤسسات السعودية الكبرى لمساندتهم في إرساء دعائم حوكمة تقنية متكاملة.</p>
      <p class="inner-section__lead">احصل على خارطة طريق تقنية واضحة تمكنك من بسط سيطرتك الفنية على استخدامات الذكاء الاصطناعي وتطبيق سياساتك الأمنية في الوقت الفعلي.</p>
      <div class="grid grid--3">
        {targetAudience.map(a => (
          <article class="card card--feature card--lg">
            <div class={`avatar-tile avatar-tile--sm ${a.bgClass}`} aria-hidden="true">
              <Icon name={a.icon} class="avatar-tile__icon--white icon-size-md" />
            </div>
            <h3 class="inner-card__title">{a.title}</h3>
            <p class="text-cyan-300 font-bold text-sm mb-3">{a.sub}</p>
            <p class="inner-card__text">{a.desc}</p>
            <div class="flex flex-wrap gap-2 mt-3">
              {a.tags.map(t => <span class="assessment-tag">{t}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 4. AUDIT PILLARS — 4 cells ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="audit-scope-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">آلية الفحص</p>
      <h2 id="audit-scope-title" class="inner-section__title">ماذا نفحص في تقييم الجاهزية؟</h2>
      <p class="inner-section__lead">نقوم بفحص ومراجعة أربع ركائز أساسية تغطي كافة جوانب استخدامات الذكاء الاصطناعي داخل بيئتك التقنية.</p>
      <div class="grid grid--4">
        {auditPillars.map(p => (
          <article class={`card card--feature audit-pillar audit-pillar--${p.accentClass}`}>
            <div class="audit-pillar__icon" aria-hidden="true">
              <Icon name={p.icon} class="icon-size-md" />
            </div>
            <h3 class="inner-card__title">{p.title}</h3>
            <p class="inner-card__text">{p.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 5. OUTPUTS — 3 panels with accent borders ═══════════ */}
  <section class="inner-section" aria-labelledby="outputs-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">نتائج ملموسة</p>
