---
/**
 * ROI Calculator — /calculator/roi/
 * Interactive vanilla-JS estimator of AI-governance value. No React, tokens only.
 */
import ArabicLayout from '../../../layouts/ArabicLayout.astro';
import LeadForm from '../../../components/LeadForm.astro';

const sectors = [
  { v: 'bank', t: 'بنك / مالي' },
  { v: 'hospital', t: 'صحي / مستشفى' },
  { v: 'government', t: 'جهة حكومية' },
  { v: 'industry', t: 'صناعة / مصنع' },
  { v: 'tech', t: 'تقنية / SaaS' },
  { v: 'other', t: 'غيره' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'حاسبة العائد على الاستثمار لحوكمة الذكاء الاصطناعي | BrightAI',
      description: 'قدّر الوفر السنوي وتقليل المخاطر من تطبيق حوكمة الذكاء الاصطناعي مع BrightAI. حاسبة تفاعلية بالعربية.',
      url: 'https://brightai.live/calculator/roi/',
      inLanguage: 'ar-SA',
    },
  ],
};
---

<ArabicLayout
  title="حاسبة عائد الاستثمار لحوكمة AI | BrightAI"
   description="قدّر الوفر السنوي وتقليل المخاطر من حوكمة الذكاء الاصطناعي مع BrightAI وفق PDPL وNCA. حاسبة عائد استثمار تفاعلية لمؤسسات السعودية. احسب العائد الآن."
  canonical="https://brightai.live/calculator/roi/"
  hreflang={[{ lang: 'ar-SA', href: 'https://brightai.live/calculator/roi/' }, { lang: 'x-default', href: 'https://brightai.live/calculator/roi/' }]}
  jsonLd={jsonLd as any}
  currentPath="/calculator/roi/"
  breadcrumbs={[{ name: 'حاسبة العائد', href: '/calculator/roi/' }]}
>

  <section class="page-hero" aria-label="حاسبة العائد">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="inner-hero__badge">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-calculator-variant"></use></svg>
        حاسبة تفاعلية — بالعربية
      </div>
      <h1 class="page-hero__title"><span class="gradient-text">حاسبة العائد</span> على حوكمة AI</h1>
      <p class="page-hero__description">قدّر الوفر السنوي وتقليل المخاطر من تطبيق حوكمة الذكاء الاصطناعي في مؤسستك. الأرقام تقديرية لأغراض التخطيط، ونقدر نراجعها معك في عرض مخصص.</p>
    </div>
  </section>

  <section class="inner-section" aria-labelledby="roi-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="roi-title" class="inner-section__title">أدخل بيانات مؤسستك</h2>
      <div class="roi-grid">
        {/* Inputs */}
        <form id="roi-form" class="card card--feature card--lg roi-form" aria-label="مدخلات الحاسبة">
          <div class="form-field">
            <label class="form-label" for="roi-sector">القطاع</label>
            <select class="field field--select" id="roi-sector" name="sector">
              {sectors.map((s) => <option value={s.v}>{s.t}</option>)}
            </select>
          </div>
          <div class="form-field">
            <label class="form-label" for="roi-employees">عدد الموظفين التقنيين</label>
            <input class="field" type="number" id="roi-employees" name="employees" min="1" value="200" inputmode="numeric" />
          </div>
          <div class="form-field">
            <label class="form-label" for="roi-hours">ساعات تدقيق يدوي / شهر</label>
            <input class="field" type="number" id="roi-hours" name="hours" min="0" value="40" inputmode="numeric" />
          </div>
          <div class="form-field">
            <label class="form-label" for="roi-hourly">متوسط تكلفة الساعة (SAR)</label>
            <input class="field" type="number" id="roi-hourly" name="hourly" min="0" value="120" inputmode="numeric" />
          </div>
          <div class="form-field">
            <label class="form-label" for="roi-incidents">عدد حوادث امتثال متوقعة / سنة</label>
            <input class="field" type="number" id="roi-incidents" name="incidents" min="0" value="4" inputmode="numeric" />
          </div>
          <div class="form-field">
            <label class="form-label" for="roi-investment">الاستثمار السنوي المقدّر (SAR)</label>
            <input class="field" type="number" id="roi-investment" name="investment" min="0" value="300000" inputmode="numeric" />
          </div>
          <button type="submit" class="btn btn--glow btn--block">احسب العائد</button>
          <p class="roi-note">* تقديري لأغراض التخطيط. يختلف حسب نطاق التنفيذ والقطاع.</p>
        </form>

        {/* Results */}
        <div class="roi-results" aria-live="polite">
          <article class="card card--feature roi-result">
            <span class="assessment-result-preview__label">توفير العمالة (أتمتة التدقيق)</span>
            <div class="assessment-result-preview__score" id="roi-out-labor">—</div>
          </article>
          <article class="card card--feature roi-result">
            <span class="assessment-result-preview__label">قيمة تقليل المخاطر</span>
            <div class="assessment-result-preview__score" id="roi-out-risk">—</div>
          </article>
          <article class="card card--feature roi-result card--gradient">
            <span class="assessment-result-preview__label">إجمالي القيمة السنوية</span>
            <div class="assessment-result-preview__score" id="roi-out-total">—</div>
          </article>
          <article class="card card--feature roi-result">
            <span class="assessment-result-preview__label">العائد على الاستثمار (ROI)</span>
            <div class="assessment-result-preview__score" id="roi-out-roi">—</div>
          </article>
          <article class="card card--feature roi-result">
            <span class="assessment-result-preview__label">فترة الاسترداد</span>
            <div class="assessment-result-preview__score" id="roi-out-payback">—</div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="inner-section inner-section--alt" aria-labelledby="roi-cta">
    <div class="max-w-4xl mx-auto px-5 lg:px-8">
      <h2 id="roi-cta" class="inner-section__title inner-section__title--centered">تبي عائداً مبني على بياناتك الفعلية؟</h2>
      <p class="inner-section__lead inner-section__lead--centered">احجز عرضاً مخصصاً ونراجع الأرقام مع فريقك بناءً على حالتك.</p>
      <div class="contact-form-card contact-form-card--padded">
        <LeadForm
          title="اطلب عرضاً مخصصاً"
          intro="نرسل لك تقديراً مفصّلاً بعد مشاركة سياق مؤسستك."
          subject="طلب عرض حوكمة AI (من حاسبة ROI)"
          ctaLabel="اطلب العرض"
          source="calculator"
          medium="roi"
          campaign="always-on"
          fields={[
            { name: 'name', label: 'الاسم الكامل', required: true, autocomplete: 'name' },
            { name: 'email', label: 'البريد الإلكتروني', type: 'email', required: true, autocomplete: 'email' },
            { name: 'company', label: 'الشركة', autocomplete: 'organization' },
            { name: 'sector', label: 'القطاع', type: 'select', options: ['مصرفي', 'صحي', 'حكومي', 'صناعي', 'تقني', 'غيره'] },
          ]}
        />
      </div>
    </div>
  </section>

  {/* ─── Related resources for ROI planning (BAI-SEO-003-S5) ────── */}
  <section class="inner-section" aria-labelledby="roi-related">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="roi-related" class="inner-section__title">روابط تساعدك تبني حالة ROI لحوكمة AI</h2>
      <p class="inner-section__lead">لو تبي تفصيل أعمق للتكاليف الفعلية أو نماذج حسابية مشابهة، هذي المصادر مفيدة قبل ما تطلع بالعرض التقديمي للإدارة أو المالية.</p>
      <div class="grid grid--2">
        <article class="card card--feature">
          <h3 class="inner-card__title"><a href="/blog/ai-implementation-cost-saudi/">تكلفة تطبيق AI للشركات السعودية</a></h3>
          <p class="inner-card__text">تفصيل التكاليف الإجمالية (تراخيص + بنية تحتية + كفاءات + حوكمة) مع نصائح لتحسين العائد وتجنّب الأخطاء الشائعة في حساب ROI.</p>
        </article>
        <article class="card card--feature">
          <h3 class="inner-card__title"><a href="/blog/rpa-automation-saudi-savings/">أتمتة RPA: توفير ملايين الريالات</a></h3>
          <p class="inner-card__text">دراسة حالة توفير 7.4 مليون ريال من أتمتة العمليات، مع خارطة طريق 6 مراحل لتطبيق RPA داخل الشركات السعودية.</p>
        </article>
        <article class="card card--feature">
          <h3 class="inner-card__title"><a href="/blog/iso-42001-saudi-implementation-guide/">تطبيق ISO/IEC 42001 في السعودية</a></h3>
          <p class="inner-card__text">دليل 6 مراحل لتطبيق معيار حوكمة AI العالمي ISO 42001، يربط ROI بمتطلبات الامتثال المحلية (PDPL، NCA ECC، SDAIA).</p>
        </article>
        <article class="card card--feature">
          <h3 class="inner-card__title"><a href="/pricing/">عروض حوكمة AI وأسعارها</a></h3>
          <p class="inner-card__text">3 عروض متدرجة (Assessment / Pilot / Enterprise Rollout) تترجم تقدير الحاسبة إلى نطاق فعلي وفاتورة مرتبطة بنتائج قابلة للقياس.</p>
        </article>
      </div>
    </div>
  </section>
</ArabicLayout>

<script>
  import '../../../scripts/roi-calculator.js';
</script>

<style>
  .roi-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  @media (max-width: 860px) {
    .roi-grid { grid-template-columns: 1fr; }
  }
  .roi-form { display: flex; flex-direction: column; gap: var(--space-4); }
  .roi-note { font-size: var(--text-xs); color: var(--text-secondary); margin: 0; }
  .roi-results {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  .roi-result {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }
  .assessment-result-preview__label {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
  .assessment-result-preview__score {
    font-size: var(--text-3xl);
    font-weight: var(--font-extrabold);
    color: var(--brand-300);
    line-height: 1;
  }
  .contact-form-card {
    background: var(--bg-surface);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
</style>
