---
import PageShell from '../components/PageShell.astro';
export const prerender = true;
const rows = [
  ['مبادئ أخلاقيات الذكاء الاصطناعي — سدايا', 'النزاهة، والخصوصية، والإنسانية، والموثوقية، والشفافية، والمساءلة', 'تقييم مخاطر، وموافقة بشرية، وسجل تدقيق، وتقييم انحياز', 'Risk Engine · Human Gate · Ledger'],
  ['نظام حماية البيانات الشخصية', 'تقليل البيانات، ومنع الإفصاح غير المشروع، وضوابط النقل خارج المملكة', 'حجب البيانات قبل خروجها، والتشغيل المحلي، وحذف السياقات تلقائياً', 'Firewall · Sovereign'],
  ['الضوابط الأساسية للأمن السيبراني — الهيئة الوطنية للأمن السيبراني', 'إدارة الهويات والصلاحيات، والتسجيل والمراقبة، وحماية البيانات', 'صلاحيات K1، وسجلات قابلة للتحقق، وتكامل SIEM', 'K1 · Ledger · SIEM'],
  ['إرشادات الذكاء الاصطناعي التوليدي — سدايا', 'الاستخدام المسؤول، والتحقق من المخرجات، وحماية المعلومات', 'قوالب معتمدة فقط، ومنع حقن التعليمات، وسياسة الاستخدام', 'K2 · Secure Chat · سياسة الاستخدام'],
  ['ISO/IEC 42001', 'نظام إدارة الذكاء الاصطناعي: المخاطر والأدوار والتحسين المستمر', 'خدمة التهيئة، وسجل النماذج، وأدلة جاهزة من Ledger', 'خدمة ISO 42001 · Model Lineage'],
];
---
<PageShell title="الامتثال التنظيمي للذكاء الاصطناعي في السعودية | BRIGHTAI" description="كيف يساعد AIGAS في تطبيق مبادئ سدايا ونظام حماية البيانات الشخصية وضوابط الهيئة الوطنية للأمن السيبراني وISO 42001." crumbs={[{ name: 'الامتثال' }]}>
  <p class="eyebrow">الامتثال / المرجعيات السعودية والدولية</p>
  <h1>من النص التنظيمي<br /><span class="muted">إلى ضابط يعمل فعلاً.</span></h1>
  <p class="note">هذا المحتوى يصف التصور المستهدف للمنصة، ولا يثبت تشغيل القدرات أو التكاملات أو مدد الاحتفاظ المذكورة. المتاح هنا تجربة حجب توضيحية؛ يُحدد نطاق الخدمة والتزاماتها في اتفاق مكتوب.</p>
  <p class="lead">اللوائح تحدد المطلوب، لكنها لا تشرح كيف تطبقه على موظف يكتب في أداة ذكاء اصطناعي الساعة العاشرة صباحاً. هذه الخريطة تربط كل مرجعية بضابط عملي.</p>
  <div class="table-wrap"><table>
    <thead><tr><th>المرجعية</th><th>أبرز المتطلبات</th><th>كيف نساعد</th><th>المنتج أو الخدمة</th></tr></thead>
    <tbody>{rows.map(r => <tr>{r.map(c => <td>{c}</td>)}</tr>)}</tbody>
  </table></div>
  <section class="block"><h2>لماذا الآن</h2>
    <p>استخدام أدوات الذكاء الاصطناعي مع بيانات شخصية يحتاج تقييماً للغرض من المعالجة، والبيانات المرسلة، وأطراف المعالجة ومواقعها. تُراجع المتطلبات والعقوبات المنطبقة مع مستشار قانوني وفق النصوص الرسمية السارية وحالة الجهة.</p>
    <div class="actions"><a class="button" href="/services/#readiness-scan">ابدأ بفحص الجاهزية <span aria-hidden="true">←</span></a></div>
  </section>
  <p class="note">AIGAS أداة تساعد على الامتثال وليست شهادة امتثال. المسؤولية النظامية تبقى على الجهة، وننصح بمراجعة مستشار قانوني مختص.</p>
</PageShell>
