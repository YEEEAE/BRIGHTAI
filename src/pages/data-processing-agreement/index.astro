---
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { getLanguageCounterpart, getLegalAlternates } from '../../data/i18n-pairs';
import { legal_data_processing_agreement } from '../../data/legal-content-inline';
import DOMPurify from 'isomorphic-dompurify';
const route = '/data-processing-agreement/';
const canonical = `https://brightai.live${route}`;
const legalContent = legal_data_processing_agreement;
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'ar-SA' },
]};
---
<ArabicLayout title="DPA — اتفاقية معالجة البيانات | BrightAI" description="اتفاقية معالجة بيانات خدمات BrightAI: أدوار المعالجة وحماية البيانات لعملاء السعودية وفق PDPL والأنظمة المحلية. اطلع على الاتفاقية كاملة وتأكد من امتثالك." canonical={canonical} hreflang={getLegalAlternates(route, 'ar')} jsonLd={jsonLd} currentPath={route} languageCounterpart={getLanguageCounterpart(route)} breadcrumbs={[{ name: 'اتفاقية معالجة البيانات', href: '/data-processing-agreement/' }]}>
  <div class="legal-page" set:html={DOMPurify.sanitize(legalContent.html)} />
</ArabicLayout>
