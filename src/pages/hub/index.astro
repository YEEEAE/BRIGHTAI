---
/**
 * Hub index — /hub/
 * Lists the content hubs as a canonical card grid.
 *
 * REPORT-12: Visual refresh — removes the legacy `set:html` of generated
 * Tailwind-flavored HTML in favor of canonical styles. The generated hub
 * hero/intro HTML (auto-extracted into src/data/hub-content-inline.ts)
 * still renders verbatim inside the page; we only reskin the wrappers
 * + add a small token-only style sheet that gives orphan classes
 * (`text-white/60`, `chip`, etc.) sensible defaults.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { SITE } from '../../data/site';

const hubFaq = [
  {
    question: 'ما هي مراكز محتوى BrightAI وكيف تفيد مؤسستي؟',
    answer: 'مراكز المحتوى هي مراجع معرفية وهندسية متخصصة ومصنفة بحسب المجالات الرئيسية لحوكمة وأمان الذكاء الاصطناعي في السوق السعودي. تغطي المراكز الأطر التشريعية، والحلول التقنية لـ Saudi AI Safety OS، وحالات الاستخدام بالقطاعات، وأدلة حوكمة الوكلاء الأذكياء (Agentic AI).',
  },
  {
    question: 'كيف ترتبط المراكز بالأنظمة السعودية (PDPL, NCA, SDAIA)؟',
    answer: 'تم تصميم محتوى المراكز ليربط بدقة بين المتطلبات القانونية الصادرة عن الهيئة السعودية للبيانات والذكاء الاصطناعي والهيئة الوطنية للأمن السيبراني وبين التطبيق الفني والبرمجي؛ حيث توضح الأدلة كيفية ترجمة النصوص القانونية إلى قواعد جدار حماية وسجلات تدقيق قابلة للإنفاذ آلياً.',
  },
  {
    question: 'هل المحتوى موجه للمسؤولين التنفيذيين أم للمطورين التقنيين؟',
    answer: 'يجمع المحتوى بين المستويين الاستراتيجي والهندسي؛ حيث يجد المسؤول التنفيذي (CTO/CISO/DPO) ملخصات تنفيذية وأطر تقييم المخاطر، بينما يجد المطورون والمهندسون مواصفات تقنية وبنى معمارية تفصيلية للدمج مع واجهات البرمجة وقواعد البيانات.',
  },
  {
    question: 'كم مرة يتم تحديث مراكز المعرفة؟',
    answer: 'يتم تحديث مراكز المحتوى بشكل دوري ومستمر فور صدور أي لوائح أو تعاميم تنظيمية جديدة من الجهات الرقابية السعودية، لضمان بقاء مؤسستك على اطلاع دائم بأحدث الممارسات وأدلة الامتثال.',
  },
];

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: `${SITE.url}/hub/`,
  name: 'مراكز محتوى AI | محاور مرجعية',
  description: 'مراكز محتوى مرجعية من BrightAI: حوكمة AI وامتثال سعودي وحلول تقنية وحالات استخدام وأدلة تشغيلية للوكلاء. مرجع عملي للسوق السعودي.',
  inLanguage: 'ar-SA',
  hasPart: [
    { '@type': 'WebPage', url: `${SITE.url}/hub/ai-governance/`, name: 'حوكمة الذكاء الاصطناعي' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/compliance/`, name: 'الامتثال السعودي' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/solutions/`, name: 'الحلول التقنية' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/use-cases/`, name: 'حالات الاستخدام' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/sdaia-ai-risk-management/`, name: 'الإطار الوطني لإدارة مخاطر الذكاء الاصطناعي' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/agentic-ai-governance/`, name: 'حوكمة Agentic AI التشغيلية' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/agentic-ai-security/`, name: 'أمن Agentic AI' },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: hubFaq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const hubJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    collectionLd,
    faqLd,
  ],
};

const hubs = [
  {
    slug: 'ai-governance',
    eyebrow: 'حوكمة AI',
    title: 'مركز حوكمة الذكاء الاصطناعي',
    desc: 'الإطار الموحّد للحوكمة، من السياسات إلى التطبيق: تعريفات، معايير، خطوات تنفيذ، وخارطة طريق 30 يوم.',
    icon: 'mdi-brain',
    tint: 'teal',
  },
  {
    slug: 'compliance',
    eyebrow: 'الامتثال السعودي',
    title: 'مركز الامتثال للأنظمة السعودية',
    desc: 'PDPL وNCA ECC وSDAIA وساما والزكاة وضوابطها التشغيلية: شرح عملي وربط بالحلول.',
    icon: 'mdi-scale-balance',
    tint: 'indigo',
  },
  {
    slug: 'solutions',
    eyebrow: 'الحلول التقنية',
    title: 'مركز الحلول التقنية لـ Saudi AI Safety OS',
    desc: 'AI Firewall وسجل التدقيق والموافقات وملف الأدلة — كل حل تقني ومتى تحتاجه وكيف يشتغل.',
    icon: 'mdi-view-dashboard',
    tint: 'teal-indigo',
  },
  {
    slug: 'use-cases',
    eyebrow: 'حالات الاستخدام',
    title: 'مركز حالات الاستخدام بالقطاعات السعودية',
    desc: 'الصحة، البنوك، الحكومي، التعليم، المشتريات، والموارد البشرية: أمثلة وقصص نجاح تطبيقية حقيقية.',
    icon: 'mdi-hospital-building',
    tint: 'amber',
  },
  {
    slug: 'sdaia-ai-risk-management',
    eyebrow: 'دليل تنظيمي سعودي',
    title: 'إطار سدايا لإدارة مخاطر AI',
    desc: 'المراحل الرسمية، مصفوفة الاحتمالية والأثر، وقائمة تطبيق عملية للجهات الحكومية والخاصة.',
    icon: 'mdi-shield-check',
    tint: 'teal',
  },
  {
    slug: 'agentic-ai-security',
    eyebrow: 'أمن الوكلاء',
    title: 'أمن Agentic AI',
    desc: 'حماية هوية الوكيل وصلاحيات الأدوات وحدود البيانات ومسار المراقبة عند تنفيذ الأفعال.',
    icon: 'mdi-shield-lock',
    tint: 'teal',
  },
  {
    slug: 'agentic-ai-governance',
    eyebrow: 'حوكمة الوكلاء',
    title: 'حوكمة Agentic AI التشغيلية',
    desc: 'الملكية، الصلاحيات، الموافقات، دورة الحياة، وسجل الأدلة للوكلاء اللي ينفذون خطوات نيابة عن المستخدم.',
    icon: 'mdi-account-check',
    tint: 'indigo',
  },
];
---

<ArabicLayout
  title="مراكز محتوى AI | محاور مرجعية"
  description="مراكز محتوى مرجعية من BrightAI: حوكمة AI وامتثال لـ PDPL وNCA وحلول تقنية وأدلة تشغيلية للوكلاء. ابدأ رحلة التعلم والامتثال من هنا."
  canonical={`${SITE.url}/hub/`}
  hreflang={[{ lang: 'ar-SA', href: `${SITE.url}/hub/` }]}
  jsonLd={hubJsonLd as any}
  currentPath="/hub/"
  breadcrumbs={[{ name: 'مركز المعرفة', href: '/hub/' }]}
>
  <main class="hub-page">
    <header class="hub-page__hero">
      <span class="chip chip--brand">
        <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-layers"></use></svg>
        المرجع الشامل
      </span>
      <h1>كل شي تبي تعرفه عن حوكمة AI في مكان واحد</h1>
      <p class="hub-page__intro">
        حوكمة وأمان الذكاء الاصطناعي في السعودية، مرتّب لك في مراكز موضوعية متكاملة. اختصر وقتك وابدأ من المركز الذي يطابق سؤالك واحتياج مؤسستك الحالي.
      </p>
    </header>

    <nav class="hub-page__grid" aria-label="مراكز المحتوى">
      {hubs.map((hub) => (
        <a
          class="hub-card--clean"
          href={`/hub/${hub.slug}/`}
          data-hub-tint={hub.tint}
        >
          <div class="hub-card__icon" aria-hidden="true">
            <svg width="28" height="28"><use href={`/icons.svg#${hub.icon}`}></use></svg>
          </div>
          <p class="hub-card__eyebrow">{hub.eyebrow}</p>
          <h2 class="hub-card__title">{hub.title}</h2>
          <p class="hub-card__desc">{hub.desc}</p>
          <span class="hub-card__arrow">
            ادخل المركز
            <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-arrow-left"></use></svg>
          </span>
        </a>
      ))}
    </nav>

    <!-- Deep Architecture & Methodology Guide -->
    <section class="hub-methodology-section" aria-labelledby="hub-methodology">
      <div class="hub-methodology-card">
        <span class="chip chip--brand">المنهجية التشغيلية</span>
        <h2 id="hub-methodology" class="hub-section-title">خارطة طريق تبني الذكاء الاصطناعي المسؤول والآمن</h2>
        <p class="hub-section-intro">
          تعتمد المنشآت السعودية الرائدة منهجية متدرجة للانتقال من مرحلة التجارب المتفرقة إلى التشغيل المؤسسي المحوكم، وفق أربع مراحل رئيسية:
        </p>

        <div class="hub-steps-grid">
          <div class="hub-step-item">
            <div class="hub-step-num">01</div>
            <h3>حصر وتقييم المخاطر (Inventory & Assessment)</h3>
            <p>
              بناء سجل كامل لجميع أدوات ونماذج الذكاء الاصطناعي المستخدمة داخل المنشأة (بما في ذلك كشف Shadow AI)، وتصنيفها حسب درجات الحساسية ومستويات خطورة البيانات المعالجة وفق إطار سدايا.
            </p>
          </div>
          <div class="hub-step-item">
            <div class="hub-step-num">02</div>
            <h3>تطبيق جدار الحماية اللحظي (Inline AI Firewall)</h3>
            <p>
              نشر بوابات أمان وسيطة تفحص كل استعلام ومخرج لحظياً، مع تفعيل آليات التعمية التلقائية للبيانات الشخصية (PII Masking) والتصدي لمحاولات حقن الأوامر والتهديدات السيبرانية المستجدة.
            </p>
          </div>
          <div class="hub-step-item">
            <div class="hub-step-num">03</div>
            <h3>التوثيق الجنائي والأدلة الرقمية (Audit Logging)</h3>
            <p>
              أرشفة كافة الاستعلامات، والقرارات، والبيانات الوصفية في سجل تدقيق مشفر غير قابل للتعديل، مع تفعيل مسارات المراجعة البشرية (Human-in-the-loop) للعمليات والقرارات ذات التأثير العالي.
            </p>
          </div>
          <div class="hub-step-item">
            <div class="hub-step-num">04</div>
            <h3>المراقبة المستمرة والاعتماد القياسي (Continuous Assurance)</h3>
            <p>
              مراقبة الانحراف السلوكي للنماذج (Drift Detection)، وإجراء اختبارات الاختراق المستمرة (AI Red Teaming)، والتوافق مع متطلبات المعيار الدولي لإدارة الذكاء الاصطناعي ISO/IEC 42001.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="hub-faq-section" aria-labelledby="hub-faq-title">
      <div class="hub-faq-card">
        <h2 id="hub-faq-title" class="hub-section-title">أسئلة شائعة حول مراكز المعرفة والحوكمة</h2>
        <div class="hub-faq-grid">
          {hubFaq.map((item) => (
            <div class="hub-faq-item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="content-cta-final" aria-labelledby="hub-cta">
      <div class="card card--cta">
        <h2 id="hub-cta">ابدأ من المركز الأقرب لقرارك الحالي</h2>
        <p>
          لو تبي توصية سريعة بدون ما تقرأ كل شي، <a href="/assessment/ai-governance-readiness/">ابدأ بتقييم جاهزية الحوكمة</a> أو <a href="/contact/">تواصل مع الفريق</a> لجلسة تشخيص قصيرة.
        </p>
        <div class="content-cta-final__actions">
          <a href="/assessment/ai-governance-readiness/" class="btn btn--glow">
            <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-gauge"></use></svg>
            تقييم جاهزية شركتك
          </a>
          <a href="/contact/" class="btn btn--outline">
            <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-email"></use></svg>
            تواصل مع الفريق
          </a>
        </div>
      </div>
    </section>
  </main>

  <style>
    /* REPORT-12: per-hub tint via [data-hub-tint] attribute set in markup. */
    .hub-card--clean[data-hub-tint='teal'] .hub-card__icon {
      background: var(--brand-soft);
      color: var(--interactive-primary);
    }
    .hub-card--clean[data-hub-tint='indigo'] .hub-card__icon {
      background: rgba(99, 102, 241, 0.15);
      color: var(--indigo-300);
    }
    .hub-card--clean[data-hub-tint='teal-indigo'] .hub-card__icon {
      background: linear-gradient(135deg, var(--brand-soft), rgba(99, 102, 241, 0.15));
      color: var(--brand-300);
    }
    .hub-card--clean[data-hub-tint='amber'] .hub-card__icon {
      background: var(--accent-warm-soft);
      color: var(--accent-warm);
    }

    .hub-methodology-section,
    .hub-faq-section {
      margin-top: var(--space-12);
      margin-bottom: var(--space-8);
    }
    .hub-methodology-card,
    .hub-faq-card {
      background: var(--surface-subtle, rgba(255,255,255,0.02));
      border: 1px solid var(--border-subtle, rgba(255,255,255,0.08));
      border-radius: var(--radius-xl, 1rem);
      padding: var(--space-8);
    }
    .hub-section-title {
      font-size: var(--text-2xl, 1.75rem);
      font-weight: 800;
      color: var(--text-primary);
      margin-top: var(--space-3);
      margin-bottom: var(--space-3);
    }
    .hub-section-intro {
      color: var(--text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
      max-width: 65ch;
    }
    .hub-steps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-8);
    }
    .hub-step-item {
      background: var(--surface-card, rgba(255,255,255,0.03));
      border: 1px solid var(--border-subtle, rgba(255,255,255,0.06));
      border-radius: var(--radius-lg, 0.75rem);
      padding: var(--space-6);
    }
    .hub-step-num {
      display: inline-block;
      font-size: 1.5rem;
      font-weight: 900;
      color: var(--interactive-primary, #14b8a6);
      margin-bottom: var(--space-2);
    }
    .hub-step-item h3 {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: var(--space-3);
    }
    .hub-step-item p {
      font-size: 0.95rem;
      line-height: 1.7;
      color: var(--text-secondary);
    }
    .hub-faq-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-6);
    }
    .hub-faq-item {
      background: var(--surface-card, rgba(255,255,255,0.02));
      border: 1px solid var(--border-subtle, rgba(255,255,255,0.05));
      border-radius: var(--radius-md, 0.5rem);
      padding: var(--space-5);
    }
    .hub-faq-item h3 {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: var(--space-2);
    }
    .hub-faq-item p {
      font-size: 0.925rem;
      line-height: 1.65;
      color: var(--text-secondary);
    }
  </style>
</ArabicLayout>
