---
/**
 * Hub index — /hub/
 * Lists the content hubs as a canonical card grid.
 *
 * REPORT-12: Visual refresh — removes the legacy `set:html` of generated
 * Tailwind-flavored HTML in favor of canonical styles. The generated hub
 * hero/intro HTML (auto-extracted into src/data/hub-content-inline.ts)
 * still renders verbatim inside the page; we only reskin the wrappers
 * + add a small token-only style sheet that gives orphan classes
 * (`text-white/60`, `chip`, etc.) sensible defaults.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { SITE } from '../../data/site';

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: `${SITE.url}/hub/`,
  name: 'مراكز محتوى AI | محاور مرجعية',
  description: 'مراكز محتوى مرجعية من BrightAI: حوكمة AI وامتثال سعودي وحلول تقنية وحالات استخدام وأدلة تشغيلية للوكلاء. مرجع عملي للسوق السعودي.',
  inLanguage: 'ar-SA',
  hasPart: [
    { '@type': 'WebPage', url: `${SITE.url}/hub/ai-governance/`, name: 'حوكمة الذكاء الاصطناعي' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/compliance/`, name: 'الامتثال السعودي' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/solutions/`, name: 'الحلول التقنية' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/use-cases/`, name: 'حالات الاستخدام' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/sdaia-ai-risk-management/`, name: 'الإطار الوطني لإدارة مخاطر الذكاء الاصطناعي' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/agentic-ai-governance/`, name: 'حوكمة Agentic AI التشغيلية' },
    { '@type': 'WebPage', url: `${SITE.url}/hub/agentic-ai-security/`, name: 'أمن Agentic AI' },
  ],
};

const hubJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    collectionLd,
  ],
};

const hubs = [
  {
    slug: 'ai-governance',
    eyebrow: 'حوكمة AI',
    title: 'مركز حوكمة الذكاء الاصطناعي',
    desc: 'الإطار الموحّد للحوكمة، من السياسات إلى التطبيق: تعريفات، معايير، خطوات تنفيذ، وخارطة طريق 30 يوم.',
    icon: 'mdi-brain',
    tint: 'teal',
  },
  {
    slug: 'compliance',
    eyebrow: 'الامتثال السعودي',
    title: 'مركز الامتثال للأنظمة السعودية',
    desc: 'PDPL وNCA ECC وSDAIA وساما والزكاة وضوابطها التشغيلية: شرح عملي وربط بالحلول.',
    icon: 'mdi-scale-balance',
    tint: 'indigo',
  },
  {
    slug: 'solutions',
    eyebrow: 'الحلول التقنية',
    title: 'مركز الحلول التقنية لـ Saudi AI Safety OS',
    desc: 'AI Firewall وسجل التدقيق والموافقات وملف الأدلة — كل حل تقني ومتى تحتاجه وكيف يشتغل.',
    icon: 'mdi-view-dashboard',
    tint: 'teal-indigo',
  },
  {
    slug: 'use-cases',
    eyebrow: 'حالات الاستخدام',
    title: 'مركز حالات الاستخدام بالقطاعات السعودية',
    desc: 'الصحة، البنوك، الحكومي، التعليم، المشتريات، والموارد البشرية: أمثلة وقصص نجاح تطبيقية حقيقية.',
    icon: 'mdi-hospital-building',
    tint: 'amber',
  },
  {
    slug: 'sdaia-ai-risk-management',
    eyebrow: 'دليل تنظيمي سعودي',
    title: 'إطار سدايا لإدارة مخاطر AI',
    desc: 'المراحل الرسمية، مصفوفة الاحتمالية والأثر، وقائمة تطبيق عملية للجهات الحكومية والخاصة.',
    icon: 'mdi-shield-check',
    tint: 'teal',
  },
  {
    slug: 'agentic-ai-security',
    eyebrow: 'أمن الوكلاء',
    title: 'أمن Agentic AI',
    desc: 'حماية هوية الوكيل وصلاحيات الأدوات وحدود البيانات ومسار المراقبة عند تنفيذ الأفعال.',
    icon: 'mdi-shield-lock',
    tint: 'teal',
  },
  {
    slug: 'agentic-ai-governance',
    eyebrow: 'حوكمة الوكلاء',
    title: 'حوكمة Agentic AI التشغيلية',
    desc: 'الملكية، الصلاحيات، الموافقات، دورة الحياة، وسجل الأدلة للوكلاء اللي ينفذون خطوات نيابة عن المستخدم.',
    icon: 'mdi-account-check',
    tint: 'indigo',
  },
];
---

<ArabicLayout
  title="مراكز محتوى AI | محاور مرجعية"
   description="مراكز محتوى مرجعية من BrightAI: حوكمة AI وامتثال لـ PDPL وNCA وحلول تقنية وأدلة تشغيلية للوكلاء. ابدأ رحلة التعلم والامتثال من هنا."
  canonical={`${SITE.url}/hub/`}
  hreflang={[{ lang: 'ar-SA', href: `${SITE.url}/hub/` }]}
  jsonLd={hubJsonLd as any}
  currentPath="/hub/"
  breadcrumbs={[{ name: 'مركز المعرفة', href: '/hub/' }]}
>
  <main class="hub-page">
    <header class="hub-page__hero">
      <span class="chip chip--brand">
        <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-layers"></use></svg>
        المرجع الشامل
      </span>
      <h1>كل شي تبي تعرفه عن حوكمة AI في مكان واحد</h1>
      <p class="hub-page__intro">
        حوكمة وأمان الذكاء الاصطناعي في السعودية، مرتّب لك في مراكز موضوعية. اختصر وقتك وابدأ من المركز اللي يخص سؤالك بالضبط.
      </p>
    </header>

    <nav class="hub-page__grid" aria-label="مراكز المحتوى">
      {hubs.map((hub) => (
        <a
          class="hub-card--clean"
          href={`/hub/${hub.slug}/`}
          data-hub-tint={hub.tint}
        >
          <div class="hub-card__icon" aria-hidden="true">
            <svg width="28" height="28"><use href={`/icons.svg#${hub.icon}`}></use></svg>
          </div>
          <p class="hub-card__eyebrow">{hub.eyebrow}</p>
          <h2 class="hub-card__title">{hub.title}</h2>
          <p class="hub-card__desc">{hub.desc}</p>
          <span class="hub-card__arrow">
            ادخل المركز
            <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-arrow-left"></use></svg>
          </span>
        </a>
      ))}
    </nav>

    <section class="content-cta-final" aria-labelledby="hub-cta">
      <div class="card card--cta">
        <h2 id="hub-cta">ابدأ من المركز الأقرب لقرارك الحالي</h2>
        <p>
          لو تبي توصية سريعة بدون ما تقرأ كل شي، <a href="/assessment/ai-governance-readiness/">ابدأ بتقييم جاهزية الحوكمة</a> أو <a href="/contact/">تواصل مع الفريق</a> لجلسة تشخيصية قصيرة.
        </p>
        <div class="content-cta-final__actions">
          <a href="/assessment/ai-governance-readiness/" class="btn btn--glow">
            <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-gauge"></use></svg>
            تقييم جاهزية شركتك
          </a>
          <a href="/contact/" class="btn btn--outline">
            <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-email"></use></svg>
            تواصل مع الفريق
          </a>
        </div>
      </div>
    </section>
  </main>

  <style>
    /* REPORT-12: per-hub tint via [data-hub-tint] attribute set in markup. */
    .hub-card--clean[data-hub-tint='teal'] .hub-card__icon {
      background: var(--brand-soft);
      color: var(--interactive-primary);
    }
    .hub-card--clean[data-hub-tint='indigo'] .hub-card__icon {
      background: rgba(99, 102, 241, 0.15);
      color: var(--indigo-300);
    }
    .hub-card--clean[data-hub-tint='teal-indigo'] .hub-card__icon {
      background: linear-gradient(135deg, var(--brand-soft), rgba(99, 102, 241, 0.15));
      color: var(--brand-300);
    }
    .hub-card--clean[data-hub-tint='amber'] .hub-card__icon {
      background: var(--accent-warm-soft);
      color: var(--accent-warm);
    }
  </style>
</ArabicLayout>
