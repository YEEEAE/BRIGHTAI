---
/**
 * Hub sub-pages — /hub/<slug>/
 * Enriched with full pillar articles for compliance, solutions, security, and use-cases.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import AiGovernancePillar from '../../components/hub/AiGovernancePillar.astro';
import SdaiaAiRiskManagementGuide from '../../components/hub/SdaiaAiRiskManagementGuide.astro';
import AgenticAiGovernancePillar from '../../components/hub/AgenticAiGovernancePillar.astro';
import AgenticAiSecurityPillar from '../../components/hub/AgenticAiSecurityPillar.astro';
import { getPublishedPosts } from '../../data/blog';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  const hubPages = [
    {
      slug: 'sdaia-ai-risk-management',
      title: 'الإطار الوطني لإدارة مخاطر الذكاء الاصطناعي | SDAIA-P145',
      description: 'دليل سعودي عملي يشرح إطار سدايا الوطني لإدارة مخاطر الذكاء الاصطناعي: المراحل، مصفوفة الاحتمالية والأثر، وقائمة تطبيق مؤسسية منفصلة عن قدرات BrightAI.',
      tags: ['حوكمة الذكاء الاصطناعي', 'امتثال'],
      eyebrow: 'دليل تنظيمي سعودي',
      icon: 'mdi-shield-check',
      categoryLinks: [],
    },
    {
      slug: 'agentic-ai-security',
      title: 'أمن Agentic AI: حماية الوكلاء والأدوات والبيانات | BrightAI',
      description: 'دليل معلوماتي لأمن الوكلاء في المؤسسات السعودية: الهوية، الصلاحيات، حدود البيانات، فحص الطلبات، المراقبة وأدلة الحوادث.',
      tags: ['أمن-البيانات', 'Agentic AI', 'أمان AI'],
      eyebrow: 'أمن الوكلاء',
      icon: 'mdi-shield-lock',
      categoryLinks: [],
    },
    {
      slug: 'agentic-ai-governance',
      title: 'حوكمة Agentic AI: الملكية والموافقات والأدلة | BrightAI',
      description: 'دليل تشغيلي لحوكمة الوكلاء: تحديد مالك الأعمال والمالك التقني ومالك المخاطر والمعتمد، ودورة التسجيل والتصنيف والموافقة والمراقبة والمراجعة.',
      tags: ['حوكمة الذكاء الاصطناعي', 'Agentic AI', 'إدارة المخاطر'],
      eyebrow: 'حوكمة الوكلاء',
      icon: 'mdi-account-check',
      categoryLinks: [],
    },
    {
      slug: 'ai-governance',
      title: 'وش هي حوكمة الذكاء الاصطناعي؟ | دليل سعودي عملي',
      description: 'دليل معلوماتي عملي يشرح حوكمة الذكاء الاصطناعي للمؤسسات السعودية: الفرق عن السلامة والأمن، الأدوار، تصنيف المخاطر، الإشراف البشري، الأدلة، وخارطة البدء.',
      tags: ['حوكمة الذكاء الاصطناعي'],
      eyebrow: 'مركز محتوى BrightAI',
      icon: 'mdi-brain',
      categoryLinks: [
        {
          href: '/blog/category/ai/',
          eyebrow: 'تصنيف المدونة',
          title: 'مقالات حوكمة الذكاء الاصطناعي الكاملة',
          desc: 'كل ما ينشر عن حوكمة الـ AI وأخلاقياته ومنصات BrightAI — مرتبة في تصنيف واحد للتنقل السريع.',
        },
        {
          href: '/blog/category/vision-2030/',
          eyebrow: 'تصنيف المدونة',
          title: 'مقالات رؤية 2030 وحوكمة الـ AI',
          desc: 'كيف يلتقي برنامج التحول الوطني مع حوكمة الذكاء الاصطناعي في القطاعين العام والخاص.',
        },
      ],
    },
    {
      slug: 'compliance',
      title: 'الامتثال السعودي للذكاء الاصطناعي | BrightAI',
      description: 'شرح عملي للأنظمة السعودية المطبقة على AI: PDPL وNCA ECC وSDAIA وساما والزكاة مع ضوابطها التشغيلية والرقابية. حقّق الامتثال الكامل لمؤسستك مع BrightAI.',
      tags: ['امتثال', 'أمن-البيانات'],
      eyebrow: 'مركز الامتثال والأنظمة',
      icon: 'mdi-scale-balance',
      categoryLinks: [
        {
          href: '/blog/category/data-security/',
          eyebrow: 'تصنيف المدونة',
          title: 'مقالات حماية البيانات والـ PDPL',
          desc: 'دليل عملي لـ PDPL وNCA ECC وضوابط SDAIA على بيانات الـ AI — مقالات تنفيذية جاهزة للتطبيق.',
        },
      ],
    },
    {
      slug: 'solutions',
      title: 'الحلول التقنية لحوكمة AI | مركز محتوى BrightAI',
      description: 'AI Firewall وسجل التدقيق والموافقات البشرية وملف الأدلة: كل حل تقني من BrightAI لحوكمة AI في مؤسستك بأمان. اكتشف الحل المناسب لاحتياجاتك السعودية اليوم.',
      tags: ['حلول', 'تحول-رقمي'],
      eyebrow: 'مركز الحلول والتقنيات',
      icon: 'mdi-view-dashboard',
      categoryLinks: [
        {
          href: '/blog/category/digital-transformation/',
          eyebrow: 'تصنيف المدونة',
          title: 'مقالات التحول الرقمي وحوكمة الـ AI',
          desc: 'مسارات التحول الرقمي، ISO/IEC 42001، وسجلات تدقيق AI — محتوى تطبيقي يساعدك في تخطيط المرحلة القادمة.',
        },
      ],
    },
    {
      slug: 'use-cases',
      title: 'حالات استخدام AI بالقطاعات السعودية | BrightAI',
      description: 'استكشف تطبيقات وحالات استخدام الذكاء الاصطناعي في البنوك والصحة والتصنيع والخدمات الحكومية مع أطر الحوكمة وضمان الامتثال لـ PDPL وNCA.',
      tags: ['دراسات-حالة'],
      eyebrow: 'مركز حالات الاستخدام',
      icon: 'mdi-briefcase-check',
      categoryLinks: [
        {
          href: '/blog/category/case-studies/',
          eyebrow: 'تصنيف المدونة',
          title: 'دراسات الحالة الواقعية',
          desc: 'قصص نجاح وتطبيقات عملية لشركات ومؤسسات سعودية في تبني الذكاء الاصطناعي المسؤول.',
        },
      ],
    },
    {
      slug: 'security',
      title: 'أمان الذكاء الاصطناعي | مركز محتوى BrightAI',
      description: 'دليل أمان الذكاء الاصطناعي في السعودية: جدار حماية AI Firewall، منع حقن الأوامر، فحص PII، واختبارات الفريق الأحمر AI Red Teaming.',
      tags: ['أمن-البيانات', 'أمان AI'],
      eyebrow: 'مركز أمان الذكاء الاصطناعي',
      icon: 'mdi-shield-lock',
      categoryLinks: [
        {
          href: '/blog/category/data-security/',
          eyebrow: 'تصنيف المدونة',
          title: 'مقالات أمن البيانات و AI Firewall',
          desc: 'كل ما ينشر عن جدار حماية AI، اختبار الاختراق، منع تسريب البيانات، وضوابط NCA ECC لحماية بيانات الذكاء الاصطناعي.',
        },
      ],
    },
  ];
  return hubPages.map(page => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const isAiGovernancePillar = page.slug === 'ai-governance';
const isSdaiaRiskGuide = page.slug === 'sdaia-ai-risk-management';
const isAgenticAiGovernance = page.slug === 'agentic-ai-governance';
const isAgenticAiSecurity = page.slug === 'agentic-ai-security';

const relatedPosts = (await getPublishedPosts()).filter(post =>
  page.tags.some(tag => post.tags.some(pt => pt.includes(tag) || tag.includes(pt)))
).slice(0, 6);

const canonicalUrl = `${SITE.url}/hub/${page.slug}/`;

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: canonicalUrl,
  name: page.title,
  description: page.description,
  inLanguage: 'ar-SA',
  isPartOf: { '@type': 'CollectionPage', url: `${SITE.url}/hub/` },
};

const hubSlugJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [collectionLd],
};
---

<ArabicLayout
  title={page.title}
  description={page.description}
  canonical={canonicalUrl}
  hreflang={[{ lang: 'ar-SA', href: canonicalUrl }]}
  jsonLd={hubSlugJsonLd as any}
  currentPath={`/hub/${page.slug}/`}
  breadcrumbs={[{ name: 'مركز المعرفة', href: '/hub/' }, { name: page.title, href: `/hub/${page.slug}/` }]}
>
  <main class="hub-subpage">
    {isSdaiaRiskGuide ? (
      <SdaiaAiRiskManagementGuide />
    ) : isAgenticAiSecurity ? (
      <AgenticAiSecurityPillar />
    ) : isAgenticAiGovernance ? (
      <AgenticAiGovernancePillar />
    ) : isAiGovernancePillar ? (
      <AiGovernancePillar />
    ) : (
      <>
        <header class="hub-subpage__hero">
          <span class="chip chip--brand hub-subpage__eyebrow">
            <svg aria-hidden="true" width="14" height="14"><use href={`/icons.svg#${page.icon}`}></use></svg>
            {page.eyebrow}
          </span>
          <h1>{page.title.replace(' | BrightAI', '').replace(' | مركز محتوى BrightAI', '')}</h1>
          <p>{page.description}</p>
        </header>

        <!-- محتوى دليلي تحريري شامل لرفع نسبة النص -->
        <div class="article-content" style="max-width: 52rem; margin: 0 auto; padding: var(--space-6) 0;">
          {page.slug === 'compliance' && (
            <div>
              <h2>دليل الامتثال التنظيمي للذكاء الاصطناعي في المملكة العربية السعودية</h2>
              <p>تشهد المملكة العربية السعودية نهضة تنظيمية رائدة تهدف إلى تمكين الابتكار التقني مع حماية السيادة الرقمية وخصوصية البيانات الشخصية. لم يعد استخدام الذكاء الاصطناعي في المنشآت السعودية خياراً تقنياً معزولاً عن الأطر القانونية؛ بل يخضع لشبكة متكاملة من الضوابط الصادرة عن <strong>الهيئة السعودية للبيانات والذكاء الاصطناعي (سدايا)</strong> و<strong>الهيئة الوطنية للأمن السيبراني (NCA)</strong> و<strong>البنك المركزي السعودي (SAMA)</strong>.</p>
              
              <h3>1. نظام حماية البيانات الشخصية (PDPL) والذكاء الاصطناعي</h3>
              <p>يعد نظام حماية البيانات الشخصية الركيزة القانونية الأساسية لمعالجة البيانات في المملكة. يفرض النظام متطلبات مشددة عند تدريب أو استخدام النماذج اللغوية الكبيرة (LLMs):</p>
              <ul>
                <li><strong>مبدأ تقليل البيانات (Data Minimization):</strong> حظر إرسال أي بيانات شخصية غير ضرورية للنموذج الذكي.</li>
                <li><strong>التعمية والإخفاء (Anonymization & Pseudonymization):</strong> إزالة المعرفات الشخصية (الاسم، الهوية، الهاتف، البريد) قبل تمرير المدخلات للنواة الذكية.</li>
                <li><strong>الشفافية وحق الاعتراض:</strong> إشعار أصحاب البيانات عندما تتخذ القرارات المؤثرة بواسطة خوارزميات آلية بالكامل.</li>
              </ul>

              <h3>2. ضوابط الأمن السيبراني للذكاء الاصطناعي (NCA ECC)</h3>
              <p>تتطلب ضوابط الهيئة الوطنية للأمن السيبراني حماية سلاسل إمداد البرمجيات وخوادم الذكاء الاصطناعي من هجمات التسميم البياني (Data Poisoning) وحقن الأوامر غير المباشر (Indirect Prompt Injection). تتكامل حلول BrightAI لتقديم سجلات تدقيق تشغيلية تثبت سلامة النماذج والسياسات الأمنية المعتمدة.</p>

              <h3>3. إرشادات سدايا للذكاء الاصطناعي التوليدي والمسؤول</h3>
              <p>حددت سدايا مبادئ أخلاقيات الذكاء الاصطناعي السبعة (العدالة، الخصوصية، الشفافية، المسؤولية، الأمان، الموثوقية، والإنسانية). تساعد منصة BrightAI المنشآت على ترجمة هذه المبادئ إلى مقاييس رقمية وسجلات مخاطر واضحة.</p>
            </div>
          )}

          {page.slug === 'security' && (
            <div>
              <h2>أمان الذكاء الاصطناعي: حماية النماذج وسرية الأصول المؤسسية</h2>
              <p>مع اعتماد الشركات على نماذج الذكاء الاصطناعي التوليدي، ظهرت نواقل تهديد جديدة لا تستطيع الجدران النارية التقليدية للشبكات رصدها أو إيقافها. يتطلب أمان الذكاء الاصطناعي فهماً عميقاً لسلوك النماذج وطبيعة المدخلات النصية.</p>

              <h3>1. جدار حماية الذكاء الاصطناعي (AI Firewall)</h3>
              <p>يعمل AI Firewall كحاجز تفتيش ذكي يفحص كل طلب ومخرج بين المستخدم والنموذج. يقوم الجدار الناري بالمهام الحيوية التالية:</p>
              <ul>
                <li><strong>منع هجمات Jailbreak وPrompt Injection:</strong> حجب المحاولات الخبيثة للالتفاف على قيود النموذج أو استخراج التعليمات النظامية المخفية (System Prompts).</li>
                <li><strong>فحص وتعصيب PII:</strong> تعمية البيانات الشخصية والسرية تلقائياً قبل مغادرتها حدود المنشأة.</li>
                <li><strong>منع استخراج البيانات وتسميم المخرجات:</strong> التأكد من عدم تسريب أسرار البرمجة ومفاتيح API وقواعد البيانات.</li>
              </ul>

              <h3>2. اختبارات الفريق الأحمر (AI Red Teaming)</h3>
              <p>يتضمن اختبار الأمان السيبراني للذكاء الاصطناعي محاكاة هجمات الخصوم لاكتشاف نقاط الضعف في منطق النموذج، وقدرته على مقاومة الهندسة الاجتماعية الخوارزمية، وضمان عدم توليد محتوى ضار أو مخالف للقوانين واللوائح السعودية.</p>
            </div>
          )}

          {page.slug === 'solutions' && (
            <div>
              <h2>الحلول التقنية المتكاملة لمنصة BrightAI Kernel</h2>
              <p>توفر BRIGHTAI منظومة تقنية شاملة تمكن المنشآت السعودية من تبني الذكاء الاصطناعي بأقصى درجات الكفاءة التشغيلية والامتثال السيادي:</p>

              <h3>1. منصة حوكمة الذكاء الاصطناعي (Governance Platform)</h3>
              <p>لوحة قيادة مركزية توفر جرد شامل لكافة أدوات الذكاء الاصطناعي في المنشأة (Shadow AI Discovery)، وتصنيفها حسب درجات المخاطر والحساسية، مع تحديد المالك المسؤول وسياسات الوصول المعتمدة.</p>

              <h3>2. سجل تدقيق الذكاء الاصطناعي المشفر (AI Audit Trail)</h3>
              <p>سجل غير قابل للتعديل يوثق كل معاملة، استعلام، وتوصية آلية مع ختم زمني مشفر بـ SHA-256، مما يمنح الإدارة وفرق المراجعة أدلة جاهزة للتدقيق أمام هيئات الرقابة الحكومية.</p>

              <h3>3. حلقة الموافقات والرقابة البشرية (Human-in-the-Loop)</h3>
              <p>مسارات عمل ذكية تفرض اشتراط موافقة الموظف المختص على القرارات الآلية الحساسة (مثل منح الائتمان، التشخيص الطبي، أو إنهاء الخدمات) لضمان المسؤولية الإنسانية ومنع الانحياز.</p>
            </div>
          )}

          {page.slug === 'use-cases' && (
            <div>
              <h2>حالات استخدام وتطبيقات الذكاء الاصطناعي في القطاعات الحيوية السعودية</h2>
              <p>تتعدد مجالات الاستفادة من حلول الذكاء الاصطناعي والأتمتة في السوق السعودي، ولكن النجاح الحقيقي يرتبط بوجود إطار حوكمة يحمي الاستثمار ويسرع العائد:</p>

              <h3>1. القطاع المصرفي والتقنية المالية (FinTech)</h3>
              <p>استخدام الذكاء الاصطناعي في كشف الاحتيال المالي، وتحليل الجدارة الائتمانية، وخدمة العملاء عبر المساعدين الرقميين الذكيين، مع ضمان الامتثال التام لتعليمات البنك المركزي (SAMA) وحماية الآيبان وبيانات البطاقات.</p>

              <h3>2. قطاع الرعاية الصحية والمستشفيات</h3>
              <p>تسريع تلخيص الملفات الطبية المعقدة، وأرشفة تقارير الفحوصات والأشعة، ودعم الاستشارات السريرية مع حماية 100% لبيانات وسجلات المرضى وفق نظام حماية البيانات الشخصية.</p>

              <h3>3. قطاع التصنيع والخدمات اللوجستية</h3>
              <p>أتمتة سلاسل الإمداد، التنبؤ بأعطال المعدات وخطوط الإنتاج، ومراقبة الجودة الصناعية بواسطة الرؤية الحاسوبية (Computer Vision)، مع الحفاظ على الملكية الفكرية للبراءات والمعادلات الصناعية.</p>
            </div>
          )}
        </div>
      </>
    )}
  </main>

  {relatedPosts.length > 0 && (
    <section class="hub-related" aria-labelledby="hub-related">
      <h2 id="hub-related">📝 مقالات وأدلة ذات صلة بالمركز</h2>
      <div class="hub-related-grid">
        {relatedPosts.map(post => (
          <a href={`/blog/${post.slug}/`} class="hub-related-card">
            <p class="hub-related-card__cat">{post.category}</p>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {page.categoryLinks && page.categoryLinks.length > 0 && (
    <section class="hub-related hub-categories" aria-labelledby="hub-categories">
      <h2 id="hub-categories">📚 تصفّح المقالات حسب التصنيف المخصص</h2>
      <p class="hub-categories__lead">
        للاطلاع على التغطية التفصيلية لمواضيع هذا المركز، استكشف الأقسام التالية:
      </p>
      <div class="hub-related-grid">
        {page.categoryLinks.map((link) => (
          <a href={link.href} class="hub-related-card hub-category-card">
            <p class="hub-related-card__cat">{link.eyebrow}</p>
            <h3>{link.title}</h3>
            <p>{link.desc}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</ArabicLayout>
