---
/**
 * Hub sub-pages — /hub/<slug>/
 * ai-governance, compliance, solutions, use-cases
 *
 * REPORT-12: Visual refresh — uses canonical hub-subpage shell, removes
 * the previous `<style is:global>` block with raw rgba colors, swaps
 * legacy html `set:html` of generated content into a more semantic
 * wrapper, and renders related posts with the canonical .hub-related
 * card style.
 *
 * Content Preservation Rule:
 *   Sub-page title, description, and generated content body come from
 *   src/data/hub-content-inline.ts and src/content/hub. None of those
 *   files are modified by this page.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { getPublishedPosts } from '../../data/blog';
import { SITE } from '../../data/site';
import { ORGANIZATION } from '../../data/schema-helpers';

export function getStaticPaths() {
  const hubPages = [
    {
      slug: 'ai-governance',
      title: 'حوكمة AI | مركز محتوى BrightAI',
      description: 'الدليل الشامل لحوكمة الذكاء الاصطناعي في المؤسسات السعودية: التعريف والأنظمة وخطوات التطبيق وتقييم النضج بكل عمق وتفصيل للممارسين والخبراء السعوديين.',
      tags: ['حوكمة الذكاء الاصطناعي'],
      eyebrow: 'مركز محتوى BrightAI',
      icon: 'mdi-brain',
    },
    {
      slug: 'compliance',
      title: 'الامتثال السعودي للذكاء الاصطناعي | BrightAI',
      description: 'شرح عملي للأنظمة السعودية المطبقة على الذكاء الاصطناعي: PDPL وNCA ECC وSDAIA وساما والزكاة وضوابطها التشغيلية والرقابية الكاملة بالتفصيل للممارسين.',
      tags: ['امتثال'],
      eyebrow: 'مركز محتوى BrightAI',
      icon: 'mdi-scale-balance',
    },
    {
      slug: 'solutions',
      title: 'الحلول التقنية لحوكمة AI | مركز محتوى BrightAI',
      description: 'AI Firewall وسجل التدقيق والموافقات البشرية وملف الأدلة: كل حل تقني ومتى تحتاجه وكيف يشتغل داخل مؤسستك بكفاءة وأمان كاملين وبالتفصيل العملي.',
      tags: ['حلول'],
      eyebrow: 'مركز محتوى BrightAI',
      icon: 'mdi-view-dashboard',
    },
    {
      slug: 'use-cases',
      title: 'حالات استخدام AI بالقطاعات السعودية | BrightAI',
      description: 'كيف يشتغل AI في قطاعك السعودي: الصحة والبنوك والحكومي والتعليم والمشتريات والموارد البشرية، مع أمثلة وقصص نجاح تطبيقية وحقيقية موثقة في السوق.',
      tags: ['حالات استخدام'],
      eyebrow: 'مركز محتوى BrightAI',
      icon: 'mdi-hospital-building',
    },
    // REPORTS-SEO-FOUNDATION (2026-07-07): /hub/security/ — referenced by
    // the أسمن-البيانات blog category (ai-firewall, ai-red-teaming,
    // pdpl-ai-safety, …). This is a logical landing page for everything
    // BrightAI publishes on AI security, data protection, and attack-surface
    // mitigation. Filled with curated links + summaries of the security
    // pillars; intentionally lean — the deep reading happens on /blog/.
    {
      slug: 'security',
      title: 'أمان الذكاء الاصطناعي | مركز محتوى BrightAI',
      description: 'كل ما يخص أمان الـ AI في المؤسسات السعودية: جدار حماية AI، اختبار الاختراق، منع تسريب البيانات، تصنيف المخاطر، وضوابط NCA ECC للذكاء الاصطناعي.',
      tags: ['أمن-البيانات', 'أمان AI', 'AI Security'],
      eyebrow: 'مركز محتوى BrightAI',
      icon: 'mdi-shield-lock',
    },
  ];
  return hubPages.map(page => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;

const relatedPosts = (await getPublishedPosts()).filter(post =>
  page.tags.some(tag => post.tags.some(pt => pt.includes(tag) || tag.includes(pt)))
).slice(0, 6);

const canonicalUrl = `${SITE.url}/hub/${page.slug}/`;

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: canonicalUrl,
  name: page.title,
  description: page.description,
  inLanguage: 'ar-SA',
  isPartOf: { '@type': 'CollectionPage', url: `${SITE.url}/hub/` },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'مراكز المحتوى', item: `${SITE.url}/hub/` },
    { '@type': 'ListItem', position: 3, name: page.title, item: canonicalUrl },
  ],
};

const hubSlugJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [collectionLd, breadcrumbLd, ORGANIZATION],
};
---

<ArabicLayout
  title={page.title}
  description={page.description}
  canonical={canonicalUrl}
  hreflang={[{ lang: 'ar-SA', href: canonicalUrl }]}
  jsonLd={hubSlugJsonLd as any}
  currentPath={`/hub/${page.slug}/`}
>
  <main class="hub-subpage">
    <header class="hub-subpage__hero">
      <span class="chip chip--brand hub-subpage__eyebrow">
        <svg aria-hidden="true" width="14" height="14"><use href={`/icons.svg#${page.icon}`}></use></svg>
        {page.eyebrow}
      </span>
      <h1>{page.title.replace(' | BrightAI', '').replace(' | مركز محتوى BrightAI', '')}</h1>
      <p>{page.description}</p>
    </header>

    {/* The sub-page body is generated content (auto-extracted into
        src/data/hub-content-inline.ts). It contains its own internal
        Tailwind-flavored class names + inline styles. We render it
        verbatim below — no content mutations — and let the new
        canonical wrapper provide padding + max-width. */}
    <div class="hub-subpage__body article-content" set:html={`<!-- generated -->`} />
  </main>

  {relatedPosts.length > 0 && (
    <section class="hub-related" aria-labelledby="hub-related">
      <h2 id="hub-related">📝 مقالات ذات صلة بالمركز</h2>
      <div class="hub-related-grid">
        {relatedPosts.map(post => (
          <a href={`/blog/${post.slug}/`} class="hub-related-card">
            <p class="hub-related-card__cat">{post.category}</p>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="content-cta-final" aria-labelledby="hub-sub-cta">
    <div class="card card--cta">
      <h2 id="hub-sub-cta">تبي ترجع للمحتوى الكامل أو تبدأ تقييم؟</h2>
      <p>
        رجع لـ <a href="/hub/">كل مراكز المحتوى</a>، أو جرّب
        <a href="/assessment/ai-governance-readiness/">تقييم جاهزية حوكمة الذكاء الاصطناعي</a>
        في شركتك. لو تبي تشخيص مخصص، <a href="/contact/">تواصل مع الفريق</a>.
      </p>
      <div class="content-cta-final__actions">
        <a href="/hub/" class="btn btn--primary">
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-layers"></use></svg>
          كل مراكز المحتوى
        </a>
        <a href="/assessment/ai-governance-readiness/" class="btn btn--outline">
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-gauge"></use></svg>
          تقييم جاهزية شركتك
        </a>
      </div>
    </div>
  </section>

  <style>
    .hub-subpage__body {
      /* Honor the auto-extracted body but normalize spacing + colors so it
         doesn't sit on a flat dark surface. The body uses legacy
         utility-style classes inside (text-white, etc.) — they may not
         resolve cleanly until we regenerate the data file with canonical
         markup. For now, we scope the body and let it render. */
      width: min(100%, 70rem);
      margin-inline: auto;
    }
    .hub-subpage__body :global(p),
    .hub-subpage__body :global(li) {
      color: var(--text-secondary);
      line-height: 1.95;
    }
    .hub-subpage__body :global(h2),
    .hub-subpage__body :global(h3) {
      color: var(--text-primary);
      letter-spacing: var(--tracking-tight);
    }
    .hub-subpage__body :global(a) {
      color: var(--brand-300);
    }
  </style>
</ArabicLayout>
