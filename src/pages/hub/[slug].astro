---
/**
 * Hub sub-pages — /hub/<slug>/
 * ai-governance, compliance, solutions, use-cases
 *
 * REPORT-12: Visual refresh — uses canonical hub-subpage shell, removes
 * the previous `<style is:global>` block with raw rgba colors, swaps
 * legacy html `set:html` of generated content into a more semantic
 * wrapper, and renders related posts with the canonical .hub-related
 * card style.
 *
 * Content Preservation Rule:
 *   Sub-page title, description, and generated content body come from
 *   src/data/hub-content-inline.ts and src/content/hub. None of those
 *   files are modified by this page.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import AiGovernancePillar from '../../components/hub/AiGovernancePillar.astro';
import SdaiaAiRiskManagementGuide from '../../components/hub/SdaiaAiRiskManagementGuide.astro';
import AgenticAiGovernancePillar from '../../components/hub/AgenticAiGovernancePillar.astro';
import { getPublishedPosts } from '../../data/blog';
import { SITE } from '../../data/site';
// BAI-SEO-003-S3 (2026-07-18): ORGANIZATION import removed — foundation
// Schema.astro emits the canonical Organization @id.
// KRN-012 / EXEC-12: static literal — sanitize for consistency (no-op for HTML comment)
import DOMPurify from 'isomorphic-dompurify';

export function getStaticPaths() {
  const hubPages = [
    {
      slug: 'sdaia-ai-risk-management',
      title: 'الإطار الوطني لإدارة مخاطر الذكاء الاصطناعي | SDAIA-P145',
      description: 'دليل سعودي عملي يشرح إطار سدايا الوطني لإدارة مخاطر الذكاء الاصطناعي: المراحل، مصفوفة الاحتمالية والأثر، وقائمة تطبيق مؤسسية منفصلة عن قدرات BrightAI.',
      tags: ['حوكمة الذكاء الاصطناعي', 'امتثال'],
      eyebrow: 'دليل تنظيمي سعودي',
      icon: 'mdi-shield-check',
      categoryLinks: [],
    },
    {
      slug: 'agentic-ai-governance',
      title: 'حوكمة Agentic AI: الملكية والموافقات والأدلة | BrightAI',
      description: 'دليل تشغيلي لحوكمة الوكلاء: تحديد مالك الأعمال والمالك التقني ومالك المخاطر والمعتمد، ودورة التسجيل والتصنيف والموافقة والمراقبة والمراجعة.',
      tags: ['حوكمة الذكاء الاصطناعي', 'Agentic AI', 'إدارة المخاطر'],
      eyebrow: 'حوكمة الوكلاء',
      icon: 'mdi-account-check',
      categoryLinks: [],
    },
    {
      slug: 'ai-governance',
      title: 'وش هي حوكمة الذكاء الاصطناعي؟ | دليل سعودي عملي',
      description: 'دليل معلوماتي عملي يشرح حوكمة الذكاء الاصطناعي للمؤسسات السعودية: الفرق عن السلامة والأمن، الأدوار، تصنيف المخاطر، الإشراف البشري، الأدلة، وخارطة البدء.',
      tags: ['حوكمة الذكاء الاصطناعي'],
      eyebrow: 'مركز محتوى BrightAI',
      icon: 'mdi-brain',
      categoryLinks: [
        {
          href: '/blog/category/ذكاء-اصطناعي/',
          eyebrow: 'تصنيف المدونة',
          title: 'مقالات حوكمة الذكاء الاصطناعي الكاملة',
          desc: 'كل ما ينشر عن حوكمة الـ AI وأخلاقياته ومنصات BrightAI — مرتبة في تصنيف واحد للتنقل السريع.',
        },
        {
          href: '/blog/category/رؤية-2030/',
          eyebrow: 'تصنيف المدونة',
          title: 'مقالات رؤية 2030 وحوكمة الـ AI',
          desc: 'كيف يلتقي برنامج التحول الوطني مع حوكمة الذكاء الاصطناعي في القطاعين العام والخاص.',
        },
      ],
    },
    {
      slug: 'compliance',
      title: 'الامتثال السعودي للذكاء الاصطناعي | BrightAI',
      description: 'شرح عملي للأنظمة السعودية المطبقة على AI: PDPL وNCA ECC وSDAIA وساما والزكاة مع ضوابطها التشغيلية والرقابية. حقّق الامتثال الكامل لمؤسستك مع BrightAI.',
      tags: ['امتثال'],
      eyebrow: 'مركز محتوى BrightAI',
      icon: 'mdi-scale-balance',
      categoryLinks: [
        {
          href: '/blog/category/أمن-البيانات/',
          eyebrow: 'تصنيف المدونة',
          title: 'مقالات حماية البيانات والـ PDPL',
          desc: 'دليل عملي لـ PDPL وNCA ECC وضوابط SDAIA على بيانات الـ AI — مقالات تنفيذية جاهزة للتطبيق.',
        },
      ],
    },
    {
      slug: 'solutions',
      title: 'الحلول التقنية لحوكمة AI | مركز محتوى BrightAI',
      description: 'AI Firewall وسجل التدقيق والموافقات البشرية وملف الأدلة: كل حل تقني من BrightAI لحوكمة AI في مؤسستك بأمان. اكتشف الحل المناسب لاحتياجاتك السعودية اليوم.',
      tags: ['حلول'],
      eyebrow: 'مركز محتوى BrightAI',
      icon: 'mdi-view-dashboard',
      categoryLinks: [
        {
          href: '/blog/category/تحول-رقمي/',
          eyebrow: 'تصنيف المدونة',
          title: 'مقالات التحول الرقمي وحوكمة الـ AI',
          desc: 'مسارات التحول الرقمي، ISO/IEC 42001، وسجلات تدقيق AI — محتوى تطبيقي يساعدك في تخطيط المرحلة القادمة.',
        },
      ],
    },
    {
      slug: 'use-cases',
      title: 'حالات استخدام AI بالقطاعات السعودية | BrightAI',
      description: 'حالات استخدام AI في القطاعات السعودية: الصحة والبنوك والحكومي والتعليم والمشتريات. أمثلة وقصص نجاح تطبيقية من السوق السعودي. اكتشف كيف يناسبك الحل مع BrightAI.',
      tags: ['حالات استخدام'],
      eyebrow: 'مركز محتوى BrightAI',
      icon: 'mdi-hospital-building',
      categoryLinks: [
        {
          href: '/blog/category/دراسات-حالة/',
          eyebrow: 'تصنيف المدونة',
          title: 'دراسات حالة سعودية من السوق',
          desc: 'تطبيقات حقيقية لـ AI في الصحة والبنوك والحكومة والتعليم — أرقام ونتائج وقصص نجاح من السوق السعودي.',
        },
        {
          href: '/blog/category/رؤية-2030/',
          eyebrow: 'تصنيف المدونة',
          title: 'مقالات رؤية 2030 في القطاعات',
          desc: 'كيف يدعم الذكاء الاصطناعي مستهدفات رؤية 2030 في القطاعات الحكومية والصحية والمالية.',
        },
      ],
    },
    // REPORTS-SEO-FOUNDATION (2026-07-07): /hub/security/ — referenced by
    // the أسمن-البيانات blog category (ai-firewall, ai-red-teaming,
    // pdpl-ai-safety, …). This is a logical landing page for everything
    // BrightAI publishes on AI security, data protection, and attack-surface
    // mitigation. Filled with curated links + summaries of the security
    // pillars; intentionally lean — the deep reading happens on /blog/.
    {
      slug: 'security',
      title: 'أمان الذكاء الاصطناعي | مركز محتوى BrightAI',
      description: 'كل ما يخص أمان AI في المؤسسات السعودية: جدار حماية واختبار اختراق ومنع تسريب البيانات وتصنيف المخاطر وفق NCA ECC. احمي مؤسستك السعودية مع BrightAI وابدأ الآن.',
      tags: ['أمن-البيانات', 'أمان AI', 'AI Security'],
      eyebrow: 'مركز محتوى BrightAI',
      icon: 'mdi-shield-lock',
      categoryLinks: [
        {
          href: '/blog/category/أمن-البيانات/',
          eyebrow: 'تصنيف المدونة',
          title: 'مقالات أمن البيانات و AI Firewall',
          desc: 'كل ما ينشر عن جدار حماية AI، اختبار الاختراق، منع تسريب البيانات، وضوابط NCA ECC لحماية بيانات الذكاء الاصطناعي.',
        },
      ],
    },
  ];
  return hubPages.map(page => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const isAiGovernancePillar = page.slug === 'ai-governance';
const isSdaiaRiskGuide = page.slug === 'sdaia-ai-risk-management';
const isAgenticAiGovernance = page.slug === 'agentic-ai-governance';

const relatedPosts = (await getPublishedPosts()).filter(post =>
  page.tags.some(tag => post.tags.some(pt => pt.includes(tag) || tag.includes(pt)))
).slice(0, 6);

const canonicalUrl = `${SITE.url}/hub/${page.slug}/`;

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  url: canonicalUrl,
  name: page.title,
  description: page.description,
  inLanguage: 'ar-SA',
  isPartOf: { '@type': 'CollectionPage', url: `${SITE.url}/hub/` },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'مراكز المحتوى', item: `${SITE.url}/hub/` },
    { '@type': 'ListItem', position: 3, name: page.title, item: canonicalUrl },
  ],
};

// BAI-SEO-003-S3 (2026-07-18): Organization and BreadcrumbList are emitted
// by the foundation Schema.astro. We keep only the page-specific
// CollectionPage node to avoid duplicate @id warnings.
const hubSlugJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [collectionLd],
};
---

<ArabicLayout
  title={page.title}
  description={page.description}
  canonical={canonicalUrl}
  hreflang={[{ lang: 'ar-SA', href: canonicalUrl }]}
  jsonLd={hubSlugJsonLd as any}
  currentPath={`/hub/${page.slug}/`}
  breadcrumbs={[{ name: 'مركز المعرفة', href: '/hub/' }, { name: page.title, href: `/hub/${page.slug}/` }]}
>
  <main class="hub-subpage">
    {isSdaiaRiskGuide ? (
      <SdaiaAiRiskManagementGuide />
    ) : isAgenticAiGovernance ? (
      <AgenticAiGovernancePillar />
    ) : isAiGovernancePillar ? (
      <AiGovernancePillar />
    ) : (
      <>
        <header class="hub-subpage__hero">
          <span class="chip chip--brand hub-subpage__eyebrow">
            <svg aria-hidden="true" width="14" height="14"><use href={`/icons.svg#${page.icon}`}></use></svg>
            {page.eyebrow}
          </span>
          <h1>{page.title.replace(' | BrightAI', '').replace(' | مركز محتوى BrightAI', '')}</h1>
          <p>{page.description}</p>
        </header>
        <div class="hub-subpage__body article-content" set:html={DOMPurify.sanitize(`<!-- generated -->`)} />
      </>
    )}
  </main>

  {relatedPosts.length > 0 && (
    <section class="hub-related" aria-labelledby="hub-related">
      <h2 id="hub-related">📝 مقالات ذات صلة بالمركز</h2>
      <div class="hub-related-grid">
        {relatedPosts.map(post => (
          <a href={`/blog/${post.slug}/`} class="hub-related-card">
            <p class="hub-related-card__cat">{post.category}</p>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {page.categoryLinks && page.categoryLinks.length > 0 && (
    <section class="hub-related hub-categories" aria-labelledby="hub-categories">
      <h2 id="hub-categories">📚 تصفّح المدونة حسب الموضوع</h2>
      <p class="hub-categories__lead">
        لو تبي تتعمّق في جانب معيّن من هذا المركز، هذي تصنيفات المدونة اللي تخدمك:
      </p>
      <div class="hub-related-grid">
        {page.categoryLinks.map((link) => (
          <a href={link.href} class="hub-related-card hub-category-card">
            <p class="hub-related-card__cat">{link.eyebrow}</p>
            <h3>{link.title}</h3>
            <p>{link.desc}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="content-cta-final" aria-labelledby="hub-sub-cta">
    <div class="card card--cta">
      <h2 id="hub-sub-cta">تبي ترجع للمحتوى الكامل أو تبدأ تقييم؟</h2>
      <p>
        رجع لـ <a href="/hub/">كل مراكز المحتوى</a>، أو جرّب
        <a href="/assessment/ai-governance-readiness/">تقييم جاهزية حوكمة الذكاء الاصطناعي</a>
        في شركتك. لو تبي تشخيص مخصص، <a href="/contact/">تواصل مع الفريق</a>.
      </p>
      <div class="content-cta-final__actions">
        <a href="/hub/" class="btn btn--primary">
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-layers"></use></svg>
          كل مراكز المحتوى
        </a>
        <a href="/assessment/ai-governance-readiness/" class="btn btn--outline">
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-gauge"></use></svg>
          تقييم جاهزية شركتك
        </a>
      </div>
    </div>
  </section>

  <style>
    .hub-subpage__body {
      /* Honor the auto-extracted body but normalize spacing + colors so it
         doesn't sit on a flat dark surface. The body uses legacy
         utility-style classes inside (text-white, etc.) — they may not
         resolve cleanly until we regenerate the data file with canonical
         markup. For now, we scope the body and let it render. */
      width: min(100%, 70rem);
      margin-inline: auto;
    }
    .hub-subpage__body :global(p),
    .hub-subpage__body :global(li) {
      color: var(--text-secondary);
      line-height: 1.95;
    }
    .hub-subpage__body :global(h2),
    .hub-subpage__body :global(h3) {
      color: var(--text-primary);
      letter-spacing: var(--tracking-tight);
    }
    .hub-subpage__body :global(a) {
      color: var(--brand-300);
    }
    .hub-categories__lead {
      color: var(--text-secondary);
      font-size: var(--text-base);
      margin: 0 0 var(--space-4);
      max-width: 60ch;
    }
    .hub-category-card {
      border-color: var(--brand-400);
    }
    .hub-category-card:hover {
      border-color: var(--interactive-primary);
      background: linear-gradient(180deg, transparent, rgba(34, 211, 238, 0.04));
    }
  </style>
</ArabicLayout>
