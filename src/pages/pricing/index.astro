<!-- BAI-CRO-003 (2026-07-18): إعادة بناء صفحة /pricing/ وفق MASTER-CRO-AUDIT-AR.md Prompt 3.
     - 3 عروض حوكمة مؤسسية: Assessment / 30-Day Pilot (الموصى به) / Enterprise Rollout
     - لا فئات شات بوت/وكلاء/أتمتة تنافس منصة الحوكمة (Section 8 في الـ audit)
     - إزالة مرساة سعر منخفضة من العرض الرئيسي (Section 4 المشكلة #5)
     - كل عرض يوضح: مناسب لمن، النطاق، المدة، المخرجات، ما لا يشمله، معايير النجاح، الخطوة التالية
     - CTA الأساسي = "احجز ديمو حوكمة مخصص" (Section 7)، ثانوي = "ابدأ تقييم الجاهزية"
     - كل CTA يحمل data-cta + data-position + data-offer + data-page-type
     - FAQ للاعتراضات (8): استضافة، بيانات، تكامل، شراء، NDA، SLA، دعم، امتثال
     - جدول مقارنة متجاوب + scope/caption للـ keyboard
     - Service Schema للعروض الثلاثة + FAQPage Schema
     - قسم "عوامل التسعير" يفسر لماذا "مخصص"
     - قسم "روابط القرار" بدل قسم الروابط الـ SEO (3 أسئلة شائعة → 3 وجهات)
     - لا كسر canonical/hreflang/schema الأساسية
     - لا اختراع أسعار/سلا/اعتمادات/عوائد
-->
---
import ArabicLayout from '../../layouts/ArabicLayout.astro';


const title = 'باقات وأسعار حوكمة AI المؤسسية | 3 عروض واضحة';
const description = '3 عروض حوكمة AI مؤسسية من BrightAI وفق PDPL وNCA: تقييم جاهزية، Pilot 30 يوم، Enterprise Rollout. ابدأ بتقييم مجاني واكتشف الحزمة الأنسب لمؤسستك.';
const canonical = 'https://brightai.live/pricing/';
const whatsapp = 'https://wa.me/966538229013?text=%D8%A7%D9%84%D8%B3%D9%84%D8%A7%D9%85%20%D8%B9%D9%84%D9%8A%D9%83%D9%85%D8%8C%20%D8%A3%D8%B1%D9%8A%D8%AF%20%D9%86%D8%B7%D8%A7%D9%82%20Pilot%20%D8%AD%D9%88%D9%83%D9%85%D8%A9%20AI%20%D9%85%D8%A4%D8%B3%D8%B3%D9%8A%20%D9%85%D8%B9%20Bright%20AI.';

// العروض الثلاثة — single source of truth للبطاقات + الجدول + Service Schema
const offers = [
  {
    id: 'assessment',
    name: 'تقييم جاهزية حوكمة AI',
    tagline: 'نقطة البداية المؤسسية',
    description: 'جلسة اكتشاف وجرد مخاطر لحالات استخدام AI في منشأتك قبل أي التزام تقني أو مالي.',
    price: 'مخصص',
    priceNote: 'حسب حجم المؤسسة وعدد حالات الاستخدام',
    cta: 'ابدأ تقييم الجاهزية',
    ctaHref: '/assessment/ai-governance-readiness/',
    ctaTarget: '_self',
    recommended: false,
    suitableFor: [
      'CISO وDPO اللذان يبنون حالة عمل لحوكمة AI',
      'CIO الذي يستعد لقرار شراء خلال 60-90 يوم',
      'الشركات في مرحلة استكشاف لم تلتزم بعد بأي منصة',
    ],
    scope: [
      'حصر حالات استخدام AI الحالية والمخطط لها (3-5 أقسام عادةً)',
      'تصنيف المخاطر حسب الحساسية والبيانات المتداولة',
      'Gap analysis مقابل PDPL/NCA ECC/SDAIA Generative AI Guidelines',
      'توصية واضحة بالمرحلة التالية (Pilot أو مؤجّل)',
    ],
    duration: '5-10 أيام عمل',
    durationNote: 'لا يتطلب نشر أي منتج أو وصول لأنظمة الإنتاج',
    deliverables: [
      'تقرير جاهزية (12-18 صفحة) بصيغة PDF',
      'Gap summary قابل للعرض على الإدارة',
      'خارطة طريق مرحلية بـ milestones قابلة للقياس',
      'توصية مكتوبة بالمرحلة التالية',
    ],
    notIncluded: [
      'نشر AI Firewall أو أي مكون تقني في الإنتاج',
      'تكامل مع أنظمتك الداخلية',
      'سجلات تدقيق أو Evidence File قابل للتسليم',
      'تعديل سياسات أو إجراءات قائمة',
    ],
    successCriteria: [
      'استلام تقرير جاهزية مع Gap Summary مصنّف حسب الأولوية',
      'اجتماع مراجعة مع فريقك خلال 14 يوم من التسليم',
      'قرار واضح: Pilot، مؤجّل، أو غير مناسب حالياً',
    ],
    nextStep: 'ابدأ التقييم الذاتي (20 دقيقة) أو احجز جلسة جاهزية مع فريقنا',
    nextStepHref: '/assessment/ai-governance-readiness/',
  },
  {
    id: 'pilot',
    name: 'Pilot 30 يوم بنطاق محدد',
    tagline: 'الموصى به — قياس القيمة قبل التوسع',
    description: 'تجربة عملية على قسم أو حالة استخدام واحدة مع AI Firewall وAudit Trail وHuman Approval. نتائج قابلة للقياس قبل أي التزام مؤسسي أوسع.',
    price: 'مخصص',
    priceNote: 'يعتمد على حجم القسم النطاق وعدد المستخدمين والـ connectors',
    cta: 'اطلب نطاق Pilot',
    ctaHref: '/contact/',
    ctaTarget: '_self',
    recommended: true,
    suitableFor: [
      'CISO الذي يثبت فرضية حوكمة AI لقسم أو حالة استخدام',
      'مدير التقنية الذي يحتاج بيانات واقعية قبل Sourcing',
      'مدير المخاطر والتدقيق الذي يستعد لقرار تعميم',
    ],
    scope: [
      'قسم واحد أو حالة استخدام واحدة (مثل: خدمة العملاء، التسويق، القانونية)',
      'AI Firewall مع سياسات افتراضية قابلة للتعديل',
      'Audit Trail كامل لكل عملية استخدام',
      'Human Approval لمسار حساس واحد على الأقل',
      'تكامل مع قناة واحدة (Slack, Microsoft Teams, Email, أو API)',
      'لوحة مؤشرات أساسية للفترة التجريبية',
    ],
    duration: '30 يوم تقويمي (قابل للتمديد أسبوعين بموافقة متبادلة)',
    durationNote: 'الأسبوع 1-2: إعداد ودمج. الأسبوع 3: تشغيل مقيّد. الأسبوع 4: قياس وتقرير',
    deliverables: [
      'تقرير نتائج Pilot (15-25 صفحة) مع KPIs كمية',
      'Sample Evidence File من فترة التشغيل',
      'ملاحظات قابلة للتنفيذ قبل التوسع',
      'توصية بثلاث سيناريوهات: تعميم، توسعة، أو إيقاف',
    ],
    notIncluded: [
      'تغطية متعددة الأقسام أو المؤسسة بأكملها',
      'تكاملات معقدة مع أنظمة ERP/CRM مخصصة',
      'SLA إنتاجي أو دعم 24/7 (يُعرض في Enterprise)',
      'تخصيصات عميقة في الكود أو في البنية',
    ],
    successCriteria: [
      'مؤشران كمّيان على الأقل: (مثال) 100% من طلبات AI الحساسة مرّت عبر Approval، صفر تسريب PII مكتشف',
      'استلام Sample Evidence File مع trace كامل',
      'اجتماع ختامي مع تقرير وقرار خلال 7 أيام من نهاية Pilot',
    ],
    nextStep: 'احجز جلسة لتحديد نطاق Pilot: قسم، حالة استخدام، قناة، KPIs',
    nextStepHref: '/contact/',
  },
  {
    id: 'enterprise',
    name: 'Enterprise Rollout',
    tagline: 'نشر مؤسسي متكامل',
    description: 'نشر BrightAI عبر المؤسسة مع تكاملات مؤسسية، حزم سياسات، وأدوار وصلاحيات، ودعم تشغيلي. مناسب للمؤسسات الجاهزة للتعميم بعد Pilot ناجح.',
    price: 'مخصص',
    priceNote: 'عرض سعر مفصّل بعد إكمال Pilot أو Assessment بنجاح',
    cta: 'تواصل للمؤسسات',
    ctaHref: '/contact/',
    ctaTarget: '_self',
    recommended: false,
    suitableFor: [
      'مؤسسات أكملت Pilot بنجاح وتستعد للتعميم',
      'CIO/CISO مع موافقة ميزانية سنوية لحوكمة AI',
      'قطاعات منظمة (حكومي، مصرفي، صحي، صناعي) تحتاج أدلة امتثال',
    ],
    scope: [
      'نشر متعدد الأقسام مع connectors شاملة',
      'تكامل مع SSO/IdP وأنظمة IAM المؤسسية',
      'حزم سياسات مخصصة لكل قسم/دور',
      'أدوار وصلاحيات مفصّلة (RBAC)',
      'SLA إنتاجي مع خطة استمرارية الأعمال',
      'تدريب لفريقك وفرق العمليات',
    ],
    duration: '12-16 أسبوع من توقيع العقد حتى التشغيل الكامل',
    durationNote: 'المرحلة 1: تصميم مفصّل (3-4 أسابيع). المرحلة 2: نشر مرحلي (6-8 أسابيع). المرحلة 3: تشغيل ودعم (مستمر)',
    deliverables: [
      'بنية نشر موثقة (Architecture document)',
      'حزم سياسات مخصصة (3-5 packs حسب القطاع)',
      'تدريب معتمد لفريقك (8-16 ساعة)',
      'SLA مكتوب وخطة استمرارية',
      'دعم تشغيلي مع SLA محدد',
    ],
    notIncluded: [
      'تطوير ميزات جديدة خارج خارطة المنتج المعلنة',
      'استضافة محلية معزولة بالكامل (يُناقش كـ add-on)',
      'عمليات تدقيق خارجية (Audit) نيابةً عنك',
    ],
    successCriteria: [
      'نشر BrightAI في ≥ 3 أقسام مع ≥ 80% امتثال للسياسات',
      'تشغيل Pilot شامل واحد (≥ 30 يوم) بدون انقطاع خدمة',
      'استلام Architecture document + حزم السياسات',
    ],
    nextStep: 'تواصل مع فريق المؤسسات لمناقشة خارطة النشر والـ SLA',
    nextStepHref: '/contact/',
  },
];

// عوامل التسعير — Section "سعر مخصص" يفسر لماذا
const pricingFactors = [
  { factor: 'حجم النطاق', detail: 'عدد المستخدمين النشطين، الأقسام المشمولة، وحجم الطلبات الشهرية المتوقعة' },
  { factor: 'مستوى التخصيص', detail: 'تكاملات مخصصة، سياسات مخصصة لكل قسم، أوضاع نشر خاصة' },
  { factor: 'البيئة التقنية', detail: 'سحابة عامة، استضافة خاصة، أو on-premise؛ التكامل مع IdP وأنظمة IAM' },
  { factor: 'متطلبات الامتثال', detail: 'حزم PDPL/NCA ECC/SFDA/SAMA/ISO 13485/ISO 42001 المفعّلة وتكرار التدقيق' },
  { factor: 'مستوى الدعم', detail: 'ساعات الدعم، SLA، مدير حساب مخصص، ودعم في الموقع للمؤسسات الكبرى' },
  { factor: 'مدة العقد', detail: 'سنوي (الأكثر مرونة) أو متعدد السنوات (مع خصومات مرحلية)' },
];

// FAQ للاعتراضات التجارية والأمنية — 8 أسئلة بصياغة دقيقة غير مضللة
const objectionFaqs = [
  {
    q: 'أين تُستضاف بياناتنا؟',
    a: 'تُستضاف البيانات في مزوّد سحابي رئيسي في منطقة الشرق الأوسط بشكل افتراضي، مع خيارات للنشر في مناطق جغرافية محددة أو داخل المملكة عند الحاجة المؤسسية. في Enterprise Rollout نناقش خيارات on-premise أو VPC خاصة كـ add-on. لا نشارك بيانات العملاء مع أي طرف ثالث لأغراض تدريب نماذج.',
  },
  {
    q: 'مَن يصل إلى البيانات الحساسة في BrightAI؟',
    a: 'الوصول إلى البيانات الحساسة مقيّد بأدوار RBAC مفصّلة. فريق BrightAI التشغيلي يصل فقط لما هو ضروري لتقديم الدعم المتفق عليه، مع تسجيل كل عملية وصول في Audit Trail. في Enterprise، يمكنك تقييد وصول فريق الدعم إلى بيئة الإنتاج كلياً وإتاحة بيئة دعم معزولة.',
  },
  {
    q: 'كم يستغرق التكامل مع أنظمتنا الحالية؟',
    a: 'في Pilot: تكامل مع قناة واحدة (Slack, Teams, Email, API) خلال 1-2 أسبوع. في Enterprise: تكامل مع IdP/SSO وأنظمة IAM خلال 3-4 أسابيع. التكاملات المخصصة مع ERP/CRM تُقيّم حالة بحالة وتعتمد على توفر API وموارد فريقك التقني.',
  },
  {
    q: 'كم تستغرق دورة الشراء من التواصل إلى العقد؟',
    a: 'عادةً 4-8 أسابيع للمؤسسات التي لديها موافقة ميزانية. الجدول التقريبي: أسبوع لجلسة النطاق + أسبوع للعرض + 2-4 أسابيع لتقييم أمني/قانوني + توقيع. في المؤسسات الحكومية والصحية قد تطول بسبب متطلبات المشتريات. Pilot أسرع لأنه نطاق محدد وموافقات أصغر.',
  },
  {
    q: 'هل نوقّع NDA قبل مناقشة التفاصيل؟',
    a: 'نعم. نوقّع NDA متبادل (mutual NDA) قبل مشاركة أي معلومات سرية عن بنيتك أو بياناتك. نموذج NDA المعياري متاح، ونقبل صيغ NDA المعتمدة من فريقك القانوني للمراجعة.',
  },
  {
    q: 'ما هو مستوى SLA المضمون في Enterprise؟',
    a: 'SLA الإنتاجي يُتفق عليه في عقد Enterprise Rollout بناءً على نطاق النشر ومتطلباتك. الافتراضي: 99.5% uptime شهري مع تعويض مرحلي، ودعم خلال ساعات العمل الموسّعة. SLA أعلى (99.9% مع دعم 24/7) متاح كترقية. لا نلتزم بـ SLA قبل Pilot ناجح.',
  },
  {
    q: 'كيف يعمل الدعم الفني بعد الإطلاق؟',
    a: 'في Pilot: دعم خلال ساعات العمل عبر البريد + WhatsApp. في Enterprise: مدير حساب مخصص + دعم خلال ساعات العمل الموسّعة + قناة طوارئ. الترقية إلى دعم 24/7 مع SLA 1 ساعة متاحة للمؤسسات الحرجة. لا نقدم دعم استشاري غير محدود في أي مستوى.',
  },
  {
    q: 'هل BrightAI "متوافقة مع PDPL" أم "تدعم الجاهزية"؟',
    a: 'BrightAI تساعد على الجاهزية للامتثال عبر Audit Trail، ضوابط الوصول، وتوثيق القرارات، لكنها لا تحل محل مسؤوليتك كمدير بيانات أو مسؤول امتثال. امتثال PDPL الفعلي يعتمد على تطبيقك للسياسات، تدريب فريقك، ومراجعاتك الداخلية. لا ندّعي امتثالاً كاملاً؛ ندّعي أن المنصة تقلل الجهد اللازم لإثبات الامتثال عند التدقيق.',
  },
];

// أسئلة مساعدة القرار — بدل قسم الروابط الـ SEO
const decisionHelper = [
  {
    question: 'لسنا متأكدين بعد هل نحتاج حوكمة AI',
    answer: 'ابدأ بـ Assessment الذاتي (20 دقيقة، تقرير فجوات PDF) أو احجز جلسة جاهزية مع فريقنا. لا التزام تقني أو مالي.',
    ctaLabel: 'ابدأ تقييم الجاهزية',
    ctaHref: '/assessment/ai-governance-readiness/',
    ctaData: 'assessment_start',
  },
  {
    question: 'نريد قياس القيمة قبل التزام مؤسسي',
    answer: 'Pilot 30 يوم على قسم واحد يعطيك KPIs كمية + Sample Evidence File قبل أي قرار تعميم. هذا المسار الأنسب لـ CISO وCIO.',
    ctaLabel: 'اطلب نطاق Pilot',
    ctaHref: '/contact/',
    ctaData: 'pilot_request',
  },
  {
    question: 'مستعدون للتعميم أو عندنا Pilot سابق',
    answer: 'تواصل مع فريق المؤسسات لمناقشة Enterprise Rollout. نبدأ بمراجعة نتائج Pilot أو Assessment كأساس لخارطة النشر والـ SLA.',
    ctaLabel: 'تواصل للمؤسسات',
    ctaHref: '/contact/',
    ctaData: 'enterprise_contact',
  },
];

// Service Schema للعروض الثلاثة — schema.org/Service
const serviceSchemas = offers.map((o) => ({
  '@type': 'Service',
  name: o.name,
  description: o.description,
  provider: { '@id': 'https://brightai.live/#organization' },
  serviceType: 'AI Governance & Safety',
  areaServed: { '@type': 'Country', name: 'المملكة العربية السعودية' },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'SAR',
    priceSpecification: {
      '@type': 'PriceSpecification',
      priceCurrency: 'SAR',
      description: o.priceNote,
    },
    availability: 'https://schema.org/InStock',
    url: canonical,
    category: o.recommended ? 'recommended' : 'standard',
  },
}));

// BAI-SEO-003-S3 (2026-07-18): WebPage and BreadcrumbList are emitted
// by the foundation Schema.astro. The page now keeps only the
// page-specific Service nodes (one per offer) to avoid duplicate @id
// warnings (verified via scripts/_check-duplicate-schema-ids.mjs).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: objectionFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
    ...serviceSchemas,
  ],
};
---

<ArabicLayout title={title} description={description} canonical={canonical} hreflang={[{lang:'ar-SA',href:canonical},{lang:'x-default',href:canonical}]} jsonLd={jsonLd} currentPath="/pricing/" extraSpeakableSelectors={['.pricing-hero__lead', 'aside[data-snippet="tl-dr"]']} breadcrumbs={[{ name: 'الأسعار', href: '/pricing/' }]}>

  <div class="pricing-page">

    {/* ──────────────────────────────────────────────────────────
        1. HERO — Category + 3 packages + Primary CTA
        ────────────────────────────────────────────────────────── */}
    <section class="page-hero pricing-hero">
      <div class="pricing-hero__inner">

        <p class="pricing-hero__eyebrow">باقات حوكمة AI المؤسسية</p>
        <h1 class="pricing-hero__title">3 عروض واضحة — لا خدمات AI متفرقة</h1>
        <p class="pricing-hero__lead">BrightAI منصة حوكمة AI مؤسسية واحدة. اختر نقطة البداية المناسبة لمؤسستك: تقييم جاهزية، Pilot بنطاق محدد، أو تعميم مؤسسي متكامل. السعر مخصص في كل عرض — لأن الحوكمة المؤسسية ليست منتج صندوقي.</p>
        {/* BAI-SEO-003-S7 (2026-07-18): P0 snippet pack — TL;DR / الخلاصة.
           Answer-first, self-contained, ≤60 words. Single source of truth:
           src/data/snippet-pack.ts. */}
        <aside data-snippet="tl-dr" aria-label="الخلاصة" class="answer-first-summary">
          <p>عروض حوكمة الذكاء الاصطناعي المؤسسية من برايت أيه آي ثلاثة: تقييم جاهزية، وPilot لمدة ثلاثين يوما، ونشر مؤسسي شامل. السعر مخصص في كل عرض ويعتمد على حجم المنشأة ونطاق الاستخدام والضوابط المطلوبة. العروض مصممة لتغطي مسار الجاهزية وفق أولويات المنشأة. الخدمة مكمل للتشغيل وليست بديلا عن الاستشارة القانونية.</p>
        </aside>
        <div class="pricing-hero__actions">
          <div class="cta-actions">
            <a
              href="/contact/"
              class="btn btn--glow"
              data-cta="pricing_cta_click"
              data-position="hero"
