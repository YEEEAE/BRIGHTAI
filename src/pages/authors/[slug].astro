---
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { authors } from '../../data/blog';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return Object.keys(authors).map(slug => ({
    params: { slug },
    props: { author: authors[slug] },
  }));
}

const { author } = Astro.props;

const legacyArticles = [
  { href: '/blog/what-is-ai-governance-saudi-companies/', label: 'ما هي حوكمة الذكاء الاصطناعي؟ الدليل الكامل للشركات السعودية' },
  { href: '/blog/hidden-ai-risks-saudi-organizations/', label: '5 مخاطر خفية للذكاء الاصطناعي في المؤسسات السعودية' },
  { href: '/blog/ai-governance-vs-ai-safety-vs-ai-security/', label: 'الفرق بين AI Governance وAI Safety وAI Security' },
  { href: '/blog/shadow-ai-discovery-saudi-company/', label: 'Shadow AI: كيف تكتشف الاستخدام الخفي للذكاء الاصطناعي في شركتك' },
  { href: '/blog/pdpl-ai-compliance-guide/', label: 'دليل PDPL والذكاء الاصطناعي لمسؤول الامتثال' },
  { href: '/blog/nca-ecc-ai-controls-guide/', label: 'ضوابط NCA ECC للذكاء الاصطناعي خطوة بخطوة' },
  { href: '/blog/sdaia-generative-ai-guidelines-practical-compliance/', label: 'إرشادات سدايا للذكاء الاصطناعي التوليدي: كيف تتوافق عملياً' },
  { href: '/blog/iso-42001-saudi-implementation-guide/', label: 'ISO/IEC 42001 للشركات السعودية: دليل التطبيق العملي' },
  { href: '/blog/ai-firewall-why-you-need-it/', label: 'جدار حماية الذكاء الاصطناعي: ما هو ولماذا تحتاجه' },
  { href: '/blog/ai-audit-trail-compliance-path/', label: 'سجل تدقيق الذكاء الاصطناعي ومسار الامتثال' },
  { href: '/blog/healthcare-ai-governance-saudi-hospitals/', label: 'حوكمة الذكاء الاصطناعي في المستشفيات السعودية' },
  { href: '/blog/banking-ai-governance-sama-requirements/', label: 'حوكمة الذكاء الاصطناعي في البنوك السعودية ومتطلبات SAMA' },
  { href: '/blog/ai-ethics-saudi-responsible-ai/', label: 'أخلاقيات الذكاء الاصطناعي في السعودية' },
  { href: '/blog/best-ai-governance-platforms-2026/', label: 'مقارنة أفضل منصات حوكمة الذكاء الاصطناعي في 2026' },
  { href: '/blog/ai-red-teaming-security-testing/', label: 'AI Red Teaming: اختبار أمان أنظمة الذكاء الاصطناعي' },
  { href: '/blog/vision-2030-ai-governance-roadmap/', label: 'الذكاء الاصطناعي في رؤية 2030: خريطة طريق الحوكمة' },
];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  alternateName: author.nameEn,
  url: author.url,
  jobTitle: author.title,
  description: author.bio,
  image: `${SITE.url}/assets/images/authors/nasser-alabdullah.svg`,
  worksFor: {
    '@type': 'Organization',
    name: 'BrightAI',
    url: SITE.url,
  },
  inLanguage: 'ar-SA',
  knowsAbout: [
    'AI Governance',
    'PDPL Compliance',
    'NCA ECC Controls',
    'SDAIA AI Guidelines',
    'AI Safety',
    'ISO/IEC 42001',
    'Risk Management',
    'AI Firewall',
  ],
};

const authorJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [personLd],
};
---

<ArabicLayout
  title={`${author.name} | ${author.title}`}
  description={`${author.bio.slice(0, 155).replace(/\s+\S*$/, '')}...`}
  canonical={author.url}
  hreflang={[{ lang: 'ar-SA', href: author.url }]}
  jsonLd={authorJsonLd as any}
  currentPath={`/authors/${author.slug}/`}
  breadcrumbs={[{ name: 'المؤلفون والخبراء', href: '/authors/' }, { name: author.name, href: `/authors/${author.slug}/` }]}
>
  <div class="author-shell">
    <header class="author-header">
      <div>
        <p class="author-title">ملف الخبير / الكاتب</p>
        <h1>{author.name} — {author.title}</h1>
        <p class="author-bio">{author.bio}</p>
      </div>
      <figure class="author-portrait">
        <img src="/assets/images/authors/nasser-alabdullah.svg" alt={`صورة تعريفية لـ ${author.name}`} width="150" height="150" decoding="async" loading="lazy" />
        <figcaption>فريق استشارات BrightAI للذكاء الاصطناعي</figcaption>
      </figure>
    </header>

    <!-- قسم مجالات التخصص والخبرة المعمقة -->
    <section class="inner-section" aria-label="مجالات التخصص والخبرة" style="margin-top: var(--space-6);">
      <div class="card card--feature" style="padding: var(--space-6); border-inline-start: 4px solid var(--brand);">
        <h2 style="font-size: var(--text-xl); color: var(--text-primary); margin-bottom: var(--space-3);">مجالات التخصص والمساهمات المعرفية</h2>
        <p style="color: var(--text-secondary); line-height: var(--leading-relaxed); font-size: var(--text-base); margin-bottom: var(--space-4);">
          يركز محتوى وأبحاث <strong>{author.name}</strong> على تمكين المنشآت السعودية من بناء منظومة حوكمة شاملة تضمن تبني حلول الذكاء الاصطناعي دون المساس بخصوصية الأفراد وسرية المؤسسات. تشمل مجالات التركيز:
        </p>
        <div class="grid grid--3" style="gap: var(--space-4);">
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <strong style="color: var(--text-primary); display: block; margin-bottom: var(--space-2);">حوكمة البيانات ونظام PDPL</strong>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">وضع آليات تصنيف البيانات وضوابط التعمية الآلية للحد من مخاطر تسريب الهويات الوطنية وسجلات العملاء.</p>
          </div>
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <strong style="color: var(--text-primary); display: block; margin-bottom: var(--space-2);">إدارة مخاطر وأمان الذكاء الاصطناعي</strong>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">بناء سجلات المخاطر التشغيلية وفحص النماذج اللغوية واختبارات الفريق الأحمر (AI Red Teaming).</p>
          </div>
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <strong style="color: var(--text-primary); display: block; margin-bottom: var(--space-2);">جاهزية التدقيق وسدايا</strong>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">إعداد ملفات الأدلة الرقمية غير القابلة للتعديل للتوافق مع إرشادات سدايا ومعيار ISO 42001 الدولي.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- المقالات المنشورة -->
    <section aria-label="المقالات والأدلة المنشورة" style="margin-top: var(--space-8);">
      <h2 class="author-section-title">الأدلة والمقالات التنفيذية المنشورة</h2>
      <p class="author-posts-count">16 مرجعاً ودليلاً معرفياً متقدماً</p>
      <div class="author-posts">
        {legacyArticles.map(article => (
          <a href={article.href} class="author-post-card">
            <span class="author-post-card__cat">حوكمة الذكاء الاصطناعي • دليل سعودي</span>
            <h3>{article.label}</h3>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="professional-accounts" style="margin-top: var(--space-6);">
      <h2 id="professional-accounts" class="author-section-title">الموثوقية والشفافية المهنية (E-E-A-T)</h2>
      <p class="author-identity-note">يعمل كافة المستشارين والكتّاب تحت مظلة المرجعية البحثية والتقنية لمنصة BRIGHTAI، وتتم مراجعة وتحديث المحتوى دورياً ليتوافق مع أحدث التحديثات التنظيمية الصادرة في المملكة العربية السعودية.</p>
    </section>
  </div>
</ArabicLayout>

<style>
  .author-shell {
    max-width: 56rem;
    margin: 0 auto;
    padding: var(--space-8) var(--space-5);
  }
  .author-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .author-title {
    color: var(--brand-400);
    font-size: var(--text-sm);
    font-weight: bold;
    margin-bottom: var(--space-2);
  }
  .author-bio {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    font-size: var(--text-base);
    margin-top: var(--space-3);
  }
  .author-portrait {
    flex-shrink: 0;
    text-align: center;
  }
  .author-portrait img {
    border-radius: 50%;
    border: 2px solid var(--brand);
    background: var(--bg-surface);
  }
  .author-portrait figcaption {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-2);
  }
  .author-section-title {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }
  .author-posts-count {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }
  .author-posts {
    display: grid;
    gap: var(--space-3);
  }
  .author-post-card {
    display: block;
    padding: var(--space-4);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text-primary);
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .author-post-card:hover {
    border-color: var(--brand-400);
  }
  .author-post-card__cat {
    color: var(--brand-300);
    font-size: var(--text-xs);
  }
  .author-post-card h3 {
    margin: var(--space-1) 0 0;
    font-size: var(--text-base);
  }
  .author-identity-note {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }
</style>
