---
/**
 * Author page — /authors/<slug>/
 * Currently only nasser-alabdullah.
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';

import { authors } from '../../data/blog';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return Object.keys(authors).map(slug => ({
    params: { slug },
    props: { author: authors[slug] },
  }));
}

const { author } = Astro.props;
const legacyArticles = [
  { href: '/blog/what-is-ai-governance-saudi-companies/', label: 'ما هي حوكمة الذكاء الاصطناعي؟ الدليل الكامل للشركات السعودية' },
  { href: '/blog/hidden-ai-risks-saudi-organizations/', label: '5 مخاطر خفية للذكاء الاصطناعي في المؤسسات السعودية' },
  { href: '/blog/ai-governance-vs-ai-safety-vs-ai-security/', label: 'الفرق بين AI Governance وAI Safety وAI Security' },
  { href: '/blog/shadow-ai-discovery-saudi-company/', label: 'Shadow AI: كيف تكتشف الاستخدام الخفي للذكاء الاصطناعي في شركتك' },
  { href: '/blog/pdpl-ai-compliance-guide/', label: 'دليل PDPL والذكاء الاصطناعي لمسؤول الامتثال' },
  { href: '/blog/nca-ecc-ai-controls-guide/', label: 'ضوابط NCA ECC للذكاء الاصطناعي خطوة بخطوة' },
  { href: '/blog/sdaia-generative-ai-guidelines-practical-compliance/', label: 'إرشادات سدايا للذكاء الاصطناعي التوليدي: كيف تتوافق عملياً' },
  { href: '/blog/iso-42001-saudi-implementation-guide/', label: 'ISO/IEC 42001 للشركات السعودية: دليل التطبيق العملي' },
  { href: '/blog/ai-firewall-why-you-need-it/', label: 'جدار حماية الذكاء الاصطناعي: ما هو ولماذا تحتاجه' },
  { href: '/blog/ai-audit-trail-compliance-path/', label: 'سجل تدقيق الذكاء الاصطناعي ومسار الامتثال' },
  { href: '/blog/healthcare-ai-governance-saudi-hospitals/', label: 'حوكمة الذكاء الاصطناعي في المستشفيات السعودية' },
  { href: '/blog/banking-ai-governance-sama-requirements/', label: 'حوكمة الذكاء الاصطناعي في البنوك السعودية ومتطلبات SAMA' },
  { href: '/blog/ai-ethics-saudi-responsible-ai/', label: 'أخلاقيات الذكاء الاصطناعي في السعودية' },
  { href: '/blog/best-ai-governance-platforms-2026/', label: 'مقارنة أفضل منصات حوكمة الذكاء الاصطناعي في 2026' },
  { href: '/blog/ai-red-teaming-security-testing/', label: 'AI Red Teaming: اختبار أمان أنظمة الذكاء الاصطناعي' },
  { href: '/blog/vision-2030-ai-governance-roadmap/', label: 'الذكاء الاصطناعي في رؤية 2030: خريطة طريق الحوكمة' },
];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  alternateName: author.nameEn,
  url: author.url,
  jobTitle: author.title,
  description: author.bio,
  image: `${SITE.url}/assets/images/authors/nasser-alabdullah.svg`,
  worksFor: {
    '@type': 'Organization',
    name: 'BrightAI',
    url: SITE.url,
  },
  inLanguage: 'ar-SA',
  knowsAbout: [
    'AI Governance',
    'PDPL Compliance',
    'NCA ECC Controls',
    'SDAIA AI Guidelines',
    'AI Safety',
    'ISO/IEC 42001',
  ],
  sameAs: [],
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'المؤلفون', item: `${SITE.url}/authors/` },
    { '@type': 'ListItem', position: 3, name: author.name, item: author.url },
  ],
};

// SCHEMA-ENHANCEMENT (REPORT-23): wrap into @graph with Person + BreadcrumbList.
// BAI-SEO-003-S3 (2026-07-18): Organization and BreadcrumbList are emitted by
// the foundation Schema.astro, so we no longer append them here to avoid
// duplicate @id warnings (verified via scripts/_check-duplicate-schema-ids.mjs).
const authorJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [personLd],
};
---

<ArabicLayout
  title={`${author.name} | ${author.title} | BrightAI`}
  description={`${author.bio.slice(0, 155).replace(/\s+\S*$/, '')}...`}
  canonical={author.url}
  hreflang={[{ lang: 'ar-SA', href: author.url }]}
  jsonLd={authorJsonLd as any}
  currentPath={`/authors/${author.slug}/`}
  breadcrumbs={[{ name: 'المؤلفون', href: '/authors/' }, { name: author.name, href: `/authors/${author.slug}/` }]}
>

  <div class="author-shell">

    <header class="author-header">
      <div>
        <p class="author-title">صفحة المؤلف</p>
        <h1>م. ناصر العبدالله — مؤسس BrightAI</h1>
        <p class="author-bio">{author.bio}</p>
      </div>
      <figure class="author-portrait">
        <img src="/assets/images/authors/nasser-alabdullah.svg" alt="رسم تعريفي مؤقت لم. ناصر العبدالله" width="150" height="150" decoding="async" loading="lazy" />
        <figcaption>رسم تعريفي مؤقت لحين توفير صورة شخصية موثقة.</figcaption>
      </figure>
    </header>

    <h2 class="author-section-title">المقالات</h2>
    <p class="author-posts-count">16 مقالاً</p>
    <div class="author-posts">
      {legacyArticles.map(article => (
        <a href={article.href} class="author-post-card">
          <span class="author-post-card__cat">BrightAI</span>
          <h3>{article.label}</h3>
        </a>
      ))}
    </div>

    <section aria-labelledby="professional-accounts">
      <h2 id="professional-accounts" class="author-section-title">الحسابات المهنية</h2>
      <p class="author-identity-note">لا يوجد حالياً رابط LinkedIn شخصي موثّق ومنشور لم. ناصر العبدالله؛ لذلك لم تتم إضافة أي رابط إلى <code>sameAs</code>.</p>
    </section>
  </div>
</ArabicLayout>
