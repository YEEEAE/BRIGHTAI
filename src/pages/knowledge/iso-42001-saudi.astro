  { label: 'تحقّق', latin: 'CHECK', detail: 'راقب النتائج والمؤشرات، واجمع أدلة مناسبة، ونفّذ التدقيق الداخلي ومراجعة الإدارة لتعرف هل النظام مطبق ويحقق ما خُطط له.' },
  { label: 'حسّن', latin: 'ACT', detail: 'عالج عدم المطابقة وأسبابها، وتعلّم من الحوادث والتغييرات، ثم حدّث الضوابط والنظام وأعد دورة التخطيط.' },
];
