<script>
  const root = document.querySelector('[data-pdca]');
  if (root) {
    const wheel = root.querySelector<SVGSVGElement>('[data-wheel]');
    const title = root.querySelector('[data-phase-title]');
    const copy = root.querySelector('[data-phase-copy]');
    const labels = ['خطّط · PLAN', 'نفّذ · DO', 'تحقّق · CHECK', 'حسّن · ACT'];
    const details = [
      'افهم سياق المنشأة وحدود النطاق، وثبّت القيادة والسياسة والمسؤوليات، ثم حدّد المخاطر والفرص وأهداف نظام الإدارة.',
      'حوّل القرارات إلى عمليات وموارد وكفاءات وضوابط تشغيلية. وثّق كيف تُدار دورة حياة الاستخدامات، ومتى تتدخل الأدوار البشرية.',
      'راقب النتائج والمؤشرات، واجمع أدلة مناسبة، ونفّذ التدقيق الداخلي ومراجعة الإدارة لتعرف هل النظام مطبق ويحقق ما خُطط له.',
      'عالج عدم المطابقة وأسبابها، وتعلّم من الحوادث والتغييرات، ثم حدّث الضوابط والنظام وأعد دورة التخطيط.'
    ];
    root.querySelectorAll<HTMLButtonElement>('[data-phase]').forEach((button) => button.addEventListener('click', () => {
      const index = Number(button.dataset.phase);
      root.querySelectorAll('[data-phase]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      wheel?.style.setProperty('--wheel-turn', `${index * 90}deg`);
      if (title) title.textContent = labels[index];
      if (copy) copy.textContent = details[index];
    }));
  }
</script>

