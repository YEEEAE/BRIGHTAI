---
import PageShell from '../../components/PageShell.astro';
export const prerender = true;
const description = 'مقارنة عملية بين مبادئ الذكاء الاصطناعي التوليدي للعموم وللجهات الحكومية من سدايا: من تنطبق عليه كل نسخة، والفروقات، وأمثلة مسموح وممنوع، وخطوات التطبيق.';
const path = Astro.url.pathname;

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'مبادئ الذكاء الاصطناعي التوليدي من سدايا: نسخة العموم مقابل نسخة الجهات الحكومية',
  description,
  inLanguage: 'ar-SA',
  datePublished: '2026-11-03',
  dateModified: '2026-11-03',
  mainEntityOfPage: new URL(path, 'https://brightai.live').href,
  author: { '@type': 'Organization', name: 'BRIGHTAI', url: 'https://brightai.live/about/' },
  publisher: {
    '@type': 'Organization',
    name: 'BRIGHTAI',
    url: 'https://brightai.live/',
    logo: { '@type': 'ImageObject', url: 'https://brightai.live/images/brightai-logo.webp' },
  },
  about: [
    { '@type': 'Thing', name: 'مبادئ الذكاء الاصطناعي التوليدي' },
    { '@type': 'Thing', name: 'إرشادات الذكاء الاصطناعي التوليدي' },
    { '@type': 'Thing', name: 'استخدام الذكاء الاصطناعي التوليدي في الجهات الحكومية' },
    { '@type': 'Thing', name: 'ضوابط الذكاء الاصطناعي التوليدي' },
  ],
};

const faqs = [
  {
    q: 'هل الإرشادات ملزمة؟',
    a: 'الوثيقتان مصنفتان رسمياً بأنهما «وثائق تنظيمية»، ونسخة الجهات الحكومية تصف مبادئها بأنها «إلزامية» وتستخدم صيغة «يجب». لكن هل يترتب على المخالفة جزاء مستقل بذات الوثيقة؟ هذا سؤال نظامي يحتاج رأياً قانونياً على حالتك. الأثر العملي الأوضح على الجهات الحكومية: منع إدخال البيانات المصنفة «مقيد» فأعلى، والامتناع عن استخدام الأدوات في القرارات الحاسمة التي تمس الأفراد أو المصالح الحيوية، وإجراء مراجعة بشرية للمخرجات.',
  },
  {
    q: 'هل أقدر أستخدم ChatGPT في الشغل؟',
    a: 'الوثيقتان ما تحظران الأداة بذاتها، لكنهما تضعان شروطاً على البيانات والغرض والمراجعة. القاعدة المختصرة: لا تدخل بيانات شخصية أو سرية أو مصنفة في أداة غير معتمدة، ولا تعتمد مخرجاً دون تحقق بشري، وأفصح عن استخدام الأداة عند الحاجة. في الجهات الحكومية يضاف شرط اعتماد الأداة من مكتب إدارة البيانات بعد مراجعة سياسات الخصوصية والإفصاح.',
  },
  {
    q: 'الفرق بين النسختين؟',
    a: 'نسخة العموم (SDAIA-P115) دليل مرجعي للجميع: سبعة مبادئ، وسبع فئات مخاطر مع تدابير تخفيف، وفوائد الاستخدام. نسخة الجهات الحكومية (SDAIA-P116) أضيق جمهوراً وأكثر تفصيلاً: مبادئ إلزامية للتعامل مع البيانات الحكومية، وأدوار واضحة داخل الجهة تشمل مكتب إدارة البيانات، وأدلة عملية بصيغ أوامر جيدة وسيئة، وقائمة تحقق ختامية.',
  },
  {
    q: 'هل تشمل الصور والأكواد؟',
    a: 'نعم. النسختان تعرّفان الذكاء الاصطناعي التوليدي بأنه ينتج نصوصاً وصوراً وأصواتاً ورموزاً ومقاطع فيديو، وتذكران التزييف العميق والعلامات المائية ضمن المخاطر. وفيما يخص الأكواد، توصي نسخة العموم بوضع علامة توضيحية في الكود المولّد ومراجعته واختباره، وتضم قائمة تحقق الجهات الحكومية بنداً صريحاً للتحقق من دقة الكود قبل استخدامه.',
  },
  {
    q: 'كيف أطبّقها بدون فريق كبير؟',
    a: 'ابدأ بأربعة ملفات فقط: جرد للأدوات والحالات، وسياسة من صفحتين تحدد المسموح والمشروط والممنوع، وقائمة تحقق قبل النشر، وسجل قرارات ومراجعات. عيّن مالكاً واحداً لكل حالة استخدام، ودرّب الفريق على سيناريوهات حقيقية بدل محاضرة عامة، وراجع كل ربع سنة أو عند تغيير أداة أو بيانات.',
  },
];
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<PageShell
  title="مبادئ الذكاء الاصطناعي التوليدي سدايا: نسختان | BRIGHTAI"
  description={description}
  crumbs={[{ name: 'مركز المعرفة', href: '/docs/' }, { name: 'إرشادات الذكاء الاصطناعي التوليدي' }]}
  ogType="article"
  structuredData={article}
>
  <div class="k3" id="top" data-k3-root data-mode="public">
    <header class="k3-hero">
      <div class="k3-hero-top">
        <p class="k3-eyebrow"><span class="k3-eyebrow-dot" aria-hidden="true"></span> الحوكمة · وثيقتان بنفس التاريخ</p>
        <p class="k3-hero-id"><bdi dir="ltr">SDAIA-P115</bdi> / <bdi dir="ltr">SDAIA-P116</bdi></p>
      </div>
      <h1>مبادئ الذكاء الاصطناعي التوليدي من سدايا: نسخة العموم مقابل نسخة الجهات الحكومية</h1>
      <p class="k3-lead">سدايا أصدرت في مايو 2025 وثيقتين متشابهتين في الشكل ومختلفتين في الأثر: واحدة للعموم، وواحدة للجهات الحكومية. هذا الدليل يفكّ الفرق بينهما بلغة عملية، ويعطيك شجرة قرار تعرف بها أي نسخة تخصك، وأمثلة يومية بثلاث إشارات: مسموح، بشروط، ممنوع.</p>
      <ul class="k3-badges" aria-label="بيانات الدليل">
        <li>الحوكمة</li>
        <li>وثيقتان · إصدار 1</li>
        <li>قراءة 18 دقيقة</li>
        <li>آخر مراجعة: 3 نوفمبر 2026</li>
      </ul>

      <div class="k3-hero-split" aria-label="الوثيقتان في سطرين">
        <div class="k3-hero-half k3-hero-half--public">
          <p class="k3-half-label">للعموم</p>
          <p class="k3-half-title">مبادئ الذكاء الاصطناعي التوليدي للعموم</p>
          <p class="k3-half-meta"><bdi dir="ltr">P115</bdi> · 22 صفحة · مبادئ ومخاطر وتدابير</p>
        </div>
        <div class="k3-hero-seam" aria-hidden="true"><span>أو</span></div>
        <div class="k3-hero-half k3-hero-half--gov">
          <p class="k3-half-label">للجهات الحكومية</p>
          <p class="k3-half-title">مبادئ الذكاء الاصطناعي التوليدي للجهات الحكومية</p>
          <p class="k3-half-meta"><bdi dir="ltr">P116</bdi> · 30 صفحة · مبادئ وأدوار وملاحق</p>
        </div>
      </div>
    </header>

    <p class="k3-alert" role="note">هذا المحتوى توعوي ولا يمثل استشارة قانونية أو اعتماداً تنظيمياً، ولا يثبت امتثال أي منشأة. آخر مراجعة: 3 نوفمبر 2026 — يلزم اعتماد المراجع البشري المختص قبل النشر النهائي.</p>

    <article class="k3-body">
      <section class="k3-tldr" aria-labelledby="tldr-title">
        <h2 id="tldr-title">الزبدة</h2>
        <ul>
          <li><strong>الوثيقتان صدرتا في مايو 2025</strong> بنفس الوصف الرسمي «وثائق تنظيمية» وتصنيف «عام»، لكن جمهور كل واحدة مختلف.</li>
          <li><strong>نسخة العموم</strong> تشرح سبعة مبادئ وسبع فئات مخاطر وتدابير تخفيف، وتخاطب المطورين والمستخدمين والمتأثرين.</li>
          <li><strong>نسخة الجهات الحكومية</strong> تضيف أدواراً داخل الجهة، ومنعاً صريحاً لإدخال البيانات المصنفة «مقيد» فأعلى، ومنعاً لاستخدام الأدوات في القرارات الحاسمة.</li>
          <li><strong>لست جهة حكومية؟</strong> قد تنطبق عليك النسخة الحكومية إذا كنت تعالج بيانات حكومية بصفتك مقاولاً أو مشغّلاً أو مقيّماً.</li>
          <li><strong>التطبيق ما يحتاج فريقاً كبيراً:</strong> جرد، وسياسة قصيرة، وقائمة تحقق، ومالك لكل حالة استخدام، وسجل قرارات.</li>
        </ul>
      </section>

      <section class="k3-def" aria-labelledby="def-title">
        <h2 id="def-title">تعريف مباشر</h2>
        <p><strong>مبادئ الذكاء الاصطناعي التوليدي</strong> هما وثيقتان أصدرتهما الهيئة السعودية للبيانات والذكاء الاصطناعي (سدايا) في مايو 2025: «مبادئ الذكاء الاصطناعي التوليدي للعموم» ورقمها <bdi dir="ltr">SDAIA-P115</bdi>، و«مبادئ الذكاء الاصطناعي التوليدي للجهات الحكومية» ورقمها <bdi dir="ltr">SDAIA-P116</bdi>؛ وتحددان المبادئ والضوابط المتوقعة عند استخدام أدوات الذكاء الاصطناعي التوليدي، وتشرحان المخاطر وتدابير التخفيف منها، مع أدوار وملاحق عملية في نسخة الجهات الحكومية.</p>
      </section>

      <div class="k3-layout">
        <aside class="k3-toc" aria-labelledby="toc-title">
          <p class="k3-toc-label" id="toc-title">محطات الدليل</p>
          <ol>
            <li><a href="#which"><span>01</span> الوثيقتان ومن يعنيهما</a></li>
            <li><a href="#tree"><span>02</span> أي نسخة تخصك</a></li>
            <li><a href="#diff"><span>03</span> الفروقات العملية</a></li>
            <li><a href="#lights"><span>04</span> مسموح وبشروط وممنوع</a></li>
            <li><a href="#risks"><span>05</span> المخاطر الأربعة</a></li>
            <li><a href="#apply"><span>06</span> التطبيق داخل منشأتك</a></li>
            <li><a href="#pdpl"><span>07</span> العلاقة بـPDPL</a></li>
            <li><a href="#faq"><span>08</span> الأسئلة والمراجع</a></li>
          </ol>
          <p class="k3-toc-note">الوثيقتان مرجع للفهم والتحضير، وليستا شهادة امتثال.</p>
        </aside>

        <div class="k3-content">
          <section id="which" aria-labelledby="which-title">
            <div class="k3-sec-head"><span class="k3-sec-num" aria-hidden="true">01</span><h2 id="which-title">الزبدة: وش الوثيقتين ومن المقصود بكل وحدة؟</h2></div>
            <p class="k3-answer">الوثيقتان مرجعان رسميان من سدايا لتنظيم الاستخدام المسؤول للذكاء الاصطناعي التوليدي: نسخة للعموم تشرح المبادئ والمخاطر وتدابير التخفيف لجميع المطوّرين والمستخدمين، ونسخة للجهات الحكومية تضيف ضوابط ملزمة على البيانات الحكومية، وأدواراً داخل الجهة، وأدلة عملية وقائمة تحقق.</p>
            <p>خلنا نبدأ من اللي يلخبط الناس: الوثيقتان بنفس الشهر، ونفس الوصف الرسمي تقريباً، وبعض المبادئ متطابقة بالاسم. الفرق مو في «مين أقوى»، بل في <strong>مين المخاطب</strong> و<strong>وش مسموح له يدخل في الأداة</strong>: وحدة تخاطب المجتمع، والثانية موظفاً حكومياً يتعامل مع بيانات حكومية.</p>

            <div class="k3-docs">
              <article class="k3-doc">
                <p class="k3-doc-kicker">الوثيقة الأولى</p>
                <h3>مبادئ الذكاء الاصطناعي التوليدي للعموم</h3>
                <dl class="k3-doc-facts">
                  <div><dt>رقم الوثيقة</dt><dd><bdi dir="ltr">SDAIA-P115</bdi></dd></div>
                  <div><dt>الإصدار</dt><dd>1 — مايو 2025</dd></div>
                  <div><dt>الحجم</dt><dd>22 صفحة</dd></div>
                  <div><dt>التصنيف</dt><dd>عام — وثائق تنظيمية</dd></div>
                </dl>
                <p>تخاطب العموم، بما يشمل من يصمم أو يطور أو ينشر أو ينفذ أو يستخدم أنظمة الذكاء الاصطناعي التوليدي، وكذلك من يتأثر بها. تعطيك المبادئ السبعة، وفوائد الاستخدام، وسبع فئات مخاطر مع تدابير تخفيف لكل فئة. لغتها أقرب إلى شرح «ليش» و«كيف نتجنب الضرر»، وموجهة لمطور ومستخدم ومهتم، مو لجهة لها دليل إجراءات.</p>
              </article>

              <article class="k3-doc k3-doc--gov">
                <p class="k3-doc-kicker">الوثيقة الثانية</p>
                <h3>مبادئ الذكاء الاصطناعي التوليدي للجهات الحكومية</h3>
                <dl class="k3-doc-facts">
                  <div><dt>رقم الوثيقة</dt><dd><bdi dir="ltr">SDAIA-P116</bdi></dd></div>
                  <div><dt>الإصدار</dt><dd>1 — مايو 2025</dd></div>
                  <div><dt>الحجم</dt><dd>30 صفحة</dd></div>
                  <div><dt>التصنيف</dt><dd>عام — وثائق تنظيمية</dd></div>
                </dl>
                <p>تخاطب العاملين في الجهات الحكومية ومستخدمي البيانات الحكومية، ويشمل تعريفها «مستخدمي البيانات الحكومية» الموظفين والمقاولين وغيرهم ممن يتعامل مع بيانات الجهة. تبدأ من المبادئ السبعة نفسها، لكنها تصفها بأنها «إلزامية»، وتضيف أدواراً داخل الجهة، وأمثلة بصيغ أوامر جيدة وسيئة، وقائمة تحقق ختامية.</p>
              </article>
            </div>

            <p>نقطة ثالثة: الوثيقتان مو مشروع قانون جديد، ولا تستبدلان الأنظمة السارية. النسخة الحكومية تقول إنها تتوافق مع الأنظمة والسياسات الحالية وتدعم الامتثال لها، بما يشمل حوكمة البيانات والخصوصية والأمن والملكية الفكرية. يعني هي طبقة إرشاد فوق التزاماتك. وإذا كان عندك شك في حدود الالتزام، اقرأ <a href="/knowledge/saudi-ai-law-binding-vs-guidance/">الفرق بين الملزم والإرشادي في ملف الذكاء الاصطناعي</a>.</p>
          </section>

          <section id="tree" aria-labelledby="tree-title">
            <div class="k3-sec-head"><span class="k3-sec-num" aria-hidden="true">02</span><h2 id="tree-title">أيهما ينطبق على منشأتك؟ (شجرة قرار)</h2></div>
            <p class="k3-answer">ابدأ من طبيعة جهتك، بعدها من نوع البيانات، بعدها من دورك في المنظومة. إذا كنت جهة حكومية أو تعالج بيانات حكومية، فنسخة الجهات الحكومية هي مرجعك الأول. وإذا كنت منشأة خاصة تطور أو تستخدم أدوات توليدية، فنسخة العموم هي الحد الأدنى.</p>

            <figure class="k3-tree">
              <svg viewBox="0 0 720 560" role="img" aria-labelledby="tree-svg-title tree-svg-desc" focusable="false">
                <title id="tree-svg-title">شجرة قرار: أي نسخة من إرشادات الذكاء الاصطناعي التوليدي تنطبق عليك؟</title>
                <desc id="tree-svg-desc">سلسلة من ثلاثة أسئلة: هل جهتك حكومية أو تتعامل ببيانات حكومية؟ إن كانت الإجابة نعم فمرجعك نسخة الجهات الحكومية. إن كانت لا، هل تستخدم أداة توليدية في عمل المنشأة؟ إن كانت نعم فمرجعك نسخة العموم مع سياسة داخلية. إن كانت لا، هل تطور أو تنشر نموذجاً يستخدمه الجمهور؟ إن كانت نعم فمرجعك نسخة العموم مع مبادئ الأخلاقيات. وإن كانت لا فأنت من المتأثرين وتفيدك النسخة العامة.</desc>
                <defs>
                  <marker id="k3-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                    <path d="M 0 0 L 10 5 L 0 10 z" fill="#4aa8c9" />
                  </marker>
                </defs>
                <g class="k3-tree-start">
                  <rect x="240" y="8" width="240" height="42" rx="21" />
                  <text x="360" y="35" text-anchor="middle">ابدأ من هنا</text>
                </g>

                <line x1="360" y1="50" x2="360" y2="76" class="k3-tree-line" marker-end="url(#k3-arrow)" />

                <g class="k3-tree-q">
                  <rect x="360" y="80" width="336" height="86" rx="12" />
                  <text x="528" y="112" text-anchor="middle">هل جهتك حكومية،</text>
                  <text x="528" y="136" text-anchor="middle">أو تتعامل ببيانات حكومية؟</text>
                </g>
                <g class="k3-tree-r k3-tree-r--gov">
                  <rect x="24" y="80" width="288" height="86" rx="12" />
                  <text x="168" y="112" text-anchor="middle">نسخة الجهات الحكومية</text>
                  <text x="168" y="136" text-anchor="middle">+ الأدوار والملاحق</text>
                </g>
                <line x1="356" y1="123" x2="316" y2="123" class="k3-tree-line" marker-end="url(#k3-arrow)" />
                <text x="336" y="113" text-anchor="middle" class="k3-tree-yn">نعم</text>

                <line x1="528" y1="166" x2="528" y2="196" class="k3-tree-line" marker-end="url(#k3-arrow)" />
                <text x="540" y="188" text-anchor="start" class="k3-tree-yn">لا</text>

                <g class="k3-tree-q">
                  <rect x="360" y="200" width="336" height="86" rx="12" />
                  <text x="528" y="232" text-anchor="middle">تستخدم أداة توليدية</text>
                  <text x="528" y="256" text-anchor="middle">في عمل المنشأة؟</text>
                </g>
                <g class="k3-tree-r">
                  <rect x="24" y="200" width="288" height="86" rx="12" />
                  <text x="168" y="232" text-anchor="middle">نسخة العموم</text>
                  <text x="168" y="256" text-anchor="middle">+ سياسة استخدام داخلية</text>
                </g>
                <line x1="356" y1="243" x2="316" y2="243" class="k3-tree-line" marker-end="url(#k3-arrow)" />
                <text x="336" y="233" text-anchor="middle" class="k3-tree-yn">نعم</text>

                <line x1="528" y1="286" x2="528" y2="316" class="k3-tree-line" marker-end="url(#k3-arrow)" />
                <text x="540" y="308" text-anchor="start" class="k3-tree-yn">لا</text>

                <g class="k3-tree-q">
                  <rect x="360" y="320" width="336" height="86" rx="12" />
                  <text x="528" y="352" text-anchor="middle">تطوّر أو تنشر نموذجاً</text>
                  <text x="528" y="376" text-anchor="middle">يستخدمه الجمهور؟</text>
                </g>
                <g class="k3-tree-r">
                  <rect x="24" y="320" width="288" height="86" rx="12" />
                  <text x="168" y="352" text-anchor="middle">نسخة العموم</text>
                  <text x="168" y="376" text-anchor="middle">+ مبادئ الأخلاقيات</text>
                </g>
                <line x1="356" y1="363" x2="316" y2="363" class="k3-tree-line" marker-end="url(#k3-arrow)" />
                <text x="336" y="353" text-anchor="middle" class="k3-tree-yn">نعم</text>

                <line x1="528" y1="406" x2="528" y2="436" class="k3-tree-line" marker-end="url(#k3-arrow)" />
                <text x="540" y="428" text-anchor="start" class="k3-tree-yn">لا</text>

                <g class="k3-tree-end">
                  <rect x="360" y="440" width="336" height="96" rx="12" />
                  <text x="528" y="474" text-anchor="middle">أنت في خانة المتأثر</text>
                  <text x="528" y="498" text-anchor="middle">النسخة العامة تفيدك في فهم حقك،</text>
                  <text x="528" y="520" text-anchor="middle">والملاحظة ترفعها للجهة المسؤولة</text>
                </g>
              </svg>
              <figcaption>الأرقام <bdi dir="ltr">P115</bdi> و<bdi dir="ltr">P116</bdi> هي أرقام الوثائق الرسمية في مايو 2025. المخطط للتوضيح ولا يعفي من مراجعة نطاق الوثيقة.</figcaption>
              <details class="k3-tree-alt">
                <summary>النص البديل لشجرة القرار</summary>
                <ol>
                  <li>إذا كانت جهتك حكومية، أو تعالج بيانات حكومية بصفتك مقاولاً أو مشغّلاً: مرجعك نسخة الجهات الحكومية بملاحقها.</li>
                  <li>إذا لم تكن كذلك، وتستخدم أداة توليدية في عمل المنشأة: مرجعك نسخة العموم، وتحتاج سياسة استخدام داخلية.</li>
                  <li>إذا كنت تطوّر أو تنشر نموذجاً يستخدمه الجمهور: مرجعك نسخة العموم مع مبادئ أخلاقيات الذكاء الاصطناعي.</li>
                  <li>إذا لم تكن مطوراً ولا جهة مستخدمة، وأنت متأثر بالمخرجات: النسخة العامة تعطيك لغة الحقوق والاعتراض.</li>
                </ol>
              </details>
            </figure>

            <p>ثلاث نقاط عملية. الأولى: تعريف «مستخدمي البيانات الحكومية» واسع ويشمل المقاولين، فالمقاول اللي يشتغل على بيانات جهة حكومية داخل النطاق ولو كانت شركته خاصة. الثانية: كونك منشأة خاصة ما يعفيك إذا كانت البيانات حكومية، لأن الحكم متعلق بالبيانات والغرض مو بالاسم. الثالثة: الجهات التي لها شركات تابعة أو مشاريع مشتركة تحتاج مراجعة الامتثال في الجهة الأم.</p>
            <p>وإذا كنت في القطاع الحكومي، <a href="/solutions/government/">صفحة حل الجهات الحكومية في BRIGHTAI</a> تعرض أسئلة التخطيط التي تسبق أي استخدام، وهي إطار أسئلة لا توصية تشغيلية.</p>
          </section>

          <section id="diff" aria-labelledby="diff-title">
            <div class="k3-sec-head"><span class="k3-sec-num" aria-hidden="true">03</span><h2 id="diff-title">أهم الفروقات بين النسختين</h2></div>
            <p class="k3-answer">الفرق الجوهري ليس في عدد المبادئ، بل في ثلاثة أشياء: من تخاطبه الوثيقة، وما البيانات التي يُسمح بإدخالها، ومن يملك القرار والمراجعة. النسخة الحكومية أضيق في البيانات وأوسع في الأدوار والملاحق.</p>

            <div class="k3-table-wrap">
              <table class="k3-table">
                <caption>مقارنة عامة بين الوثيقتين كما وردت في نسختيهما الصادرتين في مايو 2025</caption>
                <thead>
                  <tr><th scope="col">البند</th><th scope="col">نسخة العموم</th><th scope="col">نسخة الجهات الحكومية</th></tr>
                </thead>
                <tbody>
                  <tr><th scope="row">الجمهور</th><td>الجميع: مطورون، مستخدمون، متأثرون</td><td>العاملون في الجهات الحكومية ومستخدمو البيانات الحكومية</td></tr>
                  <tr><th scope="row">البيانات</th><td>تحذير من البيانات الحساسة وتدابير لحمايتها</td><td>منع إدخال «مقيد» فأعلى، وقصر الاستخدام على البيانات «العامة»</td></tr>
                  <tr><th scope="row">القرارات</th><td>مسؤولية المطور والمستخدم عن المخرجات</td><td>الامتناع عن القرارات الحاسمة، ومراجعة بشرية لجميع النتائج</td></tr>
                  <tr><th scope="row">الأدوار</th><td>مطوّر ومستخدم</td><td>مكتب إدارة البيانات، والمستخدمون، والجهة الحكومية</td></tr>
                  <tr><th scope="row">الأدوات العملية</th><td>سبع فئات مخاطر مع تدابير تخفيف</td><td>أدلة بصيغ أوامر جيدة وسيئة، وقائمة تحقق ختامية</td></tr>
                  <tr><th scope="row">الوصف الرسمي</th><td>مبادئ ومرجع للعموم</td><td>مبادئ موصوفة بأنها «إلزامية» للبيانات الحكومية</td></tr>
                </tbody>
              </table>
            </div>

            <div class="k3-switchbar">
              <div class="k3-switch" role="group" aria-label="اختر النسخة لعرض بطاقتها وأمثلتها">
                <span class="k3-switch-pill" aria-hidden="true"></span>
                <button type="button" data-k3-set="public" aria-pressed="true" aria-controls="panel-public panel-lights-public">
                  <span>للعموم</span><small><bdi dir="ltr">P115</bdi></small>
                </button>
                <button type="button" data-k3-set="gov" aria-pressed="false" aria-controls="panel-gov panel-lights-gov">
                  <span>للجهات الحكومية</span><small><bdi dir="ltr">P116</bdi></small>
                </button>
              </div>
              <p class="k3-switch-note">المفتاح يبدّل بطاقة الوثيقة وأمثلة الاستخدام. كل النصوص موجودة في الصفحة.</p>
            </div>

            <div class="k3-panel" id="panel-public" data-k3-panel="public">
              <div class="k3-panel-in">
                <div class="k3-panel-head">
                  <p class="k3-panel-kicker">بطاقة الوثيقة · للعموم</p>
                  <h3>مرجع المبادئ والمخاطر لكل من يستخدم أداة توليدية</h3>
                </div>
                <dl class="k3-facts">
                  <div><dt>الاسم الرسمي</dt><dd>مبادئ الذكاء الاصطناعي التوليدي للعموم</dd></div>
                  <div><dt>الرقم والإصدار</dt><dd><bdi dir="ltr">SDAIA-P115</bdi> — الإصدار 1</dd></div>
                  <div><dt>التاريخ</dt><dd>مايو 2025</dd></div>
                  <div><dt>المحتوى</dt><dd>تعريفات، نطاق، فوائد، سبعة مبادئ، سبع فئات مخاطر وتدابير</dd></div>
                </dl>
                <p>وش يعني هذا لك؟ إذا كنت منشأة خاصة، هذي وثيقتك الأساسية: منها تبني السياسة وتحدد ما يحتاج مراجعة بشرية. لكنها ما تعطيك نموذجاً ولا أدواراً مؤسسية، وهذي فجوة تسدها بـ<a href="/knowledge/ai-use-policy-employees/">سياسة استخدام الذكاء الاصطناعي للموظفين</a>.</p>
              </div>
            </div>

            <div class="k3-panel" id="panel-gov" data-k3-panel="gov">
              <div class="k3-panel-in">
                <div class="k3-panel-head">
                  <p class="k3-panel-kicker">بطاقة الوثيقة · للجهات الحكومية</p>
                  <h3>مرجع الضوابط على البيانات الحكومية والأدوار داخل الجهة</h3>
                </div>
                <dl class="k3-facts">
                  <div><dt>الاسم الرسمي</dt><dd>مبادئ الذكاء الاصطناعي التوليدي للجهات الحكومية</dd></div>
                  <div><dt>الرقم والإصدار</dt><dd><bdi dir="ltr">SDAIA-P116</bdi> — الإصدار 1</dd></div>
                  <div><dt>التاريخ</dt><dd>مايو 2025</dd></div>
                  <div><dt>المحتوى</dt><dd>تعريفات، نطاق، سبعة مبادئ، أدوار، ملحقان: أدلة عملية وقائمة تحقق</dd></div>
                </dl>
                <p>وش يعني هذا لك؟ المراجعة ما عادت «هل الأداة جيدة؟» فقط، بل «هل هي معتمدة؟ ومن وافق؟ ووش تصنيف البيانات؟». الوثيقة تنسب لمكتب إدارة البيانات الموافقة على الأدوات بعد مراجعة سياسات الخصوصية والإفصاح، وتدقيق جودة بيانات التدريب ومدى التحيز.</p>
              </div>
            </div>

            <p>الفرق الثالث اللي يستحق التنبيه: النسخة الحكومية ما تتوقف عند «لا تدخل بيانات حساسة». تقول بالنص: «يجب على العاملين في الجهات الحكومية عدم إدخال أي بيانات تصنف على مستوى مقيد فأعلى (مقيد، وسري، وسري للغاية)»، ثم تضيف: «يجب قصر استخدام أدوات الذكاء الاصطناعي التوليدي على البيانات المصنفة على أنها بيانات عامة». البند الثاني أضيق من الأول. القراءة العملية الآمنة: اعتبر الأصل «العام» هو المسموح، وأي شيء أعلى منه يحتاج قراراً مكتوباً ومراجعة من مكتب إدارة البيانات قبل الاستخدام، مو بعد ما يصير.</p>
            <p>وهنا يظهر الرابط بـ<a href="/knowledge/saudi-ai-ethics-principles/">مبادئ أخلاقيات الذكاء الاصطناعي في السعودية</a>: المبادئ السبعة نفسها في الوثيقتين، لكن النسخة الحكومية تحوّلها إلى التزامات تشغيلية بأدوار وقوائم.</p>
            <!-- TODO-VERIFY: هل يترتب على وصف المبادئ بأنها «إلزامية» في وثيقة الجهات الحكومية أثر نظامي مباشر أو جزاء مستقل؟ يحتاج رأياً قانونياً بشرياً على حالة الجهة؛ الصياغة هنا تحفظ الفرق بين وصف الوثيقة لنفسها وبين الالتزام الساري. -->
          </section>

          <section id="lights" aria-labelledby="lights-title">
            <div class="k3-sec-head"><span class="k3-sec-num" aria-hidden="true">04</span><h2 id="lights-title">مثلث الاستخدام: مسموح، بشروط، ممنوع (أمثلة من العمل اليومي)</h2></div>
            <p class="k3-answer">الأمثلة هنا توضيحية وليست تصنيفاً نظامياً. الفكرة أن كل مثال يمر بثلاث بوابات: نوع البيانات، هل فيه أثر على شخص، وهل فيه مراجعة بشرية قبل الاستخدام. إذا اختل شرط واحد، انتقل المثال من الأخضر إلى الأصفر أو الأحمر.</p>
            <p>خلنا نتكلم بصراحة: أغلب المخالفات ما تصير لأن أحد يبي يخالف، بل لأن الموظف يبي يخلص شغله بسرعة فيلصق نصاً فيه اسم عميل. عشان كذا التصنيف لازم يكون مربوطاً بمثال يعرفه الموظف.</p>

            <div class="k3-panel" id="panel-lights-public" data-k3-panel="public">
              <div class="k3-panel-in">
                <p class="k3-lights-title">أمثلة للعموم — منشأة خاصة أو فريق عمل</p>
                <ul class="k3-lights">
                  <li class="k3-light" data-light="green">
                    <span class="k3-light-tag"><span class="k3-dot" aria-hidden="true"></span>مسموح</span>
                    <h3>صياغة وتلخيص محتوى عام</h3>
                    <ul class="k3-light-list">
                      <li>إعادة صياغة نص منشور أصلاً للعامة، أو تلخيص مقال للاستخدام الداخلي.</li>
                      <li>توليد أفكار لعرض تقديمي بلا أي بيانات عملاء أو أرقام داخلية.</li>
                      <li>تحسين صياغة بريد لا يحتوي أسماء أو مرفقات أو تفاصيل عقد.</li>
                    </ul>
                    <p class="k3-why">ليش مسموح؟ ما فيه بيانات محمية ولا أثر على شخص، والمراجعة النهائية عندك قبل الإرسال.</p>
                  </li>
                  <li class="k3-light" data-light="amber">
                    <span class="k3-light-tag"><span class="k3-dot" aria-hidden="true"></span>بشروط</span>
                    <h3>محتوى تسويقي وصور وترجمة</h3>
                    <ul class="k3-light-list">
                      <li>صور أو فيديو توليدي للحملات: إفصاح واضح، ومراجعة بشرية قبل النشر، وفحص حقوق الاستخدام.</li>
                      <li>ترجمة نص رسمي: ترجمة عكسية ومراجعة لغوية، لأن الأخطاء الدقيقة تغيّر المعنى.</li>
                      <li>كود مساعد: وسم الكود المولّد، واختباره، ومراجعة من مالك المكوّن.</li>
                    </ul>
                    <p class="k3-why">ليش بشروط؟ المخاطرة مو في الأداة، بل في النشر والاعتماد. لذلك تحتاج إفصاحاً ومراجعة وسجلاً.</p>
                  </li>
                  <li class="k3-light" data-light="red">
                    <span class="k3-light-tag"><span class="k3-dot" aria-hidden="true"></span>ممنوع</span>
                    <h3>بيانات محمية أو انتحال هوية</h3>
                    <ul class="k3-light-list">
                      <li>لصق بيانات عملاء أو عقود أو مفاتيح دخول في أداة غير معتمدة.</li>
                      <li>توليد صوت أو صورة لشخص حقيقي ونشرها دون إذن واضح.</li>
                      <li>الاعتماد على مخرج آلي في قرار توظيف أو تقييم أو حرمان من خدمة.</li>
                    </ul>
                    <p class="k3-why">ليش ممنوع؟ هنا ينتقل الخطر من جودة النص إلى ضرر على شخص أو المنشأة، والوثيقة تعالج التزييف العميق وتسرب البيانات ضمن فئات المخاطر.</p>
                  </li>
                </ul>
                <p class="k3-more">تفاصيل البوابة الأولى موجودة في <a href="/knowledge/protect-company-data-chatgpt/">قائمة قرار حماية بيانات المنشأة عند استخدام ChatGPT</a>.</p>
              </div>
            </div>

            <div class="k3-panel" id="panel-lights-gov" data-k3-panel="gov">
              <div class="k3-panel-in">
                <p class="k3-lights-title">أمثلة للجهات الحكومية — موظف يتعامل مع بيانات حكومية</p>
                <ul class="k3-lights">
                  <li class="k3-light" data-light="green">
                    <span class="k3-light-tag"><span class="k3-dot" aria-hidden="true"></span>مسموح</span>
                    <h3>عمل على بيانات عامة أو مفتوحة</h3>
                    <ul class="k3-light-list">
                      <li>تلخيص وثيقة منشورة أو تقرير متاح للعامة.</li>
                      <li>قالب خطة مشروع عام دون أسماء أنظمة أو موظفين أو ميزانية.</li>
                      <li>تبسيط نص توعوي موجّه للمستفيدين بصياغة أوضح.</li>
                    </ul>
                    <p class="k3-why">ليش مسموح؟ الوثيقة تقصر الاستخدام على البيانات «العامة»، وهذي الأمثلة داخل هذا الحد.</p>
                  </li>
                  <li class="k3-light" data-light="amber">
                    <span class="k3-light-tag"><span class="k3-dot" aria-hidden="true"></span>بشروط</span>
                    <h3>مسودات تمس المستفيد أو تحليل بيانات</h3>
                    <ul class="k3-light-list">
                      <li>مسودة رد على استفسار: تحتاج مراجعة بشرية وإفصاحاً عند الحاجة، ولا تُرسل كما هي.</li>
                      <li>تحليل مجموعة بيانات: بيانات عامة أو مفتوحة، مع إخفاء هوية، وموافقة مالك البيانات، وسجل للعملية.</li>
                      <li>استخدام أداة جديدة: لا تبدأ قبل اعتمادها من مكتب إدارة البيانات بعد مراجعة سياسات الخصوصية والإفصاح.</li>
                    </ul>
                    <p class="k3-why">ليش بشروط؟ لأن كل بند هنا يحتاج قراراً موثقاً من جهة مخولة، مو اجتهاداً فردياً.</p>
                  </li>
                  <li class="k3-light" data-light="red">
                    <span class="k3-light-tag"><span class="k3-dot" aria-hidden="true"></span>ممنوع</span>
                    <h3>بيانات مصنفة أو قرارات حاسمة</h3>
                    <ul class="k3-light-list">
                      <li>إدخال أي بيانات مصنفة «مقيد» أو «سري» أو «سري للغاية» — منع صريح في الوثيقة.</li>
                      <li>استخدام الأداة في قرار حاسم يؤثر على فرد أو على مصلحة حيوية للمملكة.</li>
                      <li>الاعتماد على مخرج آلي دون مراجعة بشرية، أو تحليل بيانات شخصية غير مجهولة.</li>
                    </ul>
                    <p class="k3-why">ليش ممنوع؟ الوثيقة تمنع القرارات الحاسمة وتشترط مراجعة بشرية لجميع النتائج، وتضع حداً واضحاً لتصنيف البيانات.</p>
                  </li>
                </ul>
                <p class="k3-more">إذا كان عندك أداة يستخدمها الفريق بدون اعتماد، ابدأ من <a href="/knowledge/shadow-ai-detection/">كشف الاستخدام غير المعتمد للذكاء الاصطناعي</a> قبل أي إجراء انضباطي.</p>
              </div>
            </div>

            <p>ملاحظة على الإشارات: «بشروط» ما تعني «موافق عليه ضمناً». تعني أن المثال يحتاج قراراً ومراجعة وسجلاً قبل التنفيذ، وأن اعتماد الأداة نفسها شرط أول في الجهات الحكومية.</p>
          </section>

          <section id="risks" aria-labelledby="risks-title">
            <div class="k3-sec-head"><span class="k3-sec-num" aria-hidden="true">05</span><h2 id="risks-title">المخاطر التي تعالجها الإرشادات (الخصوصية، الدقة، الملكية الفكرية، التزييف)</h2></div>
            <p class="k3-answer">الوثيقتان تعالجان المخاطر نفسها من زاويتين: نسخة العموم تسمّي سبع فئات مخاطر مع تدابير تخفيف، ونسخة الجهات الحكومية تركّز على تسرب البيانات والتضليل والتزييف العميق والتحيز ومخاوف السلامة، ثم تعطيك أدلة عملية لكل نشاط.</p>

            <div class="k3-risk-grid">
              <article class="k3-risk-card">
                <p class="k3-risk-no">01</p>
                <h3>الخصوصية وتسرب البيانات</h3>
                <p>المدخلات قد تُحفظ وتُستخدم لتطوير الخدمة، وقد يصعب لاحقاً تحديد ما تسرب أو جعله «يُنسى». الوثيقة توصي ببروتوكولات استخدام تمنع إدخال المعلومات المصنفة، وتوعية الموظفين، وخيارات للمستخدم للتحكم ببياناته عند توفرها.</p>
                <p class="k3-risk-act">إجراء عملي: قائمة أدوات معتمدة، وقاعدة «لا لصق» للبيانات المحمية، وقناة إبلاغ عند الخطأ.</p>
              </article>
              <article class="k3-risk-card">
                <p class="k3-risk-no">02</p>
                <h3>الدقة والهلوسة</h3>
                <p>النماذج قد تولّد «حقائق» بثقة عالية. الوثيقة توصي بالتحقق من المحتوى والاستشهاد بالمصادر، وتنبيه المستخدم عند انخفاض الدقة، وتذكيره دورياً بأن المخرجات قد تكون قديمة أو متحيزة.</p>
                <p class="k3-risk-act">إجراء عملي: قاعدة مصدرين لكل رقم أو ادعاء، ومراجعة بشرية موقّعة قبل النشر.</p>
              </article>
              <article class="k3-risk-card">
                <p class="k3-risk-no">03</p>
                <h3>الملكية الفكرية</h3>
                <p>المخاطر تشمل استخدام مواد محمية في التدريب أو في المخرجات. الوثيقة تتحدث عن تراخيص للملكية الفكرية، وفحص نافٍ للجهالة قبل الاستخدام، واحترام حقوق النشر في المحتوى المولّد.</p>
                <p class="k3-risk-act">إجراء عملي: سؤال المورد عن بيانات التدريب، وسجل للأصول المستخدمة، ومراجعة قانونية للمواد الحساسة.</p>
              </article>
              <article class="k3-risk-card">
                <p class="k3-risk-no">04</p>
                <h3>التزييف العميق والتضليل</h3>
                <p>الوثيقة تسمّي التزييف العميق ضمن أكبر المخاطر، وتوصي بالعلامات المائية، والتحقق من المخرجات، وتوعية الجمهور بطرق التعرف على المحتوى المزيف.</p>
                <p class="k3-risk-act">إجراء عملي: سياسة نشر للصور والصوت، وإفصاح إلزامي، وتحقق من الهوية عبر قناة بديلة عند الطلبات المالية.</p>
              </article>
            </div>

            <p>نسخة العموم تزيد تفاصيل مثل التحقق من طلب المستخدم ومخرجاته، وتصفية بيانات التدريب، وتوضيح الكود المولّد. ونسخة الجهات الحكومية تعيد صياغة المخاطر نفسها بلسان حكومي: تسرب معلومات مقيدة، وتضليل، وتزييف عميق، وتحيز، ومخاوف سلامة.</p>
            <p>والوثيقة تفرّق بين «المخاطر البسيطة أو المنعدمة» و«المحدودة» و«العالية» و«غير المقبولة»، وتربط كل مستوى بالتزامات إضافية. الأداة قد تكون محدودة الخطر، لكن حالة الاستخدام ترفعها: مترجم نصوص عام محدود، ونفس المترجم لتفسير قرار على مستفيد أعلى بكثير.</p>
            <p>للتعمق في جانب الدقة، اقرأ <a href="/knowledge/ai-hallucinations-controls/">ضوابط التعامل مع هلوسة الذكاء الاصطناعي</a>، ولجانب المحتوى المزيف اقرأ <a href="/knowledge/deepfake-policy-organizations/">سياسة التعامل مع التزييف العميق في المنشآت</a>. وإذا كان عندك مساعد محادثة داخلي، أضف طبقة حماية من <a href="/knowledge/prompt-injection/">هجمات حقن الأوامر</a> لأن المحتوى الخارجي قد يغيّر سلوك النموذج.</p>
          </section>

          <section id="apply" aria-labelledby="apply-title">
            <div class="k3-sec-head"><span class="k3-sec-num" aria-hidden="true">06</span><h2 id="apply-title">كيف تطبّقها داخل منشأتك: سياسة، تدريب، أدوات معتمدة</h2></div>
            <p class="k3-answer">التطبيق العملي يقوم على ثلاث ركائز: سياسة مكتوبة تعرف بها المسموح والمشروط والممنوع، وتدريب يربط القاعدة بسيناريو يومي، وقائمة أدوات معتمدة بمالك واضح لكل أداة. أضف إليها سجلاً يثبت القرار، لأن الوثيقة تتحدث عن المراجعة والتدقيق لا عن النوايا.</p>

            <ol class="k3-steps">
              <li><b>اجرد أولاً.</b> اكتب كل أداة توليدية تُستخدم فعلاً، ولو كانت غير رسمية، مع الغرض والبيانات والمستخدمين. <a href="/knowledge/ai-inventory-register/">سجل استخدامات الذكاء الاصطناعي</a> يثبت الأداة والغرض والبيانات والمالك.</li>
              <li><b>اكتب سياسة قصيرة.</b> صفحتان تكفيان: المسموح، والمشروط بموافقة، والممنوع، وقناة الإبلاغ، ومسار التصعيد. لا تنسخ نص الوثيقة؛ اكتب قراراً يمكن للموظف تنفيذه اليوم.</li>
              <li><b>أعتمد الأدوات رسمياً.</b> لكل أداة: مالك، ومراجعة خصوصية وعقد، وحدود بيانات، وتاريخ مراجعة قادم. وفي الجهة الحكومية، الاعتماد يمر بمكتب إدارة البيانات بعد مراجعة سياسات الخصوصية والإفصاح.</li>
              <li><b>درّب على سيناريوهات.</b> مو محاضرة عن «أخلاقيات الذكاء الاصطناعي»، بل ثلاث حالات: نص عام، رسالة مستفيد، وطلب ربط أداة بنظام داخلي. <a href="/knowledge/ai-employee-training/">خطة تدريب الموظفين على الذكاء الاصطناعي</a> تعطيك هيكل الجلسة.</li>
              <li><b>افحص المورد قبل التوقيع.</b> اسأل عن بيانات التدريب، والاحتفاظ، وموقع المعالجة، وكيف تطلب حذف بياناتك. <a href="/knowledge/ai-vendor-assessment/">تقييم موردي الذكاء الاصطناعي</a> يحوّل هذي الأسئلة إلى ملف واحد.</li>
              <li><b>راجع كل ربع.</b> أعد التقييم عند تغيير أداة أو نموذج أو نوع بيانات، وتحقّق من النسخة السارية قبل الاعتماد.</li>
            </ol>

            <div class="k3-check">
              <p class="k3-check-title">قائمة تحقق سريعة قبل أي استخدام — مستندة إلى بنود الوثيقتين</p>
              <ul>
                <li>الغرض محدد، والبيانات في الحد الأدنى اللازم.</li>
                <li>مستوى تصنيف البيانات معروف، ولا يوجد «مقيد» فأعلى في المدخلات.</li>
                <li>الأداة معتمدة، والحساب مؤسسي، وسياسة الاحتفاظ والتدريب مراجعة.</li>
                <li>هناك مراجعة بشرية للمخرج، واسم من اعتمد ووقت الاعتماد.</li>
                <li>الإفصاح عن المحتوى المولّد مضاف عند الحاجة، والوسم موجود في الكود والصور.</li>
                <li>المصادر المذكورة في المخرج تم التحقق منها، لا سيما الأرقام والاقتباسات.</li>
                <li>حقوق الاستخدام والملكية الفكرية مراجعة للمواد الحساسة.</li>
                <li>قناة الإبلاغ عن خطأ أو تسرب معروفة للفريق.</li>
              </ul>
            </div>

            <p>أما الأدوات نفسها، فالأفضل أن تبدأ من الاحتياج لا من المنتج. إذا كان الخطر الأكبر عندك هو لصق بيانات محمية، فأنت تحتاج ضابطاً قبل الإدخال، مثل تصور <a href="/products/firewall/">AIGAS Firewall</a> الذي يصف فحص المدخلات والمخرجات وفق سياسة المنشأة، وهو تصور مخطط لا خدمة متاحة. وإذا كانت المشكلة أن الفريق يستخدم أدوات غير معتمدة، فالضابط يبدأ بالجرد والاعتماد قبل أي تقنية.</p>
            <p>وفي الجهات التي تحتاج قناة محادثة داخل حدود واضحة، يصف تصور <a href="/products/secure-chat/">AIGAS Secure Chat</a> واجهة محادثة مؤسسية يمكن أن تخضع لسياسات اختيار الأدوات والمراجعة بعد إثبات البنية والتكاملات. الفكرة أن التقنية تخدم السياسة، مو العكس.</p>
            <!-- TODO-VERIFY: هل يتطلب اعتماد الأدوات في الجهة الحكومية إجراءً إدارياً محدداً (نموذج طلب، جهة اعتماد مركزية، مدة صلاحية)؟ الوثيقة تحدد المسؤولية ولا تحدد النموذج الإجرائي؛ يلزم تأكيده من الجهة ومكتب إدارة البيانات. -->
          </section>

          <section id="pdpl" aria-labelledby="pdpl-title">
            <div class="k3-sec-head"><span class="k3-sec-num" aria-hidden="true">07</span><h2 id="pdpl-title">علاقتها بحماية البيانات وPDPL</h2></div>
            <p class="k3-answer">نظام حماية البيانات الشخصية (PDPL) ينظم معالجة البيانات الشخصية داخل المملكة، وإدخال بيانات شخصية في أداة توليدية هو معالجة تحتاج أساساً مشروعاً وغرضاً محدداً وحداً أدنى من البيانات. الوثيقتان تربطان صراحة بين استخدام الأدوات والالتزام بـPDPL وبالأنظمة ذات الصلة.</p>
            <p>نسخة الجهات الحكومية تذكر PDPL في أكثر من موضع: ضمن مبدأ المساءلة والمسؤولية، وفي مبدأ الخصوصية والأمن، حيث تشير كذلك إلى معايير الأمن السيبراني ذات العلاقة الصادرة من الهيئة الوطنية للأمن السيبراني وسياسة تصنيف البيانات. ونسخة العموم توصي بتدابير حماية صارمة وبمراجعة مستمرة لتقييم الأثر على الخصوصية.</p>

            <div class="k3-ladder" role="group" aria-label="مستويات تصنيف البيانات وما يقابلها في استخدام الأدوات التوليدية">
              <p class="k3-ladder-title">سلّم التصنيف كما تتعامل معه نسخة الجهات الحكومية</p>
              <ul>
                <li class="k3-rung" data-level="open"><span class="k3-rung-label">عام</span><span class="k3-rung-note">الحد الذي تقصره الوثيقة على الاستخدام</span></li>
                <li class="k3-rung" data-level="restricted"><span class="k3-rung-label">مقيد</span><span class="k3-rung-note">ممنوع إدخاله</span></li>
                <li class="k3-rung" data-level="secret"><span class="k3-rung-label">سري</span><span class="k3-rung-note">ممنوع إدخاله</span></li>
                <li class="k3-rung" data-level="top"><span class="k3-rung-label">سري للغاية</span><span class="k3-rung-note">ممنوع إدخاله</span></li>
              </ul>
              <p class="k3-ladder-note">السلّم يوضح ما ورد في نص الوثيقة، ولا يستبدل سياسة تصنيف البيانات المعتمدة في جهتك.</p>
            </div>

            <p>عملياً، عندك أربعة أسئلة قبل أي إدخال: هل البيانات شخصية؟ ما أساس المعالجة والغرض؟ هل هناك حد أدنى يمكن إدخاله بدل النص الكامل؟ وهل توجد حاجة لنقل البيانات خارج المملكة أو لمشاركتها مع طرف ثالث؟ الوثيقة تطلب التحقق من سياسات الخصوصية للأدوات ومن بنود الإفصاح والمشاركة، وهذا يغطي جزءاً من الأسئلة لا كلها.</p>
            <p>ونقطة يعرفها من عمل في الخصوصية: حقوق الوصول والتصحيح والحذف تصعب في الأنظمة التوليدية لأن المعلومة مو مخزنة كمستند يمكن تعديله. عشان كذا الأفضل منع الإدخال من البداية، وهذا منطق الوثيقة الحكومية في قصر الاستخدام على البيانات العامة.</p>
            <p>للتفاصيل القانونية، اقرأ <a href="/knowledge/pdpl-and-ai/">دليل PDPL والذكاء الاصطناعي</a>، ولطريقة تصنيف البيانات قبل الإدخال اقرأ <a href="/knowledge/data-classification-for-ai/">تصنيف البيانات للذكاء الاصطناعي</a>. وعلى مستوى الموقع، يشرح <a href="/pillars/privacy/">ركن الخصوصية وحماية البيانات في BRIGHTAI</a> الأسئلة الثلاثة التي تسبق أي إدخال: نوع البيانات، والغرض، والقناة.</p>
            <!-- TODO-VERIFY: التفاصيل الإجرائية لنظام حماية البيانات الشخصية (المواد، مدد الإشعار، ضوابط النقل خارج المملكة، اللائحة التنفيذية السارية) لم تُراجع نصياً في هذه المهمة؛ ما ورد هنا توصيف عام ولا يُعتمد كاستشارة قانونية. -->
          </section>

