    box-shadow: 0 0 12px var(--k3-sky);
  }
  .k3-hero-id {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: #7d97a2;
  }
  .k3-lead {
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.95;
    color: #d5e4ea;
    max-inline-size: 74ch;
  }
  .k3-badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 22px;
    padding: 0;
  }
  .k3-badges li {
    font-size: 11.5px;
    color: #a9c3cd;
    border: 1px solid var(--k3-line);
    background: #07141a;
    border-radius: 999px;
    padding: 5px 11px;
  }
  .k3-badges li:first-child {
    color: var(--k3-sky-soft);
    border-color: var(--k3-sky-dim);
  }
  .k3-hero-split {
    display: grid;
    grid-template-columns: 1fr 46px 1fr;
    align-items: stretch;
    margin-block-start: 6px;
  }
  .k3-hero-half {
    padding: 18px 20px;
    border: 1px solid var(--k3-line);
    border-radius: 14px;
    background:
      radial-gradient(120% 100% at 100% 0%, #0d2733 0%, transparent 60%),
      #040d12;
  }
  .k3-hero-half--gov {
    border-style: dashed;
    border-color: #24515f;
    background:
      radial-gradient(120% 100% at 0% 0%, #0b2531 0%, transparent 60%),
      #040d12;
  }
  .k3-half-label {
    margin: 0 0 4px;
    font-size: 10.5px;
    letter-spacing: 0.07em;
    color: var(--k3-sky);
  }
  .k3-half-title {
    margin: 0 0 6px;
    color: #fff;
    font-size: 15.5px;
    line-height: 1.65;
  }
  .k3-half-meta {
    margin: 0;
    font-size: 11.5px;
    color: #8fa9b4;
  }
  .k3-hero-seam {
    position: relative;
    display: grid;
    place-items: center;
  }
  .k3-hero-seam::before {
    content: "";
    position: absolute;
    inset-block: 12px;
    inline-size: 1px;
    background: linear-gradient(to bottom, transparent, var(--k3-sky-dim), transparent);
  }
  .k3-hero-seam span {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: 30px;
    block-size: 30px;
    border-radius: 50%;
    border: 1px solid var(--k3-sky-dim);
    background: #04121a;
    color: var(--k3-sky);
    font-size: 11px;
  }

  .k3-alert {
    margin-block: 20px;
    padding: 13px 16px;
    border: 1px solid #2a4b58;
    border-inline-start: 3px solid var(--k3-sky);
    border-radius: 10px;
    background: #06141b;
    font-size: 13px;
    line-height: 1.85;
    color: #c8dbe3;
  }

  .k3-tldr,
  .k3-def {
    margin-block: 26px;
    padding: 20px 22px;
    border: 1px solid var(--k3-line);
    border-radius: 14px;
    background: linear-gradient(180deg, #071319, #040c11);
  }
  .k3-tldr h2,
  .k3-def h2 { font-size: 20px; margin-block-end: 12px; }
  .k3-tldr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .k3-tldr li {
    position: relative;
    padding-inline-start: 18px;
    font-size: 15px;
  }
  .k3-tldr li::before {
    content: "";
    position: absolute;
    inset-inline-start: 2px;
    inset-block-start: 13px;
    inline-size: 7px;
    block-size: 7px;
    border-radius: 2px;
    background: var(--k3-sky);
    box-shadow: 0 0 8px color-mix(in srgb, var(--k3-sky) 60%, transparent);
  }
  .k3-def p { margin: 0; }

  .k3-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 26px;
    margin-block-start: 30px;
  }
  .k3-toc {
    border: 1px solid var(--k3-line);
    border-radius: 12px;
    padding: 16px;
    background: #050e13;
  }
  .k3-toc-label {
    margin: 0 0 10px;
    font-size: 10.5px;
    letter-spacing: 0.07em;
    color: var(--k3-sky);
  }
  .k3-toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    counter-reset: none;
  }
  .k3-toc a {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 40px;
    padding-inline: 6px;
    font-size: 13px;
    color: #c4d7de;
    text-decoration: none;
    border-radius: 7px;
    border-inline-start: 1px solid transparent;
  }
  .k3-toc a:hover {
    background: #08181f;
    border-inline-start-color: var(--k3-sky);
    color: #fff;
  }
  .k3-toc a span {
    font-size: 10px;
    color: var(--k3-sky);
    font-variant-numeric: tabular-nums;
  }
  .k3-toc-note {
    margin: 12px 0 0;
    font-size: 11px;
    color: #7f98a3;
    line-height: 1.7;
  }

  .k3-content > section {
    margin-block-end: 46px;
    scroll-margin-block-start: 24px;
  }
  .k3-content > section > p,
  .k3-tldr li,
  .k3-check li,
  .k3-steps li,
  .k3-faq p,
  .k3-light-list li,
  .k3-light h3,
  .k3-next-grid b {
    max-inline-size: 68ch;
  }
  .k3-sec-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-block-end: 6px;
  }
  .k3-sec-num {
    font-size: 11px;
    color: var(--k3-sky);
    font-variant-numeric: tabular-nums;
    border: 1px solid var(--k3-sky-dim);
    border-radius: 5px;
    padding: 2px 6px;
    flex: none;
  }
  .k3-answer {
    padding-inline-start: 14px;
    border-inline-start: 2px solid var(--k3-sky);
    color: #dbe9ef !important;
    font-size: 16px !important;
    margin-block: 10px 18px !important;
  }

  /* Document cards */
  .k3-docs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    gap: 12px;
    margin-block: 20px;
  }
  .k3-doc {
    padding: 18px;
    border: 1px solid var(--k3-line);
    border-radius: 13px;
    background:
      linear-gradient(160deg, #0a222c 0%, transparent 45%),
      #050f14;
  }
  .k3-doc--gov {
    border-style: dashed;
    border-color: #29596a;
  }
  .k3-doc-kicker {
    margin: 0 0 6px !important;
    font-size: 10.5px !important;
    color: var(--k3-sky) !important;
    letter-spacing: 0.05em;
  }
  .k3-doc h3 { font-size: 17px; }
  .k3-doc p { font-size: 14px; }
  .k3-doc-facts {
    margin: 12px 0;
    display: grid;
    gap: 5px;
    padding-block: 10px;
    border-block: 1px solid #122830;
  }
  .k3-doc-facts > div {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 12px;
  }
  .k3-doc-facts dt { color: #8aa5b0; }
  .k3-doc-facts dd { margin: 0; color: #d8e8ee; font-variant-numeric: tabular-nums; }

  /* Decision tree */
  .k3-tree {
    margin: 22px 0;
    padding: 16px;
    border: 1px solid var(--k3-line);
    border-radius: 14px;
    background:
      radial-gradient(90% 70% at 50% 0%, #0b2532 0%, transparent 70%),
      #040d12;
  }
  .k3-tree svg {
    inline-size: 100%;
    block-size: auto;
    max-block-size: 560px;
    display: block;
  }
  .k3-tree svg text {
    fill: #d7e8ee;
    font-size: 12.5px;
    font-family: inherit;
    direction: rtl;
  }
  .k3-tree-start rect { fill: #0a2632; stroke: var(--k3-sky-dim); }
  .k3-tree-start text { fill: var(--k3-sky); font-size: 12px; }
  .k3-tree-q rect { fill: #061820; stroke: #2a5d6f; }
  .k3-tree-r rect { fill: #07161c; stroke: #23505f; }
  .k3-tree-r--gov rect { fill: #092430; stroke: #3d8aa3; }
  .k3-tree-end rect { fill: #061318; stroke: #1f4653; }
  .k3-tree-end text { fill: #a9c4ce; font-size: 11.5px; }
  .k3-tree-line { stroke: #3f8ba3; stroke-width: 1.2; fill: none; }
  .k3-tree-yn { fill: #7fb6c8 !important; font-size: 10.5px !important; }
  .k3-tree figcaption {
    margin-block-start: 10px;
    font-size: 11.5px;
    line-height: 1.8;
    color: #8aa5b0;
    text-align: center;
  }
  .k3-tree-alt {
    margin-block-start: 12px;
    font-size: 12px;
    color: #a9c3cd;
  }
  .k3-tree-alt summary {
    cursor: pointer;
    min-height: 40px;
    display: flex;
    align-items: center;
    color: var(--k3-sky-soft);
  }
  .k3-tree-alt ol {
    list-style: none;
    counter-reset: treealt;
    margin: 10px 0 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .k3-tree-alt li {
    counter-increment: treealt;
    position: relative;
    padding-inline-start: 22px;
    font-size: 12.5px;
    line-height: 1.8;
  }
  .k3-tree-alt li::before {
    content: counter(treealt) ".";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    color: var(--k3-sky);
    font-size: 11px;
  }

  /* Comparison table */
  .k3-table-wrap {
    margin-block: 18px;
    overflow-x: auto;
    border: 1px solid var(--k3-line);
    border-radius: 12px;
    background: #050f14;
  }
  .k3-table {
    inline-size: 100%;
    min-inline-size: 640px;
    border-collapse: collapse;
    text-align: start;
  }
  .k3-table caption {
    padding: 12px 14px;
    font-size: 12px;
    color: #93aeb9;
    text-align: start;
    border-block-end: 1px solid var(--k3-line);
  }
  .k3-table th,
  .k3-table td {
    padding: 11px 13px;
    font-size: 13px;
    line-height: 1.8;
    border-block-end: 1px solid #10242c;
    text-align: start;
    vertical-align: top;
  }
  .k3-table thead th {
    background: #08202a;
    color: var(--k3-sky-soft);
    font-weight: 600;
    font-size: 12px;
    position: sticky;
    inset-block-start: 0;
  }
  .k3-table tbody th {
    color: #e6f3f8;
    background: #061319;
    font-weight: 600;
    white-space: nowrap;
  }
  .k3-table tbody tr:hover th,
  .k3-table tbody tr:hover td { background: #081b23; }

  /* Switch control */
  .k3-switchbar {
    position: sticky;
    inset-block-start: 8px;
    z-index: 6;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    margin-block: 24px 18px;
    padding: 10px;
    border: 1px solid #21505f;
    border-radius: 12px;
    background: color-mix(in srgb, #04121a 92%, transparent);
    backdrop-filter: blur(8px);
  }
  .k3-switch {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    inline-size: min(100%, 420px);
    padding: 4px;
    border: 1px solid #1d4451;
    border-radius: 10px;
    background: #030b0f;
    isolation: isolate;
  }
  .k3-switch-pill {
    position: absolute;
    inset-block: 4px;
    inset-inline-start: 4px;
    inline-size: calc(50% - 4px);
    border-radius: 7px;
    background: linear-gradient(180deg, #13404f, #0b2a35);
    border: 1px solid #2b7188;
    z-index: -1;
    transition: inset-inline-start 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .k3[data-mode="gov"] .k3-switch-pill { inset-inline-start: 50%; }
  .k3-switch button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 44px;
    padding: 6px 10px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: #a9c3cd;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .k3-switch button small {
    font-size: 9.5px;
    color: #6f909c;
    letter-spacing: 0.03em;
  }
  .k3-switch button[aria-pressed="true"] { color: #fff; }
  .k3-switch button[aria-pressed="true"] small { color: var(--k3-sky); }
  .k3-switch button:hover { color: #fff; }
  .k3-switch-note {
    margin: 0;
    flex: 1 1 220px;
    font-size: 11.5px;
    color: #849faa;
    line-height: 1.7;
  }

  /* Switchable panels */
  .k3-panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.38s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.26s ease;
    margin-block: 14px;
  }
  .k3-panel-in {
    min-block-size: 0;
    overflow: hidden;
    padding: 18px;
    border: 1px solid var(--k3-line);
    border-radius: 13px;
    background: #050f14;
    transition: padding 0.38s ease, border-width 0.38s ease;
  }
  .k3[data-mode="public"] .k3-panel[data-k3-panel="gov"],
  .k3[data-mode="gov"] .k3-panel[data-k3-panel="public"] {
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    margin-block: 0;
    transition: grid-template-rows 0.38s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.2s ease, visibility 0s 0.38s, margin-block 0.38s;
  }
  .k3[data-mode="public"] .k3-panel[data-k3-panel="gov"] .k3-panel-in,
  .k3[data-mode="gov"] .k3-panel[data-k3-panel="public"] .k3-panel-in {
    padding-block: 0;
    border-block-width: 0;
  }
  .k3-panel-head { margin-block-end: 12px; }
  .k3-panel-kicker {
    margin: 0 0 4px !important;
    font-size: 10.5px !important;
    color: var(--k3-sky) !important;
    letter-spacing: 0.05em;
  }
  .k3-facts {
    margin: 0 0 14px;
    display: grid;
    gap: 6px;
    padding-block-end: 12px;
    border-block-end: 1px solid #122830;
  }
  .k3-facts > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    font-size: 12.5px;
  }
  .k3-facts dt { color: #8aa5b0; }
  .k3-facts dd { margin: 0; color: #d6e7ee; text-align: end; }
  .k3-panel-in > p:last-child { margin-block-end: 0; }

  /* Traffic lights */
  .k3-lights-title {
    margin: 0 0 12px !important;
    font-size: 12px !important;
    color: var(--k3-sky-soft) !important;
    letter-spacing: 0.03em;
  }
  .k3-lights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .k3-light {
    padding: 15px 16px;
    border: 1px solid var(--k3-line);
    border-inline-start: 3px solid #2a5d6f;
    border-radius: 11px;
    background: #041016;
  }
  .k3-light[data-light="green"] { border-inline-start-color: var(--k3-green); }
  .k3-light[data-light="amber"] { border-inline-start-color: var(--k3-amber); }
  .k3-light[data-light="red"] { border-inline-start-color: var(--k3-red); }
  .k3-light-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: #b6ccd5;
    margin-block-end: 6px;
  }
  .k3-dot {
    inline-size: 9px;
    block-size: 9px;
    border-radius: 50%;
    background: #2a5d6f;
  }
  .k3-light[data-light="green"] .k3-dot { background: var(--k3-green); }
  .k3-light[data-light="amber"] .k3-dot { background: var(--k3-amber); }
  .k3-light[data-light="red"] .k3-dot { background: var(--k3-red); }
  .k3-light[data-light="green"] .k3-light-tag { color: var(--k3-green); }
  .k3-light[data-light="amber"] .k3-light-tag { color: var(--k3-amber); }
  .k3-light[data-light="red"] .k3-light-tag { color: var(--k3-red); }
  .k3-light h3 { font-size: 16px; margin-block-end: 8px; }
  .k3-light-list {
    list-style: none;
    margin: 0 0 10px;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .k3-light-list li {
    position: relative;
    padding-inline-start: 15px;
    font-size: 13.5px;
    line-height: 1.85;
  }
  .k3-light-list li::before {
    content: "";
    position: absolute;
    inset-inline-start: 2px;
    inset-block-start: 12px;
    inline-size: 5px;
    block-size: 5px;
    border-radius: 50%;
    background: #4a8ba1;
  }
  .k3-why {
    margin: 0 !important;
    font-size: 12.5px !important;
    color: #9db6c0;
    padding-inline-start: 10px;
    border-inline-start: 1px solid #1d3f4b;
  }
  .k3-more { margin-block: 12px 0; font-size: 13px; }

  /* Risk cards */
  .k3-risk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 10px;
    margin-block: 18px;
  }
  .k3-risk-card {
    padding: 16px;
    border: 1px solid var(--k3-line);
    border-radius: 12px;
    background: #050f14;
  }
  .k3-risk-no {
    margin: 0 0 6px !important;
    font-size: 10.5px !important;
    color: var(--k3-sky) !important;
    font-variant-numeric: tabular-nums;
  }
  .k3-risk-card h3 { font-size: 16px; }
  .k3-risk-card p { font-size: 13.5px; }
  .k3-risk-act {
    margin: 0 !important;
    padding: 9px 11px;
    border-radius: 8px;
    background: #071a21;
    border: 1px solid #173843;
    font-size: 12.5px !important;
    color: #bcd4dd !important;
  }

  /* Steps + checklist */
  .k3-steps {
    list-style: none;
    counter-reset: k3step;
    margin: 18px 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .k3-steps li {
    counter-increment: k3step;
    position: relative;
    padding: 13px 16px;
    padding-inline-start: 50px;
    border: 1px solid var(--k3-line);
    border-radius: 10px;
    background: #050f14;
    font-size: 14px;
  }
  .k3-steps li::before {
    content: counter(k3step, decimal-leading-zero);
    position: absolute;
    inset-inline-start: 14px;
    inset-block-start: 13px;
    font-size: 11px;
    color: var(--k3-sky);
    border: 1px solid var(--k3-sky-dim);
    border-radius: 4px;
    padding: 1px 5px;
    font-variant-numeric: tabular-nums;
  }
  .k3-check {
    margin-block: 20px;
    padding: 18px;
    border: 1px dashed #2b6070;
    border-radius: 13px;
    background: #04121a;
  }
  .k3-check-title {
    margin: 0 0 10px !important;
    font-size: 12px !important;
    color: var(--k3-sky) !important;
    letter-spacing: 0.04em;
  }
  .k3-check ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .k3-check li {
    position: relative;
    padding-inline-start: 26px;
    font-size: 13.5px;
  }
  .k3-check li::before {
    content: "";
    position: absolute;
    inset-inline-start: 4px;
    inset-block-start: 11px;
    inline-size: 10px;
    block-size: 10px;
    border: 1px solid #4b8ea5;
    border-radius: 2px;
  }

  /* Classification ladder */
  .k3-ladder {
    margin-block: 18px;
    padding: 16px;
    border: 1px solid var(--k3-line);
    border-radius: 13px;
    background: #041016;
  }
  .k3-ladder-title {
    margin: 0 0 12px !important;
    font-size: 12px !important;
    color: var(--k3-sky-soft) !important;
  }
  .k3-ladder ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 5px;
  }
  .k3-rung {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 12px;
    padding: 9px 12px;
    border-radius: 8px;
    border: 1px solid #193a45;
    background: #061820;
    font-size: 13px;
  }
  .k3-rung-label { color: #e3f1f6; font-weight: 600; }
  .k3-rung-note { font-size: 11.5px; color: #9bb6c1; }
  .k3-rung[data-level="open"] {
    border-color: #2f7f63;
    background: #06241d;
  }
  .k3-rung[data-level="open"] .k3-rung-note { color: var(--k3-green); }
  .k3-rung[data-level="restricted"],
  .k3-rung[data-level="secret"],
  .k3-rung[data-level="top"] { border-color: #5a2b32; background: #1a0b0f; }
  .k3-rung[data-level="restricted"] .k3-rung-note,
  .k3-rung[data-level="secret"] .k3-rung-note,
  .k3-rung[data-level="top"] .k3-rung-note { color: var(--k3-red); }
  .k3-rung[data-level="restricted"] { margin-inline-start: 0; }
  .k3-rung[data-level="secret"] { margin-inline-start: 8px; }
  .k3-rung[data-level="top"] { margin-inline-start: 16px; }
  .k3-ladder-note {
    margin: 10px 0 0 !important;
    font-size: 11px !important;
    color: #819ca7 !important;
  }

  /* FAQ */
  .k3-faq { display: grid; gap: 8px; }
  .k3-faq article {
    padding: 15px 17px;
    border: 1px solid var(--k3-line);
    border-radius: 11px;
    background: #050f14;
  }
  .k3-faq h3 { font-size: 15.5px; margin-block-end: 6px; }
  .k3-faq p { margin: 0; font-size: 14px; }

  /* Next + refs + CTA */
  .k3-next { padding-block-start: 8px; }
  .k3-next-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 8px;
    margin-block: 14px;
  }
  .k3-next-grid a {
    display: grid;
    gap: 4px;
    padding: 14px 15px;
    border: 1px solid var(--k3-line);
    border-radius: 11px;
    background: #050f14;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .k3-next-grid a:hover {
    border-color: #2b6c81;
    transform: translateY(-2px);
  }
  .k3-next-grid span { font-size: 10.5px; color: var(--k3-sky); }
  .k3-next-grid b { color: #fff; font-size: 14.5px; line-height: 1.6; }
  .k3-next-grid small { color: #97b0ba; font-size: 12px; line-height: 1.7; }
  .k3-site-link { margin-block: 12px 0; font-size: 13px; }
  .k3-refs {
    margin-block: 34px 0;
    padding-block-start: 20px;
    border-block-start: 1px solid var(--k3-line);
  }
  .k3-refs h2 { font-size: 20px; }
  .k3-refs ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 13px; }
  .k3-refs li { position: relative; padding-inline-start: 16px; }
  .k3-refs li::before {
    content: "";
    position: absolute;
    inset-inline-start: 3px;
    inset-block-start: 11px;
    inline-size: 5px;
    block-size: 5px;
    border-radius: 50%;
    background: var(--k3-sky);
  }
  .k3-fine {
    margin-block-start: 14px;
    font-size: 11.5px !important;
    color: #8ba5b0 !important;
    line-height: 1.8;
  }
  .k3-cta {
    margin-block: 30px 0;
    padding: 16px 18px;
    border: 1px solid var(--k3-line);
    border-radius: 12px;
    background: #04121a;
    font-size: 14px;
  }

  /* Reveal motion */
  .k3-reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .k3-reveal.is-in {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 960px) {
    .k3-layout {
      grid-template-columns: 226px minmax(0, 1fr);
      align-items: start;
      gap: 34px;
    }
    .k3-toc {
      position: sticky;
      inset-block-start: 16px;
    }
  }

  @media (max-width: 620px) {
    .k3-hero-split {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .k3-hero-seam { block-size: 22px; }
    .k3-hero-seam::before {
      inset-inline: 20%;
      inset-block: auto;
      inline-size: auto;
      block-size: 1px;
      background: linear-gradient(to left, transparent, var(--k3-sky-dim), transparent);
    }
    .k3-hero-seam span { inline-size: 26px; block-size: 26px; }
    .k3-rung { font-size: 12px; }
    .k3-sec-head { gap: 8px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .k3 *,
    .k3 *::before,
    .k3 *::after {
      transition-duration: 0.001ms !important;
      transition-delay: 0s !important;
      animation-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
    .k3-reveal { opacity: 1; transform: none; }
    .k3-next-grid a:hover { transform: none; }
  }

  @media print {
    .k3-switchbar,
    .k3-toc,
    .k3-cta { display: none !important; }
    .k3-panel {
      grid-template-rows: 1fr !important;
      opacity: 1 !important;
      visibility: visible !important;
      margin-block: 14px !important;
      break-inside: avoid;
    }
    .k3, .k3 p, .k3 li, .k3 td, .k3 th, .k3 dd { color: #111 !important; }
    .k3 a { color: #0b4a63 !important; }
    .k3-table, .k3-light, .k3-faq article, .k3-risk-card, .k3-doc { break-inside: avoid; }
    .k3-tree, .k3-table-wrap { break-inside: avoid; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-k3-root]');
  if (root) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-k3-set]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-k3-panel]'));

    const apply = (mode: string) => {
      root.dataset.mode = mode;
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.k3Set === mode));
      });
      panels.forEach((panel) => {
        const active = panel.dataset.k3Panel === mode;
        if (active) {
          panel.removeAttribute('aria-hidden');
          panel.removeAttribute('inert');
          return;
        }
        const holdsFocus = panel.contains(document.activeElement);
        panel.setAttribute('aria-hidden', 'true');
        if (!holdsFocus) panel.setAttribute('inert', '');
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        apply(button.dataset.k3Set ?? 'public');
      });
    });

    apply('public');

    // Reveal-on-scroll for section blocks, respecting reduced motion.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const targets = Array.from(
      root.querySelectorAll<HTMLElement>('.k3-content > section, .k3-docs > .k3-doc, .k3-risk-card')
    );
    if (reduce.matches || !('IntersectionObserver' in window)) {
      targets.forEach((element) => element.classList.add('is-in'));
    } else {
      targets.forEach((element) => element.classList.add('k3-reveal'));
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            observer.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      targets.forEach((element) => observer.observe(element));

      const onPreferenceChange = () => {
        if (!reduce.matches) return;
        targets.forEach((element) => element.classList.add('is-in'));
        observer.disconnect();
      };
      reduce.addEventListener('change', onPreferenceChange);
    }
  }
</script>
