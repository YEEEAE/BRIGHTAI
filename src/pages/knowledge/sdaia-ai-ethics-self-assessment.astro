  }
  .sc h2 { font-size: clamp(23px, 2.8vw, 33px); line-height: 1.5; margin-block: 0 14px; max-inline-size: 32ch; }
  .sc h3 { font-size: clamp(17px, 1.8vw, 20px); line-height: 1.6; margin-block: 0 8px; }
  .sc p, .sc li, .sc dd, .sc dt, .sc td, .sc th { line-height: 1.95; color: var(--sc-copy); overflow-wrap: anywhere; }
  .sc a { color: var(--sc-teal-soft); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .sc a:hover { color: var(--sc-teal); }
  .sc a:focus-visible, .sc button:focus-visible, .sc summary:focus-visible, .sc input:focus-visible {
    outline: 2px solid var(--sc-teal);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .sc-eyebrow { display: inline-flex; align-items: center; gap: 9px; margin: 0; color: var(--sc-teal); font-size: 13px; }
  .sc-lead { font-size: clamp(16.5px, 1.5vw, 19px); line-height: 1.95; color: #d9e6e2; max-inline-size: 62ch; margin-block: 0 22px; }
  .sc-badges { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .sc-badges li {
    font-size: 12.5px; color: #c5eee4; border: 1px solid var(--sc-teal-dim);
    border-radius: 4px; padding: 6px 12px; min-height: 32px; display: inline-flex; align-items: center; background: #061714;
  }

  /* Hero: editorial copy + instrument console */
  .sc-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.95fr);
    gap: clamp(22px, 4vw, 52px);
    align-items: start;
    padding-block: 12px 34px;
    border-block-end: 1px solid var(--sc-line);
    background:
      radial-gradient(70% 60% at 85% 0%, #2fe3c40f, transparent 62%),
      repeating-linear-gradient(90deg, transparent 0 79px, #2fe3c408 79px 80px);
  }
  .sc-console {
    border: 1px solid #1a4b43;
    border-radius: 16px;
    background: linear-gradient(170deg, #071b17, #04100e 70%);
    padding: 0 18px 16px;
    box-shadow: 0 24px 60px -40px #2fe3c455;
  }
  .sc-console-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    padding-block: 11px; border-block-end: 1px solid #113a33; font-size: 10.5px; color: #8fb4aa;
  }
  .sc-console-bar p { margin: 0; font-size: 11px; color: #a9cec4; letter-spacing: 0.02em; }
  .sc-console-bar span[aria-hidden]:last-child { font-family: ui-monospace, monospace; letter-spacing: 0.12em; color: var(--sc-teal); }
  .sc-console-dial { position: relative; padding-block: 12px 0; }
  .sc-console-dial svg { inline-size: 100%; block-size: auto; max-inline-size: 230px; display: block; margin-inline: auto; }
  .sc-dial-track { fill: none; stroke: #1b4a41; stroke-width: 10; stroke-linecap: round; }
  .sc-dial-ticks line { stroke: var(--sc-teal); stroke-width: 1.4; opacity: 0.75; }
  .sc-dial-number {
    position: absolute; inset-inline: 0; inset-block-start: 58%;
    margin: 0; text-align: center; font-size: 40px; font-weight: 700; color: #fff; line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .sc-dial-caption { margin: 4px 0 0; text-align: center; font-size: 11px; color: #8fb4aa; }
  .sc-readouts {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin: 14px 0 10px;
    background: #113a33; border: 1px solid #113a33; border-radius: 8px; overflow: hidden;
  }
  .sc-readouts div { background: #051512; padding: 9px 11px; display: grid; gap: 1px; }
  .sc-readouts dt { font-size: 10px; color: #85a8a0; }
  .sc-readouts dd { margin: 0; font-size: 14px; color: #e7faf6; font-variant-numeric: tabular-nums; }
  .sc-console-note { margin: 6px 0 0; font-size: 10px; line-height: 1.7; color: #77958d; }

  .sc-alert {
    margin-block: 22px 0; padding: 13px 16px; border-inline-start: 2px solid var(--sc-teal);
    background: #051512; color: #bfd2cd; font-size: 13px; line-height: 1.85;
  }

  .sc-tldr {
    margin-block: 30px 0; padding: clamp(18px, 3vw, 28px);
    border: 1px solid var(--sc-line); border-inline-start: 3px solid var(--sc-teal);
    border-radius: 4px 16px 16px 4px;
    background: linear-gradient(120deg, #2fe3c40d, transparent 55%), #04100e;
  }
  .sc-tldr h2 { font-size: clamp(20px, 2vw, 23px); margin-block-end: 12px; color: #fff; }
  .sc-tldr ol { margin: 0; padding: 0; list-style: none; counter-reset: tldr; display: grid; gap: 9px; }
  .sc-tldr li {
    counter-increment: tldr; position: relative; padding-inline-start: 36px;
    font-size: 14.5px; line-height: 1.9;
  }
  .sc-tldr li::before {
    content: counter(tldr, decimal-leading-zero); position: absolute; inset-inline-start: 0; inset-block-start: 5px;
    font-size: 10.5px; color: var(--sc-teal); border: 1px solid var(--sc-teal-dim); border-radius: 3px; padding: 1px 4px;
  }

  .sc-def {
    margin-block: 20px 0; display: grid; grid-template-columns: 108px minmax(0, 1fr); gap: 16px;
    align-items: start; padding-block: 16px; border-block: 1px solid var(--sc-line);
  }
  .sc-def h2 { font-size: 12px; color: var(--sc-teal); margin: 5px 0 0; letter-spacing: 0.03em; }
  .sc-def p { margin: 0; font-size: 16px; color: #e2efeb; max-inline-size: 78ch; }

  .sc-layout { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: clamp(24px, 4vw, 54px); align-items: start; margin-block-start: 28px; }
  .sc-toc { position: sticky; inset-block-start: 18px; padding-block: 14px; border-block-start: 1px solid var(--sc-line); }
  .sc-toc-label { margin: 0 0 10px; font-size: 11px; color: #7c9b93; letter-spacing: 0.04em; }
  .sc-toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
  .sc-toc a {
    display: flex; align-items: center; gap: 9px; min-height: 40px; padding: 6px 8px;
    border-radius: 6px; font-size: 12.5px; color: #b3c8c2; text-decoration: none;
    border: 1px solid transparent;
  }
  .sc-toc a:hover, .sc-toc a:focus-visible { background: #061714; border-color: #123a34; color: #fff; }
  .sc-toc a span { color: var(--sc-teal); font-size: 10px; font-variant-numeric: tabular-nums; }
  .sc-toc-note { margin: 12px 0 0; font-size: 10.5px; line-height: 1.8; color: #74938b; }

  .sc-content > section { padding-block: clamp(32px, 4.2vw, 50px); border-block-end: 1px solid #0f2f2a; scroll-margin-block-start: 24px; }
  .sc-content > section:first-child { padding-block-start: 8px; }
  .sc-content > section:last-child { border-block-end: 0; }
  .sc-sec-head { display: flex; align-items: flex-start; gap: 12px; margin-block-end: 14px; }
  .sc-sec-num {
    flex: 0 0 auto; margin-block-start: 7px; font-size: 10.5px; color: var(--sc-teal);
    border: 1px solid var(--sc-teal-dim); border-radius: 3px; padding: 2px 6px; font-variant-numeric: tabular-nums;
  }
  .sc-sec-head h2 { margin: 0; }
  .sc-answer {
    font-size: 16.5px; color: #e6f1ee; border-inline-start: 2px solid var(--sc-teal);
    padding-inline-start: 14px; margin-block: 0 16px; max-inline-size: 74ch;
  }
  .sc-content p { max-inline-size: 76ch; }
  .sc-fine { font-size: 11.5px; color: #8aa39d; line-height: 1.85; margin-block: 12px 0; }

  .sc-quote {
    margin: 18px 0; padding: 18px 20px; border: 1px solid #1a4b43; border-inline-start: 3px solid var(--sc-teal);
    border-radius: 4px 12px 12px 4px; background: #051512; max-inline-size: 78ch;
  }
  .sc-quote p { margin: 0 0 8px; font-size: 15.5px; color: #e8f6f2; }
  .sc-quote footer { font-size: 11px; color: #8fb0a8; }

  .sc-facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1px; margin: 18px 0 20px; background: var(--sc-line); border: 1px solid var(--sc-line); border-radius: 10px; overflow: hidden;
  }
  .sc-facts div { background: #051210; padding: 12px 14px; }
  .sc-facts dt { font-size: 10.5px; color: var(--sc-teal); margin-block-end: 3px; }
  .sc-facts dd { margin: 0; font-size: 13px; color: #d8e8e3; }

  .sc-list { margin: 14px 0 18px; padding-inline-start: 22px; display: grid; gap: 7px; }
  .sc-list li { font-size: 14.5px; }
  .sc-list b { color: #fff; }

  .sc-scroll-hint { display: none; margin: 0 0 6px; font-size: 11px; color: #85a49c; }
  .sc-tablewrap { margin-block: 18px; max-inline-size: 100%; overflow-x: auto; border: 1px solid var(--sc-line); border-radius: 10px; }
  .sc table { inline-size: 100%; min-inline-size: 640px; border-collapse: collapse; font-size: 13px; }
  .sc caption { text-align: start; padding: 11px 14px; font-size: 11px; color: #90aca4; border-block-end: 1px solid var(--sc-line); }
  .sc th, .sc td { text-align: start; vertical-align: top; padding: 11px 13px; border-block-end: 1px solid #0f2f2a; }
  .sc thead th { background: #061714; color: #c6ece2; font-size: 11.5px; }
  .sc tbody tr:hover { background: #051310; }
  .sc td b { color: #fff; }

  /* Evidence pack */
  .sc-pack { margin: 18px 0; border: 1px solid var(--sc-line); border-radius: 12px; background: #04100e; padding: 14px; }
  .sc-pack svg { inline-size: 100%; block-size: auto; max-inline-size: 560px; margin-inline: auto; display: block; }
  .sc-pack-lines path { stroke: #123a34; stroke-width: 1; stroke-dasharray: 3 5; }
  .sc-pack-row rect { fill: #061815; stroke: #1b4b42; stroke-width: 1; }
  .sc-pack-row--top rect { fill: #0a2a24; stroke: var(--sc-teal-dim); }
  .sc-pack-row text { fill: #dff3ee; font-size: 12px; }
  .sc-pack-row .sc-pack-small { fill: #8fb0a8; font-size: 10px; }
  .sc-pack figcaption { margin-block-start: 8px; text-align: center; font-size: 11px; color: #8aa39d; }

  /* Prep questions */
  .sc-prep { display: grid; gap: 7px; margin-block: 18px; }
  .sc-prep details { border: 1px solid var(--sc-line); border-radius: 8px; background: #051210; }
  .sc-prep summary {
    display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 8px 14px;
    cursor: pointer; font-size: 14px; color: #e4f2ee; list-style: none;
  }
  .sc-prep summary::-webkit-details-marker { display: none; }
  .sc-prep summary span {
    font-size: 10px; color: var(--sc-teal); border: 1px solid var(--sc-teal-dim);
    border-radius: 3px; padding: 1px 5px; font-variant-numeric: tabular-nums;
  }
  .sc-prep summary::after { content: "+"; margin-inline-start: auto; color: var(--sc-teal); font-size: 17px; }
  .sc-prep details[open] summary::after { content: "−"; }
  .sc-prep details[open] summary { border-block-end: 1px solid #0f2f2a; }
  .sc-prep details > div { padding: 10px 16px 14px; }
  .sc-prep p { margin: 0 0 7px; font-size: 13px; }
  .sc-prep p:last-child { margin-block-end: 0; }
  .sc-prep b { color: var(--sc-teal-soft); }

  /* Dashboard */
  .sc-dash {
    margin-block: 18px; padding: clamp(14px, 2.4vw, 24px);
    border: 1px solid #1a4b43; border-radius: 18px;
    background:
      radial-gradient(75% 55% at 15% 0%, #2fe3c410, transparent 60%),
      #04100e;
  }
  .sc-dash-top { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 18px; align-items: center; }
  .sc-ring-wrap { position: relative; }
  .sc-ring { inline-size: 100%; max-inline-size: 180px; display: block; margin-inline: auto; }
  .sc-ring-track { fill: none; stroke: #123a34; stroke-width: 10; }
  .sc-ring-value {
    fill: none; stroke: var(--sc-teal); stroke-width: 10; stroke-linecap: round;
    transform: rotate(-90deg); transform-origin: 70px 70px;
    transition: stroke-dashoffset 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
    filter: drop-shadow(0 0 5px #2fe3c466);
  }
  .sc-ring-label {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0; pointer-events: none;
  }
  .sc-ring-label span { font-size: 36px; font-weight: 700; color: #fff; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .sc-ring-label small { font-size: 10px; color: #93b3ab; }
  .sc-ring-label em { font-style: normal; font-size: 10px; color: var(--sc-teal); margin-block-start: 3px; }

  .sc-kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .sc-kpi { border: 1px solid #123a34; border-radius: 9px; background: #051512; padding: 10px 12px; }
  .sc-kpi p { margin: 0; font-size: 10.5px; color: #93b3ab; line-height: 1.5; }
  .sc-kpi strong { display: block; font-size: 26px; color: #fff; line-height: 1.3; font-variant-numeric: tabular-nums; }
  .sc-kpi small { font-size: 10px; color: #7d9a93; }
  .sc-kpi--wide { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; }
  .sc-kpi--wide p { flex: 1 0 100%; }
  .sc-kpi--wide strong { font-size: 20px; }
  .sc-kpi--wide small { padding-block-end: 2px; }
  .sc-meter { flex: 1 0 100%; margin-block-start: 4px; block-size: 4px; border-radius: 999px; background: #123a34; overflow: hidden; }
  .sc-meter span { display: block; block-size: 100%; inline-size: 0; background: var(--sc-teal); transition: inline-size 0.5s ease; }

  .sc-gauges { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-block: 12px; }
  .sc-gauge { border: 1px solid #123a34; border-radius: 9px; background: #051512; padding: 8px 10px 10px; text-align: center; }
  .sc-gauge svg { inline-size: 100%; max-inline-size: 130px; display: block; margin-inline: auto; }
  .sc-gauge-track { fill: none; stroke: #123a34; stroke-width: 7; stroke-linecap: round; }
  .sc-gauge-value { fill: none; stroke: #58d9c4; stroke-width: 7; stroke-linecap: round; transition: stroke-dashoffset 0.6s ease; }
  .sc-gauge p { margin: 0; display: flex; align-items: baseline; justify-content: center; gap: 6px; }
  .sc-gauge b { font-size: 17px; color: #fff; font-variant-numeric: tabular-nums; }
  .sc-gauge span { font-size: 10.5px; color: #a5c3bb; }
  .sc-gauge small { display: block; font-size: 9.5px; color: #78968e; }

  .sc-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-block-start: 12px; }
  .sc-form fieldset { margin: 0; padding: 11px 12px; border: 1px solid #123a34; border-radius: 9px; background: #051210; min-inline-size: 0; }
  .sc-form legend { padding: 0; font-size: 12px; line-height: 1.7; color: #d5e8e3; }
  .sc-form legend span { color: var(--sc-teal); font-size: 10px; margin-inline-end: 4px; }
  .sc-opts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; margin-block-start: 8px; }
  .sc-opts label {
    position: relative; display: flex; align-items: center; justify-content: center; min-height: 44px;
    padding: 5px 4px; border: 1px solid #16443c; border-radius: 6px; background: #061815;
    font-size: 10.5px; color: #a9c6be; cursor: pointer; text-align: center; line-height: 1.4;
  }
  .sc-opts input { position: absolute; opacity: 0; inline-size: 1px; block-size: 1px; }
  .sc-opts label:has(input:checked) { border-color: var(--sc-teal); background: #0a2c26; color: #eafffb; }
  .sc-opts label:has(input:focus-visible) { outline: 2px solid var(--sc-teal); outline-offset: 2px; }
  .sc-form-foot { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding-block-start: 4px; }
  .sc-summary { flex: 1 1 260px; margin: 0; font-size: 12.5px; line-height: 1.8; color: #d6ebe6; }
  .sc-btn {
    min-height: 44px; padding: 8px 16px; border: 1px solid #1f5c51; border-radius: 7px;
    background: transparent; color: var(--sc-teal-soft); font: inherit; font-size: 12px; cursor: pointer;
  }
  .sc-btn:hover { background: #082019; }

  .sc-gaps { margin-block-start: 14px; padding-block-start: 12px; border-block-start: 1px solid #123a34; }
  .sc-gaps h3 { font-size: 14px; color: #e9f7f3; margin-block-end: 6px; }
  .sc-gaps ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 5px; }
  .sc-gaps li { font-size: 12px; padding: 7px 11px; border: 1px solid #123a34; border-radius: 6px; background: #051210; }
  .sc-gaps li b { color: #ffd8a8; font-weight: 400; }
  .sc-fallback { margin-block-start: 9px; font-size: 12px; }
  .sc-fallback summary { cursor: pointer; min-height: 32px; display: flex; align-items: center; color: #a9c6be; }

  .sc-triage { margin: 16px 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 8px; }
  .sc-triage div { border: 1px solid var(--sc-line); border-radius: 9px; background: #051210; padding: 13px 14px; }
  .sc-triage dt { font-size: 14px; color: var(--sc-teal-soft); margin-block-end: 4px; }
  .sc-triage dd { margin: 0; font-size: 12.5px; }

  /* Paper report */
  .sc-paper {
    margin: 22px 0; padding: clamp(10px, 2vw, 18px);
    background: #0b1714; border: 1px solid #1a4b43; border-radius: 4px;
  }
  .sc-paper-inner {
    background: #f1f2ea; color: #18201d; border-radius: 2px; padding: clamp(16px, 3vw, 28px);
    box-shadow: 0 18px 40px -30px #000;
  }
  .sc-paper-inner p, .sc-paper-inner li, .sc-paper-inner span, .sc-paper-inner b { color: #18201d; }
  .sc-paper-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14px; border-block-end: 2px solid #18201d; padding-block-end: 12px; }
  .sc-paper-kicker { margin: 0; font-size: 9.5px; letter-spacing: 0.16em; color: #5c6b62 !important; }
  .sc-paper-title { margin: 3px 0 2px; font-size: clamp(17px, 2.1vw, 22px); font-weight: 700; }
  .sc-paper-sub { margin: 0; font-size: 10.5px; color: #5c6b62 !important; }
  .sc-paper-score { text-align: center; min-inline-size: 88px; }
  .sc-paper-score b { font-size: 38px; line-height: 1; font-variant-numeric: tabular-nums; }
  .sc-paper-score span { font-size: 12px; color: #5c6b62 !important; }
  .sc-paper-score small { display: block; font-size: 9px; color: #5c6b62 !important; }
  .sc-paper-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 20px; padding-block: 14px; }
  .sc-paper-label { margin: 0 0 6px; font-size: 9.5px; letter-spacing: 0.06em; color: #4c5a52 !important; }
  .sc-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 5px; }
  .sc-bars li { display: grid; grid-template-columns: minmax(0, 1fr) 72px 24px; align-items: center; gap: 7px; font-size: 10.5px; }
  .sc-bars span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sc-bars i { block-size: 6px; border-radius: 999px; background: linear-gradient(to left, #0f766a 0 var(--bar), #d8ddd3 var(--bar) 100%); }
  .sc-bars b { font-size: 10px; text-align: end; font-variant-numeric: tabular-nums; }
  .sc-paper-side ol { margin: 0 0 12px; padding-inline-start: 18px; font-size: 11px; display: grid; gap: 4px; }
  .sc-paper-action { margin: 0; font-size: 11px; line-height: 1.7; }
  .sc-paper-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; border-block-start: 1px solid #b9c3b8; padding-block-start: 9px; font-size: 9px; color: #5c6b62 !important; }
  .sc-paper figcaption { margin-block-start: 8px; font-size: 10.5px; color: #8aa39d; text-align: start; }

  .sc-mistakes { margin: 16px 0; display: grid; gap: 7px; }
  .sc-mistakes div { padding: 12px 14px; border: 1px solid var(--sc-line); border-inline-start: 2px solid #2a7a6c; border-radius: 7px; background: #051210; }
  .sc-mistakes dt { font-size: 13.5px; color: #f0dcd6; margin-block-end: 3px; }
  .sc-mistakes dt::before { content: "× "; color: #f08c7a; }
  .sc-mistakes dd { margin: 0; font-size: 12.5px; }
  .sc-mistakes dd b { color: var(--sc-teal-soft); }

  .sc-faq { display: grid; gap: 7px; }
  .sc-faq article { padding: 14px 16px; border: 1px solid var(--sc-line); border-radius: 8px; background: #051210; }
  .sc-faq h3 { font-size: 15px; color: #fff; margin-block-end: 5px; }
  .sc-faq p { margin: 0; font-size: 13px; max-inline-size: 82ch; }

  .sc-next { padding-block-start: 34px !important; }
  .sc-next h2 { font-size: clamp(21px, 2.3vw, 27px); }
  .sc-next-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 8px; }
  .sc-next-grid a {
    display: grid; gap: 4px; padding: 14px; border: 1px solid var(--sc-line); border-radius: 9px;
    background: #051210; text-decoration: none; transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .sc-next-grid a:hover { border-color: #2a7a6c; transform: translateY(-2px); }
  .sc-next-grid span { font-size: 10px; color: var(--sc-teal); }
  .sc-next-grid b { color: #fff; font-size: 14px; line-height: 1.6; }
  .sc-next-grid small { color: #93ada6; font-size: 11.5px; line-height: 1.7; }
  .sc-site-link { margin-block: 12px 0; font-size: 12.5px; color: #a3bab4; }

  .sc-refs { margin-block: 30px 0; padding-block-start: 20px; border-block-start: 1px solid var(--sc-line); }
  .sc-refs h2 { font-size: 19px; }
  .sc-refs ul { margin: 0; padding-inline-start: 18px; display: grid; gap: 8px; font-size: 12.5px; }
  .sc-cta {
    margin-block: 26px 0; padding: 16px 18px; border: 1px solid #1a4b43; border-radius: 9px;
    background: #04100e; font-size: 13.5px; max-inline-size: none;
  }

  /* Reveal: only when JS is on; content stays visible without it */
  .sc-js .sc-reveal { opacity: 0; transform: translateY(14px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .sc-js .sc-reveal.is-in { opacity: 1; transform: none; }

  @media (max-width: 1040px) {
    .sc-hero { grid-template-columns: minmax(0, 1fr); }
    .sc-console { max-inline-size: 460px; }
    .sc-layout { grid-template-columns: minmax(0, 1fr); }
    .sc-toc { position: static; padding-block: 0 10px; border-block-start: 0; border-block-end: 1px solid var(--sc-line); }
    .sc-toc ol { display: flex; gap: 5px; overflow-x: auto; padding-block-end: 6px; scrollbar-width: thin; }
    .sc-toc a { white-space: nowrap; border: 1px solid var(--sc-line); min-height: 44px; }
    .sc-toc-note { display: none; }
  }
  @media (max-width: 820px) {
    .sc-dash-top { grid-template-columns: minmax(0, 1fr); }
    .sc-ring { max-inline-size: 150px; }
    .sc-form { grid-template-columns: minmax(0, 1fr); }
    .sc-paper-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .sc h1 { max-inline-size: none; }
    .sc-def { grid-template-columns: minmax(0, 1fr); gap: 5px; }
    .sc-scroll-hint { display: block; }
    .sc-gauges { gap: 5px; }
    .sc-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sc-opts { grid-template-columns: minmax(0, 1fr); }
    .sc-opts label { justify-content: flex-start; padding-inline: 10px; }
    .sc-paper-head { flex-direction: column; }
    .sc-paper-score { text-align: start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-js .sc-reveal { opacity: 1; transform: none; transition: none; }
    .sc-ring-value, .sc-gauge-value, .sc-meter span, .sc-next-grid a { transition: none; }
    .sc-next-grid a:hover { transform: none; }
  }

  @media print {
    .sc-toc, .sc-form, .sc-btn, .sc-gauges, .sc-cta, .sc-next, .sc-dash-top .sc-ring-wrap, .sc-console { display: none; }
    .sc, .sc * { color: #000 !important; background: #fff !important; box-shadow: none !important; }
    .sc-hero, .sc-def, .sc-layout, .sc-dash-top, .sc-paper-grid { grid-template-columns: minmax(0, 1fr) !important; display: block; }
    .sc-content > section { break-inside: avoid; }
    .sc-paper, .sc-paper-inner { border: 1px solid #000; }
    .sc-bars i { background: #000 !important; }
    .sc a { text-decoration: underline; }
    .sc details { page-break-inside: avoid; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-sc]');
  if (root) {
    root.classList.add('sc-js');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const reveal = root.querySelectorAll<HTMLElement>('.sc-reveal');

    const showAll = () => reveal.forEach((item) => item.classList.add('is-in'));
    if (reduced.matches || !('IntersectionObserver' in window)) {
      showAll();
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
      );
      reveal.forEach((item) => observer.observe(item));
      // Safety net: never leave content hidden if an intersection callback is missed
      // (for example after an instant anchor jump or a very fast scroll).
      window.setTimeout(showAll, 1400);
    }
    reduced.addEventListener('change', () => {
      if (reduced.matches) showAll();
    });

    const dash = root.querySelector<HTMLElement>('[data-dashboard]');
    if (dash) {
      const form = dash.querySelector<HTMLFormElement>('[data-readiness]');
      const fields = Array.from(dash.querySelectorAll<HTMLFieldSetElement>('[data-q]'));
      const ring = dash.querySelector<SVGCircleElement>('[data-ring]');
      const ringValue = dash.querySelector<HTMLElement>('[data-ring-value]');
      const summary = dash.querySelector<HTMLElement>('[data-summary]');
      const gapList = dash.querySelector<HTMLElement>('[data-gap-list]');
      const answeredBar = dash.querySelector<HTMLElement>('[data-answered-bar]');
      const reset = dash.querySelector<HTMLButtonElement>('[data-reset]');
      const counters: Record<string, HTMLElement | null> = {
        solid: dash.querySelector('[data-kpi="solid"]'),
        partial: dash.querySelector('[data-kpi="partial"]'),
        critical: dash.querySelector('[data-kpi="critical"]'),
        answered: dash.querySelector('[data-kpi="answered"]'),
      };
      const domains = ['inventory', 'owners', 'evidence'] as const;
      const domainMax: Record<string, number> = { inventory: 6, owners: 6, evidence: 8 };

      const frames = new WeakMap<HTMLElement, number>();
      const animate = (el: HTMLElement | null, target: number) => {
        if (!el) return;
        const running = frames.get(el);
        if (running) cancelAnimationFrame(running);
        const from = Number(el.textContent) || 0;
        if (reduced.matches || from === target) {
          el.textContent = String(target);
          frames.delete(el);
          return;
        }
        const start = performance.now();
        const duration = 600;
        const tick = (now: number) => {
          const progress = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.round(from + (target - from) * eased));
          if (progress < 1) frames.set(el, requestAnimationFrame(tick));
          else frames.delete(el);
        };
        frames.set(el, requestAnimationFrame(tick));
      };

      const update = () => {
        let total = 0;
        let answered = 0;
        const counts = { solid: 0, partial: 0, critical: 0 };
        const domainScores: Record<string, number> = { inventory: 0, owners: 0, evidence: 0 };
        const gaps: { label: string; score: number }[] = [];

        fields.forEach((field) => {
          const checked = field.querySelector<HTMLInputElement>('input:checked');
          if (!checked) return;
          const score = Number(checked.dataset.score ?? 0);
          const domain = field.dataset.domain ?? 'inventory';
          answered += 1;
          total += score;
          domainScores[domain] = (domainScores[domain] ?? 0) + score;
          if (score === 2) counts.solid += 1;
          else if (score === 1) counts.partial += 1;
          else counts.critical += 1;
          if (score < 2) gaps.push({ label: field.dataset.short ?? 'بند', score });
        });

        const pct = Math.round((total / 20) * 100);
        animate(counters.solid, counts.solid);
        animate(counters.partial, counts.partial);
        animate(counters.critical, counts.critical);
        animate(counters.answered, answered);
        animate(ringValue, pct);
        if (ring) ring.style.strokeDashoffset = String(100 - pct);
        if (answeredBar) answeredBar.style.inlineSize = `${answered * 10}%`;

        domains.forEach((domain) => {
          const gauge = dash.querySelector<HTMLElement>(`[data-gauge="${domain}"]`);
          const score = domainScores[domain] ?? 0;
          const domainPct = Math.round((score / domainMax[domain]) * 100);
          const arc = gauge?.querySelector<SVGPathElement>('.sc-gauge-value');
          const value = gauge?.querySelector<HTMLElement>('[data-gauge-value]');
          if (arc) arc.style.strokeDashoffset = String(100 - domainPct);
          if (value) value.textContent = `${domainPct}%`;
          const cellScore = dash.querySelector<HTMLElement>(`[data-table-score="${domain}"]`);
          const cellPct = dash.querySelector<HTMLElement>(`[data-table-pct="${domain}"]`);
          if (cellScore) cellScore.textContent = `${score} من ${domainMax[domain]}`;
          if (cellPct) cellPct.textContent = `${domainPct}%`;
        });

        if (summary) {
          if (answered < fields.length) {
            summary.textContent = `أجبت على ${answered} من ${fields.length}. أكمل الباقي لتحصل على قراءة أوضح للفجوات.`;
          } else if (pct >= 80) {
            summary.textContent = `جاهزية ${pct} من 100. أساسك جيد؛ راجع الفجوات الجزئية قبل الاعتماد على النتيجة، وتأكد أن كل «نعم» لها دليل يمكن فتحه.`;
          } else if (pct >= 45) {
            summary.textContent = `جاهزية ${pct} من 100. عندك أساس يحتاج إكمالاً؛ ابدأ بأكبر فجوة حرجة قبل الدخول على الأداة حتى لا تجيب على مستوى النية.`;
          } else {
            summary.textContent = `جاهزية ${pct} من 100. الأفضل تأجيل الدخول حتى تجهّز الجرد والمالكين، لأن الإجابات الحالية غالباً ستكون تقديرية.`;
          }
        }

        if (gapList) {
          const pending = fields.length - answered;
          const items: string[] = [];
          gaps
            .slice()
            .sort((a, b) => a.score - b.score)
            .slice(0, 4)
            .forEach((gap) => {
              items.push(`<li><b>${gap.score === 0 ? 'غير موجود:' : 'جزئي:'}</b> ${gap.label}</li>`);
            });
          if (pending > 0) items.push(`<li>باقي <b>${pending}</b> ${pending === 1 ? 'سؤال' : 'أسئلة'} بلا إجابة.</li>`);
          if (!items.length) items.push('<li>كل البنود موثقة في هذا الفحص. راجعها دورياً ولا تفترض الثبات.</li>');
          gapList.innerHTML = items.join('');
        }
      };

      form?.addEventListener('change', update);
      form?.addEventListener('submit', (event) => event.preventDefault());
      reset?.addEventListener('click', () => {
        form?.reset();
        update();
        fields[0]?.querySelector<HTMLInputElement>('input')?.focus();
      });
      update();
    }
  }
</script>
