---
import PageShell from '../../components/PageShell.astro';
import { brand } from '../../data/brand';
export const prerender = true;
const description = 'دليل عملي للتحضير لأداة التقييم الذاتي لأخلاقيات الذكاء الاصطناعي من سدايا: ما تجمعه، وكيف تقرأ النتيجة، وكيف تعالج الفجوات دون نسخ أسئلة الأداة.';
const path = Astro.url.pathname;
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'أداة التقييم الذاتي لأخلاقيات الذكاء الاصطناعي من سدايا: كيف تستعد قبل استخدامها؟',
  description,
  inLanguage: 'ar-SA',
  datePublished: '2026-11-03',
  dateModified: '2026-11-03',
  mainEntityOfPage: new URL(path, 'https://brightai.live').href,
  author: { '@type': 'Organization', name: 'BRIGHTAI', url: 'https://brightai.live/about/' },
  publisher: {
    '@type': 'Organization',
    name: 'BRIGHTAI',
    url: 'https://brightai.live/',
    logo: { '@type': 'ImageObject', url: new URL(brand.logo, 'https://brightai.live').href },
  },
  about: [
    { '@type': 'Thing', name: 'تقييم أخلاقيات الذكاء الاصطناعي سدايا' },
    { '@type': 'Thing', name: 'أداة التقييم الذاتي' },
    { '@type': 'Thing', name: 'منصة حوكمة البيانات الوطنية' },
    { '@type': 'Thing', name: 'قياس الالتزام بالمبادئ الأخلاقية' },
    { '@type': 'Thing', name: 'جاهزية الذكاء الاصطناعي' },
  ],
};
const faqItems = [
  {
    q: 'هل التقييم إلزامي؟',
    a: 'الأداة تقييم ذاتي، ووصفتها سدايا بأنها وسيلة لمساعدة الجهات على قياس التزامها بالمعايير الأخلاقية، ولم ترد في صفحتها الرسمية صيغة تفرضها كالتزام مستقل. الالتزامات الملزمة تأتي من الأنظمة واللوائح السارية على نشاطك ومن متطلبات المنظم القطاعي. تحقق مع مختصك النظامي قبل أن تعتمد على أي استنتاج في هذا الشأن.',
  },
  {
    q: 'من يمكنه استخدام الأداة؟',
    a: 'بحسب إعلان الإطلاق الرسمي، الأداة متاحة للجهات الحكومية والخاصة وكذلك المطورين الأفراد، بهدف قياس مدى التزامهم بالمبادئ الأخلاقية عند تطوير وتطبيق تقنيات الذكاء الاصطناعي. وتصف صفحة الخدمة الرسمية الأداة بأنها تساعد جهات التحكم على إجراء تحليل شامل ومنهجي. الدخول يكون عبر منصة حوكمة البيانات الوطنية، وقد يتطلب حساباً على المنصة.',
  },
  {
    q: 'كم يستغرق التحضير؟',
    a: 'لا توجد مدة تحضير معلنة في المصدر الرسمي، والمدة تعتمد على عدد حالات الاستخدام وجودة وثائقك. عملياً، منشأة عندها سجل استخدامات محدث ومالكون معروفون تستطيع تجهيز ملفها في جلسة أو جلستين، ومنشأة تبدأ من الصفر تحتاج أسابيع لجمع الحد الأدنى. الأفضل تقسيم العمل إلى ثلاث جلسات: الجرد، ثم المالكين والأدلة، ثم مراجعة الإجابات.',
  },
  {
    q: 'هل النتيجة تعني اعتماداً رسمياً؟',
    a: 'لا. الأداة تصدر نتيجة وتقريراً يوضح مستوى الالتزام أو النضج الأخلاقي في كل مبدأ، وهي أداة تقييم ذاتي وليست شهادة أو اعتماداً تنظيمياً. لا تنسب لمنشأتك اعتماداً بسبب نتيجة التقييم، ولا تستخدم النتيجة في عرض تسويقي يوحي بأن سدايا وثّقت التزامك. النتيجة نقطة بداية للمعالجة، والدليل هو ما يثبت الالتزام لاحقاً.',
  },
  {
    q: 'كيف أحسّن نتيجتي؟',
    a: 'لا تحسّن النتيجة بالإجابة المتفائلة، بل بمعالجة الفجوة وإثبات المعالجة. ابدأ بأكبر فجوة في مبدأ يؤثر في حقوق الناس أو بياناتهم، وسمِّ مالكاً واحداً، واكتب الدليل المتوقع، وحدد موعداً لإعادة التقييم. الأداة نفسها مصممة لتُستخدم أكثر من مرة لتتبع التقدم، فالتحسن الحقيقي يظهر في تكرار القياس بعد تنفيذ إجراءات موثقة.',
  },
];
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<PageShell
  title="تقييم أخلاقيات الذكاء الاصطناعي سدايا: الاستعداد"
  description={description}
  crumbs={[{ name: 'مركز المعرفة', href: '/docs/' }, { name: 'التقييم الذاتي لأخلاقيات الذكاء الاصطناعي' }]}
  ogType="article"
  structuredData={article}
>
  <div class="sc" id="top" data-sc>
    <header class="sc-hero">
      <div class="sc-hero-copy">
        <p class="sc-eyebrow"><span aria-hidden="true">▣</span> المخاطر · لوحة جاهزية</p>
        <h1>أداة التقييم الذاتي لأخلاقيات الذكاء الاصطناعي من سدايا: كيف تستعد قبل استخدامها؟</h1>
        <p class="sc-lead">تقييم أخلاقيات الذكاء الاصطناعي سدايا ما يعطيك صورة عن منشأتك من الفراغ؛ يعطيك صورة عن اللي أنت قادر تثبته. عشان كذا التحضير مو حفظ إجابات، هو ترتيب ملفك: وش تستخدم، ومين يملكه، ووش الدليل اللي تقدر تفتحه لو أحد سألك. هذا الدليل يمشّيك قبل الدخول على الأداة.</p>
        <ul class="sc-badges" aria-label="بيانات الدليل">
          <li>المخاطر</li>
          <li>81 سؤالاً · 7 مبادئ</li>
          <li>قراءة 18 دقيقة</li>
          <li>آخر مراجعة: 3 نوفمبر 2026</li>
        </ul>
      </div>
      <aside class="sc-console" aria-labelledby="console-title">
        <div class="sc-console-bar">
          <span aria-hidden="true">● ● ●</span>
          <p id="console-title">نطاق الأداة الرسمي</p>
          <span aria-hidden="true">SDAIA</span>
        </div>
