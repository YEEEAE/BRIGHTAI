  .pd-tree-block { margin-block-start: 26px; padding: clamp(16px, 3vw, 24px); border: 1px solid #392c58; background: linear-gradient(160deg, #1b1132, #09060f 70%); }
  .pd-tree-block h3 { color: #f2edff; max-inline-size: 34ch; }
  .pd-tree-block > p { font-size: 13.5px; color: #b8aecb; margin-block: 0 12px; }
  .pd-tree { border: 1px solid #332650; background: #0a0613; }
  .pd-tree-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 9px 12px; border-block-end: 1px solid #241b3a; }
  .pd-tree-progress { margin: 0; font-family: var(--font-monospace); font-size: 11px; color: var(--pd-violet); }
  .pd-tree-reset { background: transparent; border: 0; color: #a99dc4; font: inherit; font-size: 11.5px; text-decoration: underline; cursor: pointer; padding: 6px; min-height: 32px; }
  .pd-tree-reset:hover { color: #fff; }
  .pd-tree [data-tree-stage] { padding: 16px 14px 6px; }
  .pd-tree-q { margin: 0 0 6px; font-size: 16.5px; color: #f0ebfb; line-height: 1.7; }
  .pd-tree-hint { margin: 0; font-size: 12.5px; color: #9c90b5; }
  .pd-tree-actions { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 14px 16px; }
  .pd-tree-actions button { min-height: 44px; min-inline-size: 84px; padding: 8px 18px; font: inherit; font-size: 14px; color: #f4efff; background: #2a1a4d; border: 1px solid #5b3fa0; cursor: pointer; }
  .pd-tree-actions button:hover { background: #38226a; border-color: var(--pd-violet); }
  .pd-tree-actions button[data-tree-answer="no"] { background: transparent; color: #c7bddd; border-color: #3a2f58; }
  .pd-tree-actions button[data-tree-answer="no"]:hover { background: #1b1330; }
  .pd-tree-back { margin-inline-start: auto; background: transparent !important; border-color: transparent !important; color: #9d91b8 !important; text-decoration: underline; }
  .pd-tree-result { padding: 16px 14px; border-block-start: 1px solid #2a2143; }
  .pd-tree-result[data-verdict="in"] { background: #150e26; box-shadow: inset 3px 0 0 var(--pd-violet); }
  .pd-tree-result[data-verdict="out"] { background: #141018; box-shadow: inset 3px 0 0 #6c6089; }
  .pd-tree-result p { margin: 0 0 8px; font-size: 14px; }
  .pd-tree-verdict { color: #f4efff; font-weight: 700; font-size: 16px !important; }
  .pd-tree-result b { color: #d9c9ff; }
  .pd-tree-note { font-size: 11.5px !important; color: #8d81aa !important; margin-block-end: 0 !important; }
  .pd-tree-fallback { margin-block-start: 10px; border: 1px solid #2a2143; background: #0a0613; padding: 10px 12px; }
  .pd-tree-fallback summary { cursor: pointer; font-size: 12.5px; color: #b9aed2; min-height: 30px; }
  .pd-tree-fallback ol { margin: 8px 0; padding-inline-start: 20px; display: grid; gap: 4px; }
  .pd-tree-fallback li, .pd-tree-fallback p { font-size: 12.5px; margin: 0; }

  .pd-mistakes { display: grid; gap: 1px; background: #241c39; border: 1px solid #241c39; margin-block: 14px; }  .pd-mistakes > div { background: #0b0715; padding: 12px 14px; }
  .pd-mistakes dt { color: #f2edff; font-weight: 700; font-size: 14.5px; margin-block-end: 4px; }
  .pd-mistakes dd { margin: 0; font-size: 13.5px; }
  .pd-mistakes b { color: #c9b8ff; }

  .pd-example { border: 1px solid #392c58; background: linear-gradient(150deg, #1a1030, #0a0612 65%); padding: clamp(16px, 3vw, 24px); margin-block: 18px; }
  .pd-example-label { display: inline-block; font-size: 10.5px; color: var(--pd-amber); border: 1px solid #5d4824; padding: 3px 9px; margin: 0 0 10px; }
  .pd-example > p { font-size: 14.5px; }
  .pd-steps { margin: 10px 0; padding-inline-start: 20px; display: grid; gap: 8px; }
  .pd-steps li { font-size: 14px; }
  .pd-steps b { color: #e9e1ff; }

  .pd-faq { display: grid; gap: 1px; background: #241c39; border: 1px solid #241c39; }
  .pd-faq article { background: #0b0715; padding: 14px 16px; }
  .pd-faq h3 { color: #f0eaff; font-size: 16px; }
  .pd-faq p { margin: 0; font-size: 14.5px; }

  .pd-next { padding-block: 28px; border-block-end: 1px solid #1d1730; }
  .pd-next-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); gap: 1px; background: #2a2143; border: 1px solid #2a2143; }
  .pd-next-grid a { display: grid; gap: 5px; padding: 14px; background: #0b0715; text-decoration: none; min-height: 108px; align-content: start; }
  .pd-next-grid a:hover { background: #140d23; }
  .pd-next-grid span { font-size: 10.5px; color: var(--pd-violet); }
  .pd-next-grid b { color: #f0eaff; font-size: 14px; line-height: 1.6; }
  .pd-next-grid small { color: #a79cbd; font-size: 12px; line-height: 1.7; }
  .pd-site-link { margin-block: 14px 0; font-size: 13px; }

  .pd-refs { padding-block: 26px 10px; }
  .pd-refs ul { padding-inline-start: 18px; display: grid; gap: 8px; }
  .pd-refs li { font-size: 13px; }
  .pd-fine { font-size: 11.5px; color: #8c81a6; border-block-start: 1px solid #1d1730; padding-block-start: 12px; margin-block-start: 16px; }

  .pd-cta { margin-block: 24px 0; padding: 14px 16px; border: 1px solid #2f2549; background: #0b0715; font-size: 14px; }

  /* Motion: only when JS marks the document; content stays visible otherwise */
  .js .pd-reveal { opacity: 0; transform: translateY(14px); transition: opacity 0.55s ease, transform 0.55s ease; }
  .js .pd-reveal.is-in { opacity: 1; transform: none; }
  .js .pd-hero-main h1 { animation: pd-rise 0.6s ease both; }
  .js .pd-pass { animation: pd-rise 0.7s 0.08s ease both; }
  @keyframes pd-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  @media (max-width: 1000px) {
    .pd-layout { grid-template-columns: 1fr; }
    .pd-toc { position: static; border: 1px solid var(--pd-line); padding: 12px 14px; }
    .pd-toc ol { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0 14px; }
    .pd-hero { grid-template-columns: 1fr; }
    .pd-pass { max-inline-size: 420px; }
  }
  @media (max-width: 560px) {
    .pd-def { grid-template-columns: 1fr; gap: 6px; }
    .pd-sec-head { gap: 9px; }
    .pd-answer { font-size: 16px; }
    .pd-journey-scroll { padding-inline: 4px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .pd-reveal, .js .pd-hero-main h1, .js .pd-pass { opacity: 1 !important; transform: none !important; animation: none !important; transition: none !important; }
    .pd-card-chev { transition: none; }
  }
  @media print {
    .pd-toc, .pd-pass, .pd-cta, .pd-next { display: none; }
    .pd, .pd p, .pd li, .pd td, .pd th, .pd dd { color: #000; }
    .pd-sec, .pd-card, .pd-faq article, .pd-example { break-inside: avoid; }
    .pd a { color: #000; text-decoration: underline; }
    .pd-card { border: 1px solid #999; }
  }
</style>

<script>
  // Journey inspector: node click opens the matching checkpoint card.
  document.querySelectorAll<HTMLElement>('[data-journey]').forEach((root) => {
    const nodes = [...root.querySelectorAll<SVGGElement>('.pd-node')];
    const cards = [...root.querySelectorAll<HTMLDetailsElement>('[data-card]')];
    const select = (index: number, scroll = false) => {
      nodes.forEach((node, i) => node.setAttribute('data-active', String(i === index)));
      cards.forEach((card, i) => {
        card.dataset.active = String(i === index);
        if (i === index) card.open = true;
      });
      if (scroll) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        cards[index]?.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
      }
    };
    nodes.forEach((node, index) => {
      node.addEventListener('click', () => select(index, true));
      node.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          select(index, true);
        }
        if (event.key === 'ArrowLeft') { event.preventDefault(); nodes[Math.min(index + 1, nodes.length - 1)]?.focus(); }
        if (event.key === 'ArrowRight') { event.preventDefault(); nodes[Math.max(index - 1, 0)]?.focus(); }
      });
    });
    select(0);

    // Respect reduced motion for the SVG motion path.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const svg = root.querySelector('svg');
      try { (svg as SVGSVGElement & { pauseAnimations?: () => void })?.pauseAnimations?.(); } catch { /* noop */ }
      const dot = root.querySelector<SVGCircleElement>('.pd-route-dot');
      if (dot) { dot.setAttribute('cx', '918'); dot.setAttribute('cy', '118'); }
    }
  });

  // Decision tree: four questions, no data leaves the browser.
  document.querySelectorAll<HTMLElement>('[data-tree]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-tree-stage]');
    const result = root.querySelector<HTMLElement>('[data-tree-result]');
    const progress = root.querySelector<HTMLElement>('[data-tree-progress]');
    const actions = root.querySelector<HTMLElement>('[data-tree-actions]');
    const back = root.querySelector<HTMLButtonElement>('[data-tree-back]');
    const reset = root.querySelector<HTMLButtonElement>('[data-tree-reset]');
    if (!stage || !result || !progress) return;

    type Step = { q: string; hint: string };
    const steps: Step[] = [
      { q: 'هل تتعامل مع بيانات شخصية بالمعنى النظامي؟', hint: 'اسم، بريد، رقم، صورة، معرّف، أو أي بيان يمكن ربطه بفرد.' },
      { q: 'هل المعالجة لأغراض شخصية أو عائلية بحتة، دون نشر أو إفصاح خارج الأسرة؟', hint: 'الاستخدام المهني أو التجاري لا يدخل في هذا الاستثناء.' },
      { q: 'هل منشأتك (أو أنت) تحدد الغرض وطريقة المعالجة؟', hint: 'إذا كنت تعالج لحساب غيرك ونيابة عنه، فأنت جهة معالجة.' },
      { q: 'هل المعالجة تتم داخل المملكة، أو تتعلق بأفراد مقيمين فيها ولو نُفذت من خارجها؟', hint: 'وجود الأداة أو الخادم خارج المملكة لا يخرج المعالجة من النطاق.' },
    ];
    let index = 0;
    let role = '';

    const show = () => {
      progress.textContent = `سؤال ${index + 1} من ${steps.length}`;
      const step = steps[index];
      stage.innerHTML = `<p class="pd-tree-q">${step.q}</p><p class="pd-tree-hint">${step.hint}</p>`;
      stage.hidden = false;
      result.hidden = true;
      if (actions) actions.hidden = false;
      back!.hidden = index === 0;
    };

    const finish = (verdict: string, detail: string, ok: boolean) => {
      stage.hidden = true;
      if (actions) actions.hidden = true;
      result.hidden = false;
      result.tabIndex = -1;
      result.dataset.verdict = ok ? 'in' : 'out';
      result.innerHTML = `<p class="pd-tree-verdict">${verdict}</p><p>${detail}</p><p class="pd-tree-note">هذا فرز تعليمي مبني على أسئلة النطاق العامة، وليس حكماً على حالتك. راجع النص الرسمي والمختص.</p>`;
      progress.textContent = 'انتهى الفرز';
      back!.hidden = true;
      result.focus({ preventScroll: true });
    };

    const answer = (value: 'yes' | 'no') => {
      if (index === 0 && value === 'no') {
        return finish('غالباً خارج نطاق البيانات الشخصية', 'إذا كانت البيانات لا تخص فرداً يمكن التعرف عليه أصلاً، فقد لا تدخل في تعريف البيانات الشخصية. لكن تحقق: إزالة الاسم وحدها لا تكفي، والبيانات المرمزة تبقى شخصية. إذا كنت تعتمد على إخفاء الهوية، وثّق اختبار إعادة التعريف.', false);
      }
      if (index === 1 && value === 'yes') {
        return finish('غالباً خارج نطاق النظام', 'النظام يستثني معالجة الفرد لبياناته لأغراض لا تتجاوز الاستخدام الشخصي أو العائلي، بشرط عدم النشر أو الإفصاح للغير. أي استخدام مهني أو تجاري أو غير ربحي لا يدخل في الاستثناء.', false);
      }
      if (index === 2) role = value === 'yes' ? 'جهة تحكم' : 'جهة معالجة';
      if (index === 3) {
        if (value === 'yes') {
          return finish('المعالجة داخلة في نطاق PDPL', `موقعك الغالب: <b>${role}</b>. الخطوة التالية: صنّف البيانات، حدد الأساس والغرض، ثم افحص الحساب والعقد وموقع المعالجة ومسار الحقوق.`, true);
        }
        return finish('النطاق غير محسوم', 'إذا كانت المعالجة لا تتم في المملكة ولا تخص أفراداً مقيمين فيها، فقد لا ينطبق النظام من هذه الجهة. لكن البيانات قد تكون لمواطنين أو مقيمين، أو تصل إلى جهة داخل المملكة لاحقاً. راجع الوقائع قبل الجزم.', false);
      }
      index += 1;
      show();
    };

    root.querySelectorAll<HTMLButtonElement>('[data-tree-answer]').forEach((button) => {
      button.addEventListener('click', () => answer(button.dataset.treeAnswer === 'yes' ? 'yes' : 'no'));
    });
    back?.addEventListener('click', () => { if (index > 0) { index -= 1; show(); } });
    reset?.addEventListener('click', () => { index = 0; role = ''; show(); });
    show();
  });

  // Reveal-on-scroll, disabled entirely for reduced motion.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const targets = document.querySelectorAll<HTMLElement>('.pd-sec, .pd-next, .pd-refs');
    targets.forEach((el) => el.classList.add('pd-reveal'));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    targets.forEach((el) => io.observe(el));
  }
</script>
