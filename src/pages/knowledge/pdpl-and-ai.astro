  /* Journey */
  .pd-journey { margin-block: 16px 10px; border: 1px solid #392c58; background: linear-gradient(180deg, #120c22, #08050f); }
  .pd-journey-scroll { overflow-x: auto; padding: 8px 10px 0; }
  .pd-route { inline-size: 100%; min-inline-size: 700px; block-size: auto; display: block; }
  .pd-route-line { stroke: url(#pd-line-grad); stroke-width: 2.5; fill: none; }
  .pd-route-dash { stroke: #a78bfa55; stroke-width: 1.5; stroke-dasharray: 3 10; fill: none; }
  .pd-route-ends text { fill: #6c6089; font-size: 12px; font-family: var(--font-arabic); }
  .pd-node { cursor: pointer; }
  .pd-node-halo { fill: #a78bfa12; stroke: none; transition: fill 0.25s; }
  .pd-node-disc { fill: #150e26; stroke: #7c5bd6; stroke-width: 1.5; transition: stroke 0.25s, fill 0.25s; }
  .pd-node-no { fill: #cfc3ef; font-family: var(--font-monospace); font-size: 13px; }
  .pd-node-label { fill: #b8aed0; font-family: var(--font-arabic); font-size: 15px; }
  .pd-node:hover .pd-node-halo, .pd-node[data-active="true"] .pd-node-halo { fill: #a78bfa2e; }
  .pd-node:hover .pd-node-disc, .pd-node[data-active="true"] .pd-node-disc { stroke: var(--pd-amber); fill: #221539; }
  .pd-route-dot { pointer-events: none; }
  .pd-figure-note { margin: 8px 12px 12px; font-size: 11px; color: #7f7396; }

  .pd-cards { display: grid; gap: 1px; background: #2a2143; border-block-start: 1px solid #2a2143; }
