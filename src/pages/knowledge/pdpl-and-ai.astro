  .pd-scroll-hint { font-size: 11.5px; color: #867aa2; margin-block: 8px; }
  .pd-tablewrap { overflow-x: auto; border: 1px solid var(--pd-line); margin-block: 12px 14px; }
  .pd-tablewrap table { inline-size: 100%; min-inline-size: 660px; border-collapse: collapse; font-size: 13.5px; }
  .pd-tablewrap caption { text-align: start; padding: 10px 12px; font-size: 12px; color: #a79cbd; background: #0d0918; }
  .pd-tablewrap th, .pd-tablewrap td { padding: 10px 11px; text-align: start; border-block-end: 1px solid #221a36; vertical-align: top; }
