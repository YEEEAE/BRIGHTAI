---
import { articleStructuredData } from '../../data/structured-data';
import GuideSources from '../../components/GuideSources.astro';
import PageShell from '../../components/PageShell.astro';
export const prerender = true;
const description = 'دليل عملي يشرح متى ينطبق نظام حماية البيانات الشخصية على إدخال البيانات في أدوات الذكاء الاصطناعي، وموقعك من المتحكم والمعالج، والأسئلة الست قبل أي إدخال.';
const path = Astro.url.pathname;
const article = {
  ...articleStructuredData('نظام حماية البيانات الشخصية (PDPL) والذكاء الاصطناعي: متى يصبح إدخال البيانات في أداة معالجة خاضعة للنظام؟', description, Astro.url.pathname),
  about: [
    { '@type': 'Thing', name: 'نظام حماية البيانات الشخصية' },
    { '@type': 'Thing', name: 'PDPL الذكاء الاصطناعي' },
    { '@type': 'Thing', name: 'المتحكم والمعالج' },
    { '@type': 'Thing', name: 'نقل البيانات خارج المملكة' },
  ],
};
const faqs = [{"question": "هل أستطيع إدخال بيانات عميل في أداة AI؟", "answer": "لا تحسم ذلك من اسم الأداة أو الحساب. وثّق نوع البيانات والغرض والدور والمسوغ والعقد والنقل والاحتفاظ، واعرض ما لم يُحسم على الخصوصية قبل الإدخال. هذا مسار مراجعة، وليس إذنًا عامًا بالمعالجة.", "source": "law", "locator": "النظام، المواد 1 و2 و5 و6 و8 و29"}, {"question": "هل حذف الأسماء يجعل البيانات خارج النظام؟", "answer": "لا يكفي وحده؛ قد يبقى التعرف غير المباشر ممكنًا. افحص الفرق بين الترميز وإخفاء الهوية وفعالية الإخفاء مع المختص.", "source": "regulation", "locator": "اللائحة التنفيذية، المادة 1 والمادة 9"}, {"question": "هل أحتاج موافقة صريحة في كل حالة؟", "answer": "ابدأ بتحديد المسوغ؛ المادة 6 من النظام تتضمن حالات لا تخضع للموافقة بشروطها. وعند الاعتماد على الموافقة، تراجع شروطها وحالات صراحتها في المادة 11 من اللائحة. لا تختزل المسوغ إلى توقيع عام.", "source": "regulation", "locator": "النظام م.5–6؛ اللائحة التنفيذية م.11؛ راجع قسم الأساس أدناه"}, {"question": "هل الحساب المؤسسي أو إيقاف التدريب يكفي؟", "answer": "لا؛ هما إعدادان محتملان ضمن تقييم الخدمة. تحقق من أغراض المورد ودوره والضمانات والعقد الفعلي، ثم افحص النقل والاحتفاظ والحقوق.", "source": "law", "locator": "النظام م.8؛ اللائحة التنفيذية م.17"}];
const faq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
const checkpoints = [
  {
    id: 'cp-1',
    no: '01',
    label: 'الموظف',
    title: 'هل البيانات شخصية فعلاً؟',
    question: 'هل النص يحتوي اسماً أو رقماً أو بريداً أو صورة أو معرّفاً يمكن ربطه بشخص؟',
    rule: 'تعريف البيانات والمعالجة في النظام يشمل التعرف غير المباشر. افحص إمكانية إعادة التعرف بدل الاكتفاء بحذف الاسم.',
    source: 'النظام م.1؛ اللائحة م.1 وم.9.',
    ref: 'law',
  },
  {
    id: 'cp-2',
    no: '02',
    label: 'القناة',
    title: 'من أي حساب دخلت؟',
    question: 'هل الإدخال من حساب شخصي أو مؤسسي بعقد وإعدادات معتمدة؟ ومن يقرأ المحادثة بعدك؟',
    rule: 'وثّق فئة البيانات والغرض والقناة؛ الحساب المؤسسي توصية تشغيلية في هذا المثال، لا مسوغ معالجة مستقل.',
    source: 'النظام م.11–13؛ توصية القناة تعليمية.',
    ref: 'law',
  },
  {
    id: 'cp-3',
    no: '03',
    label: 'الأداة',
    title: 'وش يصير بالمُدخل داخل الأداة؟',
    question: 'هل يُحفظ المُدخل؟ هل يُستخدم للتدريب؟ وهل هناك معالجون فرعيون؟',
    rule: 'اطلب وصف الحفظ والتدريب وأغراض المورد ومعالجيه؛ لا تستنتجها من اسم المنتج أو إعداد واحد.',
    source: 'النظام م.8؛ اللائحة التنفيذية م.17.',
    ref: 'regulation',
  },
  {
    id: 'cp-4',
    no: '04',
    label: 'المورد',
    title: 'أنت متحكم أم معالج؟',
    question: 'من يحدد الغرض؟ وهل المورد يعالج لحسابك فقط أم لأغراضه أيضاً؟',
    rule: 'من يحدد الغرض وكيفية المعالجة؟ الدور يُراجع لكل نشاط؛ قد يجمع المورد أدوارًا مختلفة.',
    source: 'النظام م.1 وم.8.',
    ref: 'law',
  },
  {
    id: 'cp-5',
    no: '05',
    label: 'النقل',
    title: 'وين تُعالج البيانات فعلياً؟',
    question: 'هل الخادم أو الدعم أو النسخ خارج المملكة؟ وهل توجد ضمانات مناسبة؟',
    rule: 'ارسم مناطق المعالجة والدعم والنقل اللاحق، واطلب مراجعة شروط النقل والاستثناء المنطبق إن وجد.',
    source: 'النظام م.29؛ لائحة النقل 2024 م.2–7.',
    ref: 'transfer',
  },
  {
    id: 'cp-6',
    no: '06',
    label: 'المخرجات',
    title: 'كم تبقى وكيف تنحذف؟',
    question: 'هل تُحفظ المخرجات؟ وهل يمكن حذف المحادثة والنسخ؟ وهل يستطيع الشخص طلب الوصول أو الإتلاف؟',
    rule: 'حدّد كيف تنفّذ الوصول والتصحيح والإتلاف، وما يتطلب الاحتفاظ نظامًا؛ حذف واجهة المحادثة لا يثبت إتلاف النسخ.',
    source: 'النظام م.4 وم.18؛ اللائحة م.3 وم.8.',
    ref: 'regulation',
  },
];
---
<PageShell
  title="PDPL والذكاء الاصطناعي: متى يخضع إدخال البيانات؟"
  description={description}
  crumbs={[{ name: 'مركز المعرفة', href: '/docs/' }, { name: 'PDPL والذكاء الاصطناعي' }]}
  ogType="article"
  structuredData={article}
>
  <div class="pd" id="top">
    <script is:inline>document.documentElement.classList.add('js');</script>
    <header class="pd-hero">
      <div class="pd-hero-main">
        <p class="pd-eyebrow"><span aria-hidden="true">◆</span> البيانات · رحلة من الموظف إلى النموذج</p>
        <h1>نظام حماية البيانات الشخصية (PDPL) والذكاء الاصطناعي: متى يصبح إدخال البيانات في أداة معالجة خاضعة للنظام؟</h1>
        <p class="pd-lead">إذا كانت مدخلاتك تكشف شخصًا مباشرة أو بصورة غير مباشرة، فإدخالها أو حفظها في أداة قد يكون معالجة. افحص نطاق النظام والمسوغ والدور والعقد والنقل قبل الإدخال؛ اسم الأداة أو موافقة المدير لا يحسمان الجواز. ابدأ ببطاقة أسئلة دون بيانات حقيقية.</p>
        <ul class="pd-badges" aria-label="بيانات الدليل">
          <li>البيانات</li>
          <li>6 نقاط فحص</li>
          <li>فرز وخطوات عمل</li>
          <li>التواريخ موضحة في بيانات التحرير أعلاه</li>
        </ul>
      </div>
      <aside class="pd-pass" aria-label="مسار البيانات المختصر">
        <p class="pd-pass-top"><span>DATA ROUTE</span><span>PDPL</span></p>
        <ol>
          <li><span>01</span><b>الموظف</b><small>نوع البيانات</small></li>
          <li><span>02</span><b>القناة</b><small>الحساب والإعدادات</small></li>
          <li><span>03</span><b>الأداة</b><small>المعالجة والسجل</small></li>
          <li><span>04</span><b>المورد</b><small>الدور والعقد</small></li>
          <li><span>05</span><b>النقل</b><small>الموقع والضمانات</small></li>
          <li><span>06</span><b>المخرجات</b><small>الاحتفاظ والحذف</small></li>
        </ol>
        <p class="pd-pass-foot">رسم توضيحي — ليست بيانات تشغيل حقيقية</p>
      </aside>
    </header>

    <p class="pd-alert" role="note">هذا شرح تعليمي للنصوص المحددة في المراجع، وليس إذنًا بمعالجة واقعة. التواريخ موضحة في بيانات التحرير أعلاه؛ تحديد المسوغ والنقل والأثر يحتاج المختص المخول.</p>

    <article class="pd-body"><div class="pd-layout">
      <aside class="pd-toc" aria-label="مسار القراءة"><h2>في هذا الدليل</h2><ol><li><a href="#scope">النطاق</a></li><li><a href="#defs">البيانات والأدوار</a></li><li><a href="#journey">نقاط الفحص</a></li><li><a href="#basis">المسوغ والموافقة</a></li><li><a href="#transfer">النقل</a></li><li><a href="#rights">الحقوق والحوادث</a></li><li><a href="#mistakes">مثال وخطوة تالية</a></li><li><a href="#refs-title">النسخ والمراجع</a></li></ol></aside>
      <div class="pd-content">
          <section id="scope" class="pd-sec"><h2>متى يدخل الاستخدام في النطاق؟</h2><p class="pd-answer">اختبر نوع البيانات ومكان المعالجة وصلتها بالمقيمين في المملكة. <a href="#source-law">المادة 2 من النظام</a> تنظم النطاق؛ <a href="#source-regulation">المادة 2 من اللائحة</a> تشرح استثناء الاستخدام الشخصي أو العائلي، ولا تعد الاستخدام المهني أو التجاري أو غير الربحي ضمنه.</p><p>لا تفترض أن البيانات المنشورة أو حذف الاسم يخرجانها من النطاق، ولا أن خارج النطاق يعني جوازًا مطلقًا؛ قد تبقى قيود السرية والعقود والحقوق ومتطلبات القطاع. عند الشك أوقف الإدخال واطلب تحديدًا مكتوبًا للنطاق.</p></section>
          <section id="defs" class="pd-sec"><h2>البيانات والمعالجة والأدوار</h2><p>التعرف غير المباشر يدخل في تعريف البيانات الشخصية، والمعالجة أوسع من التدريب؛ تشمل مثلًا الحفظ والاستعمال والنقل. هذا تلخيص لـ<a href="#source-law">المادة 1 من النظام</a>، فلا تعتبر إيقاف التدريب نفيًا للمعالجة.</p><p>الترميز يبقي معلومات إضافية يمكن بها إعادة الربط، بينما إخفاء الهوية له شروط وفعالية يجب التحقق منها؛ راجع <a href="#source-regulation">المادة 1 والمادة 9 من اللائحة التنفيذية</a>. احذف الحقول غير اللازمة، ولا تفترض أن الباقي مجهول.</p></section>
          <section id="roles" class="pd-sec"><h2>كيف تحدد المتحكم والمعالج؟</h2><p>راجع كل نشاط: من يحدد الغرض وكيفية المعالجة، ومن يعالج نيابة عنه؟ هذه هي نقطة التمييز في <a href="#source-law">تعريفات المادة 1</a>. لا تصنف المورد من مجرد مدة احتفاظ أو اسم خطة، ولا تجعل الموظف جهة معالجة مستقلة تلقائيًا.</p><p>احصل على وصف أغراض الخدمة والتدريب والدعم والمعالجين الفرعيين. اختيار معالج والتحقق من ضماناته لا يلغي مسؤوليات جهة التحكم: <a href="#source-law">النظام م.8</a>؛ وبنود العلاقة والاختيار مفصلة في <a href="#source-regulation">اللائحة م.17</a>. اعرض ما بقي غامضًا على الخصوصية والقانوني قبل التعاقد أو الإدخال.</p></section>
          <section id="journey" class="pd-sec pd-journey-sec">
            <div class="pd-sec-head"><span class="pd-sec-no" aria-hidden="true">04</span><h2 id="journey-title">رحلة البيانات من الموظف إلى النموذج: ست نقاط يجب أن تسأل عنها</h2></div>
            <p class="pd-answer">المسار يبدأ من قرار الموظف بالإدخال، ويمر بالقناة والأداة والمورد والنقل، وينتهي عند المخرجات والاحتفاظ. عند كل نقطة سؤال يحدد إن كانت المعالجة مضبوطة أو تحتاج توقفاً. اضغط أي نقطة لتفتح بطاقتها.</p>
            <div class="pd-journey" data-journey>
              <div class="pd-journey-scroll" tabindex="0" role="group" aria-label="مسار البيانات التفاعلي — استخدم الأسهم للتنقل بين النقاط">
                <svg class="pd-route" viewBox="0 0 1000 230" role="img" aria-labelledby="route-title route-desc">
                  <title id="route-title">مسار البيانات من الموظف إلى المخرجات عبر ست نقاط فحص</title>
                  <desc id="route-desc">رسم توضيحي اصطناعي يوضح انتقال البيانات من الموظف إلى القناة ثم الأداة فالمورد فالنقل ثم المخرجات. كل نقطة قابلة للنقر وتعرض سؤالاً وقاعدة.</desc>
                  <defs>
                    <linearGradient id="pd-line-grad" x1="1" y1="0" x2="0" y2="0">
                      <stop offset="0" stop-color="#c4b5fd"></stop>
                      <stop offset="0.5" stop-color="#8b5cf6"></stop>
                      <stop offset="1" stop-color="#5b21b6"></stop>
                    </linearGradient>
                    <filter id="pd-dot-glow" x="-200%" y="-200%" width="500%" height="500%">
                      <feGaussianBlur stdDeviation="4" result="b"></feGaussianBlur>
                      <feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
                    </filter>
                  </defs>
                  <path id="pd-route-path" class="pd-route-line" d="M 918 118 L 82 118"></path>
                  <path class="pd-route-dash" d="M 918 118 L 82 118"></path>
                  <circle class="pd-route-dot" r="7" fill="#ffb829" filter="url(#pd-dot-glow)">
                    <animateMotion dur="16s" repeatCount="indefinite">
                      <mpath href="#pd-route-path"></mpath>
                    </animateMotion>
                  </circle>
                  {checkpoints.map((cp, i) => (
                    <g class="pd-node" data-node={i} role="button" tabindex="0" aria-controls={cp.id} aria-label={`النقطة ${cp.no}: ${cp.title}`}>
                      <circle class="pd-node-halo" cx={918 - i * 167.2} cy="118" r="34"></circle>
                      <circle class="pd-node-disc" cx={918 - i * 167.2} cy="118" r="22"></circle>
                      <text class="pd-node-no" x={918 - i * 167.2} y="124" text-anchor="middle">{cp.no}</text>
                      <text class="pd-node-label" x={918 - i * 167.2} y={i % 2 === 0 ? 52 : 190} text-anchor="middle">{cp.label}</text>
                    </g>
                  ))}
                </svg>
              </div>
              <p class="pd-figure-note">رسم توضيحي ببيانات اصطناعية للتوضيح، ولا يمثل مساراً تقنياً أو نتيجة تقييم لحالة حقيقية. مرّر الرسم أفقياً عند الحاجة.</p>
              <div class="pd-cards">
                {checkpoints.map((cp, i) => (
                  <details class="pd-card" id={cp.id} data-card={i} open={i === 0}>
                    <summary><span class="pd-card-no">{cp.no}</span><span class="pd-card-title">{cp.title}</span><span class="pd-card-chev" aria-hidden="true">⌄</span></summary>
                    <div class="pd-card-body">
                      <p class="pd-card-q"><b>السؤال:</b> {cp.question}</p>
                      <p class="pd-card-rule"><b>القاعدة:</b> {cp.rule}</p>
                      <p class="pd-card-src"><a href={`#source-${cp.ref}`}>{cp.source}</a></p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
            <p>النقاط الست طبقات متداخلة: نوع البيانات، ثم الحساب والصلاحيات، ثم العقد والنقل، ثم المخرجات. إذا ضبطت نقطة وتركت الثانية، صار عندك وهم ضابط.</p>
            <p>إذا بقيت إجابة مجهولة، أرسل بطاقة الأسئلة إلى المختص قبل إدخال بيانات فعلية. الفرز الآتي يحدد أسئلة النطاق فقط؛ لا يثبت مسوغ المعالجة أو كفاية الضوابط. مرجعه <a href="#source-law">المادتان 1 و2 من النظام</a> و<a href="#source-regulation">المادة 2 من اللائحة</a>.</p>
            <div class="pd-tree-block">
              <h3 id="tree-title">شجرة قرار: هل ينطبق PDPL على حالتي؟</h3>
              <p>أربعة أسئلة اختيارية لتحديد ما يحتاج مراجعة؛ تجنب إدخال بيانات شخصية في أي وصف للحالة. النتيجة فرز تعليمي، وليست حكماً نظامياً.</p>
              <div class="pd-tree" data-tree aria-labelledby="tree-title">
                <div class="pd-tree-top">
                  <p class="pd-tree-progress" data-tree-progress aria-live="polite">سؤال 1 من 4</p>
                  <button type="button" class="pd-tree-reset" data-tree-reset>ابدأ من جديد</button>
                </div>
                <div data-tree-stage aria-live="polite"></div>
                <div class="pd-tree-actions" data-tree-actions>
                  <button type="button" data-tree-answer="yes">نعم</button>
                  <button type="button" data-tree-answer="no">لا</button>
                  <button type="button" class="pd-tree-back" data-tree-back hidden>رجوع</button>
                </div>
                <div class="pd-tree-result" data-tree-result hidden aria-live="polite"></div>
              </div>
              <details class="pd-tree-fallback">
                <summary>الأسئلة الأربعة كنص، بدون تفاعل</summary>
                <ol>
                  <li>هل البيانات شخصية بالمعنى النظامي؟</li>
                  <li>هل المعالجة لأغراض شخصية أو عائلية بحتة؟</li>
                  <li>هل تحدد أنت أو منشأتك الغرض وطريقة المعالجة؟</li>
                  <li>هل المعالجة في المملكة أو تخص أفراداً مقيمين فيها؟</li>
                </ol>
                <p>إذا كانت البيانات شخصية والمعالجة ليست شخصية أو عائلية بحتة وتنطبق الصلة بالمملكة، فانتقل لمراجعة المسوغ والضوابط. تحديد الدور يحتاج وقائع النشاط؛ الإجابة «لا» عن تحديد الغرض لا تثبت وحدها أنك معالج.</p>
              </details>
            </div>
          </section>

          <section id="basis" class="pd-sec"><h2>المسوغ أولًا، ثم شروط الموافقة</h2><p class="pd-answer">لا تبدأ بنموذج موافقة عام. <a href="#source-law">المادتان 5 و6 من النظام</a> تنظمان أصل الموافقة وحالات المعالجة التي لا تخضع لها. يحدد المختص المسوغ وشروطه للغرض الفعلي.</p><p>إذا كان المسوغ الموافقة، راجع <a href="#source-regulation">المادة 11 من اللائحة</a> لشروط الحرية والوضوح والإثبات واستقلال الغرض، وحالات الصراحة ومنها البيانات الحساسة أو الائتمانية والقرار المبني كليًا على المعالجة الآلية. لا تحول هذا إلى اشتراط موافقة في كل معالجة، ولا إلى إعفاء لمجرد وجود علاقة عمل.</p><p>«المصلحة المشروعة» ليست وصفًا عامًا لراحة المنشأة؛ <a href="#source-regulation">المادة 16</a> تستثني الجهة العامة من هذا المسار، وتشترط ضوابط وتقويمًا موثقًا، ولا يشمل بيانات حساسة. لا تختَرها تلقائيًا بدل موافقة يصعب الحصول عليها.</p><p>استكمل معلومات الغرض والبيانات والجهات والاحتفاظ والحقوق: <a href="#source-law">النظام م.11–13</a>، و<a href="#source-regulation">اللائحة م.4 وم.19</a>. وإذا انطبقت إحدى حالات تقويم الأثر فطبّق مراجعة <a href="#source-regulation">المادة 25</a>؛ ورقة مخاطر AI التعليمية لا تستبدل هذا التقويم.</p></section>
          <section id="transfer" class="pd-sec"><h2>النقل: اختر النص والنسخة قبل الضمان</h2><p class="pd-answer">راجع <a href="#source-law">المادة 29 من النظام</a> و<a href="#source-transfer">لائحة النقل، قرار 1840 المنشور في 1 سبتمبر 2024</a>. لا تفترض أن كل نقل محظور أو أن الغرض أو توقيع عقد وحدهما يكفيان.</p><ol class="pd-steps"><li>ارسم مواقع المدخلات والمخرجات والسجلات والدعم والنسخ وأي نقل لاحق؛ هذه قائمة فحص تعليمية لتجميع الوقائع.</li><li>اطلب من المختص تحديد الغرض والشروط المنطبقة في المادة 29، ومسار مستوى الحماية أو الإعفاء وضماناته في مواد اللائحة 2–6.</li><li>افحص انطباق تقويم مخاطر النقل في المادة 7، ومنها حالات المادة 4 ونقل البيانات الحساسة باستمرار أو على نطاق واسع؛ ليس كل نقل له الحكم نفسه.</li><li>وثّق القرار والقيود وما يعيد المراجعة. إن غاب موقع أو ضمان لازم، لا تبدأ إدخال البيانات بناءً على التخمين.</li></ol><p>تفصيل خريطة البيانات في <a href="/knowledge/ai-data-residency-saudi/">دليل إقامة البيانات</a>؛ هذا الشرح لا يقرر ملاءمة دولة أو شهادة مورد بعينه.</p></section>
          <section id="rights" class="pd-sec"><h2>الحقوق والإتلاف والإبلاغ عن الحادث</h2><p>رتّب طريقة تنفيذ حقوق العلم والوصول والنسخة والتصحيح والإتلاف وفق <a href="#source-law">المادة 4</a>، مع قيود الإتلاف والاحتفاظ في <a href="#source-law">المادة 18</a>. وثّق أين توجد البيانات ومن ينفذ الطلب؛ حذف واجهة المحادثة ليس دليلًا على إتلاف كل النسخ.</p><p><a href="#source-regulation">المادة 3 من اللائحة</a> تحدد أجل تنفيذ طلبات الحقوق بثلاثين يومًا دون تأخير، مع تمديد لا يتجاوز ثلاثين أخرى في الحالات المحددة وإشعار مسبق بمبرراته؛ لا وعد آلي بمدة واحدة لكل واقعة. تفاصيل الإتلاف والنسخ في المادة 8.</p><p>عند الاشتباه بتسرب، أبلغ الفريق الداخلي واحفظ الوقائع دون توزيع البيانات. <a href="#source-regulation">المادة 24</a> تحدد شروط إشعار الجهة المختصة خلال 72 ساعة من العلم بالحادثة، ومسار إشعار صاحب البيانات دون تأخير غير مبرر بشروطه. لا تعتبر كل بلاغ داخلي تسربًا مؤكدًا، ولا تنتظر اكتمال التحقيق لبدء التقييم المختص.</p></section>
          <section id="mistakes" class="pd-sec"><h2>مثال اصطناعي: تلخيص سيرة ذاتية</h2><div class="pd-example"><p class="pd-example-label">منشأة وحالة خياليتان؛ ليستا عميلًا أو نتيجة تحقق</p><p>تريد منشأة «مدار المثال» اختبار تلخيص السير. تبدأ بسيرة مختلقة بالكامل، ولا ترتب مرشحين حقيقيين أو تستبعدهم. تختبر هل يضيف الملخص مؤهلًا غير موجود وهل يحتفظ بالحقائق التي يحددها المراجع.</p><p>قبل الانتقال لسير حقيقية، تجمع الغرض والحقول ومسوغ المعالجة ودور المورد ومواقعه والاحتفاظ ومن يطلع على الملخص، وتطلب من الخصوصية مراجعة تقويم الأثر عند انطباقه. حذف الاسم من سيرة حقيقية لا يجعلها اصطناعية أو مجهولة؛ ومراجعة بشرية اسمية لا تحسم مشروعية المعالجة.</p></div><h3>خطوتك التالية وحدودها</h3><p>اكتب بطاقة: «غرض، فئة بيانات، جهة تحكم/معالجة محتملة، مسوغ يحتاج مراجعة، مورد ومواقع، احتفاظ وحقوق، قرار منتظر ومالكه». أي مجهول له مالك وسؤال، ولا يُستبدل بـ«مسموح». اعرضها على الخصوصية والقانوني، والأمن للتكامل والصلاحيات، ومختص القطاع عند أثر صحي أو مالي.</p><p>بعد حسم الحدود، وثق <a href="/knowledge/ai-risk-assessment/">سجل المخاطر والاختبار</a> ثم اكتب <a href="/knowledge/ai-use-policy-employees/">تعليمات الموظف</a>. هذا الدليل لا يختار مسوغًا أو يجيز نقلًا لواقعة، ولا يثبت امتثالًا أو إتاحة منتج.</p></section>
          <section id="faq" class="pd-sec"><h2>أسئلة شائعة</h2><div class="pd-faq">{faqs.map(({ question, answer, source, locator }) => <article><h3>{question}</h3><p>{answer}</p><p><a href={`#source-${source}`}>{locator}</a></p></article>)}</div></section>
          <section class="pd-refs" aria-labelledby="refs-title"><h2 id="refs-title">النسخ والمراجع المعتمدة لهذا الشرح</h2><GuideSources sources={['law', 'regulation', 'transfer', 'commencement']} /></section>
