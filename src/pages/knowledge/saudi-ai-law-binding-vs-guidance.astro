  .sl-def {
    margin-block: 22px 0; display: grid; grid-template-columns: 108px minmax(0, 1fr);
    gap: 16px; padding-block: 16px; border-block: 1px solid var(--sl-line);
  }
  .sl-def h2 { font-size: 12px; color: var(--sl-sky); margin: 5px 0 0; letter-spacing: 0.03em; }
  .sl-def p { margin: 0; font-size: 16.5px; color: #e8eef8; max-inline-size: 78ch; }

  .sl-layout { display: grid; grid-template-columns: 204px minmax(0, 1fr); gap: clamp(22px, 4vw, 54px); align-items: start; margin-block-start: 26px; }
  .sl-layout > * { min-inline-size: 0; }
  .sl-toc { position: sticky; inset-block-start: 16px; padding-block: 14px; border-block-start: 1px solid var(--sl-line); }
  .sl-toc-label { margin: 0 0 11px; font-size: 10.5px; color: #8da0b8; letter-spacing: 0.05em; }
  .sl-toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .sl-toc a { display: flex; gap: 7px; align-items: baseline; padding: 5px 0; font-size: 12.5px; color: #b8c5d8; text-decoration: none; border-block-end: 1px dotted #223147; }
  .sl-toc a:hover { color: #fff; }
