  .sl-timeline ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(120px, 1fr)); gap: 0; min-inline-size: 760px; position: relative; }
  .sl-timeline ol::before { content: ""; position: absolute; inset-block-start: 25px; inset-inline: 8px; block-size: 1px; background: linear-gradient(90deg, #475569, #60a5fa, #475569); }
