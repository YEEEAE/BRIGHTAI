    background: linear-gradient(160deg, #60a5fa12, transparent 62%), var(--sl-panel);
    position: relative;
  }
  .sl-tldr::after {
    content: "TL;DR"; position: absolute; inset-block-start: 12px; inset-inline-end: 16px;
    font-family: var(--font-monospace); font-size: 10px; letter-spacing: 0.12em; color: #6f8bad;
  }
  .sl-tldr h2 { font-size: clamp(19px, 2vw, 23px); margin-block: 0 12px; }
  .sl-tldr ul { margin: 0; padding-inline-start: 19px; display: grid; gap: 9px; }
  .sl-tldr li { font-size: 15.5px; }
