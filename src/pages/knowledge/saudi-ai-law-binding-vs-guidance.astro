  @media (max-width: 560px) {
    .sl-def { grid-template-columns: 1fr; gap: 6px; }
    .sl-sec-head { gap: 9px; }
    .sl-answer { font-size: 16px; }
    .sl-status { grid-template-columns: 14px minmax(0, 1fr); }
    .sl-status a { grid-column: 2; }
    .sl-stratum { margin-inline-start: calc(var(--i) * 8px); }
    .sl-builder label { font-size: 13.5px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .sl-reveal, .js .sl-hero-main h1, .js .sl-stratum { opacity: 1 !important; transform: none !important; animation: none !important; transition: none !important; }
    .sl-stratum { transition: none; }
  }
  @media print {
    .sl-toc, .sl-stack, .sl-builder, .sl-cta, .sl-next, .sl-status { display: none; }
    .sl, .sl p, .sl li, .sl td, .sl th, .sl dd { color: #000; }
    .sl-sec, .sl-faq article, .sl-timeline, .sl-tablewrap { break-inside: avoid; }
    .sl a { color: #000; text-decoration: underline; }
    .sl-timeline { overflow: visible; }
    .sl-timeline ol { min-inline-size: 0; grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script>
  // Layer explorer: update the explanation panel and highlight the active layer.
  document.querySelectorAll<HTMLElement>('[data-layer]').forEach((layer) => {
    const select = () => {
      const id = layer.dataset.layer;
      document.querySelectorAll<HTMLElement>('[data-layer]').forEach((item) => {
        item.dataset.active = String(item.dataset.layer === id);
      });
      const panel = document.querySelector<HTMLElement>('[data-layer-panel]');
      if (panel) {
        const title = layer.dataset.title ?? '';
        const detail = layer.dataset.detail ?? '';
        panel.innerHTML = `<p><b>${title}</b></p><p>${detail}</p>`;
      }
    };
    layer.addEventListener('click', select);
    layer.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        select();
      }
    });
  });

  // Quick stack builder: local-only, no data leaves the page.
  document.querySelectorAll<HTMLElement>('[data-builder]').forEach((root) => {
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    const out = root.querySelector<HTMLElement>('[data-builder-out]');
    const render = () => {
      if (!out) return;
      const picked = new Set(boxes.filter((box) => box.checked).map((box) => box.value));
      if (picked.size === 0) {
        out.innerHTML = '<p><b>الترتيب الافتراضي:</b> ابدأ بالأنظمة العامة، ثم متطلبات القطاع والعقد، ثم الإرشاد. فعّل الخيارات أعلاه لتضييق الأولوية.</p>';
        return;
      }
      const items: string[] = [];
      if (picked.has('personal')) items.push('نظام حماية البيانات الشخصية: الأساس والغرض والحد الأدنى وتقويم الأثر والنقل والحقوق.');
      if (picked.has('gov')) items.push('سياسات البيانات الحكومية ومتطلبات الجهة العامة، وقد تشمل وثائق سدايا عبر تعميم أو عقد.');
      if (picked.has('sector')) items.push('متطلبات المنظم القطاعي والعقد: الأمن والحوكمة والاستعانة بمصادر خارجية والموافقات.');
      items.push('الطبقة الإرشادية: مبادئ الأخلاقيات ومبادئ الذكاء الاصطناعي التوليدي وإطار المخاطر كحد أدنى مهني.');
      out.innerHTML = `<p><b>ابدأ بهذا الترتيب:</b></p><ol>${items.map((item) => `<li>${item}</li>`).join('')}</ol><p>النتيجة ترتيب للأسئلة فقط، وليست حكماً قانونياً أو تأكيداً للامتثال.</p>`;
    };
    boxes.forEach((box) => box.addEventListener('change', render));
    render();
  });

  // Reveal on scroll, honouring reduced motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('.sl-reveal');
  if (reduce || !('IntersectionObserver' in window)) {
    targets.forEach((item) => item.classList.add('is-in'));
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });
    targets.forEach((item) => observer.observe(item));
  }
</script>
