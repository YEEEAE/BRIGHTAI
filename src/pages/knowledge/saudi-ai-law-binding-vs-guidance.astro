  .sl-builder-hint { margin: 0; font-size: 12.5px; color: #9fb0c7; }
  .sl-builder fieldset { margin: 0; padding: 8px 16px 14px; border: 0; display: grid; gap: 8px; }
  .sl-builder legend { padding: 0; font-size: 11px; color: #8fa3bd; }
  .sl-builder label { display: flex; align-items: center; gap: 10px; min-block-size: 44px; padding: 7px 10px; border: 1px solid #2b3d56; background: #0b1524; font-size: 14px; color: #dbe6f3; cursor: pointer; }
  .sl-builder label:hover { border-color: #64748b; }
  .sl-builder input { inline-size: 18px; block-size: 18px; accent-color: var(--sl-sky-strong); flex: none; }
  .sl-builder-out { margin: 0 16px; padding: 13px 14px; border-block-start: 1px solid #2b3d56; background: #0a1322; }
  .sl-builder-out p { margin: 0; font-size: 13.5px; line-height: 1.9; }
  .sl-builder-out b { color: #f0f9ff; }
  .sl-builder-out ul { margin: 8px 0 0; padding-inline-start: 18px; display: grid; gap: 4px; }
  .sl-builder-out li { font-size: 13px; }
  .sl-builder-note { margin: 10px 16px 14px; font-size: 11px; color: #8396ae; }

  .sl-mistakes { display: grid; gap: 1px; background: #223147; border: 1px solid #223147; margin-block: 12px 16px; }
  .sl-mistakes > div { background: #0b1220; padding: 12px 14px; }
