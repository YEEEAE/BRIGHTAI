  .sl-mistakes dd { margin: 0; font-size: 13.5px; }
  .sl-mistakes b { color: #bfdbfe; }

  .sl-list { margin: 10px 0 16px; padding-inline-start: 20px; display: grid; gap: 7px; }
  .sl-list li { font-size: 14.5px; }
  .sl-list b { color: #eef4ff; }

  .sl-scroll-hint { font-size: 11.5px; color: #8fa3bd; margin-block: 8px; }
  .sl-tablewrap { overflow-x: auto; border: 1px solid var(--sl-line); margin-block: 12px 14px; }
  .sl-tablewrap table { inline-size: 100%; min-inline-size: 760px; border-collapse: collapse; font-size: 13.5px; }
  .sl-tablewrap caption { text-align: start; padding: 10px 12px; font-size: 12px; color: #a9bad0; background: #0b1524; }
  .sl-tablewrap th, .sl-tablewrap td { padding: 10px 11px; text-align: start; border-block-end: 1px solid #1e2c40; vertical-align: top; }
  .sl-tablewrap thead th { background: #132239; color: #f1f5f9; font-size: 12.5px; font-weight: 700; }
  .sl-tablewrap tbody tr:hover { background: #0f1a2b; }
  .sl-tablewrap b { color: #f1f5f9; }

  .sl-badge { display: inline-flex; align-items: center; min-height: 24px; padding: 2px 8px; font-size: 11.5px; border: 1px solid; border-radius: 2px; white-space: nowrap; }
  .sl-badge-bind { color: #fecaca; border-color: #7f1d1d; background: #3b1111; }
  .sl-badge-guide { color: #bfdbfe; border-color: #1e40af; background: #102347; }
  .sl-badge-draft { color: #fde68a; border-color: #78550f; background: #33260a; }
  .sl-badge-std { color: #d1d5db; border-color: #4b5563; background: #1b2432; }

  .sl-faq { display: grid; gap: 1px; background: #223147; border: 1px solid #223147; }
  .sl-faq article { background: #0b1220; padding: 14px 16px; }
  .sl-faq h3 { color: #f1f5f9; font-size: 16px; margin-block: 0 6px; }
  .sl-faq p { margin: 0; font-size: 14.5px; }

  .sl-next { padding-block: 26px 4px; }
  .sl-next-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); gap: 1px; background: #223147; border: 1px solid #223147; margin-block-start: 12px; }
  .sl-next-grid a { display: grid; gap: 5px; padding: 14px; background: #0b1220; text-decoration: none; min-height: 110px; align-content: start; }
  .sl-next-grid a:hover { background: #101c2e; }
  .sl-next-grid span { font-size: 10.5px; color: var(--sl-sky); }
  .sl-next-grid b { color: #f1f5f9; font-size: 14px; line-height: 1.6; }
  .sl-next-grid small { color: #a9bad0; font-size: 12px; line-height: 1.7; }
  .sl-site-link { margin-block: 14px 0; font-size: 13px; }

  .sl-refs { padding-block: 26px 10px; }
  .sl-refs ul { padding-inline-start: 18px; display: grid; gap: 8px; }
  .sl-refs li { font-size: 13px; }
  .sl-fine { font-size: 11.5px; color: #93a6bd; border-block-start: 1px solid #1b283a; padding-block-start: 12px; margin-block-start: 16px; }

  .sl-cta { margin-block: 24px 0; padding: 14px 16px; border: 1px solid #2b3d56; background: #0b1220; font-size: 14px; }

  /* Motion */
  .js .sl-reveal { opacity: 0; transform: translateY(14px); transition: opacity 0.55s ease, transform 0.55s ease; }
  .js .sl-reveal.is-in { opacity: 1; transform: none; }
  .js .sl-hero-main h1 { animation: sl-rise 0.6s ease both; }
  .js .sl-stratum { animation: sl-stack 0.55s ease both; animation-delay: calc(0.08s + var(--i) * 0.09s); }
  @keyframes sl-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes sl-stack { from { opacity: 0; transform: translateY(-10px) translateX(10px); } to { opacity: 1; transform: none; } }

  @media (max-width: 1000px) {
    .sl-layout { grid-template-columns: 1fr; }
    .sl-toc { position: static; border: 1px solid var(--sl-line); padding: 12px 14px; }
    .sl-toc ol { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0 14px; }
    .sl-hero { grid-template-columns: 1fr; }
    .sl-stack { max-inline-size: 430px; }
  }
  @media (max-width: 760px) {
    .sl-pyramid { grid-template-columns: 1fr; }
