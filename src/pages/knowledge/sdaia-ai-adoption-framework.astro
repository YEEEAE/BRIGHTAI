<script>
  type Band = 0 | 1 | 2 | 3;
  const quizRoots = document.querySelectorAll<HTMLElement>('[data-quiz]');
  const bandOf = (score: number): Band => (score <= 1 ? 0 : score <= 3 ? 1 : score <= 5 ? 2 : 3);

  quizRoots.forEach((form) => {
    const container = form.closest('.k1-quiz');
    if (!container) return;
    const results = container.querySelector<HTMLElement>('[data-quiz-results]');
    const idle = container.querySelector<HTMLElement>('[data-quiz-idle]');
    const error = container.querySelector<HTMLElement>('[data-quiz-error]');
    const panels = Array.from(container.querySelectorAll<HTMLElement>('[data-band]'));

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;
      const data = new FormData(form);
      let score = 0;
      let answered = 0;
      for (let i = 1; i <= 6; i += 1) {
        const value = data.get(`q${i}`);
        if (value === '1' || value === '0') {
          answered += 1;
          score += Number(value);
        }
      }
      if (error) error.hidden = answered === 6;
      if (answered < 6) {
        if (idle) idle.hidden = false;
        panels.forEach((panel) => { panel.hidden = true; });
        return;
      }
      if (idle) idle.hidden = true;
      const band = bandOf(score);
      panels.forEach((panel) => { panel.hidden = panel.dataset.band !== String(band); });
      const active = panels.find((panel) => panel.dataset.band === String(band));
      active?.setAttribute('tabindex', '-1');
      active?.focus({ preventScroll: true });
      if (results) results.dataset.score = String(score);
    });
  });

  const roadmaps = document.querySelectorAll<HTMLElement>('[data-roadmap]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  roadmaps.forEach((root) => {
    const path = root.querySelector<SVGPathElement>('[data-road-path]');
    const stations = Array.from(root.querySelectorAll<HTMLElement>('[data-station]'));
    if (!path) return;
    let frame = 0;

    const paint = () => {
      frame = 0;
      if (reduced.matches) {
        path.style.strokeDashoffset = '0';
        stations.forEach((station) => station.setAttribute('data-active', ''));
        return;
      }
      const rect = root.getBoundingClientRect();
      const viewport = window.innerHeight;
      const total = rect.height + viewport * 0.4;
      const travelled = viewport * 0.85 - rect.top;
      const progress = Math.min(1, Math.max(0, travelled / total));
      path.style.strokeDashoffset = String(1 - progress);
      const threshold = viewport * 0.72;
      stations.forEach((station) => {
        const stationRect = station.getBoundingClientRect();
        if (stationRect.top <= threshold) station.setAttribute('data-active', '');
        else station.removeAttribute('data-active');
      });
    };

    const request = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(paint);
    };

    paint();
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    reduced.addEventListener('change', paint);
  });
</script>
