export const prerender = true;
const description = 'ابدأ حوكمة استخدام واحد بمالك ونطاق ومتطلبات وضوابط واختبار وقرار مراجعة، مع التمييز بين النظام والإرشاد والمعيار.';
const article = articleStructuredData('حوكمة الذكاء الاصطناعي في السعودية', description, Astro.url.pathname);
const faqs = [{"question": "هل شراء منصة يثبت تطبيق الحوكمة؟", "answer": "لا؛ تحتاج نطاقًا ومسؤوليات ومراجعات واختبارات وأدلة وقرارًا من المخول. المثال هنا تعليمي، ولا يثبت تشغيل منتج أو امتثال منشأة."}, {"question": "هل الخطوات الست متطلب رسمي؟", "answer": "لا؛ هي طريقة عمل تعليمية مقترحة. راجع جدول المصادر لتمييز النظام الملزم ووثيقة النطاق الحكومي والإطار الطوعي والمعيار."}];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
---
<PageShell title="حوكمة الذكاء الاصطناعي في السعودية | BRIGHTAI" description={description} crumbs={[{ name: 'مركز المعرفة', href: '/docs/' }, { name: 'حوكمة الذكاء الاصطناعي في السعودية' }]} ogType="article" structuredData={article}>
  <div class="reading-layout"><aside class="reading-nav" aria-label="في هذا الدليل"><h2>في هذا الدليل</h2><a href="#enterprise-experiment">حوكمة التجارب</a><a href="#part-1">صفة المرجع ونطاقه</a><a href="#part-2">خطوات العمل</a><a href="#decision">بوابات القرار</a><a href="#example">مثال اصطناعي</a><a href="#limits">الحدود والخطوة التالية</a><a href="/docs/">← كل الأدلة</a></aside><article>
    <p class="eyebrow">دليل عملي · الاطلاع على المصادر موضح في بيانات التحرير</p><h1>حوكمة الذكاء الاصطناعي في السعودية</h1>
    <p class="lead">ابدأ باستخدام واحد: سمِّ مالكه، وحدد غرضه وبياناته والقرار الذي يؤثر فيه، ثم اجمع المراجعات اللازمة قبل إدخال بيانات فعلية. مخرجك الأول بطاقة استخدام وقرار اختبار محدود، لا شراء منصة ولا موافقة عامة على AI.</p>
    <section class="block" id="enterprise-experiment"><h2>ما المقصود بحوكمة الذكاء الاصطناعي في تجارب المؤسسات؟</h2>
      <p>حوكمة الذكاء الاصطناعي في تجارب المؤسسات هي تحديد المسؤول عن تجربة استخدام AI، وغرضها وبياناتها وحدود صلاحياتها، وكيف تُقاس مخاطرها ومن يقرر استمرارها أو إيقافها. تبدأ التجربة بنطاق موثق واختبارات وقرار من المخول؛ نجاح العرض التقني وحده لا يثبت سلامة الاستخدام أو امتثال المؤسسة.</p>
      <p><strong>الشروط والحدود:</strong> هذا تعريف عملي تعليمي مستند إلى وظائف إطار NIST الطوعي، وليس تعريفًا نظاميًا سعوديًا. تُراجع المتطلبات القانونية والقطاعية بحسب الحالة؛ ولا يثبت هذا الشرح أن BRIGHTAI يشغّل هذه الضوابط في بيئة عميل.</p>
      <p><strong>المصدر:</strong> <a href="https://nvlpubs.nist.gov/nistpubs/ai/NIST.AI.100-1.pdf#page=26">NIST AI RMF 1.0، يناير 2023، القسم 5 ووظائفه الأربع، الصفحات المطبوعة 20–31</a>؛ الصياغة والتطبيق العملي من BRIGHTAI.</p>
      <details><summary>تفصيل اختياري: ما الذي توثقه قبل التجربة؟</summary><p>وثّق المهمة والمالك والمستخدمين والبيانات المسموحة، وحدد أثر الخطأ واختبارات الرفض وقناة التصعيد وشروط الإيقاف. احتفظ بنتائج الاختبار وقرار المراجع وحدوده وموعد إعادة التقييم. استخدم الخطوات التالية لإعداد هذه الأدلة؛ لا تعتبر قائمة الحقول شهادة امتثال.</p></details>
    </section>
    <section class="block" id="part-1"><h2>ما الملزم وما الإرشادي؟</h2>
      <ul class="list"><li><strong>نظام ملزم:</strong> إذا دخلت المعالجة في نطاق PDPL، راجع تعريف البيانات والمعالجة ونطاق الانطباق في <a href="#source-law">المادتين 1 و2 من النظام</a>. وجود نموذج AI لا يغيّر هذا النطاق.</li>
      <li><strong>نطاق حكومي محدد:</strong> مبادئ سدايا للذكاء الاصطناعي التوليدي تتضمن متطلبات للبيانات والتعاملات الحكومية؛ راجع <a href="#source-government">القسم 2 للنطاق، والقسم 3 للمبادئ</a>. لا تصف جميع وثائق سدايا بأنها اختيارية، ولا تطبق هذه النسخة على كل شركة تلقائيًا.</li>
      <li><strong>إرشاد طوعي:</strong> ينظم <a href="#source-nist">NIST AI RMF 1.0، القسم 5</a> العمل بأربع وظائف متداخلة: الحوكمة، فهم السياق، القياس، وإدارة المخاطر. الخطوات أدناه اقتراحنا العملي، وليست تسلسلًا إلزاميًا من NIST.</li>
      <li><strong>معيار:</strong> <a href="#source-iso">ISO/IEC 42001:2023</a> يصف نظام إدارة AI؛ قراءة المعيار أو استخدام أداة لا تثبت حصول منشأة على شهادة. إذا أحال عقدك أو متطلب الجهة إليه، يراجع المختص نطاق الإحالة.</li></ul>
    </section>
    <section class="block" id="part-2"><h2>ست خطوات تنتهي بقرار قابل للمراجعة</h2><ol class="list">
      <li><strong>اكتب بطاقة الاستخدام:</strong> المهمة، المستخدمون، المستفيدون، المورد والنموذج، البيانات، والمخرج المسموح والمستبعد. المخرج: بطاقة لها رقم ومالك.</li>
      <li><strong>اجمع متطلبات الحالة:</strong> اطلب من الخصوصية والأمن والامتثال تحديد المصدر والنسخة والمادة وسبب انطباقها. المخرج: قائمة متطلبات؛ لا تخلط القانون بعقد المورد أو بخيار داخلي.</li>
      <li><strong>سجّل سيناريو الضرر:</strong> ماذا قد يخطئ، ومن يتأثر، وما الدليل الناقص؟ استخدم <a href="/knowledge/ai-risk-assessment/">ورقة تقييم المخاطر</a>. المخرج: خطر ومالك وضابط واختبار.</li>
      <li><strong>حدّد صلاحيات القرار:</strong> من ينفذ، ومن يراجع، ومن يعتمد، ومن يوقف؟ لا تجعل قبول المخاطر تفويضًا لتجاوز النظام. المخرج: أسماء أدوار وقناة تصعيد.</li>
      <li><strong>اختبر ببيانات اصطناعية أولًا:</strong> عرّف مسبقًا حالات النجاح والفشل، وافحص إمكانية تجاوز الضابط. المخرج: دليل اختبار وحدود معروفة؛ الانتقال للبيانات الحقيقية له مراجعة مستقلة.</li>
      <li><strong>اعتمد نطاقًا محدودًا أو أوقفه:</strong> وثّق القرار وأسبابه وموعد مراجعته والحدث الذي يعيد التقييم، كتغير المورد أو البيانات أو الغرض. المخرج: قرار مؤرخ، لا عبارة «معتمد» بلا نطاق.</li>
    </ol></section>
    <section class="block" id="decision"><h2>عند أي بوابة تتوقف؟</h2><ul class="list"><li>غرض أو مالك غير معروف ← أكمل بطاقة الاستخدام قبل الاختبار.</li><li>بيانات شخصية أو دور مورد أو نقل غير محسوم ← أحلها إلى الخصوصية مع <a href="/knowledge/pdpl-and-ai/">نقاط فحص PDPL</a>؛ لا تُدخل البيانات حتى تحسم المراجعة.</li><li>قرار يمس فردًا أو خدمة أو مالًا، أو ضابط لم يُختبر ← اطلب مراجعة المخاطر والمختص القطاعي؛ اختبر بديلًا أقل أثرًا.</li><li>النطاق والمراجعات والاختبارات مكتملة ← يقرر المخول السماح المحدود أو الرفض، مع شروط الإيقاف.</li></ul><p class="note">هذه بوابات تعليمية لإدارة العمل، وليست تصنيف مخاطر رسميًا أو حكمًا بانطباق نظام.</p></section>
    <section class="block" id="example"><h2>مثال اصطناعي: مساعد لصياغة ردود الدعم</h2><p>منشأة خيالية «مدار المثال» تريد صياغة رد من أسئلة منشورة. تحدد المالك في خدمة العملاء، وتستبعد بيانات العميل ومنح التعويض. تجهز حالات اصطناعية تتضمن سؤالًا عن سياسة منشورة وأخرى تطلب تعويضًا غير مصرح به.</p><p>معيار الاختبار المقترح: لا يُرسل الرد تلقائيًا، ويطابق المراجع المصدر المنشور، ويُحال طلب التعويض إلى صاحب الصلاحية. إذا أخفق الاختبار يبقى الاستخدام موقوفًا حتى تعديل الضابط وإعادة اختباره. هذا مثال لإعداد قرار، وليس نتيجة اختبار حقيقية أو ضمانًا للحماية.</p></section>
    <section class="block" id="limits"><h2>حدود الدليل والخطوة التالية</h2><p>لا تحدد هذه الخطوات أساس معالجة أو ترخيص نشاط أو متطلبات القطاع نيابة عن المختص. راجع الخصوصية للبيانات والأدوار والنقل، والأمن للتكامل والصلاحيات، والمختص الصحي أو المالي عند أثر قطاعي، والشؤون القانونية عند التزام أو عقد غير محسوم.</p><p><strong>خطوتك الآن:</strong> اكتب بطاقة الاستخدام بالحقول المذكورة، وأرسلها للمالكين دون بيانات حساسة. بعدها حوّل الحدود المعتمدة إلى <a href="/knowledge/ai-use-policy-employees/">سياسة مفهومة للموظفين</a>. الأدلة المتخصصة تشرح التنفيذ، وهذا الدليل يحدد مسار القرار العام.</p></section>
