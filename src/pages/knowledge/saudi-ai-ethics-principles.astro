    overflow-wrap: anywhere;
  }
  .k2 a {
    color: var(--k2-emerald-soft);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .k2 a:hover { color: var(--k2-emerald); }
  .k2 a:focus-visible,
  .k2 button:focus-visible,
  .k2 summary:focus-visible,
  .k2 input:focus-visible {
    outline: 2px solid var(--k2-emerald);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .k2-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0;
    color: var(--k2-emerald);
    font-size: 13px;
  }
  .k2-lead {
    font-size: clamp(17px, 1.55vw, 20px);
    line-height: 1.95;
    max-inline-size: 64ch;
    color: #d8e2dd;
    margin-block: 0 24px;
  }
  .k2-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
  }
  .k2-badges li {
    font-size: 12.5px;
    color: #c9e7da;
    border: 1px solid var(--k2-emerald-dim);
    border-radius: 999px;
    padding: 6px 14px;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    background: #071812;
  }

  /* Hero: full-width matrix band, no side card */
  .k2-hero {
    padding-block-end: 34px;
    border-block-end: 1px solid var(--k2-line);
    background-image:
      linear-gradient(90deg, #35e0a10a 1px, transparent 1px),
      linear-gradient(180deg, #35e0a10a 1px, transparent 1px);
    background-size: 44px 44px;
    background-position: top right;
  }
  .k2-hero-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-block-start: 18px;
  }
  .k2-hero-tag {
    margin: 0;
    font-size: 12px;
    color: #86a99b;
    font-variant-numeric: tabular-nums;
  }
  .k2-hero-matrix {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: 1px;
    background: var(--k2-line);
    border: 1px solid var(--k2-line);
    border-radius: 14px;
    overflow: hidden;
  }
  .k2-hero-matrix li {
    display: grid;
    gap: 4px;
    padding: 14px 15px;
    background: #050c09;
    transition: background-color 0.3s ease;
  }
  .k2-hero-matrix li:hover { background: #08170f; }
  .k2-hero-matrix span {
    font-size: 11px;
    color: var(--k2-emerald);
    font-variant-numeric: tabular-nums;
  }
  .k2-hero-matrix b {
    color: #eaf6f0;
    font-size: 13.5px;
    line-height: 1.6;
  }

  .k2-alert {
    margin-block: 24px 0;
    padding: 13px 17px;
    border-inline-start: 2px solid var(--k2-emerald);
    background: #06130e;
    color: #c2d2cb;
    font-size: 13px;
    line-height: 1.85;
  }

  .k2-tldr {
    margin-block: 34px 0;
    padding: clamp(20px, 3vw, 30px);
    border: 1px solid var(--k2-line);
    border-radius: 16px;
    position: relative;
    background: linear-gradient(155deg, #35e0a10d, transparent 62%), #050d0a;
  }
  .k2-tldr::before,
  .k2-tldr::after {
    content: "";
    position: absolute;
    inline-size: 14px;
    block-size: 14px;
    border: 1px solid var(--k2-emerald);
  }
  .k2-tldr::before { inset-block-start: -1px; inset-inline-start: -1px; border-width: 1px 1px 0 0; }
  .k2-tldr::after { inset-block-end: -1px; inset-inline-end: -1px; border-width: 0 0 1px 1px; }
  .k2-tldr h2 { font-size: clamp(20px, 2vw, 24px); margin-block: 0 12px; color: #fff; }
  .k2-tldr ul { margin: 0; padding-inline-start: 20px; display: grid; gap: 9px; }
  .k2-tldr li { font-size: 15.5px; }

  .k2-def {
    margin-block: 24px 0;
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    padding: 18px 0;
    border-block: 1px solid var(--k2-line);
  }
  .k2-def h2 {
    font-size: 12.5px;
    color: var(--k2-emerald);
    margin: 4px 0 0;
    letter-spacing: 0.02em;
  }
  .k2-def p { margin: 0; font-size: 16.5px; color: #e3ece8; max-inline-size: 76ch; }

  .k2-layout {
    display: grid;
    grid-template-columns: 206px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 58px);
    align-items: start;
    margin-block-start: 30px;
  }
  .k2-toc {
    position: sticky;
    inset-block-start: 18px;
    padding: 16px 0;
    border-block-start: 1px solid var(--k2-line);
  }
  .k2-toc-label {
    margin: 0 0 12px;
    font-size: 11px;
    color: #779487;
    letter-spacing: 0.04em;
  }
  .k2-toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    counter-reset: toc;
  }
  .k2-toc li { counter-increment: toc; }
  .k2-toc a {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 40px;
    padding: 6px 8px;
    border-radius: 7px;
    font-size: 13px;
    color: #b9c9c2;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .k2-toc a:hover,
  .k2-toc a:focus-visible { background: #08170f; color: #fff; }
  .k2-toc a span {
    color: var(--k2-emerald);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
  }
  .k2-toc-note {
    margin: 14px 0 0;
    font-size: 11px;
    line-height: 1.8;
    color: #70857b;
  }

  .k2-content > section {
    padding-block: clamp(34px, 4.4vw, 54px);
    border-block-end: 1px solid #10231c;
    scroll-margin-block-start: 24px;
  }
  .k2-content > section:first-child { padding-block-start: 0; }
  .k2-content > section:last-child { border-block-end: 0; }
  .k2-sec-head {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-block-end: 16px;
  }
  .k2-sec-num {
    flex: 0 0 auto;
    margin-block-start: 6px;
    font-size: 11px;
    color: var(--k2-emerald);
    border: 1px solid var(--k2-emerald-dim);
    border-radius: 5px;
    padding: 2px 6px;
    font-variant-numeric: tabular-nums;
  }
  .k2-sec-head h2 { margin: 0; }
  .k2-answer {
    font-size: 16.5px;
    color: #e6efeb;
    border-inline-start: 2px solid var(--k2-emerald);
    padding-inline-start: 15px;
    margin-block: 0 18px;
    max-inline-size: 72ch;
  }
  .k2-content p { max-inline-size: 74ch; }
  .k2-fine { font-size: 12px; color: #83968c; line-height: 1.85; margin-block: 14px 0; }

  .k2-flip-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-block: 22px 8px;
  }
  .k2-principle {
    flex: 1 1 260px;
    max-inline-size: 320px;
    border: 1px solid var(--k2-line);
    border-radius: 13px;
    background: linear-gradient(180deg, #07120e, #040a08);
    padding: 8px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s ease;
  }
  .k2-principle:hover { border-color: #245744; }
  .k2-flip-stage {
    position: relative;
    block-size: 196px;
    perspective: 1000px;
  }
  .k2-flip-face {
    position: absolute;
    inset: 0;
    padding: 15px 14px;
    border-radius: 9px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1);
    display: flex;
    flex-direction: column;
    gap: 6px;
    overflow: hidden;
  }
  .k2-front {
    background: #081711;
    border: 1px solid #133126;
    transform: rotateY(0deg);
    justify-content: center;
  }
  .k2-back {
    background: linear-gradient(160deg, #0c241a, #06110d);
    border: 1px solid #256a51;
    transform: rotateY(180deg);
    justify-content: center;
  }
  .k2-principle.is-flipped .k2-front { transform: rotateY(-180deg); }
  .k2-principle.is-flipped .k2-back { transform: rotateY(0deg); }
  .k2-p-no {
    font-size: 10.5px;
    color: var(--k2-emerald);
    font-variant-numeric: tabular-nums;
  }
  .k2-front h3 { color: #fff; font-size: 17px; line-height: 1.5; margin: 0; }
  .k2-front p { margin: 0; font-size: 12.5px; line-height: 1.8; color: #a9bdb4; }
  .k2-p-back-label {
    margin: 0 !important;
    font-size: 10.5px !important;
    color: var(--k2-emerald) !important;
    letter-spacing: 0.03em;
  }
  .k2-back p { margin: 0; font-size: 12.5px; line-height: 1.8; color: #d3e5dc; }
  .k2-back .k2-p-evidence {
    margin-block-start: 4px !important;
    padding-block-start: 6px;
    border-block-start: 1px solid #1d4a3a;
    color: #a9c9ba;
    font-size: 11.5px;
  }
  .k2-p-evidence b { color: var(--k2-emerald-soft); }
  .k2-flip-btn {
    margin-block-start: 7px;
    min-height: 44px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid #1d4a3a;
    border-radius: 8px;
    background: #06130e;
    color: var(--k2-emerald-soft);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .k2-flip-btn:hover { background: #0a2017; border-color: #2a7a5c; }
  .k2-flip-btn span[aria-hidden] { font-size: 14px; }

  .k2-formula {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    gap: 1px;
    background: var(--k2-line);
    border: 1px solid var(--k2-line);
    border-radius: 12px;
    overflow: hidden;
    margin-block: 22px;
  }
  .k2-formula div { padding: 15px; background: #06100c; display: grid; gap: 3px; }
  .k2-formula span { font-size: 10.5px; color: var(--k2-emerald); font-variant-numeric: tabular-nums; }
  .k2-formula b { color: #fff; font-size: 15px; }
  .k2-formula small { color: #97aca2; font-size: 11.5px; line-height: 1.7; }

  .k2-scroll-hint {
    display: none;
    margin: 0 0 6px;
    font-size: 11px;
    color: #8aa197;
  }
  .k2-tablewrap {
    margin-block: 20px;
    max-inline-size: 100%;
    overflow-x: auto;
    border: 1px solid var(--k2-line);
    border-radius: 12px;
  }
  .k2 table {
    inline-size: 100%;
    min-inline-size: 700px;
    border-collapse: collapse;
    font-size: 13.5px;
  }
  .k2 caption {
    text-align: start;
    padding: 12px 15px;
    font-size: 11.5px;
    color: #93a89e;
    border-block-end: 1px solid var(--k2-line);
  }
  .k2 th, .k2 td {
    text-align: start;
    vertical-align: top;
    padding: 12px 14px;
    border-block-end: 1px solid #10231c;
  }
  .k2 thead th { background: #081711; color: #c9f0de; font-size: 12px; }
  .k2 tbody tr:hover { background: #06110d; }
  .k2 td b { color: #fff; }

  /* Radar */
  .k2-radar {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(18px, 3vw, 36px);
    align-items: start;
    margin-block: 22px;
    padding: clamp(16px, 2.5vw, 24px);
    border: 1px solid #1a3d30;
    border-radius: 16px;
    background:
      radial-gradient(80% 70% at 70% 0%, #35e0a10e, transparent 62%),
      #050d0a;
  }
  .k2-radar-figure { position: sticky; inset-block-start: 20px; }
  .k2-radar svg {
    inline-size: 100%;
    block-size: auto;
    max-inline-size: 340px;
    margin-inline: auto;
    display: block;
  }
  .k2-radar-grid circle,
  .k2-radar-grid line {
    fill: none;
    stroke: #1c3b2f;
    stroke-width: 1;
  }
  .k2-radar-grid line { stroke: #163027; }
  .k2-radar-poly {
    fill: #35e0a129;
    stroke: var(--k2-emerald);
    stroke-width: 1.8;
    stroke-linejoin: round;
    transition: points 0.2s linear;
    filter: drop-shadow(0 0 6px #35e0a155);
  }
  .k2-radar-dots circle { fill: var(--k2-emerald); }
  .k2-radar-caption {
    margin: 8px 0 0;
    text-align: center;
    font-size: 10.5px;
    color: #7f958a;
  }
  .k2-slider { margin-block-end: 9px; }
  .k2-slider label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: #cfded7;
    margin-block-end: 2px;
  }
  .k2-slider label span {
    color: var(--k2-emerald);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
  }
  .k2-slider output {
    margin-inline-start: auto;
    font-size: 11.5px;
    color: var(--k2-emerald-soft);
    border: 1px solid #1d4a3a;
    border-radius: 5px;
    padding: 1px 7px;
    font-variant-numeric: tabular-nums;
  }
  .k2-slider input[type="range"] {
    inline-size: 100%;
    block-size: 28px;
    accent-color: var(--k2-emerald);
    background: transparent;
    cursor: pointer;
  }
  .k2-radar-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-block-start: 12px;
    padding-block-start: 12px;
    border-block-start: 1px solid #153128;
  }
  .k2-radar-summary {
    flex: 1 1 220px;
    margin: 0;
    font-size: 12px;
    line-height: 1.75;
    color: #cfe8dc;
  }
  .k2-btn-ghost {
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid #245744;
    border-radius: 8px;
    background: transparent;
    color: var(--k2-emerald-soft);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
  }
  .k2-btn-ghost:hover { background: #092117; }
  .k2-radar-details {
    margin-block-start: 12px;
    font-size: 12px;
    color: #a9bdb4;
  }
  .k2-radar-details summary { cursor: pointer; min-height: 32px; display: flex; align-items: center; }
  .k2-radar-details ul { margin: 8px 0 0; padding-inline-start: 18px; display: grid; gap: 3px; }

  /* Risk tiers */
  .k2-risk {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 10px;
    counter-reset: risk;
  }
  .k2-risk li {
    counter-increment: risk;
    position: relative;
    padding: 18px 18px 16px;
    border: 1px solid var(--k2-line);
    border-radius: 12px;
    background: #050d0a;
    display: grid;
    gap: 5px;
    align-content: start;
  }
  .k2-risk li::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline: 18px;
    block-size: 2px;
    background: var(--k2-emerald);
    opacity: 0.5;
  }
  .k2-risk li[data-risk="limited"]::before { background: #d8c35a; }
  .k2-risk li[data-risk="high"]::before { background: #f0913f; }
  .k2-risk li[data-risk="unacceptable"]::before { background: #f2686f; }
  .k2-risk-label {
    margin: 0 !important;
    font-size: 10.5px;
    color: #83a294;
    letter-spacing: 0.03em;
  }
  .k2-risk h3 { color: #fff; font-size: 17px; margin: 0; }
  .k2-risk p { margin: 0; font-size: 13px; line-height: 1.85; }

  .k2-example {
    margin-block: 20px;
    padding: 20px 22px;
    border: 1px dashed #2a6b53;
    border-radius: 14px;
    background: #06130e;
  }
  .k2-example p { margin: 0 0 10px; font-size: 14.5px; }
  .k2-example p:last-child { margin-block-end: 0; }
  .k2-example-label {
    font-size: 10.5px !important;
    color: var(--k2-emerald) !important;
    letter-spacing: 0.04em;
  }
  .k2-check {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .k2-check li {
    position: relative;
    padding: 10px 14px 10px 14px;
    padding-inline-start: 38px;
    border: 1px solid #10231c;
    border-radius: 9px;
    background: #050c09;
    font-size: 13.5px;
  }
  .k2-check li::before {
    content: "✓";
    position: absolute;
    inset-inline-start: 13px;
    inset-block-start: 11px;
    color: var(--k2-emerald);
    font-size: 12px;
  }
  .k2-check b { color: #fff; }

  .k2-mistakes { margin: 20px 0 0; display: grid; gap: 8px; }
  .k2-mistakes > div {
    padding: 14px 16px;
    border: 1px solid var(--k2-line);
    border-inline-start: 2px solid #2a6b53;
    border-radius: 10px;
    background: #050d0a;
  }
  .k2-mistakes dt { color: #f0d9db; font-size: 14.5px; margin-block-end: 4px; }
  .k2-mistakes dt::before { content: "✕ "; color: #f2686f; font-size: 12px; }
  .k2-mistakes dd { margin: 0; font-size: 13px; }
  .k2-mistakes dd b { color: var(--k2-emerald-soft); }

  .k2-chain {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
    counter-reset: chain;
  }
  .k2-chain li {
    counter-increment: chain;
    position: relative;
    padding: 13px 16px 13px 16px;
    padding-inline-start: 48px;
    border: 1px solid #10231c;
    border-radius: 9px;
    background: #06100c;
    font-size: 13.5px;
  }
  .k2-chain li::before {
    content: counter(chain);
    position: absolute;
    inset-inline-start: 14px;
    inset-block-start: 13px;
    inline-size: 22px;
    block-size: 22px;
    display: grid;
    place-items: center;
    border: 1px solid var(--k2-emerald-dim);
    border-radius: 50%;
    color: var(--k2-emerald);
    font-size: 10.5px;
  }
  .k2-chain b { color: #fff; }

  .k2-faq { display: grid; gap: 8px; }
  .k2-faq article {
    padding: 16px 18px;
    border: 1px solid var(--k2-line);
    border-radius: 11px;
    background: #050d0a;
  }
  .k2-faq h3 { font-size: 16px; color: #fff; margin-block-end: 6px; }
  .k2-faq p { margin: 0; font-size: 14px; max-inline-size: 80ch; }

  .k2-next { padding-block-start: 44px; }
  .k2-next h2 { font-size: clamp(22px, 2.4vw, 28px); }
  .k2-next-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 10px;
  }
  .k2-next-grid a {
    display: grid;
    gap: 5px;
    padding: 16px;
    border: 1px solid var(--k2-line);
    border-radius: 12px;
    background: #050d0a;
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .k2-next-grid a:hover { border-color: #2a6b53; transform: translateY(-2px); }
  .k2-next-grid span { font-size: 10.5px; color: var(--k2-emerald); }
  .k2-next-grid b { color: #fff; font-size: 15px; line-height: 1.6; }
  .k2-next-grid small { color: #98aca2; font-size: 12px; line-height: 1.7; }
  .k2-site-link {
    margin-block: 14px 0;
    font-size: 13px;
    color: #a7bab1;
  }

  .k2-refs { margin-block: 40px 0; padding-block-start: 24px; border-block-start: 1px solid var(--k2-line); }
  .k2-refs h2 { font-size: 20px; }
  .k2-refs ul { margin: 0; padding-inline-start: 20px; display: grid; gap: 9px; font-size: 13px; }
  .k2-cta {
    margin-block: 30px 0;
    padding: 18px 20px;
    border: 1px solid #1a3d30;
    border-radius: 12px;
    background: #050d0a;
    font-size: 14px;
    max-inline-size: none;
  }

  @media (max-width: 980px) {
    .k2-layout { grid-template-columns: minmax(0, 1fr); }
    .k2-toc {
      position: static;
      padding-block: 0 10px;
      border-block-end: 1px solid var(--k2-line);
      border-block-start: 0;
    }
    .k2-toc ol {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding-block-end: 6px;
      scrollbar-width: thin;
    }
    .k2-toc a {
      white-space: nowrap;
      border: 1px solid var(--k2-line);
      min-height: 44px;
    }
    .k2-toc-note { display: none; }
    .k2-radar { grid-template-columns: minmax(0, 1fr); }
    .k2-radar-figure { position: static; }
  }
  @media (max-width: 640px) {
    .k2-scroll-hint { display: block; }
    .k2-def { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .k2-flip-stage { block-size: 210px; }
    .k2 h1 { max-inline-size: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .k2-flip-face { transition: none; }
    .k2-radar-poly { transition: none; }
    .k2-next-grid a,
    .k2-flip-btn,
    .k2-toc a { transition: none; }
    .k2-next-grid a:hover { transform: none; }
  }

  @media print {
    .k2-toc, .k2-flip-btn, .k2-radar-controls, .k2-cta { display: none; }
    .k2, .k2 * { color: #000 !important; background: #fff !important; box-shadow: none !important; }
    .k2-flip-stage { block-size: auto; perspective: none; }
    .k2-flip-face {
      position: static;
      transform: none !important;
      backface-visibility: visible;
      border: 1px solid #000;
      margin-block-end: 4px;
      break-inside: avoid;
    }
    .k2-content > section { break-inside: avoid; }
    .k2 a { text-decoration: underline; }
  }
</style>

<script>
  const flipCards = document.querySelectorAll<HTMLElement>('[data-flip]');
  flipCards.forEach((card) => {
    const button = card.querySelector<HTMLButtonElement>('.k2-flip-btn');
    const front = card.querySelector<HTMLElement>('.k2-front');
    const back = card.querySelector<HTMLElement>('.k2-back');
    const label = button?.querySelector<HTMLElement>('[data-flip-label]');
    if (!button || !front || !back) return;
    const name = card.querySelector('h3')?.textContent?.trim() ?? '';
    button.addEventListener('click', () => {
      const open = card.classList.toggle('is-flipped');
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? `ارجع لمبدأ ${name}` : `اعرض الضابط العملي لمبدأ ${name}`);
      back.setAttribute('aria-hidden', String(!open));
      front.setAttribute('aria-hidden', String(open));
      if (label) label.textContent = open ? 'ارجع للمبدأ' : 'اعرض الضابط';
    });
  });

  const radar = document.querySelector<HTMLElement>('[data-radar]');
  if (radar) {
    const inputs = Array.from(radar.querySelectorAll<HTMLInputElement>('[data-radar-input]'));
    const outputs = Array.from(radar.querySelectorAll<HTMLOutputElement>('[data-out]'));
    const polygon = radar.querySelector<SVGPolygonElement>('[data-radar-poly]');
    const dots = Array.from(radar.querySelectorAll<SVGCircleElement>('[data-radar-dot]'));
    const summary = radar.querySelector<HTMLElement>('[data-radar-summary]');
    const valuesList = radar.querySelector<HTMLElement>('[data-radar-values]');
    const reset = radar.querySelector<HTMLButtonElement>('[data-radar-reset]');
    const cx = 160;
    const cy = 160;
    const radius = 112;
    const angle = (index: number) => ((-90 + (index * 360) / 7) * Math.PI) / 180;

    const paint = () => {
      const values = inputs.map((input) => Number(input.value));
      const points = values.map((value, index) => {
        const r = (radius * value) / 5;
        return `${(cx + Math.cos(angle(index)) * r).toFixed(1)},${(cy + Math.sin(angle(index)) * r).toFixed(1)}`;
      });
      polygon?.setAttribute('points', points.join(' '));
      dots.forEach((dot, index) => {
        if (index >= values.length) return;
        const r = (radius * values[index]) / 5;
        dot.setAttribute('cx', (cx + Math.cos(angle(index)) * r).toFixed(1));
        dot.setAttribute('cy', (cy + Math.sin(angle(index)) * r).toFixed(1));
      });
      outputs.forEach((output, index) => {
        if (output) output.textContent = String(values[index]);
      });
      if (valuesList) {
        valuesList.innerHTML = values
          .map((value, index) => `<li>${inputs[index].dataset.name ?? ''}: ${value}</li>`)
          .join('');
      }
      if (summary) {
        let weakest = 0;
        values.forEach((value, index) => {
          if (value < values[weakest]) weakest = index;
        });
        const name = inputs[weakest]?.dataset.name ?? '';
        summary.textContent = values[weakest] >= 5
          ? 'كل الضوابط عندك بخمس درجات. راجعها كل فترة، ولا تفترض أن الثبات يستمر مع تغيّر الأداة أو البيانات.'
          : `أضعف ضابط عندك الآن: ${name} (${values[weakest]} من 5). ابدأ منه قبل أي توسع.`;
      }
    };

    inputs.forEach((input) => {
      input.addEventListener('input', paint);
    });
    reset?.addEventListener('click', () => {
      inputs.forEach((input) => { input.value = '3'; });
      paint();
      inputs[0]?.focus();
    });
    paint();
  }
</script>
