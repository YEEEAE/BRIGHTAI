---
import PageShell from '../components/PageShell.astro';
export const prerender = true;
---
<PageShell title="طلب تجربة مؤسسية | BRIGHTAI" description="استفسر عن تجربة مؤسسية أو تقييم جاهزية الذكاء الاصطناعي." crumbs={[{ name: 'طلب تجربة مؤسسية' }]} robots="noindex, follow">
  <h1>طلب تجربة مؤسسية</h1>
  <p class="lead">صف الهدف الذي تريد اختباره، وراسل الفريق عبر البريد أو واتساب لمراجعة النطاق. يمكنك الاستفسار بدون حساب.</p>
  <p><a class="button" id="enterprise-contact" href="/contact/?access=production#contact">جهّز طلب التواصل</a></p>
  <section class="block">
    <h2>تقييم جاهزية الذكاء الاصطناعي</h2>
    <p>نراجع حالة استخدام واحدة مع فريقك، ونحدد متطلبات البيانات والحوكمة والتشغيل. التسليم المقترح تقرير مكتوب بالفجوات ذات الأولوية وخطوات المعالجة، مع جلسة لمراجعة النتائج. يحدد مالك العرض السعر وموعد التسليم في عرض مكتوب بعد مراجعة النطاق.</p>
    <p>إذا رغبت في مشاركة نتيجة من المختبر، اختر ملخصًا ببيانات اصطناعية وراجعه وأضفه بنفسك إلى رسالة التواصل.</p>
    <a href="/demo/governance/">افتح مختبر الحوكمة</a>
  </section>
  <section class="block">
    <h2>تجربة الحساب المحدودة</h2>
    <p>تظهر تجربة الـ48 ساعة عند إتاحة بوابة الحساب. تبدأ المدة عند التفعيل داخل مساحة عمل اصطناعية للقراءة فقط، وتنتهي بدون دفع تلقائي.</p>
    <p id="trial-option" hidden><a id="trial-account" href="/auth/sign-up/?trial=48h">تابع إلى تجربة 48 ساعة</a></p>
  </section>
</PageShell>
<script>
  import { accessTrack, trialAccountPath } from '../shared/access-journey.mjs';
  import { productForSlug } from '../shared/product-navigation.mjs';

  const query = new URLSearchParams(location.search);
  const product = productForSlug(query.get('product'));
  const contact = document.querySelector<HTMLAnchorElement>('#enterprise-contact')!;
  const contactQuery = new URLSearchParams({ access: query.has('track') ? accessTrack(query.get('track')) : 'production' });
  if (product) contactQuery.set('product', product.slug);
  contact.href = `/contact/?${contactQuery}#contact`;

  async function showTrialWhenReady() {
    try {
      const response = await fetch('/readyz/', { cache: 'no-store', redirect: 'error' });
      if (!response.ok || !response.headers.get('content-type')?.includes('application/json')) return;
      const report = await response.json();
      if (report.status !== 'ready' || report.dependencies?.portal !== 'ENABLED') return;
      document.querySelector<HTMLAnchorElement>('#trial-account')!.href = trialAccountPath(product?.slug);
      document.querySelector<HTMLElement>('#trial-option')!.hidden = false;
    } catch {
      // The public page also runs on static hosting without readiness or auth routes.
    }
  }

  void showTrialWhenReady();
</script>
