  <!-- Lightweight IntersectionObserver reveal (no GSAP) + keyboard shortcut overlay -->
  <script>
    /* ── Journey Theater ── */
    const journeyScenes = [
      { title: 'كتابة الطلب', narrative: 'يكتب المستخدم طلبه للنموذج — شيء يبدو عادي على السطح.', scenarioPii: 'يطلب تصدير بيانات عملاء مرفقة برقم الهوية والسجل التجاري.', scenarioInjection: 'يُرفق أمر system يطلب من النموذج تجاوز الضوابط وإرجاع بيانات داخلية.', scenarioMedical: 'يسأل عن تلخيص سجلات مرضى كاملة يشمل التشخيص والعلاج.', scenarioIbanc: 'يطلب تحويل مبلغ عبر IBAN سعودي مع تفاصيل الحساب والبيانات الشخصية.' },
      { title: 'اشتعال الـ Firewall', narrative: 'جدار الحماية يُشعل نفسه ويفحص الطلب أثناء مروره.', scenarioPii: 'يرصد 1,847 كيان هوية + جوال + بريد مدمجة في الطلب.', scenarioInjection: 'يكشف حزمة payload ضارة مخبّأة في حقل السياق.', scenarioMedical: 'يصنّف البيانات كصحية حساسة تحت مظلة SFDA ويعلّمها.', scenarioIbanc: 'يكتشف رقم IBAN + بيانات بنكية في الجسم — علامة خطر مباشرة.' },
      { title: 'صعود المخاطر لـ 87', narrative: 'نقاط المخاطر تتسلق من 0 إلى 87 — فوق عتبة الحظر في الصف.', scenarioPii: 'تتسارع بسبب كثرة PII — هوية + جوال + بريد معاً.', scenarioInjection: 'الـ payload الخبيث يرفع المخاطر تلقائياً لأنه محاولة تجاوز.', scenarioMedical: 'البيانات الطبية تحمل وزناً عالياً بموجب SFDA — الخطر 87.', scenarioIbanc: 'التحويل المالي غير المصرّح يُصنَّف كخطر مالي حرِج.' },
      { title: 'مطابقة السياسة', narrative: 'Kernel يقارن الطلب بالسياسات الـ11 الفعّالة.', scenarioPii: 'سياسة حماية الهوية والجوال تمنع التصدير — الإجراء: حظر.', scenarioInjection: 'سياسة أمن النموذج تمنع أي طلب يحتوي أوامر نظام — الإجراء: حظر.', scenarioMedical: 'سياسة SFDA تمنع إرسال بيانات طبية للنموذج — الإجراء: حظر.', scenarioIbanc: 'سياسة حماية IBAN تمنع إرسال أرقام حساسة — الإجراء: تعمية.' },
      { title: 'حقن قيد السجل', narrative: 'كل شيء يُسجَّل في سلسلة الهاش غير القابلة للتعديل.', scenarioPii: 'يُسجَّل: 1,847 كيان PII محجوب — الهاش يتشكّل.', scenarioInjection: 'يُسجَّل: payload خبيث مُكتشف — الهاش يتشكّل.', scenarioMedical: 'يُسجَّل: بيانات طبية محظورة — الهاش يتشكّل.', scenarioIbanc: 'يُسجَّل: رقم IBAN معمّى — الهاش يتشكّل.' },
      { title: 'هبوط الطلب في الموافقات', narrative: 'الطلب يهبط في طابور الموافقات البشرية — بانتظار قرار.', scenarioPii: 'يحتاج موافقة مدير حماية البيانات قبل أي إجراء.', scenarioInjection: 'يحتاج مراجعة أمنية من فريق الاستجابة للحوادث.', scenarioMedical: 'يحتاج موافقة مسؤول الامتثال الطبي.', scenarioIbanc: 'يحتاج موافقة فريق مكافحة غسل الأموال.' },
      { title: 'توليد ملف الدليل', narrative: 'النظام يولّد ملف دليل كامل — كل شيء موثّق وجاهز للتدقيق.', scenarioPii: 'دليل PDF يعرض: ماذا حُظر، لماذا، وأي سياسات تدخّلت.', scenarioInjection: 'دليل PDF يعرض: الهجوم الذي كُشف، السياسة التي أوقفته، والنتيجة.', scenarioMedical: 'دليل PDF يعرض: سبب الحظر (SFDA)، البيانات التي تمت معالجتها، الأثر المتوقع.', scenarioIbanc: 'دليل PDF يعرض: البيانات المعمّاة، سبب التعمية، والأثر المُقدَّر بالريال.' }
    ];

    const scenarioLabels = { pii: 'PII', injection: 'حقن أوامر', medical: 'تصدير طبي', ibanc: 'SA-IBAN' };

    let journeyActive = false;
    let journeyTimer = null;
    let currentScene = 0;
    let currentScenario = 'pii';
    let journeyStartTime = 0;
    let journeyPaused = false;
    let journeyPausedAt = 0;
    let journeyPausedElapsed = 0;
    const TOTAL_SCENES = 7;
    const SCENE_DURATION = 13000; // ~13 seconds per scene, 7 scenes × 13 = 91 ≈ 90 seconds

    const journeyEl = document.getElementById('kernel-journey');
    const journeyTrigger = document.getElementById('kernel-journey-trigger');
    const stageEl = document.getElementById('kernel-journey-stage');
    const narrativeEl = document.getElementById('kernel-journey-narrative');
    const dotsEl = document.getElementById('kernel-journey-dots');
    const stopBtn = document.getElementById('kernel-journey-stop');
    const pauseBtn = document.getElementById('kernel-journey-pause');
    const skipBtn = document.getElementById('kernel-journey-skip');
    const replayBtn = document.getElementById('kernel-journey-replay');
    const pills = document.querySelectorAll('.kernel-journey__pill');

    function getReducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function renderDots() {
      dotsEl.innerHTML = '';
      for (let i = 0; i < TOTAL_SCENES; i++) {
        const dot = document.createElement('button');
        dot.className = 'kernel-journey__dot' + (i === currentScene ? ' kernel-journey__dot--active' : '');
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', 'مشهد ' + (i + 1) + ': ' + journeyScenes[i].title);
        dot.setAttribute('aria-selected', String(i === currentScene));
        dot.addEventListener('click', () => { currentScene = i; renderScene(); });
        dotsEl.appendChild(dot);
      }
    }

    function renderScene() {
      const scene = journeyScenes[currentScene];
      const scenarioText = scenarioTextForScene(scene);
      /* Cross-fade transition + slight slide (skipped under reduced motion) */
      stageEl.style.opacity = '0';
      stageEl.style.transform = getReducedMotion() ? 'none' : 'translateY(8px)';
      setTimeout(() => {
        stageEl.innerHTML = '<div class="kernel-journey__scene-title">' + (currentScene + 1) + '. ' + scene.title + '</div><div class="kernel-journey__scene-body">' + scenarioText + '</div>';
        stageEl.style.opacity = '1';
        stageEl.style.transform = 'none';
      }, 400);
      updateNarrative();
      renderDots();
      /* Update progress */
      const progress = ((currentScene + 1) / TOTAL_SCENES) * 100;
      journeyEl.style.setProperty('--journey-progress', progress + '%');
    }

    /* لوحة سردية: سطر لكل مشهد، النشط يُضاء والبقية text-low (تصميم §1) */
    function renderNarrative() {
      narrativeEl.innerHTML = '';
      for (let i = 0; i < TOTAL_SCENES; i++) {
        const line = document.createElement('p');
        line.className = 'kernel-journey__narrative-line';
        narrativeEl.appendChild(line);
      }
    }

    function updateNarrative() {
      const lines = narrativeEl.querySelectorAll('.kernel-journey__narrative-line');
      lines.forEach((line, i) => {
        const isReached = i <= currentScene;
        const isActive = i === currentScene;
        line.textContent = isReached ? journeyScenes[i].narrative : '';
        line.classList.toggle('kernel-journey__narrative-line--past', isReached && !isActive);
        line.classList.toggle('kernel-journey__narrative-line--active', isActive);
      });
    }

    function scenarioTextForScene(scene) {
      const key = currentScenario;
      if (key === 'pii') return scene.scenarioPii;
      if (key === 'injection') return scene.scenarioInjection;
      if (key === 'medical') return scene.scenarioMedical;
      if (key === 'ibanc') return scene.scenarioIbanc;
      return scene.scenarioPii;
    }

    function startJourney() {
      if (journeyActive) return;
      journeyActive = true;
      currentScene = 0;
      currentScenario = 'pii';
      journeyPaused = false;
      journeyPausedAt = 0;
      journeyPausedElapsed = 0;
      journeyStartTime = Date.now();
      setPauseBtnState(false);
      journeyEl.hidden = false;
      journeyEl.scrollIntoView({ behavior: getReducedMotion() ? 'auto' : 'smooth', block: 'center' });
      renderNarrative();
      renderScene();
      scheduleNextScene();
    }

    function scheduleNextScene() {
      if (!journeyActive || journeyPaused) return;
      journeyTimer = setTimeout(() => {
        if (!journeyActive) return;
        if (currentScene < TOTAL_SCENES - 1) {
          currentScene++;
          renderScene();
          scheduleNextScene();
        } else {
          /* Journey complete */
          journeyActive = false;
        }
      }, SCENE_DURATION);
    }

    function stopJourney() {
      journeyActive = false;
      journeyPaused = false;
      journeyPausedAt = 0;
      setPauseBtnState(false);
      clearTimeout(journeyTimer);
    }

    function skipScene() {
      if (!journeyActive) return;
      clearTimeout(journeyTimer);
      if (currentScene < TOTAL_SCENES - 1) {
        currentScene++;
        renderScene();
        scheduleNextScene();
      }
    }

    function replayJourney() {
      clearTimeout(journeyTimer);
      journeyActive = false;
      currentScene = 0;
      journeyPaused = false;
      journeyPausedAt = 0;
      journeyPausedElapsed = 0;
      journeyStartTime = Date.now();
      setPauseBtnState(false);
      journeyEl.hidden = false;
      journeyEl.scrollIntoView({ behavior: 'auto', block: 'center' });
      renderNarrative();
      renderScene();
      startJourney();
    }

    function switchScenario(scenario) {
      currentScenario = scenario;
      pills.forEach((pill) => {
        const isActive = pill.dataset.scenario === scenario;
        pill.classList.toggle('kernel-journey__pill--active', isActive);
        pill.setAttribute('aria-pressed', String(isActive));
      });
      if (journeyActive) renderScene();
    }

    /* Journey trigger */
    if (journeyTrigger) {
      journeyTrigger.addEventListener('click', () => {
        if (journeyEl.hidden) {
          startJourney();
        } else {
          journeyEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    }

    /* Pause / resume */
    function setPauseBtnState(paused) {
      if (!pauseBtn) return;
      pauseBtn.setAttribute('aria-pressed', String(paused));
      pauseBtn.textContent = paused ? 'استئناف' : 'إيقاف مؤقت';
    }

    function togglePause() {
      if (!journeyActive) return;
      if (journeyPaused) {
        journeyPaused = false;
        journeyPausedElapsed += Date.now() - journeyPausedAt;
        journeyPausedAt = 0;
        setPauseBtnState(false);
        scheduleNextScene();
      } else {
        journeyPaused = true;
        journeyPausedAt = Date.now();
        clearTimeout(journeyTimer);
        setPauseBtnState(true);
      }
    }

    /* Controls */
    if (stopBtn) stopBtn.addEventListener('click', stopJourney);
    if (pauseBtn) pauseBtn.addEventListener('click', togglePause);
    if (skipBtn) skipBtn.addEventListener('click', skipScene);
    if (replayBtn) replayBtn.addEventListener('click', replayJourney);

    /* Scenario pills */
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        switchScenario(pill.dataset.scenario);
      });
    });

    /* Keyboard: Escape to close journey */
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && journeyEl && !journeyEl.hidden) {
        stopJourney();
      }
    });

    /* ── Live Counter ── */
    let counterPII = 1247;
    let counterRisk = 8400000;
    let counterRequests = 3842;
    let counterBlocked = 29;

    function animateCounter(element, target, duration) {
      if (!element) return;
      const start = parseInt(element.textContent.replace(/,/g, ''), 10) || 0;
      const diff = target - start;
      if (diff === 0) return;
      const startTime = performance.now();
      function update(now) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = Math.round(start + diff * eased);
        element.textContent = current.toLocaleString('en-US');
        if (progress < 1) requestAnimationFrame(update);
      }
      requestAnimationFrame(update);
    }

    function updateCounters() {
      counterPII += Math.floor(Math.random() * 3) + 1;
      counterRisk += Math.floor(Math.random() * 5000) + 200;
      counterRequests += Math.floor(Math.random() * 5) + 1;
      counterBlocked += Math.random() > 0.7 ? 1 : 0;
      const piiEl = document.getElementById('kernel-counter-pii');
      const riskEl = document.getElementById('kernel-counter-risk');
      if (piiEl) piiEl.textContent = counterPII.toLocaleString('en-US');
      if (riskEl) riskEl.textContent = counterRisk.toLocaleString('en-US');
      const kpiPii = document.getElementById('kpi-pii-masked');
      const kpiRisk = document.getElementById('kpi-risk-avoided');
      const kpiReq = document.getElementById('kpi-requests-today');
      const kpiBlock = document.getElementById('kpi-blocked');
      if (kpiPii) kpiPii.textContent = counterPII.toLocaleString('en-US');
      if (kpiRisk) kpiRisk.textContent = counterRisk.toLocaleString('en-US');
      if (kpiReq) kpiReq.textContent = counterRequests.toLocaleString('en-US');
      if (kpiBlock) kpiBlock.textContent = counterBlocked.toLocaleString('en-US');
    }

    /* ── Init ── */
    document.addEventListener('astro:page-load', () => {
      /* Counter initial render */
      const piiEl = document.getElementById('kernel-counter-pii');
      const riskEl = document.getElementById('kernel-counter-risk');
      if (piiEl) piiEl.textContent = counterPII.toLocaleString('en-US');
      if (riskEl) riskEl.textContent = counterRisk.toLocaleString('en-US');
      /* Start counter interval */
      setInterval(updateCounters, 4000);
      /* Reduced motion: make journey manual */
      if (getReducedMotion() && journeyEl) {
        journeyEl.removeAttribute('hidden');
        journeyEl.style.position = 'relative';
      }
      initModeShell();
    });

    /* ── KRN-DASH-001: Mode-aware shell (first-visit / returning-operator) ── */
    /* يقرا data-kernel-mode (ضُبط قبل paint بالـ inline script) ويبديل اللوحة.
       - first: يعرض [data-hero-first] + onboarding sections
       - returning: يعرض [data-hero-returning] + يخفي onboarding
       زر "اختر دورك" يعمل scroll للـ role selector + يفعّلها.
       السكربت idempotent — re-run آمن على astro:page-load. */
    function initModeShell() {
      const mode = document.documentElement.getAttribute('data-kernel-mode') || 'first';
      const heroFirst = document.querySelector('[data-hero-first]');
      const heroReturning = document.querySelector('[data-hero-returning]');
      const onboardingOnly = document.querySelectorAll('[data-kernel-onboarding-only]');

      function applyMode(m) {
        const isReturning = m === 'returning';
        if (heroFirst) heroFirst.hidden = isReturning;
        if (heroReturning) heroReturning.hidden = !isReturning;
        onboardingOnly.forEach(function (el) {
          el.classList.toggle('kernel-onboarding--hidden', isReturning);
        });
      }

      applyMode(mode);

      /* زر "اختر دورك" → scroll للـ role selector + سيجنال أن المستخدم بدأ */
      const pickRoleBtn = document.getElementById('kernel-pick-role');
      if (pickRoleBtn && !pickRoleBtn.dataset.bound) {
        pickRoleBtn.dataset.bound = '1';
        pickRoleBtn.addEventListener('click', function () {
          const roleSelector = document.querySelector('[data-kernel-role-selector]');
          if (roleSelector) {
            roleSelector.scrollIntoView({ behavior: getReducedMotion() ? 'auto' : 'smooth', block: 'center' });
            /* ومّض خفيف للفت الانتباه */
            roleSelector.classList.add('kernel-onboarding--pulse');
            setTimeout(function () { roleSelector.classList.remove('kernel-onboarding--pulse'); }, 1600);
          }
        });
      }

      /* استمع لاختيار الدور → علّم المستخدم onboarded + بدّل للوحة التشغيل */
      document.removeEventListener('kernel:role-change', handleRoleChange);
      document.addEventListener('kernel:role-change', handleRoleChange);
    }

    function handleRoleChange() {
      try { localStorage.setItem('kernel-onboarded', 'done'); } catch (e) {}
      document.documentElement.setAttribute('data-kernel-mode', 'returning');
      /* أعد تطبيق اللوحة فورًا */
      const heroFirst = document.querySelector('[data-hero-first]');
      const heroReturning = document.querySelector('[data-hero-returning]');
      const onboardingOnly = document.querySelectorAll('[data-kernel-onboarding-only]');
      if (heroFirst) heroFirst.hidden = true;
      if (heroReturning) heroReturning.hidden = false;
      onboardingOnly.forEach(function (el) { el.classList.add('kernel-onboarding--hidden'); });
    }
  </script>

