---
/**
 * /kernel/ — Index page (REPORTS-14: dashboard showcase)
 *
 * Anatomy:
 * 1. Breadcrumb + page header (title + subtitle + actions)
 * 2. Status strip (provider/db/mode)
 * 3. KPI metric grid (4 cards)
 * 4. Dashboard grid:
 *    - Approvals pending widget
 *    - Compliance status widget (risk chart)
 *    - Recent traces widget (full width)
 * 5. Unit cards (existing) + cross-links
 *
 * Uses the canonical shell components:
 * - KernelStatusStrip · KernelMetricCard · KernelCard
 * - KernelRiskChart · KernelActivityList · KernelActivityItem
 * - KernelDemoPill · KernelEmptyState · KernelSkeleton
 *
 * All Arabic text is preserved from the published content (titles,
 * descriptions, schema, breadcrumbs, CTAs). Only visual implementation changed.
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelStatusStrip from '../../components/kernel/KernelStatusStrip.astro';
import KernelMetricCard from '../../components/kernel/KernelMetricCard.astro';
import KernelCard from '../../components/kernel/KernelCard.astro';
import KernelRiskChart from '../../components/kernel/KernelRiskChart.astro';
import KernelActivityList from '../../components/kernel/KernelActivityList.astro';
import KernelActivityItem from '../../components/kernel/KernelActivityItem.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import KernelLeadForm from '../../components/kernel/KernelLeadForm.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelRoleSelector from '../../components/kernel/KernelRoleSelector.astro';
import KernelRecommendedJourney from '../../components/kernel/KernelRecommendedJourney.astro';
import KernelProductTour from '../../components/kernel/KernelProductTour.astro';
import DOMPurify from 'isomorphic-dompurify';
import { kernelUnits, kernelNavItems, getCrossLinks, getKernelUnit, getKernelFaqJsonLd } from '../../data/kernel';
import { KERNEL_PRODUCT, getFaqLd } from '../../data/schema-helpers';

const unit = getKernelUnit('index')!;

/**
 * BAI-SEO-003-S3 (2026-07-18): kernel/index.astro used to emit its own
 * Organization, WebSite, WebPage, BreadcrumbList, and Riyadh LocalBusiness
 * — but the foundation Schema.astro (mounted by BaseLayout) already emits
 * the canonical versions of every one of those nodes. The duplicates were
 * a soft-spam signal and a source of drift (two different Organization
 * descriptions, two different sameAs lists, two different BreadcrumbLists).
 *
 * The page now only adds page-specific nodes:
 *   - KERNEL_PRODUCT  (SoftwareApplication — the kernel product entity)
 *   - page-level FAQPage (only when there are ≥5 visible Q/A)
 * Each city-local LocalBusiness is intentionally NOT emitted on /kernel/
 * — Schema.org guidance puts LocalBusiness on the *city's own page*, not
 * on a product showcase. The 6 city pages (/solutions/<sector>/<city>/)
 * already carry their own LocalBusiness nodes.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      ...KERNEL_PRODUCT,
      description: 'نواة حوكمة الذكاء الاصطناعي للمنشآت السعودية — تدعم جاهزية الامتثال ولا تُعدّ استشارة قانونية. تشمل AI Firewall وسجل تدقيق غير قابل للتعديل وموافقات بشرية وملفات أدلة وحزم امتثال للوائح السعودية.',
    },
    getFaqLd(unit.faq),
  ].filter(Boolean),
};

// Icons (inline SVGs, no extra deps)
const iconApprovals = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
const iconShield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>';
const iconChat = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>';
const iconWarning = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
const iconActivity = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>';
const iconClock = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
const iconLock = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>';
const iconCheck = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
const iconArrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
const iconPii = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>';

// Risk distribution (compliance frameworks)
const complianceRows = [
  { label: 'PDPL', level: 'minimal' as const, value: 92 },
  { label: 'NCA ECC', level: 'low' as const, value: 87 },
  { label: 'ISO 42001', level: 'low' as const, value: 81 },
  { label: 'SDAIA', level: 'medium' as const, value: 73 },
  { label: 'SFDA', level: 'high' as const, value: 64 },
];
---

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath="/kernel/"
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }]}
  extraSpeakableSelectors={['.kernel-page-header__subtitle', 'aside[data-snippet="tl-dr"]']}
>

  {/* KRN-DASH-001 (2026-08-09): Pre-paint mode detection — يمنع FOUC.
      يقرا localStorage('kernel-onboarded') + ('brightai-kernel-role') ويضبط
      body[data-kernel-mode] قبل ما يرسم المتصفح الـ hero. السكربت تافه (~15 سطر)
      ومتزامن. أي signal (دور محفوظ / تخطّي صريح / جولة مكتملة) = وضع العائد. */}
  <script is:inline>
    (function () {
      try {
        var onboarded = localStorage.getItem('kernel-onboarded') === 'done';
        var hasRole = !!localStorage.getItem('brightai-kernel-role');
        var mode = (onboarded || hasRole) ? 'returning' : 'first';
        document.documentElement.setAttribute('data-kernel-mode', mode);
      } catch (e) {
        /* private mode — default to first (safe) */
        document.documentElement.setAttribute('data-kernel-mode', 'first');
      }
    })();
  </script>

  <!-- Page header -->
  <header class="kernel-page-header kernel-hero">
    {/* خلفية شبكية خافتة متحركة ببطء — تصميم-صفحات-kernel §1 (فوق الطية) */}
    <div class="kernel-hero__grid-bg" aria-hidden="true"></div>
    <div class="kernel-page-header__lead kernel-hero__inner">
      <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
        <ol>
          <li><a href="/">BrightAI</a></li>
          <li aria-current="page">Kernel · لوحة الحوكمة</li>
        </ol>
      </nav>
      {/* حبة الحالة: Demo · Live — توضيح مصدر البيانات فوق الطية */}
      <div class="kernel-hero__mode" role="status" aria-live="polite">
        <span class="kernel-hero__mode-pill kernel-hero__mode-pill--demo">
          <span class="kernel-hero__mode-dot" aria-hidden="true"></span>
          Mode: Demo
        </span>
        <span class="kernel-hero__mode-pill kernel-hero__mode-pill--live">
          <span class="kernel-hero__mode-dot kernel-hero__mode-dot--live" aria-hidden="true"></span>
          Live
        </span>
      </div>
      <h1 class="kernel-page-header__title kernel-hero__title">{unit.h1}</h1>
      <p class="kernel-page-header__subtitle kernel-hero__subtitle">
        نظرة تشغيلية سريعة على طلبات الذكاء الاصطناعي، الموافقات المعلقة، توزيع المخاطر، وحالة النظام.
      </p>
      {/* BAI-SEO-003-S7 (2026-07-18): P0 snippet pack — TL;DR / الخلاصة.
         Answer-first, self-contained, ≤60 words. Single source of truth:
         src/data/snippet-pack.ts. */}
      <aside data-snippet="tl-dr" aria-label="الخلاصة" class="answer-first-summary">
        <p>نواة برايت أيه آي هي نظام تشغيل حوكمة الذكاء الاصطناعي يركّب تحت أي نموذج داخل المنشأة. تشمل جدار حماية للذكاء الاصطناعي وسجل تدقيق غير قابل للتعديل وموافقات بشرية للقرارات عالية الأثر وملفات أدلة قابلة للمراجعة. تدعم المنشآت السعودية في تطبيق ضوابط حماية البيانات والأمن السيبراني وإرشادات سدايا. أداة تشغيلية لا تعد استشارة قانونية.</p>
      </aside>

      {/* KRN-DASH-001 (2026-08-09): Mode-aware hero — attention over showcase.
         وضعان متنافيان، واحد فقط يظهر فوق الطية حسب حالة الزائر.
         - data-hero-first: الزائر الجديد → CTA أساسي وحيد (جولة 90ث) + فعل تالي (اختر دورك).
         - data-hero-returning: العائد → CTA أساسي وحيد (الموافقات المعلقة) + 4 quick actions.
         الحالة تُقرأ من localStorage('kernel-onboarded') قبل paint (no FOUC).
         HTML الكامل موجود دايمًا (progressive enhancement — crawlers يشوفون الاثنين). */}
      <div class="kernel-hero-actions">
        {/* ── وضع أول زيارة ── */}
        <div class="kernel-hero__mode-panel kernel-hero__mode-panel--first" data-hero-first>
          <div class="kernel-hero__cta-row">
            <button class="kernel-hero__journey-btn kernel-hero__primary-cta" id="kernel-journey-trigger" aria-label="شغّل جولة حادثة 90 ثانية">
              <span class="kernel-hero__journey-btn-icon" aria-hidden="true">▶</span>
              شغّل حادثة · 90 ثانية
            </button>
            <button class="kernel-hero__secondary-cta" id="kernel-pick-role" aria-label="اختر دورك لتبدأ">
              اختر دورك وابدأ ←
            </button>
          </div>
          <p class="kernel-hero__next-hint">
            <span class="kernel-hero__next-label">الخطوة التالية:</span>
            <span>اختر دورك (CISO · امتثال · مطوّر · موظف) ونرتّب لك الوحدات.</span>
          </p>
        </div>

        {/* ── وضع العائد للتشغيل ── */}
        <div class="kernel-hero__mode-panel kernel-hero__mode-panel--returning" data-hero-returning hidden>
          <a class="kernel-hero__journey-btn kernel-hero__primary-cta" href="/kernel/approvals/" aria-label="راجع 7 موافقات معلقة — 3 حرجة">
            <span class="kernel-hero__journey-btn-icon" aria-hidden="true">⚠</span>
            راجع 7 موافقات معلقة · 3 حرجة ←
          </a>
          <nav class="kernel-hero__quick-actions" aria-label="إجراءات سريعة للتشغيل">
            <a class="kernel-hero__quick-action" href="/kernel/approvals/" aria-label="الموافقات — 7 طلبات">
              <span class="kernel-hero__qa-label">الموافقات</span>
              <span class="kernel-hero__qa-value kernel-hero__qa-value--warn">7</span>
              <span class="kernel-hero__qa-hint">طلبات</span>
            </a>
            <a class="kernel-hero__quick-action" href="/kernel/audit/?risk=high" aria-label="مخاطر عالية — 5 طلبات">
              <span class="kernel-hero__qa-label">مخاطر عالية</span>
              <span class="kernel-hero__qa-value kernel-hero__qa-value--danger">5</span>
              <span class="kernel-hero__qa-hint">طلبات</span>
            </a>
            <a class="kernel-hero__quick-action" href="/kernel/audit/?status=unresolved" aria-label="غير محلولة — 3 حوادث">
              <span class="kernel-hero__qa-label">غير محلولة</span>
              <span class="kernel-hero__qa-value kernel-hero__qa-value--danger">3</span>
              <span class="kernel-hero__qa-hint">حوادث</span>
            </a>
            <a class="kernel-hero__quick-action" href="/kernel/audit/" aria-label="آخر حادثة — قبل 3 دقائق">
              <span class="kernel-hero__qa-label">آخر حادثة</span>
              <span class="kernel-hero__qa-value kernel-hero__qa-value--time">3د</span>
              <span class="kernel-hero__qa-hint">قبل</span>
            </a>
          </nav>
        </div>

        {/* Counter (shared، يظهر في كلا الوضعين) */}
        <div class="kernel-hero__counter" aria-live="polite" aria-atomic="true">
          <span class="kernel-hero__counter-label">ما مُنع اليوم</span>
          <span class="kernel-hero__counter-value" id="kernel-counter-pii">0</span>
          <span class="kernel-hero__counter-unit">سجل PII محجوب</span>
          <span class="kernel-hero__counter-value" id="kernel-counter-risk">0</span>
          <span class="kernel-hero__counter-unit">ريال متفادى</span>
        </div>
      </div>
    </div>
  </header>

  <div class="kernel-main kernel-page-fade-in">
    {/* K1 (2026-07-18): Stage 1 — Onboarding.
       لوحة الحوكمة المعروضة أدناه (Status strip + KPI grid + Dashboard + Units)
       تبقى كما هي. نضيف بطاقة رحلة Kernel فوقها كـ "بوابة" للزائر الجديد
       تربطه بالمراحل الخمس. البيانات أدناه كلها تجريبية (KernelDemoPill). */}

    {/* KRN-DASH-001: onboarding wrapper — يتخفى في وضع العائد (data-kernel-onboarding-only).
       الـ HTML يبقى للـ crawlers؛ CSS يخفيه بصريًا فقط. */}
    <section class="kernel-onboarding" data-kernel-onboarding-only aria-labelledby="kernel-onboarding-title">
      <h2 id="kernel-onboarding-title" class="k-section-title kernel-onboarding__title">رحلة Kernel — 5 مراحل</h2>
      <p class="k-section-intro kernel-onboarding__lead">
        Kernel أداة تشغيلية لحوكمة الذكاء الاصطناعي في المنشآت السعودية. لا تدّعي امتثالاً قانونياً كاملاً، لكنها تساعدك على الجاهزية للوائح (PDPL، NCA ECC، SDAIA، SFDA، SAMA). ابدأ بأي مرحلة تناسب مهمتك.
      </p>
      <ol class="kernel-onboarding__steps" role="list">
        <li class="kernel-onboarding__step">
          <span class="kernel-onboarding__num" aria-hidden="true">1</span>
          <div class="kernel-onboarding__body">
            <h3 class="kernel-onboarding__h3">تعرّف على Kernel</h3>
            <p class="kernel-onboarding__p">وش هو، كيف يحمي منشأتك، وماذا تعني الأرقام في اللوحة.</p>
            <a class="kernel-onboarding__link" href="#kernel-onboarding-more" aria-label="المزيد عن Kernel">المزيد عن Kernel</a>
          </div>
        </li>
        <li class="kernel-onboarding__step">
          <span class="kernel-onboarding__num" aria-hidden="true">2</span>
          <div class="kernel-onboarding__body">
            <h3 class="kernel-onboarding__h3">اختر سيناريو سعودي</h3>
            <p class="kernel-onboarding__p">12 سيناريو واقعي يغطي بنوك، صحة، حكومي، قانوني، HR، وأمن الكود.</p>
            <a class="kernel-onboarding__link" href="/kernel/scenarios/" data-scenario-link data-scenario-id="" data-sector="" data-risk-band="" data-journey-stage="scenario">تصفح السيناريوهات ←</a>
          </div>
        </li>
        <li class="kernel-onboarding__step">
          <span class="kernel-onboarding__num" aria-hidden="true">3</span>
          <div class="kernel-onboarding__body">
            <h3 class="kernel-onboarding__h3">شغّل المحادثة الآمنة</h3>
            <p class="kernel-onboarding__p">محادثة بضوابط حوكمة كاملة: كشف PII، تقييم مخاطر، تطبيق سياسات.</p>
            <a class="kernel-onboarding__link" href="/kernel/chat/">فتح المحادثة ←</a>
          </div>
        </li>
        <li class="kernel-onboarding__step">
          <span class="kernel-onboarding__num" aria-hidden="true">4</span>
          <div class="kernel-onboarding__body">
            <h3 class="kernel-onboarding__h3">افهم السياسات والأدلة</h3>
            <p class="kernel-onboarding__p">كيف فسّر Kernel القرار: السياسات، الأدلة، السجل، والامتثال.</p>
            <a class="kernel-onboarding__link" href="/kernel/policies/">السياسات والأدلة ←</a>
          </div>
        </li>
        <li class="kernel-onboarding__step">
          <span class="kernel-onboarding__num" aria-hidden="true">5</span>
          <div class="kernel-onboarding__body">
            <h3 class="kernel-onboarding__h3">تواصل مع الحوكمة</h3>
            <p class="kernel-onboarding__p">احجز عرضاً مفصّلاً. الـ CTA يحمل القطاع والمخاطر — بدون PII.</p>
            <a class="kernel-onboarding__link" href="#kernel-lead-form-index">احجز عرضاً مفصّلاً ←</a>
          </div>
        </li>
      </ol>
      <p class="kernel-onboarding__disclaimer" id="kernel-onboarding-more">
        <strong>تنبيه تشغيلي:</strong> البيانات الظاهرة في هذه اللوحة تجريبية (محددة بوسم «بيانات تجريبية» في الأعلى). المكوّنات لا تستهلك بيانات حقيقية إلا بعد ربط Kernel بمنشأتك. لا يستخدم هذا الموقع لأغراض قانونية أو استشارية — للمراجعة القانونية المتخصصة تواصل مع مستشار مرخّص.
      </p>
    </section>

    {/* Product Tour — first-visit guided tour (max 7 steps, skippable, RTL, mobile-friendly) */}
    <div data-kernel-onboarding-only>
      <KernelProductTour />

      {/* P1 (2026-08-04): Role-Based Personalized Journey — اختياري،
         يظهر للزائر الجديد عشان يختار دوره ويشوف رحلة موصى بها. */}
      <KernelRoleSelector />
      <KernelRecommendedJourney />
    </div>

    <!-- Journey Theater (hidden by default, toggled by JS) -->
    <section class="kernel-journey" id="kernel-journey" aria-label="جولة حادثة" hidden>
      <div class="kernel-journey__platform">
        <div class="kernel-journey__stage" id="kernel-journey-stage">
          <!-- Scene content rendered by JS -->
        </div>
        <aside class="kernel-journey__narrative" id="kernel-journey-narrative" aria-live="polite">
          <!-- Narrative lines rendered by JS -->
        </aside>
      </div>

      <!-- Progress dots + controls -->
      <div class="kernel-journey__controls">
        <div class="kernel-journey__dots" id="kernel-journey-dots" role="tablist" aria-label="مشاهد الجولة">
          <!-- 7 dots rendered by JS -->
        </div>
        <div class="kernel-journey__actions">
          <button class="kernel-journey__btn" id="kernel-journey-stop" aria-label="إيقاف الجولة">إيقاف</button>
          <button class="kernel-journey__btn" id="kernel-journey-pause" aria-label="إيقاف مؤقت للجولة" aria-pressed="false">إيقاف مؤقت</button>
          <button class="kernel-journey__btn" id="kernel-journey-skip" aria-label="تخطي المشهد الحالي">تخطي</button>
          <button class="kernel-journey__btn" id="kernel-journey-replay" aria-label="إعادة تشغيل الجولة">إعادة</button>
        </div>
        <div class="kernel-journey__scenarios" aria-label="مبدّل السيناريو">
          <button class="kernel-journey__pill kernel-journey__pill--active" data-scenario="pii" aria-pressed="true">PII</button>
          <button class="kernel-journey__pill" data-scenario="injection" aria-pressed="false">حقن أوامر</button>
          <button class="kernel-journey__pill" data-scenario="medical" aria-pressed="false">تصدير طبي</button>
          <button class="kernel-journey__pill" data-scenario="ibanc" aria-pressed="false">SA-IBAN</button>
        </div>
      </div>
    </section>

    <!-- Status strip — توافق مع topbar: الوضع Demo (بيانات تجريبية) -->
    <KernelStatusStrip
      kicker="Kernel Provider"
      title="NVIDIA · Connected"
      dot="ok"
      items={[
        { label: 'قاعدة البيانات', value: 'Connected' },
        { label: 'الوضع', value: 'Demo' },
        { label: 'آخر تحديث', value: 'قبل 12 ثانية' },
      ]}
    />

    <!-- KPI grid -->
    <section class="kernel-metric-section" aria-label="المؤشرات الرئيسية">
      {/* KRN-P1 (2026-08-04): honesty badge — كل KPI أدناه بيانات تجريبية */}
      <div class="kernel-metric-section__bar">
        <KernelDemoPill />
      </div>
      <div class="kernel-metric-grid kernel-stagger">
        <KernelMetricCard
          label="إجمالي الطلبات"
          value="12,483"
          unit="طلب"
          variant="brand"
          trend="up"
          trendLabel="8%"
          iconSvg={iconActivity}
          footer="آخر 24 ساعة"
          demo
        />
        <KernelMetricCard
          label="بانتظار الموافقة"
          value="7"
