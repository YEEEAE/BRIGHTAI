---
/**
 * /kernel/ — Index page (REPORTS-14: dashboard showcase)
 *
 * Anatomy:
 * 1. Breadcrumb + page header (title + subtitle + actions)
 * 2. Status strip (provider/db/mode)
 * 3. KPI metric grid (4 cards)
 * 4. Dashboard grid:
 *    - Approvals pending widget
 *    - Compliance status widget (risk chart)
 *    - Recent traces widget (full width)
 * 5. Unit cards (existing) + cross-links
 *
 * Uses the canonical shell components:
 * - KernelStatusStrip · KernelMetricCard · KernelCard
 * - KernelRiskChart · KernelActivityList · KernelActivityItem
 * - KernelDemoPill · KernelEmptyState · KernelSkeleton
 *
 * All Arabic text is preserved from the published content (titles,
 * descriptions, schema, breadcrumbs, CTAs). Only visual implementation changed.
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelStatusStrip from '../../components/kernel/KernelStatusStrip.astro';
import KernelMetricCard from '../../components/kernel/KernelMetricCard.astro';
import KernelCard from '../../components/kernel/KernelCard.astro';
import KernelRiskChart from '../../components/kernel/KernelRiskChart.astro';
import KernelActivityList from '../../components/kernel/KernelActivityList.astro';
import KernelActivityItem from '../../components/kernel/KernelActivityItem.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import KernelLeadForm from '../../components/kernel/KernelLeadForm.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import { kernelNavItems, getCrossLinks, getKernelUnit, getKernelFaqJsonLd } from '../../data/kernel';
import { LOCAL_BUSINESS_BY_CITY, getBreadcrumbLd, getFaqLd } from '../../data/schema-helpers';

const unit = getKernelUnit('index')!;

const jsonLd = {
