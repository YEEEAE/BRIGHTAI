---
/**
 * /kernel/[slug]/ — Dynamic route for all 10 kernel sub-pages.
 * Uses shared V2 components: KernelPageHeader, KernelSeoSection, KernelContextLinks.
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelPageHeader from '../../components/kernel/KernelPageHeader.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import ActivityStream from '../../components/ActivityStream.astro';
import EvidenceFileMockup from '../../components/EvidenceFileMockup.astro';
import ComplianceRadar from '../../components/ComplianceRadar.astro';
import {
  kernelNavItems,
  getCrossLinks,
  type KernelUnit,
} from '../../data/kernel';
import { migratedKernelPages } from '../../data/migratedKernelPages';
// KRN-012 / EXEC-12: sanitize migrated HTML
import DOMPurify from 'isomorphic-dompurify';
// BAI-SCHEMA-05: Service schema for /kernel/* pages
import { getServiceLd } from '../../data/schema-helpers';

export function getStaticPaths() {
  return kernelNavItems.map(unit => ({
    params: { slug: unit.slug },
    props: { unit },
  }));
}

interface Props { unit: KernelUnit }
const { unit } = Astro.props;
const migratedPage = migratedKernelPages[unit.slug];
const cross = getCrossLinks(unit);
const relatedSlugs = unit.relatedSlugs ?? [];

// BAI-SCHEMA-05: build Service node for kernel unit
const serviceLd = getServiceLd({
  canonical: unit.canonical,
  name: unit.h1,
  description: unit.description,
  serviceType: unit.label,
  areaServed: 'Saudi Arabia',
  offers: {
    url: 'https://brightai.site/contact/',
    description: 'تواصل عبر /contact/ للحصول على عرض توضيحي مخصص لمنشأتك',
  },
});

// Merge with migrated JSON-LD if present (migrated pages may already have schema)
const finalJsonLd = migratedPage?.jsonLd ?? null;
const mergedJsonLd = (() => {
  if (!finalJsonLd) return serviceLd;

  if (Array.isArray(finalJsonLd)) {
    return { '@context': 'https://schema.org', '@graph': [...finalJsonLd, serviceLd] };
  }

  if ((finalJsonLd as Record<string, unknown>)['@graph']) {
    return {
      ...(finalJsonLd as Record<string, unknown>),
      '@graph': [
        ...((finalJsonLd as Record<string, unknown>)['@graph'] as Array<Record<string, unknown>>),
        serviceLd,
      ],
    };
  }

  return { '@context': 'https://schema.org', '@graph': [finalJsonLd, serviceLd] };
})();

/**
 * BAI-SEO-003-S3 (2026-07-18): the kernel sub-page used to emit its own
 * Organization, BreadcrumbList, and a per-page `SoftwareApplication` node
 * with `@id: ...kernel/<slug>/#product` — but those are all duplicates of
 * foundation nodes that Schema.astro (mounted via BaseLayout → KernelLayout)
 * already emits. The product entity is the same Kernel product across all
 * sub-pages; its @id is `https://brightai.site/#product` (one entity, many
 * pages describing it).
 *
 * Page-level extra schema is now empty for non-migrated sub-pages
 * (FoundationSchema handles Organization, WebSite, WebPage, BreadcrumbList).
 * For migrated sub-pages, we surface the migrated JSON-LD untouched
 * (REPORT-23 additive contract is preserved) — the FoundationSchema and
 * the migrated @graph are merged into a single @graph at layout level.
 *
 * AggregateRating is removed from the fallback product node for the same
 * reason as KERNEL_PRODUCT in schema-helpers.ts: no source-backed reviews.
 */

const isAudit = unit.slug === 'audit';
const isEvidence = unit.slug === 'evidence';
const isCompliance = unit.slug === 'compliance';
---

<style>
  /*
   * Mobile-first + RTL baseline for Slug (kernel championship).
   * Injected by kernel-mobile-baseline.mjs. Logical properties (RTL-safe), ≥44px touch
   * targets, responsive breakpoints, and empty/loading state styles.
   * Uses design tokens. No published text or layout overrides.
   */
  .kernel-slug__empty-state,
  .kernel-slug-empty-state {
    padding-inline: var(--space-6);
    margin-inline: auto;
    text-align: start;
    color: var(--text-muted);
    border-inline-start: 3px solid var(--interactive-primary);
  }
  .kernel-slug__skeleton,
  .kernel-slug-skeleton {
    inset-inline-start: 0;
    background: var(--bg-elevated);
    animation: kernel-slug-shimmer 1.4s var(--ease-in-out) infinite;
  }
  @keyframes kernel-slug-shimmer {
    0% { opacity: 1; }
    50% { opacity: 0.45; }
    100% { opacity: 1; }
  }
  /* Touch targets ≥44px — accessibility on small screens */
  .kernel-slug [data-kernel-touch],
  .kernel-slug__touch {
    min-height: 44px;
    min-width: 44px;
  }
  /* Mobile-first: single column on mobile, enhance at ≥768px */
  .kernel-slug__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .kernel-slug__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }
  @media (max-width: 640px) {
    .kernel-slug [data-kernel-touch] { min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kernel-slug-skeleton { animation: none; }
  }
</style>

<KernelLayout
  title={migratedPage?.title ?? unit.title}
  description={migratedPage?.description ?? unit.description}
  canonical={migratedPage?.canonical ?? unit.canonical}
  hreflang={migratedPage?.hreflang ?? unit.hreflang}
  jsonLd={mergedJsonLd as any}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: unit.label, href: unit.path }]}
  extraSpeakableSelectors={['.answer-first-summary', '.k-page__disclaimer']}
>

  <div class="k-page">
    <!-- Breadcrumb -->
    <nav aria-label="التنقل التفصيلي">
      <ol class="k-breadcrumb">
        <li><a href="/">الرئيسية</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/kernel/">Kernel</a></li>
        <li aria-hidden="true">/</li>
        <li class="k-breadcrumb__current">{unit.label}</li>
      </ol>
    </nav>

    <!-- Page heading + description using shared KernelPageHeader -->
    <KernelPageHeader
      h1={unit.h1}
      description={unit.shortDescription}
    />

    {migratedPage ? (
      <>
        {!migratedPage.html.includes('<h1') && <h1>{unit.h1}</h1>}
        <div class="migrated-kernel-content" set:html={DOMPurify.sanitize(migratedPage.html)} />

        <!-- SEO content from migrated page typically includes its own sections -->
      </>
    ) : (
    <>
      <!-- Build seo items from content if available -->
      {false && <p>القسم الأساسي</p>}

      <!-- Page-specific interactive components -->
      {isAudit && (
        <div class="k-page__component">
          <h2>سجل الأنشطة الأخيرة</h2>
          <ActivityStream />
        </div>
      )}

      {isEvidence && (
        <div class="k-page__component">
          <h2>سجل الأدلة</h2>
          <EvidenceFileMockup />
        </div>
      )}

      {isCompliance && (
        <div class="k-page__component">
          <h2>حالة الامتثال</h2>
          <ComplianceRadar />
        </div>
      )}
    </>
    )}

    <!-- Demo disclaimer (for non-migrated pages only) -->
    {!migratedPage && (
    <div class="k-page__disclaimer">
      ℹ️ هذه الصفحة توضيحية تعرّف إمكانات وحدة {unit.label} في BrightAI Kernel. الأرقام والبيانات المعروضة هي بيانات توضيحية (demo) ولا تمثل بيانات حقيقية.
    </div>
    )}

    <!-- Cross-links using shared KernelContextLinks -->
    <KernelContextLinks
      currentPath={unit.path}
      solutionPath={cross.solutionPath ?? ''}
      solutionLabel="الحل المقابل"
      docPath={cross.docPath ?? ''}
      relatedSlugs={relatedSlugs}
    />

    <!-- CTA -->
    <a href="/contact/" class="k-page__cta">
      ابدأ تطبيق الحوكمة في منشأتك
    </a>
  </div>
</KernelLayout>

</write_to_file>