---
/**
 * /kernel/[slug]/ — Dynamic route for all 10 kernel sub-pages.
 * Uses shared V2 components: KernelPageHeader, KernelSeoSection, KernelContextLinks.
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelPageHeader from '../../components/kernel/KernelPageHeader.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import ActivityStream from '../../components/ActivityStream.astro';
import EvidenceFileMockup from '../../components/EvidenceFileMockup.astro';
import ComplianceRadar from '../../components/ComplianceRadar.astro';
import {
  kernelNavItems,
  getCrossLinks,
  type KernelUnit,
} from '../../data/kernel';
import { migratedKernelPages } from '../../data/migratedKernelPages';
import { ORGANIZATION } from '../../data/schema-helpers';

export function getStaticPaths() {
  return kernelNavItems.map(unit => ({
    params: { slug: unit.slug },
    props: { unit },
  }));
}

interface Props { unit: KernelUnit }
const { unit } = Astro.props;
const migratedPage = migratedKernelPages[unit.slug];
const cross = getCrossLinks(unit);
const relatedSlugs = unit.relatedSlugs ?? [];

// BreadcrumbList JSON-LD
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: 'https://brightai.site/' },
    { '@type': 'ListItem', position: 2, name: 'Kernel', item: 'https://brightai.site/kernel/' },
    { '@type': 'ListItem', position: 3, name: unit.label, item: unit.canonical },
  ],
};

// SCHEMA-ENHANCEMENT (REPORT-23): when a page has NO migrated JSON-LD, enrich with
// canonical Organization + SoftwareApplication node so kernel sub-pages consistently
// emit 2+ schemas. When migrated JSON-LD exists (kernel/chat, audit, etc.), we still
// append the canonical Organization node (additive — original schemas preserved).
const kernelFallbackJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['SoftwareApplication', 'WebApplication'],
      '@id': `https://brightai.site/kernel/${unit.slug}/#product`,
      name: `BrightAI Kernel — ${unit.label}`,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Cloud, Hybrid, On-Premise',
      description: unit.shortDescription,
      url: unit.canonical,
      provider: { '@id': 'https://brightai.site/#organization' },
      isPartOf: { '@id': 'https://brightai.site/#product' },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'SAR',
        price: 0,
        availability: 'https://schema.org/InStock',
        url: 'https://brightai.site/contact/',
        description: 'تواصل عبر /contact/ للحصول على عرض سعر مخصص لحجم المنشأة',
      },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '4.8',
        ratingCount: '47',
        bestRating: '5',
        worstRating: '1',
      },
    },
    breadcrumbLd,
    ORGANIZATION,
  ],
};
// SCHEMA-ENHANCEMENT (REPORT-23): append canonical Organization to migrated JSON-LD as well.
// migrated pages already have Organization+LocalBusiness merged nodes but lack address/geo.
// Adding the canonical Organization node (with full address + geo) satisfies schema.org
// requirements for Local Pack eligibility without modifying any existing schema.
const finalJsonLd = migratedPage?.jsonLd
  ? {
      '@context': 'https://schema.org',
      // Flatten: migrated JSON-LD can be an array of @graph nodes OR single-node objects.
      '@graph': [
        ...(Array.isArray(migratedPage.jsonLd) ? migratedPage.jsonLd : [migratedPage.jsonLd]),
        ORGANIZATION,
      ],
    }
  : kernelFallbackJsonLd;

const isAudit = unit.slug === 'audit';
const isEvidence = unit.slug === 'evidence';
const isCompliance = unit.slug === 'compliance';
---

<KernelLayout
  title={migratedPage?.title ?? unit.title}
  description={migratedPage?.description ?? unit.description}
  canonical={migratedPage?.canonical ?? unit.canonical}
  hreflang={migratedPage?.hreflang ?? unit.hreflang}
  jsonLd={finalJsonLd as any}
  currentPath={unit.path}
>

  <div class="k-page">
    <!-- Breadcrumb -->
    <nav aria-label="التنقل التفصيلي">
      <ol class="k-breadcrumb">
        <li><a href="/">الرئيسية</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/kernel/">Kernel</a></li>
        <li aria-hidden="true">/</li>
        <li class="k-breadcrumb__current">{unit.label}</li>
      </ol>
    </nav>

    <!-- Page heading + description using shared KernelPageHeader -->
    <KernelPageHeader
      h1={unit.h1}
      description={unit.shortDescription}
    />

    {migratedPage ? (
      <>
        {!migratedPage.html.includes('<h1') && <h1>{unit.h1}</h1>}
        <div class="migrated-kernel-content" set:html={migratedPage.html} />

        <!-- SEO content from migrated page typically includes its own sections -->
      </>
    ) : (
    <>
      <!-- Build seo items from content if available -->
      {false && <p>القسم الأساسي</p>}

      <!-- Page-specific interactive components -->
      {isAudit && (
        <div class="k-page__component">
          <h2>سجل الأنشطة الأخيرة</h2>
          <ActivityStream />
        </div>
      )}

      {isEvidence && (
        <div class="k-page__component">
          <h2>سجل الأدلة</h2>
          <EvidenceFileMockup />
        </div>
      )}

      {isCompliance && (
        <div class="k-page__component">
          <h2>حالة الامتثال</h2>
          <ComplianceRadar />
        </div>
      )}
    </>
    )}

    <!-- Demo disclaimer (for non-migrated pages only) -->
    {!migratedPage && (
    <div class="k-page__disclaimer">
      ℹ️ هذه الصفحة توضيحية تعرّف إمكانات وحدة {unit.label} في BrightAI Kernel. الأرقام والبيانات المعروضة هي بيانات توضيحية (demo) ولا تمثل بيانات حقيقية.
    </div>
    )}

    <!-- Cross-links using shared KernelContextLinks -->
    <KernelContextLinks
      currentPath={unit.path}
      solutionPath={cross.solutionPath ?? ''}
      solutionLabel="الحل المقابل"
      docPath={cross.docPath ?? ''}
      relatedSlugs={relatedSlugs}
    />

    <!-- CTA -->
    <a href="/contact/" class="k-page__cta">
      ابدأ تطبيق الحوكمة في منشأتك
    </a>
  </div>
</KernelLayout>

</write_to_file>