      var tokens = html.split(/(\s+|<[^>]+>)/).filter(Boolean);
      var idx = 0;
      bubble.textContent = '';
      var interval = setInterval(function () {
        if (idx >= tokens.length) {
          clearInterval(interval);
          if (typeof onDone === 'function') onDone();
          return;
