---
/**
 * /kernel/chat/ — Secure AI chat with governance controls (REPORTS-15).
 *
 * REPORTS-15 update:
 * - Upgraded to 3-pane enterprise dashboard layout.
 * - LEFT: threads list (recent conversations, sticky header with "new" CTA).
 * - CENTER: streaming chat thread with user/AI bubbles, policy banners, typing indicator, compose box.
 *  - RIGHT: live provider status card (reflected from /api/ai/chat metadata) + policy notifications + session meta.
 * - Demo mode handled via KernelDemoPill (existing) + JS-driven fake streaming for "send" UX.
 * - Mobile responsive: panes collapse via CSS @media.
 * - RTL-aware, V3 tokens, design system preserved.
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import { getKernelUnit, getCrossLinks, getKernelFaqJsonLd } from '../../data/kernel';
import { getKernelSubPageJsonLd } from '../../data/schema-helpers';
import KernelContactCta from '../../components/kernel/KernelContactCta.astro';
import KernelLeadForm from '../../components/kernel/KernelLeadForm.astro';
// CHAMPION-06 (2026-07-30): first-visit onboarding tour (compose / threads / context).
// CSP-safe module script; does not touch the chat SSE logic below.
import KernelOnboarding from '../../components/kernel/KernelOnboarding.astro';
import KernelSkeleton from '../../components/kernel/KernelSkeleton.astro';
import KernelEmptyState from '../../components/kernel/KernelEmptyState.astro';
import KernelTabs from '../../components/kernel/KernelTabs.astro';
// K1 (2026-07-18): kernel journey — read scenario from URL.
import {
  getScenarioMeta,
  RISK_BAND_LABELS,
  SECTOR_LABELS,
  type ScenarioMeta,
  type Sector,
  type RiskBand,
} from '../../data/kernel-journey';

const unit = getKernelUnit('chat')!;
const cross = getCrossLinks(unit);

const jsonLd = [
  ...getKernelSubPageJsonLd(unit),
  getKernelFaqJsonLd(unit),
];

// K1 (2026-07-18): detect a pre-selected scenario from ?scenario=... query param.
// The value is an opaque id (e.g. "pdpl-id-leak") — no PII. We use it to:
//  1) show a sticky banner above the composer so the user remembers context;
//  2) pre-fill the textarea with the prompt hint (best-effort);
const activeScenarioId: string | null = Astro.url.searchParams.get('scenario');
const activeScenario: ScenarioMeta | null = activeScenarioId
  ? getScenarioMeta(activeScenarioId)
  : null;
const activeSectorLabel: string | null = activeScenario ? SECTOR_LABELS[activeScenario.sector] : null;
const activeRiskLabel: string | null = activeScenario ? RISK_BAND_LABELS[activeScenario.riskBand] : null;

const iconChat = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>';
const iconMessages = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>';
const iconContext = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
const iconClose = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
const iconPlus = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>';
const iconPaperclip = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>';
const iconSend = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>';
const iconShield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>';
const iconWarning = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
const iconInfo = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';

// Demo seed threads
const threads = [
  { id: 't-1', title: 'تصدير قائمة عملاء (محظور)', preview: '87% PII risk · قبل 3د', selected: true },
  { id: 't-2', title: 'تلخيص سياسة الإجازات', preview: 'مسموح · قبل 18د' },
  { id: 't-3', title: 'تحليل عقد مورد', preview: 'موافق · قبل 1س' },
  { id: 't-4', title: 'تشخيص سجلات طبية', preview: 'ينتظر موافقة · قبل 2س' },
  { id: 't-5', title: 'استعلام لوائح البنك', preview: 'مسموح · قبل 4س' },
  { id: 't-6', title: 'تقرير حوكمة ربع سنوي', preview: 'موافق · أمس' },
];

// Demo seed messages in selected thread (user right RTL / AI left)
// Each message carries governance metadata per M14 spec:
// PII count, risk score, decision, Trace ID, Run ID, masked text,
// safe-phrasing suggestion, and evaluation-case readiness.
const seedMessages: {
  role: 'user' | 'ai';
  text: string;
  meta: string;
  traceId: string;
  runId: string;
  piiCount: number;
  riskScore: number;
  riskBand: 'low' | 'medium' | 'high' | 'critical';
  decision: 'allowed' | 'blocked' | 'pending_approval' | 'masked';
  action: string;
  maskedText?: string;
  suggestedPhrasing?: string;
  whyModified?: string;
  attachments?: { name: string; size: string; safe: boolean; piiDetected: boolean }[];
  evaluationCaseReady?: boolean;
}[] = [
  {
    role: 'user',
    text: 'اعرض لي قائمة آخر 2,400 عميل مع أرقام الهواتف والعناوين — أريد تصديرها إلى ملف Excel لمكتب التسويق.',
    meta: 'قبل 3د · AI-2026-10493',
    traceId: 'AI-2026-10493',
    runId: 'RUN-2026-10493',
    piiCount: 2400,
    riskScore: 87,
    riskBand: 'critical',
    decision: 'blocked',
    action: 'حظر — تجاوز عتبة الـ 70% للمخاطر',
    suggestedPhrasing: 'اعرض لي ملخص إحصائي للعملاء (عددهم وتوزيعهم حسب المنطقة) دون أرقام هواتف أو عناوين — أريد تصدير التقرير إلى Excel.',
    whyModified: 'الطلب الأصلي يطلب أرقام هووات وعناوين (PII حساس) لـ 2,400 عميل. التعمية تستبدل البيانات الشخصية بإحصاءات مجمّعة تحافظ على القيمة التحليلية دون كشف هويات.',
    evaluationCaseReady: true,
  },
  {
    role: 'ai',
    text: 'تمام، قبل ما أجيب الطلب واجهت 3 ضوابط:\n\n• تم كشف 1,847 سجل يحتوي PII (اسم + هاتف + بريد + عنوان) — يخالف المادة 12 من PDPL.\n• درجة المخاطر 87% (حرج) — تجاوزت عتبة الـ 70% المعتمدة.\n• الطلب يحتاج موافقة بشرية قبل أي إجراء.\n\nنماذج BrightAI حظرت الإرسال وأعدت توجيه الطلب إلى فريق الحوكمة.\n\n⚠️ هذا رد تجريبي — المحادثة الحقيقية تتطلب ربط Kernel API.',
    meta: 'قبل 3د · Kernel v3.7 · blocked · تجريبي',
    traceId: 'AI-2026-10493',
    runId: 'RUN-2026-10493',
    piiCount: 1847,
    riskScore: 87,
    riskBand: 'critical',
    decision: 'blocked',
    action: 'حظر — PII مكشوف، مخاطر حرجة',
    maskedText: 'تم كشف [1,847 سجل] يحتوي PII ([هوية] + [جوال] + [بريد] + [عنوان]) — يخالف المادة 12 من PDPL.',
    whyModified: 'النموذج الأصلي كان سيُعيد البيانات الخام للعملاء (أسماء + هواتف + عناوين). التعمية تستبدل كل كيان PII بوسم آمن: [هوية]، [جوال]، [بريد]، [عنوان] — مع الإبقاء على الأرقام المجمّعة (1,847 سجل) والإشارة إلى المادة القانونية.',
    attachments: [
      { name: 'customer_export.xlsx', size: '2.4 MB', safe: false, piiDetected: true },
      { name: 'marketing_report.pdf', size: '180 KB', safe: true, piiDetected: false },
    ],
    evaluationCaseReady: true,
  },
];

// Initial non-blocking warning banner
const policyBanner = {
  tone: 'warning' as 'warning' | 'danger' | 'info',
  title: 'تنبيه Firewall',
  msg: 'الكشف كشف PII في 1,847 سجل — تم تجميد الطلب قبل الإرسال إلى النموذج. راجع <a href="/kernel/audit/">سجل التدقيق</a> للتفاصيل.',
};
---

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: 'المحادثة', href: unit.path }]}
  extraSpeakableSelectors={['.answer-first-summary']}
>
  <header class="kernel-page-header">
    <div class="kernel-page-header__lead">
      <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
        <ol>
          <li><a href="/">BrightAI</a></li>
          <li><a href="/kernel/">Kernel</a></li>
          <li aria-current="page">{unit.label}</li>
        </ol>
      </nav>
      <h1 class="kernel-page-header__title">{unit.h1}</h1>
      {/* BAI-VOC-001-B (2026-07-18): answer-first summary sits between
          the H1 and the subtitle so AI voice / TTS engines can quote it.
          Also the second cssSelector entry for the WebPage
          SpeakableSpecification (kernel pages use KernelLayout → Schema
          via the foundation WebPage node). */}
      <p class="answer-first-summary" data-speakable-target="answer-first">محادثة آمنة بضوابط حوكمة كاملة: كشف PII قبل الإرسال، تقييم مخاطر (0-100)، تطبيق سياسات الشركة، إجبار موافقة بشرية على القرارات عالية المخاطر، وإنشاء سجل تدقيق غير قابل للتعديل. متوافق مع PDPL وNCA ECC.</p>
      <p class="kernel-page-header__subtitle">
        ابدأ محادثة مع الذكاء الاصطناعي تحت ضوابط الحوكمة الكاملة: كشف PII، تقييم المخاطر، تطبيق السياسات، وإنشاء الأدلة تلقائياً.
      </p>
    </div>
    <div class="kernel-page-header__actions">
      <KernelDemoPill />
    </div>
  </header>

  <div class="kernel-main kernel-page-fade-in" data-kernel-loading data-kernel-count={threads.length}>
    <div data-kernel-skeleton class="kernel-loading-skeleton">
      <KernelSkeleton variant="card" count={3} />
      <KernelSkeleton variant="text" count={6} />
    </div>
    <div data-kernel-empty hidden>
      <KernelEmptyState title="ما في محادثات الحين" message="المحادثات تظهر فور توفرها." />
    </div>
    {/* K1 (2026-07-18): scenario context banner.
       Server-rendered with a fallback empty state — the JS in chat.astro
       reads ?scenario=... at runtime and fills in the metadata.
       This works for both SSR (activeScenario truthy when ?scenario= present
       at build time) and static + query-string runtime (JS fills in).
       When no scenario is active, the banner is hidden via [hidden]. */}
    <aside
      class="k-scenario-banner"
      role="region"
      aria-label="سياق السيناريو"
      data-scenario-banner
      data-sector={activeScenario?.sector ?? ''}
      data-risk-band={activeScenario?.riskBand ?? ''}
      data-journey-stage="run"
      data-scenario-id={activeScenario?.id ?? ''}
      hidden={!activeScenario}
    >
      <div class="k-scenario-banner__lead">
        <span class="k-scenario-banner__icon" aria-hidden="true">
          <Fragment set:html={iconShield} />
        </span>
        <div>
          <p class="k-scenario-banner__title" data-banner-title>
            {activeScenario
              ? <Fragment>تشغييل سيناريو: <strong>{activeScenario.title}</strong></Fragment>
              : <Fragment>تشغييل سيناريو: <strong data-banner-title-text>—</strong></Fragment>
            }
          </p>
          <p class="k-scenario-banner__meta" data-banner-meta>
            {activeScenario ? (
              <Fragment>
                القطاع: <strong>{activeSectorLabel}</strong>
                <span aria-hidden="true">·</span>
                المخاطر: <strong>{activeRiskLabel}</strong>
                <span aria-hidden="true">·</span>
                الحزمة: <strong lang="en">{activeScenario.compliancePack.toUpperCase()}</strong>
                <span aria-hidden="true">·</span>
                الإجراء المتوقع: <strong>{activeScenario.expectedAction}</strong>
              </Fragment>
            ) : (
              <Fragment>—</Fragment>
            )}
          </p>
          <p class="k-scenario-banner__hint" data-banner-hint>
            {activeScenario?.promptHint ?? ''}
          </p>
        </div>
      </div>
      <a
        class="k-scenario-banner__cancel"
        href="/kernel/chat/"
        data-clear-scenario
        aria-label="إلغاء السيناريو والعودة لمحادثة فارغة"
      >إلغاء السيناريو</a>
    </aside>

    <script>
      // K1 (2026-07-18): scenario banner runtime upgrade.
      // The Astro static build sees activeScenario=null because query
      // params don't exist at build time. The banner is rendered with
      // empty data + hidden=true at build; this script reads the query
      // string at runtime and shows + fills the banner. The metadata
      // map is a minimal mirror of SCENARIO_META — single source of
      // truth stays in src/data/kernel-journey.ts; this is a browser
      // duplicate for the banner UX only.
      (function () {
        'use strict';
        var MAP = {
          'pdpl-id-leak':            { sector: 'legal',      riskBand: 'critical', title: 'كشف تسريب الهوية الوطنية (PDPL)',                pack: 'PDPL',     action: 'block' },
          'procurement-contract':    { sector: 'government', riskBand: 'minimal',  title: 'مراجعة عقود المشتريات الحكومية',                  pack: 'PROC',     action: 'allow' },
          'sfda-medical-export':     { sector: 'healthcare', riskBand: 'critical', title: 'تصدير السجلات الطبية الحساسة (SFDA)',            pack: 'SFDA',     action: 'block' },
          'nca-prompt-injection':    { sector: 'code',       riskBand: 'high',     title: 'منع Prompt Injection (NCA ECC)',                 pack: 'NCA ECC',  action: 'block' },
          'hr-salary-export':        { sector: 'hr',         riskBand: 'high',     title: 'تصدير بيانات الرواتب (HR)',                       pack: 'PDPL',     action: 'block' },
          'finance-iban-leak':       { sector: 'banking',    riskBand: 'critical', title: 'تسريب أرقام الآيبان البنكية (SAMA)',             pack: 'PDPL',     action: 'block' },
          'code-secret-extract':     { sector: 'code',       riskBand: 'high',     title: 'استخراج أسرار من الكود (NCA)',                   pack: 'NCA ECC',  action: 'block' },
          'healthcare-research':     { sector: 'healthcare', riskBand: 'medium',   title: 'بحث طبي على مرضى مجهولين (SFDA)',                pack: 'SFDA',     action: 'allow_with_review' },
          'legal-contract-summary':  { sector: 'legal',      riskBand: 'minimal',  title: 'تلخيص عقد قانوني (مسموح)',                        pack: 'PROC',     action: 'allow' },
          'hr-cv-screening':         { sector: 'hr',         riskBand: 'medium',   title: 'فحص سير ذاتية مع PII (HR)',                      pack: 'PDPL',     action: 'allow_with_review' },
          'finance-quarterly-report':{ sector: 'banking',    riskBand: 'medium',   title: 'تقرير ربع سنوي بنوك (SAMA)',                     pack: 'PDPL',     action: 'allow_with_review' },
          'code-sql-injection':      { sector: 'code',       riskBand: 'high',     title: 'كشف حقن SQL (NCA)',                              pack: 'NCA ECC',  action: 'block' },
        };
        var SECTOR_LABELS = {
          banking: 'البنوك', government: 'الحكومي', healthcare: 'الرعاية الصحية',
          hr: 'الموارد البشرية', legal: 'القانوني', finance: 'المالية',
          code: 'أمن الكود',
        };
        var RISK_LABELS = {
          minimal: 'منخفض جداً', low: 'منخفض', medium: 'متوسط',
          high: 'عالي', critical: 'حرج',
        };

        function upgrade() {
          var banner = document.querySelector('[data-scenario-banner]') as HTMLElement | null;
          if (!banner) return;
          var params = new URLSearchParams(location.search);
          var id = params.get('scenario');
          if (!id) return;
          var meta = MAP[id as keyof typeof MAP];
          if (!meta) return;
          banner.hidden = false;
          banner.setAttribute('data-sector', meta.sector);
          banner.setAttribute('data-risk-band', meta.riskBand);
          banner.setAttribute('data-scenario-id', id);
          // KERNEL-ANALYTICS-2026-07-18: scenario_selected — non-PII slugs only.
          var rt = window.__BRIGHTAI_ANALYTICS__;
          if (rt && typeof rt.track === 'function') {
            rt.track('scenario_selected', {
              scenario_id: id,
              sector: meta.sector,
              risk_band: meta.riskBand,
              journey_stage: 'run',
            });
          }
          var titleEl = banner.querySelector('[data-banner-title-text]');
          if (titleEl) titleEl.textContent = meta.title;
          var metaEl = banner.querySelector('[data-banner-meta]');
          if (metaEl) {
            metaEl.innerHTML = '' +
              'القطاع: <strong>' + (SECTOR_LABELS[meta.sector as keyof typeof SECTOR_LABELS] || meta.sector) + '</strong>' +
              ' <span aria-hidden="true">·</span> ' +
              'المخاطر: <strong>' + (RISK_LABELS[meta.riskBand as keyof typeof RISK_LABELS] || meta.riskBand) + '</strong>' +
              ' <span aria-hidden="true">·</span> ' +
              'الحزمة: <strong lang="en">' + meta.pack + '</strong>' +
              ' <span aria-hidden="true">·</span> ' +
              'الإجراء المتوقع: <strong>' + meta.action + '</strong>';
          }
        }

        document.addEventListener('astro:page-load', upgrade);
        if (document.readyState !== 'loading') upgrade();
      })();
    </script>

    <!-- CHAMPION-06 (2026-07-30): first-visit tour overlay. Position:fixed;
         self-contained, shows once until finished/skipped (localStorage). -->
    <KernelOnboarding />

    <!-- 3-pane chat layout -->
    <div class="kernel-chat-layout">

      {/*
        PROMPT-2 (2026-08-04): Mobile-first chat redesign.
        - On <768px: 3 tabs (المحادثات | المحادثة | التفاصيل) replace the
          drawers. Each pane carries data-tab-active so CSS shows only the
          active tab's pane. KernelTabs provides the WAI-ARIA tabs pattern
          (roving tabindex + Arrow L/R RTL-inverted + Home/End).
        - On 768-1023px: 2 panes (threads + chat) — context hidden.
        - On ≥1024px: 3-pane layout unchanged.
        - The tabs bar is hidden on ≥768px via .kernel-chat-mobile-tabs.
      */}
      <KernelTabs
        class="kernel-chat-mobile-tabs"
        tabs={[
          { id: 'threads', label: 'المحادثات' },
          { id: 'chat', label: 'المحادثة', selected: true },
          { id: 'context', label: 'التفاصيل' },
        ]}
        ariaLabel="تبويبات المحادثة"
        panelIdBase="kernel-chat-tabpanel"
        tabIdBase="kernel-chat-tab"
      />

      <!-- LEFT — Threads list -->
      <aside
        class="kernel-chat-layout__pane kernel-chat-layout__pane--left"
        aria-label="قائمة المحادثات"
        role="tabpanel"
        id="kernel-chat-tabpanel-threads"
        aria-labelledby="kernel-chat-tab-threads"
      >
        <button type="button" class="kernel-threads-list__new-btn" data-kernel-chat-new>
          <span aria-hidden="true"><Fragment set:html={iconPlus} /></span>
          <span>محادثة جديدة</span>
        </button>
        <ul class="kernel-threads-list" role="list" data-kernel-threads>
          {threads.map(t => (
            <li>
              <button
                type="button"
                class="kernel-threads-list__item"
                aria-current={t.selected ? 'true' : 'false'}
                data-thread-id={t.id}
                data-thread-title={t.title}
              >
                <span class="kernel-threads-list__title">{t.title}</span>
                <span class="kernel-threads-list__meta">{t.preview}</span>
              </button>
            </li>
          ))}
        </ul>
      </aside>

      <!-- CENTER — Chat thread + composer -->
      <section
        class="kernel-chat-layout__pane kernel-chat-layout__pane--center"
        aria-label="محادثة نشطة"
        role="tabpanel"
        id="kernel-chat-tabpanel-chat"
        aria-labelledby="kernel-chat-tab-chat"
        data-tab-active="chat"
      >
        {/*
          KRN-008 / EXEC-08: Mobile toolbar — appears only on <1024px.
          Toggles the threads drawer (الرسائل) and context drawer (السياق)
          which expose the hidden --left and --right panes.
        */}
        <div class="kernel-chat-toolbar" role="toolbar" aria-label="أدوات الدردشة">
          <button
            type="button"
            class="kernel-chat-toolbar__btn"
            data-kernel-chat-threads-toggle
            aria-controls="kernel-chat-drawer-threads"
            aria-expanded="false"
            aria-label="فتح قائمة المحادثات"
          >
            <span aria-hidden="true"><Fragment set:html={iconMessages} /></span>
            <span>الرسائل</span>
          </button>
          <button
            type="button"
            class="kernel-chat-toolbar__btn"
            data-kernel-chat-context-toggle
            aria-controls="kernel-chat-drawer-context"
            aria-expanded="false"
            aria-label="فتح لوحة السياق"
          >
            <span aria-hidden="true"><Fragment set:html={iconContext} /></span>
            <span>السياق</span>
          </button>
        </div>

        <header style="display:flex; align-items:center; justify-content:space-between; gap:var(--space-2); padding-bottom:var(--space-2); border-bottom:1px solid var(--border-subtle);">
          <div>
            <h2 style="font-size:var(--text-base); font-weight:var(--font-bold); color:var(--text-primary); margin:0;" data-kernel-thread-title>تصدير قائمة عملاء (محظور)</h2>
            <p style="font-size:var(--text-xs); color:var(--text-secondary); margin:2px 0 0;">Trace: <span data-kernel-thread-trace>AI-2026-10493</span></p>
          </div>
          <span class="kernel-badge" style="font-size:var(--text-xs);" aria-label="حالة المحادثة">
            <span class="kernel-badge__dot" aria-hidden="true"></span>
            <span>نشطة</span>
          </span>
        </header>

        <!-- Inline policy banner above the first blocked AI message -->
        <div class="kernel-chat-policy-banner kernel-chat-policy-banner--warning" role="alert" data-kernel-policy-banner>
          <span class="kernel-chat-policy-banner__icon" aria-hidden="true"><Fragment set:html={iconWarning} /></span>
          <div class="kernel-chat-policy-banner__body">
            <p class="kernel-chat-policy-banner__title" set:html={policyBanner.title}></p>
            <p class="kernel-chat-policy-banner__msg" set:html={policyBanner.msg}></p>
          </div>
          <button type="button" class="kernel-chat-policy-banner__close" aria-label="إغلاق التنبيه" data-kernel-banner-close>
            <Fragment set:html={iconClose} />
          </button>
        </div>

        <!-- KERNEL-AI-2026-07-14: error banner (يظهر عند فشل API) -->
        <div data-kernel-chat-error-slot style="margin-block:var(--space-2);"></div>

        <!-- KERNEL-AI-2026-07-14: contact CTA يظهر بعد 3 رسائل -->
        <KernelContactCta id="kernel-chat-cta" threshold={3} />

        <!-- Messages -->
        <div class="kernel-chat-thread" data-kernel-chat-thread>
          {/* A11Y-STREAM (2026-07-18): الـ live region السابق كان على
              data-kernel-chat-messages نفسه — وهذا يُعلن كل token أثناء
              البث ويغرق قارئات الشاشة. الحل: نزيل aria-live من حاوية
              الرسائل (نبقي aria-busy للإشارة لعدم الإعلان أثناء الكتابة)
              ونستخدم مُعلِن منفصل sr-only نحدّثه بالرد الكامل فقط بعد
              انتهاء البث — إعلان واحد نظيف لكل رسالة. */}
          <div class="kernel-chat-thread__messages" data-kernel-chat-messages aria-busy="false">
            <div class="sr-only" data-kernel-chat-announcer aria-live="polite" aria-atomic="true"></div>
            {seedMessages.map(m => (
              <article class:list={['kernel-chat-message', m.role === 'user' ? 'kernel-chat-message--user' : 'kernel-chat-message--ai']} data-trace-id={m.traceId} data-run-id={m.runId} data-evaluation-ready={m.evaluationCaseReady ? 'true' : 'false'}>
                <span class="kernel-chat-message__avatar" aria-hidden="true">{m.role === 'user' ? 'ي' : 'AI'}</span>
                <div class="kernel-chat-message__body">
                  <div class="kernel-chat-message__bubble" data-masked-text={m.maskedText ? 'true' : 'false'}>
                    {m.text}
                    {m.maskedText && m.role === 'ai' && (
                      <button type="button" class="kernel-chat-message__mask-toggle" data-kernel-mask-toggle aria-label="عرض النص بعد التعمية" title="عرض النص بعد التعمية">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <span>عرض بعد التعمية</span>
                      </button>
                    )}
                  </div>
                  {m.maskedText && m.role === 'ai' && (
                    <div class="kernel-chat-message__masked-view" hidden>
                      <div class="kernel-chat-message__masked-label">النص بعد التعمية (ما يراه النموذج):</div>
                      <div class="kernel-chat-message__masked-text">{m.maskedText}</div>
                    </div>
                  )}
                  {m.role === 'ai' && m.decision === 'blocked' && m.suggestedPhrasing && (
                    <div class="kernel-chat-suggestion" role="alert">
                      <div class="kernel-chat-suggestion__head">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        <span>طلبك محظور — جرّب هذي الصياغة بدلاً منها</span>
                      </div>
                      <div class="kernel-chat-suggestion__body">
                        <textarea readonly rows="2" aria-label="الصياغة الآمنة المقترحة">{m.suggestedPhrasing}</textarea>
                      </div>
                      <div class="kernel-chat-suggestion__actions">
                        <button type="button" class="kernel-chat-suggestion__btn kernel-chat-suggestion__btn--primary" data-kernel-use-phrasing>استخدم الصياغة</button>
                        <button type="button" class="kernel-chat-suggestion__btn" data-kernel-why-modified>ليش عدّلت؟</button>
                      </div>
                      <div class="kernel-chat-suggestion__reason" hidden>
                        {m.whyModified}
                      </div>
                    </div>
                  )}
                  {m.attachments && m.attachments.length > 0 && (
                    <div class="kernel-chat-attachments">
                      <div class="kernel-chat-attachments__label">المرفقات:</div>
                      {m.attachments.map(att => (
                        <div class:list={['kernel-chat-attachment', att.safe ? 'kernel-chat-attachment--safe' : 'kernel-chat-attachment--unsafe']}>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
                          <span>{att.name}</span>
                          <span class="kernel-chat-attachment__size">{att.size}</span>
                          {att.piiDetected && <span class="kernel-chat-attachment__warn" title="PII مكتشف في هذا الملف">⚠ PII</span>}
                          <span class="kernel-chat-attachment__status">{att.safe ? '✅ آمن' : '❌ محظور'}</span>
                        </div>
                      ))}
                    </div>
                  )}
                  <!-- Governance strip: PII · Risk · Decision · Trace -->
                  <div class="kernel-governance-strip" aria-label="شريط الحوكمة">
                    <span class="kernel-governance-strip__item" title="كيانات PII المكتشفة">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                      PII: {m.piiCount}
                    </span>
                    <span class="kernel-governance-strip__item" title="درجة المخاطر">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                      مخاطر: {m.riskScore}%
                    </span>
                    <span class="kernel-governance-strip__item kernel-governance-strip__item--decision" title="القرار" data-decision={m.decision}>
                      {m.decision === 'blocked' && '⊘ محظور'}
                      {m.decision === 'allowed' && '✓ مسموح'}
                      {m.decision === 'pending_approval' && '⏳ ينتظر موافقة'}
                      {m.decision === 'masked' && '◐ معمّى'}
                    </span>
                    <span class="kernel-governance-strip__item kernel-governance-strip__item--trace" title="Trace ID">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                      {m.traceId}
                    </span>
                  </div>
                  <!-- Message actions: Playground + Evaluation -->
                  <div class="kernel-chat-message__actions">
                    <button type="button" class="kernel-chat-message__action" data-kernel-open-playground title="افتح هذه الرسالة في الملعب" aria-label="افتح هذه الرسالة في الملعب">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                      افتح في الملعب
                    </button>
                    {m.evaluationCaseReady && (
                      <button type="button" class="kernel-chat-message__action" data-kernel-to-evaluation title="حوّل هذا التشغيل إلى حالة تقييم" aria-label="حوّل هذا التشغيل إلى حالة تقييم">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M14.5 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M16 13h-6"/><path d="M16 17h-6"/><path d="M10 9H8"/></svg>
                        تحويل لتقييم
                      </button>
                    )}
                  </div>
                  <span class="kernel-chat-message__meta">{m.meta}</span>
                </div>
              </article>
            ))}
            <!-- Typing indicator (initially hidden, toggled via JS when sending) -->
            <div class="kernel-chat-typing" data-kernel-typing hidden role="status" aria-live="polite">
              <span class="sr-only">النموذج يكتب</span>
              <span class="kernel-chat-typing__dot" aria-hidden="true"></span>
              <span class="kernel-chat-typing__dot" aria-hidden="true"></span>
              <span class="kernel-chat-typing__dot" aria-hidden="true"></span>
            </div>
          </div>

          <!-- Compose box -->
          <form
            class="kernel-chat-composer"
            data-kernel-chat-form
            aria-label="حقل كتابة الرسالة"
            data-prevent-default
          >
            <label for="kernel-chat-input" class="visually-hidden" style="position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;">رسالة جديدة</label>
            <textarea
              id="kernel-chat-input"
              class="kernel-chat-composer__textarea"
              placeholder="اكتب سؤالك هنا — كل رسالة تمر عبر فلتر PII، تقييم المخاطر، وفحص السياسات قبل إرسالها للنموذج…"
              rows="2"
              data-kernel-chat-input
              data-scenario-id={activeScenario?.id ?? ''}
              data-scenario-prompt-hint={activeScenario?.promptHint ?? ''}
              aria-describedby="kernel-chat-hint"
            ></textarea>
            <div class="kernel-chat-composer__row">
              <span class="kernel-chat-composer__hint" id="kernel-chat-hint">
                <kbd>Enter</kbd> للإرسال · <kbd>Shift+Enter</kbd> لسطر جديد · <kbd>C</kbd> لمحادثة جديدة · <kbd>Esc</kbd> لإغلاق التنبيه
              </span>
              <div class="kernel-chat-composer__actions">
                <button type="button" class="kernel-chat-composer__btn" aria-label="إرفاق ملف" data-kernel-chat-attach>
                  <span aria-hidden="true"><Fragment set:html={iconPaperclip} /></span>
                  <span>إرفاق</span>
                </button>
                <button type="submit" class="kernel-chat-composer__btn kernel-chat-composer__btn--primary" data-kernel-chat-send aria-label="إرسال">
                  <span aria-hidden="true"><Fragment set:html={iconSend} /></span>
                  <span>إرسال</span>
                </button>
              </div>
            </div>
            <div class="input-attachments" data-kernel-attachments-slot></div>
          </form>
        </div>
      </section>

      <!-- RIGHT — Context panel (live provider status + policy feed + session meta) -->
      <aside
        class="kernel-chat-layout__pane kernel-chat-layout__pane--right"
        aria-label="لوحة السياق"
        role="tabpanel"
        id="kernel-chat-tabpanel-context"
        aria-labelledby="kernel-chat-tab-context"
      >
        <!-- Live provider card (K2 2026-07-18): name reflects the actual
             provider returned by /api/ai/chat metadata — never hard-coded.
             Starts as "—" until the first live reply; shows a DEMO badge
             while a seed/demo reply is displayed, and a DEGRADED badge when
             the session store fell back to in-memory storage. -->
        <section class="kernel-chat-context-card" aria-labelledby="ctx-provider-title" data-provider-card>
          <header class="kernel-chat-context-card__head">
            <span class="kernel-chat-context-card__logo" aria-hidden="true" data-provider-logo>B</span>
            <div class="kernel-chat-context-card__title-block">
              <h3 class="kernel-chat-context-card__title" id="ctx-provider-title">
                مزود النموذج: <span data-provider-badge>—</span>
              </h3>
              <p class="kernel-chat-context-card__sub">يُعرض من استجابة الخادم</p>
            </div>
            <span class="kernel-chat-context-card__tag" data-demo-badge hidden>تجريبي</span>
            <span class="kernel-chat-context-card__tag kernel-chat-context-card__tag--warn" data-degraded-badge hidden>سياق غير محفوظ</span>
          </header>
          <dl>
            <div class="kernel-chat-context-card__field">
              <dt class="kernel-chat-context-card__label">الحالة</dt>
              <dd class="kernel-chat-context-card__value" data-provider-status>—</dd>
            </div>
            <div class="kernel-chat-context-card__field">
              <dt class="kernel-chat-context-card__label">الوضع</dt>
              <dd class="kernel-chat-context-card__value" data-provider-mode>—</dd>
            </div>
          </dl>
        </section>

        <!-- Policy / Firewall notifications -->
        <section class="kernel-sidecard" aria-labelledby="ctx-policy-title">
          <h3 class="kernel-sidecard__title" id="ctx-policy-title">تنبيهات السياسة</h3>
          <div style="display:flex; flex-direction:column; gap:var(--space-2);">
            <div class="kernel-chat-policy-banner kernel-chat-policy-banner--warning" style="padding:var(--space-2);">
              <span class="kernel-chat-policy-banner__icon" aria-hidden="true" style="inline-size:20px; block-size:20px;">
                <Fragment set:html={iconShield} />
              </span>
              <div class="kernel-chat-policy-banner__body">
                <p class="kernel-chat-policy-banner__title">Firewall: PDPL §12</p>
                <p class="kernel-chat-policy-banner__msg">حظر تصدير بيانات شخصية إلى نموذج خارجي.</p>
              </div>
            </div>
            <div class="kernel-chat-policy-banner kernel-chat-policy-banner--info" style="padding:var(--space-2);">
              <span class="kernel-chat-policy-banner__icon" aria-hidden="true" style="inline-size:20px; block-size:20px;">
                <Fragment set:html={iconInfo} />
              </span>
              <div class="kernel-chat-policy-banner__body">
                <p class="kernel-chat-policy-banner__title">Audit Chain: VALID</p>
                <p class="kernel-chat-policy-banner__msg">سلسلة hash متطابقة بصرياً — السجلات سليمة.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Session meta -->
        <section class="kernel-sidecard" aria-labelledby="ctx-session-title">
          <h3 class="kernel-sidecard__title" id="ctx-session-title">الجلسة الحالية</h3>
          <dl style="display:grid; grid-template-columns:auto 1fr; gap:6px var(--space-3); font-size:var(--text-sm);">
            <dt style="color:var(--text-secondary); opacity:var(--text-tertiary-opacity);">Trace</dt>
            <dd style="margin:0; font-family:var(--font-mono); color:var(--text-primary);">AI-2026-10493</dd>
            <dt style="color:var(--text-secondary); opacity:var(--text-tertiary-opacity);">Hash</dt>
            <dd style="margin:0; font-family:var(--font-mono); color:var(--text-primary); font-size:0.78rem;">0xa7c8f2e9…d41b</dd>
            <dt style="color:var(--text-secondary); opacity:var(--text-tertiary-opacity);">الوقت</dt>
            <dd style="margin:0; color:var(--text-primary);">قبل 3د · live</dd>
          </dl>
        </section>
      </aside>

    </div>

    {/*
      KRN-008 / EXEC-08: Mobile drawers (slide-in panels).
      - Hidden on desktop (display: none).
      - On <1024px, opened via the toolbar buttons (الرسائل / السياق).
      - role="dialog" + aria-modal="true" + focus trap (per §4.5(i)).
      - Body scroll lock + Escape-to-close + focus return to trigger.
    */}

    <!-- THREADS DRAWER (mobile only) -->
    <div
      class="kernel-chat-drawer"
      id="kernel-chat-drawer-threads"
      role="dialog"
      aria-modal="true"
      aria-labelledby="kernel-chat-drawer-threads-title"
      aria-hidden="true"
      data-open="false"
      data-drawer-name="threads"
    >
      <div class="kernel-chat-drawer__backdrop" data-kernel-chat-drawer-close="threads" aria-hidden="true"></div>
      <div class="kernel-chat-drawer__panel">
        <header class="kernel-chat-drawer__head">
          <h3 class="kernel-chat-drawer__title" id="kernel-chat-drawer-threads-title">المحادثات</h3>
          <button
            type="button"
            class="kernel-chat-drawer__close"
            data-kernel-chat-drawer-close="threads"
            aria-label="إغلاق قائمة المحادثات"
          >
            <Fragment set:html={iconClose} />
          </button>
        </header>
        <div class="kernel-chat-drawer__body">
          <button type="button" class="kernel-threads-list__new-btn" data-kernel-chat-new>
            <span aria-hidden="true"><Fragment set:html={iconPlus} /></span>
            <span>محادثة جديدة</span>
          </button>
          <ul class="kernel-threads-list" role="list" data-kernel-drawer-threads>
            {threads.map(t => (
              <li>
                <button
                  type="button"
                  class="kernel-threads-list__item"
                  aria-current={t.selected ? 'true' : 'false'}
                  data-thread-id={t.id}
                  data-thread-title={t.title}
                >
                  <span class="kernel-threads-list__title">{t.title}</span>
                  <span class="kernel-threads-list__meta">{t.preview}</span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- CONTEXT DRAWER (mobile only) -->
    <div
      class="kernel-chat-drawer"
      id="kernel-chat-drawer-context"
      role="dialog"
      aria-modal="true"
      aria-labelledby="kernel-chat-drawer-context-title"
      aria-hidden="true"
      data-open="false"
      data-drawer-name="context"
    >
      <div class="kernel-chat-drawer__backdrop" data-kernel-chat-drawer-close="context" aria-hidden="true"></div>
      <div class="kernel-chat-drawer__panel">
        <header class="kernel-chat-drawer__head">
          <h3 class="kernel-chat-drawer__title" id="kernel-chat-drawer-context-title">لوحة السياق</h3>
          <button
            type="button"
            class="kernel-chat-drawer__close"
            data-kernel-chat-drawer-close="context"
            aria-label="إغلاق لوحة السياق"
          >
            <Fragment set:html={iconClose} />
          </button>
        </header>
        <div class="kernel-chat-drawer__body">
          <!-- Live provider card (K2 2026-07-18): mirrors the RIGHT pane. -->
          <section class="kernel-chat-context-card" aria-labelledby="ctx-drawer-provider-title" data-provider-card>
            <header class="kernel-chat-context-card__head">
              <span class="kernel-chat-context-card__logo" aria-hidden="true" data-provider-logo>B</span>
              <div class="kernel-chat-context-card__title-block">
                <h3 class="kernel-chat-context-card__title" id="ctx-drawer-provider-title">
                  مزود النموذج: <span data-provider-badge>—</span>
                </h3>
                <p class="kernel-chat-context-card__sub">يُعرض من استجابة الخادم</p>
              </div>
              <span class="kernel-chat-context-card__tag" data-demo-badge hidden>تجريبي</span>
              <span class="kernel-chat-context-card__tag kernel-chat-context-card__tag--warn" data-degraded-badge hidden>سياق غير محفوظ</span>
            </header>
            <dl>
              <div class="kernel-chat-context-card__field">
                <dt class="kernel-chat-context-card__label">الحالة</dt>
                <dd class="kernel-chat-context-card__value" data-provider-status>—</dd>
              </div>
              <div class="kernel-chat-context-card__field">
                <dt class="kernel-chat-context-card__label">الوضع</dt>
                <dd class="kernel-chat-context-card__value" data-provider-mode>—</dd>
              </div>
            </dl>
          </section>

          <!-- Policy / Firewall notifications -->
          <section class="kernel-sidecard" aria-labelledby="ctx-drawer-policy-title">
            <h3 class="kernel-sidecard__title" id="ctx-drawer-policy-title">تنبيهات السياسة</h3>
            <div style="display:flex; flex-direction:column; gap:var(--space-2);">
              <div class="kernel-chat-policy-banner kernel-chat-policy-banner--warning" style="padding:var(--space-2);">
                <span class="kernel-chat-policy-banner__icon" aria-hidden="true" style="inline-size:20px; block-size:20px;">
                  <Fragment set:html={iconShield} />
                </span>
                <div class="kernel-chat-policy-banner__body">
