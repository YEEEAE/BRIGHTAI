---
/**
 * /kernel/reports/ — Reports library + Builder + Preview + Template versions (M23).
 *
 * Features:
 *   - 4 KPI cards (total / ready / generating / recipients) — SSR from deterministic data
 *   - Filters: type + status + language
 *   - Reports library: 42 reports with Trace coverage + Certificate coverage
 *   - Generate wizard (4 steps: type → period → format → recipients)
 *   - Report builder: drag & drop widgets onto A4 canvas
 *   - Report preview: drawer with executive summary + Trace/Certificate coverage
 *   - 5 languages switcher
 *   - Template versions tab (hash-chained)
 *   - Scheduled reports section
 *   - Role recipients (not emails)
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelMetricCard from '../../components/kernel/KernelMetricCard.astro';
import KernelCard from '../../components/kernel/KernelCard.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelLeadForm from '../../components/kernel/KernelLeadForm.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import { getKernelUnit, getCrossLinks, getKernelFaqJsonLd } from '../../data/kernel';
import { getKernelSubPageJsonLd } from '../../data/schema-helpers';
import { buildReportStats, REPORT_TYPES, REPORT_LANGUAGES, REPORT_RECIPIENTS, REPORT_WIDGETS } from '../../data/kernel-reports';

const unit = getKernelUnit('reports')!;
const cross = getCrossLinks(unit);

const jsonLd: Record<string, unknown>[] = [
  ...getKernelSubPageJsonLd(unit),
  getKernelFaqJsonLd(unit),
].filter(Boolean) as Record<string, unknown>[];

const stats = buildReportStats();

const iconReports = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>';
const iconCheck = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
const iconClock = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
const iconDownload = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>';
const iconClose = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
const iconPlus = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>';
const iconArrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
const iconBuilder = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>';
const iconVersions = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6m11-7h-6m-6 0H1"/></svg>';
---

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: 'التقارير', href: unit.path }]}
>
  <header class="kernel-page-header">
    <div class="kernel-page-header__lead">
      <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
        <ol>
          <li><a href="/">BrightAI</a></li>
          <li><a href="/kernel/">Kernel</a></li>
          <li aria-current="page">{unit.label}</li>
        </ol>
      </nav>
      <h1 class="kernel-page-header__title">{unit.h1}</h1>
      <p class="kernel-page-header__subtitle">
        مكتبة التقارير + منشئ التقارير البصري + معاينة + 5 لغات + إصدارات القوالب + تغطية Trace وشهادات.
      </p>
    </div>
    <div class="kernel-page-header__actions">
      <KernelDemoPill />
      <button type="button" class="kernel-stats-export" id="kr-open-wizard">
        <Fragment set:html={iconPlus} />
        <span>تقرير جديد</span>
      </button>
    </div>
  </header>

  <div class="kernel-main kernel-page-fade-in">
    {/* KPI cards — SSR from deterministic data */}
    <section class="kernel-metric-grid kernel-stagger" aria-label="مؤشرات التقارير">
      <KernelMetricCard label="تقارير منجزة" value={stats.total} variant="brand" trend="up" trendLabel="8%" iconSvg={iconReports} footer="هذا الشهر" />
      <KernelMetricCard label="جاهزة" value={stats.ready} iconSvg={iconCheck} footer={`${stats.generating} قيد الإنشاء`} />
      <KernelMetricCard label="مجدولة" value={stats.scheduled} iconSvg={iconClock} footer="3 نشطة · 1 موقوفة" />
      <KernelMetricCard label="المستلمون" value={stats.recipients} iconSvg={iconReports} footer="أدوار · قادة · امتثال" />
    </section>

    {/* Tabs: Library | Builder | Versions */}
    <nav class="kr-tabs" aria-label="أقسام التقارير">
      <button type="button" class="kr-tab active" data-kr-tab="library" aria-pressed="true">مكتبة التقارير</button>
      <button type="button" class="kr-tab" data-kr-tab="builder" aria-pressed="false">منشئ التقارير</button>
      <button type="button" class="kr-tab" data-kr-tab="versions" aria-pressed="false">إصدارات القوالب</button>
    </nav>

    {/* ─── Tab 1: Library ─── */}
    <section class="kr-tab-panel active" data-kr-panel="library">
      {/* Filters */}
      <nav class="kr-filters" aria-label="فلترة التقارير">
        <div class="kr-filters__group">
          <span class="kr-filters__label">النوع:</span>
          <button type="button" class="kr-filters__chip active" data-kr-filter-type="all">الكل</button>
          {REPORT_TYPES.map((t) => (
            <button type="button" class="kr-filters__chip" data-kr-filter-type={t.id}>
              <span aria-hidden="true">{t.icon}</span>
              <span>{t.label}</span>
            </button>
          ))}
        </div>
        <div class="kr-filters__group">
          <span class="kr-filters__label">الحالة:</span>
          <button type="button" class="kr-filters__chip active" data-kr-filter-status="all">الكل</button>
          <button type="button" class="kr-filters__chip" data-kr-filter-status="ready">جاهز</button>
          <button type="button" class="kr-filters__chip" data-kr-filter-status="generating">قيد الإنشاء</button>
          <button type="button" class="kr-filters__chip" data-kr-filter-status="failed">فشل</button>
        </div>
        <div class="kr-filters__group">
          <span class="kr-filters__label">اللغة:</span>
          <button type="button" class="kr-filters__chip active" data-kr-filter-language="all">الكل</button>
          {REPORT_LANGUAGES.map((l) => (
            <button type="button" class="kr-filters__chip" data-kr-filter-language={l.id}>
              <span>{l.native}</span>
            </button>
          ))}
        </div>
      </nav>

      {/* Reports Library */}
      <KernelCard title="مكتبة التقارير" subtitle={`${stats.total} تقرير`} iconSvg={iconReports}>
        <div class="kernel-card__body">
          <div class="kr-reports-list" id="kr-reports-list">
            {/* JS-rendered */}
          </div>
        </div>
      </KernelCard>

      {/* Scheduled reports */}
      <KernelCard title="التقارير المجدولة" subtitle={`${stats.scheduled} جداول · 3 نشطة`} iconSvg={iconClock}>
        <div class="kernel-card__body">
          <div class="kr-scheduled-list" id="kr-scheduled-list">
            {/* JS-rendered */}
          </div>
        </div>
      </KernelCard>
    </section>

    {/* ─── Tab 2: Builder ─── */}
    <section class="kr-tab-panel" data-kr-panel="builder" hidden>
      <div class="kr-builder-layout">
        {/* Palette */}
        <aside class="kr-builder-palette" aria-label="مكتبة الـ widgets">
          <h3 class="kr-builder-palette__title">Widgets</h3>
          <div class="kr-builder-palette__list" id="kr-builder-palette">
            {/* JS-rendered */}
          </div>
        </aside>

        {/* Canvas */}
        <div class="kr-builder-canvas" id="kr-builder-canvas" aria-label="قماش التقرير">
          <div class="kr-builder-canvas__header">
            <span class="kr-builder-canvas__label">قماش A4</span>
            <div class="kr-builder-canvas__actions">
              <button type="button" class="kr-builder-btn kr-builder-btn--clear" id="kr-builder-clear">مسح</button>
              <button type="button" class="kr-builder-btn kr-builder-btn--save" id="kr-builder-save">حفظ كقالب</button>
            </div>
          </div>
          <div class="kr-builder-canvas__body">
            {/* JS-rendered widgets */}
          </div>
        </div>

        {/* Properties */}
        <aside class="kr-builder-properties" aria-label="خصائص الـ widget">
          <h3 class="kr-builder-properties__title">الخصائص</h3>
          <div class="kr-builder-properties__body">
            <p class="kr-builder-properties__hint">اختر widget لتعديل خصائصه</p>
          </div>
        </aside>
      </div>
    </section>

    {/* ─── Tab 3: Template Versions ─── */}
    <section class="kr-tab-panel" data-kr-panel="versions" hidden>
      <KernelCard title="إصدارات القوالب" subtitle="5 إصدارات · hash-chained" iconSvg={iconVersions}>
        <div class="kernel-card__body">
          <div class="kr-template-versions" id="kr-template-versions">
            {/* JS-rendered */}
          </div>
        </div>
      </KernelCard>
    </section>

  </div>

  {/* Generate Report Wizard Modal */}
  <div class="kernel-modal" id="kr-wizard-modal" role="dialog" aria-modal="true" aria-labelledby="kr-wizard-title" hidden>
    <div class="kernel-modal__backdrop" data-kr-close-wizard></div>
    <div class="kernel-modal__panel kernel-modal__panel--wide">
      <header class="kernel-modal__header">
        <div>
          <h2 class="kernel-modal__title" id="kr-wizard-title">إنشاء تقرير جديد</h2>
          <p class="kernel-modal__subtitle">معالج بـ 4 خطوات · يستغرق دقيقتين</p>
        </div>
        <button type="button" class="kernel-modal__close" data-kr-close-wizard aria-label="إغلاق">
          <Fragment set:html={iconClose} />
        </button>
      </header>

      {/* Stepper */}
      <div class="kr-wizard__stepper">
        <div class="kr-wizard__step active" data-step="1">
          <span class="kr-wizard__step-num">1</span>
          <span class="kr-wizard__step-label">النوع</span>
        </div>
        <div class="kr-wizard__step" data-step="2">
          <span class="kr-wizard__step-num">2</span>
          <span class="kr-wizard__step-label">الفترة</span>
        </div>
        <div class="kr-wizard__step" data-step="3">
          <span class="kr-wizard__step-num">3</span>
          <span class="kr-wizard__step-label">الصيغة</span>
        </div>
        <div class="kr-wizard__step" data-step="4">
          <span class="kr-wizard__step-num">4</span>
          <span class="kr-wizard__step-label">المستلمون</span>
        </div>
      </div>

      <div class="kernel-modal__body">
        {/* Step 1: Type */}
        <section class="kr-wizard__panel active" data-kr-wizard-panel="1">
          <h3 class="kr-wizard__panel-title">اختر نوع التقرير</h3>
          <div class="kr-wizard__type-grid">
            {REPORT_TYPES.map((t) => (
              <label class="kr-wizard__type-option">
                <input type="radio" name="report-type" value={t.id} />
                <span class="kr-wizard__type-card">
                  <span class="kr-wizard__type-icon" aria-hidden="true">{t.icon}</span>
                  <strong>{t.label}</strong>
                </span>
              </label>
            ))}
          </div>
        </section>

        {/* Step 2: Period */}
        <section class="kr-wizard__panel" data-kr-wizard-panel="2" hidden>
          <h3 class="kr-wizard__panel-title">حدد الفترة الزمنية</h3>
          <div class="kr-wizard__period-grid">
            {[
              { id: 'today', label: 'اليوم', desc: 'من 00:00 حتى الآن' },
              { id: 'week', label: 'الأسبوع الماضي', desc: '7 أيام' },
              { id: 'month', label: 'الشهر الماضي', desc: '30 يوم' },
              { id: 'quarter', label: 'الربع الحالي', desc: 'Q2 2026' },
              { id: 'year', label: 'السنة الحالية', desc: '2026 كامل' },
              { id: 'custom', label: 'مخصص', desc: 'حدد البداية والنهاية' },
            ].map((p) => (
              <label class="kr-wizard__period-option">
                <input type="radio" name="report-period" value={p.id} />
                <span class="kr-wizard__period-card">
                  <strong>{p.label}</strong>
                  <small>{p.desc}</small>
                </span>
              </label>
            ))}
          </div>
        </section>

        {/* Step 3: Format */}
        <section class="kr-wizard__panel" data-kr-wizard-panel="3" hidden>
          <h3 class="kr-wizard__panel-title">اختر صيغة الإخراج</h3>
          <div class="kr-wizard__format-grid">
            {[
              { id: 'pdf', label: 'PDF', desc: 'مناسب للطباعة والمشاركة', icon: '📕' },
              { id: 'json', label: 'JSON', desc: 'للتكامل مع APIs', icon: '🔧' },
              { id: 'csv', label: 'CSV', desc: 'بيانات خام', icon: '📄' },
              { id: 'xlsx', label: 'Excel', desc: 'للتحليل والمعالجة', icon: '📗' },
            ].map((f) => (
              <label class="kr-wizard__format-option">
                <input type="radio" name="report-format" value={f.id} />
                <span class="kr-wizard__format-card">
                  <span aria-hidden="true">{f.icon}</span>
                  <strong>{f.label}</strong>
                  <small>{f.desc}</small>
                </span>
              </label>
            ))}
          </div>
        </section>

        {/* Step 4: Recipients */}
        <section class="kr-wizard__panel" data-kr-wizard-panel="4" hidden>
          <h3 class="kr-wizard__panel-title">اختر المستلمين (أدوار)</h3>
          <div class="kr-wizard__recipients">
            {REPORT_RECIPIENTS.map((r) => (
              <label class="kr-wizard__recipient-option">
                <input type="checkbox" name="report-recipient" value={r.id} />
                <span class="kr-wizard__recipient-card">
                  <strong>{r.label}</strong>
                  <small>{r.role}</small>
                </span>
              </label>
            ))}
          </div>
        </section>
      </div>

      <footer class="kernel-modal__footer kr-wizard__footer">
        <button type="button" class="kernel-policy-editor__btn kernel-policy-editor__btn--cancel" data-kr-close-wizard>إلغاء</button>
        <div class="kr-wizard__nav">
          <button type="button" class="kernel-policy-editor__btn kernel-policy-editor__btn--secondary" id="kr-wizard-prev" hidden>
            السابق
          </button>
          <button type="button" class="kernel-policy-editor__btn kernel-policy-editor__btn--save" id="kr-wizard-next">
            <span>التالي</span>
            <Fragment set:html={iconArrow} />
          </button>
          <button type="button" class="kernel-policy-editor__btn kernel-policy-editor__btn--save" id="kr-wizard-generate" hidden>
            <Fragment set:html={iconCheck} />
            <span>توليد التقرير</span>
          </button>
        </div>
      </footer>
    </div>
  </div>

  {/* Report Preview Drawer */}
  <div class="kr-preview-drawer" id="kr-preview-drawer" role="dialog" aria-modal="true" aria-labelledby="kr-preview-title" hidden>
    <div class="kr-preview-drawer__backdrop" data-kr-close-preview></div>
    <div class="kr-preview-drawer__panel">
      <header class="kr-preview-drawer__head">
        <h2 id="kr-preview-title" class="kr-preview-drawer__title" data-kr-preview-title>—</h2>
        <button type="button" class="kr-preview-drawer__close" data-kr-close-preview aria-label="إغلاق">
          <Fragment set:html={iconClose} />
        </button>
      </header>
      <div class="kr-preview-drawer__body">
        {/* Executive Summary */}
        <div class="kr-preview-section">
          <h3 class="kr-preview-section__title">الملخص التنفيذي</h3>
          <div class="kr-preview-summary" data-kr-preview-summary>—</div>
        </div>

        {/* Meta */}
        <div class="kr-preview-section">
          <h3 class="kr-preview-section__title">التفاصيل</h3>
          <div class="kr-preview-meta" data-kr-preview-meta>—</div>
        </div>

        {/* Trace Coverage */}
        <div class="kr-preview-section">
          <h3 class="kr-preview-section__title">تغطية Trace</h3>
          <div data-kr-preview-traces>—</div>
        </div>

        {/* Certificate Coverage */}
        <div class="kr-preview-section">
          <h3 class="kr-preview-section__title">تغطية الشهادات</h3>
          <div data-kr-preview-certs>—</div>
        </div>
      </div>
    </div>
  </div>

  {/* Lead Capture */}
  <section class="kernel-lead-section inner-section inner-section--alt" aria-labelledby="lead-form-h2-reports">
    <div class="max-w-3xl mx-auto px-5">
      <h2 id="lead-form-h2-reports" class="inner-section__title inner-section__title--centered">تبي تقارير تنفيذية جاهزة لمجلس الإدارة؟</h2>
      <p class="inner-section__lead inner-section__lead--centered">فريق الحوكمة يوضح لك كيف تولّد Kernel تقارير بـ 5 لغات.</p>
      <KernelLeadForm id="kernel-lead-form-reports" page="/kernel/reports/" />
    </div>
  </section>

  {/* SEO content + FAQ */}
  <KernelSeoSection
    id="kernel-seo-reports"
    heading="دليل حوكمة AI — سياق إضافي عن وحدة التقارير"
    blocks={unit.seoBlocks}
    faq={unit.faq}
  />

  {/* Cross-links */}
  <KernelContextLinks
    currentPath={unit.path}
    solutionPath={cross.solutionPath}
    docPath={cross.docPath ?? ''}
    blogPath={cross.blogPath}
    blogLabel={unit.blogLabel}
    relatedSlugs={unit.relatedSlugs}
  />

  {/* Data + Engine — type="module" required for public/js/ */}
  <script type="module" src="/js/kernel-reports-data.js"></script>
  <script type="module" src="/js/kernel-reports.js"></script>
  <script type="module" src="/js/kernel-loading-state.js"></script>
</KernelLayout>