---

<style>
  /*
   * Mobile-first + RTL baseline for Policies (kernel championship).
   * Injected by kernel-mobile-baseline.mjs. Logical properties (RTL-safe), ≥44px touch
   * targets, responsive breakpoints, and empty/loading state styles.
   * Uses design tokens. No published text or layout overrides.
   */
  .kernel-policies__empty-state,
  .kernel-policies-empty-state {
    padding-inline: var(--space-6);
    margin-inline: auto;
    text-align: start;
    color: var(--text-muted);
    border-inline-start: 3px solid var(--interactive-primary);
  }
  .kernel-policies__skeleton,
  .kernel-policies-skeleton {
    inset-inline-start: 0;
    background: var(--bg-elevated);
    animation: kernel-policies-shimmer 1.4s var(--ease-in-out) infinite;
  }
  @keyframes kernel-policies-shimmer {
    0% { opacity: 1; }
    50% { opacity: 0.45; }
    100% { opacity: 1; }
  }
  /* Touch targets ≥44px — accessibility on small screens */
  .kernel-policies [data-kernel-touch],
  .kernel-policies__touch {
    min-height: 44px;
    min-width: 44px;
  }
  /* Mobile-first: single column on mobile, enhance at ≥768px */
  .kernel-policies__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .kernel-policies__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }
  @media (max-width: 640px) {
    .kernel-policies [data-kernel-touch] { min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kernel-policies-skeleton { animation: none; }
  }
</style>

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: 'السياسات', href: unit.path }]}
>
  <header class="kernel-page-header">
    <div class="kernel-page-header__lead">
      <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
        <ol>
          <li><a href="/">BrightAI</a></li>
          <li><a href="/kernel/">Kernel</a></li>
          <li aria-current="page">{unit.label}</li>
        </ol>
      </nav>
      <h1 class="kernel-page-header__title">{unit.h1}</h1>
      <p class="kernel-page-header__subtitle">
        محرر سياسات بصري مع rule builder، preview محلي، ودعم 9 أنواع PII رئيسية و 7 حزم امتثال.
      </p>
    </div>
    <div class="kernel-page-header__actions">
      <KernelDemoPill />
      <button type="button" class="kernel-stats-export" id="new-policy-btn">
        <Fragment set:html={iconPlus} />
        <span>سياسة جديدة</span>
      </button>
    </div>
  </header>

  <div class="kernel-main kernel-page-fade-in">

    <KernelStatusStrip
      kicker="السياسات النشطة"
      title="11 سياسة · 3 بحاجة لمراجعة"
      dot="warn"
      items={[
        { label: 'مفعّلة', value: '9' },
        { label: 'مسودة', value: '2' },
        { label: 'مؤرشفة', value: '1' },
      ]}
    />

    {/* Policies List */}
    <section class="kernel-col-12">
      <KernelCard title="قائمة السياسات" subtitle="CRUD + Visual Rule Builder + Preview" iconSvg={iconPolicies}>
        <div class="kernel-card__body">
          <div class="kernel-policies-table" role="table" aria-label="جدول السياسات">
            <div class="kernel-policies-table__header" role="row">
              <span role="columnheader">السياسة</span>
              <span role="columnheader">نوع PII</span>
              <span role="columnheader">حزمة الامتثال</span>
              <span role="columnheader">الإجراء</span>
              <span role="columnheader">التطبيقات</span>
              <span role="columnheader">الحالة</span>
              <span role="columnheader">آخر تعديل</span>
              <span role="columnheader">إجراءات</span>
            </div>
            {policies.map((p) => (
              <div class="kernel-policies-table__row" role="row" data-policy-id={p.id}>
                <div class="kernel-policies-table__name" role="cell">
                  <strong>{p.name}</strong>
                  <small>{p.description}</small>
                </div>
                <span class="kernel-policies-table__cell" role="cell">
                  <span class="kernel-policies-table__chip">{piiTypes.find(t => t.id === p.piiType)?.icon} {piiTypes.find(t => t.id === p.piiType)?.label || p.piiType}</span>
                </span>
                <span class="kernel-policies-table__cell" role="cell">
                  <span class="kernel-badge kernel-badge--pack" lang="en">{p.compliancePack.toUpperCase()}</span>
                </span>
                <span class="kernel-policies-table__cell" role="cell">
                  <span class:list={['kernel-badge', `kernel-badge--${p.action === 'block' ? 'danger' : p.action === 'mask' ? 'brand' : p.action === 'hitl' ? 'warning' : 'neutral'}`]}>
                    {actions.find(a => a.id === p.action)?.label || p.action}
                  </span>
                </span>
                <span class="kernel-policies-table__cell kernel-policies-table__apps" role="cell">{p.appsCount}</span>
                <span class="kernel-policies-table__cell" role="cell">
                  <span class:list={['kernel-policies-table__status', p.isActive ? 'active' : 'inactive']}>
                    {p.isActive ? (<><Fragment set:html={iconCheck} /> مفعّلة</>) : (<><Fragment set:html={iconClock} /> مسودة</>)}
                  </span>
                </span>
                <span class="kernel-policies-table__cell kernel-policies-table__date" role="cell">{p.lastModified}</span>
                <span class="kernel-policies-table__cell" role="cell">
                  <button
                    type="button"
                    class="kernel-policies-table__edit"
                    data-edit-policy={p.id}
                    aria-label={`تعديل ${p.name}`}
                  >
                    <Fragment set:html={iconEdit} />
                    <span>تعديل</span>
                  </button>
                </span>
              </div>
            ))}
          </div>
        </div>
      </KernelCard>
    </section>

  </div>

  {/* Policy Editor Modal — Visual Rule Builder */}
  <div class="kernel-modal" id="policy-modal" role="dialog" aria-modal="true" aria-labelledby="policy-modal-title" hidden>
    <div class="kernel-modal__backdrop" data-close-policy-modal></div>
    <div class="kernel-modal__panel kernel-modal__panel--wide">
      <header class="kernel-modal__header">
        <div>
          <h2 class="kernel-modal__title" id="policy-modal-title">محرر السياسة</h2>
          <p class="kernel-modal__subtitle" id="policy-modal-subtitle">rule builder بصري · بدون كتابة كود</p>
        </div>
        <button type="button" class="kernel-modal__close" data-close-policy-modal aria-label="إغلاق">
          <Fragment set:html={iconClose} />
        </button>
      </header>

      <div class="kernel-modal__body">
        {/* Policy name + description */}
        <section class="kernel-policy-editor__meta">
          <label class="kernel-policy-editor__field">
            <span>اسم السياسة</span>
            <input type="text" id="policy-name" class="kernel-policy-editor__input" placeholder="مثلاً: حظر الهوية الوطنية في البيانات الطبية" />
          </label>
          <label class="kernel-policy-editor__field">
            <span>الوصف</span>
            <input type="text" id="policy-description" class="kernel-policy-editor__input" placeholder="شرح مختصر لهدف السياسة" />
          </label>
        </section>

        {/* Visual Rule Builder */}
        <section class="kernel-policy-editor__builder">
          <h3 class="kernel-policy-editor__section-title">قاعدة السياسة (IF…THEN)</h3>

          <div class="kernel-rulebuilder">
            {/* IF clause */}
            <div class="kernel-rulebuilder__row kernel-rulebuilder__row--if">
              <span class="kernel-rulebuilder__keyword kernel-rulebuilder__keyword--if">IF</span>
              <label class="kernel-rulebuilder__select">
                <span class="kernel-rulebuilder__select-label">نوع البيانات</span>
                <select id="rule-pii-type">
                  {piiTypes.map((t) => (
                    <option value={t.id}>{t.icon} {t.label}</option>
                  ))}
                </select>
              </label>
              <label class="kernel-rulebuilder__select">
                <span class="kernel-rulebuilder__select-label">المطابقة</span>
                <select id="rule-operator">
                  <option value="contains">يحتوي على</option>
                  <option value="matches">يطابق النمط</option>
                  <option value="equals">يساوي</option>
                </select>
              </label>
              <label class="kernel-rulebuilder__select kernel-rulebuilder__select--pattern">
                <span class="kernel-rulebuilder__select-label">نمط Regex (اختياري)</span>
                <input type="text" id="rule-pattern" class="kernel-policy-editor__input" placeholder='مثلاً: ^1[0-9]{9}$' />
              </label>
            </div>

            {/* AND clause */}
            <div class="kernel-rulebuilder__row kernel-rulebuilder__row--and">
              <span class="kernel-rulebuilder__keyword kernel-rulebuilder__keyword--and">AND</span>
              <label class="kernel-rulebuilder__select">
                <span class="kernel-rulebuilder__select-label">حزمة الامتثال</span>
                <select id="rule-pack">
                  {compliancePacks.map((c) => (
                    <option value={c.id}>{c.label}</option>
                  ))}
                </select>
              </label>
            </div>

            {/* THEN clause */}
            <div class="kernel-rulebuilder__row kernel-rulebuilder__row--then">
              <span class="kernel-rulebuilder__keyword kernel-rulebuilder__keyword--then">THEN</span>
              <label class="kernel-rulebuilder__select">
                <span class="kernel-rulebuilder__select-label">الإجراء</span>
                <select id="rule-action">
                  {actions.map((a) => (
                    <option value={a.id}>{a.label} — {a.desc}</option>
                  ))}
                </select>
              </label>
              <label class="kernel-rulebuilder__select">
                <span class="kernel-rulebuilder__select-label">مُعدِّل الخطورة (+/−)</span>
                <input type="number" id="rule-risk-modifier" class="kernel-policy-editor__input" value="10" min="0" max="50" />
              </label>
            </div>
          </div>
        </section>

        {/* Preview */}
        <section class="kernel-policy-editor__preview">
          <h3 class="kernel-policy-editor__section-title">معاينة JSON</h3>
          <pre class="kernel-policy-editor__json" id="policy-json-preview">{`{
  "id": "pr_new_policy",
  "name": "...",
  "rule": {
    "if": { "pii_type": "...", "operator": "...", "pattern": "..." },
    "and": { "compliance_pack": "..." },
    "then": { "action": "...", "risk_score_modifier": 0 }
  },
  "is_active": true
}`}</pre>
        </section>
      </div>

      <footer class="kernel-modal__footer">
        <button type="button" class="kernel-policy-editor__btn kernel-policy-editor__btn--cancel" data-close-policy-modal>إلغاء</button>
        <button type="button" class="kernel-policy-editor__btn kernel-policy-editor__btn--save" id="save-policy-btn">
          <Fragment set:html={iconCheck} />
          <span>حفظ السياسة</span>
        </button>
      </footer>
    </div>
  </div>

  <script is:inline define:vars={{ policies, piiTypes, compliancePacks, actions }}>
    (function () {
      'use strict';

      const modal = document.getElementById('policy-modal');
      const nameInput = document.getElementById('policy-name');
      const descInput = document.getElementById('policy-description');
      const piiSelect = document.getElementById('rule-pii-type');
      const operatorSelect = document.getElementById('rule-operator');
      const patternInput = document.getElementById('rule-pattern');
      const packSelect = document.getElementById('rule-pack');
      const actionSelect = document.getElementById('rule-action');
      const riskInput = document.getElementById('rule-risk-modifier');
      const jsonPreview = document.getElementById('policy-json-preview');
      const saveBtn = document.getElementById('save-policy-btn');

      function openModal(policy) {
        if (policy) {
          nameInput.value = policy.name;
          descInput.value = policy.description;
          piiSelect.value = policy.piiType;
          packSelect.value = policy.compliancePack;
          actionSelect.value = policy.action;
          riskInput.value = policy.riskModifier;
          document.getElementById('policy-modal-title').textContent = 'تعديل السياسة';
        } else {
          nameInput.value = '';
          descInput.value = '';
          piiSelect.value = 'saudi_id';
          packSelect.value = 'pdpl';
          actionSelect.value = 'mask';
          riskInput.value = 10;
          patternInput.value = '';
          document.getElementById('policy-modal-title').textContent = 'سياسة جديدة';
        }
        updatePreview();
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        nameInput.focus();
      }

      function closeModal() {
        modal.hidden = true;
        document.body.style.overflow = '';
      }

      function updatePreview() {
        const policyObj = {
          id: 'pr_' + (nameInput.value || 'new_policy').toLowerCase().replace(/\s+/g, '_').slice(0, 32),
          name: nameInput.value || '...',
          description: descInput.value || '',
          rule: {
            if: {
              pii_type: piiSelect.value,
              operator: operatorSelect.value,
              pattern: patternInput.value || null,
            },
            and: {
              compliance_pack: packSelect.value,
            },
            then: {
              action: actionSelect.value,
              risk_score_modifier: parseInt(riskInput.value, 10) || 0,
            },
          },
          is_active: true,
        };
        jsonPreview.textContent = JSON.stringify(policyObj, null, 2);
      }

      [nameInput, descInput, piiSelect, operatorSelect, patternInput, packSelect, actionSelect, riskInput].forEach((el) => {
        el.addEventListener('input', updatePreview);
        el.addEventListener('change', updatePreview);
      });

      document.querySelectorAll('[data-close-policy-modal]').forEach((el) => {
        el.addEventListener('click', closeModal);
      });

      document.querySelectorAll('[data-edit-policy]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const policy = policies.find(p => p.id === btn.dataset.editPolicy);
          if (policy) openModal(policy);
        });
      });

      document.getElementById('new-policy-btn').addEventListener('click', () => openModal(null));

      saveBtn.addEventListener('click', () => {
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<span>جاري الحفظ…</span>';
        setTimeout(() => {
          saveBtn.disabled = false;
          saveBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg><span>تم الحفظ</span>';
          setTimeout(() => {
            saveBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="20 6 9 17 4 12"/></svg><span>حفظ السياسة</span>';
            closeModal();
          }, 800);
        }, 600);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.hidden) closeModal();
      });
    })();
  </script>

