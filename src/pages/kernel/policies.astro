---
/**
 * /kernel/policies/ — محرر السياسات والحوكمة (M17 rebuild).
 *
 * ترقية محرر REPORTS-16 إلى أداة حوكمة كاملة:
 *   - جدول سياسات: الاسم، PII، الحزم، الإجراء، التطبيقات، الحالة، عدد
 *     الإصدارات، آخر تعديل، إجراءات (تعديل / إصدارات / محاكاة / استثناءات).
 *   - إصدارات immutable: أي تعديل ينشئ إصداراً جديداً بـ hash FNV-1a —
 *     لا تعديل في مكانه. إصدار مثبَّت بشهادة (certifiedBy) يُجمَّد ولا
 *     يُعدَّل (منع تعديل Policy version مستخدمة في Certificate قديم).
 *   - فرق Git-like بين الإصدارات + rollback (يُنشئ إصداراً جديداً).
 *   - محاكاة حتمية: آخر 1000 طلب × السياسات النشطة → أثر + إيجابيات كاذبة
 *     + توزيع حسب القسم + تحذير قبل التفعيل لو فوق العتبة.
 *   - مولّد سياسة بالذكاء (Demo — مسودة تحتاج مراجعة بشرية؛ شارة صريحة).
 *   - استيراد/تصدير JSON + باني شروط no-code + استثناءات.
 *
 * المعمارية (M17): محرك حتمي kernel-policies.js (لا Math.random) يشتغل
 * محلياً بالمتصفح. البيانات تُستهلك build-time وتُحقن كـ JSON blob
 * (#policies-config) — لا استيراد TS في المتصفح (نفس نمط
 * redteam.astro / #redteam-config). الإحصاءات العليا تُحسب SSR (قابلة
 * للزحف)، والجداول التفاعلية JS.
 *
 * النصوص بالعامية السعودية. الأرقام لاتينية. الجزر التقنية dir="ltr".
 * احترام prefers-reduced-motion. القيود: vanilla JS فقط.
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelStatusStrip from '../../components/kernel/KernelStatusStrip.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import KernelConditionBuilder from '../../components/kernel/KernelConditionBuilder.astro';
import { getKernelUnit, getCrossLinks, getKernelFaqJsonLd } from '../../data/kernel';
import { getKernelSubPageJsonLd } from '../../data/schema-helpers';
import { buildPolicyEditorConfig, buildPolicyEditorStats } from '../../data/kernel-policy-editor';
import '../../../kernel/assets/css/pages/policies.css';

const unit = getKernelUnit('policies')!;
const cross = getCrossLinks(unit);

const jsonLd = [
  ...getKernelSubPageJsonLd(unit),
  getKernelFaqJsonLd(unit),
];

const editorConfig = buildPolicyEditorConfig();
const stats = buildPolicyEditorStats();
---

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: 'السياسات', href: unit.path }]}
>
  <div class="po-page" data-po-root>
    <!-- ═══ رأس الصفحة ═══ -->
    <header class="po-header">
      <div class="po-header__lead">
        <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
          <ol>
            <li><a href="/">BrightAI</a></li>
            <li><a href="/kernel/">Kernel</a></li>
            <li aria-current="page">{unit.label}</li>
          </ol>
        </nav>
        <h1 class="po-header__title">محرر السياسات البصري</h1>
        <p class="po-header__subtitle">
          أداة حوكمة كاملة: سياسات قابلة للإصدارات، محاكاة قبل التفعيل، استثناءات،
          واستيراد/تصدير — بدون كود.
        </p>
      </div>
      <div class="po-header__actions">
        <KernelDemoPill />
        <button type="button" class="po-btn po-btn--primary" data-po-export>
          تصدير JSON
        </button>
        <label class="po-btn po-btn--ghost po-btn--file">
          استيراد JSON
          <input type="file" accept="application/json" class="po-file-input" data-po-import-input hidden />
        </label>
        <button type="button" class="po-btn po-btn--ghost" data-po-import>استيراد</button>
      </div>
    </header>

    <!-- ═══ شريط الملخص (SSR — قابلة للزحف) ═══ -->
    <div class="po-stats" aria-label="ملخص السياسات">
      <div class="po-stat">
        <span class="po-stat__label">سياسات</span>
        <strong class="po-stat__value">{stats.total}</strong>
      </div>
      <div class="po-stat">
        <span class="po-stat__label">مفعّلة</span>
        <strong class="po-stat__value" data-po-status-active>{stats.active}</strong>
      </div>
      <div class="po-stat">
        <span class="po-stat__label">مسودة</span>
        <strong class="po-stat__value" data-po-status-draft>{stats.drafts}</strong>
      </div>
      <div class="po-stat">
        <span class="po-stat__label">تطبيقات</span>
        <strong class="po-stat__value" dir="ltr">{stats.totalApps}</strong>
      </div>
      <div class="po-stat">
        <span class="po-stat__label">إصدارات</span>
        <strong class="po-stat__value" dir="ltr">{stats.versions}</strong>
      </div>
      <div class="po-stat">
        <span class="po-stat__label">شهادات مثبِّتة</span>
        <strong class="po-stat__value" dir="ltr">{stats.certified}</strong>
      </div>
    </div>

    <!-- ═══ محاكاة (آخر 1000 طلب) ═══ -->
    <section class="po-sim" aria-labelledby="po-sim-title">
      <div class="po-sim__head">
        <div>
          <h2 class="po-sim__title" id="po-sim-title">🧪 محاكاة قبل التفعيل</h2>
          <p class="po-sim__subtitle">
            يعيد تشغيل آخر {editorConfig.limits.simCount} طلب على السياسات النشطة بأنماط PII
            الحقيقية — حتمي، بدون نموذج خارجي.
          </p>
        </div>
        <button type="button" class="po-btn po-btn--primary" data-po-sim-all>
          شغّل المحاكاة
        </button>
      </div>

      <div class="po-sim__grid">
        <div class="po-sim__kpis">
          <div class="po-sim__kpi">
            <span class="po-sim__kpi-label">إجمالي الطلبات</span>
            <strong class="po-sim__kpi-value" dir="ltr" data-po-sim-total>{editorConfig.limits.simCount}</strong>
          </div>
          <div class="po-sim__kpi">
            <span class="po-sim__kpi-label">متأثر</span>
            <strong class="po-sim__kpi-value" dir="ltr" data-po-sim-affected>—</strong>
          </div>
          <div class="po-sim__kpi">
            <span class="po-sim__kpi-label">نسبة الأثر</span>
            <strong class="po-sim__kpi-value" dir="ltr" data-po-sim-affected-pct>—</strong>
          </div>
          <div class="po-sim__kpi">
            <span class="po-sim__kpi-label">إيجابيات كاذبة</span>
            <strong class="po-sim__kpi-value" dir="ltr" data-po-sim-fp>—</strong>
          </div>
          <div class="po-sim__kpi">
            <span class="po-sim__kpi-label">نسبة الكاذب</span>
            <strong class="po-sim__kpi-value" dir="ltr" data-po-sim-fp-pct>—</strong>
          </div>
        </div>

        <p class="po-sim__warn" data-po-sim-warn hidden></p>

        <div class="po-sim__bydept">
          <h3 class="po-sim__bydept-title">الأثر حسب القسم</h3>
          <div class="po-sim__list" data-po-sim-list></div>
        </div>
      </div>
    </section>

    <!-- ═══ جدول السياسات ═══ -->
    <section class="po-table-wrap" aria-labelledby="po-table-title">
      <div class="po-table__head">
        <h2 class="po-table__title" id="po-table-title">قائمة السياسات</h2>
        <span class="po-conflict-badge" data-po-conflict-badge>تعارضات: 0</span>
      </div>

      <div class="po-table" role="table" aria-label="جدول سياسات الحوكمة">
        <div class="po-table__headrow" role="row">
          <span role="columnheader">السياسة</span>
          <span role="columnheader">نوع PII</span>
          <span role="columnheader">حزمة الامتثال</span>
          <span role="columnheader">الإجراء</span>
          <span role="columnheader">التطبيقات</span>
          <span role="columnheader">الحالة</span>
          <span role="columnheader">الإصدارات</span>
          <span role="columnheader">آخر تعديل</span>
          <span role="columnheader">إجراءات</span>
        </div>
        <div class="po-table__body" data-po-tbody role="rowgroup">
          <!-- تُرسم من المحرك JS -->
          <div class="po-table__loading">جاري تحميل السياسات…</div>
        </div>
      </div>
    </section>

    <!-- ═══ مولّد السياسة بالذكاء ═══ -->
    <section class="po-gen" aria-labelledby="po-gen-title">
      <div class="po-gen__head">
        <h2 class="po-gen__title" id="po-gen-title">🤖 مولّد سياسة بالذكاء</h2>
        <span class="po-gen__badge" data-po-gen-meta>{editorConfig.aiBadge.label}</span>
      </div>
      <p class="po-gen__subtitle">
        صف السياسة اللي تبيها بجملة، ونولّد لك مسودة جاهزة للمراجعة. المسودة Demo —
        تتطلب مراجعة فريق الحوكمة قبل التفعيل.
      </p>
      <label class="po-gen__label" for="po-gen-input">وصف السياسة المطلوبة</label>
      <div class="po-gen__inputrow">
        <input
          type="text"
          id="po-gen-input"
          class="po-gen__input"
          placeholder="مثلاً: امنع تسريب أرقام الجوال مع حزم PDPL…"
          required
          aria-describedby="po-gen-input-error"
          data-po-gen-input
        />
        <button type="button" class="po-btn po-btn--primary" data-po-gen-btn>ولّد المسودة</button>
      </div>
      <p class="k-form__error" id="po-gen-input-error" role="alert" hidden>اكتب وصف السياسة قبل التوليد.</p>
      <pre class="po-gen__result" data-po-gen-result dir="ltr"></pre>
      <button type="button" class="po-btn po-btn--primary" data-po-gen-add hidden>
        أضف المسودة كسياسة (Demo)
      </button>
    </section>

    <KernelSeoSection
      id="kernel-seo-policies"
      heading="دليل حوكمة AI — سياق إضافي عن وحدة السياسات"
      blocks={unit.seoBlocks}
      faq={unit.faq}
    />

    <KernelContextLinks
      currentPath={unit.path}
      solutionPath={cross.solutionPath}
      docPath={cross.docPath ?? ''}
      blogPath={cross.blogPath}
      blogLabel={unit.blogLabel}
      relatedSlugs={unit.relatedSlugs}
    />
  </div>

  <!-- ═══ Modal: محرر السياسة ═══ -->
  <div class="po-modal" data-po-editor role="dialog" aria-modal="true" aria-labelledby="po-editor-title" hidden>
    <div class="po-modal__backdrop" data-po-editor-close></div>
    <div class="po-modal__panel">
      <header class="po-modal__head">
        <h2 class="po-modal__title" id="po-editor-title">تعديل السياسة</h2>
        <button type="button" class="po-modal__close" data-po-editor-close aria-label="إغلاق">✕</button>
      </header>

      <p class="po-editor__lock" data-po-editor-lock hidden></p>

      <div class="po-editor__body">
        <div class="po-field">
          <label for="po-field-name">اسم السياسة</label>
          <input type="text" id="po-field-name" class="po-field__input" data-po-field-name maxlength={editorConfig.limits.maxNameLen} required aria-describedby="po-field-name-error" />
          <p class="k-form__error" id="po-field-name-error" role="alert" hidden>اسم السياسة مطلوب قبل الحفظ.</p>
        </div>
        <div class="po-field">
          <label for="po-field-desc">الوصف</label>
          <input type="text" id="po-field-desc" class="po-field__input" data-po-field-desc />
        </div>

        <h3 class="po-editor__section-title">قاعدة السياسة (IF…THEN)</h3>

        {/* باني الشروط البصري الجديد (Visual Condition Builder) */}
        <KernelConditionBuilder />

        {/* المحرر النصي التقليدي — يتم إظهاره/إخفاؤه حسب النمط المختار */}
        <div class="po-classic-rules-wrap" data-po-classic-rules-wrap hidden>
          <div class="po-rule">
            <span class="po-rule__kw po-rule__kw--if">IF</span>
            <label class="po-field po-field--inline">
              <span class="po-field__label">نوع البيانات</span>
              <select class="po-field__input" data-po-field-pii>
                {editorConfig.piiTypes.map((t) => (
                  <option value={t.id}>{t.icon} {t.label}</option>
                ))}
              </select>
            </label>
            <label class="po-field po-field--inline">
              <span class="po-field__label">المطابقة</span>
              <select class="po-field__input" data-po-field-operator>
                {editorConfig.operators.map((o) => (
                  <option value={o.id}>{o.label}</option>
                ))}
              </select>
            </label>
            <label class="po-field po-field--inline po-field--grow">
              <span class="po-field__label">نمط Regex (اختياري)</span>
              <input type="text" class="po-field__input" placeholder='مثلاً: ^1[0-9]{9}$' data-po-field-pattern />
            </label>
          </div>

          <div class="po-rule">
            <span class="po-rule__kw po-rule__kw--and">AND</span>
            <label class="po-field po-field--inline">
              <span class="po-field__label">حزمة الامتثال</span>
              <select class="po-field__input" data-po-field-pack>
                {editorConfig.packs.map((c) => (
                  <option value={c.id}>{c.label}</option>
                ))}
              </select>
            </label>
          </div>

          <div class="po-rule">
            <span class="po-rule__kw po-rule__kw--then">THEN</span>
            <label class="po-field po-field--inline">
              <span class="po-field__label">الإجراء</span>
              <select class="po-field__input" data-po-field-action>
                {editorConfig.actions.map((a) => (
                  <option value={a.id}>{a.label} — {a.desc}</option>
                ))}
              </select>
            </label>
            <label class="po-field po-field--inline">
              <span class="po-field__label">مُعدِّل الخطورة</span>
              <input type="number" class="po-field__input" data-po-field-risk min="0" max="50" />
            </label>
          </div>
        </div>

        <div class="po-field">
          <label for="po-field-status">الحالة</label>
          <select id="po-field-status" class="po-field__input" data-po-field-status>
            <option value="active">مفعّلة</option>
            <option value="draft">مسودة</option>
            <option value="archived">مؤرشفة</option>
          </select>
        </div>
        <div class="po-field">
          <label for="po-field-note">ملاحظة الإصدار</label>
          <input type="text" id="po-field-note" class="po-field__input" placeholder="وش تغيّر في هذا الإصدار؟" data-po-field-note />
        </div>

        <h3 class="po-editor__section-title">معاينة JSON</h3>
        <pre class="po-editor__json" data-po-editor-json dir="ltr"></pre>
      </div>

      <footer class="po-modal__foot">
        <button type="button" class="po-btn po-btn--ghost" data-po-editor-close>إلغاء</button>
        <button type="button" class="po-btn po-btn--primary" data-po-editor-save>حفظ الإصدار</button>
      </footer>
    </div>
  </div>

  <!-- ═══ Modal: الإصدارات ═══ -->
  <div class="po-modal" data-po-versions-modal role="dialog" aria-modal="true" aria-labelledby="po-versions-title" hidden>
    <div class="po-modal__backdrop" data-po-versions-close></div>
    <div class="po-modal__panel po-modal__panel--wide">
      <header class="po-modal__head">
        <h2 class="po-modal__title" id="po-versions-title" data-po-versions-title>الإصدارات</h2>
        <button type="button" class="po-modal__close" data-po-versions-close aria-label="إغلاق">✕</button>
      </header>
      <div class="po-modal__body" data-po-versions-body>
        <p class="po-sim__empty">لا توجد إصدارات.</p>
      </div>
      <pre class="po-diff-output" data-po-diff-output dir="ltr"></pre>
    </div>
  </div>

  <!-- ═══ Modal: الاستثناءات ═══ -->
  <div class="po-modal" data-po-exc-modal role="dialog" aria-modal="true" aria-labelledby="po-exc-title" hidden>
    <div class="po-modal__backdrop" data-po-exc-close></div>
    <div class="po-modal__panel">
      <header class="po-modal__head">
        <h2 class="po-modal__title" id="po-exc-title" data-po-exc-title>الاستثناءات</h2>
        <button type="button" class="po-modal__close" data-po-exc-close aria-label="إغلاق">✕</button>
      </header>
      <div class="po-modal__body" data-po-exc-body>
        <p class="po-sim__empty">لا توجد استثناءات.</p>
      </div>
    </div>
  </div>

  {/* M17: data blob + module — نفس نمط redteam.astro */}
  <script type="application/json" id="policies-config" set:html={JSON.stringify(editorConfig)} />
  <script type="module" src="/js/kernel-policies.js"></script>
</KernelLayout>
