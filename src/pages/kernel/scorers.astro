---
/**
 * /kernel/scorers/ — Scorer Registry + Scorer Runner (M8).
 *
 * سجل الـ Scorers الثلاثة والثلاثين (دقة 8 · هلوسة 6 · PII 4 · حقن 9 ·
 * امتثال 6) + Runner تفاعلي يقيّم مدخلات/مخرجات على السجل كاملاً.
 *
 * القواعد (Prompt 09 / M8):
 *   - تسريب PII حرج (sc-pii-leakage) يمنع الجاهزية للإنتاج.
 *   - فشل أي Scorer يجعل الـ Run Incomplete.
 *   - لا تُعرض حالة Compliant بدون control mapping — سكوررز الامتثال
 *     مرتبطون بضوابط مرقّمة وإلا لا يمرون.
 *   - الدرجة (score) ليست بديلاً عن الدليل (evidence).
 *   - Live / Demo / Simulated واضح دائماً في كل نتيجة.
 *
 * المحرّك في /js/kernel-scorers.js (vanilla، CSP-safe، لا inline).
 * البيانات من src/data/kernel-scorers.ts تُحقن كـ JSON blob (#scorers-config).
 * التنسيق من kernel/assets/css/pages/scorers.css (side-effect import).
 * الإحصاءات تُعرض SSR من SCORER_STATS (قابلة للزحف)؛ السجل التفاعلي JS.
 * النصوص بالعامية السعودية. يحترم prefers-reduced-motion. الجزر dir="ltr".
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import KernelSkeleton from '../../components/kernel/KernelSkeleton.astro';
import { getKernelUnit, getCrossLinks, getKernelFaqJsonLd } from '../../data/kernel';
import { getKernelSubPageJsonLd } from '../../data/schema-helpers';
import {
  SCORER_REGISTRY,
  SCORER_FIXTURES,
  SCORER_STATS,
  SCORER_CATEGORY_LABELS,
  SCORER_CATEGORY_COLORS,
  SCORER_STATUS_LABELS,
  SCORER_SEVERITY_LABELS,
  SCORER_ENV_LABELS,
  EVALUATOR_TYPE_LABELS,
  PII_TYPE_LABELS,
  type ScorerCategory,
} from '../../data/kernel-scorers';

// تنسيق الصفحة (side-effect import).
import '../../../kernel/assets/css/pages/scorers.css';

const unit = getKernelUnit('scorers')!;
const cross = getCrossLinks(unit);
const jsonLd = [...getKernelSubPageJsonLd(unit), getKernelFaqJsonLd(unit)] as Array<Record<string, unknown> | null | undefined>;
const pageJsonLd = jsonLd as unknown as Record<string, unknown>;

const st = SCORER_STATS;
const categoryIds = Object.keys(SCORER_CATEGORY_LABELS) as ScorerCategory[];

// عدد المقيّمين في فئة معينة (استخدام في JSX).
const countByCategory = (cat: ScorerCategory): number => SCORER_STATS.byCategory[cat] ?? 0;

// إعدادات تُحقن للـ JS (لا استيراد TS في المتصفح).
const scorersConfig = {
  scorers: SCORER_REGISTRY,
  fixtures: SCORER_FIXTURES,
  labels: {
    categories: SCORER_CATEGORY_LABELS,
    statuses: SCORER_STATUS_LABELS,
    severities: SCORER_SEVERITY_LABELS,
    evaluators: EVALUATOR_TYPE_LABELS,
    piiTypes: PII_TYPE_LABELS,
    envs: SCORER_ENV_LABELS,
  },
};
---

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={pageJsonLd}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: unit.label, href: unit.path }]}
>
  {/* ── إعدادات للـ JS ── */}
  <script type="application/json" id="scorers-config" set:html={JSON.stringify(scorersConfig)} />

  <div class="kernel-main kernel-page-fade-in" data-sc-root data-kernel-loading data-kernel-count="1">
    {/* skeleton */}
    <div data-kernel-skeleton>
      <KernelSkeleton variant="heading" />
      <KernelSkeleton variant="card" count={3} />
    </div>

    {/* المحتوى الفعلي */}
    <div data-sc-content>
      <header class="sc-header">
        <div>
          <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
            <ol>
              <li><a href="/">BrightAI</a></li>
              <li><a href="/kernel/">Kernel</a></li>
              <li aria-current="page">{unit.label}</li>
            </ol>
          </nav>
          <h1 class="sc-header__title">{unit.h1}</h1>
          <p class="sc-header__sub">{unit.shortDescription}</p>
        </div>
        <div class="sc-header__badges">
          <span class="sc-env-badge sc-env-badge--demo">بيانات توضيحية · Demo</span>
          <span class="sc-env-badge sc-env-badge--sim">{st.simulatedCount} مقيّم Simulated</span>
          <span class="sc-env-badge sc-env-badge--live">Live: {st.liveCount}</span>
        </div>
      </header>

      {/* ═════════ القواعد الخمس الحاكمة ═════════ */}
      <section class="sc-rules" aria-label="القواعد الحاكمة للتقييم">
        <div class="sc-rule sc-rule--critical"><span class="sc-rule__icon" aria-hidden="true">⛔</span><span><strong>تسريب PII حرج يمنع الجاهزية للإنتاج.</strong> فشل sc-pii-leakage = Blocked، لا شهادة Passed.</span></div>
        <div class="sc-rule"><span class="sc-rule__icon" aria-hidden="true">⚠️</span><span><strong>فشل Scorer يجعل الـ Run Incomplete.</strong> أي فشل = تشغيل ناقص لا يُصدر شهادة.</span></div>
        <div class="sc-rule"><span class="sc-rule__icon" aria-hidden="true">🔗</span><span><strong>لا Compliant بدون control mapping.</strong> سكوررز الامتثال الستة مرتبطون بضوابط مرقّمة.</span></div>
        <div class="sc-rule"><span class="sc-rule__icon" aria-hidden="true">📎</span><span><strong>الدرجة ليست بديلاً عن الدليل.</strong> كل نتيجة تعرض الأدلة والتوصية والـ Trace.</span></div>
        <div class="sc-rule"><span class="sc-rule__icon" aria-hidden="true">🟢</span><span><strong>Live / Demo / Simulated واضح دائماً.</strong> شارة البيئة في كل نتيجة وملخص التشغيل.</span></div>
      </section>

      {/* ═════════ إحصاءات السجل (SSR) ═════════ */}
      <section class="sc-stats" aria-label="إحصاءات سجل الـ Scorers">
        <div class="sc-stats__head">
          <h2 class="sc-section-title">سجل الـ Scorers — {st.total} مقيّماً</h2>
          <span class="sc-stats__foot">33 مقيّماً عبر 5 فئات · {st.criticalScorers} حرجة · {st.complianceWithControls}/6 امتثال مرتبط بضوابط</span>
        </div>

        <div class="sc-kpi-grid">
          <div class="sc-kpi">
            <span class="sc-kpi__label">إجمالي المقيّمين</span>
            <strong class="sc-kpi__value" dir="ltr">{st.total}</strong>
            <span class="sc-kpi__foot">5 فئات · إصدارات v1</span>
          </div>
          <div class="sc-kpi sc-kpi--danger">
            <span class="sc-kpi__label">مقيّمون حرجون</span>
            <strong class="sc-kpi__value" dir="ltr">{st.criticalScorers}</strong>
            <span class="sc-kpi__foot">فشلهم يمنع الإنتاج</span>
          </div>
          <div class="sc-kpi">
            <span class="sc-kpi__label">امتثال بضوابط مرقّمة</span>
            <strong class="sc-kpi__value" dir="ltr">{st.complianceWithControls}/{countByCategory('compliance')}</strong>
            <span class="sc-kpi__foot">لا Compliant بدون mapping</span>
          </div>
          <div class="sc-kpi sc-kpi--warn">
            <span class="sc-kpi__label">مقيّمون Simulated</span>
            <strong class="sc-kpi__value" dir="ltr">{st.simulatedCount}</strong>
            <span class="sc-kpi__foot">llm-judge / hybrid / semantic — واضح في كل نتيجة</span>
          </div>
        </div>

        <div class="sc-cat-grid">
          {categoryIds.map((cat) => (
            <div class="sc-cat" data-sc-cat={cat}>
              <span class="sc-cat__name">{SCORER_CATEGORY_LABELS[cat]}</span>
              <span class="sc-cat__num"><em dir="ltr">{st.byCategory[cat]}</em> مقيّم</span>
              <span class="sc-cat__foot">عتبات {cat === 'pii' ? '95–100 (حرجة)' : cat === 'injection' ? '95–100 (حظر)' : cat === 'compliance' ? '85–90 + ضوابط' : '80–95'}</span>
            </div>
          ))}
        </div>
      </section>

      {/* ═════════ سجل الـ Scorers ═════════ */}
      <section class="sc-registry" aria-label="سجل الـ Scorers">
        <div class="sc-registry__head">
          <div>
            <h2 class="sc-section-title">السجل الكامل</h2>
            <p class="sc-registry__hint">اضغط على أي مقيّم لعرض تفاصيله: المدخلات، مدى المخرجات، الخطورة، العتبة، نوع المقيّم، متطلبات الدليل، وضوابط الامتثال.</p>
          </div>
        </div>

        <div class="sc-registry__toolbar">
          <label class="sc-search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input id="sc-search" type="search" placeholder="ابحث في الـ Scorers…" aria-label="بحث في الـ Scorers" autocomplete="off" />
          </label>
          <div class="sc-chips" role="group" aria-label="فلترة بالفئة">
            <button class="sc-chip" type="button" data-sc-cat-chip="all" aria-pressed="true">الكل</button>
            {categoryIds.map((cat) => (
              <button class="sc-chip" type="button" data-sc-cat-chip={cat} aria-pressed="false">{SCORER_CATEGORY_LABELS[cat]}</button>
            ))}
          </div>
        </div>

        <div class="sc-table-wrap" role="region" aria-label="جدول الـ Scorers" tabindex="0" data-dt-scroll>
          <table class="sc-table" data-dt>
            <thead>
              <tr>
                <th scope="col" data-dt-p="2">ID</th>
                <th scope="col" data-dt-p="1">الاسم</th>
                <th scope="col" data-dt-p="2">الفئة</th>
                <th scope="col" data-dt-p="3">الإصدار</th>
                <th scope="col" data-dt-p="2">الخطورة</th>
                <th scope="col" data-dt-p="3">العتبة</th>
                <th scope="col" data-dt-p="2">نوع المقيّم</th>
                <th scope="col" data-dt-p="2">ضوابط</th>
              </tr>
            </thead>
            <tbody id="sc-registry-body">
              {SCORER_REGISTRY.map((s) => (
                <tr data-sc-row={s.id} data-sc-category={s.category}>
                  <td data-dt-p="2" data-dt-label="ID"><code class="sc-row-id">{s.id}</code></td>
                  <td data-dt-p="1"><button class="sc-row-name" type="button" data-sc-action="open" data-sc-id={s.id}>{s.name}</button></td>
                  <td data-dt-p="2" data-dt-label="الفئة"><span class:list={['sc-cat-chip', `sc-cat-chip--${SCORER_CATEGORY_COLORS[s.category]}`]}>{SCORER_CATEGORY_LABELS[s.category]}</span></td>
                  <td data-dt-p="3" data-dt-label="الإصدار"><span dir="ltr">v{s.version}</span></td>
                  <td data-dt-p="2" data-dt-label="الخطورة"><span class:list={['sc-sev', `sc-sev--${s.severity}`]}>{SCORER_SEVERITY_LABELS[s.severity]}</span></td>
                  <td data-dt-p="3" data-dt-label="العتبة"><span class="sc-threshold">{s.threshold}</span></td>
                  <td data-dt-p="2" data-dt-label="نوع المقيّم"><span class="sc-eval">{EVALUATOR_TYPE_LABELS[s.evaluatorType]}</span></td>
                  <td data-dt-p="2" data-dt-label="ضوابط">{(s.controls?.length ?? 0) > 0 ? <span class="sc-eval">✓ {s.controls!.length} ضابط</span> : <span class="sc-eval">—</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {/* ═════════ تفاصيل الـ Scorer (JS) ═════════ */}
      <section class="sc-detail" id="sc-detail" aria-label="تفاصيل المقيّم" hidden>
        <div id="sc-detail-body"></div>
      </section>

      {/* ═════════ الـ Runner ═════════ */}
      <section class="sc-runner" id="sc-runner" aria-label="مشغّل الـ Scorers">
        <div class="sc-runner__head">
          <div>
            <h2 class="sc-section-title">مشغّل الـ Scorers (Scorer Runner)</h2>
            <p class="sc-registry__hint">اختر مثالاً أو الصق مدخلاً ومخرجات، ثم شغّل التقييم على السجل كاملاً. Demo بيئة — المقيّمون الحتميون (regex) يُنفَّذون فعلاً، والبقية Simulated بشارة واضحة.</p>
          </div>
          <span class="sc-env-badge sc-env-badge--demo">Demo · محلي بالكامل</span>
        </div>

        <div class="sc-fixtures" role="group" aria-label="أمثلة جاهزة">
          {SCORER_FIXTURES.map((f) => (
            <button class="sc-fixture" type="button" data-sc-fixture={f.id} aria-pressed={f.id === 'fx-safe'}>
              {f.name}
              <span class="sc-fixture__tag" aria-hidden="true">({f.sector})</span>
            </button>
          ))}
        </div>

        <div class="sc-runner__setup">
          <label class="sc-runner__card">
            <span class="sc-runner__card-label">المدخل (Prompt)</span>
            <textarea id="sc-input" dir="auto" spellcheck="false" placeholder="الصق الطلب الذي سيُقيَّم…"></textarea>
          </label>
          <label class="sc-runner__card">
            <span class="sc-runner__card-label">المخرجات (Output)</span>
            <textarea id="sc-output" dir="auto" spellcheck="false" placeholder="الصق مخرجات النموذج المُراد تقييمها…"></textarea>
          </label>
          <label class="sc-runner__card">
            <span class="sc-runner__card-label">المتوقع (Expected)</span>
            <textarea id="sc-expected" dir="auto" spellcheck="false" placeholder="السلوك المتوقع (اختياري للمقارنة)…"></textarea>
          </label>
        </div>

        <div class="sc-runner__actions">
          <button class="sc-btn sc-btn--primary" type="button" id="sc-run-btn">شغّل التقييم ▶</button>
          <button class="sc-btn sc-btn--ghost" type="button" id="sc-reset-btn">إعادة تعيين</button>
          <span class="sc-eval">يقيّم على {SCORER_REGISTRY.length} سكورر · النتائج حتمية وقابلة للتكرار (بذرة ثابتة)</span>
        </div>

        {/* نتائج الـ Run */}
        <div class="sc-run-results" id="sc-run-results" hidden>
          <div class="sc-run-summary" id="sc-run-summary" role="status" aria-live="polite"></div>
          <div id="sc-run-alerts"></div>
          <div class="sc-results-wrap" role="region" aria-label="نتائج التقييم" tabindex="0" data-dt-scroll data-dt-tall>
            <table class="sc-results-table" data-dt>
              <thead>
                <tr>
                  <th scope="col" data-dt-p="1">الحالة</th>
                  <th scope="col" data-dt-p="2">الدرجة</th>
                  <th scope="col" data-dt-p="3">المتوقع</th>
                  <th scope="col" data-dt-p="3">الفعلي</th>
                  <th scope="col" data-dt-p="2">الخطورة</th>
                  <th scope="col" data-dt-p="2">الشرح</th>
                  <th scope="col" data-dt-p="3">السياسة</th>
                  <th scope="col" data-dt-p="3">Trace</th>
                  <th scope="col" data-dt-p="2">التوصية</th>
                  <th scope="col" data-dt-p="2">الدليل</th>
                  <th scope="col" data-dt-p="2">البيئة</th>
                </tr>
              </thead>
              <tbody id="sc-results-body"></tbody>
            </table>
          </div>
        </div>
      </section>

      {/* SEO نصّي قابل للزحف */}
      <KernelSeoSection blocks={unit.seoBlocks} faq={unit.faq} faqHeading="أسئلة شائعة عن Scorer Registry" />

      <KernelContextLinks
        currentPath={unit.path}
        solutionPath={cross.solutionPath}
        docPath={cross.docPath ?? ''}
        blogPath={unit.blogPath}
        blogLabel={unit.blogLabel}
        relatedSlugs={unit.relatedSlugs}
      />
    </div>
  </div>

  {/* ═══════ توست ═══════ */}
  <div class="sc-toast" id="sc-toast" role="status" aria-live="polite" aria-atomic="true" hidden>
    <span class="sc-toast__msg" id="sc-toast-msg">تم.</span>
    <button class="sc-toast__close" type="button" id="sc-toast-close" aria-label="إغلاق">×</button>
  </div>

  <script type="module" src="/js/kernel-loading-state.js"></script>
  <script type="module" src="/js/kernel-scorers.js"></script>

  <style>
    /* مساعدة: الحاويات التفاعلية تبدأ مخفية حتى يحمّل JS. */
    .sc-detail[hidden] { display: none; }
    .sc-run-results[hidden] { display: none; }
    .sc-toast[hidden] { display: none; }
  </style>
</KernelLayout>
