---
/**
 * /kernel/api/ — وحدة المطوّر (design spec §16).
 *
 * وثيقة تقنية ثلاثية الأعمدة:
 *   الشجرة الجانبية (أقسام + نقاط طرفية) | المحتوى (المعاملات/الاستجابة/الأخطاء)
 *   | لوحة الكود الحية (cURL / Python / TypeScript) + زر تشغيل.
 *
 * فوق الطية: بطاقة مفتاح تجريبي (يولَّد فوراً بلا تسجيل، 98/100 طلب متبقٍّ).
 * أقسام: نقاط طرفية · فاحص Webhook · دفتر الأخطاء · دليل الترحيل · حالة الخدمة
 *   (شبكة 90 يوماً) · سجل الإصدارات.
 *
 * vanilla JS فقط (لا مكتبات خارجية). RTL كامل مع جزر LTR للكود والهاش.
 * البيانات كلها توضيحية موسومة Demo (المبدأ الخامس: الصدق التصميمي).
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelLeadForm from '../../components/kernel/KernelLeadForm.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import { getKernelUnit, getCrossLinks, getKernelFaqJsonLd } from '../../data/kernel';
import { getKernelSubPageJsonLd } from '../../data/schema-helpers';
import '../../../kernel/assets/css/pages/api.css';

const unit = getKernelUnit('api')!;
const cross = getCrossLinks(unit);

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@graph': [
    ...getKernelSubPageJsonLd(unit),
    ...(getKernelFaqJsonLd(unit) ? [getKernelFaqJsonLd(unit)] : []),
  ].filter(Boolean) as Record<string, unknown>[],
};

// ── المفتاح التجريبي (بيانات توضيحية) ──────────────────────────────────────
const DEMO_KEY = 'br_k_demo_a7c8f2e9d41b';
const DEMO_REMAINING = 98;
const DEMO_LIMIT = 100;

// ── النقاط الطرفية (توثيق) ─────────────────────────────────────────────────
const endpoints = [
  {
    id: 'inspect',
    method: 'POST',
    path: '/v1/guard/inspect',
    title: 'فحص طلب قبل الإرسال للنموذج',
    desc: 'يرسل الطلب عبر طبقات الحوكمة: فحص PII، تقييم المخاطر، مطابقة السياسات. يرجّع الحكم النهائي (allow / review / block) مع Trace ID للتوثيق في سجل التدقيق.',
    params: [
      { name: 'text', type: 'string', required: true, desc: 'نص الطلب المراد فحصه (UTF-8).' },
      { name: 'context', type: 'object', required: false, desc: 'سياق الطلب: القسم، الدور، الحساسية، النموذج.' },
      { name: 'policies', type: 'string[]', required: false, desc: 'معرّفات السياسات المفعلة. الافتراضي: كل السياسات النشطة.' },
    ],
    response: [
      { name: 'trace_id', type: 'string', desc: 'Trace ID فريد — يستخدم للاستعلام من /kernel/audit/.' },
      { name: 'risk_score', type: 'integer', desc: 'درجة المخاطر 0-100.' },
      { name: 'verdict', type: 'string', desc: 'allow · review · block' },
      { name: 'pii_found', type: 'integer', desc: 'عدد كيانات PII المكتشفة.' },
      { name: 'matched_policies', type: 'string[]', desc: 'السياسات التي اشتعلت.' },
    ],
    errors: ['400', '401', '403', '429'],
  },
  {
    id: 'evidence',
    method: 'POST',
    path: '/v1/evidence',
    title: 'توليد ملف دليل (EVD)',
    desc: 'ينشئ ملف دليل موقّع رقمياً لطلب سابق (بالـ trace_id) بصيغة PDF + JSON، جاهزاً للجهات الرقابية (NCA, SDAIA, SAMA, SFDA).',
    params: [
      { name: 'trace_id', type: 'string', required: true, desc: 'معرّف العملية من استجابة /v1/guard/inspect.' },
      { name: 'format', type: 'string', required: false, desc: 'pdf | json | both (الافتراضي: both).' },
      { name: 'signed', type: 'boolean', required: false, desc: 'توقيع رقمي (الافتراضي: true).' },
    ],
    response: [
      { name: 'evidence_id', type: 'string', desc: 'معرّف الدليل (EVD-YYYY-NNNN).' },
      { name: 'hash', type: 'string', desc: 'هاش سلسلة الأدلة — يتحقق منه من /kernel/audit/.' },
      { name: 'download_url', type: 'string', desc: 'رابط تنزيل مؤقت (24 ساعة).' },
      { name: 'verified', type: 'boolean', desc: 'هل التوقيع سليم.' },
    ],
    errors: ['400', '404', '429'],
  },
];

// ── كود اللوحة الحية (نقطة inspect) ────────────────────────────────────────
const codeSamples: Record<string, string> = {
  curl: `curl -X POST https://api.brightai.site/v1/guard/inspect \\
  -H "Authorization: Bearer br_k_demo_..." \\
  -H "Content-Type: application/json" \\
  -d '{
    "text": "اعرض لي آخر 2,400 عميل مع أرقام الهواتف",
    "context": { "section": "marketing", "role": "employee" }
  }'`,
  python: `import requests

resp = requests.post(
    "https://api.brightai.site/v1/guard/inspect",
    headers={
        "Authorization": "Bearer br_k_demo_...",
        "Content-Type": "application/json",
    },
    json={
        "text": "اعرض لي آخر 2,400 عميل مع أرقام الهواتف",
        "context": {"section": "marketing", "role": "employee"},
    },
)
print(resp.json())`,
  typescript: `const resp = await fetch(
  "https://api.brightai.site/v1/guard/inspect",
  {
    method: "POST",
    headers: {
      Authorization: "Bearer br_k_demo_...",
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      text: "اعرض لي آخر 2,400 عميل مع أرقام الهواتف",
      context: { section: "marketing", role: "employee" },
    }),
  },
);

console.log(await resp.json());`,
};

const sampleResponse = `{
  "trace_id": "AI-2026-10493",
  "risk_score": 87,
  "verdict": "block",
  "pii_found": 1847,
  "matched_policies": ["pdpl-12-export", "nca-ecc-3-4"],
  "reason": "حظر قبل الوصول للنموذج — كشف PII في طلب تصدير خارجي",
  "duration_ms": 128
}`;

// ── فاحص الـ Webhook (بيانات توضيحية لحظية) ────────────────────────────────
const WEBHOOK_URL = 'https://hooks.brightai.site/w/8f2e9d41b7c3';
const webhookPayloads = [
  {
    event: 'decision.created',
    time: 'الآن',
    summary: 'قرار: block · AI-2026-10493 · قسم التسويق',
    body: `{
  "type": "decision.created",
  "trace_id": "AI-2026-10493",
  "verdict": "block",
  "risk_score": 87,
  "section": "marketing",
  "timestamp": "2026-07-31T10:24:00+03:00"
}`,
  },
  {
    event: 'approval.requested',
    time: 'قبل 2د',
    summary: 'طلب موافقة: review · AI-2026-10491 · قسم الموارد البشرية',
    body: `{
  "type": "approval.requested",
  "trace_id": "AI-2026-10491",
  "verdict": "review",
  "risk_score": 62,
  "section": "hr",
  "approver": "DPO",
  "timestamp": "2026-07-31T10:22:00+03:00"
}`,
  },
  {
    event: 'evidence.generated',
    time: 'قبل 12د',
    summary: 'دليل جديد: EVD-2026-10492 · PDF موقّع',
    body: `{
  "type": "evidence.generated",
  "evidence_id": "EVD-2026-10492",
  "hash": "0xa7c8f2e9d41b",
  "signed": true,
  "timestamp": "2026-07-31T10:12:00+03:00"
}`,
  },
];

// ── دفتر الأخطاء ───────────────────────────────────────────────────────────
const errorBook = [
  { code: '400', meaning: 'طلب غير صالح — معامل ناقص أو نص فارغ.', fix: 'راجع جدول المعاملات وأرسل كل الحقول الإلزامية.', example: '{"error":"invalid_request","message":"field text is required"}' },
  { code: '401', meaning: 'مفتاح غير صحيح أو منتهي.', fix: 'تحقق من رأس Authorization وصحة المفتاح التجريبي.', example: '{"error":"unauthorized","message":"invalid api key"}' },
  { code: '403', meaning: 'حظره الحوكمة قبل الوصول للنموذج.', fix: 'هذا سلوك مقصود: افحص reason وmatched_policies في الاستجابة.', example: '{"error":"forbidden","verdict":"block","reason":"PII export blocked"}' },
  { code: '404', meaning: 'المورد غير موجود — trace_id خاطئ.', fix: 'تأكد من الـ trace_id المنسوخ من سجل التدقيق.', example: '{"error":"not_found","message":"trace not found"}' },
  { code: '429', meaning: 'تجاوزت حصة الطلبات.', fix: 'المفتاح التجريبي يسمح 100 طلب. انتظر تجديد الحصة أو اطلب باقة.', example: '{"error":"rate_limited","retry_after":60}' },
  { code: '500', meaning: 'خطأ خادم داخلي.', fix: 'أعد المحاولة بعد 30 ثانية. لو تكرر، أبلغ عبر صفحة الاتصال.', example: '{"error":"internal","message":"temporary outage"}' },
];

// ── دليل الترحيل ───────────────────────────────────────────────────────────
const migrationSteps = [
  {
    title: '1. وجّه حركة المرور لـ Kernel',
    before: 'fetch("https://api.openai.com/v1/chat/completions", ...)',
    after: 'fetch("https://api.brightai.site/v1/guard/inspect", ...)',
    note: 'بدّل نقطة النهاية من المزوّد مباشرة إلى بوابة الحوكمة. نفس فكرة الـ proxy.',
  },
  {
    title: '2. مرّر السياق عبر معامل context',
    before: 'body: JSON.stringify({ prompt })',
    after: 'body: JSON.stringify({ text: prompt, context: { section, role } })',
    note: 'السياق (القسم، الدور) يحسّن دقة تقييم المخاطر والسياسات.',
  },
  {
    title: '3. اقرأ الحكم قبل تنفيذ أي شيء',
    before: 'const answer = await resp.json(); sendToUI(answer)',
    after: 'const { verdict } = await resp.json(); if (verdict === "allow") sendToUI(...)',
    note: 'لا تكمل أبداً لو verdict !== allow — هذي هي نقطة القوة في Kernel.',
  },
];

// ── حالة الخدمة (90 يوماً — شبكة 10×9) ─────────────────────────────────────
const uptimeCells = Array.from({ length: 90 }, (_, i) => {
  if (i % 47 === 0) return 'down';
  if (i % 13 === 0) return 'degraded';
  return 'ok';
});

// ── سجل الإصدارات ──────────────────────────────────────────────────────────
const releases = [
  { version: 'v3.7.0', date: '2026-07-20', note: 'فاحص Webhook حي + دعم حمولات متعددة. تحسين توقيع HMAC-SHA256.' },
  { version: 'v3.6.0', date: '2026-06-28', note: 'نقطة /v1/evidence مع توقيع رقمي وتوليد PDF فوري.' },
  { version: 'v3.5.2', date: '2026-06-02', note: 'تسريع /v1/guard/inspect — متوسط 128ms (كان 220ms).' },
  { version: 'v3.5.0', date: '2026-05-15', note: 'معامل policies في inspect — تفعيل سياسات محددة لكل طلب.' },
];

// ── سردية لوحة الكود (تنقّل بالأسهم) ───────────────────────────────────────
const navSections = [
  { id: 'endpoints', label: 'نقاط الطرفية' },
  { id: 'webhook', label: 'فاحص Webhook' },
  { id: 'errors', label: 'دفتر الأخطاء' },
  { id: 'migration', label: 'دليل الترحيل' },
  { id: 'status', label: 'حالة الخدمة' },
  { id: 'releases', label: 'سجل الإصدارات' },
];
---

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  ogImage={unit.ogImage}
  jsonLd={jsonLd}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: 'المطوّر', href: unit.path }]}
  extraSpeakableSelectors={['.answer-first-summary']}
>
  <div class="kernel-main kernel-page-fade-in">
    <header class="kernel-api__header">
      <div class="kernel-api__header-lead">
        <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
          <ol>
            <li><a href="/">BrightAI</a></li>
            <li><a href="/kernel/">Kernel</a></li>
            <li aria-current="page">{unit.label}</li>
          </ol>
        </nav>
        <h1 class="kernel-api__title">{unit.h1}</h1>
        <p class="answer-first-summary" data-speakable-target="answer-first">واجهة مطوّر لربط Kernel بمنشأتك: مفتاح تجريبي فوري، نقاط طرفية REST موثقة (فحص طلب، توليد دليل)، عارض Webhook حي، دفتر أخطاء بالعربي، ودليل ترحيل. أول طلب ناجح خلال دقائق.</p>
        <p class="kernel-api__subtitle">{unit.shortDescription}</p>
      </div>
      <KernelDemoPill />
    </header>

    {/* ═══ بطاقة المفتاح التجريبي (فوق الطية) ═══ */}
    <section class="kernel-api-key" aria-labelledby="demo-key-title">
      <div class="kernel-api-key__label" id="demo-key-title">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
        مفتاحك التجريبي
      </div>
      <code class="kernel-api-key__code" id="demo-key" dir="ltr">br_k_demo_••••••••••••</code>
      <div class="kernel-api-key__actions">
        <button type="button" class="kernel-api__run-btn" data-reveal-key>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          كشف المفتاح
        </button>
        <button type="button" class="kernel-api__copy-btn" data-copy-key aria-label="نسخ المفتاح">نسخ</button>
      </div>
      <div class="kernel-api-key__quota">
        <span>المتبقي</span>
        <span class="kernel-api-key__quota-bar" aria-hidden="true"><span class="kernel-api-key__quota-fill"></span></span>
        <span dir="ltr" style="font-variant-numeric: tabular-nums;">{DEMO_REMAINING}/{DEMO_LIMIT} طلب</span>
      </div>
    </section>

    {/* ═══ التخطيط الثلاثي ═══ */}
    <div class="kernel-api__layout">
      {/* العمود الأول: شجرة التنقل */}
      <nav class="kernel-api__nav" aria-label="أقسام وحدة المطوّر">
        <p class="kernel-api__nav-title">على هذه الصفحة</p>
        <ul class="kernel-api__nav-list">
          {navSections.map(s => (
            <li><a href={`#${s.id}`} class="kernel-api__nav-link" data-nav-link={s.id}>{s.label}</a></li>
          ))}
        </ul>
      </nav>

      {/* العمود الأوسط: المحتوى */}
      <div class="kernel-api__content">
        {/* نقاط الطرفية */}
        <section class="kernel-api__section" id="endpoints" aria-labelledby="endpoints-title">
          <h2 class="kernel-api__section-title" id="endpoints-title">نقاط الطرفية</h2>
          {endpoints.map(ep => (
            <article class="kernel-api__endpoint" id={`ep-${ep.id}`}>
              <header class="kernel-api__endpoint-head">
                <span class:list={['kernel-api__method', `kernel-api__method--${ep.method.toLowerCase()}`]}>{ep.method}</span>
                <code class="kernel-api__path" dir="ltr">{ep.path}</code>
              </header>
              <p class="kernel-api__endpoint-desc">{ep.desc}</p>

              <h3 class="kernel-api__subhead">المعاملات</h3>
              <table class="kernel-api__table">
                <thead>
                  <tr><th scope="col">المعامل</th><th scope="col">النوع</th><th scope="col">إلزامي</th><th scope="col">الوصف</th></tr>
                </thead>
                <tbody>
                  {ep.params.map(p => (
                    <tr>
                      <td><code dir="ltr">{p.name}</code></td>
                      <td><code dir="ltr">{p.type}</code></td>
                      <td>{p.required ? 'نعم' : 'لا'}</td>
                      <td>{p.desc}</td>
                    </tr>
                  ))}
                </tbody>
              </table>

              <h3 class="kernel-api__subhead">الاستجابة</h3>
              <table class="kernel-api__table">
                <thead>
                  <tr><th scope="col">الحقل</th><th scope="col">النوع</th><th scope="col">الوصف</th></tr>
                </thead>
                <tbody>
                  {ep.response.map(r => (
                    <tr>
                      <td><code dir="ltr">{r.name}</code></td>
                      <td><code dir="ltr">{r.type}</code></td>
                      <td>{r.desc}</td>
                    </tr>
                  ))}
                </tbody>
              </table>

              <h3 class="kernel-api__subhead">الأخطاء</h3>
              <p class="kernel-api__endpoint-desc" style="margin-block-end: 0;">{ep.errors.map(c => <code dir="ltr" style="margin-inline-end: var(--space-2);">{c}</code>)} — التفاصيل في دفتر الأخطاء أدناه.</p>
            </article>
          ))}
        </section>

        {/* فاحص الـ Webhook */}
        <section class="kernel-api__section" id="webhook" aria-labelledby="webhook-title">
          <h2 class="kernel-api__section-title" id="webhook-title">فاحص الـ Webhook</h2>
          <p class="kernel-api__endpoint-desc">سجّل هذا الرابط في لوحة المطوّر، وستستقبل أحداث Kernel لحظياً. الحمولة الجديدة تُميَّز بومضة. اضغط أي صف لتوسيعه.</p>
          <code class="kernel-api__webhook-url" dir="ltr">{WEBHOOK_URL}</code>
          <ul class="kernel-api__payload-list" id="webhook-list" aria-label="الحمولات الواردة">
            {webhookPayloads.map((p, i) => (
              <li class:list={['kernel-api__payload', i === 0 ? 'is-new' : '']} data-payload>
                <span class="kernel-api__payload-event" dir="ltr">{p.event}</span>
                <span class="kernel-api__payload-summary">{p.summary}</span>
                <span class="kernel-api__payload-time">{p.time}</span>
                <pre class="kernel-api__payload-body" dir="ltr" set:html={p.body}></pre>
              </li>
            ))}
          </ul>
        </section>

        {/* دفتر الأخطاء */}
        <section class="kernel-api__section" id="errors" aria-labelledby="errors-title">
          <h2 class="kernel-api__section-title" id="errors-title">دفتر الأخطاء</h2>
          <table class="kernel-api__table">
            <thead>
              <tr><th scope="col">الرمز</th><th scope="col">المعنى بالعربي</th><th scope="col">الحل</th></tr>
            </thead>
            <tbody>
              {errorBook.map(e => (
                <tr>
                  <td><code dir="ltr">{e.code}</code></td>
                  <td>{e.meaning}</td>
                  <td>{e.fix}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        {/* دليل الترحيل */}
        <section class="kernel-api__section" id="migration" aria-labelledby="migration-title">
          <h2 class="kernel-api__section-title" id="migration-title">دليل الترحيل</h2>
          <p class="kernel-api__endpoint-desc">ثلاث خطوات لتحويل تطبيقك من الاتصال المباشر بالنموذج إلى مرور الحوكمة عبر Kernel.</p>
          {migrationSteps.map(m => (
            <article class="kernel-api__endpoint">
              <h3 class="kernel-api__endpoint-desc" style="margin-block-end: var(--space-2); font-weight: var(--font-semibold); color: var(--text-primary);">{m.title}</h3>
              <p class="kernel-api__endpoint-desc">{m.note}</p>
              <pre class="kernel-api__codeblock" dir="ltr" style="background: var(--k-ink-950, #080d16);"><code>قبل:  {m.before}

بعد:  {m.after}</code></pre>
            </article>
          ))}
        </section>

        {/* حالة الخدمة */}
        <section class="kernel-api__section" id="status" aria-labelledby="status-title">
          <h2 class="kernel-api__section-title" id="status-title">حالة الخدمة — آخر 90 يوماً</h2>
          <div class="kernel-api__uptime-grid" role="img" aria-label="شبكة حالة الخدمة: 90 يوماً، خضراء متاحة، عنبرية تدهور، حمراء انقطاع">
            {uptimeCells.map(c => (
              <span class:list={['kernel-api__uptime-cell', c === 'down' ? 'kernel-api__uptime-cell--down' : '', c === 'degraded' ? 'kernel-api__uptime-cell--degraded' : '']}></span>
            ))}
          </div>
          <p class="kernel-api__uptime-legend">
            <span class="ok">متاح</span>
            <span class="degraded">تدهور</span>
            <span class="down">انقطاع</span>
            <span dir="ltr" style="font-variant-numeric: tabular-nums;">99.95%</span>
          </p>
        </section>

        {/* سجل الإصدارات */}
        <section class="kernel-api__section" id="releases" aria-labelledby="releases-title">
          <h2 class="kernel-api__section-title" id="releases-title">سجل الإصدارات</h2>
          <ol class="kernel-api__releases">
            {releases.map(r => (
              <li class="kernel-api__release">
                <span class="kernel-api__release-version" dir="ltr">{r.version}</span>
                <span class="kernel-api__release-date" dir="ltr"> · {r.date}</span>
                <p class="kernel-api__release-note">{r.note}</p>
              </li>
            ))}
          </ol>
        </section>
      </div>

      {/* العمود الأخير: لوحة الكود الحية */}
      <aside class="kernel-api__panel" aria-label="لوحة الكود الحية">
        <header class="kernel-api__panel-head">
          <span class="kernel-api__panel-title">لوحة الكود الحية</span>
          <button type="button" class="kernel-api__copy-btn" data-copy-code aria-label="نسخ الكود">نسخ الكود</button>
        </header>
        <div class="kernel-api__langs" role="tablist" aria-label="لغة الكود">
          <button type="button" role="tab" aria-selected="true" class="kernel-api__lang is-active" data-lang="curl">cURL</button>
          <button type="button" role="tab" aria-selected="false" class="kernel-api__lang" data-lang="python">Python</button>
          <button type="button" role="tab" aria-selected="false" class="kernel-api__lang" data-lang="typescript">TypeScript</button>
        </div>
        <pre class="kernel-api__codeblock" id="code-output" dir="ltr" set:html={codeSamples.curl}></pre>
        <button type="button" class="kernel-api__run-btn" data-run-code>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          شغّل ◀
        </button>
        <pre class="kernel-api__response" id="code-response" dir="ltr" hidden set:html={sampleResponse}></pre>
      </aside>
    </div>
  </div>

  {/* Lead capture */}
  <section class="kernel-lead-section inner-section inner-section--alt" aria-labelledby="lead-form-h2-api">
    <div class="max-w-3xl mx-auto px-5">
      <h2 id="lead-form-h2-api" class="inner-section__title inner-section__title--centered">تبي تربط Kernel بمنشأتك؟</h2>
      <p class="inner-section__lead inner-section__lead--centered">فريق المطوّرين يرسل لك دليل ربط كامل بمفتاح دائم خلال 24 ساعة.</p>
      <KernelLeadForm id="kernel-lead-form-api" page="/kernel/api/" />
    </div>
  </section>

  {/* SEO content + FAQ — server-rendered for crawlers */}
  <KernelSeoSection
    id="kernel-seo-api"
    heading="دليل حوكمة AI — سياق إضافي عن وحدة المطوّر"
    blocks={unit.seoBlocks}
    faq={unit.faq}
  />

  {/* Cross-links: kernel ↔ kernel + solution + doc + blog */}
  <KernelContextLinks
    currentPath={unit.path}
    solutionPath={cross.solutionPath}
    docPath={cross.docPath ?? ''}
    blogPath={cross.blogPath}
    blogLabel={unit.blogLabel}
    relatedSlugs={unit.relatedSlugs}
  />

  <script is:inline define:vars={{ codeSamples, DEMO_KEY, sampleResponse }}>
    // /kernel/api/ — التفاعل (vanilla JS, CSP-safe: define:vars).
    (function () {
      'use strict';

      // كشف/نسخ المفتاح التجريبي
      var keyEl = document.getElementById('demo-key');
      var revealBtn = document.querySelector('[data-reveal-key]');
      var copyKeyBtn = document.querySelector('[data-copy-key]');
      if (keyEl && revealBtn) {
        revealBtn.addEventListener('click', function () {
          keyEl.textContent = DEMO_KEY;
          keyEl.classList.add('is-revealed');
          if (copyKeyBtn) {
            copyKeyBtn.addEventListener('click', function () {
              try {
                navigator.clipboard.writeText(DEMO_KEY);
                copyKeyBtn.textContent = 'نُسخ ✓';
                setTimeout(function () { copyKeyBtn.textContent = 'نسخ'; }, 2000);
              } catch (e) { /* clipboard غير متاح */ }
            });
          }
        });
      }

      // مبدّل لغات الكود + نسخ + تشغيل
      var codeOut = document.getElementById('code-output');
      var codeResp = document.getElementById('code-response');
      var copyCodeBtn = document.querySelector('[data-copy-code]');
      var runBtn = document.querySelector('[data-run-code]');
      var langs = Array.prototype.slice.call(document.querySelectorAll('[data-lang]'));

      function currentCode() {
        var active = document.querySelector('[data-lang].is-active');
        var lang = active ? active.getAttribute('data-lang') : 'curl';
        return codeSamples[lang] || '';
      }

      if (langs.length && codeOut) {
        langs.forEach(function (btn) {
          btn.addEventListener('click', function () {
            langs.forEach(function (b) {
              b.classList.remove('is-active');
              b.setAttribute('aria-selected', 'false');
            });
            btn.classList.add('is-active');
            btn.setAttribute('aria-selected', 'true');
            codeOut.textContent = currentCode();
          });
        });
      }

      if (copyCodeBtn && codeOut) {
        copyCodeBtn.addEventListener('click', function () {
          try {
            navigator.clipboard.writeText(codeOut.textContent || '');
            copyCodeBtn.textContent = 'نُسخ ✓';
            setTimeout(function () { copyCodeBtn.textContent = 'نسخ الكود'; }, 2000);
          } catch (e) { /* clipboard غير متاح */ }
        });
      }

      if (runBtn && codeResp && codeOut) {
        runBtn.addEventListener('click', function () {
          runBtn.disabled = true;
          runBtn.textContent = 'جارٍ التنفيذ…';
          setTimeout(function () {
            codeResp.hidden = false;
            runBtn.disabled = false;
            runBtn.textContent = 'شغّل ◀';
            codeResp.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }, 700);
        });
      }

      // فاحص الـ Webhook: توسيع الحمولات
      var payloads = Array.prototype.slice.call(document.querySelectorAll('[data-payload]'));
      payloads.forEach(function (li) {
        li.addEventListener('click', function () {
          li.classList.toggle('is-open');
        });
      });

      // تمييز قسم الشجرة الحالي أثناء التمرير
      var links = Array.prototype.slice.call(document.querySelectorAll('[data-nav-link]'));
      if ('IntersectionObserver' in window && links.length) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var id = entry.target.getAttribute('id');
              links.forEach(function (l) {
                l.classList.toggle('is-active', l.getAttribute('data-nav-link') === id);
              });
            }
          });
        }, { rootMargin: '-20% 0px -70% 0px' });
        links.forEach(function (l) {
          var sec = document.getElementById(l.getAttribute('data-nav-link') || '');
          if (sec) observer.observe(sec);
        });
      }
    })();
  </script>
</KernelLayout>
