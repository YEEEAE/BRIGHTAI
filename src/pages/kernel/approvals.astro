---
/**
 * /kernel/approvals/ — Human-in-the-loop approvals queue (M19 build).
 *
 * M19 (2026-08-01) — replaces the old REPORTS-15 tabs/cards/demo page with the
 * queue list/detail design from تصميم-صفحات-kernel.md §8:
 *   - Five status filter cards (7 معلقة · 3 حرجة · 2 مراجعة · 142 موافقة · 8 رفض),
 *     clickable as filters; the active one gets a colored border.
 *   - List/detail: right column (380px) = request cards, left = detail panel.
 *   - Request card: 3px risk border · 40px mini risk counter · 2-line title ·
 *     requester + dept · thin decreasing SLA bar (red under 20%) · trace badge.
 *   - Detail panel: full request · colorized PII findings · triggered policies ·
 *     "ماذا لو وافقت" impact card (3 points) · mandatory reason on reject with
 *     auto-suggest · three big buttons: وافق / ارفض / حوّل.
 *   - Keyboard batch: J/K move, A approve, R reject, F transfer, Space preview,
 *     ? toggles the shortcuts hint.
 *
 * Immutable rule (Prompt 20): every decision appends a NEW Audit event to the
 * on-page decision ledger ([data-kap-ledger]) that links Audit · Trace ·
 * Evidence · Certificate. The sealed hash chain in kernel-approvals-data.js is
 * never mutated.
 *
 * Determinism contract (verified by scripts/verify-approvals.mjs):
 *   total = 162 · pending = 7 · critical = 3 · review = 2 · approved = 142
 *   rejected = 8 · chain genesis 0x00000000 · final hash 0x90e4c4c8.
 *
 * Scripts (CSP-safe, external only):
 *   /js/kernel-approvals-data.js  → classic UMD, exposes window.KernelApprovalsData
 *   /js/kernel-approvals.js       → ES module engine (worker + main-thread fallback)
 *   /js/kernel-loading-state.js   → skeleton/loading transition
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelLeadForm from '../../components/kernel/KernelLeadForm.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import { getKernelUnit, getCrossLinks, getKernelFaqJsonLd } from '../../data/kernel';
import { getKernelSubPageJsonLd } from '../../data/schema-helpers';
import KernelSkeleton from '../../components/kernel/KernelSkeleton.astro';
import KernelEmptyState from '../../components/kernel/KernelEmptyState.astro';
import { buildApprovalStats } from '../../data/kernel-approvals';

const unit = getKernelUnit('approvals')!;
const cross = getCrossLinks(unit);

// Deterministic baseline — computed at build time, byte-identical to the
// client dataset (kernel-approvals-data.js). SSR'd into the filter cards.
const stats = buildApprovalStats();

const jsonLd = [
  ...getKernelSubPageJsonLd(unit),
  ...(getKernelFaqJsonLd(unit) ? [getKernelFaqJsonLd(unit)] : []),
].filter((item): item is Record<string, unknown> => Boolean(item));

const iconClose = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
const iconSearch = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>';
const iconKeyboard = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M6 14h.01M18 14h.01"/><path d="M9 14h6"/></svg>';

// Status filter cards — engine reads data-kap-filter + data-kap-filter-count.
// The status class (--pending/--critical/…) selects the active border color.
const FILTERS = [
  { id: 'pending',   label: 'معلقة',       count: stats.pending },
  { id: 'critical',  label: 'حرجة',        count: stats.critical },
  { id: 'review',    label: 'قيد المراجعة', count: stats.review },
  { id: 'approved',  label: 'موافقة',      count: stats.approved },
  { id: 'rejected',  label: 'رفض',         count: stats.rejected },
];

const fmtCount = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
---

<style>
  /*
   * Mobile-first + RTL baseline for Approvals (kernel championship).
   * Logical properties (RTL-safe), ≥44px touch targets, responsive breakpoints,
   * and empty/loading state styles. Uses design tokens.
   * NOTE: the queue/list + detail + filter-card + ledger styles live in
   * src/styles/kernel.css (block 24) so they stay consistent with the kernel pages.
   */
  .kernel-ap__empty-state,
  .kernel-ap-empty-state {
    padding-inline: var(--space-6);
    margin-inline: auto;
    text-align: start;
    color: var(--text-muted);
    border-inline-start: 3px solid var(--interactive-primary);
  }
  .kernel-ap__skeleton,
  .kernel-ap-skeleton {
    inset-inline-start: 0;
    background: var(--bg-elevated);
    animation: kernel-ap-shimmer 1.4s var(--ease-in-out) infinite;
  }
  @keyframes kernel-ap-shimmer {
    0% { opacity: 1; }
    50% { opacity: 0.45; }
    100% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kernel-ap-skeleton { animation: none; }
  }

  /* Empty state (engine toggles via data-kap-empty) */
  .kernel-ap-empty-state[hidden] { display: none; }
  .kernel-ap-empty-state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-8);
    padding-inline: var(--space-6);
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    border-inline-start: 3px solid var(--interactive-primary);
  }
  .kernel-ap-empty-state__title { margin: 0; font-size: var(--text-lg); color: var(--text-primary); }
  .kernel-ap-empty-state__hint { margin: 0; color: var(--text-secondary); }
  .kernel-ap-empty-state__reset {
    min-block-size: 44px;
    min-inline-size: 44px;
    padding-inline: var(--space-5);
    padding-block: var(--space-2);
    border: 1px solid var(--interactive-primary);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--interactive-primary);
    cursor: pointer;
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }
  .kernel-ap-empty-state__reset:hover { background: var(--bg-elevated); }

  /* Toolbar: search */
  .kernel-ap-toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-end: var(--space-4);
  }
  .kernel-ap-toolbar__search {
    position: relative;
    flex: 1;
    min-inline-size: 0;
  }
  .kernel-ap-toolbar__search-icon {
    position: absolute;
    inset-inline-start: var(--space-3);
    inset-block-start: 50%;
    transform: translateY(-50%);
    inline-size: 18px;
    block-size: 18px;
    color: var(--text-muted);
    pointer-events: none;
  }
  .kernel-ap-toolbar__input {
    inline-size: 100%;
    min-block-size: 44px;
    padding-inline-start: var(--space-10);
    padding-inline-end: var(--space-4);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: inherit;
    font-size: var(--text-sm);
  }
  .kernel-ap-toolbar__input:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 1px;
  }
  .kernel-ap-toolbar__total {
    flex-shrink: 0;
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* Shortcuts hint button */
  .kernel-ap-shortcuts-btn {
    flex-shrink: 0;
    min-block-size: 44px;
    min-inline-size: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding-inline: var(--space-3);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-family: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .kernel-ap-shortcuts-btn:hover { background: var(--bg-elevated); color: var(--text-primary); }
  .kernel-ap-shortcuts-btn:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
  }

  /* Ledger heading */
  .kernel-ap-ledger-wrap {
    margin-block-start: var(--space-6);
  }
  .kernel-ap-ledger-title {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--text-primary);
  }
  .kernel-ap-ledger-desc {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Loading state: hide content while skeleton is visible */
  [data-kernel-loading] > *:not([data-kernel-skeleton]):not([data-kernel-empty]) {
    display: none;
  }
  .kernel-loading-skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
</style>

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd as any}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: 'الموافقات', href: unit.path }]}
  extraSpeakableSelectors={['.answer-first-summary']}
>
  <header class="kernel-page-header">
    <div class="kernel-page-header__lead">
      <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
        <ol>
          <li><a href="/">BrightAI</a></li>
          <li><a href="/kernel/">Kernel</a></li>
          <li aria-current="page">{unit.label}</li>
        </ol>
      </nav>
      <h1 class="kernel-page-header__title">{unit.h1}</h1>
      {/* BAI-VOC-001-B (2026-07-18): answer-first summary — wired as the
          second cssSelector for WebPage SpeakableSpecification. */}
      <p class="answer-first-summary" data-speakable-target="answer-first">موافقات بشرية منظمة على قرارات AI عالية المخاطر: ترتيب حسب درجة المخاطرة، تحديد جماعي، رفض جماعي بسبب واضح، وتصعيد تلقائي عند انتهاء المهلة. كل قرار يُسجَّل في سجل تدقيق غير قابل للتعديل.</p>
      <p class="kernel-page-header__subtitle">
        قائمة طلبات حية تعرض درجة المخاطرة ومهلة SLA، مع لوحة تفاصيل كاملة: فحص PII، السياسات المشتعلة، أثر الموافقة، وتعليل إلزامي عند الرفض.
      </p>
    </div>
    <div class="kernel-page-header__actions">
      <KernelDemoPill />
    </div>
  </header>

  <div class="kernel-main kernel-page-fade-in" data-kernel-loading data-kernel-count={stats.total}>
    <div data-kernel-skeleton class="kernel-loading-skeleton">
      <KernelSkeleton variant="card" count={3} />
      <KernelSkeleton variant="text" count={5} />
    </div>
    <div data-kernel-empty hidden>
      <KernelEmptyState
        title="لا توجد طلبات معلقة"
        message="جميع الطلبات تمت مراجعتها وإدارتها، أو لا توجد موافقات بانتظار القرار في وضع البث الحي."
        ctaLabel="راجع السياسات"
        ctaHref="/kernel/policies/"
        demoHint={true}
      />
    </div>

    <!-- Status filter cards (five) — clickable filters, active gets colored border -->
    <div class="kernel-ap-filters" data-kap-filters role="group" aria-label="حالات الموافقات">
      {FILTERS.map((f, i) => (
        <button
          type="button"
          class:list={[
            'kernel-ap-filter',
            `kernel-ap-filter--${f.id}`,
            i === 0 && 'kernel-ap-filter--active',
          ]}
          data-kap-filter={f.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-label={`${f.label}: ${fmtCount(f.count)} طلب`}
        >
          <span>{f.label}</span>
          <span class="kernel-ap-filter__count" data-kap-filter-count={f.id}>{fmtCount(f.count)}</span>
        </button>
      ))}
    </div>

    <!-- Toolbar: search + total + shortcuts hint -->
    <div class="kernel-ap-toolbar">
      <div class="kernel-ap-toolbar__search">
        <span class="kernel-ap-toolbar__search-icon" aria-hidden="true"><Fragment set:html={iconSearch} /></span>
        <input
          type="search"
          class="kernel-ap-toolbar__input"
          data-kap-search
          placeholder="بحث بالعنوان، Trace ID، المستخدم…"
          aria-label="بحث في طلبات الموافقات"
        />
      </div>
      <span class="kernel-ap-toolbar__total">{fmtCount(stats.total)} طلب إجمالي</span>
      <button type="button" class="kernel-ap-shortcuts-btn" data-kap-shortcuts-btn aria-label="عرض اختصارات الكيبورد">
        <span aria-hidden="true"><Fragment set:html={iconKeyboard} /></span>
        <span>اختصارات</span>
      </button>
    </div>

    <!-- List/detail layout: right 380px queue, left detail panel (RTL) -->
    <div class="kernel-ap-layout">
      <section class="kernel-ap-queue" aria-label="قائمة طلبات الموافقات">
        <div data-kap-list></div>
      </section>
      <section class="kernel-ap-detail-col" aria-label="تفاصيل الطلب">
        <div data-kap-detail></div>
      </section>
    </div>

    <!-- Empty state (engine toggles via data-kap-empty) -->
    <div
      class="kernel-ap-empty-state"
      data-kap-empty
      hidden
      role="status"
      aria-live="polite"
    >
      <p class="kernel-ap-empty-state__title">لا توجد طلبات مطابقة</p>
      <p class="kernel-ap-empty-state__hint">جرّب توسيع البحث أو اختيار حالة أخرى.</p>
      <button type="button" class="kernel-ap-empty-state__reset" data-kap-reset>
        إعادة ضبط الفلاتر
      </button>
    </div>

    <!-- Decision ledger (Prompt 20: every decision → Audit event) -->
    <section class="kernel-ap-ledger-wrap" aria-labelledby="kap-ledger-title">
      <h2 class="kernel-ap-ledger-title" id="kap-ledger-title">سجل قرارات الجلسة</h2>
      <p class="kernel-ap-ledger-desc">
        كل قرار هنا يُسجَّل كحدث تدقيق (Audit) يربط Trace → Evidence → Certificate ولا يمكن تعديله.
      </p>
      <ol class="kernel-ap-ledger" data-kap-ledger></ol>
    </section>
  </div>

  <!-- Decision modal (approve / reject / transfer) — Enhanced with summary, policy, consequence, audit receipt -->
  <div class="kernel-modal" data-kap-modal data-open="false" role="dialog" aria-modal="true" aria-labelledby="kap-modal-title" aria-hidden="true">
    <div class="kernel-modal__backdrop" data-kap-modal-close></div>
    <div class="kernel-modal__dialog kernel-modal__dialog--wide" tabindex="-1">
      <header class="kernel-modal__head">
        <h2 class="kernel-modal__title" id="kap-modal-title" data-kap-modal-title>تأكيد القرار</h2>
        <button type="button" class="kernel-modal__close" aria-label="إغلاق" data-kap-modal-close>
          <Fragment set:html={iconClose} />
        </button>
      </header>

      <!-- Decision Summary Card -->
      <div class="kernel-modal__summary" data-kap-modal-summary hidden>
        <div class="kernel-modal__summary-header">
          <span class="kernel-modal__summary-badge" data-kap-modal-summary-badge></span>
          <span class="kernel-modal__summary-irreversible" data-kap-modal-irreversible hidden>قرار لا رجعة فيه</span>
        </div>
        <dl class="kernel-modal__summary-grid">
          <dt>الطلب</dt>
          <dd data-kap-modal-summary-title>—</dd>
          <dt>Trace ID</dt>
          <dd data-kap-modal-summary-trace>—</dd>
          <dt>درجة المخاطر</dt>
          <dd data-kap-modal-summary-risk>—</dd>
          <dt>الإجراء</dt>
          <dd data-kap-modal-summary-action>—</dd>
          <dt>السياسة المحفزة</dt>
          <dd data-kap-modal-summary-policy>—</dd>
          <dt>الأثر المتوقع</dt>
          <dd data-kap-modal-summary-consequence>—</dd>
        </dl>
      </div>

      <div class="kernel-modal__context" data-kap-modal-context>—</div>

      <div class="kernel-modal__field" data-kap-modal-delegate-field hidden>
        <label for="kap-modal-delegate" class="kernel-modal__label">حوّل إلى</label>
        <select id="kap-modal-delegate" class="kernel-modal__select" data-kap-modal-delegate></select>
        <p class="kernel-modal__hint">اختر المسؤول المستهدف للتفويض. التفويض مسجّل كجهة مستقبلة جديدة في السجل.</p>
      </div>

      <div class="kernel-modal__field">
        <label for="kap-modal-reason" class="kernel-modal__label" data-kap-modal-label>
          ملاحظاتك (اختياري)
        </label>
        <textarea
          id="kap-modal-reason"
          class="kernel-modal__textarea"
          data-kap-modal-reason
          placeholder="اكتب سبب القرار…"
          aria-describedby="kap-modal-reason-hint"
        ></textarea>
        <p id="kap-modal-reason-hint" class="kernel-modal__hint" hidden>سبب القرار إلزامي للرفض والتفويض</p>
        <button type="button" class="kernel-modal__btn kernel-modal__btn--ghost" data-kap-modal-suggest>اقتراح آلي</button>
        <span class="kernel-modal__suggest-badge" data-kap-modal-suggest-badge hidden>اقتراح آلي — راجعه قبل التأكيد</span>
      </div>

      <div class="kernel-modal__actions">
        <button type="button" class="kernel-modal__btn kernel-modal__btn--secondary" data-kap-modal-close>إلغاء</button>
        <button type="button" class="kernel-modal__btn kernel-modal__btn--confirm" data-kap-modal-confirm>تأكيد القرار</button>
      </div>

      <!-- Audit Receipt (shown after confirmation) -->
      <div class="kernel-modal__receipt" data-kap-modal-receipt hidden role="region" aria-label="إيصال التدقيق">
        <h3 class="kernel-modal__receipt-title">إيصال قرار التدقيق</h3>
        <dl class="kernel-modal__receipt-grid">
          <dt>رقم الحدث</dt>
          <dd data-kap-receipt-event-id>—</dd>
          <dt>Trace ID</dt>
          <dd data-kap-receipt-trace>—</dd>
          <dt>القرار</dt>
          <dd data-kap-receipt-action>—</dd>
          <dt>السبب</dt>
          <dd data-kap-receipt-reason>—</dd>
          <dt>المراجع</dt>
          <dd data-kap-receipt-reviewer>—</dd>
          <dt>الوقت</dt>
          <dd data-kap-receipt-timestamp>—</dd>
          <dt>هاش الدليل</dt>
          <dd data-kap-receipt-evidence>—</dd>
          <dt>رقم الشهادة</dt>
          <dd data-kap-receipt-certificate>—</dd>
        </dl>
        <div class="kernel-modal__receipt-actions">
          <button type="button" class="kernel-modal__btn kernel-modal__btn--secondary" data-kap-receipt-copy>نسخ JSON</button>
          <button type="button" class="kernel-modal__btn" data-kap-receipt-print>طباعة</button>
          <button type="button" class="kernel-modal__btn kernel-modal__btn--secondary" data-kap-receipt-close>إغلاق</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Shortcuts hint (toggled by ? key or the toolbar button) -->
  <div class="kernel-shortcuts" data-kap-shortcuts hidden role="region" aria-label="اختصارات الكيبورد">
    <h3 class="kernel-shortcuts__title">اختصارات الكيبورد</h3>
    <ul class="kernel-shortcuts__list">
      <li><kbd>J</kbd> / <kbd>K</kbd> — تنقّل بين الطلبات</li>
      <li><kbd>A</kbd> — موافقة</li>
      <li><kbd>R</kbd> — رفض</li>
      <li><kbd>F</kbd> — تحويل</li>
      <li><kbd>Space</kbd> — معاينة / تفعيل</li>
      <li><kbd>?</kbd> — إظهار/إخفاء هذه اللوحة</li>
    </ul>
  </div>

  {/* ═══════════ KERNEL-AI-2026-07-14: Lead Capture ═══════════ */}

  <section class="kernel-lead-section inner-section inner-section--alt" aria-labelledby="lead-form-h2-approvals">
    <div class="max-w-3xl mx-auto px-5">
      <h2 id="lead-form-h2-approvals" class="inner-section__title inner-section__title--centered">تبي تفعّل الموافقات البشرية على قرارات AI؟</h2>
      <p class="inner-section__lead inner-section__lead--centered">فريق الحوكمة يوضح لك كيف تربط الموافقات بسير العمل الحالي بدون تعطيل.</p>
      <KernelLeadForm id="kernel-lead-form-approvals" page="/kernel/approvals/" />
    </div>
  </section>

  {/* SEO content + FAQ — server-rendered for crawlers (2026-07-14) */}
  <KernelSeoSection
    id="kernel-seo-approvals"
    heading="دليل حوكمة AI — سياق إضافي عن وحدة الموافقات"
    blocks={unit.seoBlocks}
    faq={unit.faq}
  />

  {/* Cross-links: kernel ↔ kernel + solution + doc + blog */}
  <KernelContextLinks
    currentPath={unit.path}
    solutionPath={cross.solutionPath}
    docPath={cross.docPath ?? ''}
    blogPath={cross.blogPath}
    blogLabel={unit.blogLabel}
    relatedSlugs={unit.relatedSlugs}
  />
  <script type="module" src="/js/kernel-approvals-data.js"></script>
  <script type="module" src="/js/kernel-approvals.js"></script>
  <script type="module" src="/js/kernel-loading-state.js"></script>
</KernelLayout>
