---
/**
 * src/pages/kernel/admin/quota.astro — CHAMPION-05 (2026-07-30).
 *
 * Admin-only quota dashboard (UI for src/pages/api/kernel/quota-stats.ts).
 * Renders today's global chat usage/cost, per-provider circuit-breaker state,
 * and the configured limits. Intended for operators, not end users.
 *
 * Auth model:
 *   The page itself is a static shell that reveals NOTHING without a valid
 *   admin key. The key is entered client-side, persisted to localStorage
 *   (admin's own browser), and sent as `x-brightai-admin-key` on every fetch.
 *   The server enforces the gate (401 on mismatch) — this page never trusts
 *   itself. noindex/nofollow so it never enters Google's index.
 *
 * Why static (no prerender=false): the page is a thin client that fetches
 * live data via the SSR API route. Keeping it prerendered HTML avoids an extra
 * SSR cost for a low-traffic internal tool. Robots meta + the key gate are the
 * protection layers.
 *
 * Design: uses the project design tokens (tokens.css) so it matches the site's
 * dark aesthetic. No Header/Footer/analytics — this is an internal operator
 * screen, not a marketing surface.
 */
const title = 'BrightAI — Quota Dashboard (admin)';
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {/* Admin screen — never index, never follow. */}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="admin only" />
    <link rel="canonical" href="https://brightai.site/kernel/admin/quota/" />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <main class="qd">
      <header class="qd__top">
        <h1 class="qd__title">لوحة حصة الـ Kernel</h1>
        <p class="qd__sub">استخدام اليوم + حالة الـ circuit breaker — admin only</p>
      </header>

      {/* Auth gate — hidden once a key is entered and the first fetch succeeds. */}
      <section class="qd__gate" id="gate" hidden>
        <label class="qd__label" for="adminKey">Admin key</label>
        <input
          id="adminKey"
          class="qd__input"
          type="password"
          autocomplete="off"
          placeholder="BRIGHTAI_ADMIN_KEY"
          required
          aria-describedby="gateErr"
        />
        <button id="unlockBtn" class="qd__btn" type="button">فتح</button>
        <p class="qd__err" id="gateErr" role="alert" aria-live="assertive"></p>
      </section>

      {/* Dashboard — shown after successful auth. */}
      <section class="qd__dash" id="dash" hidden>
        <div class="qd__row">
          <div class="qd__card">
            <span class="qd__card-label">طلبات اليوم</span>
            <span class="qd__card-value" id="reqValue">—</span>
            <span class="qd__card-foot" id="reqFoot"></span>
          </div>
          <div class="qd__card">
            <span class="qd__card-label">التكلفة اليوم (USD)</span>
            <span class="qd__card-value" id="costValue">—</span>
            <span class="qd__card-foot" id="costFoot"></span>
          </div>
          <div class="qd__card">
            <span class="qd__card-label">Circuit — Groq</span>
            <span class="qd__chip" id="cbGroq">—</span>
          </div>
          <div class="qd__card">
            <span class="qd__card-label">Circuit — Gemini</span>
            <span class="qd__chip" id="cbGemini">—</span>
          </div>
        </div>

        <div class="qd__actions">
          <button id="refreshBtn" class="qd__btn" type="button">تحديث</button>
          <button id="logoutBtn" class="qd__btn qd__btn--ghost" type="button">نسيت المفتاح</button>
          <span class="qd__meta" id="meta"></span>
        </div>
      </section>
    </main>

    <style>
      :global(html) {
        background: var(--bg-base);
      }
      .qd {
        max-width: 920px;
        margin: 0 auto;
        padding: var(--space-8) var(--space-4);
        font-family:
          'IBM Plex Sans Arabic', 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--text-primary);
      }
      .qd__title {
        font-size: var(--text-3xl);
        margin: 0;
      }
      .qd__sub {
        color: var(--text-secondary);
        margin: var(--space-1) 0 var(--space-6);
        font-size: var(--text-sm);
      }
      .qd__gate {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        align-items: center;
        background: var(--bg-surface);
        border: 1px solid var(--bg-elevated);
        border-radius: var(--radius-lg);
        padding: var(--space-4);
      }
      .qd__label {
        width: 100%;
        color: var(--text-secondary);
        font-size: var(--text-sm);
      }
      .qd__input {
        flex: 1 1 240px;
        background: var(--bg-base);
        border: 1px solid var(--bg-elevated);
        border-radius: var(--radius-md);
        color: var(--text-primary);
        padding: var(--space-2) var(--space-3);
        font-size: var(--text-base);
      }
      .qd__err {
        width: 100%;
        color: var(--status-danger);
        font-size: var(--text-sm);
        min-height: 1.25em;
      }
      .qd__row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: var(--space-3);
      }
      .qd__card {
        background: var(--bg-surface);
        border: 1px solid var(--bg-elevated);
        border-radius: var(--radius-lg);
        padding: var(--space-4);
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
      }
      .qd__card-label {
        color: var(--text-secondary);
        font-size: var(--text-sm);
      }
      .qd__card-value {
        font-size: var(--text-3xl);
        font-weight: 600;
      }
      .qd__card-foot {
        color: var(--text-muted);
        font-size: var(--text-xs);
      }
      .qd__chip {
        display: inline-block;
        align-self: flex-start;
        padding: var(--space-1) var(--space-3);
        border-radius: var(--radius-full);
        font-size: var(--text-sm);
        font-weight: 600;
        background: var(--bg-elevated);
        color: var(--text-secondary);
      }
      .qd__chip[data-state='closed'] {
        background: color-mix(in srgb, var(--status-success) 22%, transparent);
        color: var(--status-success);
      }
      .qd__chip[data-state='open'] {
        background: color-mix(in srgb, var(--status-danger) 22%, transparent);
        color: var(--status-danger);
      }
      .qd__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        align-items: center;
        margin-top: var(--space-5);
      }
      .qd__btn {
        background: var(--interactive-primary);
        color: var(--bg-base);
        border: 0;
        border-radius: var(--radius-md);
        padding: var(--space-2) var(--space-4);
        font-size: var(--text-sm);
        font-weight: 600;
        cursor: pointer;
      }
      .qd__btn--ghost {
        background: transparent;
        color: var(--text-secondary);
        border: 1px solid var(--bg-elevated);
      }
      .qd__meta {
        color: var(--text-muted);
        font-size: var(--text-xs);
        margin-inline-start: auto;
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
          animation: none !important;
        }
      }
    </style>

    <script>
      // Admin quota dashboard client. Fetches /api/kernel/quota-stats/ with the
      // admin key header. Never logs the key. All rendering is defensive.
      const ENDPOINT = '/api/kernel/quota-stats/';
      const STORAGE_KEY = 'brightai_admin_key';

      const gate = document.getElementById('gate');
      const dash = document.getElementById('dash');
      const input = document.getElementById('adminKey') as HTMLInputElement | null;
      const unlockBtn = document.getElementById('unlockBtn') as HTMLButtonElement | null;
      const gateErr = document.getElementById('gateErr');
      const refreshBtn = document.getElementById('refreshBtn');
      const logoutBtn = document.getElementById('logoutBtn');
      const meta = document.getElementById('meta');

      const reqValue = document.getElementById('reqValue');
      const reqFoot = document.getElementById('reqFoot');
      const costValue = document.getElementById('costValue');
      const costFoot = document.getElementById('costFoot');
      const cbGroq = document.getElementById('cbGroq');
      const cbGemini = document.getElementById('cbGemini');

      function getKey(): string {
        return localStorage.getItem(STORAGE_KEY) ?? '';
      }

      function setKey(k: string): void {
        if (k) localStorage.setItem(STORAGE_KEY, k);
        else localStorage.removeItem(STORAGE_KEY);
      }

      function showGate(err?: string): void {
        dash?.setAttribute('hidden', '');
        gate?.removeAttribute('hidden');
        if (input) input.value = '';
        if (gateErr) gateErr.textContent = err ?? '';
        input?.focus();
      }

      function showDash(): void {
        gate?.setAttribute('hidden', '');
        dash?.removeAttribute('hidden');
      }

      function chipState(el: Element | null, open: boolean): void {
        if (!el) return;
        el.textContent = open ? 'مفتوح (open)' : 'سليم (closed)';
        el.setAttribute('data-state', open ? 'open' : 'closed');
      }

      async function load(): Promise<void> {
        const key = getKey();
        if (!key) {
          showGate();
          return;
        }
        try {
          const res = await fetch(ENDPOINT, {
            headers: { 'x-brightai-admin-key': key },
          });
          if (res.status === 401) {
            setKey('');
            showGate('مفتاح غير صحيح.');
            return;
          }
          if (res.status === 503) {
            showGate('الخادم ما مضبوط: BRIGHTAI_ADMIN_KEY غير محدد.');
            return;
          }
          if (!res.ok) throw new Error(`http ${res.status}`);
          const d = await res.json();
          if (reqValue) reqValue.textContent = String(d.usage.requestsToday);
          if (reqFoot) reqFoot.textContent = `الحد اليومي: ${d.usage.limit}`;
          if (costValue) costValue.textContent = `$${d.cost.usdToday.toFixed(2)}`;
          if (costFoot) costFoot.textContent = `السقف: $${d.cost.capUsd}`;
          chipState(cbGroq, !!d.circuit.groq.open);
          chipState(cbGemini, !!d.circuit.gemini.open);
          if (meta)
            meta.textContent = `آخر تحديث: ${new Date(d.ts).toLocaleTimeString('ar')} ${
              d.degraded ? '• بدون Redis (degraded)' : ''
            }`;
          showDash();
        } catch (e) {
          if (meta) meta.textContent = 'فشل التحميل — حاول مرة أخرى.';
          // eslint-disable-next-line no-console
          console.warn('[quota-dash] load failed', e instanceof Error ? e.message : e);
        }
      }

      unlockBtn?.addEventListener('click', () => {
        const k = input?.value?.trim() ?? '';
        if (!k) {
          if (gateErr) gateErr.textContent = 'أدخل المفتاح.';
          if (input) input.setAttribute('aria-invalid', 'true');
          input?.focus();
          return;
        }
        if (input) input.removeAttribute('aria-invalid');
        if (unlockBtn) unlockBtn.disabled = true;
        setKey(k);
        load().finally(() => {
          if (unlockBtn) unlockBtn.disabled = false;
        });
      });
      input?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') unlockBtn?.click();
      });
      refreshBtn?.addEventListener('click', load);
      logoutBtn?.addEventListener('click', () => {
        setKey('');
        showGate();
      });

      // Initial: if a key is stored, try to load; otherwise show the gate.
      load();
    </script>
  </body>
</html>
