---
/**
 * /kernel/models/ — سجل النماذج والحلبة وقواعد التوجيه (M25).
 *
 * ثلاث تبويبات:
 *   1. السجل — جدول مقارنة للنماذج (مرتّب، أفضل صف بنجمة) + تصدير CSV
 *   2. الحلبة — محاكاة بثّ متوازي حتمية لثلاثة نماذج + تصويت + لوحة صدارة
 *   3. قواعد التوجيه — مخطط تدفق SVG تفاعلي + تجاوز يدوي + تنبيهات تدهور
 *
 * vanilla JS فقط (لا مكتبات خارجية). مخطط التدفق بـ SVG يدوي.
 * عامية سعودية، أرقام لاتينية، KernelTabs للتبويبات، ورثة الشِل.
 * prefers-reduced-motion محترم. حتمية كاملة (لا Math.random).
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelLeadForm from '../../components/kernel/KernelLeadForm.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import KernelTabs from '../../components/kernel/KernelTabs.astro';
import { getKernelUnit, getCrossLinks, getKernelFaqJsonLd } from '../../data/kernel';
import { getKernelSubPageJsonLd } from '../../data/schema-helpers';
import { buildModelsData } from '../../data/kernel-models';
import '../../../kernel/assets/css/pages/models.css';

const unit = getKernelUnit('models')!;
const cross = getCrossLinks(unit);

const jsonLd: Record<string, unknown>[] = [
  ...getKernelSubPageJsonLd(unit),
  ...(getKernelFaqJsonLd(unit) ? [getKernelFaqJsonLd(unit)] : []),
].filter(Boolean) as Record<string, unknown>[];

const modelsData = buildModelsData();
---
<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  ogImage={unit.ogImage}
  jsonLd={jsonLd}
  currentPath="/kernel/models/"
  breadcrumbs={[
    { name: 'Kernel', href: '/kernel/' },
    { name: 'النماذج والتوجيه', href: '/kernel/models/' },
  ]}
>
  <main class="models-page" id="models-page">
    <header class="kernel-page-header">
      <div class="kernel-page-header__lead">
        <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
          <ol>
            <li><a href="/">BrightAI</a></li>
            <li><a href="/kernel/">Kernel</a></li>
            <li aria-current="page">{unit.label}</li>
          </ol>
        </nav>
        <h1 class="kernel-page-header__title">{unit.h1}</h1>
        <p class="kernel-page-header__subtitle">{unit.shortDescription}</p>
      </div>
      <div class="kernel-page-header__actions">
        <KernelDemoPill />
      </div>
    </header>

    <div class="kernel-main kernel-page-fade-in">
      <KernelTabs
        tabs={[
          { id: 'registry', label: 'السجل', count: modelsData.registry.length, selected: true },
          { id: 'arena', label: 'الحلبة' },
          { id: 'routing', label: 'قواعد التوجيه' },
        ]}
        panelIdBase="models-tabpanel"
        tabIdBase="models-tab"
      />

      {/* ═══════════════ تبويب ١: السجل ═══════════════ */}
      <section id="models-tabpanel-registry" role="tabpanel" aria-labelledby="models-tab-registry" tabindex="0">
        <div class="km-table-wrap" tabindex="0" role="region" aria-label="جدول مقارنة النماذج — مرّر أفقياً">
          <table class="km-table" id="km-table" aria-label="جدول مقارنة النماذج">
            <thead>
              <tr>
                <th data-col="logo" data-sort-dir="none" aria-label="الشعار">الشعار</th>
                <th data-col="name" data-sort-dir="none" aria-label="الاسم">الاسم والإصدار</th>
                <th data-col="location" data-sort-dir="none" aria-label="مكان البيانات">مكان البيانات</th>
                <th data-col="latency" data-sort-dir="none" aria-label="الزمن الوسيط">الزمن الوسيط</th>
                <th data-col="cost" data-sort-dir="none" aria-label="التكلفة">التكلفة / 1K توكن</th>
                <th data-col="success" data-sort-dir="none" aria-label="معدل النجاح">معدل النجاح</th>
                <th data-col="hallucination" data-sort-dir="none" aria-label="معدل الهلوسة">معدل الهلوسة</th>
                <th data-col="safety" data-sort-dir="none" aria-label="درجة الأمان">درجة الأمان</th>
                <th data-col="status" data-sort-dir="none" aria-label="الحالة">الحالة</th>
              </tr>
            </thead>
            <tbody id="km-tbody"></tbody>
          </table>
        </div>
        <p class="km-note" dir="ltr">⭐ الصف الأفضل في كل عمود · البيانات توضيحية تُحدَّث أسبوعياً</p>
        <button type="button" id="km-export-csv" class="km-export-btn">صدّر مقارنة النماذج (CSV)</button>
      </section>

      {/* ═══════════════ تبويب ٢: الحلبة ═══════════════ */}
      <section id="models-tabpanel-arena" role="tabpanel" aria-labelledby="models-tab-arena" tabindex="0" hidden>
        <div class="km-arena">
          <div class="km-arena__prompt">
            <label for="km-arena-input" class="sr-only">اكتب الطلب</label>
            <input type="text" id="km-arena-input" placeholder="اكتب الطلب هنا لتشغيل الحلبة..." dir="rtl" aria-label="طلب للمقارنة بين النماذج" />
            <button type="button" id="km-arena-run">شغّل الحلبة</button>
          </div>

          <div class="km-arena__countdown" id="km-arena-countdown" data-active="false"></div>

          <div class="km-arena__columns" id="km-arena-columns">
            {modelsData.arenaModels.map((m) => (
              <div class="km-arena__column" data-model={m.name}>
                <div class="km-arena__column-header">
                  <span class="km-arena__column-name">{m.logo} {m.name}</span>
                  <span class="km-arena__column-timer" data-timer></span>
                </div>
                <div class="km-arena__stream" data-stream aria-live="polite"></div>
                <div class="km-arena__result" data-result hidden>
                  <div class="km-arena__result-row">
                    <span class="km-arena__result-label">الزمن</span>
                    <span class="km-arena__result-value" data-field="time">—</span>
                  </div>
                  <div class="km-arena__result-row">
                    <span class="km-arena__result-label">التكلفة</span>
                    <span class="km-arena__result-value" data-field="cost">—</span>
                  </div>
                  <div class="km-arena__result-row">
                    <span class="km-arena__result-label">درجة الحوكمة</span>
                    <span class="km-arena__result-value" data-field="governance">—</span>
                  </div>
                  <div class="km-arena__winner" data-winner hidden></div>
                </div>
              </div>
            ))}
          </div>

          <button type="button" class="km-arena__vote-btn" data-km-arena-vote>صوّت للأفضل</button>

          <div class="km-arena__leaderboard" id="km-arena-leaderboard">
            <h2>لوحة الصدارة</h2>
            <div id="km-arena-leaderboard-rows"></div>
          </div>
        </div>
      </section>

      {/* ═══════════════ تبويب ٣: قواعد التوجيه ═══════════════ */}
      <section id="models-tabpanel-routing" role="tabpanel" aria-labelledby="models-tab-routing" tabindex="0" hidden>
        <div class="km-routing">
          <div class="km-routing__chart" id="km-routing-chart" role="img" aria-label="مخطط تدفق قواعد التوجيه — عقدة البداية تتفرع لقرارات تحدد نوع البيانات والحساسية والقسم وتنتهي بالنموذج المختار"></div>

          <div class="km-routing__legend">
            <span class="km-routing__legend-item"><span class="km-routing__legend-dot km-routing__legend-dot--start"></span> عقدة بداية</span>
            <span class="km-routing__legend-item"><span class="km-routing__legend-dot km-routing__legend-dot--decision"></span> عقدة شرطية</span>
            <span class="km-routing__legend-item"><span class="km-routing__legend-dot km-routing__legend-dot--model"></span> عقدة نموذج</span>
            <span class="km-routing__legend-item"><span class="km-routing__legend-dot km-routing__legend-dot--active"></span> القاعدة النشطة</span>
          </div>

          {/* لوحة التجاوز اليدوي */}
          <div class="km-routing__override">
            <h2>جدول التجاوز اليدوي</h2>
            <table class="km-routing__override-table">
              <thead>
                <tr>
                  <th>القاعدة</th>
                  <th>النموذج الأصلي</th>
                  <th>النموذج المُتجاوز</th>
                  <th>التعليق</th>
                  <th>&nbsp;</th>
                </tr>
              </thead>
              <tbody>
                {modelsData.manualOverrides.map((o) => (
                  <tr>
                    <td>{o.rule}</td>
                    <td>{o.originalModel}</td>
                    <td>
                      <select class="km-routing__override-select" aria-label="اختر النموذج المتجاوز">
                        <option>{o.overrideModel}</option>
                        <option>Jais 13B</option>
                      </select>
                    </td>
                    <td>{o.reason}</td>
                    <td><button class="km-routing__override-btn" type="button">طبّق</button></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {/* تنبيهات تدهور الأداء */}
          <div class="km-routing__alerts" id="km-routing-alerts">
            {modelsData.alerts.map((a) => (
              <div class={`km-routing__alert km-routing__alert--${a.level}`} role="alert">
                <span class="km-routing__alert-icon" aria-hidden="true">{a.level === 'warning' ? '⚠️' : a.level === 'danger' ? '🔴' : 'ℹ️'}</span>
                <div class="km-routing__alert-body">
                  <div class="km-routing__alert-title">{a.title}</div>
                  <div>{a.desc}</div>
                  <div class="km-routing__alert-time">{a.time}</div>
                </div>
              </div>
            ))}
          </div>

          {/* لوحة صدارة أمان النماذج */}
          <div class="km-routing__leaderboard">
            <h2>لوحة صدارة أمان النماذج — أسبوع 2026-08-01</h2>
            <div class="km-routing__leaderboard-grid" id="km-security-lb-grid"></div>
          </div>
        </div>
      </section>
    </div>

    {/* Lead Capture */}
    <section class="kernel-lead-section inner-section inner-section--alt" aria-labelledby="lead-form-h2-models">
      <div class="max-w-3xl mx-auto px-5">
        <h2 id="lead-form-h2-models" class="inner-section__title inner-section__title--centered">تبي توجيه النماذج لمنشأتك؟</h2>
        <p class="inner-section__lead inner-section__lead--centered">فريق الحوكمة يوضح لك كيف تختار النموذج المناسب لكل طلب حسب الحساسية والقسم.</p>
        <KernelLeadForm id="kernel-lead-form-models" page="/kernel/models/" />
      </div>
    </section>

    {/* SEO content + FAQ */}
    <KernelSeoSection
      id="kernel-seo-models"
      heading="دليل حوكمة AI — سياق إضافي عن وحدة النماذج"
      blocks={unit.seoBlocks}
      faq={unit.faq}
    />

    {/* Cross-links */}
    <KernelContextLinks
      currentPath={unit.path}
      solutionPath={cross.solutionPath}
      docPath={cross.docPath ?? ''}
      blogPath={cross.blogPath}
      blogLabel={unit.blogLabel}
      relatedSlugs={unit.relatedSlugs}
    />

    {/* Data + Engine — type="module" required for public/js/ */}
    <script type="module" src="/js/kernel-models-data.js"></script>
    <script type="module" src="/js/kernel-models.js"></script>
    <script type="module" src="/js/kernel-loading-state.js"></script>
  </main>
</KernelLayout>