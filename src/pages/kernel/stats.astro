---
/**
 * /kernel/stats/ — Statistics dashboard (M24).
 *
 * Features:
 *   - 6 KPI cards (clickable → /kernel/audit/ with filter)
 *   - Time series chart + risk distribution doughnut (Chart.js)
 *   - Top users + top departments + top models by cost
 *   - Live event stream + pause button
 *   - Period comparison
 *   - Alerts + quotas + cost + latency panels
 *   - Custom widgets (drag & save view)
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelCard from '../../components/kernel/KernelCard.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelLeadForm from '../../components/kernel/KernelLeadForm.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import { getKernelUnit, getCrossLinks, getKernelFaqJsonLd } from '../../data/kernel';
import { getKernelSubPageJsonLd } from '../../data/schema-helpers';
import { buildStatsData } from '../../data/kernel-stats';

const unit = getKernelUnit('stats')!;
const cross = getCrossLinks(unit);

const jsonLd = [
  ...getKernelSubPageJsonLd(unit),
  getKernelFaqJsonLd(unit),
].filter(Boolean) as Record<string, unknown>[];

const statsData = buildStatsData();

const iconActivity = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>';
const iconStats = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>';
const iconExport = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>';
const iconUsers = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>';
const iconCost = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>';
const iconLatency = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
const iconAlert = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/></svg>';
const iconQuota = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>';
---

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: 'الإحصائيات', href: unit.path }]}
>
  <header class="kernel-page-header">
    <div class="kernel-page-header__lead">
      <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
        <ol>
          <li><a href="/">BrightAI</a></li>
          <li><a href="/kernel/">Kernel</a></li>
          <li aria-current="page">{unit.label}</li>
        </ol>
      </nav>
      <h1 class="kernel-page-header__title">{unit.h1}</h1>
      <p class="kernel-page-header__subtitle">
        لوحة مؤشرات حية: طلبات، مخاطر، PII، أعلى المستخدمين والأقسام والنماذج، تدفق أحداث حي، تنبيهات، حصص، تكلفة، زمن استجابة.
      </p>
    </div>
    <div class="kernel-page-header__actions">
      <KernelDemoPill />
      <button id="export-dashboard-pdf" class="kernel-stats-export" type="button" aria-label="تصدير PDF">
        <Fragment set:html={iconExport} />
        <span>تصدير PDF</span>
      </button>
    </div>
  </header>

  <div class="kernel-main kernel-page-fade-in">
    {/* Time Range Selector */}
    <nav class="ks-range" aria-label="نطاق زمني">
      <div class="ks-range__tabs" role="group" aria-label="النطاق الزمني">
        <button class="ks-range__tab" type="button" aria-pressed="false" data-ks-range="24">آخر 24 ساعة</button>
        <button class="ks-range__tab active" type="button" aria-pressed="true" data-ks-range="7">آخر 7 أيام</button>
        <button class="ks-range__tab" type="button" aria-pressed="false" data-ks-range="30">آخر 30 يوم</button>
        <button class="ks-range__tab" type="button" aria-pressed="false" data-ks-range="90">آخر 90 يوم</button>
      </div>
      <span class="ks-range__refresh">آخر تحديث: قبل لحظات</span>
    </nav>

    {/* KPI cards — clickable → audit */}
    <section class="ks-kpis" id="ks-kpis" aria-label="المؤشرات الرئيسية">
      {/* JS-rendered */}
    </section>

    {/* Charts row */}
    <section class="ks-charts-row" aria-label="الرسوم البيانية">
      <KernelCard title="الطلبات عبر الزمن" subtitle="آخر 7 أيام" iconSvg={iconActivity}>
        <div class="kernel-card__body">
          <div class="ks-chart-wrap">
            <canvas id="requests-line-chart" aria-label="رسم بياني خطي للطلبات"></canvas>
          </div>
        </div>
      </KernelCard>

      <KernelCard title="توزيع المخاطر" subtitle="حرج / مرتفع / متوسط / منخفض / ضئيل" iconSvg={iconStats}>
        <div class="kernel-card__body">
          <div class="ks-chart-wrap">
            <canvas id="risk-pie-chart" aria-label="رسم بياني دائري لتوزيع المخاطر"></canvas>
          </div>
        </div>
      </KernelCard>
    </section>

    {/* Top users + departments + models */}
    <section class="ks-top-row" aria-label="الأعلى استخدامًا">
      <KernelCard title="أعلى المستخدمين" subtitle="10 مستخدمين" iconSvg={iconUsers}>
        <div class="kernel-card__body">
          <div id="ks-top-users">{/* JS-rendered */}</div>
        </div>
      </KernelCard>

      <KernelCard title="أعلى الأقسام" subtitle="7 أقسام" iconSvg={iconStats}>
        <div class="kernel-card__body">
          <div id="ks-top-departments">{/* JS-rendered */}</div>
        </div>
      </KernelCard>

      <KernelCard title="أعلى النماذج تكلفة" subtitle="5 نماذج · بالريال" iconSvg={iconCost}>
        <div class="kernel-card__body">
          <div id="ks-top-models">{/* JS-rendered */}</div>
        </div>
      </KernelCard>
    </section>

    {/* Live event stream + period comparison */}
    <section class="ks-stream-row" aria-label="تدفق الأحداث والمقارنة">
      <KernelCard title="تدفق الأحداث الحي" subtitle="يتحدث كل 3 ثوانٍ" iconSvg={iconActivity}>
        <Fragment slot="actions">
          <button type="button" class="ks-stream-pause" id="ks-stream-pause" aria-pressed="false">إيقاف البث مؤقتًا</button>
        </Fragment>
        <div class="kernel-card__body">
          <div id="ks-live-events" class="ks-live-events">{/* JS-rendered */}</div>
        </div>
      </KernelCard>

      <KernelCard title="مقارنة بالفترة السابقة" subtitle="مايو vs أبريل 2026" iconSvg={iconStats}>
        <div class="kernel-card__body">
          <div id="ks-period-comparison">{/* JS-rendered */}</div>
        </div>
      </KernelCard>
    </section>

    {/* Alerts + quotas + cost + latency */}
    <section class="ks-panels-row" aria-label="التنبيهات والحصص والتكلفة والزمن">
      <KernelCard title="التنبيهات" subtitle="4 قواعد" iconSvg={iconAlert}>
        <div class="kernel-card__body">
          <div id="ks-alerts" class="ks-alerts">{/* JS-rendered */}</div>
        </div>
      </KernelCard>

      <KernelCard title="الحصص" subtitle="7 أقسام" iconSvg={iconQuota}>
        <div class="kernel-card__body">
          <div id="ks-quotas" class="ks-quotas">{/* JS-rendered */}</div>
        </div>
      </KernelCard>

      <KernelCard title="التكلفة" subtitle="إجمالي + حسب النموذج" iconSvg={iconCost}>
        <div class="kernel-card__body">
          <div id="ks-cost" class="ks-cost">{/* JS-rendered */}</div>
        </div>
      </KernelCard>

      <KernelCard title="زمن الاستجابة" subtitle="P50 / P95 / P99" iconSvg={iconLatency}>
        <div class="kernel-card__body">
          <div id="ks-latency" class="ks-latency">{/* JS-rendered */}</div>
        </div>
      </KernelCard>
    </section>

  </div>

  {/* Lead Capture */}
  <section class="kernel-lead-section inner-section inner-section--alt" aria-labelledby="lead-form-h2-stats">
    <div class="max-w-3xl mx-auto px-5">
      <h2 id="lead-form-h2-stats" class="inner-section__title inner-section__title--centered">تبي لوحة مؤشرات تنفيذية لمنشأتك؟</h2>
      <p class="inner-section__lead inner-section__lead--centered">فريق الحوكمة يوضح لك كيف تربط مؤشراتك التشغيلية بمؤشرات حوكمة AI.</p>
      <KernelLeadForm id="kernel-lead-form-stats" page="/kernel/stats/" />
    </div>
  </section>

  {/* SEO content + FAQ */}
  <KernelSeoSection
    id="kernel-seo-stats"
    heading="دليل حوكمة AI — سياق إضافي عن وحدة الإحصائيات"
    blocks={unit.seoBlocks}
    faq={unit.faq}
  />

  {/* Cross-links */}
  <KernelContextLinks
    currentPath={unit.path}
    solutionPath={cross.solutionPath}
    docPath={cross.docPath ?? ''}
    blogPath={cross.blogPath}
    blogLabel={unit.blogLabel}
    relatedSlugs={unit.relatedSlugs}
  />

  {/* Data + Engine — type="module" required for public/js/ */}
  <script type="module" src="/js/kernel-stats-data.js"></script>
  <script type="module" src="/js/kernel-stats.js"></script>
  <script type="module" src="/js/kernel-loading-state.js"></script>
</KernelLayout>