---
import KernelLayout from '../../layouts/KernelLayout.astro';
import { migratedKernelOffline as page } from '../../data/migratedKernelPages';
// KRN-012 / EXEC-12: sanitize migrated HTML
import DOMPurify from 'isomorphic-dompurify';
---
<KernelLayout
  title={page.title}
  description={page.description}
  canonical={page.canonical}
  robots="index, follow"
  hreflang={page.hreflang}
  jsonLd={page.jsonLd as any}
  currentPath="/kernel/offline/"
>
  <main class="migrated-legacy-content" set:html={DOMPurify.sanitize(page.html)} />
  <h2 class="sr-only">حالة الاتصال بالشبكة</h2>
</KernelLayout>
