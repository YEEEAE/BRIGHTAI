      <footer class="kernel-modal__actions">
        <button type="button" class="kernel-modal__btn" data-kernel-evidence-batch-close>إلغاء</button>
        <button type="button" class="kernel-modal__btn kernel-modal__btn--primary" data-kernel-evidence-batch-start>ابدأ التوليد</button>
      </footer>
    </div>
  </div>

  {/* Preview modal */}
  <div class="kernel-modal" data-kernel-evidence-preview-modal data-open="false" role="dialog" aria-modal="true" aria-labelledby="ev-preview-title" aria-hidden="true">
    <div class="kernel-modal__backdrop" data-kernel-evidence-preview-modal-close></div>
    <div class="kernel-modal__dialog" style="inline-size: min(880px, 100%);" tabindex="-1">
      <header class="kernel-modal__head">
        <h2 class="kernel-modal__title" id="ev-preview-title">معاينة ملف الدليل</h2>
        <button type="button" class="kernel-modal__close" aria-label="إغلاق" data-kernel-evidence-preview-modal-close>
