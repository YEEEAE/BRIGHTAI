type EvidenceItem = {
  id: string;
  traceId: string;
  title: string;
  query: string;
  status: 'allowed' | 'blocked' | 'pending_approval' | 'approved' | 'draft';
  riskLevel: 'low' | 'medium' | 'high' | 'critical';
  riskScore: number;
  sector: string;
  pack: string;
  hash: string;
  signedAt: string | null;
  size: string;
  createdAt: string;
};

