        {/* M22: tag filter */}
        <div style="display:flex; flex-direction:column; gap:4px;">
          <label for="ev-tag" class="kernel-audit-filters__label">الوسم</label>
          <select id="ev-tag" class="kernel-evidence-toolbar__select" data-kernel-evidence-filter="tag">
            {TAGS.map(t => <option value={t.value}>{t.label}</option>)}
          </select>
        </div>
      </div>
      <div class="kernel-evidence-toolbar__actions">
        {/* M22: batch generation button */}
        <button type="button" class="kernel-evidence-toolbar__btn" data-kernel-evidence-batch>
          <span aria-hidden="true"><Fragment set:html={iconBolt} /></span>
          <span>توليد دفعي</span>
        </button>
        <button type="button" class="kernel-evidence-toolbar__generate" data-kernel-evidence-generate>
          <span aria-hidden="true"><Fragment set:html={iconPlus} /></span>
          <span>توليد دليل جديد</span>
        </button>
      </div>
    </div>

    <!-- Stats line -->
    <p style="margin-block-end: var(--space-4); font-size:var(--text-sm); color:var(--text-secondary); opacity:var(--text-tertiary-opacity);" data-kernel-evidence-count>
      {ITEMS.length} من {ITEMS.length} · 142KB إجمالي · 4 حزم امتثال
