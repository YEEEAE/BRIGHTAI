  { value: 'nca', label: 'NCA ECC' },
  { value: 'sdaia', label: 'SDAIA' },
  { value: 'sfda', label: 'SFDA' },
  { value: 'sama', label: 'SAMA' },
  { value: 'iso42001', label: 'ISO 42001' },
  { value: 'iso27001', label: 'ISO 27001' },
