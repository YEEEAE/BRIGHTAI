<style>
  /*
   * Mobile-first + RTL baseline for Evidence (kernel championship).
   * Injected by kernel-mobile-baseline.mjs. Logical properties (RTL-safe), ≥44px touch
   * targets, responsive breakpoints, and empty/loading state styles.
   * Uses design tokens. No published text or layout overrides.
   */
  .kernel-evidence__empty-state,
  .kernel-evidence-empty-state {
    padding-inline: var(--space-6);
    margin-inline: auto;
    text-align: start;
    color: var(--text-muted);
    border-inline-start: 3px solid var(--interactive-primary);
  }
  .kernel-evidence__skeleton,
  .kernel-evidence-skeleton {
    inset-inline-start: 0;
    background: var(--bg-elevated);
    animation: kernel-evidence-shimmer 1.4s var(--ease-in-out) infinite;
  }
  @keyframes kernel-evidence-shimmer {
    0% { opacity: 1; }
    50% { opacity: 0.45; }
    100% { opacity: 1; }
  }
  /* Touch targets ≥44px — accessibility on small screens */
  .kernel-evidence [data-kernel-touch],
  .kernel-evidence__touch {
    min-height: 44px;
    min-width: 44px;
  }
  /* Mobile-first: single column on mobile, enhance at ≥768px */
  .kernel-evidence__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .kernel-evidence__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }
  @media (max-width: 640px) {
    .kernel-evidence [data-kernel-touch] { min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kernel-evidence-skeleton { animation: none; }
  }

  /* Empty-state presentation (shown when filters yield no items) */
  .kernel-evidence-empty-state[hidden] { display: none; }
  .kernel-evidence-empty-state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-8);
    padding-inline: var(--space-6);
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
  }
  .kernel-evidence-empty-state__title { margin: 0; font-size: var(--text-lg); color: var(--text-primary); }
  .kernel-evidence-empty-state__hint { margin: 0; color: var(--text-secondary); }
  .kernel-evidence-empty-state__reset {
    min-height: 44px; min-width: 44px;
    padding-inline: var(--space-5); padding-block: var(--space-2);
    border: 1px solid var(--interactive-primary); border-radius: var(--radius-md);
    background: transparent; color: var(--interactive-primary); cursor: pointer;
  }
  .kernel-evidence-empty-state__reset:hover { background: var(--bg-elevated); }

  /* Loading state: hide content while skeleton is visible */
  [data-kernel-loading] > *:not([data-kernel-skeleton]):not([data-kernel-empty]) {
    display: none;
  }
  .kernel-loading-skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
</style>

