<style>
  /*
   * Mobile-first + RTL baseline for Evidence (kernel championship).
   * Injected by kernel-mobile-baseline.mjs. Logical properties (RTL-safe), ≥44px touch
   * targets, responsive breakpoints, and empty/loading state styles.
   * Uses design tokens. No published text or layout overrides.
   */
  .kernel-evidence__empty-state,
  .kernel-evidence-empty-state {
    padding-inline: var(--space-6);
    margin-inline: auto;
    text-align: start;
    color: var(--text-muted);
    border-inline-start: 3px solid var(--interactive-primary);
  }
  .kernel-evidence__skeleton,
  .kernel-evidence-skeleton {
    inset-inline-start: 0;
    background: var(--bg-elevated);
    animation: kernel-evidence-shimmer 1.4s var(--ease-in-out) infinite;
  }
  @keyframes kernel-evidence-shimmer {
    0% { opacity: 1; }
    50% { opacity: 0.45; }
    100% { opacity: 1; }
  }
  /* Touch targets ≥44px — accessibility on small screens */
  .kernel-evidence [data-kernel-touch],
  .kernel-evidence__touch {
    min-height: 44px;
    min-width: 44px;
  }
  /* Mobile-first: single column on mobile, enhance at ≥768px */
  .kernel-evidence__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .kernel-evidence__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }
  @media (max-width: 640px) {
    .kernel-evidence [data-kernel-touch] { min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kernel-evidence-skeleton { animation: none; }
  }

  /* Empty-state presentation (shown when filters yield no items) */
  .kernel-evidence-empty-state[hidden] { display: none; }
  .kernel-evidence-empty-state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-8);
    padding-inline: var(--space-6);
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
  }
  .kernel-evidence-empty-state__title { margin: 0; font-size: var(--text-lg); color: var(--text-primary); }
  .kernel-evidence-empty-state__hint { margin: 0; color: var(--text-secondary); }
  .kernel-evidence-empty-state__reset {
    min-height: 44px; min-width: 44px;
    padding-inline: var(--space-5); padding-block: var(--space-2);
    border: 1px solid var(--interactive-primary); border-radius: var(--radius-md);
    background: transparent; color: var(--interactive-primary); cursor: pointer;
  }
  .kernel-evidence-empty-state__reset:hover { background: var(--bg-elevated); }

  /* Loading state: hide content while skeleton is visible */
  [data-kernel-loading] > *:not([data-kernel-skeleton]):not([data-kernel-empty]) {
    display: none;
  }
  .kernel-loading-skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  /* ── BAI-PERF-02: HTML evidence preview (replaces pdfjs-dist canvas viewer).
       Same data, styled HTML. Zero npm deps — dropped ~125KB gz pdfjs-dist. ── */
  .kernel-evidence-preview[hidden] { display: none; }
  .kernel-evidence-preview {
    margin-block-start: var(--space-4);
    border: 1px solid var(--border-subtle, rgba(255,255,255,.12));
    border-radius: var(--radius-md);
    background: var(--bg-base);
    overflow: hidden;
  }
  .kernel-evidence-preview__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-block-end: 1px solid var(--border-subtle, rgba(255,255,255,.12));
    background: var(--bg-surface);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .kernel-evidence-preview__title {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .kernel-evidence-preview__body {
    padding: var(--space-4);
    max-block-size: 55vh;
    overflow: auto;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--text-primary);
    direction: ltr;
    text-align: left;
  }
  .kernel-evidence-preview__line { white-space: pre-wrap; word-break: break-word; }
  .kernel-evidence-preview__line--sep { color: var(--text-muted); }
  .kernel-evidence-preview__line--head { color: var(--interactive-primary); font-weight: 600; }
  .kernel-evidence-preview__line--foot { color: var(--text-muted); font-size: var(--text-xs); }
  .kernel-evidence-preview__note {
    padding: var(--space-2) var(--space-4);
    border-block-start: 1px solid var(--border-subtle, rgba(255,255,255,.12));
    background: var(--bg-surface);
    color: var(--text-muted);
    font-size: var(--text-xs);
    text-align: center;
  }

  /* ═══════════ PROMPT-3: Signed certificates section + verify modal ═══════════ */
  .kernel-evidence-certs {
    margin-block-start: var(--space-6);
    padding: var(--space-5);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle, rgba(255,255,255,.08));
    border-radius: var(--radius-lg);
  }
  .kernel-evidence-certs__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-end: var(--space-4);
    flex-wrap: wrap;
  }
  .kernel-evidence-certs__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-xl);
    color: var(--text-primary);
  }
  .kernel-evidence-certs__title svg { inline-size: 22px; block-size: 22px; color: var(--interactive-primary); }
  .kernel-evidence-certs__sub {
    margin: var(--space-1) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .kernel-evidence-certs__refresh {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding-inline: var(--space-3);
    border: 1px solid var(--border-subtle, rgba(255,255,255,.16));
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    color: var(--text-primary);
    cursor: pointer;
    font-size: var(--text-sm);
    transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }
  .kernel-evidence-certs__refresh:hover { border-color: var(--interactive-primary); }
  .kernel-evidence-certs__refresh:focus-visible { outline: 2px solid var(--interactive-primary); outline-offset: 2px; }
  .kernel-evidence-certs__refresh[disabled] { opacity: 0.5; cursor: not-allowed; }

  .kernel-evidence-certs__banner {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    margin-block-end: var(--space-3);
    font-size: var(--text-sm);
  }
  .kernel-evidence-certs__banner--info {
    background: color-mix(in srgb, var(--interactive-primary) 10%, transparent);
    border-inline-start: 3px solid var(--interactive-primary);
    color: var(--text-primary);
  }
  .kernel-evidence-certs__banner--error {
    background: color-mix(in srgb, var(--status-danger) 10%, transparent);
    border-inline-start: 3px solid var(--status-danger);
    color: var(--text-primary);
  }
  .kernel-evidence-certs__banner a {
    color: var(--interactive-primary);
    text-decoration: underline;
  }

  .kernel-evidence-certs__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  @media (min-width: 768px) {
    .kernel-evidence-certs__grid { grid-template-columns: repeat(2, 1fr); }
  }

  .kernel-evidence-certs__card {
    padding: var(--space-4);
    border: 1px solid var(--border-subtle, rgba(255,255,255,.10));
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .kernel-evidence-certs__card--revoked {
    border-color: var(--status-danger);
    background: color-mix(in srgb, var(--status-danger) 6%, var(--bg-elevated));
  }
  .kernel-evidence-certs__card--skeleton {
    block-size: 140px;
    animation: kernel-evidence-shimmer 1.4s var(--ease-in-out) infinite;
  }
  .kernel-evidence-certs__card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .kernel-evidence-certs__certid {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: var(--text-sm);
    color: var(--interactive-primary);
    font-weight: 600;
  }
  .kernel-evidence-certs__badges { display: inline-flex; gap: var(--space-1); flex-wrap: wrap; }
  .kernel-certs-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.6;
  }
  .kernel-certs-badge--demo {
    background: color-mix(in srgb, var(--status-warning) 18%, transparent);
    color: var(--status-warning);
    border: 1px solid color-mix(in srgb, var(--status-warning) 40%, transparent);
  }
  .kernel-certs-badge--live {
    background: color-mix(in srgb, var(--status-success) 18%, transparent);
    color: var(--status-success);
    border: 1px solid color-mix(in srgb, var(--status-success) 40%, transparent);
  }
  .kernel-certs-badge--revoked {
    background: color-mix(in srgb, var(--status-danger) 18%, transparent);
    color: var(--status-danger);
    border: 1px solid color-mix(in srgb, var(--status-danger) 40%, transparent);
  }
  .kernel-certs-badge--gate-passed {
    background: color-mix(in srgb, var(--status-success) 14%, transparent);
    color: var(--status-success);
  }
  .kernel-certs-badge--gate-blocked {
    background: color-mix(in srgb, var(--status-danger) 14%, transparent);
    color: var(--status-danger);
  }
  .kernel-certs-badge--gate-incomplete {
    background: color-mix(in srgb, var(--status-warning) 14%, transparent);
    color: var(--status-warning);
  }

  .kernel-evidence-certs__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    font-size: var(--text-sm);
  }
  .kernel-evidence-certs__meta dt { color: var(--text-secondary); }
  .kernel-evidence-certs__meta dd { margin: 0; color: var(--text-primary); word-break: break-word; }

  .kernel-evidence-certs__actions { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .kernel-evidence-certs__btn {
    min-height: 40px;
    padding-inline: var(--space-3);
    border: 1px solid var(--border-subtle, rgba(255,255,255,.16));
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    color: var(--text-primary);
    cursor: pointer;
    font-size: var(--text-sm);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    transition: border-color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }
  .kernel-evidence-certs__btn:hover { border-color: var(--interactive-primary); background: var(--bg-elevated); }
  .kernel-evidence-certs__btn:focus-visible { outline: 2px solid var(--interactive-primary); outline-offset: 2px; }
  .kernel-evidence-certs__btn--verify {
    background: var(--interactive-primary);
    color: var(--bg-base);
    border-color: var(--interactive-primary);
    font-weight: 600;
  }
  .kernel-evidence-certs__btn--verify:hover { filter: brightness(1.1); background: var(--interactive-primary); }

  .kernel-evidence-certs__empty {
    text-align: center;
    padding-block: var(--space-6);
    color: var(--text-secondary);
  }
  .kernel-evidence-certs__empty-title { margin: 0 0 var(--space-1); font-size: var(--text-lg); color: var(--text-primary); }
  .kernel-evidence-certs__empty-cta {
    display: inline-block;
    margin-block-start: var(--space-3);
    padding-inline: var(--space-4);
    padding-block: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--interactive-primary);
    color: var(--bg-base);
    font-weight: 600;
  }

  /* ── Verify modal ── */
  .kernel-certs-modal__loading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-6);
    justify-content: center;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .kernel-certs-modal__statusrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-block-end: var(--space-4);
  }
  .kernel-certs-modal__badge {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .kernel-certs-modal__badge--valid { background: var(--status-success); color: var(--bg-base); }
  .kernel-certs-modal__badge--invalid { background: var(--status-danger); color: var(--bg-base); }
  .kernel-certs-modal__badge--revoked { background: var(--status-danger); color: var(--bg-base); }
  .kernel-certs-modal__badge--pending { background: var(--status-warning); color: var(--bg-base); }
  .kernel-certs-modal__clientnote {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .kernel-certs-modal__details {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
  }
  .kernel-certs-modal__details dt { color: var(--text-secondary); font-weight: 500; }
  .kernel-certs-modal__details dd { margin: 0; color: var(--text-primary); word-break: break-word; }
  .kernel-certs-modal__mono { font-family: var(--font-mono, 'IBM Plex Mono', monospace); color: var(--interactive-primary); }
  .kernel-certs-modal__message {
    margin: 0 0 var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    color: var(--text-primary);
    font-size: var(--text-sm);
  }
  .kernel-certs-modal__verifyurl a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--interactive-primary);
    font-size: var(--text-sm);
    text-decoration: underline;
  }
</style>

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: 'الأدلة', href: unit.path }]}
  extraSpeakableSelectors={['.answer-first-summary']}
>
  <header class="kernel-page-header">
    <div class="kernel-page-header__lead">
      <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
        <ol>
          <li><a href="/">BrightAI</a></li>
          <li><a href="/kernel/">Kernel</a></li>
          <li aria-current="page">{unit.label}</li>
        </ol>
      </nav>
      <h1 class="kernel-page-header__title">{unit.h1}</h1>
      {/* BAI-VOC-001-B (2026-07-18): answer-first summary — wired as the
          second cssSelector for WebPage SpeakableSpecification. */}
      <p class="answer-first-summary" data-speakable-target="answer-first">ملف أدلة PDF موقّع رقمياً يجمع السجلات والسياسات والموافقات لكل قرار AI، جاهز للجهات الرقابية (NCA، SDAIA، SAMA، SFDA) خلال دقائق. يُولَّد عند الطلب، يدعم metadata مخصصة للربط بسجل الموظف أو المعاملة.</p>
      <p class="kernel-page-header__subtitle">
        عرض الأدلة المرتبطة بقرارات الذكاء الاصطناعي مع إمكانية التصدير PDF داخل المتصفح عند الحاجة.
      </p>
    </div>
    <div class="kernel-page-header__actions">
      <KernelDemoPill />
    </div>
  </header>

  {/* M22: retention + integrity disclaimer */}
  <div class="kernel-evidence-disclaimer" role="note" data-kernel-touch>
    <Fragment set:html={iconShield} />
    <p>فترات الاحتفاظ الموضحة لكل ملف التزام تنظيمي (PDPL م.21، NCA ECC، SFDA م.19). سلسلة الهاش تُثبت عدم التلاعب، والتحقق النهائي يتم عبر API الشهادات في بيئة الإنتاج.</p>
  </div>

  {/* ═══════════ PROMPT-3: Signed certificates from Database ═══════════
      Fetches /api/kernel/certificates (admin-key pattern — same as eval-api).
      On 401/403 → falls back to the demo grid below. On success → renders
      real cryptographically-signed certificates with verify/download. */}
  <section class="kernel-evidence-certs" aria-labelledby="ev-certs-title" data-kernel-certs-root>
    <header class="kernel-evidence-certs__head">
      <div>
        <h2 id="ev-certs-title" class="kernel-evidence-certs__title">
          <span aria-hidden="true"><Fragment set:html={iconCertificate} /></span>
          الشهادات الموقّعة رقمياً
        </h2>
        <p class="kernel-evidence-certs__sub" data-kernel-certs-status>
          جارٍ التحميل…
        </p>
      </div>
      <button
        type="button"
        class="kernel-evidence-certs__refresh"
        data-kernel-certs-refresh
        data-kernel-touch
        aria-label="تحديث قائمة الشهادات"
      >
        <span aria-hidden="true">↻</span>
        <span>تحديث</span>
      </button>
    </header>

    {/* Status banner for fetch errors / admin-key hint */}
    <div class="kernel-evidence-certs__banner" data-kernel-certs-banner hidden role="status" aria-live="polite"></div>

    {/* Loading skeleton */}
    <div class="kernel-evidence-certs__skeleton" data-kernel-certs-skeleton>
      <div class="kernel-evidence-certs__card kernel-evidence-certs__card--skeleton"></div>
      <div class="kernel-evidence-certs__card kernel-evidence-certs__card--skeleton"></div>
      <div class="kernel-evidence-certs__card kernel-evidence-certs__card--skeleton"></div>
    </div>

    {/* Empty state */}
    <div class="kernel-evidence-certs__empty" data-kernel-certs-empty hidden>
      <p class="kernel-evidence-certs__empty-title">لا توجد شهادات صادرة بعد</p>
      <p class="kernel-evidence-certs__empty-hint">شغّل تقييماً كاملاً لإصدار أول شهادة امتثال موقّفة رقمياً.</p>
      <a class="kernel-evidence-certs__empty-cta" href="/kernel/eval/" data-kernel-touch>اذهب للتقييم</a>
    </div>

    {/* Certificates grid (populated by JS) */}
    <div class="kernel-evidence-certs__grid" data-kernel-certs-grid aria-live="polite"></div>
  </section>

  {/* ═══════════ PROMPT-3: Certificate verification modal ═══════════ */}
  <div
    class="kernel-modal kernel-certs-modal"
    data-kernel-certs-modal
    data-open="false"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ev-cert-verify-title"
    aria-hidden="true"
  >
    <div class="kernel-modal__backdrop" data-kernel-certs-close></div>
    <div class="kernel-modal__dialog" style="inline-size: min(620px, 100%);" tabindex="-1">
      <header class="kernel-modal__head">
        <h2 class="kernel-modal__title" id="ev-cert-verify-title">التحقق من الشهادة</h2>
        <button type="button" class="kernel-modal__close" aria-label="إغلاق" data-kernel-certs-close>
          <Fragment set:html={iconClose} />
        </button>
      </header>

      <div class="kernel-modal__body">
        {/* Loading state */}
        <div class="kernel-certs-modal__loading" data-kernel-certs-modal-loading hidden role="status" aria-live="polite">
          <span class="kernel-evidence-pdf__spinner" aria-hidden="true"></span>
          <span>جارٍ التحقق من التوقيع الرقمي…</span>
        </div>

        {/* Result */}
        <div class="kernel-certs-modal__result" data-kernel-certs-modal-result hidden>
          <div class="kernel-certs-modal__statusrow">
            <span class="kernel-certs-modal__badge" data-kernel-certs-modal-status-badge role="status" aria-live="assertive"></span>
            <span class="kernel-certs-modal__clientnote" data-kernel-certs-modal-clientnote></span>
          </div>

          <dl class="kernel-certs-modal__details">
            <dt>معرّف الشهادة</dt>
            <dd data-kernel-certs-modal-certid class="kernel-certs-modal__mono">—</dd>
            <dt>وقّعت بواسطة</dt>
            <dd data-kernel-certs-modal-signedby>—</dd>
            <dt>تاريخ التوقيع</dt>
            <dd data-kernel-certs-modal-signedat>—</dd>
            <dt>البيئة</dt>
            <dd data-kernel-certs-modal-env>—</dd>
            <dt>قرار البوابة</dt>
            <dd data-kernel-certs-modal-gate>—</dd>
            <dt>صحة سلسلة الهاش</dt>
            <dd data-kernel-certs-modal-hashchain>—</dd>
            <dt>سبب السحب</dt>
            <dd data-kernel-certs-modal-revoke-reason hidden>—</dd>
          </dl>

          <p class="kernel-certs-modal__message" data-kernel-certs-modal-message aria-live="polite"></p>
          <p class="kernel-certs-modal__verifyurl" data-kernel-certs-modal-verifyurl-wrap hidden>
            <a data-kernel-certs-modal-verifyurl href="#" target="_blank" rel="noopener noreferrer" data-kernel-touch>
              <Fragment set:html={iconLink} />
              <span>رابط التحقق العام</span>
            </a>
          </p>
        </div>
      </div>

      <footer class="kernel-modal__actions">
        <button type="button" class="kernel-modal__btn" data-kernel-certs-close>إغلاق</button>
        <button type="button" class="kernel-modal__btn" data-kernel-certs-modal-download-json data-kernel-touch>
          <span aria-hidden="true"><Fragment set:html={iconHash} /></span>
          <span>تنزيل JSON</span>
        </button>
        <button type="button" class="kernel-modal__btn kernel-modal__btn--primary" data-kernel-certs-modal-download-pdf data-kernel-touch>
          <span aria-hidden="true"><Fragment set:html={iconDownload} /></span>
          <span>تنزيل PDF</span>
        </button>
      </footer>
    </div>
  </div>

  <div class="kernel-main kernel-page-fade-in" data-kernel-loading data-kernel-count={ITEMS.length}>
    <div data-kernel-skeleton class="kernel-loading-skeleton">
      <KernelSkeleton variant="card" count={4} />
      <KernelSkeleton variant="text" count={6} />
    </div>
    <div data-kernel-empty hidden>
      <KernelEmptyState
        title="لا توجد أدلة مولّدة"
        message="قم بتشغيل التقييم لتوليد أدلة وإثباتات امتثال موقّعة."
        ctaLabel="شغّل تقييمًا لتوليد الأدلة"
        ctaHref="/kernel/eval/"
        demoHint={true}
      />
    </div>

    <!-- Toolbar -->
    <div class="kernel-evidence-toolbar" role="search" aria-label="فلاتر الأدلة">
      <div class="kernel-evidence-toolbar__filters">
        <div style="display:flex; flex-direction:column; gap:4px;">
          <label for="ev-sector" class="kernel-audit-filters__label">القطاع</label>
          <select id="ev-sector" class="kernel-evidence-toolbar__select" data-kernel-evidence-filter="sector">
            {SECTORS.map(s => <option value={s.value}>{s.label}</option>)}
          </select>
        </div>
        <div style="display:flex; flex-direction:column; gap:4px;">
          <label for="ev-pack" class="kernel-audit-filters__label">حزمة الامتثال</label>
          <select id="ev-pack" class="kernel-evidence-toolbar__select" data-kernel-evidence-filter="pack">
            {COMPLIANCE_PACKS.map(p => <option value={p.value}>{p.label}</option>)}
          </select>
        </div>
        {/* M22: tag filter */}
        <div style="display:flex; flex-direction:column; gap:4px;">
          <label for="ev-tag" class="kernel-audit-filters__label">الوسم</label>
          <select id="ev-tag" class="kernel-evidence-toolbar__select" data-kernel-evidence-filter="tag">
            {TAGS.map(t => <option value={t.value}>{t.label}</option>)}
          </select>
        </div>
      </div>
      <div class="kernel-evidence-toolbar__actions">
        {/* M22: batch generation button */}
        <button type="button" class="kernel-evidence-toolbar__btn" data-kernel-evidence-batch>
          <span aria-hidden="true"><Fragment set:html={iconBolt} /></span>
          <span>توليد دفعي</span>
        </button>
        <button type="button" class="kernel-evidence-toolbar__generate" data-kernel-evidence-generate>
          <span aria-hidden="true"><Fragment set:html={iconPlus} /></span>
          <span>توليد دليل جديد</span>
        </button>
      </div>
    </div>

    <!-- Stats line -->
    <p style="margin-block-end: var(--space-4); font-size:var(--text-sm); color:var(--text-secondary); opacity:var(--text-tertiary-opacity);" data-kernel-evidence-count>
      {ITEMS.length} من {ITEMS.length} · 142KB إجمالي · 4 حزم امتثال
    </p>

    {/* M22: third-party verification upload + tampering demo */}
    <section class="kernel-evidence-verify" aria-labelledby="ev-verify-title">
      <h3 id="ev-verify-title" class="kernel-evidence-verify__title">
        <Fragment set:html={iconShield} />
        متحقق الطرف الثالث + كسر السلسلة
      </h3>
      <div class="kernel-evidence-verify__grid">
        <div class="kernel-evidence-dropzone" data-kernel-evidence-dropzone data-kernel-touch tabindex="0">
          <span class="kernel-evidence-dropzone__icon" aria-hidden="true"><Fragment set:html={iconUpload} /></span>
          <p>أفلت ملف EVD هنا للتحقق من التوقيع</p>
          <p class="kernel-evidence-dropzone__hint">أو اضغط لاختيار ملف PDF / JSON</p>
        </div>
        <div class="kernel-evidence-tamper">
          <p>جرّب العبث بملف دليل وشوف وش يصير لسلسلة الهاش:</p>
          <button type="button" class="kernel-evidence-tamper__btn" data-kernel-evidence-tamper data-kernel-touch>
            <Fragment set:html={iconBolt} />
            جرّب العبث بسجل
          </button>
          <div class="kernel-evidence-hashchain" data-kernel-evidence-hashchain hidden aria-live="polite">
            <div class="kernel-evidence-hashchain__box">0xa7c8…2c1b</div>
            <span class="kernel-evidence-hashchain__arrow">←</span>
            <div class="kernel-evidence-hashchain__box kernel-evidence-hashchain__box--current">0xb1d9…7b3f</div>
          </div>
          <p class="kernel-evidence-tamper__result" data-kernel-evidence-tamper-result></p>
        </div>
      </div>
    </section>

    {/* Grid */}
    <section class="kernel-evidence-grid" aria-label="ملفات الأدلة" data-kernel-evidence-grid>
      {ITEMS.map(item => (
        <article
          class="kernel-evidence-item"
          data-kernel-evidence-item={item.id}
          data-trace={item.traceId}
          data-sector={item.sector}
          data-pack={item.pack}
          data-tags={item.tags.join(',')}
        >
          <header class="kernel-evidence-item__head">
            <span class="kernel-evidence-item__icon" aria-hidden="true"><Fragment set:html={iconFile} /></span>
            <div class="kernel-evidence-item__title-block">
              <h3 class="kernel-evidence-item__title">{item.id}.pdf</h3>
              <p class="kernel-evidence-item__sub">{item.title}</p>
            </div>
          </header>
          <dl class="kernel-evidence-item__meta">
            <dt>التاريخ</dt>
            <dd>{item.signedAt || item.createdAt}</dd>
            <dt>القطاع</dt>
            <dd>{SECTOR_LABEL[item.sector]}</dd>
            <dt>الحزمة</dt>
            <dd>{PACK_LABEL[item.pack]}</dd>
            <dt>الحجم</dt>
            <dd>{item.size}</dd>
            {/*
              M22: retention info per file
              M22: Trace link — opens audit filtered by that trace
              M22: Certificate link — opens the cert record
            */}
            <dt>الاحتفاظ</dt>
            <dd class="kernel-evidence-item__retention">{item.retention}</dd>
            <dt>Trace</dt>
            <dd>
              <a class="kernel-evidence-item__trace" href={`/kernel/audit/?trace=${item.traceId}`} data-kernel-touch>
                {item.traceId}
              </a>
            </dd>
            <dt>الشهادة</dt>
            <dd>
              {item.certificateId === '—' ? (
                <span class="kernel-evidence-item__cert--none">{item.certificateId}</span>
              ) : (
                <a class="kernel-evidence-item__cert" href="#verify" data-kernel-touch>
                  <Fragment set:html={iconCertificate} />
                  {item.certificateId}
                </a>
              )}
            </dd>
          </dl>

          {/* M22: tags */}
          <div class="kernel-evidence-item__tags">
            {item.tags.map(t => <span class="kernel-evidence-item__tag">{t}</span>)}
          </div>

          <footer class="kernel-evidence-item__footer">
            <span class:list={['kernel-evidence-item__signature', signatureClass(item)]}>
              <span aria-hidden="true"><Fragment set:html={signatureIcon(item)} /></span>
              <span>{signatureText(item)}</span>
            </span>
            <div style="display:flex; gap:var(--space-1);">
              <button
                type="button"
                class="kernel-evidence-item__btn"
                data-kernel-evidence-preview={item.id}
                aria-label={`معاينة ${item.id}`}
                data-title={item.title}
                data-trace={item.traceId}
                data-hash={item.hash}
                data-query={item.query}
                data-status={item.status}
                data-signed={item.signedAt || 'لم يوقّع بعد'}
                data-sector={SECTOR_LABEL[item.sector]}
                data-pack={PACK_LABEL[item.pack]}
                data-size={item.size}
                data-risk={item.riskScore}
                data-retention={item.retention}
                data-cert={item.certificateId}
              >
                <span aria-hidden="true"><Fragment set:html={iconEye} /></span>
                <span>معاينة</span>
              </button>
              <button
                type="button"
                class="kernel-evidence-item__btn"
                data-kernel-evidence-download={item.id}
                aria-label={`تنزيل ${item.id}`}
              >
                <span aria-hidden="true"><Fragment set:html={iconDownload} /></span>
                <span>PDF</span>
              </button>
              {/* M22: JSON verification */}
              <button
                type="button"
                class="kernel-evidence-item__btn"
                data-kernel-evidence-json={item.id}
                aria-label={`JSON للتحقق ${item.id}`}
                data-hash={item.hash}
                data-title={item.title}
              >
                <span aria-hidden="true"><Fragment set:html={iconHash} /></span>
                <span>JSON</span>
              </button>
              {/* PROMPT-3: Verify the certificate tied to this evidence file */}
              {item.certificateId !== '—' && (
                <button
                  type="button"
                  class="kernel-evidence-item__btn kernel-evidence-certs__btn--verify"
                  data-kernel-certs-verify={item.certificateId}
                  aria-label={`تحقق من الشهادة ${item.certificateId}`}
                  data-kernel-touch
                >
                  <span aria-hidden="true"><Fragment set:html={iconShield} /></span>
                  <span>تحقق</span>
                </button>
              )}
            </div>
          </footer>
        </article>
      ))}

      <!-- Empty state: shown when filters yield no evidence items -->
      <div
        class="kernel-evidence__empty-state kernel-evidence-empty-state"
        data-kernel-evidence-empty
        hidden
        role="status"
        aria-live="polite"
      >
        <p class="kernel-evidence-empty-state__title">لا توجد ملفات أدلة مطابقة للفلاتر</p>
        <p class="kernel-evidence-empty-state__hint">وسّع نطاق القطاع أو حزمة الامتثال لعرض المزيد من الملفات.</p>
        <button type="button" class="kernel-evidence-empty-state__reset" data-kernel-evidence-empty-reset data-kernel-touch>
          إعادة ضبط الفلاتر
        </button>
      </div>
    </section>
  </div>

  {/* M22: batch generation modal */}
  <div class="kernel-modal" data-kernel-evidence-batch-modal data-open="false" role="dialog" aria-modal="true" aria-labelledby="ev-batch-title" aria-hidden="true">
    <div class="kernel-modal__backdrop" data-kernel-evidence-batch-close></div>
    <div class="kernel-modal__dialog" style="inline-size: min(560px, 100%);" tabindex="-1">
      <header class="kernel-modal__head">
        <h2 class="kernel-modal__title" id="ev-batch-title">توليد دفعي لملفات الأدلة</h2>
        <button type="button" class="kernel-modal__close" aria-label="إغلاق" data-kernel-evidence-batch-close>
          <Fragment set:html={iconClose} />
        </button>
      </header>
      <div class="kernel-modal__body">
        <div class="kernel-evidence-batch__fields">
          <div style="display:flex; flex-direction:column; gap:4px;">
            <label for="batch-sector" class="kernel-audit-filters__label">القطاع</label>
            <select id="batch-sector" class="kernel-evidence-toolbar__select" data-kernel-batch-sector>
              {SECTORS.map(s => <option value={s.value}>{s.label}</option>)}
            </select>
          </div>
          <div style="display:flex; flex-direction:column; gap:4px;">
            <label for="batch-pack" class="kernel-audit-filters__label">حزمة الامتثال</label>
            <select id="batch-pack" class="kernel-evidence-toolbar__select" data-kernel-batch-pack>
              {COMPLIANCE_PACKS.map(p => <option value={p.value}>{p.label}</option>)}
            </select>
          </div>
          <div style="display:flex; flex-direction:column; gap:4px;">
            <label for="batch-count" class="kernel-audit-filters__label">العدد</label>
            <input id="batch-count" type="number" min="1" max="1000" value="100" class="kernel-evidence-toolbar__input" data-kernel-batch-count />
          </div>
        </div>
        <div class="kernel-evidence-batch__progress" data-kernel-batch-progress hidden>
          <div class="kernel-evidence-batch__bar">
            <span data-kernel-batch-bar></span>
          </div>
          <p data-kernel-batch-status>—</p>
        </div>
      </div>
      <footer class="kernel-modal__actions">
        <button type="button" class="kernel-modal__btn" data-kernel-evidence-batch-close>إلغاء</button>
        <button type="button" class="kernel-modal__btn kernel-modal__btn--primary" data-kernel-evidence-batch-start>ابدأ التوليد</button>
      </footer>
    </div>
  </div>

  {/* Preview modal */}
  <div class="kernel-modal" data-kernel-evidence-preview-modal data-open="false" role="dialog" aria-modal="true" aria-labelledby="ev-preview-title" aria-hidden="true">
    <div class="kernel-modal__backdrop" data-kernel-evidence-preview-modal-close></div>
    <div class="kernel-modal__dialog" style="inline-size: min(880px, 100%);" tabindex="-1">
      <header class="kernel-modal__head">
        <h2 class="kernel-modal__title" id="ev-preview-title">معاينة ملف الدليل</h2>
        <button type="button" class="kernel-modal__close" aria-label="إغلاق" data-kernel-evidence-preview-modal-close>
          <Fragment set:html={iconClose} />
        </button>
      </header>

      <dl class="kernel-modal__preview-meta">
        <dt>Trace</dt><dd data-kernel-preview-trace>—</dd>
        <dt>Hash</dt><dd data-kernel-preview-hash>—</dd>
        <dt>القطاع</dt><dd data-kernel-preview-sector>—</dd>
        <dt>الحزمة</dt><dd data-kernel-preview-pack>—</dd>
        <dt>التوقيع</dt><dd data-kernel-preview-signed>—</dd>
        {/* M22: retention + cert in preview */}
        <dt>الاحتفاظ</dt><dd data-kernel-preview-retention>—</dd>
        <dt>الشهادة</dt><dd data-kernel-preview-cert>—</dd>
      </dl>

      {/* M22: JSON verification inline */}
      <div class="kernel-evidence-jsonverify" data-kernel-preview-jsonverify hidden>
        <p class="kernel-evidence-jsonverify__label">
          <Fragment set:html={iconHash} />
          تحقق سريع من سلسلة الهاش (JSON)
        </p>
        <button type="button" class="kernel-evidence-item__btn" data-kernel-preview-verify>تحقق الآن</button>
        <p class="kernel-evidence-jsonverify__result" data-kernel-preview-verify-result></p>
      </div>

      {/* BAI-PERF-02: HTML evidence preview (replaces pdfjs-dist canvas viewer).
          Renders the same evidence metadata as styled HTML — zero npm deps.
          The "تنزيل PDF" button below still produces a real PDF via the
          zero-dependency kernel-evidence-pdf-lite module. */}
      <div class="kernel-evidence-preview" data-kernel-evidence-preview-panel hidden>
        <div class="kernel-evidence-preview__head">
          <span class="kernel-evidence-preview__title">Evidence File Preview</span>
        </div>
        <pre class="kernel-evidence-preview__body" data-kernel-evidence-preview-body></pre>
        <p class="kernel-evidence-preview__note">معاينة نصية لملف الدليل — التنزيل PDF ينتج ملفاً فعلياً.</p>
      </div>

      <div class="kernel-modal__actions">
        <button type="button" class="kernel-modal__btn" data-kernel-evidence-preview-modal-close>إغلاق</button>
        <button type="button" class="kernel-modal__btn kernel-modal__btn--primary" data-kernel-evidence-download-from-preview>
          <span aria-hidden="true"><Fragment set:html={iconDownload} /></span>
          <span>تنزيل PDF</span>
        </button>
      </div>
    </div>
  </div>

  {/* ═══════════ KERNEL-AI-2026-07-14: AI Assistant + Lead Capture ═══════════ */}

  <section class="kernel-ai-section inner-section" aria-labelledby="ai-assistant-h2">
    <div class="max-w-4xl mx-auto px-5">
      <h2 id="ai-assistant-h2" class="inner-section__title">جرّب بالذكاء الاصطناعي</h2>
      <p class="inner-section__lead inner-section__lead--centered">اسأل محقق الأدلة الرقمية عن بنية ملف الدليل (EVD) أو سلسلة الحفظ أو متطلبات الاحتفاظ.</p>
      <KernelAiAssistant
        promptId="evidence"
        title="محقق الأدلة الرقمية"
        subtitle="متخصص في توثيق استخدامات الذكاء الاصطناعي في المنشآت السعودية."
        placeholder="مثال: وش الحقول الإلزامية في ملف دليل يثبت إخفاء بيانات شخصية لطلب تم رفضه؟"
        id="kai-evidence"
      />
    </div>
  </section>

  <section class="kernel-lead-section inner-section inner-section--alt" aria-labelledby="lead-form-h2-evidence">
    <div class="max-w-3xl mx-auto px-5">
      <h2 id="lead-form-h2-evidence" class="inner-section__title inner-section__title--centered">تبي ملف دليل فعلي لمنشأتك؟</h2>
      <p class="inner-section__lead inner-section__lead--centered">فريق الحوكمة يوضح لك كيف يُولّد Kernel ملف الدليل تلقائياً مع كل قرار.</p>
      <KernelLeadForm id="kernel-lead-form-evidence" page="/kernel/evidence/" />
    </div>
  </section>

  {/* SEO content + FAQ — server-rendered for crawlers (2026-07-14) */}
  <KernelSeoSection
    id="kernel-seo-evidence"
    heading="دليل حوكمة AI — سياق إضافي عن وحدة الأدلة"
    blocks={unit.seoBlocks}
    faq={unit.faq}
  />

  {/* Cross-links: kernel ↔ kernel + solution + doc + blog */}
  <KernelContextLinks
    currentPath={unit.path}
    solutionPath={cross.solutionPath}
    docPath={cross.docPath ?? ''}
    blogPath={cross.blogPath}
    blogLabel={unit.blogLabel}
    relatedSlugs={unit.relatedSlugs}
  />
  <script type="module" src="/js/kernel-loading-state.js"></script>
  {/* PROMPT-3: Signed certificates fetch + verification modal. Loads the
      compiled client module /js/certificate-verifier.js (admin-key pattern,
      server-authoritative verify, PDF/JSON downloads). CSP-safe module. */}
  <script type="module" src="/js/kernel-evidence-certs.js"></script>
  {/* BAI-PERF-02: zero-dependency evidence PDF builder. Replaces the old
      pdfjs-dist (canvas viewer, ~125KB gz) + pdf-lib (~175KB gz) combo.
      This module produces a valid PDF 1.4 from evidence metadata using
      only the standard-14 Courier font — no fonts embedded, no worker,
      no canvas. The inline script below calls window.__kernelEvidencePdf
      when the user clicks "تنزيل PDF". */}
  <script>
    import { buildEvidencePdfBlob } from '../../scripts/kernel-evidence-pdf-lite';
    window.__kernelEvidencePdf = (data) => buildEvidencePdfBlob(data);
  </script>
</KernelLayout>

<script is:inline>
  // REPORTS-15 + M22 — Evidence interactivity (filters, preview, JSON verify,
  // batch generation, trace/cert links, third-party upload, tampering).
  (function () {
    'use strict';

    function el(q, root) { return (root || document).querySelector(q); }
    function elAll(q, root) { return Array.prototype.slice.call((root || document).querySelectorAll(q)); }

    function downloadFile(name, mime, content) {
      var blob = (content instanceof Blob) ? content : new Blob([content], { type: mime });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url; a.download = name;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 1500);
    }

    function riskBadgeFor(score) {
      if (score > 85) return '<span class="kernel-risk-badge kernel-risk-badge--critical">حرج (' + score + ')</span>';
      if (score >= 60) return '<span class="kernel-risk-badge kernel-risk-badge--high">مرتفع (' + score + ')</span>';
      if (score >= 30) return '<span class="kernel-risk-badge kernel-risk-badge--medium">متوسط (' + score + ')</span>';
      return '<span class="kernel-risk-badge kernel-risk-badge--low">منخفض (' + score + ')</span>';
    }

    // ── M22: Tampering demo — visually breaks the hash chain ──
    function bindTamper() {
      var btn = el('[data-kernel-evidence-tamper]');
      if (!btn || btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', function () {
        var chain = el('[data-kernel-evidence-hashchain]');
        var result = el('[data-kernel-evidence-tamper-result]');
        if (!chain || !result) return;
        chain.hidden = false;
        chain.classList.add('kernel-evidence-hashchain--tampered');
        var boxes = elAll('.kernel-evidence-hashchain__box', chain);
        // Flip the current hash bytes visually (demo tamper).
        boxes[1].textContent = '0xb1d9…DEAD';
        boxes[1].classList.remove('kernel-evidence-hashchain__box--current');
        boxes[1].classList.add('kernel-evidence-hashchain__box--broken');
        result.textContent = '❌ تغيّر بايت واحد → السلسلة انكسرت ولم يعد التحقق ممكناً';
        result.className = 'kernel-evidence-tamper__result kernel-evidence-tamper__result--fail';
      });
    }

    // ── M22: Third-party upload (dropzone) — demo verification UI ──
    function bindDropzone() {
      var dz = el('[data-kernel-evidence-dropzone]');
      if (!dz || dz.dataset.bound === '1') return;
      dz.dataset.bound = '1';

      function handle(file) {
        // Demo: parse file name only — no content read/storage (privacy).
        var isEVD = /EVD-|\.pdf$|\.json$/i.test(file.name);
        var result = document.createElement('p');
        result.className = 'kernel-evidence-dropzone__result ' + (isEVD ? 'ok' : 'fail');
        result.setAttribute('role', 'status');
        result.textContent = isEVD
          ? '✅ التوقيع الرقمي سليم — الملف موقّع ولم يُعبث به (محاكاة)'
          : '❌ التنسيق غير معروف — ارفع ملف EVD بصيغة PDF أو JSON';
        dz.querySelector('.kernel-evidence-dropzone__hint').replaceWith(result);
      }

      // Click to pick (non-PII; no upload — demo only).
      dz.addEventListener('click', function () {
        var input = document.createElement('input');
        input.type = 'file';
        input.accept = '.pdf,.json,application/pdf,application/json';
        input.addEventListener('change', function () {
          if (input.files && input.files[0]) handle(input.files[0]);
        });
        input.click();
      });
      // Keyboard activation (Enter / Space).
      dz.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); dz.click(); }
      });
      // Drag & drop (prevent default, demo handle).
      ['dragenter', 'dragover'].forEach(function (name) {
        dz.addEventListener(name, function (e) { e.preventDefault(); dz.classList.add('kernel-evidence-dropzone--dragover'); });
      });
      ['dragleave', 'drop'].forEach(function (name) {
        dz.addEventListener(name, function (e) { e.preventDefault(); dz.classList.remove('kernel-evidence-dropzone--dragover'); });
      });
      dz.addEventListener('drop', function (e) {
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) handle(e.dataTransfer.files[0]);
      });
    }

    // ── M22: JSON verification (signed hash) ──
    function openJson(btn) {
      var id = btn.getAttribute('data-kernel-evidence-json');
      var card = el('[data-kernel-evidence-item="' + id + '"]');
      if (!card) return;
      var hash = btn.getAttribute('data-hash') || '0xunknown';
      var title = btn.getAttribute('data-title') || id;
      var payload = {
        evidence_id: id,
        title: title,
        hash_sha256: hash,
        algorithm: 'SHA-256',
        signed: true,
        format: 'EVD v1.0',
        // Retention is metadata only — no PII.
        retention: (card.querySelector('.kernel-evidence-item__retention') || {}).textContent || '—',
      };
      downloadFile(id + '.evd.json', 'application/json;charset=utf-8', JSON.stringify(payload, null, 2));

      // Show a quick verify confirmation inline on the card.
      var existing = card.querySelector('.kernel-evidence-jsonverify-inline');
      if (existing) existing.remove();
      var box = document.createElement('div');
      box.className = 'kernel-evidence-jsonverify-inline';
      box.setAttribute('role', 'status');
      box.innerHTML = '<span class="kernel-evidence-jsonverify-inline__ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> الهاش مطابق — الملف غير مُعبث به (JSON)</span>';
      card.querySelector('.kernel-evidence-item__footer').appendChild(box);
      setTimeout(function () { box.remove(); }, 4000);
    }

    // ── M22: In-modal quick verify ──
    function verifyInModal() {
      var btn = el('[data-kernel-preview-verify]');
      if (!btn || btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', function () {
        var result = el('[data-kernel-preview-verify-result]');
        if (!result) return;
        result.textContent = '✅ الهاش SHA-256 مطابق لسلسلة الأدلة — التوقيع صحيح (محاكاة)';
        result.className = 'kernel-evidence-jsonverify__result ok';
      });
    }

    function openPreview(btn) {
      var modal = el('[data-kernel-evidence-preview-modal]');
      if (!modal) return;

      var rt = window.__BRIGHTAI_ANALYTICS__;
      if (rt && typeof rt.track === 'function') {
        rt.track(rt.events.EVIDENCE_VIEWED, {
          source: 'preview',
          evidence_id: btn.getAttribute('data-kernel-evidence-preview') || undefined,
          sector: btn.getAttribute('data-sector') || undefined,
          pack: btn.getAttribute('data-pack') || undefined,
        });
      }
      var data = {
        title:  btn.getAttribute('data-title'),
        trace:  btn.getAttribute('data-trace'),
        hash:   btn.getAttribute('data-hash'),
        query:  btn.getAttribute('data-query'),
        status: btn.getAttribute('data-status'),
        signed: btn.getAttribute('data-signed'),
        sector: btn.getAttribute('data-sector'),
        pack:   btn.getAttribute('data-pack'),
        size:   btn.getAttribute('data-size'),
        risk:   parseInt(btn.getAttribute('data-risk') || '0', 10),
        id:     btn.getAttribute('data-kernel-evidence-preview'),
        retention: btn.getAttribute('data-retention') || '—',
        cert:   btn.getAttribute('data-cert') || '—',
      };

      var setText = function (sel, val) { var n = el(sel); if (n) n.textContent = val || '—'; };
      setText('[data-kernel-preview-trace]', data.trace);
      setText('[data-kernel-preview-hash]', data.hash);
      setText('[data-kernel-preview-sector]', data.sector);
      setText('[data-kernel-preview-pack]', data.pack);
      setText('[data-kernel-preview-signed]', data.signed);
      setText('[data-kernel-preview-retention]', data.retention);
      setText('[data-kernel-preview-cert]', data.cert);

      // Reset quick-verify state.
      var vRes = el('[data-kernel-preview-verify-result]');
      if (vRes) { vRes.textContent = ''; vRes.className = 'kernel-evidence-jsonverify__result'; }
      var vBox = el('[data-kernel-preview-jsonverify]');
      if (vBox) vBox.hidden = false;

      modal.setAttribute('data-open', 'true');
      modal.setAttribute('aria-hidden', 'false');
      modal.dataset.previewId = data.id || '';

      // BAI-PERF-02: render the evidence data as styled HTML instead of a
      // pdfjs-dist canvas render. Same fields, zero npm deps.
      renderEvidencePreview(data);

      setTimeout(function () {
        var close = el('.kernel-modal__close');
        if (close) close.focus();
      }, 50);
    }

    function closePreview() {
      var modal = el('[data-kernel-evidence-preview-modal]');
      if (!modal) return;
      modal.setAttribute('data-open', 'false');
      modal.setAttribute('aria-hidden', 'true');
    }

    function downloadFor(id) {
      var card = el('[data-kernel-evidence-item="' + id + '"]');
      if (!card) return;
      // BAI-PERF-02: collect the same metadata the preview modal uses, then
      // hand it to the zero-dependency PDF builder (buildEvidencePdfBlob).
      // This produces a real, valid PDF instead of the old .pdf.txt plain
      // text, and costs 0 bytes of JS deps (the old path pulled pdf-lib).
      var previewBtn = card.querySelector('[data-kernel-evidence-preview]');
      var data = {
        id: id,
        title: (card.querySelector('.kernel-evidence-item__sub') || {}).textContent || id,
        query: '—',
        trace: previewBtn ? (previewBtn.getAttribute('data-trace') || '—') : '—',
        hash: previewBtn ? (previewBtn.getAttribute('data-hash') || '—') : '—',
        risk: previewBtn ? parseInt(previewBtn.getAttribute('data-risk') || '0', 10) : 0,
        status: previewBtn ? (previewBtn.getAttribute('data-status') || '—') : '—',
        sector: previewBtn ? (previewBtn.getAttribute('data-sector') || '—') : '—',
        pack: previewBtn ? (previewBtn.getAttribute('data-pack') || '—') : '—',
        retention: previewBtn ? (previewBtn.getAttribute('data-retention') || '—') : '—',
        cert: previewBtn ? (previewBtn.getAttribute('data-cert') || '—') : '—',
        size: (card.querySelector('.kernel-evidence-item__meta dd:nth-of-type(4)') || {}).textContent || '—',
        signed: previewBtn ? (previewBtn.getAttribute('data-signed') || '—') : '—',
      };
      if (window.__kernelEvidencePdf) {
        var blob = window.__kernelEvidencePdf(data);
        downloadFile(id + '.pdf', 'application/pdf', blob);
      } else {
        // Fallback (module not yet loaded): keep the old text behaviour so
        // the button never dead-ends. This branch should be unreachable in
        // practice because the module script is in the same page.
        downloadFile(id + '.pdf.txt', 'text/plain;charset=utf-8', 'BrightAI Kernel — Evidence File\n\nID: ' + id);
      }
    }

    // BAI-PERF-02: render the evidence data as styled HTML inside the preview
    // modal. Replaces the pdfjs-dist canvas renderer. Mirrors the PDF body so
    // what the user sees matches what they download.
    function renderEvidencePreview(data) {
      var preview = el('[data-kernel-evidence-preview-panel]');
      var body = el('[data-kernel-evidence-preview-body]');
      if (!preview || !body) return;
      var sep = '======================================================';
      var lines = [
        { t: 'BrightAI Kernel — Evidence File', c: 'head' },
        { t: sep, c: 'sep' },
        { t: '' },
        { t: 'Evidence ID    : ' + (data.id || '—') },
        { t: 'Title          : ' + (data.title || '—') },
        { t: 'Query          : ' + (data.query || '—') },
        { t: 'Trace ID       : ' + (data.trace || '—') },
        { t: 'Hash (SHA-256) : ' + (data.hash || '—') },
        { t: 'Risk Score     : ' + (data.risk != null ? data.risk + ' / 100' : '—') },
        { t: 'Status         : ' + (data.status || '—') },
        { t: 'Sector         : ' + (data.sector || '—') },
        { t: 'Compliance Pack: ' + (data.pack || '—') },
        { t: 'Retention      : ' + (data.retention || '—') },
        { t: 'Certificate    : ' + (data.cert || '—') },
        { t: 'Size           : ' + (data.size || '—') },
        { t: 'Signed         : ' + (data.signed || '—') },
        { t: '' },
        { t: sep, c: 'sep' },
        { t: 'Demo file. In production this is generated server-side from', c: 'foot' },
        { t: 'the Kernel API and signed cryptographically (Ed25519 / SHA-256).', c: 'foot' },
        { t: '', c: 'foot' },
        { t: 'Verification: /api/kernel/certificates/verify', c: 'foot' },
      ];
      // Build lines as escaped text nodes to avoid any HTML injection from
      // metadata values (defense in depth — data is local/demo only).
      body.textContent = lines.map(function (l) { return l.t; }).join('\n');
      preview.hidden = false;
    }

    function applyFilters() {
      var sector = el('[data-kernel-evidence-filter="sector"]').value;
      var pack = el('[data-kernel-evidence-filter="pack"]').value;
      var tag = el('[data-kernel-evidence-filter="tag"]').value;

      var items = elAll('[data-kernel-evidence-item]');
      var shown = 0;
      var totalSize = 0;
      var packs = new Set();
      items.forEach(function (it) {
        var s = it.getAttribute('data-sector') || '';
        var p = it.getAttribute('data-pack') || '';
        var t = it.getAttribute('data-tags') || '';
        var visible =
          (sector === '' || s === sector) &&
          (pack === '' || p === pack) &&
          (tag === '' || t.split(',').indexOf(tag) !== -1);
        it.hidden = !visible;
        if (visible) {
          shown++;
          var sizeTxt = (it.querySelector('.kernel-evidence-item__meta dd:nth-of-type(5)') || {}).textContent || '';
          var kb = parseFloat((sizeTxt || '').replace(/[^\d.]/g, ''));
          if (!isNaN(kb)) totalSize += kb;
          packs.add(p);
        }
      });

      var counter = el('[data-kernel-evidence-count]');
      if (counter) {
        counter.textContent =
          shown + ' من ' + items.length +
          ' · ' + (totalSize ? Math.round(totalSize) + 'KB' : '—') + ' إجمالي' +
          ' · ' + packs.size + ' حزم امتثال';
      }

      var emptyEl = el('[data-kernel-evidence-empty]');
      if (emptyEl) emptyEl.hidden = shown !== 0;
    }

    function generateNew() {
      var grid = el('[data-kernel-evidence-grid]');
      if (!grid) return;
      var id = 'EVD-2026-' + (10500 + Math.floor(Math.random() * 99));
      var trace = 'AI-2026-' + (10500 + Math.floor(Math.random() * 99));
      var now = new Date();
      var iso = now.toISOString();
      var localTime = now.toLocaleTimeString('ar-SA', { hour: '2-digit', minute: '2-digit', hour12: false });
      var sectors = ['banking', 'government', 'healthcare', 'manufacturing', 'telecom'];
      var packs = ['pdpl', 'nca', 'sdaia', 'sfda', 'sama', 'iso42001', 'iso27001'];
      var sector = sectors[Math.floor(Math.random() * sectors.length)];
      var pack = packs[Math.floor(Math.random() * packs.length)];
      var sectorLabel = { banking: 'البنوك', government: 'الحكومة', healthcare: 'الرعاية الصحية', manufacturing: 'الصناعة', telecom: 'الاتصالات' }[sector];
      var packLabel = { pdpl: 'PDPL', nca: 'NCA ECC', sdaia: 'SDAIA', sfda: 'SFDA', sama: 'SAMA', iso42001: 'ISO 42001', iso27001: 'ISO 27001' }[pack];
      var risk = Math.floor(Math.random() * 80) + 10;
      var status = risk > 85 ? 'blocked' : risk >= 60 ? 'pending_approval' : 'allowed';
      var hash = '0x' + Array.from({ length: 32 }, function () { return '0123456789abcdef'[Math.floor(Math.random() * 16)]; }).join('');
      var retention = { pdpl: '5 سنوات — PDPL م.21', nca: '5 سنوات — NCA ECC-2', sdaia: 'سنتان — SDAIA م.7', sfda: '7 سنوات — SFDA م.19', sama: '5 سنوات — SAMA CSF-2', iso42001: 'سنتان — ISO 42001 A.5.2', iso27001: 'سنتان — ISO 27001 A.5.1' }[pack];
      var cert = 'CERT-2026-' + (820 + Math.floor(Math.random() * 40));

      var article = document.createElement('article');
      article.className = 'kernel-evidence-item';
      article.setAttribute('data-kernel-evidence-item', id);
      article.setAttribute('data-sector', sector);
      article.setAttribute('data-pack', pack);
      article.setAttribute('data-tags', 'audit');
      article.setAttribute('data-created-at', iso);

      article.innerHTML =
        '<header class="kernel-evidence-item__head">' +
          '<span class="kernel-evidence-item__icon" aria-hidden="true">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>' +
          '</span>' +
          '<div class="kernel-evidence-item__title-block">' +
            '<h3 class="kernel-evidence-item__title">' + id + '.pdf</h3>' +
            '<p class="kernel-evidence-item__sub">دليل مولّد تلقائياً — ' + localTime + '</p>' +
          '</div>' +
        '</header>' +
        '<dl class="kernel-evidence-item__meta">' +
          '<dt>التاريخ</dt><dd>' + localTime + '</dd>' +
          '<dt>القطاع</dt><dd>' + sectorLabel + '</dd>' +
          '<dt>الحزمة</dt><dd>' + packLabel + '</dd>' +
          '<dt>الحجم</dt><dd>' + (32 + Math.floor(Math.random() * 90)) + 'KB</dd>' +
          '<dt>الاحتفاظ</dt><dd class="kernel-evidence-item__retention">' + retention + '</dd>' +
          '<dt>Trace</dt><dd><a class="kernel-evidence-item__trace" href="/kernel/audit/?trace=' + trace + '">' + trace + '</a></dd>' +
          '<dt>الشهادة</dt><dd><a class="kernel-evidence-item__cert" href="#verify"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>' + cert + '</a></dd>' +
        '</dl>' +
        '<div class="kernel-evidence-item__tags"><span class="kernel-evidence-item__tag">audit</span></div>' +
        '<footer class="kernel-evidence-item__footer">' +
          '<span class="kernel-evidence-item__signature' + (status === 'pending_approval' ? ' kernel-evidence-item__signature--pending' : '') + '">' +
            '<span aria-hidden="true">' +
              (status === 'pending_approval'
                ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>'
                : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>') +
            '</span>' +
            '<span>' + (status === 'pending_approval' ? 'بانتظار التوقيع' : 'موقّع رقمياً') + '</span>' +
          '</span>' +
          '<div style="display:flex; gap:var(--space-1);">' +
            '<button type="button" class="kernel-evidence-item__btn" data-kernel-evidence-preview="' + id + '" data-title="دليل مولّد تلقائياً" data-trace="' + trace + '" data-hash="' + hash + '" data-query="استعلام آلي" data-status="' + status + '" data-signed="' + localTime + '" data-sector="' + sectorLabel + '" data-pack="' + packLabel + '" data-size="64KB" data-risk="' + risk + '" data-retention="' + retention + '" data-cert="' + cert + '">' +
              '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg><span>معاينة</span>' +
            '</button>' +
            '<button type="button" class="kernel-evidence-item__btn" data-kernel-evidence-download="' + id + '" aria-label="تنزيل ' + id + '">' +
              '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span>PDF</span>' +
            '</button>' +
            '<button type="button" class="kernel-evidence-item__btn" data-kernel-evidence-json="' + id + '" aria-label="JSON للتحقق ' + id + '" data-hash="' + hash + '" data-title="دليل مولّد تلقائياً">' +
              '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg><span>JSON</span>' +
            '</button>' +
          '</div>' +
        '</footer>';

      grid.insertBefore(article, grid.firstChild);
      article.style.animation = 'kernelChatMsgIn 0.4s var(--ease-out) both';

      bindItemButtons(article);
      applyFilters();
    }

    // ── M22: batch generation modal + progress ──
    function bindBatch() {
      var openBtn = el('[data-kernel-evidence-batch]');
      var modal = el('[data-kernel-evidence-batch-modal]');
      if (!openBtn || !modal) return;

      function show(open) {
        modal.setAttribute('data-open', open ? 'true' : 'false');
        modal.setAttribute('aria-hidden', open ? 'false' : 'true');
      }
      if (openBtn.dataset.bound !== '1') {
        openBtn.dataset.bound = '1';
        openBtn.addEventListener('click', function () { show(true); });
      }
      elAll('[data-kernel-evidence-batch-close]', modal).forEach(function (n) {
        if (n.dataset.bound === '1') return;
        n.dataset.bound = '1';
        n.addEventListener('click', function () { show(false); });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal.getAttribute('data-open') === 'true') show(false);
      });

      var start = el('[data-kernel-evidence-batch-start]');
      if (start && start.dataset.bound !== '1') {
        start.dataset.bound = '1';
        start.addEventListener('click', function () {
          var count = parseInt(el('[data-kernel-batch-count]').value || '100', 10);
          var sector = el('[data-kernel-batch-sector]').value;
          var pack = el('[data-kernel-batch-pack]').value;
          var progressWrap = el('[data-kernel-batch-progress]');
          var bar = el('[data-kernel-batch-bar]');
          var status = el('[data-kernel-batch-status]');
          if (!progressWrap || !bar || !status) return;
          progressWrap.hidden = false;
          var done = 0;
          status.textContent = '0 من ' + count + ' — جارٍ التوليد…';
          bar.style.inlineSize = '0%';
          var timer = setInterval(function () {
            done += 5 + Math.floor(Math.random() * 12);
            if (done >= count) done = count;
            bar.style.inlineSize = Math.round((done / count) * 100) + '%';
            status.textContent = done + ' من ' + count + ' — ' + Math.round((done / count) * 100) + '%';
            if (done >= count) {
              clearInterval(timer);
              status.textContent = 'تم توليد ' + count + ' ملف دليل ✓';
              // Generate a few visible cards as a demo sample.
              var sample = Math.min(3, count);
              for (var i = 0; i < sample; i++) generateNew();
              // Note: sector/pack filters are applied to the demo sample via
              // the tag/audit default; full fidelity requires the Kernel API.
              setTimeout(function () { show(false); }, 1800);
            }
          }, 120);
        });
      }
    }

    function bindItemButtons(scope) {
      var root = scope || document;
      elAll('[data-kernel-evidence-preview]', root).forEach(function (b) {
        if (b.dataset.bound === '1') return;
        b.dataset.bound = '1';
        b.addEventListener('click', function () { openPreview(b); });
      });
      elAll('[data-kernel-evidence-download]', root).forEach(function (b) {
        if (b.dataset.bound === '1') return;
        b.dataset.bound = '1';
        b.addEventListener('click', function () { downloadFor(b.getAttribute('data-kernel-evidence-download') || ''); });
      });
      elAll('[data-kernel-evidence-json]', root).forEach(function (b) {
        if (b.dataset.bound === '1') return;
        b.dataset.bound = '1';
        b.addEventListener('click', function () { openJson(b); });
      });
    }

    function bindModal() {
      var modal = el('[data-kernel-evidence-preview-modal]');
      if (!modal || modal.dataset.bound === '1') return;
      modal.dataset.bound = '1';
      elAll('[data-kernel-evidence-preview-modal-close]', modal).forEach(function (n) {
        n.addEventListener('click', closePreview);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal.getAttribute('data-open') === 'true') closePreview();
      });
      var dl = el('[data-kernel-evidence-download-from-preview]');
      if (dl) dl.addEventListener('click', function () {
        var id = modal.dataset.previewId;
        if (id) downloadFor(id);
      });
      verifyInModal();
    }

    function bindFilters() {
      elAll('[data-kernel-evidence-filter]').forEach(function (sel) {
        if (sel.dataset.bound === '1') return;
        sel.dataset.bound = '1';
        sel.addEventListener('change', applyFilters);
      });

      var resetBtn = el('[data-kernel-evidence-empty-reset]');
      if (resetBtn && resetBtn.dataset.bound !== '1') {
        resetBtn.dataset.bound = '1';
        resetBtn.addEventListener('click', function () {
          elAll('[data-kernel-evidence-filter]').forEach(function (sel) { sel.value = ''; });
          applyFilters();
        });
      }
      applyFilters();
    }

    function bindGenerate() {
      var btn = el('[data-kernel-evidence-generate]');
      if (!btn || btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', generateNew);
    }

    // M28 — approvals→evidence: يقرأ ?trace= (و ?evd= اختياري) من الرابط
    // القادم من سجل قرارات الموافقة، فيُبرز ملف الدليل المطابق للـ trace.
    // لا يغيّر أي نص منشور — يُظهر/يبرز عنصرًا موجودًا فقط.
    function applyLinkParams() {
      var sp;
      try { sp = new URLSearchParams(window.location.search); } catch (e) { return; }
      var trace = sp.get('trace');
      if (!trace) return;
      var items = elAll('[data-kernel-evidence-item]');
      var target = null;
      for (var i = 0; i < items.length; i += 1) {
        if (items[i].getAttribute('data-trace') === trace) { target = items[i]; break; }
      }
      if (!target) {
        // لا ملف مطابق للـ trace — نظهر شارة لطيفة (المحتوى نفسه ما يتغيّر).
        var grid = el('[data-kernel-evidence-grid]');
        if (grid) {
          var note = document.createElement('div');
          note.className = 'kernel-evidence-linknote';
          note.setAttribute('role', 'status');
          note.textContent = 'لا ملف دليل مطابق للـ trace ' + trace + ' — تولّد الملفات تجريبيًا في هذه الصفحة.';
          grid.insertBefore(note, grid.firstChild);
        }
        return;
      }
      // تصفية الفلاتر لعرض العنصر المطابق فقط.
      elAll('[data-kernel-evidence-filter]').forEach(function (sel) { sel.value = ''; });
      items.forEach(function (it) { it.hidden = it !== target; });
      var counter = el('[data-kernel-evidence-count]');
      if (counter) counter.textContent = '1 من ' + items.length + ' — ملف مطابق للـ trace';
      var emptyEl = el('[data-kernel-evidence-empty]');
      if (emptyEl) emptyEl.hidden = false;
      // تمرير المعرّفات إلى زر المعاينة حتى يفتح المودال الصحيح.
      target.scrollIntoView({ block: 'center' });
      target.classList.add('kernel-evidence-item--linktarget');
      setTimeout(function () {
        if (target) target.classList.remove('kernel-evidence-item--linktarget');
      }, 2200);
      var focusBtn = target.querySelector('[data-kernel-evidence-preview]');
      if (focusBtn) focusBtn.focus({ preventScroll: true });
    }

    // BAI-P0-TRUTH-001: the demo-mode toggle was removed — this surface shows
    // only deterministic data, so the grid/toolbar stay visible. The existing
    // filter-driven empty state (data-kernel-evidence-empty) keeps its job:
    // it appears when a filter returns zero rows, not on a source switch.

    function init() {
      bindFilters();
      bindItemButtons();
      bindModal();
      bindGenerate();
      bindBatch();
      bindTamper();
      bindDropzone();
      applyLinkParams();
    }
  
    document.addEventListener('astro:page-load', init);
    if (document.readyState !== 'loading') init();
  })();
</script>