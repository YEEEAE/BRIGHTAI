function signatureClass(item: EvidenceItem): string {
  if (!item.signedAt) return 'kernel-evidence-item__signature--pending';
  if (item.status === 'draft') return 'kernel-evidence-item__signature--draft';
  return '';
}

function signatureText(item: EvidenceItem): string {
  if (!item.signedAt) return 'بانتظار التوقيع';
  if (item.status === 'draft') return 'مسودة — غير موقّعة';
  return 'موقّع رقمياً';
}

function signatureIcon(item: EvidenceItem): string {
  if (!item.signedAt) return iconClock;
  if (item.status === 'draft') return iconFile;
  return iconCheck;
}

