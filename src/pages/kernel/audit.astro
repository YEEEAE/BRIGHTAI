---
/**
 * /kernel/audit/ — Audit log + hash chain verification (REPORTS-15 full build).
 *
 * REPORTS-15 — Enterprise audit dashboard, deterministic + virtualized:
 * 1. KPI strip: 4 baseline cards (total / allowed / blocked / approvals) SSR'd
 *    from the deterministic dataset (src/data/kernel-audit.ts).
 * 2. Filters bar: date range + risk level + status + user + department.
 * 3. Toolbar: record count + text search + clear + export (CSV / JSON / PDF).
 * 4. VIRTUALIZED table: 12,483 rows → ~40 DOM nodes. Only the visible window
 *    renders; scroll delta-re-renders via the engine (ROW_H = 44px).
 * 5. Hash chain verifier: paste a Trace ID → engine recomputes FNV-1a and
 *    compares prev/current/next. Tamper button = labelled demo (mutates a COPY).
 * 6. Detail drawer: full context + trace JSON + DevTools snippet + timeline.
 * 7. RTL-aware, V3 tokens, fixed 44px rows on mobile (virtualization math safe).
 *
 * Determinism contract (verified by scripts/verify-audit.mjs):
 *   total = 12,483 · allowed = 11,210 · blocked = 382 · pending = 841
 *   error = 50 · approvals = 1,554 · chain genesis 0x00000000.
 *
 * Scripts (CSP-safe, external only):
 *   /js/kernel-audit-data.js  → classic UMD, exposes window.KernelAuditData
 *   /js/kernel-audit.js       → ES module engine (worker + virtualization)
 *   /js/kernel-loading-state.js → skeleton/loading transition
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelAiAssistant from '../../components/kernel/KernelAiAssistant.astro';
import KernelLeadForm from '../../components/kernel/KernelLeadForm.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import { getKernelUnit, getCrossLinks, getKernelFaqJsonLd } from '../../data/kernel';
import { getKernelSubPageJsonLd } from '../../data/schema-helpers';
import KernelSkeleton from '../../components/kernel/KernelSkeleton.astro';
import KernelEmptyState from '../../components/kernel/KernelEmptyState.astro';
import { buildAuditStats } from '../../data/kernel-audit';
// KRN-001/002 / EXEC-02: no longer import KERNEL_SYSTEM_PROMPTS — server uses promptId allowlist

const unit = getKernelUnit('audit')!;
const cross = getCrossLinks(unit);

// Deterministic baseline — computed at build time, byte-identical to the
// client dataset (kernel-audit-data.js). SSR'd into the KPI strip.
const stats = buildAuditStats();

// SCHEMA-ENHANCEMENT (2026-07-14): add SoftwareApplication + BreadcrumbList + FAQPage
const jsonLd: Record<string, unknown>[] = [
  ...getKernelSubPageJsonLd(unit),
  getKernelFaqJsonLd(unit),
].filter((item): item is Record<string, unknown> => Boolean(item));

const iconDownload = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>';
const iconCopy = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>';
const iconCheck = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
const iconClose = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
const iconShield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>';

// Filters risk levels
const RISK_LEVELS = [
  { value: '', label: 'كل المستويات' },
  { value: 'low', label: 'منخفض (≤30)' },
  { value: 'medium', label: 'متوسط (31-60)' },
  { value: 'high', label: 'مرتفع (61-85)' },
  { value: 'critical', label: 'حرج (>85)' },
];

// Filters statuses
const STATUSES = [
  { value: '', label: 'كل الحالات' },
  { value: 'allowed', label: 'مسموح' },
  { value: 'blocked', label: 'محظور' },
  { value: 'pending_approval', label: 'بانتظار الموافقة' },
  { value: 'error', label: 'خطأ' },
];

// Users (filter dropdown)
const USERS = [
  { id: '', label: 'كل المستخدمين' },
  { id: 'm.alharbi', label: 'محمد الحربي — التسويق' },
  { id: 's.alfaisal', label: 'سارة الفيصل — المالية' },
  { id: 'a.alqahtani', label: 'أحمد القحطاني — العمليات' },
  { id: 'n.alshahrani', label: 'نورة الشهراني — القانونية' },
  { id: 'k.alghamdi', label: 'خالد الغامدي — تقنية' },
];

// Departments (filter dropdown — matches row.role)
const DEPTS = [
  { id: '', label: 'كل الأقسام' },
  { id: 'تسويق', label: 'التسويق' },
  { id: 'مالية', label: 'المالية' },
  { id: 'عمليات', label: 'العمليات' },
  { id: 'قانونية', label: 'القانونية' },
  { id: 'تقنية', label: 'تقنية المعلومات' },
];

const fmtCount = (n: number) => n.toLocaleString('ar-SA');
---

<style>
  /*
   * Mobile-first + RTL baseline for Audit (kernel championship).
   * Logical properties (RTL-safe), ≥44px touch targets, responsive breakpoints,
   * and empty/loading state styles. Uses design tokens.
   * NOTE: the virtualized-table + KPI + verifier styles live in src/styles/kernel.css
   * (block 23b) so they stay consistent with the rest of the kernel pages.
   */
  .kernel-audit__empty-state,
  .kernel-audit-empty-state {
    padding-inline: var(--space-6);
    margin-inline: auto;
    text-align: start;
    color: var(--text-muted);
    border-inline-start: 3px solid var(--interactive-primary);
  }
  .kernel-audit__skeleton,
  .kernel-audit-skeleton {
    inset-inline-start: 0;
    background: var(--bg-elevated);
    animation: kernel-audit-shimmer 1.4s var(--ease-in-out) infinite;
  }
  @keyframes kernel-audit-shimmer {
    0% { opacity: 1; }
    50% { opacity: 0.45; }
    100% { opacity: 1; }
  }
  .kernel-audit [data-kernel-touch],
  .kernel-audit__touch {
    min-height: 44px;
    min-width: 44px;
  }
  .kernel-audit__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .kernel-audit__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }
  @media (max-width: 640px) {
    .kernel-audit [data-kernel-touch] { min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kernel-audit-skeleton { animation: none; }
  }

  .kernel-audit-empty-state[hidden] { display: none; }
  .kernel-audit-empty-state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-8);
    padding-inline: var(--space-6);
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
  }
  .kernel-audit-empty-state__title {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--text-primary);
  }
  .kernel-audit-empty-state__hint {
    margin: 0;
    color: var(--text-secondary);
  }
  .kernel-audit-empty-state__reset {
    min-height: 44px;
    min-width: 44px;
    padding-inline: var(--space-5);
    padding-block: var(--space-2);
    border: 1px solid var(--interactive-primary);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--interactive-primary);
    cursor: pointer;
  }
  .kernel-audit-empty-state__reset:hover { background: var(--bg-elevated); }

  /* Loading state: hide content while skeleton is visible */
  [data-kernel-loading] > *:not([data-kernel-skeleton]):not([data-kernel-empty]) {
    display: none;
  }
  .kernel-loading-skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
</style>

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: 'التدقيق', href: unit.path }]}
  extraSpeakableSelectors={['.answer-first-summary']}
>
  <header class="kernel-page-header">
    <div class="kernel-page-header__lead">
      <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
        <ol>
          <li><a href="/">BrightAI</a></li>
          <li><a href="/kernel/">Kernel</a></li>
          <li aria-current="page">{unit.label}</li>
        </ol>
      </nav>
      <h1 class="kernel-page-header__title">{unit.h1}</h1>
      {/* BAI-VOC-001-B (2026-07-18): answer-first summary — wired as the
          second cssSelector for WebPage SpeakableSpecification. */}
      <p class="answer-first-summary" data-speakable-target="answer-first">سجل تدقيق غير قابل للتعديل يحفظ كل قرار AI: prompt، model، risk score، approval، action. حماية بـ hash chain يكشف أي تعديل، وفلاتر متقدمة للبحث بالزمن والمستخدم والمخاطر. إعادة بناء أي قرار من بدايته لنهايته في ثوانٍ.</p>
      <p class="kernel-page-header__subtitle">
        سلسلة قرارات الذكاء الاصطناعي مع تحقق hash chain، Trace Timeline للمراحل الست، وفلاتر متقدمة للقسم والمخاطر.
      </p>
    </div>
    <div class="kernel-page-header__actions">
      <KernelDemoPill />
    </div>
  </header>

  <div class="kernel-main kernel-page-fade-in" data-kernel-loading data-kernel-count={stats.total}>
    <div data-kernel-skeleton class="kernel-loading-skeleton">
      <KernelSkeleton variant="card" count={3} />
      <KernelSkeleton variant="text" count={5} />
    </div>
    <div data-kernel-empty hidden>
      <KernelEmptyState title="ما في سجلات تدقيق الحين" message="سجل التدقيق يعرض القرارات فور توفرها." />
    </div>

    <!-- KPI strip — deterministic baseline (SSR) -->
    <section class="kernel-audit-kpis" aria-label="مؤشرات سجل التدقيق">
      <div class="kernel-audit-kpi">
        <span class="kernel-audit-kpi__value" data-ka-kpi-total>{fmtCount(stats.total)}</span>
        <span class="kernel-audit-kpi__label">سجل إجمالي</span>
      </div>
      <div class="kernel-audit-kpi kernel-audit-kpi--success">
        <span class="kernel-audit-kpi__value" data-ka-kpi-allowed>{fmtCount(stats.allowed)}</span>
        <span class="kernel-audit-kpi__label">مسموح</span>
      </div>
      <div class="kernel-audit-kpi kernel-audit-kpi--danger">
        <span class="kernel-audit-kpi__value" data-ka-kpi-blocked>{fmtCount(stats.blocked)}</span>
        <span class="kernel-audit-kpi__label">محظور</span>
      </div>
      <div class="kernel-audit-kpi kernel-audit-kpi--accent">
        <span class="kernel-audit-kpi__value" data-ka-kpi-approvals>{fmtCount(stats.approvals)}</span>
        <span class="kernel-audit-kpi__label">موافقات بشرية</span>
      </div>
    </section>

    <!-- Filters bar -->
    <section class="kernel-audit-filters" aria-label="فلاتر سجل التدقيق">
      <div class="kernel-audit-filters__field">
        <label for="audit-date-from" class="kernel-audit-filters__label">من تاريخ</label>
        <input id="audit-date-from" type="date" class="kernel-audit-filters__input" data-kernel-audit-filter="dateFrom" />
      </div>
      <div class="kernel-audit-filters__field">
        <label for="audit-date-to" class="kernel-audit-filters__label">إلى تاريخ</label>
        <input id="audit-date-to" type="date" class="kernel-audit-filters__input" data-kernel-audit-filter="dateTo" />
      </div>
      <div class="kernel-audit-filters__field">
        <label for="audit-risk" class="kernel-audit-filters__label">درجة المخاطر</label>
        <select id="audit-risk" class="kernel-audit-filters__select" data-kernel-audit-filter="risk">
          {RISK_LEVELS.map(l => <option value={l.value}>{l.label}</option>)}
        </select>
      </div>
      <div class="kernel-audit-filters__field">
        <label for="audit-status" class="kernel-audit-filters__label">الحالة</label>
        <select id="audit-status" class="kernel-audit-filters__select" data-kernel-audit-filter="status">
          {STATUSES.map(s => <option value={s.value}>{s.label}</option>)}
        </select>
      </div>
      <div class="kernel-audit-filters__field">
        <label for="audit-user" class="kernel-audit-filters__label">المستخدم</label>
        <select id="audit-user" class="kernel-audit-filters__select" data-kernel-audit-filter="user">
          {USERS.map(u => <option value={u.id}>{u.label}</option>)}
        </select>
      </div>
      <div class="kernel-audit-filters__field">
        <label for="audit-dept" class="kernel-audit-filters__label">القسم</label>
        <select id="audit-dept" class="kernel-audit-filters__select" data-kernel-audit-filter="dept">
          {DEPTS.map(d => <option value={d.id}>{d.label}</option>)}
        </select>
      </div>
    </section>

    <!-- Toolbar -->
    <div class="kernel-audit-toolbar">
      <span class="kernel-audit-toolbar__count" data-kernel-audit-count>
        {fmtCount(stats.total)} سجل إجمالي · تعرض {fmtCount(stats.total)}
      </span>
      <div class="kernel-audit-toolbar__actions">
        <div class="kernel-audit-toolbar__search">
          <input
            type="search"
            class="kernel-audit-toolbar__search-input"
            data-ka-search
            placeholder="بحث بالإجراء، Trace ID، المستخدم…"
            aria-label="بحث في سجل التدقيق"
          />
          <button type="button" class="kernel-audit-toolbar__btn" data-ka-clear aria-label="إعادة ضبط الفلاتر">
            <Fragment set:html={iconClose} />
            <span>مسح</span>
          </button>
        </div>
        <button type="button" class="kernel-audit-toolbar__btn" data-kernel-audit-export="csv" aria-label="تصدير CSV">
          <Fragment set:html={iconDownload} />
          <span>CSV</span>
        </button>
        <button type="button" class="kernel-audit-toolbar__btn" data-kernel-audit-export="json" aria-label="تصدير JSON">
          <Fragment set:html={iconDownload} />
          <span>JSON</span>
        </button>
        <button type="button" class="kernel-audit-toolbar__btn" data-kernel-audit-export="pdf" aria-label="تصدير PDF">
          <Fragment set:html={iconDownload} />
          <span>PDF</span>
        </button>
      </div>
    </div>

    <!-- Virtualized table -->
    <div class="kernel-audit-thead" aria-hidden="true">
      <span>الوقت</span>
      <span>المستخدم</span>
      <span>الإجراء</span>
      <span>المخاطر</span>
      <span>الحالة</span>
      <span>Hash</span>
      <span>عرض</span>
    </div>
    <div
      class="kernel-audit-viewport"
      data-ka-viewport
      role="table"
      aria-label="سجل التدقيق"
      aria-rowcount={stats.total}
      aria-describedby="ka-audit-hint"
      tabindex="0"
    >
      <div class="kernel-audit-vspacer" data-ka-spacer></div>
      <div class="kernel-audit-vband" data-ka-band role="rowgroup"></div>
    </div>
    <p class="kernel-audit-scrollpos" data-ka-scrollpos aria-live="polite">{fmtCount(stats.total)}</p>

    <!-- Empty state (engine toggles via data-ka-empty) -->
    <div
      class="kernel-audit-empty-state"
      data-ka-empty
      hidden
      role="status"
      aria-live="polite"
    >
      <p class="kernel-audit-empty-state__title">لا توجد سجلات مطابقة للفلاتر</p>
      <p class="kernel-audit-empty-state__hint">جرّب توسيع نطاق التاريخ أو إعادة ضبط درجة المخاطر / الحالة / المستخدم.</p>
      <button type="button" class="kernel-audit-empty-state__reset" data-ka-clear data-kernel-touch>
        إعادة ضبط الفلاتر
      </button>
    </div>

    <!-- Hash chain verifier -->
    <section class="kernel-audit-verifier" aria-labelledby="ka-verifier-title">
      <h2 class="kernel-audit-verifier__title" id="ka-verifier-title">التحقق من سلسلة الهاش (Hash Chain)</h2>
      <p class="kernel-audit-verifier__desc" id="ka-audit-hint">
        انسخ Trace ID من أي سجل أعلى (أو من جدول التدقيق) واضغط «تحقق». المحرك يعيد حساب FNV-1a محليًا ويقارن
        الهاش المخزّن مع السجل السابق والتالي. لو أي حقل في السجل عُدّل، يطلع الكسر فورًا.
      </p>
      <div class="kernel-audit-verifier__row">
        <input
          type="text"
          class="kernel-audit-verifier__input"
          data-ka-verify-trace
          placeholder="مثال: AI-2026-12503"
          aria-label="Trace ID للتحقق"
        />
        <button type="button" class="kernel-audit-verifier__btn" data-ka-verify-btn>
          <Fragment set:html={iconShield} />
          <span>تحقق</span>
        </button>
        <button type="button" class="kernel-audit-verifier__btn kernel-audit-verifier__btn--ghost" data-ka-tamper-btn>
          <span>محاكاة عبث (Demo)</span>
        </button>
      </div>
      <div class="ka-verify-out" data-ka-verify-out role="status" aria-live="polite"></div>
      <dl class="kernel-audit-verifier__chain">
        <dt>السجل السابق (prev hash)</dt>
        <dd data-ka-verify-prev>—</dd>
        <dt>السجل الحالي (current hash)</dt>
        <dd data-ka-verify-current>—</dd>
        <dt>السجل التالي (next hash)</dt>
        <dd data-ka-verify-next>—</dd>
      </dl>
    </section>
  </div>

  <!-- Detail drawer -->
  <div class="kernel-audit-drawer" data-kernel-audit-drawer data-open="false" role="dialog" aria-modal="true" aria-labelledby="audit-drawer-title" aria-hidden="true">
    <div class="kernel-audit-drawer__backdrop" data-kernel-audit-drawer-close></div>
    <div class="kernel-audit-drawer__panel" tabindex="-1">
      <button type="button" class="kernel-audit-drawer__close" aria-label="إغلاق" data-kernel-audit-drawer-close>
        <Fragment set:html={iconClose} />
      </button>
      <h2 class="kernel-audit-drawer__title" id="audit-drawer-title" data-kernel-drawer-title>تفاصيل السجل</h2>

      <section class="kernel-audit-drawer__section">
        <h3 class="kernel-audit-drawer__section-title">المعلومات الأساسية</h3>
        <dl class="kernel-audit-drawer__kv">
          <dt class="kernel-audit-drawer__key">Trace ID</dt>
          <dd class="kernel-audit-drawer__val kernel-audit-drawer__val--mono" data-kernel-drawer-trace>—</dd>
          <dt class="kernel-audit-drawer__key">Hash</dt>
          <dd class="kernel-audit-drawer__val kernel-audit-drawer__val--mono" data-kernel-drawer-hash>—</dd>
          <dt class="kernel-audit-drawer__key">الوقت</dt>
          <dd class="kernel-audit-drawer__val" data-kernel-drawer-ts>—</dd>
          <dt class="kernel-audit-drawer__key">المستخدم</dt>
          <dd class="kernel-audit-drawer__val" data-kernel-drawer-user>—</dd>
          <dt class="kernel-audit-drawer__key">القسم</dt>
          <dd class="kernel-audit-drawer__val" data-kernel-drawer-dept>—</dd>
          <dt class="kernel-audit-drawer__key">الحالة</dt>
          <dd class="kernel-audit-drawer__val" data-kernel-drawer-status>—</dd>
          <dt class="kernel-audit-drawer__key">موافقة بشرية</dt>
          <dd class="kernel-audit-drawer__val" data-kernel-drawer-approval>—</dd>
          <dt class="kernel-audit-drawer__key">شذوذ (Anomaly)</dt>
          <dd class="kernel-audit-drawer__val" data-kernel-drawer-anomaly>—</dd>
        </dl>
      </section>

      <section class="kernel-audit-drawer__section">
        <h3 class="kernel-audit-drawer__section-title">تفاصيل الإجراء</h3>
        <p style="color:var(--text-primary); line-height:1.6;" data-kernel-drawer-action>—</p>
      </section>

      <section class="kernel-audit-drawer__section">
        <h3 class="kernel-audit-drawer__section-title">Trace JSON</h3>
        <div class="kernel-audit-drawer__trace" data-kernel-drawer-json>—</div>
      </section>

      <section class="kernel-audit-drawer__section">
        <h3 class="kernel-audit-drawer__section-title">DevTools snippet</h3>
        <div class="kernel-audit-drawer__trace" data-kernel-drawer-snippet>—</div>
        <div style="margin-block-start: var(--space-2);">
          <button type="button" class="kernel-modal__btn" data-kernel-drawer-copy-snippet>
            <Fragment set:html={iconCopy} />
            <span>نسخ الـ snippet</span>
          </button>
        </div>
      </section>

      <section class="kernel-audit-drawer__section">
        <h3 class="kernel-audit-drawer__section-title">إجراءات</h3>
        <div style="display:flex; gap:var(--space-2); flex-wrap:wrap;">
          <button type="button" class="kernel-modal__btn" data-kernel-drawer-export-pdf>
            <Fragment set:html={iconDownload} />
            <span>تصدير PDF</span>
          </button>
          <button type="button" class="kernel-modal__btn" data-kernel-drawer-copy-hash>
            <Fragment set:html={iconCopy} />
            <span>نسخ الهاش</span>
          </button>
          <a href="/kernel/evidence/" class="kernel-modal__btn" data-kernel-drawer-link-evidence>افتح ملف الدليل</a>
        </div>
      </section>
    </div>
  </div>

  {/* ═══════════ KERNEL-AI-2026-07-14: AI Assistant + Lead Capture ═══════════ */}

  <section class="kernel-ai-section inner-section" aria-labelledby="ai-assistant-h2">
    <div class="max-w-4xl mx-auto px-5">
      <h2 id="ai-assistant-h2" class="inner-section__title">جرّب بالذكاء الاصطناعي</h2>
      <p class="inner-section__lead inner-section__lead--centered">اسأل المدقق عن كيفية تحضير تقرير تدقيق لـ PDPL أو NCA أو SAMA أو ISO 42001.</p>
      <KernelAiAssistant
        promptId="audit"
        title="مدقق سجلات AI"
        subtitle="متخصص في تدقيق سجلات الذكاء الاصطناعي للجهات الرقابية السعودية."
        placeholder="مثال: كيف أجهّز تقرير تدقيق ربع سنوي لـ NCA ECC عن 348 تفاعل AI في البنك؟"
        id="kai-audit"
      />
    </div>
  </section>

  <section class="kernel-lead-section inner-section inner-section--alt" aria-labelledby="lead-form-h2-audit">
    <div class="max-w-3xl mx-auto px-5">
      <h2 id="lead-form-h2-audit" class="inner-section__title inner-section__title--centered">تبي تدقيق خارجي لمنشأتك؟</h2>
      <p class="inner-section__lead inner-section__lead--centered">فريق التدقيق يوضح لك كيف يبسّط Kernel عملية المراجعة من أسابيع إلى ساعات.</p>
      <KernelLeadForm id="kernel-lead-form-audit" page="/kernel/audit/" />
    </div>
  </section>

  {/* SEO content + FAQ — server-rendered for crawlers (2026-07-14) */}
  <KernelSeoSection
    id="kernel-seo-audit"
    heading="دليل حوكمة AI — سياق إضافي عن وحدة التدقيق"
    blocks={unit.seoBlocks}
    faq={unit.faq}
  />

  {/* Cross-links: kernel ↔ kernel + solution + doc + blog */}
  <KernelContextLinks
    currentPath={unit.path}
    solutionPath={cross.solutionPath}
    docPath={cross.docPath ?? ''}
    blogPath={cross.blogPath}
    blogLabel="سجل تدقيق AI: من استخدمه وماذا حدث؟"
    relatedSlugs={unit.relatedSlugs}
  />
  <script type="module" src="/js/kernel-audit-data.js"></script>
  <script type="module" src="/js/kernel-audit.js"></script>
  <script type="module" src="/js/kernel-loading-state.js"></script>
</KernelLayout>
