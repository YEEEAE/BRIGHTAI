  },
  {
    id: 'moodle',
    name: 'Moodle LMS',
    category: 'Education',
    description: 'سجلات الطلاب في Moodle. يتطلب OAuth Setup.',
    icon: '🎓',
    status: 'pending',
    lastSync: 'لم تتم المزامنة',
    recordsToday: 0,
    totalRecords: 0,
    avgLatencyMs: 0,
    uptime: '—',
    authMethod: 'OAuth (مطلوب)',
    endpoint: 'lms.saudi-company.com',
    syncFreq: '—',
  },
  {
    id: 'sharepoint',
    name: 'Microsoft SharePoint',
    category: 'Documents',
    description: 'مستندات المؤسسة في SharePoint. فهرسة الوثائق الحساسة.',
    icon: '📁',
    status: 'connected',
    lastSync: 'قبل 15 دقيقة',
    recordsToday: 184,
    totalRecords: 24189,
    avgLatencyMs: 132,
    uptime: '99.6%',
    authMethod: 'Azure AD',
    endpoint: 'saudi-company.sharepoint.com',
    syncFreq: 'كل 30 دقيقة',
  },
  {
    id: 'salesforce',
    name: 'Salesforce',
    category: 'CRM',
    description: 'بيانات العملاء المحتملين في Salesforce.',
    icon: '☁️',
    status: 'error',
    lastSync: 'فشل قبل ساعتين',
    recordsToday: 0,
    totalRecords: 18420,
    avgLatencyMs: 0,
    uptime: '94.2%',
    authMethod: 'OAuth 2.0',
    endpoint: 'saudi-company.my.salesforce.com',
    syncFreq: 'كل 10 دقائق',
    errorMsg: 'انتهت صلاحية Access Token — يحتاج تجديد',
  },
  {
    id: 'okta',
    name: 'Okta SSO',
    category: 'Identity',
    description: 'تسجيل الدخول الموحد وأدوار المستخدمين.',
    icon: '🔐',
    status: 'connected',
    lastSync: 'قبل 30 ثانية',
    recordsToday: 92,
    totalRecords: 8420,
