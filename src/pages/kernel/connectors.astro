---
/**
 * /kernel/connectors/ — Enterprise connectors dashboard (REPORTS-16).
 *
 * Features:
 * - 4 KPI cards (total / active / requests today / avg latency)
 * - Connector cards: ERP, CRM, HIS, SharePoint, etc.
 * - Status indicators (connected/disconnected/error/syncing)
 * - Configure button + last sync time + records flowed
 * - Sync history log per connector
 * - Configure modal: endpoint, auth method, sync frequency
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelMetricCard from '../../components/kernel/KernelMetricCard.astro';
import KernelCard from '../../components/kernel/KernelCard.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelLeadForm from '../../components/kernel/KernelLeadForm.astro';
import { getKernelUnit } from '../../data/kernel';
import { getKernelSubPageJsonLd } from '../../data/schema-helpers';

const unit = getKernelUnit('connectors')!;

const jsonLd = getKernelSubPageJsonLd(unit);

// Connectors: 8 enterprise connectors (ERP, CRM, HIS, LMS, etc.)
const connectors = [
  {
    id: 'sap',
    name: 'SAP S/4HANA',
    category: 'ERP',
    description: 'وحدة المالية والمشتريات في SAP. قراءة فقط — بدون وصول كتابة.',
