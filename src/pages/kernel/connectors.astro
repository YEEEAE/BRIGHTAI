  },
  {
    id: 'dynamics365',
    name: 'Microsoft Dynamics 365',
    category: 'CRM',
    description: 'إدارة العملاء والفرص في Dynamics 365. قراءة فقط.',
    icon: '💼',
    status: 'connected',
    lastSync: 'قبل 12 دقيقة',
    recordsToday: 86,
    totalRecords: 12450,
    avgLatencyMs: 165,
    uptime: '99.9%',
    authMethod: 'Azure AD',
    endpoint: 'saudi-company.crm.dynamics.com',
    syncFreq: 'كل 10 دقائق',
  },
  {
    id: 'epic-his',
    name: 'Epic HIS',
    category: 'Healthcare',
    description: 'سجلات المرضى الإلكترونية في Epic. حساسة — تخضع لـ SFDA + HIPAA.',
    icon: '⚕️',
    status: 'connected',
    lastSync: 'قبل 5 دقائق',
    recordsToday: 312,
    totalRecords: 58234,
    avgLatencyMs: 220,
