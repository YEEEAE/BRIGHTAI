---
/**
 * /kernel/connectors/ — Enterprise connectors dashboard (M26).
 *
 * Features:
 *   - 4 KPI cards (total / active / requests today / avg latency)
 *   - 8 connector cards: SAP, Oracle, Dynamics, Epic, Moodle, SharePoint, Salesforce, Okta
 *   - read-only default + OAuth/SAML + health + sync + latency + failure state
 *   - token renewal (Salesforce) + OAuth setup (Moodle)
 *   - drawer: data flow diagram + live test (safe mock) + sync log + queue
 *   - custom connector guide (4 steps)
 *
 * vanilla JS فقط. حتمية كاملة (لا Math.random). prefers-reduced-motion محترم.
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelLeadForm from '../../components/kernel/KernelLeadForm.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import { getKernelUnit, getCrossLinks, getKernelFaqJsonLd } from '../../data/kernel';
import { getKernelSubPageJsonLd } from '../../data/schema-helpers';
import { buildConnectorsData } from '../../data/kernel-connectors';
import '../../../kernel/assets/css/pages/connectors.css';

const unit = getKernelUnit('connectors')!;
const cross = getCrossLinks(unit);

const jsonLd: Record<string, unknown>[] = [
  ...getKernelSubPageJsonLd(unit),
  ...(getKernelFaqJsonLd(unit) ? [getKernelFaqJsonLd(unit)] : []),
].filter(Boolean) as Record<string, unknown>[];

const connectorsData = buildConnectorsData();
---
<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: 'الموصلات', href: unit.path }]}
>
  <main class="connectors-page" id="connectors-page">
    <header class="kernel-page-header">
      <div class="kernel-page-header__lead">
        <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
          <ol>
            <li><a href="/">BrightAI</a></li>
            <li><a href="/kernel/">Kernel</a></li>
            <li aria-current="page">{unit.label}</li>
          </ol>
        </nav>
        <h1 class="kernel-page-header__title">{unit.h1}</h1>
        <p class="kernel-page-header__subtitle">{unit.shortDescription}</p>
      </div>
      <div class="kernel-page-header__actions">
        <KernelDemoPill />
      </div>
    </header>

    <div class="kernel-main kernel-page-fade-in">
      {/* KPIs */}
      <section class="kc-kpis" aria-label="مؤشرات الموصلات">
        <div class="kc-kpi">
          <div class="kc-kpi__label">إجمالي الموصلات</div>
          <div class="kc-kpi__value" id="kc-kpi-total">{connectorsData.kpis.total}</div>
          <div class="kc-kpi__footer">6 نشطة · 1 معلقة · 1 خطأ</div>
        </div>
        <div class="kc-kpi">
          <div class="kc-kpi__label">نشطة</div>
          <div class="kc-kpi__value" id="kc-kpi-active">{connectorsData.kpis.active}</div>
          <div class="kc-kpi__footer">قراءة فقط</div>
        </div>
        <div class="kc-kpi">
          <div class="kc-kpi__label">طلبات اليوم</div>
          <div class="kc-kpi__value" id="kc-kpi-requests">—</div>
          <div class="kc-kpi__footer">عبر جميع الموصلات</div>
        </div>
        <div class="kc-kpi">
          <div class="kc-kpi__label">متوسط زمن الاستجابة</div>
          <div class="kc-kpi__value" id="kc-kpi-latency">—</div>
          <div class="kc-kpi__footer">P95: 240ms</div>
        </div>
      </section>

      {/* Connector grid */}
      <section aria-label="الموصلات">
        <div class="kc-grid" id="kc-grid"></div>
      </section>

      {/* Custom connector guide */}
      <section id="kc-custom-guide-section" class="kernel-col-12" aria-labelledby="kc-guide-title">
        <h2 id="kc-guide-title" class="kernel-section-title">بناء موصل مخصص</h2>
        <p class="kernel-section-subtitle">4 خطوات لربط نظامك الخاص بـ Kernel.</p>
        <div class="kc-guide" id="kc-custom-guide"></div>
      </section>
    </div>

    {/* Drawer */}
    <div class="kc-drawer" id="kc-drawer" role="dialog" aria-modal="true" aria-labelledby="kc-drawer-title" hidden>
      <div class="kc-drawer__backdrop" data-drawer-backdrop></div>
      <div class="kc-drawer__panel">
        <header class="kc-drawer__header">
          <div>
            <h2 class="kc-drawer__title" id="kc-drawer-title" data-drawer-title>—</h2>
            <p class="kc-drawer__subtitle" data-drawer-subtitle>—</p>
          </div>
          <button type="button" class="kc-drawer__close" data-drawer-close aria-label="إغلاق">×</button>
        </header>
        <div class="kc-drawer__body">
          <section class="kc-drawer__section">
            <h3>مخطط تدفق البيانات</h3>
            <div id="kc-drawer-flow"></div>
          </section>
          <section class="kc-drawer__section">
            <h3>الاختبار الحي</h3>
            <div id="kc-drawer-test"></div>
          </section>
          <section class="kc-drawer__section">
            <h3>سجل المزامنة</h3>
            <div id="kc-drawer-sync"></div>
          </section>
          <section class="kc-drawer__section" id="kc-drawer-queue-section">
            <div id="kc-drawer-queue"></div>
          </section>
        </div>
      </div>
    </div>

    {/* Toast */}
    <div class="kc-toast" id="kc-toast" hidden></div>

    {/* Lead Capture */}
    <section class="kernel-lead-section inner-section inner-section--alt" aria-labelledby="lead-form-h2-connectors">
      <div class="max-w-3xl mx-auto px-5">
        <h2 id="lead-form-h2-connectors" class="inner-section__title inner-section__title--centered">تبي تربط Kernel بأنظمتك الحالية؟</h2>
        <p class="inner-section__lead inner-section__lead--centered">فريق الحوكمة يوضح لك الموصلات الجاهزة والموصلات المخصصة لأنظمتك.</p>
        <KernelLeadForm id="kernel-lead-form-connectors" page="/kernel/connectors/" />
      </div>
    </section>

    {/* SEO content + FAQ */}
    <KernelSeoSection
      id="kernel-seo-connectors"
      heading="دليل حوكمة AI — سياق إضافي عن وحدة الموصلات"
      blocks={unit.seoBlocks}
      faq={unit.faq}
    />

    {/* Cross-links */}
    <KernelContextLinks
      currentPath={unit.path}
      solutionPath={cross.solutionPath}
      docPath={cross.docPath ?? ''}
      blogPath={cross.blogPath}
      blogLabel={unit.blogLabel}
      relatedSlugs={unit.relatedSlugs}
    />

    {/* Data + Engine — type="module" required for public/js/ */}
    <script type="module" src="/js/kernel-connectors-data.js"></script>
    <script type="module" src="/js/kernel-connectors.js"></script>
    <script type="module" src="/js/kernel-loading-state.js"></script>
  </main>
</KernelLayout>