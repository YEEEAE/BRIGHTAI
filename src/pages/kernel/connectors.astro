const iconConnectors = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>';
const iconCheck = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
const iconClock = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
const iconAlert = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
const iconSettings = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/></svg>';
const iconClose = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
const iconRefresh = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>';
---

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath={unit.path}
  extraSpeakableSelectors={['.answer-first-summary']}
>
  <header class="kernel-page-header">
    <div class="kernel-page-header__lead">
      <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
        <ol>
          <li><a href="/">BrightAI</a></li>
          <li><a href="/kernel/">Kernel</a></li>
          <li aria-current="page">{unit.label}</li>
        </ol>
      </nav>
      <h1 class="kernel-page-header__title">{unit.h1}</h1>
      {/* BAI-VOC-001-B (2026-07-18): answer-first summary — wired as the
          second cssSelector for WebPage SpeakableSpecification. */}
      <p class="answer-first-summary" data-speakable-target="answer-first">موصلات جاهزة لأنظمة المؤسسة (ERP, CRM, HIS, LMS) ونماذج AI (OpenAI, Azure, Anthropic, Llama, نماذج On-Premise) — قراءة فقط افتراضياً مع مزامنة دورية ومراقبة حالة. يحمي بياناتك من vendor lock-in ويبقي الحوكمة موحدة.</p>
      <p class="kernel-page-header__subtitle">
        8 موصلات لأنظمة المؤسسة (ERP, CRM, HIS, LMS) — قراءة فقط مع مزامنة دورية ومراقبة حالة.
      </p>
    </div>
    <div class="kernel-page-header__actions">
      <KernelDemoPill />
    </div>
  </header>

  <div class="kernel-main kernel-page-fade-in">

    {/* KPI cards */}
    <section class="kernel-metric-grid kernel-stagger" aria-label="مؤشرات الموصلات">
      <KernelMetricCard label="إجمالي الموصلات" value="8" variant="brand" iconSvg={iconConnectors} footer="6 نشطة · 1 معلقة · 1 خطأ" />
      <KernelMetricCard label="قراءة فقط" value="8" iconSvg={iconCheck} footer="بدون وصول كتابة" />
      <KernelMetricCard label="طلبات اليوم" value="2,148" trend="up" trendLabel="12%" iconSvg={iconConnectors} footer="عبر جميع الموصلات" />
      <KernelMetricCard label="متوسط زمن الاستجابة" value="128" unit="ms" iconSvg={iconClock} footer="P95: 240ms" />
    </section>

    {/* Connectors grid */}
    <section class="kernel-col-12">
      <KernelCard title="الموصلات" subtitle="حالة الاتصال + آخر مزامنة + السجلات المتدفقة" iconSvg={iconConnectors}>
        <div class="kernel-card__body">
          <div class="kernel-connectors-grid">
            {connectors.map((c) => (
              <article class:list={['kernel-connector-card', `kernel-connector-card--${c.status}`]} data-connector-id={c.id}>
                <header class="kernel-connector-card__header">
                  <div class="kernel-connector-card__icon-block">
                    <span class="kernel-connector-card__icon" aria-hidden="true">{c.icon}</span>
                    <span class:list={['kernel-connector-card__status-dot', `kernel-connector-card__status-dot--${c.status}`]} aria-label={`الحالة: ${c.status}`}></span>
                  </div>
                  <div class="kernel-connector-card__title-block">
                    <h3 class="kernel-connector-card__name">{c.name}</h3>
                    <p class="kernel-connector-card__category">{c.category} · {c.authMethod}</p>
                  </div>
                </header>

                <p class="kernel-connector-card__description">{c.description}</p>

                <div class="kernel-connector-card__status-row">
                  <span class:list={['kernel-connector-card__status-pill', `kernel-connector-card__status-pill--${c.status}`]}>
                    {c.status === 'connected' && (<><Fragment set:html={iconCheck} /> متصل</>)}
                    {c.status === 'pending' && (<><Fragment set:html={iconClock} /> معلق</>)}
                    {c.status === 'error' && (<><Fragment set:html={iconAlert} /> خطأ</>)}
                    {c.status === 'syncing' && (<><Fragment set:html={iconRefresh} /> مزامنة…</>)}
                  </span>
                  <span class="kernel-connector-card__uptime">{c.uptime}</span>
                </div>

                {c.status === 'error' && c.errorMsg && (
                  <div class="kernel-connector-card__error">
                    <Fragment set:html={iconAlert} />
                    <span>{c.errorMsg}</span>
                  </div>
                )}

                <div class="kernel-connector-card__metrics">
                  <div class="kernel-connector-card__metric">
                    <span class="kernel-connector-card__metric-label">آخر مزامنة</span>
                    <span class="kernel-connector-card__metric-value">{c.lastSync}</span>
                  </div>
                  <div class="kernel-connector-card__metric">
                    <span class="kernel-connector-card__metric-label">اليوم</span>
                    <span class="kernel-connector-card__metric-value">{c.recordsToday.toLocaleString('ar-SA')}</span>
                  </div>
                  <div class="kernel-connector-card__metric">
                    <span class="kernel-connector-card__metric-label">زمن الاستجابة</span>
                    <span class="kernel-connector-card__metric-value">{c.avgLatencyMs ? `${c.avgLatencyMs} ms` : '—'}</span>
                  </div>
                </div>

                <footer class="kernel-connector-card__footer">
                  <button
                    type="button"
                    class="kernel-connector-card__btn kernel-connector-card__btn--secondary"
                    data-configure-connector={c.id}
                    aria-label={`إعدادات ${c.name}`}
                  >
                    <Fragment set:html={iconSettings} />
                    <span>إعدادات</span>
                  </button>
                  <button
                    type="button"
                    class="kernel-connector-card__btn kernel-connector-card__btn--primary"
                    data-sync-connector={c.id}
                    aria-label={`مزامنة الآن ${c.name}`}
                    disabled={c.status === 'pending'}
                  >
                    <Fragment set:html={iconRefresh} />
                    <span>مزامنة الآن</span>
                  </button>
                </footer>
              </article>
            ))}
          </div>
        </div>
      </KernelCard>
    </section>

  </div>

  {/* Configure Modal */}
  <div class="kernel-modal" id="connector-modal" role="dialog" aria-modal="true" aria-labelledby="connector-modal-title" hidden>
    <div class="kernel-modal__backdrop" data-close-connector-modal></div>
    <div class="kernel-modal__panel">
      <header class="kernel-modal__header">
        <div>
          <h2 class="kernel-modal__title" id="connector-modal-title">إعدادات الموصل</h2>
          <p class="kernel-modal__subtitle" id="connector-modal-subtitle"></p>
        </div>
        <button type="button" class="kernel-modal__close" data-close-connector-modal aria-label="إغلاق">
          <Fragment set:html={iconClose} />
        </button>
      </header>

      <div class="kernel-modal__body">
        <section class="kernel-modal__section">
          <h3 class="kernel-modal__section-title">معلومات الاتصال</h3>
          <div class="kernel-connector-config">
            <label class="kernel-policy-editor__field">
              <span>Endpoint URL</span>
              <input type="text" id="connector-endpoint" class="kernel-policy-editor__input" readonly />
            </label>
            <label class="kernel-policy-editor__field">
              <span>طريقة المصادقة</span>
              <input type="text" id="connector-auth" class="kernel-policy-editor__input" readonly />
            </label>
            <label class="kernel-policy-editor__field">
              <span>تكرار المزامنة</span>
              <select id="connector-freq" class="kernel-policy-editor__input">
                <option value="realtime">real-time</option>
                <option value="5min">كل 5 دقائق</option>
                <option value="15min">كل 15 دقيقة</option>
                <option value="30min">كل 30 دقيقة</option>
                <option value="hourly">كل ساعة</option>
                <option value="daily">يومي</option>
              </select>
            </label>
          </div>
        </section>

        <section class="kernel-modal__section">
          <h3 class="kernel-modal__section-title">سجل المزامنة الأخير</h3>
          <ol class="kernel-connector-sync-log" id="connector-sync-log"></ol>
        </section>

        <section class="kernel-modal__section">
          <h3 class="kernel-modal__section-title">إحصائيات</h3>
          <div class="kernel-connector-stats" id="connector-stats"></div>
        </section>
      </div>

      <footer class="kernel-modal__footer">
        <button type="button" class="kernel-policy-editor__btn kernel-policy-editor__btn--cancel" data-close-connector-modal>إغلاق</button>
        <button type="button" class="kernel-policy-editor__btn kernel-policy-editor__btn--save" id="save-connector-btn">
          <Fragment set:html={iconCheck} />
          <span>حفظ التغييرات</span>
        </button>
      </footer>
    </div>
  </div>

  <!-- BAI-SEC-18 (2026-07-25): define:vars converted to JSON data block
       + external ES module. The `connectors` array is serialised into a
       sibling <script type="application/json"> block; the external JS
       reads it via JSON.parse. This enables strict-CSP (no 'unsafe-inline'
       on script-src). -->
  <script type="application/json" id="kernel-connectors-data" set:html={JSON.stringify(connectors)}></script>
  <script type="module" src="/js/kernel-connectors.js"></script>

  {/* ═══════════ KERNEL-AI-2026-07-14: Lead Capture ═══════════ */}

  <section class="kernel-lead-section inner-section inner-section--alt" aria-labelledby="lead-form-h2-connectors">
    <div class="max-w-3xl mx-auto px-5">
      <h2 id="lead-form-h2-connectors" class="inner-section__title inner-section__title--centered">تبي تربط Kernel بأنظمتك الحالية؟</h2>
      <p class="inner-section__lead inner-section__lead--centered">فريق الحوكمة يوضح لك الموصلات الجاهزة والموصلات المخصصة لأنظمتك.</p>
      <KernelLeadForm id="kernel-lead-form-connectors" page="/kernel/connectors/" />
    </div>
  </section>

  {/* SEO content + FAQ — server-rendered for crawlers (2026-07-14) */}
  <KernelSeoSection
    id="kernel-seo-connectors"
    heading="دليل حوكمة AI — سياق إضافي عن وحدة الموصلات"
    blocks={unit.seoBlocks}
    faq={unit.faq}
  />

  {/* Cross-links: kernel ↔ kernel + solution + doc + blog */}
  <KernelContextLinks
    currentPath={unit.path}
    solutionPath={cross.solutionPath}
    docPath={cross.docPath ?? ''}
    blogPath={cross.blogPath}
    blogLabel={unit.blogLabel}
    relatedSlugs={unit.relatedSlugs}
  />
</KernelLayout>