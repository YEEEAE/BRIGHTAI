---
/**
 * /kernel/scenarios/ — Scenario Lab (M15, REPORTS-16).
 *
 * مختبر سيناريوهات تفاعلي بمحرك تقييم حقيقي (kernel-scenarios.js) يشتغل محلياً
 * في المتصفح، بدل التشغيل المحاكى السابق:
 *
 * - رأس KPIs (الإجمالي / ناجح / فاشل / الجاهزية) + زر «▶ شغّل الكل» مع شريط تقدم
 *   وتحويل الرأس لشريط تقدم أثناء التشغيل الدفعي (المواصفات §4).
 * - شبكة بطاقات 3 أعمدة بشريط علوي 4px بلون النتيجة، تشغيل فردي لكل بطاقة،
 *   زر «اقترح سياسة تسدّها ←» للفاشل، وتتبع Trace عبر درج الرحلة.
 * - مصفوفة حرارية سيناريو × نموذج (خلايا 32px) مع مبدّل «مقارنة بالتشغيل السابق»
 *   (أسهم ▲ تحسّن / ▼ تراجع).
 * - تقرير جاهزية مع بوابة قرار (passed / passed-with-findings /
 *   review-required / incomplete).
 *
 * البيانات: مصدر الحقيقة الوحيد في src/data/kernel-scenarios-lab.ts (12 سيناريو
 * بالحقول الـ 11 + ربط حالات SBG_CASES + سياسات حقيقية). تُحقن build-time كـ
 * JSON blob (#scenarios-config) — لا استيراد TS في المتصفح (نفس نمط eval.astro).
 *
 * المعمارية (M15): محرك مستقل kernel-scenarios.js — لا يُستدعى
 * kernel-eval-engine.js لأنه مرتبط بـ [data-eval-root] ويعود مبكراً خارج صفحة
 * eval. النتائج تُحفظ في KernelEvalStore الحقيقي (Trace/Certificate موحّد).
 *
 * المحتوى المنشور (عناوين/أوصاف/CTA/SEO/FAQ) لا يتغير إطلاقاً.
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelDemoPill from '../../components/kernel/KernelDemoPill.astro';
import KernelAiAssistant from '../../components/kernel/KernelAiAssistant.astro';
import KernelLeadForm from '../../components/kernel/KernelLeadForm.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import { getKernelUnit, getCrossLinks, getKernelFaqJsonLd } from '../../data/kernel';
import { getKernelSubPageJsonLd } from '../../data/schema-helpers';
import KernelSkeleton from '../../components/kernel/KernelSkeleton.astro';
import KernelEmptyState from '../../components/kernel/KernelEmptyState.astro';
import { SECTOR_LABELS, type Sector } from '../../data/kernel-journey';
import {
  SCENARIO_LAB,
  LAB_POLICIES,
  buildScenariosLabConfig,
  type ScenarioIcon,
} from '../../data/kernel-scenarios-lab';
import '../../../kernel/assets/css/pages/scenarios.css';

const unit = getKernelUnit('scenarios')!;
const cross = getCrossLinks(unit);

const jsonLd: any = [
  ...getKernelSubPageJsonLd(unit),
  getKernelFaqJsonLd(unit),
];

// M15: كل بيانات السيناريوهات من مصدر الحقيقة (kernel-scenarios-lab.ts).
const scenarios = SCENARIO_LAB;
const labConfig = buildScenariosLabConfig();

// القطاعات بترتيب أول ظهور (لأزرار التصفية).
const seenSectors: string[] = [];
SCENARIO_LAB.forEach((s) => { if (!seenSectors.includes(s.sector)) seenSectors.push(s.sector); });
const sectorTabs: { id: string; label: string }[] = [
  { id: 'all', label: 'الكل' },
  ...seenSectors.map((id) => ({ id, label: SECTOR_LABELS[id as Sector] ?? 'عام' })),
];

const policyLabel = (id: string) => LAB_POLICIES.find((p) => p.id === id)?.label ?? id;

// أيقونات السيناريو (SVG sprite أسلوب lucide — لا تبعيات).
const iconShield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>';
const iconLock = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>';
const iconDb = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>';
const iconCode = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>';
const iconMedical = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>';
const iconBank = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10h18"/><path d="M5 10v11"/><path d="M19 10v11"/><path d="M12 10v11"/><path d="M3 10l9-7 9 7"/><path d="M8 21h8"/></svg>';
const iconHr = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>';
const iconScale = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18"/><path d="M5 7h14"/><path d="M5 7l-3 6h6z"/><path d="M19 7l3 6h-6z"/><path d="M8 21h8"/></svg>';
const iconPlay = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>';
const iconClose = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
const iconCompare = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>';

const icons: Record<ScenarioIcon, string> = {
  shield: iconShield,
  lock: iconLock,
  db: iconDb,
  code: iconCode,
  medical: iconMedical,
  bank: iconBank,
  hr: iconHr,
  scale: iconScale,
};
---

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={jsonLd}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: 'السيناريوهات', href: unit.path }]}
>
  <header class="kernel-page-header">
    <div class="kernel-page-header__lead">
      <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
        <ol>
          <li><a href="/">BrightAI</a></li>
          <li><a href="/kernel/">Kernel</a></li>
          <li aria-current="page">{unit.label}</li>
        </ol>
      </nav>
      <h1 class="kernel-page-header__title">{unit.h1}</h1>
      <p class="kernel-page-header__subtitle">
        سيناريوهات اختبار جاهزة تختبر سلوك Kernel في ظروف حقيقية: كشف PII، حزم امتثال، حدود HITL، ومحاولات Prompt Injection.
      </p>
    </div>
    <div class="kernel-page-header__actions">
      <KernelDemoPill />
    </div>
  </header>

  <div class="kernel-main kernel-page-fade-in" data-kernel-loading data-kernel-count={scenarios.length}>
    <div data-kernel-skeleton class="kernel-loading-skeleton">
      <KernelSkeleton variant="card" count={4} />
      <KernelSkeleton variant="text" count={6} />
    </div>
    <div data-kernel-empty hidden>
      <KernelEmptyState title="ما في سيناريوهات الحين" message="السيناريوهات تظهر فور توفرها." />
    </div>

    {/* ═══════════ M15: Scenario Lab (data-sc-root) ═══════════ */}
    <section class="sc-lab" data-sc-root aria-label="مختبر السيناريوهات">
      {/* ── رأس KPIs + التشغيل الدفعي ── */}
      <div class="sc-kpis">
        <div class="sc-kpi">
          <span class="sc-kpi__label">إجمالي السيناريوهات</span>
          <strong class="sc-kpi__value" data-sc-kpi-total>{scenarios.length}</strong>
        </div>
        <div class="sc-kpi">
          <span class="sc-kpi__label">ناجح</span>
          <strong class="sc-kpi__value sc-kpi__value--ok" data-sc-kpi-passed>0</strong>
        </div>
        <div class="sc-kpi">
          <span class="sc-kpi__label">فاشل</span>
          <strong class="sc-kpi__value sc-kpi__value--err" data-sc-kpi-failed>0</strong>
        </div>
        <div class="sc-kpi">
          <span class="sc-kpi__label">الجاهزية</span>
          <strong class="sc-kpi__value" data-sc-kpi-progress>0%</strong>
        </div>
      </div>

      <div class="sc-actions">
        <div class="sc-actions__run">
          <button type="button" class="sc-btn sc-btn--primary" data-sc-run-all>
            <Fragment set:html={iconPlay} />
            <span>شغّل الكل</span>
          </button>
          <button type="button" class="sc-btn sc-btn--ghost" data-sc-pause hidden>إيقاف مؤقت</button>
          <button type="button" class="sc-btn sc-btn--ghost" data-sc-resume hidden>استئناف</button>
          <button type="button" class="sc-btn sc-btn--danger" data-sc-cancel hidden>إلغاء</button>
          <span class="sc-actions__phase" data-sc-phase>خامل</span>
        </div>
        <div class="sc-actions__progress">
          <div class="sc-progress" role="progressbar" aria-label="تقدم التشغيل الدفعي">
            <div class="sc-progress__bar" data-sc-progress-bar></div>
          </div>
          <span class="sc-progress__label" data-sc-progress-label>جاهز — اختر التشغيل</span>
        </div>
      </div>

      {/* ── التبويبات: شبكة / مصفوفة / تقرير ── */}
      <nav class="sc-tabs" role="tablist" aria-label="عرض مختبر السيناريوهات">
        <button type="button" role="tab" class="sc-tab active" data-sc-tab="grid" aria-selected="true">شبكة السيناريوهات</button>
        <button type="button" role="tab" class="sc-tab" data-sc-tab="matrix" aria-selected="false">مصفوفة النماذج</button>
        <button type="button" role="tab" class="sc-tab" data-sc-tab="report" aria-selected="false">تقرير الجاهزية</button>
      </nav>

      {/* ── فلاتر: قطاع + نتيجة + بحث ── */}
      <div class="sc-controls">
        <nav class="sc-filter" aria-label="تصفية حسب القطاع">
          {sectorTabs.map((cat, i) => (
            <button
              type="button"
              class:list={['sc-chip', 'sc-filter__tab', i === 0 && 'active']}
              data-sc-cat={cat.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {cat.label}
              {cat.id !== 'all' && (
                <span class="sc-filter__count">{scenarios.filter((s) => s.sector === cat.id).length}</span>
              )}
            </button>
          ))}
        </nav>
        <div class="sc-controls__row">
          <label class="sc-search">
            <span class="sc-search__hint sr-only">ابحث في السيناريوهات</span>
            <input
              type="search"
              class="sc-search__input"
              data-sc-search
              placeholder="ابحث بالعنوان أو الوصف…"
              autocomplete="off"
            />
          </label>
          <div class="sc-result-filter" role="group" aria-label="تصفية حسب النتيجة">
            <button type="button" class="sc-chip sc-chip--sm sc-result-filter__btn" data-sc-result-filter="all" aria-pressed="true">الكل</button>
            <button type="button" class="sc-chip sc-chip--sm sc-result-filter__btn" data-sc-result-filter="pass" aria-pressed="false">ناجح</button>
            <button type="button" class="sc-chip sc-chip--sm sc-result-filter__btn" data-sc-result-filter="fail" aria-pressed="false">فاشل</button>
            <button type="button" class="sc-chip sc-chip--sm sc-result-filter__btn" data-sc-result-filter="partial" aria-pressed="false">بانتظار</button>
          </div>
        </div>
      </div>

      {/* ── عرض الشبكة ── */}
      <div class="sc-view" data-sc-view="grid">
        <section class="kernel-scenarios-grid" id="scenarios-grid" aria-label="قائمة السيناريوهات">
          {scenarios.map((s) => (
            <article
              class="kernel-scenario-card sc-card"
              data-sc-card
              data-scenario-id={s.id}
              data-sector={s.sector}
              data-risk-band={s.riskBand}
              data-journey-stage="scenario"
            >
              <span class="sc-card__topbar" data-sc-topbar aria-hidden="true"></span>
              <header class="kernel-scenario-card__header">
                <div class="kernel-scenario-card__badges">
                  <span class:list={['kernel-badge', `kernel-badge--${s.riskBand}`]} lang="en">{s.riskBand}</span>
                  <span class="kernel-badge kernel-badge--pack" lang="en">{s.complianceTags.join(' · ')}</span>
                  <span class="kernel-badge kernel-badge--sector">{SECTOR_LABELS[s.sector] ?? 'عام'}</span>
                </div>
                <span class="kernel-scenario-card__category">{SECTOR_LABELS[s.sector] ?? 'عام'}</span>
              </header>
              <div class="sc-card__body">
                <span class="sc-card__icon" aria-hidden="true"><Fragment set:html={icons[s.icon]} /></span>
                <h3 class="kernel-scenario-card__title">{s.title}</h3>
              </div>
              <p class="kernel-scenario-card__description">{s.description}</p>
              <div class="sc-card__result">
                <span class="sc-badge sc-badge--muted" data-sc-verdict>لم يُشغَّل</span>
              </div>
              <div class="sc-card__meta">
                <span class="sc-card__meta-item">آخر تشغيل: <strong data-sc-last>لم يُشغَّل بعد</strong></span>
                <span class="sc-card__meta-item">الزمن: <strong data-sc-latency>—</strong></span>
                <span class="sc-card__meta-item">الكلفة: <strong data-sc-cost>—</strong></span>
              </div>
              <footer class="kernel-scenario-card__footer sc-card__footer">
                <button
                  type="button"
                  class="kernel-scenario-card__run"
                  data-sc-run
                  data-scenario-id={s.id}
                  aria-label={`شغّل ${s.title} الآن`}
                >
                  <Fragment set:html={iconPlay} />
                  <span>تشغيل الآن</span>
                </button>
                <button
                  type="button"
                  class="sc-btn sc-btn--ghost sc-btn--small"
                  data-sc-policy-suggest
                  hidden
                  aria-label={`اقترح سياسة تسد فجوة ${s.title}`}
                >
                  اقترح سياسة تسدّها ←
                </button>
                <a
                  href={`/kernel/chat/?scenario=${encodeURIComponent(s.id)}`}
                  class="kernel-scenario-card__open"
                  data-scenario-link
                  data-scenario-id={s.id}
                  data-sector={s.sector}
                  data-risk-band={s.riskBand}
                  data-journey-stage="run"
                  aria-label={`افتح ${s.title} في المحادثة الكاملة`}
                >
                  افتح في المحادثة ←
                </a>
              </footer>
              <span class="sc-card__trace" data-sc-trace data-trace-id="" lang="en">—</span>
            </article>
          ))}
        </section>
        <div class="kernel-scenarios-empty sc-empty" data-sc-empty hidden>
          <p>لا توجد سيناريوهات تطابق التصفية الحالية.</p>
        </div>
      </div>

      {/* ── عرض المصفوفة سيناريو × نموذج ── */}
      <div class="sc-view" data-sc-view="matrix" hidden>
        <div class="sc-matrix__toolbar">
          <label class="sc-switch">
            <input type="checkbox" data-sc-compare-toggle />
            <span>مقارنة بالتشغيل السابق</span>
          </label>
          <span class="sc-matrix__note" data-sc-matrix-prev-note>مصفوفة الجولة الحالية (0)</span>
        </div>
        <div class="sc-matrix__wrap">
          <table class="sc-matrix" data-sc-matrix-body></table>
        </div>
        <p class="sc-matrix__hint">
          كل خلية = نتيجة السيناريو (ناجح/فاشل/بانتظار) تحت نموذج تجريبي.
          فعّل «مقارنة بالتشغيل السابق» لإظهار أسهم التحسّن (▲) والتراجع (▼) عبر الجولات.
        </p>
      </div>

      {/* ── عرض تقرير الجاهزية ── */}
      <div class="sc-view" data-sc-view="report" hidden>
        <div class="sc-report__head">
          <div>
            <span class="sc-report__head-label">درجة الجاهزية</span>
            <strong class="sc-report__score" data-sc-report-score>0%</strong>
          </div>
          <div>
            <span class="sc-report__head-label">بوابة القرار</span>
            <span class="sc-report__gate sc-badge--muted" data-sc-report-gate>لم يُشغَّل</span>
          </div>
        </div>
        <div class="sc-report__body" data-sc-report-body></div>
      </div>
    </section>
  </div>

  {/* ═══════════ M15: Modal اقتراح السياسة ═══════════ */}
  <div
    class="kernel-modal sc-policy-modal"
    data-sc-policy-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="sc-policy-modal-title"
    hidden
  >
    <div class="kernel-modal__backdrop" data-sc-policy-backdrop></div>
    <div class="kernel-modal__panel">
      <header class="kernel-modal__header">
        <div>
          <h2 class="kernel-modal__title" id="sc-policy-modal-title">اقترح سياسة تسدّها</h2>
          <p class="kernel-modal__subtitle">مسودة فورية تُضاف إلى لوحة السياسات في /kernel/policies/ للاعتماد.</p>
        </div>
        <button type="button" class="kernel-modal__close" data-sc-policy-close aria-label="إغلاق">
          <Fragment set:html={iconClose} />
        </button>
      </header>
      <div class="kernel-modal__body">
        <h3 class="kernel-modal__section-title sc-policy__title" data-sc-policy-title>سياسة مقترحة</h3>
        <pre class="sc-policy__text" data-sc-policy-text></pre>
        <div class="sc-policy__pills" data-sc-policy-pills></div>
      </div>
    </div>
  </div>

  {/* M15: data blob + modules — نفس نمط datasets.astro */}
  <script type="application/json" id="scenarios-config" set:html={JSON.stringify(labConfig)} />

  {/* ═══════════ KERNEL-AI-2026-07-14: AI Assistant + Lead Capture ═══════════ */}

  <section class="kernel-ai-section inner-section" aria-labelledby="ai-assistant-h2">
    <div class="max-w-4xl mx-auto px-5">
      <h2 id="ai-assistant-h2" class="inner-section__title">جرّب بالذكاء الاصطناعي</h2>
      <p class="inner-section__lead inner-section__lead--centered">اطلب من المساعد تصميم سيناريو حوكمة مخصص لقطاعك وحجم منشأتك.</p>
      <KernelAiAssistant
        promptId="scenarios"
        title="مستشار تنفيذ حوكمة AI"
        subtitle="يصمم سيناريوهات تطبيق واقعية لمنشأتك في السوق السعودي."
        placeholder="مثال: صمم لي سيناريو تطبيقي لـ AI Firewall في مستشفى بسعة 200 سرير يستخدم 3 نماذج توليدية."
        id="kai-scenarios"
      />
    </div>
  </section>

  <section class="kernel-lead-section inner-section inner-section--alt" aria-labelledby="lead-form-h2-scenarios">
    <div class="max-w-3xl mx-auto px-5">
      <h2 id="lead-form-h2-scenarios" class="inner-section__title inner-section__title--centered">تبي سيناريو مخصص لمنشأتك؟</h2>
      <p class="inner-section__lead inner-section__lead--centered">فريق الحوكمة يرد خلال 24 ساعة بسيناريو مفصّل يناسب حجم منشأتك وطبيعة أدواتك.</p>
      <KernelLeadForm id="kernel-lead-form-scenarios" page="/kernel/scenarios/" />
    </div>
  </section>

  {/* SEO content + FAQ — server-rendered for crawlers (2026-07-14) */}
  <KernelSeoSection
    id="kernel-seo-scenarios"
    heading="دليل حوكمة AI — سياق إضافي عن وحدة السيناريوهات"
    blocks={unit.seoBlocks}
    faq={unit.faq}
  />

  {/* Cross-links: kernel ↔ kernel + solution + doc + blog */}
  <KernelContextLinks
    currentPath={unit.path}
    solutionPath={cross.solutionPath}
    docPath={cross.docPath ?? ''}
    blogPath={cross.blogPath}
    blogLabel={unit.blogLabel}
    relatedSlugs={unit.relatedSlugs}
  />
  <script type="module" src="/js/kernel-loading-state.js"></script>
  <script type="module" src="/js/kernel-scenarios.js"></script>
</KernelLayout>

<style>
  /* Loading state: hide content while skeleton is visible */
  [data-kernel-loading] > *:not([data-kernel-skeleton]):not([data-kernel-empty]) {
    display: none;
  }
  .kernel-loading-skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
</style>

<style>
  /* K1 (2026-07-18): scenario card enrichment —
     sector badge + open-in-chat CTA + visible risk band.
