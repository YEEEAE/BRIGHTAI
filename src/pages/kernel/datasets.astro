---
/**
 * /kernel/datasets/ — Dataset Manager (M7).
 *
 * أداة إدارة مجموعات بيانات التقييم داخل Kernel: سجل، إصدارات وهاش،
 * استيراد (CSV/JSON/JSONL/لصق جدول)، فلاتر، كشف تكرار ونقص، تقسيم
 * train/validation/test، ومجموعات فرعية. أداة، لا صفحة تسويقية.
 *
 * القواعد:
 *   - لا تعدّل Dataset منشوراً — أي تعديل ينشئ version جديد.
 *   - لا تحذف Dataset مستخدَماً في Run (usedInRuns > 0).
 *   - كل version له hash حتمي.
 *   - Test dataset وfixtures منفصلة عن Live (environment صريح لكل Dataset).
 *
 * المحرّك في /js/kernel-datasets.js (vanilla، CSP-safe، لا inline).
 * البيانات من src/data/kernel-datasets.ts تُحقن كـ JSON blob (#ds-config).
 * التنسيق من kernel/assets/css/pages/datasets.css (side-effect import).
 * الإحصاءات تُعرض SSR من SBG_STATS (قابلة للزحف)؛ الجداول التفاعلية JS.
 * النصوص بالعامية السعودية. يحترم prefers-reduced-motion. الجزر dir="ltr".
 */
import KernelLayout from '../../layouts/KernelLayout.astro';
import KernelSeoSection from '../../components/kernel/KernelSeoSection.astro';
import KernelContextLinks from '../../components/kernel/KernelContextLinks.astro';
import KernelSkeleton from '../../components/kernel/KernelSkeleton.astro';
import { getKernelUnit, getCrossLinks, getKernelFaqJsonLd } from '../../data/kernel';
import { getKernelSubPageJsonLd } from '../../data/schema-helpers';
import {
  KERNEL_DATASETS_DEMO,
  KERNEL_DATASETS_TEST,
  KERNEL_DATASETS_LIVE,
  DATASET_IMPORT_FIXTURES,
  SBG_STATS,
  DATASET_SECTORS,
  DATASET_VERDICT_LABELS,
  DATASET_VERDICT_COLORS,
  DATASET_RISK_LABELS,
  DATASET_STATUS_LABELS,
  DATASET_LANG_LABELS,
  DATASET_ENV_LABELS,
  type DatasetVerdict,
  type DatasetSectorId,
} from '../../data/kernel-datasets';

// تنسيق الصفحة (side-effect import).
import '../../../kernel/assets/css/pages/datasets.css';

const unit = getKernelUnit('datasets')!;
const cross = getCrossLinks(unit);
const jsonLd = [...getKernelSubPageJsonLd(unit), getKernelFaqJsonLd(unit)] as Array<Record<string, unknown> | null | undefined>;
const pageJsonLd = jsonLd as unknown as Record<string, unknown>;

const s = SBG_STATS;
const sectorIds = Object.keys(DATASET_SECTORS) as DatasetSectorId[];
const verdictIds = Object.keys(DATASET_VERDICT_LABELS) as DatasetVerdict[];

const pct = (n: number) => (s.totalCases ? Math.round((n / s.totalCases) * 1000) / 10 : 0);
const allowedPct = pct(s.verdicts.allowed);
const blockedPct = pct(s.verdicts.blocked);
// عرض الأشرطة بدون inline style — أصناف خطوات ثابتة (القاعدة: لا style في .astro).
const barClass = (n: number) =>
  'ds-fill-' + Math.min(100, Math.max(0, Math.round((n / s.totalCases) * 100 / 5) * 5));

// إعدادات تُحقن للـ JS (لا استيراد TS في المتصفح).
const dsConfig = {
  datasets: KERNEL_DATASETS_DEMO,
  testDatasets: KERNEL_DATASETS_TEST,
  liveDatasets: KERNEL_DATASETS_LIVE,
  fixtures: DATASET_IMPORT_FIXTURES,
  labels: {
    verdicts: DATASET_VERDICT_LABELS,
    verdictColors: DATASET_VERDICT_COLORS,
    risks: DATASET_RISK_LABELS,
    statuses: DATASET_STATUS_LABELS,
    langs: DATASET_LANG_LABELS,
    envs: DATASET_ENV_LABELS,
    sectors: Object.fromEntries(sectorIds.map((k) => [k, DATASET_SECTORS[k]])),
  },
};
---

<KernelLayout
  title={unit.title}
  description={unit.description}
  canonical={unit.canonical}
  hreflang={unit.hreflang}
  jsonLd={pageJsonLd}
  currentPath={unit.path}
  breadcrumbs={[{ name: 'Kernel', href: '/kernel/' }, { name: unit.label, href: unit.path }]}
>
  {/* ── إعدادات للـ JS ── */}
  <script type="application/json" id="ds-config" set:html={JSON.stringify(dsConfig)} />

  <div class="kernel-main kernel-page-fade-in" data-ds-root data-kernel-loading data-kernel-count="1">
    {/* skeleton */}
    <div data-kernel-skeleton>
      <KernelSkeleton variant="heading" />
      <KernelSkeleton variant="card" count={3} />
    </div>

    {/* المحتوى الفعلي */}
    <div data-ds-content>
      <header class="ds-header">
        <div>
          <nav class="kernel-breadcrumb" aria-label="مسار التنقل">
            <ol>
              <li><a href="/">BrightAI</a></li>
              <li><a href="/kernel/">Kernel</a></li>
              <li aria-current="page">{unit.label}</li>
            </ol>
          </nav>
          <h1 class="ds-header__title">{unit.h1}</h1>
          <p class="ds-header__sub">{unit.shortDescription}</p>
        </div>
        <div class="ds-header__badges">
          <span class="ds-env-badge ds-env-badge--demo">بيانات توضيحية · Demo</span>
          <span class="ds-env-badge ds-env-badge--test">Test Suite منفصل</span>
          <span class="ds-env-badge ds-env-badge--live">Live: فارغ</span>
        </div>
      </header>

      {/* ═════════ إحصاءات Saudi Governance Benchmark v1.0 (SSR) ═════════ */}
      <section class="ds-stats" aria-label="إحصاءات Saudi Governance Benchmark v1.0">
        <div class="ds-stats__head">
          <h2 class="ds-section-title">Saudi Governance Benchmark v1.0</h2>
          <span class="ds-stats__hash" dir="ltr" title="هاش الإصدار المنشور v1">hash: <code>{s ? '0x…' : ''}</code><strong data-ds-current-hash dir="ltr"></strong></span>
        </div>

        <div class="ds-kpi-grid">
          <div class="ds-kpi">
            <span class="ds-kpi__label">إجمالي الحالات</span>
            <strong class="ds-kpi__value" dir="ltr">{s.totalCases}</strong>
            <span class="ds-kpi__foot">8 قطاعات · 4 أحكام</span>
          </div>
          <div class="ds-kpi">
            <span class="ds-kpi__label">السماح / الحظر</span>
            <strong class="ds-kpi__value" dir="ltr">{allowedPct}% / {blockedPct}%</strong>
            <span class="ds-kpi__foot">سماح {s.verdicts.allowed} · حظر {s.verdicts.blocked}</span>
          </div>
          <div class="ds-kpi ds-kpi--warn">
            <span class="ds-kpi__label">تحذيرات التكرار</span>
            <strong class="ds-kpi__value" dir="ltr">{s.duplicatePairs.length}</strong>
            <span class="ds-kpi__foot">تكرار محتمل بالمدخل</span>
          </div>
          <div class="ds-kpi ds-kpi--warn">
            <span class="ds-kpi__label">نقص السلوك المتوقع</span>
            <strong class="ds-kpi__value" dir="ltr">{s.missingBehavior.length}</strong>
            <span class="ds-kpi__foot">حالة بلا expected</span>
          </div>
        </div>

        <div class="ds-dist-grid">
          {/* توزيع الأحكام */}
          <div class="ds-dist">
            <h3 class="ds-dist__title">توزيع الأحكام</h3>
            <div class="ds-dist__bars">
              {verdictIds.map((v) => {
                const n = s.verdicts[v];
                const p = pct(n);
                return (
                  <div class="ds-bar" data-verdict={v}>
                    <span class="ds-bar__label">{DATASET_VERDICT_LABELS[v]}</span>
                    <span class="ds-bar__track"><span class:list={['ds-bar__fill', `ds-bar__fill--${DATASET_VERDICT_COLORS[v]}`, barClass(n)]}></span></span>
                    <span class="ds-bar__num" dir="ltr">{n} · {p}%</span>
                  </div>
                );
              })}
            </div>
          </div>
          {/* توزيع المخاطر */}
          <div class="ds-dist">
            <h3 class="ds-dist__title">توزيع المخاطر</h3>
            <div class="ds-dist__bars">
              {(['low', 'medium', 'high', 'critical'] as const).map((r) => {
                const n = s.risks[r];
                const p = pct(n);
                return (
                  <div class="ds-bar">
                    <span class="ds-bar__label">{DATASET_RISK_LABELS[r]}</span>
                    <span class="ds-bar__track"><span class:list={['ds-bar__fill', `ds-bar__fill--risk-${r}`, barClass(n)]}></span></span>
                    <span class="ds-bar__num" dir="ltr">{n} · {p}%</span>
                  </div>
                );
              })}
            </div>
          </div>
          {/* توزيع القطاعات */}
          <div class="ds-dist ds-dist--wide">
            <h3 class="ds-dist__title">توزيع القطاعات</h3>
            <div class="ds-sector-grid">
              {sectorIds.map((sec) => {
                const n = s.sectors[sec];
                const p = pct(n);
                return (
                  <div class="ds-sector" data-sector={sec}>
                    <span class="ds-sector__name">{DATASET_SECTORS[sec].short}</span>
                    <span class="ds-sector__bar"><span class:list={['ds-sector__fill', barClass(n)]}></span></span>
                    <span class="ds-sector__num" dir="ltr">{n}</span>
                  </div>
                );
              })}
            </div>
          </div>
          {/* اللغة */}
          <div class="ds-dist">
            <h3 class="ds-dist__title">توزيع اللغة</h3>
            <div class="ds-dist__bars">
              {(['ar', 'en', 'mixed'] as const).map((l) => {
                const n = s.languages[l];
                const p = pct(n);
                return (
                  <div class="ds-bar">
                    <span class="ds-bar__label">{DATASET_LANG_LABELS[l]}</span>
                    <span class="ds-bar__track"><span class:list={['ds-bar__fill', 'ds-bar__fill--lang', barClass(n)]}></span></span>
                    <span class="ds-bar__num" dir="ltr">{n} · {p}%</span>
                  </div>
                );
              })}
            </div>
          </div>
          {/* تغطية الامتثال */}
          <div class="ds-dist">
            <h3 class="ds-dist__title">تغطية الامتثال</h3>
            <div class="ds-dist__bars">
              {Object.entries(s.compliance).map(([f, n]) => {
                const p = pct(n);
                return (
                  <div class="ds-bar">
                    <span class="ds-bar__label" dir="ltr">{f}</span>
                    <span class="ds-bar__track"><span class:list={['ds-bar__fill', 'ds-bar__fill--comp', barClass(n)]}></span></span>
                    <span class="ds-bar__num" dir="ltr">{n} حالة</span>
                  </div>
                );
              })}
            </div>
          </div>
        </div>

        {/* تحذيرات */}
        <div class="ds-warnings">
          {s.duplicatePairs.map((dp) => (
            <div class="ds-warning ds-warning--dup" role="status">
              <span class="ds-warning__icon" aria-hidden="true">⧉</span>
              <span>تكرار محتمل: <code dir="ltr">{dp.a}</code> ↔ <code dir="ltr">{dp.b}</code> — نفس المدخل «{dp.input}…»</span>
            </div>
          ))}
          {s.missingBehavior.map((id) => (
            <div class="ds-warning ds-warning--miss" role="status">
              <span class="ds-warning__icon" aria-hidden="true">△</span>
              <span>حقل السلوك المتوقع ناقص: <code dir="ltr">{id}</code></span>
            </div>
          ))}
        </div>
      </section>

      {/* ═════════ سجل الـ Datasets ═════════ */}
      <section class="ds-registry" aria-label="سجل مجموعات البيانات">
        <div class="ds-registry__head">
          <div>
            <h2 class="ds-section-title">سجل الـ Datasets</h2>
            <p class="ds-registry__hint">لا تعديل على منشور · لا حذف لـ Dataset مستخدم في Run · كل تعديل ينشئ version</p>
          </div>
          <div class="ds-registry__actions">
            <button class="ds-btn ds-btn--ghost" type="button" data-ds-action="import" aria-haspopup="dialog">⬆ استيراد</button>
            <button class="ds-btn ds-btn--primary" type="button" data-ds-action="create" aria-haspopup="dialog">+ Dataset جديد</button>
          </div>
        </div>

        <div class="ds-registry__toolbar">
          <label class="ds-search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input id="ds-search" type="search" placeholder="ابحث في الـ Datasets…" aria-label="بحث في الـ Datasets" autocomplete="off" />
          </label>
          <label class="ds-select-wrap">
            <span class="ds-select-label">الحالة</span>
            <select id="ds-status-filter" aria-label="فلترة بالحالة">
              <option value="all">الكل</option>
              <option value="published">منشور</option>
              <option value="draft">مسودة</option>
              <option value="archived">مؤرشف</option>
            </select>
          </label>
          <span class="ds-env-legend" aria-hidden="true">
            <span class="ds-dot ds-dot--demo"></span>Demo
            <span class="ds-dot ds-dot--test"></span>Test
            <span class="ds-dot ds-dot--live"></span>Live
          </span>
        </div>

        <div class="ds-table-wrap" role="region" aria-label="جدول مجموعات البيانات" tabindex="0" data-dt-scroll>
          <table class="ds-table" data-dt>
            <thead>
              <tr>
                <th scope="col" data-dt-p="1">الاسم</th>
                <th scope="col" data-dt-p="2">البيئة</th>
                <th scope="col" data-dt-p="2">الحالة</th>
                <th scope="col" data-dt-p="2">الإصدار / الهاش</th>
                <th scope="col" data-dt-p="3">الحالات</th>
                <th scope="col" data-dt-p="3">المصدر</th>
                <th scope="col" data-dt-p="2">مستخدم في Runs</th>
                <th scope="col" data-dt-p="3">آخر تحديث</th>
                <th scope="col" data-dt-p="1">إجراءات</th>
              </tr>
            </thead>
            <tbody id="ds-registry-body">
              {KERNEL_DATASETS_DEMO.map((d) => {
                const cur = d.versions.find((v) => v.version === d.currentVersion) ?? d.versions[d.versions.length - 1];
                return (
                  <tr data-ds-row={d.id} data-ds-status={d.status} data-ds-env={d.environment} data-ds-search={`${d.name} ${d.owner} ${d.id}`}>
                    <td data-dt-p="1">
                      <button class="ds-row-name" type="button" data-ds-action="open" data-ds-id={d.id}>{d.name}</button>
                    </td>
                    <td data-dt-p="2" data-dt-label="البيئة"><span class:list={['ds-env-chip', `ds-env-chip--${d.environment}`]}>{DATASET_ENV_LABELS[d.environment]}</span></td>
                    <td data-dt-p="2" data-dt-label="الحالة"><span class:list={['ds-status', `ds-status--${d.status}`]}>{DATASET_STATUS_LABELS[d.status]}</span></td>
                    <td data-dt-p="2" data-dt-label="الإصدار/الهاش">
                      <span class="ds-version" dir="ltr">v{cur.version}</span>
                      <code class="ds-hash" dir="ltr" title={`hash v${cur.version}: ${cur.hash}`}>{cur.hash.slice(0, 10)}…</code>
                    </td>
                    <td data-dt-p="3" data-dt-label="الحالات" dir="ltr">{d.cases.length}</td>
                    <td data-dt-p="3" data-dt-label="المصدر" dir="ltr">{d.source}</td>
                    <td data-dt-p="2" data-dt-label="مستخدم في Runs">
                      <span class:list={['ds-runs', d.usedInRuns > 0 ? 'ds-runs--used' : '']} dir="ltr">{d.usedInRuns}</span>
                    </td>
                    <td data-dt-p="3" data-dt-label="آخر تحديث" dir="ltr">{d.updatedAt.slice(0, 10)}</td>
                    <td data-dt-p="1">
                      <div class="ds-row-actions">
                        <button class="ds-icon-btn" type="button" data-ds-action="open" data-ds-id={d.id} aria-label={`فتح ${d.name}`} title="فتح">👁</button>
                        <button class="ds-icon-btn" type="button" data-ds-action="new-version" data-ds-id={d.id} aria-label={`نسخة جديدة من ${d.name}`} title="نسخة جديدة">⧉</button>
                        <button class="ds-icon-btn" type="button" data-ds-action="publish" data-ds-id={d.id} aria-label={`نشر ${d.name}`} title="نشر الإصدار">⬆</button>
                        <button class="ds-icon-btn" type="button" data-ds-action="archive" data-ds-id={d.id} aria-label={`أرشفة ${d.name}`} title="أرشفة">🗄</button>
                        <button class="ds-icon-btn ds-icon-btn--danger" type="button" data-ds-action="delete" data-ds-id={d.id} aria-label={`حذف ${d.name}`} title="حذف">✕</button>
                      </div>
                    </td>
                  </tr>
                );
              })}
              {KERNEL_DATASETS_TEST.map((d) => (
                <tr data-ds-row={d.id} data-ds-status={d.status} data-ds-env={d.environment} data-ds-search={`${d.name} ${d.owner} ${d.id}`}>
                  <td data-dt-p="1">
                    <button class="ds-row-name" type="button" data-ds-action="open" data-ds-id={d.id}>{d.name}</button>
                  </td>
                  <td data-dt-p="2" data-dt-label="البيئة"><span class="ds-env-chip ds-env-chip--test">Test</span></td>
                  <td data-dt-p="2" data-dt-label="الحالة"><span class="ds-status ds-status--draft">مسودة</span></td>
                  <td data-dt-p="2" data-dt-label="الإصدار/الهاش"><span class="ds-version" dir="ltr">v1</span><code class="ds-hash" dir="ltr">{d.versions[0].hash.slice(0, 10)}…</code></td>
                  <td data-dt-p="3" data-dt-label="الحالات" dir="ltr">{d.cases.length}</td>
                  <td data-dt-p="3" data-dt-label="المصدر" dir="ltr">fixture</td>
                  <td data-dt-p="2" data-dt-label="مستخدم في Runs"><span class="ds-runs" dir="ltr">0</span></td>
                  <td data-dt-p="3" data-dt-label="آخر تحديث" dir="ltr">{d.updatedAt.slice(0, 10)}</td>
                  <td data-dt-p="1">
                    <div class="ds-row-actions">
                      <button class="ds-icon-btn" type="button" data-ds-action="open" data-ds-id={d.id} aria-label={`فتح ${d.name}`} title="فتح">👁</button>
                      <button class="ds-icon-btn" type="button" data-ds-action="new-version" data-ds-id={d.id} aria-label={`نسخة جديدة من ${d.name}`} title="نسخة جديدة">⧉</button>
                      <button class="ds-icon-btn" type="button" data-ds-action="publish" data-ds-id={d.id} aria-label={`نشر ${d.name}`} title="نشر الإصدار">⬆</button>
                      <button class="ds-icon-btn" type="button" data-ds-action="delete" data-ds-id={d.id} aria-label={`حذف ${d.name}`} title="حذف">✕</button>
                    </div>
                  </td>
                </tr>
              ))}
              {KERNEL_DATASETS_LIVE.length === 0 && (
                <tr class="ds-empty-live">
                  <td colspan="9">لا توجد بيانات Live متصلة — فصل صارم بين Demo / Test / Live.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </section>

      {/* ═════════ تفاصيل الـ Dataset (JS) ═════════ */}
      <section class="ds-detail" id="ds-detail" aria-label="تفاصيل مجموعة البيانات" hidden>
        <div id="ds-detail-body"></div>
      </section>

      {/* ═════════ جدول الحالات (JS) ═════════ */}
      <section class="ds-cases" id="ds-cases" aria-label="حالات مجموعة البيانات" hidden>
        <div id="ds-cases-body"></div>
      </section>

      {/* SEO نصّي قابل للزحف */}
      <KernelSeoSection blocks={unit.seoBlocks} faq={unit.faq} faqHeading="أسئلة شائعة عن Dataset Manager" />

      <KernelContextLinks
        currentPath={unit.path}
        solutionPath={cross.solutionPath}
        docPath={cross.docPath ?? ''}
        blogPath={unit.blogPath}
        blogLabel={unit.blogLabel}
        relatedSlugs={unit.relatedSlugs}
      />
    </div>
  </div>

  {/* ═══════ نافذة إنشاء Dataset ═══════ */}
  <div class="ds-modal" id="ds-create-modal" role="dialog" aria-modal="true" aria-labelledby="ds-create-title" hidden>
    <div class="ds-modal__backdrop" data-ds-modal-close></div>
    <div class="ds-modal__panel">
      <header class="ds-modal__head">
        <h3 id="ds-create-title" class="ds-modal__title">إنشاء Dataset جديد</h3>
        <button class="ds-modal__close" type="button" data-ds-modal-close aria-label="إغلاق">✕</button>
      </header>
      <form class="ds-form" id="ds-create-form">
        <label class="ds-field">
          <span>الاسم</span>
          <input id="ds-create-name" type="text" required maxlength="80" placeholder="مثال: حالات البنك التجريبي" />
        </label>
        <label class="ds-field">
          <span>الوصف</span>
          <textarea id="ds-create-desc" rows="3" maxlength="300" placeholder="وصف مختصر للـ Dataset والغرض منه"></textarea>
        </label>
        <div class="ds-form__row">
          <label class="ds-field">
            <span>المصدر</span>
            <select id="ds-create-source">
              <option value="manual">يدوي</option>
              <option value="csv">CSV</option>
              <option value="json">JSON</option>
              <option value="jsonl">JSONL</option>
              <option value="paste">لصق جدول</option>
            </select>
          </label>
          <label class="ds-field">
            <span>المالك</span>
            <input id="ds-create-owner" type="text" maxlength="40" placeholder="فريق الحوكمة" />
          </label>
        </div>
        <p class="ds-form__note">يُنشأ كـ <strong>مسودة</strong> بإصدار v1 وهاش حتمي — لا يُنشر إلا بضغطة زر.</p>
        <footer class="ds-modal__foot">
          <button class="ds-btn ds-btn--ghost" type="button" data-ds-modal-close>إلغاء</button>
          <button class="ds-btn ds-btn--primary" type="submit">إنشاء المسودة</button>
        </footer>
      </form>
    </div>
  </div>

  {/* ═══════ نافذة الاستيراد ═══════ */}
  <div class="ds-modal ds-modal--wide" id="ds-import-modal" role="dialog" aria-modal="true" aria-labelledby="ds-import-title" hidden>
    <div class="ds-modal__backdrop" data-ds-modal-close></div>
    <div class="ds-modal__panel">
      <header class="ds-modal__head">
        <h3 id="ds-import-title" class="ds-modal__title">استيراد Dataset</h3>
        <button class="ds-modal__close" type="button" data-ds-modal-close aria-label="إغلاق">✕</button>
      </header>
      <div class="ds-tabs" role="tablist" aria-label="صيغ الاستيراد">
        <button class="ds-tab" type="button" role="tab" data-import-tab="csv" aria-selected="true">CSV</button>
        <button class="ds-tab" type="button" role="tab" data-import-tab="json" aria-selected="false">JSON</button>
        <button class="ds-tab" type="button" role="tab" data-import-tab="jsonl" aria-selected="false">JSONL</button>
        <button class="ds-tab" type="button" role="tab" data-import-tab="paste" aria-selected="false">لصق جدول</button>
      </div>
      <div class="ds-import-body">
        <label class="ds-field">
          <span>الاسم</span>
          <input id="ds-import-name" type="text" maxlength="80" placeholder="اسم الـ Dataset الجديد (اختياري)" />
        </label>
        <label class="ds-field">
          <span>المحتوى</span>
          <textarea id="ds-import-text" rows="10" spellcheck="false" dir="ltr" placeholder="الصق CSV / JSON / JSONL / جدول هنا…"></textarea>
        </label>
        <div class="ds-import-actions">
          <button class="ds-btn ds-btn--ghost" type="button" data-import-fixture>املأ مثالاً</button>
          <button class="ds-btn ds-btn--ghost" type="button" data-import-preview>معاينة</button>
          <span class="ds-import-note">الأعمدة: title · input · expected · verdict · risk · sector · lang · pii</span>
        </div>
        <div class="ds-import-preview" id="ds-import-preview" hidden>
          <h4 class="ds-import-preview__title">معاينة</h4>
          <div id="ds-import-preview-body"></div>
        </div>
      </div>
      <footer class="ds-modal__foot">
        <button class="ds-btn ds-btn--ghost" type="button" data-ds-modal-close>إلغاء</button>
        <button class="ds-btn ds-btn--primary" type="button" data-import-apply>استيراد كمسودة</button>
      </footer>
    </div>
  </div>

  {/* ═══════ نافذة التقسيم والمجموعات الفرعية ═══════ */}
  <div class="ds-modal" id="ds-split-modal" role="dialog" aria-modal="true" aria-labelledby="ds-split-title" hidden>
    <div class="ds-modal__backdrop" data-ds-modal-close></div>
    <div class="ds-modal__panel">
      <header class="ds-modal__head">
        <h3 id="ds-split-title" class="ds-modal__title">تقسيم Dataset</h3>
        <button class="ds-modal__close" type="button" data-ds-modal-close aria-label="إغلاق">✕</button>
      </header>
      <div class="ds-split__current" id="ds-split-current"></div>
      <form class="ds-form" id="ds-split-form">
        <div class="ds-form__row">
          <label class="ds-field">
            <span>Train %</span>
            <input id="ds-split-train" type="number" min="0" max="100" step="5" value="70" dir="ltr" />
          </label>
          <label class="ds-field">
            <span>Validation %</span>
            <input id="ds-split-val" type="number" min="0" max="100" step="5" value="15" dir="ltr" />
          </label>
          <label class="ds-field">
            <span>Test %</span>
            <input id="ds-split-test" type="number" min="0" max="100" step="5" value="15" dir="ltr" />
          </label>
        </div>
        <p class="ds-form__note" id="ds-split-sum" role="status"></p>

        <fieldset class="ds-subset">
          <legend>مجموعة فرعية (اختياري)</legend>
          <div class="ds-subset__row">
            <label class="ds-field">
              <span>القطاع</span>
              <select id="ds-subset-sector">
                <option value="">الكل</option>
                {sectorIds.map((sec) => <option value={sec}>{DATASET_SECTORS[sec].label}</option>)}
              </select>
            </label>
            <label class="ds-field">
              <span>الحكم</span>
              <select id="ds-subset-verdict">
                <option value="">الكل</option>
                {verdictIds.map((v) => <option value={v}>{DATASET_VERDICT_LABELS[v]}</option>)}
              </select>
            </label>
            <label class="ds-field">
              <span>عيّنة عشوائية (بذرة)</span>
              <input id="ds-subset-seed" type="text" value="" dir="ltr" placeholder="بذرة (اختياري)" />
            </label>
          </div>
          <p class="ds-form__note" id="ds-subset-sum" role="status">اختر الفلاتر لعرض حجم المجموعة الفرعية.</p>
        </fieldset>
      </form>
      <footer class="ds-modal__foot">
        <button class="ds-btn ds-btn--ghost" type="button" data-ds-modal-close>إلغاء</button>
        <button class="ds-btn ds-btn--primary" type="button" data-split-apply>حفظ التقسيم</button>
        <button class="ds-btn ds-btn--primary" type="button" data-subset-apply>إنشاء مجموعة فرعية</button>
      </footer>
    </div>
  </div>

  {/* ═══════ درج مقارنة الإصدارات ═══════ */}
  <div class="ds-compare" id="ds-compare" role="dialog" aria-modal="true" aria-labelledby="ds-compare-title" aria-hidden="true">
    <div class="ds-compare__backdrop" data-ds-compare-close></div>
    <div class="ds-compare__panel" role="document">
      <header class="ds-compare__head">
        <h3 id="ds-compare-title" class="ds-compare__title">مقارنة الإصدارات</h3>
        <button class="ds-modal__close" type="button" data-ds-compare-close aria-label="إغلاق">✕</button>
      </header>
      <div class="ds-compare__controls" id="ds-compare-controls"></div>
      <div class="ds-compare__summary" id="ds-compare-summary"></div>
      <div class="ds-compare__list" id="ds-compare-list"></div>
    </div>
  </div>

  {/* ═══════ توست ═══════ */}
  <div class="ds-toast" id="ds-toast" role="status" aria-live="polite" aria-atomic="true" hidden>
    <span class="ds-toast__msg" id="ds-toast-msg">تم.</span>
    <button class="ds-toast__close" type="button" data-ds-toast-close aria-label="إغلاق">×</button>
  </div>

  <script type="module" src="/js/kernel-loading-state.js"></script>
  <script type="module" src="/js/kernel-datasets.js"></script>

  <style>
    /* مساعدة: حاويات التفاعل تبدأ مخفية حتى يحمّل JS. */
    .ds-detail[hidden] { display: none; }
    .ds-cases[hidden] { display: none; }
    .ds-modal[hidden] { display: none; }
    .ds-compare[aria-hidden="true"] { display: none; }
    .ds-toast[hidden] { display: none; }
  </style>
</KernelLayout>
