<style>
  /*
   * Mobile-first + RTL baseline for Compliance (kernel championship).
   * Injected by kernel-mobile-baseline.mjs. Logical properties (RTL-safe), ≥44px touch
   * targets, responsive breakpoints, and empty/loading state styles.
   * Uses design tokens. No published text or layout overrides.
   */
  .kernel-compliance__empty-state,
  .kernel-compliance-empty-state {
    padding-inline: var(--space-6);
    margin-inline: auto;
    text-align: start;
    color: var(--text-muted);
    border-inline-start: 3px solid var(--interactive-primary);
  }
  .kernel-compliance__skeleton,
  .kernel-compliance-skeleton {
    inset-inline-start: 0;
    background: var(--bg-elevated);
    animation: kernel-compliance-shimmer 1.4s var(--ease-in-out) infinite;
  }
  @keyframes kernel-compliance-shimmer {
    0% { opacity: 1; }
    50% { opacity: 0.45; }
    100% { opacity: 1; }
  }
  /* Touch targets ≥44px — accessibility on small screens */
  .kernel-compliance [data-kernel-touch],
  .kernel-compliance__touch {
    min-height: 44px;
    min-width: 44px;
  }
  /* Mobile-first: single column on mobile, enhance at ≥768px */
  .kernel-compliance__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .kernel-compliance__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }
  @media (max-width: 640px) {
    .kernel-compliance [data-kernel-touch] { min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kernel-compliance-skeleton { animation: none; }
  }

  /* Loading state: hide content while skeleton is visible */
  [data-kernel-loading] > *:not([data-kernel-skeleton]):not([data-kernel-empty]) {
    display: none;
  }
  .kernel-loading-skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
</style>

