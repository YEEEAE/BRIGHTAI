      <h2 id="compliance-heatmap-title" class="k-section-title">خريطة الامتثال</h2>
      <p class="k-section-intro">انتشار الحزم عبر المناطق السعودية · 6 مدن رئيسية</p>
      <div class="kernel-compliance-map" aria-label="خريطة المملكة العربية السعودية مع توزيع حزم الامتثال">
            <svg viewBox="0 0 600 600" class="kernel-compliance-map__svg" role="img">
              <defs>
                <linearGradient id="map-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="var(--bg-elevated)" />
                  <stop offset="100%" stop-color="var(--bg-surface)" />
                </linearGradient>
                <radialGradient id="city-glow">
                  <stop offset="0%" stop-color="var(--brand-400)" stop-opacity="0.8" />
                  <stop offset="100%" stop-color="var(--brand-400)" stop-opacity="0" />
                </radialGradient>
              </defs>

              <path
                d="M 80 200 L 120 150 L 200 100 L 300 80 L 400 90 L 500 110 L 560 180 L 580 280 L 560 380 L 500 460 L 420 510 L 320 540 L 220 530 L 140 480 L 90 400 L 70 300 Z"
                fill="url(#map-grad)"
                stroke="var(--border-default)"
                stroke-width="2"
                class="kernel-compliance-map__shape"
              />

              {CITIES.map((city) => (
                <g class="kernel-compliance-map__city">
                  <circle cx={city.x} cy={city.y} r="22" fill="url(#city-glow)" class="kernel-compliance-map__pulse" />
                  <circle cx={city.x} cy={city.y} r="8" fill={city.score >= 85 ? 'var(--status-success)' : 'var(--status-warning)'} stroke="var(--bg-base)" stroke-width="2" />
                  <text x={city.x} y={city.y - 18} text-anchor="middle" class="kernel-compliance-map__label">{city.name}</text>
                  <text x={city.x} y={city.y + 26} text-anchor="middle" class="kernel-compliance-map__score">{city.score}%</text>
                </g>
              ))}
            </svg>

            {/* M21: accessible sorted city list (visual alternative, WCAG) */}
            <div class="kernel-compliance-map__legend" aria-label="قائمة المدن بالترتيب التنازلي">
              <h3 class="kernel-compliance-map__legend-title">تفاصيل المدن — مرتبة تنازلياً</h3>
              <ul>
                {SORTED_CITIES.map((c) => (
                  <li>
                    <span class="kernel-compliance-map__legend-name">{c.name}</span>
                    <span class="kernel-compliance-map__legend-pack">{c.pack}</span>
                    <span class:list={['kernel-compliance-map__legend-score', c.score >= 85 ? 'high' : 'mid']}>{c.score}%</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
    </section>

    {/* KPI cards */}
    <section class="kernel-metric-grid kernel-stagger" aria-label="مؤشرات الامتثال">
      <KernelMetricCard label="متوسط الجاهزية التجريبية" value={overallScore} unit="%" variant="brand" trend="up" trendLabel="2%" iconSvg={iconShield} footer={`${packs.length} حزم · آخر تقييم اليوم`} />
      <KernelMetricCard label="جاهز للعرض التجريبي" value={demoReadyCount} unit="حزم" trend="flat" iconSvg={iconCheck} footer="PDPL · NCA · SDAIA · SAMA · ISO 27001 · ISO 42001" />
      <KernelMetricCard label="يحتاج تحسين" value={needsImprovementCount} unit="حزم" trend="down" trendLabel="1" iconSvg={iconAlert} footer="SFDA · ISO 13485" />
      <KernelMetricCard label="فجوات ذات أولوية" value={PRIORITY_GAPS.length} iconSvg={iconGap} footer="أثر عالٍ / جهد منخفض أولاً" />
    </section>

    {/* Packs grid.
        CSS-FATIGUE (2026-08-09): outer KernelCard removed. Each compliance
        pack is already an actionable card (expand + evidence link), so the
        wrapping box created a box-inside-box. Now the packs sit directly
        under a section heading. */}
    <section class="kernel-col-12" aria-labelledby="compliance-packs-title">
      <h2 id="compliance-packs-title" class="k-section-title">حزم الجاهزية التجريبية</h2>
      <p class="k-section-intro">{packs.length} حزم · متوسط {overallScore}% · <strong>هذه تقديرات عرض تجريبي وليست شهادة امتثال</strong></p>
      <div class="kernel-compliance-grid">
            {packs.map((pack) => (
              <article class="kernel-compliance-pack" data-pack-id={pack.id}>
                <header class="kernel-compliance-pack__header">
                  <div class="kernel-compliance-pack__title-block">
                    <h3 class="kernel-compliance-pack__name">{pack.name}</h3>
                    <p class="kernel-compliance-pack__fullname">{pack.fullName}</p>
                    <p class="kernel-compliance-pack__authority">{pack.authority}</p>
                    {/* M21: monthly trend + source timestamp */}
                    <div class="kernel-compliance-pack__meta-row">
                      <span class="kernel-compliance-pack__trend" data-trend={pack.trendDir} aria-label={`اتجاه شهري ${pack.trend}`}>
                        <Fragment set:html={iconTrendUp} />
                        {pack.trend} هذا الشهر
                      </span>
                      <span class="kernel-compliance-pack__source-timestamp" aria-label={`مصدر البيانات: ${pack.sourceTimestamp}`}>
                        <Fragment set:html={iconTimestamp} />
                        تقييم: {new Date(pack.sourceTimestamp).toLocaleDateString('ar-SA', { year: 'numeric', month: 'short', day: 'numeric' })}
                      </span>
                    </div>
                  </div>
                  <div class="kernel-compliance-pack__ring" role="img" aria-label={`درجة الجاهزية التجريبية ${pack.score}%`}>
                    <svg viewBox="0 0 100 100" class="kernel-compliance-pack__ring-svg">
                      <circle cx="50" cy="50" r="42" class="kernel-compliance-pack__ring-bg" />
                      <circle
                        cx="50" cy="50" r="42"
                        class:list={['kernel-compliance-pack__ring-fg', `kernel-compliance-pack__ring-fg--${pack.status}`]}
                        stroke-dasharray={`${(pack.score / 100) * 264} 264`}
                        stroke-dashoffset="0"
                        transform="rotate(-90 50 50)"
                      />
                    </svg>
                    <span class="kernel-compliance-pack__score">{pack.score}<small>%</small></span>
                  </div>
                </header>

                <div class="kernel-compliance-pack__status">
                  <span class:list={['kernel-badge', `kernel-badge--${pack.status === 'demoReady' ? 'success' : 'warning'}`]}>
                    {pack.status === 'demoReady' ? 'جاهز للعرض التجريبي' : 'يحتاج تحسين'}
                  </span>
                  <span class="kernel-compliance-pack__audit">آخر تدقيق: {pack.lastAudit}</span>
                </div>

                <p class="kernel-compliance-pack__desc">{pack.description}</p>

                {/* M21: gap score */}
                <div class="kernel-compliance-pack__gap" data-gap={pack.score < 80 ? 'open' : 'closed'}>
                  <span>فجوة الجاهزية</span>
                  <span class="kernel-compliance-pack__gap-value">{100 - pack.score}<small> / 100</small></span>
                </div>

                <button
                  type="button"
                  class="kernel-compliance-pack__expand"
                  data-expand-pack={pack.id}
                  aria-expanded="false"
                  aria-controls={`pack-controls-${pack.id}`}
                >
                  <span>عرض الضوابط ({pack.controls.length})</span>
                  <Fragment set:html={iconExpand} />
                </button>

                <div class="kernel-compliance-pack__controls" id={`pack-controls-${pack.id}`} hidden>
                  <ul class="kernel-compliance-pack__control-list">
                    {pack.controls.map((ctrl) => (
                      <li class="kernel-compliance-pack__control">
                        <div class="kernel-compliance-pack__control-main">
                          <span class="kernel-compliance-pack__control-label">
                            {ctrl.label}
                            {/* M21: regulation control mapping */}
                            <code class="kernel-compliance-pack__control-ref" dir="ltr">{ctrl.ref}</code>
                          </span>
                          {/* M21: evidence link per control */}
                          <a
                            class="kernel-compliance-pack__control-evidence"
                            href={`/kernel/evidence/?pack=${pack.id}`}
                            data-kernel-touch
                          >
                            <Fragment set:html={iconLink} />
                            أدلة الجاهزية
                          </a>
                        </div>
<span class="kernel-compliance-pack__control-bar" role="progressbar" aria-valuenow={ctrl.score} aria-valuemin="0" aria-valuemax="100" aria-label={`${ctrl.label} جاهزية ${ctrl.score}%`}>
                            <span
                              class:list={['kernel-compliance-pack__control-fill', ctrl.score >= 90 ? 'high' : ctrl.score >= 70 ? 'mid' : 'low']}
                              style={`inline-size: ${ctrl.score}%`}
                            ></span>
                          </span>
                          <span class="kernel-compliance-pack__control-value">{ctrl.score}%</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            ))}
          </div>
    </section>

    {/* M21: Gap analysis — impact/effort matrix + priority list */}
    <section class="kernel-col-12" aria-labelledby="gap-analysis-title">
      <KernelCard title="تحليل فجوات الجاهزية التجريبية" subtitle="أثر × جهد · الأولوية لأثر عالٍ / جهد منخفض · بيانات عرض تجريبي" iconSvg={iconGap}>
        <div class="kernel-card__body">
          <h3 id="gap-analysis-title" class="kernel-compliance-gap__heading">مصفوفة الأثر × الجهد — فجوات الجاهزية</h3>
          <div class="kernel-compliance-matrix" role="img" aria-label="مصفوفة الأثر مقابل الجهد، الفجوات موزعة على أربعة أرباع">
            <div class="kernel-compliance-matrix__axis-y">أثر عالٍ ▲</div>
            <div class="kernel-compliance-matrix__axis-x">جهد →</div>
            <div class="kernel-compliance-matrix__quad kernel-compliance-matrix__quad--start" data-quad="start">
              <span class="kernel-compliance-matrix__quad-label">ابدأ هنا</span>
              <ul>
                {PRIORITY_GAPS.filter((g) => g.impact === 3 && g.effort === 1).map((g) => (
                  <li>
                    <span class="kernel-compliance-matrix__qid">{g.framework}</span>
                    <span class="kernel-compliance-matrix__qscore">−{g.gap} نقطة</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="kernel-compliance-matrix__quad" data-quad="hi-med">
              <ul>
                {PRIORITY_GAPS.filter((g) => g.impact === 3 && g.effort === 2).map((g) => (
                  <li>
                    <span class="kernel-compliance-matrix__qid">{g.framework}</span>
                    <span class="kernel-compliance-matrix__qscore">−{g.gap}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="kernel-compliance-matrix__quad" data-quad="med-low">
              <ul>
                {PRIORITY_GAPS.filter((g) => g.impact === 2 && g.effort === 1).map((g) => (
                  <li>
                    <span class="kernel-compliance-matrix__qid">{g.framework}</span>
                    <span class="kernel-compliance-matrix__qscore">−{g.gap}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="kernel-compliance-matrix__quad" data-quad="low">
              <ul>
                {PRIORITY_GAPS.filter((g) => g.impact <= 2 && g.effort === 2).map((g) => (
                  <li>
                    <span class="kernel-compliance-matrix__qid">{g.framework}</span>
                    <span class="kernel-compliance-matrix__qscore">−{g.gap}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <h3 class="kernel-compliance-gap__heading">قائمة أولوية فجوات الجاهزية — أثر عالٍ / جهد منخفض أولاً</h3>
          <ul class="kernel-compliance-gap__list">
            {PRIORITY_GAPS.map((g, i) => (
              <li class="kernel-compliance-gap__row" data-priority={i + 1}>
                <span class="kernel-compliance-gap__rank">{i + 1}</span>
                <div class="kernel-compliance-gap__body">
                  <strong>{g.framework}</strong>
                  <span class="kernel-compliance-gap__note">{g.note}</span>
                  <span class="kernel-compliance-gap__effects">
                    أثر <b>{'●'.repeat(g.impact)}</b> · جهد <b>{'●'.repeat(g.effort)}</b>
                  </span>
                </div>
                <div class="kernel-compliance-gap__aside">
                  <span class="kernel-compliance-gap__estimate">
                    <Fragment set:html={iconClock} />
                    {g.estimate}
                  </span>
                  <button
                    type="button"
                    class="kernel-compliance-gap__task"
                    data-add-task={`${g.framework}: سد فجوة الجاهزية التجريبية (${g.gap} نقطة) — أثر عالٍ، جهد منخفض، تقدير ${g.estimate}`}
                    data-kernel-touch
                  >
                    <Fragment set:html={iconAdd} />
                    أضفها كمهمة
                  </button>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </KernelCard>
    </section>

  </div>

  <script is:inline>
    (function () {
      'use strict';

      // ─── Expand/Collapse pack controls ───
      const expandButtons = document.querySelectorAll('[data-expand-pack]');
      expandButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const packId = btn.dataset.expandPack;
          const controlsEl = document.getElementById(`pack-controls-${packId}`);
          if (!controlsEl) return;
          const isOpen = !controlsEl.hidden;
          controlsEl.hidden = isOpen;
          btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
          btn.classList.toggle('expanded', !isOpen);
          const labelEl = btn.querySelector('span');
          if (labelEl) {
            const count = controlsEl.querySelectorAll('li').length;
            labelEl.textContent = isOpen ? `عرض الضوابط (${count})` : 'إخفاء الضوابط';
          }
        });
      });

      // ─── Export PDF stub ───
      const exportBtn = document.getElementById('export-compliance-pdf');
      if (exportBtn) {
        exportBtn.addEventListener('click', () => {
          exportBtn.disabled = true;
          setTimeout(() => {
            window.print();
            exportBtn.disabled = false;
          }, 400);
        });
      }

      // ─── M21: "Add as task" — localStorage (no PII, task title only) + toast ───
      const TASK_KEY = 'kernel-compliance-tasks-v1';
      function readTasks() {
        try { return JSON.parse(localStorage.getItem(TASK_KEY) || '[]'); }
        catch (e) { return []; }
      }
      function showToast(msg) {
        const existing = document.querySelector('.kernel-toast');
        if (existing) existing.remove();
        const toast = document.createElement('div');
        toast.className = 'kernel-toast';
        toast.setAttribute('role', 'status');
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(() => toast.classList.add('kernel-toast--show'), 20);
        setTimeout(() => { toast.classList.remove('kernel-toast--show'); setTimeout(() => toast.remove(), 300); }, 2600);
      }
      document.querySelectorAll('[data-add-task]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const title = btn.dataset.addTask;
          const tasks = readTasks();
          if (tasks.includes(title)) {
            showToast('المهمة مضافة مسبقاً');
            return;
          }
          tasks.push(title);
          localStorage.setItem(TASK_KEY, JSON.stringify(tasks));
          showToast('أُضيفت لقائمة مهام الامتثال ✓');
        });
      });
    })();
  </script>

  {/* ═══════════ KERNEL-AI-2026-07-14: AI Assistant + Lead Capture ═══════════ */}

  <section class="kernel-ai-section inner-section" aria-labelledby="ai-assistant-h2">
    <div class="max-w-4xl mx-auto px-5">
      <h2 id="ai-assistant-h2" class="inner-section__title">جرّب بالذكاء الاصطناعي</h2>
      <p class="inner-section__lead inner-section__lead--centered">اسأل خبير حوكمة AI عن PDPL أو NCA ECC أو SFDA أو SAMA أو ISO 42001. كل سؤال يمر عبر طبقات الأمان قبل الوصول للنموذج.</p>
      <KernelAiAssistant
        promptId="compliance"
        title="مساعد حوكمة AI"
        subtitle="متخصص في اللوائح السعودية لحوكمة الذكاء الاصطناعي."
        placeholder="مثال: وش الخطوات الفعلية عشان ألتزم PDPL في تسريب بيانات المرضى في نموذج توليدي؟"
        id="kai-compliance"
      />
    </div>
  </section>

  <section class="kernel-lead-section inner-section inner-section--alt" aria-labelledby="lead-form-h2-compliance">
    <div class="max-w-3xl mx-auto px-5">
      <h2 id="lead-form-h2-compliance" class="inner-section__title inner-section__title--centered">تطبّق حوكمة AI في منشأتك؟</h2>
      <p class="inner-section__lead inner-section__lead--centered">فريق الحوكمة يرد خلال 24 ساعة بعرض مخصص لحجم منشأتك وطبيعة البيانات.</p>
      <KernelLeadForm id="kernel-lead-form-compliance" page="/kernel/compliance/" />
    </div>
  </section>

  {/* SEO content + FAQ — server-rendered for crawlers (2026-07-14) */}
  <KernelSeoSection
    id="kernel-seo-compliance"
    heading="دليل حوكمة AI — سياق إضافي عن وحدة الامتثال"
    blocks={unit.seoBlocks}
    faq={unit.faq}
  />

  {/* Cross-links: kernel ↔ kernel + solution + doc + blog */}
  <KernelContextLinks
    currentPath={unit.path}
    solutionPath={cross.solutionPath}
    docPath={cross.docPath ?? ''}
    blogPath={cross.blogPath}
    blogLabel={unit.blogLabel}
    relatedSlugs={unit.relatedSlugs}
  />
  <script type="module" src="/js/kernel-loading-state.js"></script>
</KernelLayout>