    },
  ],
  'sdaia-generative-ai-guidelines': [
    {
      q: 'ما إرشادات سدايا للذكاء الاصطناعي التوليدي؟',
      a: 'إرشادات سدايا للذكاء الاصطناعي التوليدي هي مبادئ وطنية أصدرتها الهيئة السعودية للبيانات والذكاء الاصطناعي (SDAIA) لتنظيم استخدام GenAI في المنشآت السعودية. تتضمن نسختين (عامة وحكومية) وسبعة مبادئ أخلاقية: العدالة، الخصوصية والأمن، الإنسانية، المنافع الاجتماعية والبيئية، الموثوقية والسلامة، الشفافية والقابلية للتفسير، والمساءلة.',
    },
    {
      q: 'كيف تلتزم المنشآت السعودية بمبادئ سدايا السبعة للذكاء الاصطناعي؟',
      a: 'تلتزم المنشآت عبر تصنيف الاستخدامات إلى أربع مستويات (ممنوع، مقيد، مسموح بمراجعة، مسموح)، وتطبيق ضوابط تقنية: بوابة AI معتمدة، فحص بيانات PII، سجل تدقيق، موافقات بشرية للقرارات المؤثرة، إفصاح مناسب عن دور AI. يُربط كل استخدام بمالك قرار واضح ومسار اعتماد رسمي، مع تدريب إلزامي لجميع الموظفين.',
    },
    {
      q: 'ما العلاقة بين سدايا وPDPL في حوكمة البيانات؟',
      a: 'سدايا هي الجهة المُصدرة لإرشادات الذكاء الاصطناعي التوليدي (GenAI) ومبادئ أخلاقيات AI، وPDPL هو نظام حماية البيانات الشخصية السعودي. يكملان بعضهما: PDPL يحمي البيانات الشخصية (الأساس النظامي، حقوق أصحاب البيانات)، سدايا تنظم استخدام AI على هذه البيانات (الشفافية، الإفصاح، المراجعة البشرية). المنشأة السعودية تلتزم بالاثنين معاً.',
    },
  ],
};

const extraSchemaNodes: Array<Record<string, unknown>> = FAQ_BY_DOC[doc.id]
  ? [
      {
        ...getFaqLd(FAQ_BY_DOC[doc.id]),
        '@id': `${doc.data.canonical}#faq`,
      },
    ]
  : [];
---

<DocsLayout
  title={doc.data.title}
  metaTitle={doc.data.metaTitle ?? doc.data.title}
  description={doc.data.description}
  canonical={doc.data.canonical}
  updated={doc.data.updated ?? new Date()}
  category={doc.data.category ?? ''}
  tldr={doc.data.tldr}
  headings={headings}
  relatedDocs={relatedDocs}
  prevDoc={prevDoc}
  nextDoc={nextDoc}
  currentPath={`/docs/${doc.id}/`}
  extraSchemaNodes={extraSchemaNodes}
  tldr={doc.data.tldr ?? ''}
>
  <Content />
</DocsLayout>
