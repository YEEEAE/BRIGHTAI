// BAI-SEO-003-S3 (2026-07-18): WebPage and BreadcrumbList are emitted
// by the foundation Schema.astro (WebPage@id={canonical}#webpage,
// BreadcrumbList with no @id). The page now keeps only the ItemList
// node to avoid duplicate @id warnings.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      itemListElement: docs.map((doc, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: doc.data.title,
        url: doc.data.canonical,
      })),
    },
  ],
};

// Pick a representative icon per slug for the cards.
function cardIconFor(slug: string): string {
  for (const [key, value] of Object.entries(iconHint)) {
    if (slug.toLowerCase().includes(key)) return value;
  }
  return 'file-document';
}
---

<ArabicLayout
  title={title}
  description={description}
  canonical={canonical}
  hreflang={[{ lang: 'ar-SA', href: canonical }]}
  jsonLd={jsonLd}
  currentPath="/docs/"
  breadcrumbs={[{ name: 'الوثائق', href: '/docs/' }]}
>
  <main class="docs-page-shell">

    <header class="docs-index__hero">
      <span class="chip chip--brand docs-index__eyebrow">
        <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-book"></use></svg>
        مركز الوثائق
      </span>
      <h1>وثائق تخدم تطبيقك لحوكمة الذكاء الاصطناعي</h1>
      <p class="docs-index__intro">
        المرجع العربي الشامل لحوكمة وأمان AI في السعودية — أكثر من ٢٧ وثيقة تغطي الحوكمة،
        الامتثال، إدارة المخاطر، والتطبيق التقني. من السياسة إلى الكود، كله هنا.
      </p>

      <form class="docs-search" role="search" data-prevent-default>
        <label class="visually-hidden" for="docs-search-input">بحث في الوثائق</label>
        <svg class="docs-search__icon" aria-hidden="true" width="20" height="20">
          <use href="/icons.svg#mdi-magnify"></use>
        </svg>
        <input
          id="docs-search-input"
          class="docs-search__input"
          type="search"
          placeholder="ابحث في الوثائق (مثال: PDPL، AI Firewall، Kernel)"
          autocomplete="off"
          enterkeyhint="search"
        />
      </form>

      <div class="docs-stats-row">
        <div>
          <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-file-document"></use></svg>
          <strong>{docs.length}</strong> وثيقة منشورة
        </div>
        <div>
          <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-layers"></use></svg>
          <strong>{sections.length}</strong> محاور رئيسية
        </div>
        <div>
          <svg aria-hidden="true" width="16" height="16"><use href="/icons.svg#mdi-refresh"></use></svg>
          محدثة بصفة مستمرة
        </div>
      </div>
    </header>

    {sections.map((section) => (
      <section class="docs-index__section" aria-labelledby={`docs-${section.id}`}>
        <h2 id={`docs-${section.id}`} class="docs-index__section-heading">{section.title}</h2>
        <p class="docs-index__section-intro">{section.intro}</p>
        <div class="docs-index__grid">
          {section.cards.map(([slug, cardTitle, cardDescription]) => (
            <a class="docs-index__card" href={`/docs/${slug}/`}>
              <span class="docs-index__card-icon" aria-hidden="true">
                <svg width="18" height="18"><use href={`/icons.svg#mdi-${cardIconFor(slug)}`}></use></svg>
              </span>
              <h3>{cardTitle}</h3>
              <p>{cardDescription}</p>
              <span class="docs-index__card-link">
                اقرأ الدليل
                <svg aria-hidden="true" width="14" height="14"><use href="/icons.svg#mdi-arrow-left"></use></svg>
              </span>
            </a>
          ))}
        </div>
        {section.id === 'solutions' && <p class="docs-index__section-intro">الربط الموضوعي: هذه الحلول تعمل معاً كمنظومة متكاملة - <a href="/docs/ai-governance-platform/">المنصة</a> تدير السياسات، <a href="/docs/ai-firewall/">الجدار الناري</a> يحمي البيانات، <a href="/docs/ai-audit-trail/">سجل التدقيق</a> يوثق كل شيء، <a href="/docs/human-approval-layer/">طبقة الموافقات</a> تضمن الرقابة، و<a href="/docs/ai-evidence-file/">ملف الأدلة</a> يجمع كل شيء للتدقيق.</p>}
        {section.id === 'kernel' && <p class="docs-index__section-intro">مسار التطبيق التقني: ابدأ بـ <a href="/docs/kernel-chat/">Kernel Chat</a> للواجهة، ثم <a href="/docs/kernel-audit-trail/">سجل التدقيق</a> للتوثيق، <a href="/docs/kernel-approvals/">الموافقات</a> للرقابة، <a href="/docs/kernel-policies/">السياسات</a> للإدارة، و<a href="/docs/kernel-compliance/">الامتثال</a> للمراقبة المستمرة.</p>}
        {section.id === 'compliance' && <p class="docs-index__section-intro">مسار الامتثال: ابدأ بفهم <a href="/docs/pdpl-ai-complete-guide/">متطلبات PDPL العميقة</a> و<a href="/docs/nca-ecc-ai-guide/">NCA ECC 2-2024 للذكاء الاصطناعي</a>، ثم راجع <a href="/docs/sdaia-generative-ai-guidelines/">إرشادات سدايا للاستخدام المسؤول</a>، واستخدم <a href="/docs/nca-ecc-ai-controls-mapping/">خريطة المواءمة</a> لربط المتطلبات بالضوابط.</p>}
        {section.id === 'implementation' && <p class="docs-index__section-intro">مسار التنفيذ: ابدأ بـ <a href="/docs/ai-governance-saudi-arabia/">فهم الحوكمة</a>، ثم <a href="/docs/ai-risk-management/">صنّف المخاطر</a>، طبّق <a href="/docs/governance-application/">خطة 30 يوم</a>، وحضّر <a href="/docs/ai-audit-readiness/">جاهزية التدقيق</a>.</p>}
        {section.id === 'advanced-kernel' && <p class="docs-index__section-intro">الربط التقني المتقدم: للتكامل الفني، راجع <a href="/docs/kernel-api-client/">عميل الـ API لكيرنل</a> و <a href="/docs/kernel-nvidia-proxy/">بروكسي نفيديا لكيرنل</a>، وللإدارة والوصول راجع <a href="/docs/kernel-accessibility-mobile/">سهولة الوصول للهاتف</a> و <a href="/docs/superpowers/">أدوات المطورين الخارقة</a>.</p>}
      </section>
    ))}

    <section class="docs-page-shell__main docs-page-shell__main--padded">
