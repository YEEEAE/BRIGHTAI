---
/**
 * Docs Hub — /docs/
 * Lists all documentation pages grouped by theme.
 *
 * REPORT-12: Visual refresh — page-hero canonical, search input prominent,
 * section-by-section card grids, cluster pathway panels, FAQ accordion
 * (canonical home-faq-item), final CTA (canonical card--cta).
 *
 * Content Preservation Rule:
 *   Section titles, intros, card titles, card descriptions, FAQ items are
 *   read from the data block below and rendered verbatim. No MSA "correction".
 */
import { getCollection } from 'astro:content';
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import DOMPurify from 'isomorphic-dompurify';

const docs = await getCollection('docs');
const title = 'مركز الوثائق | 30+ دليل حوكمة AI';
const description = '30+ وثيقة شاملة من BrightAI: PDPL وNCA ECC وإرشادات سدايا وإدارة المخاطر والتدقيق. دليلك الكامل لتشغيل AI بالسعودية بأمان وثقة. تصفح الوثائق الآن.';
const canonical = 'https://brightai.site/docs/';

// Helper: derive a stable "updated on" date from a doc's body file mtime via
// the Astro content collection. Falls back to "—" when unavailable.
const recentUpdates = docs
  .map((doc) => ({
    id: doc.id,
    title: doc.data.title,
    category: doc.data.category ?? 'وثائق',
    pubDate: doc.data.updated
      ? new Date(doc.data.updated).toISOString().slice(0, 10)
      : '—',
    sortKey: doc.data.updated instanceof Date
      ? doc.data.updated.getTime()
      : 0,
  }))
  .sort((a, b) => b.sortKey - a.sortKey)
  .slice(0, 5);

