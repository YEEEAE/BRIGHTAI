---
import ContentExtension from '../components/ContentExtension.astro';
import ScopeComposer from '../components/ScopeComposer.astro';
import PageShell from '../components/PageShell.astro';
export const prerender = true;
---
<PageShell title="الأسعار وطلب عرض سعر | BRIGHTAI" description="لا يوجد سعر نهائي معتمد لمنتجات BRIGHTAI. جهّز استفساراً لطلب معلومات أو عرض سعر دون التزام." crumbs={[{ name: 'الأسعار' }]}>
  <p class="eyebrow">الأسعار والتجربة</p><h1>ما الذي تحتاجه للحصول على عرض سعر؟</h1>
  <p class="lead">تختلف تكلفة الحل المقترح باختلاف المنتجات المختارة ونطاق الاستخدام والمتطلبات التشغيلية. لا ننشر أرقاماً قبل اعتماد نموذج التسعير وشروط الخدمة.</p>
  <section class="block quote-grid"><div><p class="eyebrow">نطاق واضح قبل أي رقم</p><h2>ما الذي يشكّل<br/>عرض السعر؟</h2><ol class="list"><li>المنتج أو المنتجات المستقلة التي تحتاجها.</li><li>نطاق الاستخدام ووحدة القياس والحصص.</li><li>بيئة النشر والتكامل والدعم ومعالجة البيانات.</li></ol><p class="note">المنتجات الخمسة مستقلة، و<bdi dir="ltr">Kernel</bdi> مشمول بلا رسم ترخيص منفصل. المستهدف: <bdi dir="ltr">SaaS</bdi> باشتراك و<bdi dir="ltr">On-Premise</bdi> بترخيص، و<bdi dir="ltr">Air-Gapped</bdi> بمتطلبات تشغيل معزول؛ ليست إعلان جاهزية. لا توجد أسعار أو حصص أو <bdi dir="ltr">SLA</bdi> نهائية معتمدة.</p></div><aside class="quote-scope" aria-label="تجهيز استفسار السعر"><h2>جهّز استفسارك</h2><ul><li>القطاع والغرض من الاستخدام</li><li>المنتجات التي تود معرفة تفاصيلها</li><li>متطلبات البيئة والمراجعة</li></ul><p>اكتب وصفاً عاماً دون بيانات حساسة. تجهّز مسودة محلية ثم تنسخها إلى البريد أو واتساب؛ الموقع لا يحفظ طلبًا ولا يرسله أو يؤكد استلامه.</p><a class="button" href="/contact/">جهّز رسالة الاستفسار ←</a></aside></section>
  <section class="block pricing-trial"><h2>اطّلع الآن، وناقش التشغيل بشكل منفصل</h2><p><a href="/products/#lab">المختبر العام</a> متاح بلا حساب وببيانات اصطناعية. استكشاف 48 ساعة محدود بالقراءة يتطلب بريدًا موثقًا وإتاحة البوابة، ولا يعني تشغيلًا مؤسسيًا أو ربط بياناتك.</p><p>يمكنك الاستفسار عن تجربة مؤسسية أو Pilot. النطاق والمدة والحصص والتهيئة والدعم تحتاج موافقة واتفاقًا مستقلًا؛ إرسال استفسار لا يفعّل تجربة ولا ينشئ ترخيصًا أو التزامًا بالدفع.</p></section>

  <ScopeComposer />
    <ContentExtension>

<section><h2>التجربة والـPilot والعقد: ما الفرق؟</h2><div class="extension-columns"><div><h3>تجربة 48 ساعة</h3><p>متطلب لتجربة قصيرة ضمن أهلية وحصة ونطاق معتمد. البيانات اصطناعية؛ الواقعية ممنوعة بلا موافقة مكتوبة وبيئة معتمدة. منع التدريب ببيانات العملاء (<bdi dir="ltr">No-Training</bdi>) لا يمكن تجاوزه بموافقة تشغيلية.</p></div><div><h3>Pilot مؤسسي</h3><p>تشغيل محدود متفق عليه مع أهداف ومراجعة ونتائج موثقة. مدته ونطاقه يحددهما الاتفاق، ولا يفترض أنه التجربة نفسها.</p></div><div><h3>عقد وترخيص</h3><p>يحدد المنتج والوظائف والنشر والمسؤوليات والسعر والدعم ومعالجة البيانات. مجرد الاستفسار لا ينشئ التزاماً تجارياً.</p></div></div></section>
<section><h2>افصل رسوم المنتج عن كلفة المورد</h2><p>اطلب عرضاً يوضح رسوم BRIGHT AI، والتكامل والتنفيذ والدعم، وتكاليف النماذج أو API الخارجية عند وجودها. يجب بيان الحصص والزيادة وسقف الإنفاق وشروط الموافقة قبل التعاقد؛ لا نفترض قيماً أو نسباً معتمدة.</p><p><a href="/contact/">استفسر عن أهلية التجربة المخططة</a> دون إرسال بيانات فعلية أو أسرار.</p></section>
    </ContentExtension>
<section aria-label="مسارات التجربة"><h2>اختر المسار المناسب</h2><ul><li>مختبر عام فوري بلا حساب.</li><li>استكشاف 48 ساعة محدود بالقراءة لصاحب بريد موثق عند فتح البوابة.</li><li>تجربة مؤسسية تشغيلية بموافقة مشغّل.</li></ul></section>
</PageShell>
