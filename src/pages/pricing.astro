---
import ContentExtension from '../components/ContentExtension.astro';
import ScopeComposer from '../components/ScopeComposer.astro';
import PageShell from '../components/PageShell.astro';
export const prerender = true;
---
<PageShell title="الأسعار وطلب عرض سعر | BRIGHTAI" description="لا يوجد سعر نهائي معتمد لمنتجات BRIGHTAI. أرسل استفساراً لطلب معلومات أو عرض سعر دون التزام." crumbs={[{ name: 'الأسعار' }]}>
  <p class="eyebrow">الأسعار والتجربة</p><h1>السعر النهائي غير معتمد</h1>
  <p class="lead">تختلف تكلفة الحل المقترح باختلاف المنتجات المختارة ونطاق الاستخدام والمتطلبات التشغيلية. لا ننشر أرقاماً قبل اعتماد نموذج التسعير وشروط الخدمة.</p>
  <section class="block quote-grid"><div><p class="eyebrow">نطاق واضح قبل أي رقم</p><h2>ما الذي يشكّل<br/>عرض السعر؟</h2><ol class="list"><li>المنتج أو المنتجات المستقلة التي تحتاجها.</li><li>نطاق الاستخدام ووحدة القياس والحصص.</li><li>بيئة النشر والتكامل والدعم ومعالجة البيانات.</li></ol><p class="note">لا توجد أسعار أو حصص نهائية معتمدة. لذلك لا نقدم حاسبة تعطي مبلغاً غير موثق.</p></div><aside class="quote-scope"><h2>جهّز استفسارك</h2><ul><li>القطاع والغرض من الاستخدام</li><li>المنتجات التي تود معرفة تفاصيلها</li><li>متطلبات البيئة والمراجعة</li></ul><p>اكتب وصفاً عاماً دون بيانات حساسة. النموذج يفتح تطبيق البريد، ولا يرسل أو يؤكد استلام الطلب.</p><a class="button" href="/contact/?topic=طلب%20عرض%20سعر">جهّز رسالة الاستفسار ←</a></aside></section>
  <section class="block"><h2>حول تجربة الـ48 ساعة</h2><p>تجربة تعريفية مدتها 48 ساعة واردة كمتطلب في الـBlueprint، وتبدأ من التفعيل وفق الأهلية والسياسات. التجربة غير مفعلة حالياً، ولا يثبت هذا الموقع القدرة على تفعيلها. وهي لا تتحول تلقائياً إلى اشتراك مدفوع.</p><p class="note">أي تفعيل مستقبلي يحتاج إثبات الجاهزية، واتفاقاً واضحاً يحدد المنتج والنطاق ومعالجة البيانات وشروط الإنهاء.</p></section>

  <ScopeComposer />
    <ContentExtension>

<section><h2>التجربة والـPilot والعقد: ما الفرق؟</h2><div class="extension-columns"><div><h3>تجربة 48 ساعة</h3><p>متطلب لتجربة قصيرة من وقت التفعيل، ضمن أهلية وحصة ونطاق معلن. البيانات اصطناعية افتراضياً، ولا تتحول التجربة إلى شراء تلقائي. التفعيل الحالي غير مثبت.</p></div><div><h3>Pilot مؤسسي</h3><p>تشغيل محدود متفق عليه مع أهداف ومراجعة ونتائج موثقة. مدته ونطاقه يحددهما الاتفاق، ولا يفترض أنه التجربة نفسها.</p></div><div><h3>عقد وترخيص</h3><p>يحدد المنتج والوظائف والنشر والمسؤوليات والسعر والدعم ومعالجة البيانات. مجرد الاستفسار لا ينشئ التزاماً تجارياً.</p></div></div></section>
<section><h2>افصل رسوم المنتج عن كلفة المورد</h2><p>اطلب عرضاً يوضح رسوم BRIGHT AI، والتكامل والتنفيذ والدعم، وتكاليف النماذج أو API الخارجية عند وجودها. يجب بيان الحصص والزيادة وسقف الإنفاق وشروط الموافقة قبل التعاقد؛ لا نفترض قيماً أو نسباً معتمدة.</p><p><a href="/contact/?topic=استفسار%20عن%20تجربة%2048%20ساعة">استفسر عن أهلية التجربة المخططة</a> دون إرسال بيانات فعلية أو أسرار.</p></section>
    </ContentExtension>
</PageShell>
