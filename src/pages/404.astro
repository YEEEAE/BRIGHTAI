---
import ArabicLayout from '../layouts/ArabicLayout.astro';

import Icon from '../components/Icon.astro';

const navigationLinks = [
  { href: '/', label: 'الرئيسية', icon: 'mdi:home-outline' },
  { href: '/solutions/', label: 'الحلول', icon: 'mdi:shield-check-outline' },
  { href: '/kernel/', label: 'النواة', icon: 'mdi:hexagon-multiple-outline' },
  { href: '/blog/', label: 'المدونة', icon: 'mdi:post-outline' },
  { href: '/docs/', label: 'الوثائق', icon: 'mdi:file-document-outline' },
];
---

{/*
  ─── ECHO: The Star (mono variant) supports the 404 page ───
  The mono variant has dashed lines + dimmed kernel = visual metaphor for
  "kernel still on duty, but connection lost". Connects the brand identity
  to the error state — page error doesn't feel orphaned.
*/}

<ArabicLayout
  title="الصفحة غير موجودة | BrightAI"
  description="الصفحة المطلوبة غير متوفرة حالياً. يمكنك العودة إلى الصفحة الرئيسية أو استكشاف حلول BrightAI لحوكمة الذكاء الاصطناعي والامتثال لـ PDPL وNCA للشركات السعودية. ابدأ رحلة الامتثال من هنا."
  canonical="https://brightai.live/404/"
  hreflang={[
    { lang: 'ar-SA', href: 'https://brightai.live/404/' },
    { lang: 'x-default', href: 'https://brightai.live/404/' },
  ]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'الصفحة غير موجودة',
    url: 'https://brightai.live/404/',
    inLanguage: 'ar-SA',
  }}
  currentPath="/404/"
>
  <section class="inner-hero error-page" aria-labelledby="error-title">
    <div class="max-w-4xl mx-auto px-5 lg:px-8 text-center">
      {/*
        The Star in mono form — visually contextualizes the 404.
        Decorative; h1 carries the verbal meaning.
      */}
      <div class="error-page__star-wrap" data-priority="404-echo">
        <img src="/assets/star/bright-star-mono.svg" alt="" width="280" height="210" class="error-page__star" loading="lazy" decoding="async" />
      </div>

      <p class="error-page__code" aria-hidden="true">404</p>
      <div class="inner-hero__badge">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-map-marker-question-outline"></use></svg>
        الرابط ما وصل لصفحة
      </div>
      <h1 id="error-title">الصفحة مو موجودة</h1>
      <p class="inner-hero__desc mx-auto">
        الرابط اللي دخلت عليه إما تغيّر أو انحذف. تحت لك روابط مهمة تساعدك توصل للي تبيه.
      </p>
      <p class="inner-hero__desc mx-auto">
        إذا جيت من محرك بحث أو رابط قديم، غالباً المحتوى انتقل لمكان ثاني. نحدّث الموقع باستمرار عشان يكون أوضح وأسهل.
      </p>
      <p class="inner-hero__desc mx-auto">
        أسهل شي ترجع للصفحة الرئيسية وتختار الخدمة اللي تناسبك، أو تتواصل معنا مباشرة.
      </p>

      <nav class="error-page__links" aria-label="روابط مقترحة">
        {navigationLinks.map((link) => (
          <a href={link.href} class="inner-card error-page__link">
            <Icon name={link.icon} class="" />
            <span>{link.label}</span>
          </a>
        ))}
      </nav>

      <div class="inner-hero__actions error-page__actions">
        <a href="/contact/" class="glow-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-calendar-check"></use></svg>
          احجز جلسة
        </a>
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-white border border-white/20">
          <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-arrow-right"></use></svg>
          العودة للرئيسية
        </a>
      </div>

      <div class="error-page__legacy-links">
        <a href="/pricing/" class="inner-card error-page__legacy-link">
          <h2>الأسعار</h2>
          <p>شوف الباقات والأسعار</p>
        </a>
        <a href="/services/" class="inner-card error-page__legacy-link">
          <h2>أمثلة من السوق</h2>
          <p>شركات سعودية استخدمت الحلول</p>
        </a>
        <a href="/go/whatsapp/" target="_blank" rel="noopener noreferrer" class="inner-card error-page__legacy-link">
          <h2>تواصل واتساب</h2>
          <p>كلمنا مباشرة</p>
        </a>
      </div>
    </div>
  </section>

  <section class="inner-section inner-section--alt" aria-labelledby="site-directory-title">
    <div class="max-w-4xl mx-auto px-5 lg:px-8">
      <h2 id="site-directory-title" class="inner-section__title">دليل الموقع — BrightAI</h2>
      <p class="inner-section__lead">استعرض خريطة موقعنا الكاملة للوصول السريع لأي محتوى تبحث عنه.</p>
      <div class="grid grid--3" style="margin-top: var(--space-5); gap: var(--space-4);">
        <div class="inner-card p-5">
          <h3 class="inner-card__title">حلول الحوكمة</h3>
          <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:var(--space-2);">
            <li><a href="/solutions/ai-governance-platform/" class="footer__link">منصة حوكمة الذكاء الاصطناعي</a></li>
            <li><a href="/solutions/ai-firewall/" class="footer__link">جدار حماية الذكاء الاصطناعي</a></li>
            <li><a href="/solutions/ai-audit-trail/" class="footer__link">سجل تدقيق الذكاء الاصطناعي</a></li>
            <li><a href="/solutions/ai-risk-classification/" class="footer__link">تصنيف مخاطر الذكاء الاصطناعي</a></li>
            <li><a href="/solutions/human-approval-layer/" class="footer__link">طبقة الموافقات البشرية</a></li>
            <li><a href="/solutions/ai-evidence-file/" class="footer__link">ملف الأدلة الرقمية</a></li>
          </ul>
        </div>
        <div class="inner-card p-5">
          <h3 class="inner-card__title">القطاعات</h3>
          <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:var(--space-2);">
            <li><a href="/solutions/banking-ai-governance/" class="footer__link">حوكمة AI للبنوك</a></li>
            <li><a href="/solutions/healthcare-ai-governance/" class="footer__link">حوكمة AI للصحة</a></li>
            <li><a href="/solutions/government-ai-governance/" class="footer__link">حوكمة AI للجهات الحكومية</a></li>
            <li><a href="/solutions/manufacturing-ai-governance/" class="footer__link">حوكمة AI للتصنيع</a></li>
            <li><a href="/kernel/" class="footer__link">نواة BrightAI</a></li>
            <li><a href="/docs/" class="footer__link">الوثائق التقنية</a></li>
          </ul>
        </div>
        <div class="inner-card p-5">
          <h3 class="inner-card__title">المحتوى والموارد</h3>
          <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:var(--space-2);">
            <li><a href="/blog/" class="footer__link">المدونة التقنية</a></li>
            <li><a href="/hub/ai-governance/" class="footer__link">مركز حوكمة الذكاء الاصطناعي</a></li>
            <li><a href="/hub/compliance/" class="footer__link">مركز الامتثال السعودي</a></li>
            <li><a href="/assessment/ai-governance-readiness/" class="footer__link">تقييم الجاهزية</a></li>
            <li><a href="/pricing/" class="footer__link">الأسعار والباقات</a></li>
            <li><a href="/contact/" class="footer__link">تواصل معنا</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="inner-section" aria-labelledby="error-govref-title">
    <div class="max-w-4xl mx-auto px-5 lg:px-8">
      <h2 id="error-govref-title" class="inner-section__title">ما هي حوكمة الذكاء الاصطناعي؟</h2>
      <div class="inner-card p-6">
        <p class="inner-card__text" style="line-height:1.9;">حوكمة الذكاء الاصطناعي هي المنظومة المتكاملة من السياسات والضوابط والأدوات التي تضمن استخدام الذكاء الاصطناعي بشكل آمن ومسؤول وقابل للتدقيق داخل المنشآت السعودية. تشمل الحوكمة: جرد أدوات الذكاء الاصطناعي المستخدمة في المنشأة، تصنيف المخاطر المرتبطة بكل حالة استخدام، تطبيق ضوابط حماية البيانات وفق نظام PDPL وضوابط NCA ECC، وبناء ملف أدلة قابل للتدقيق أمام الجهات الرقابية كسدايا وBASEL وSAMA وغيرها. تساعد BrightAI المنشآت السعودية على تطبيق هذه المنظومة من خلال أدوات تقنية متكاملة وفريق من مستشاري الحوكمة المتخصصين.</p>
      </div>
    </div>
  </section>

</ArabicLayout>
