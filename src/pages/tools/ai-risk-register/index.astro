---
import ArabicLayout from '../../../layouts/ArabicLayout.astro';

const canonical = 'https://brightai.site/tools/ai-risk-register/';

const fields = [
  ['useCase', 'حالة الاستخدام'],
  ['system', 'النظام / النموذج / المورد'],
  ['owner', 'مالك العمل'],
  ['dataTypes', 'أنواع البيانات'],
  ['users', 'المستخدمون المتأثرون'],
  ['category', 'فئة الخطر'],
  ['likelihood', 'الاحتمالية'],
  ['impact', 'الأثر'],
  ['riskLevel', 'مستوى الخطر'],
  ['controls', 'الضوابط'],
  ['approval', 'الحاجة لموافقة بشرية'],
  ['monitoring', 'المراقبة'],
  ['evidence', 'الأدلة'],
  ['reviewDate', 'تاريخ المراجعة'],
  ['status', 'الحالة'],
];

const records = [
  {
    useCase: 'مساعد خدمة العملاء يكتب مسودة الرد',
    system: 'مساعد داخلي + نموذج سحابي معتمد',
    owner: 'مدير تجربة العميل',
    dataTypes: 'استفسارات العملاء، رقم الطلب',
    users: 'عملاء المتجر وموظفو الدعم',
    category: 'خصوصية · دقة',
    likelihood: ['متوسطة', 'medium'],
    impact: ['متوسط', 'medium'],
    riskLevel: ['متوسط · 9/25', 'medium'],
    controls: 'تنقيح البيانات، قاعدة معرفة معتمدة، مراجعة الموظف قبل الإرسال',
    approval: 'نعم — قبل إرسال أي رد خارجي',
    monitoring: 'عينات أسبوعية، معدل التعديل، بلاغات العملاء',
    evidence: 'سجل الطلب، الرد النهائي، اسم المراجع، نسخة السياسة',
    reviewDate: '2026-10-01',
    status: ['تجريبي', 'trial'],
  },
  {
    useCase: 'فرز أولي للسير الذاتية للوظائف',
    system: 'نظام توظيف + نموذج تصنيف داخلي',
    owner: 'مدير الموارد البشرية',
    dataTypes: 'سيرة ذاتية، مؤهلات، بيانات تواصل',
    users: 'المتقدمون للوظائف وفريق التوظيف',
    category: 'إنصاف · قرار مؤثر',
    likelihood: ['متوسطة', 'medium'],
    impact: ['عالٍ', 'high'],
    riskLevel: ['عالٍ · 16/25', 'high'],
    controls: 'معايير معلنة، منع القرار الآلي، مراجعة بشرية، اختبار تحيز',
    approval: 'نعم — إلزامية قبل الاستبعاد أو الترتيب النهائي',
    monitoring: 'مقارنة النتائج حسب الفئات، اعتراضات المتقدمين، تدقيق شهري',
    evidence: 'المعايير، عينات القرار، سجل الاعتراضات، تقرير التحيز',
    reviewDate: '2026-09-15',
    status: ['يتطلب معالجة', 'action'],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'قالب سجل مخاطر الذكاء الاصطناعي للمنشآت السعودية',
  description: 'قالب BrightAI عملي لتوثيق حالات استخدام الذكاء الاصطناعي والمخاطر والضوابط والموافقات والأدلة.',
  url: canonical,
  inLanguage: 'ar-SA',
};

// Client-side export payload (CSV/JSON) — flattened plain-text values so the
// export module never scrapes rendered markup. Files are built locally in the
// browser; nothing leaves the device.
const exportData = {
  note: 'قالب تنفيذ من BrightAI باستخدام مصفوفة عامة 1–5 — ليست درجة رسمية من سدايا ولا تصنيفًا تنظيميًا.',
  fields: fields.map(([key, label]) => ({ key, label })),
  records: records.map((record) => {
    const flat: Record<string, string> = {};
    for (const [key] of fields) {
      const value = record[key];
      flat[key] = Array.isArray(value) ? value[0] : String(value ?? '');
    }
    return flat;
  }),
};
---

<ArabicLayout title="قالب سجل مخاطر الذكاء الاصطناعي للمنشآت السعودية | BrightAI" description="قالب عملي من BrightAI لتسجيل حالات استخدام AI، المالك، البيانات، المخاطر، الضوابط، الموافقات، المراقبة والأدلة — مع نسخة مناسبة للجوال والطباعة." canonical={canonical} hreflang={[{ lang: 'ar-SA', href: canonical }, { lang: 'x-default', href: canonical }]} jsonLd={jsonLd as any} currentPath="/tools/ai-risk-register/" breadcrumbs={[{ name: 'أدوات AI', href: '/tools/ai-risk-register/' }, { name: 'سجل مخاطر AI', href: '/tools/ai-risk-register/' }]}>
  <main class="risk-register">
    <header class="risk-hero">
      <div>
        <p class="risk-kicker">أداة تشغيلية · للمنشآت السعودية</p>
        <h1>سجل مخاطر الذكاء الاصطناعي</h1>
        <p class="risk-lede">قالب واحد يخلي فريقك يعرف: وش الاستخدام؟ مين يملكه؟ وش البيانات المتأثرة؟ وش الضابط المطلوب قبل ما يكبر الخطر؟</p>
        <div class="risk-actions"><a class="risk-button risk-button--primary" href="#register">ابدأ من الجدول <span aria-hidden="true">↓</span></a><a class="risk-button risk-button--quiet" href="#how-to-use">طريقة الاستخدام</a></div>
      </div>
      <aside class="risk-hero__stamp" aria-label="طبيعة القالب"><span class="stamp-number">15</span><span>حقل تشغيلي</span><small>قابل للطباعة والمراجعة</small></aside>
    </header>

    <section id="how-to-use" class="risk-intro" aria-labelledby="how-to-use-title">
      <div><p class="risk-label">قبل ما تبدأ</p><h2 id="how-to-use-title">كيف تستخدم السجل؟</h2><p>سوّ صفًا لكل حالة استخدام AI، حتى لو كانت الأداة خارجية أو ما زالت تحت التجربة. خل مالك العمل يراجع الصف، ثم حدّد الاحتمالية والأثر بنفس القاعدة داخل الجهة. بعد التشغيل، حدّث الضوابط والأدلة في كل تغيير مهم أو حادثة، وعلى الأقل في موعد المراجعة المحدد.</p></div>
      <ol class="risk-steps"><li><b>01</b><span><strong>احصر</strong> الاستخدام والنظام والبيانات.</span></li><li><b>02</b><span><strong>قيّم</strong> الاحتمالية والأثر مع أصحاب العلاقة.</span></li><li><b>03</b><span><strong>اضبط</strong> القرار والموافقة والمراقبة.</span></li><li><b>04</b><span><strong>أثبت</strong> ما صار وراجع السجل دوريًا.</span></li></ol>
    </section>

    <section class="risk-notice" aria-label="حدود القالب"><span class="risk-notice__icon" aria-hidden="true">!</span><p><strong>مهم:</strong> مستوى الخطر هنا مبني على <strong>قالب تنفيذ من BrightAI</strong> باستخدام مصفوفة عامة 1–5 للاحتمالية والأثر. هذي <strong>ليست درجة رسمية من سدايا</strong>، ولا تصنيفًا تنظيميًا أو رأيًا قانونيًا. اعتمدوا منهجيتكم الداخلية وراجعوا المتطلبات الخاصة بقطاعكم.</p></section>

    <section class="risk-links" aria-label="روابط مرتبطة"><a href="/solutions/ai-risk-classification/"><span>01</span><strong>AI Risk Classification</strong><small>صنّف الاستخدام قبل ما توسّعه</small><b aria-hidden="true">←</b></a><a href="/assessment/ai-governance-readiness/"><span>02</span><strong>AI Governance Readiness</strong><small>خذ صورة أولية عن جاهزية الحوكمة</small><b aria-hidden="true">←</b></a></section>

    <section id="register" class="risk-table-section" aria-labelledby="register-title">
      <div class="risk-section-heading"><div><p class="risk-label">قالب جاهز للتعبئة</p><h2 id="register-title">سجل الاستخدامات والمخاطر</h2></div><span class="risk-print-hint">للطباعة: استخدم أمر الطباعة في المتصفح</span></div>
      <div class="risk-export" id="risk-export" hidden>
        <span class="risk-export__label">نزّل القالب جاهز للتعبئة:</span>
        <button type="button" class="risk-export__btn" id="risk-export-csv">ملف CSV <small>يفتح بـ Excel</small></button>
        <button type="button" class="risk-export__btn" id="risk-export-json">ملف JSON <small>للأنظمة والأدوات</small></button>
        <span class="risk-export__hint">الملف يتجهز على جهازك مباشرة — ما نرسل أي بيانات ولا نخزنها.</span>
      </div>
      <div class="risk-legend" aria-label="شرح المستويات"><span><i class="dot dot--low"></i> منخفض</span><span><i class="dot dot--medium"></i> متوسط</span><span><i class="dot dot--high"></i> عالٍ</span><span class="legend-note">النتيجة = الاحتمالية × الأثر (1–5)</span></div>
      <div class="risk-table-wrap" tabindex="0" role="region" aria-label="سجل مخاطر الذكاء الاصطناعي، مرر أفقيًا على الشاشات الكبيرة">
        <table>
          <caption>قالب سجل مخاطر الذكاء الاصطناعي — أمثلة توضيحية قابلة للاستبدال</caption>
          <thead><tr>{fields.map(([, label]) => <th scope="col">{label}</th>)}</tr></thead>
          <tbody>{records.map((record) => <tr>{fields.map(([key, label]) => { const value = record[key]; const isBadge = Array.isArray(value); const [text, tone] = isBadge ? value : [value, '']; return <td data-label={label}>{isBadge ? <span class:list={['risk-badge', 'risk-badge--' + tone]}>{text}</span> : text}</td>; })}</tr>)}</tbody>
        </table>
      </div>
      <p class="risk-table-note"><strong>ملاحظة:</strong> الصفوف أعلاه أمثلة توضيحية. استبدلها بحالاتكم الفعلية، ولا تترك خانة «الأدلة» عامة؛ اكتب اسم المستند أو السجل أو الرابط الداخلي اللي يثبت القرار.</p>
    </section>

    <section class="risk-close" aria-labelledby="close-title"><p class="risk-label">الخطوة اللي بعدها</p><h2 id="close-title">السجل بداية القرار — مو نهايته</h2><p>إذا عندكم استخدامات كثيرة أو مخاطر عالية، اربطوا السجل بمسار تصنيف، موافقات، ومراقبة مستمرة. ابدأوا بالحالات اللي تمس بيانات شخصية أو تؤثر على عميل أو موظف، ثم وسّعوا النطاق بالتدريج.</p><div><a href="/solutions/ai-risk-classification/" class="risk-text-link">استكشف تصنيف المخاطر <span aria-hidden="true">←</span></a><a href="/assessment/ai-governance-readiness/" class="risk-text-link">قيّم جاهزية الحوكمة <span aria-hidden="true">←</span></a></div></section>

    <script type="application/json" id="risk-register-data" set:html={JSON.stringify(exportData)} />
    <script is:inline type="module" src="/js/ai-risk-register-export.js"></script>
  </main>
</ArabicLayout>

<style>
  .risk-register{max-width:92rem;margin:0 auto;padding:clamp(1rem,3vw,2.5rem) clamp(1rem,4vw,3.5rem) 5rem;color:var(--text-primary)}
  .risk-hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:end;padding:clamp(1.5rem,4vw,4rem);border:1px solid color-mix(in srgb,var(--brand-400) 32%,transparent);border-radius:1.5rem;background:radial-gradient(circle at 12% 10%,rgba(56,189,248,.2),transparent 35%),linear-gradient(135deg,#0b1728,#102d3c 68%,#163d43);color:#f8fafc}
  .risk-kicker,.risk-label{margin:0 0 .65rem;color:#68e0ca;font-size:.76rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.risk-hero h1{max-width:12ch;margin:0;font-size:clamp(2.35rem,7vw,5.5rem);line-height:.98;letter-spacing:-.055em}.risk-lede{max-width:58ch;margin:1.4rem 0 0;color:#cbd5e1;font-size:clamp(1rem,2vw,1.2rem);line-height:1.8}
  .risk-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.75rem}.risk-button{display:inline-flex;align-items:center;gap:.6rem;min-height:44px;padding:.7rem 1rem;border:1px solid transparent;border-radius:.75rem;font-weight:800;text-decoration:none}.risk-button--primary{background:#68e0ca;color:#082327}.risk-button--quiet{border-color:rgba(255,255,255,.22);color:#f8fafc}.risk-hero__stamp{display:grid;min-width:10rem;padding:1rem;border:1px solid rgba(255,255,255,.18);border-radius:1rem;background:rgba(5,15,25,.26);text-align:center}.stamp-number{font-size:3rem;font-weight:900;line-height:1;color:#68e0ca}.risk-hero__stamp small{margin-top:.35rem;color:#9fb2c4}
  .risk-intro{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(18rem,.8fr);gap:clamp(1.5rem,5vw,4rem);padding:clamp(2.5rem,6vw,5rem) 0 2rem}.risk-intro h2,.risk-section-heading h2,.risk-close h2{margin:0;font-size:clamp(1.8rem,4vw,3rem);letter-spacing:-.04em}.risk-intro p:not(.risk-label),.risk-close>p{max-width:65ch;color:var(--text-secondary);line-height:1.9}
  .risk-steps{display:grid;gap:.7rem;margin:0;padding:0;list-style:none}.risk-steps li{display:flex;align-items:center;gap:.8rem;padding:.8rem 0;border-bottom:1px solid var(--border)}.risk-steps b{color:var(--brand-300);font-variant-numeric:tabular-nums}.risk-steps span{color:var(--text-secondary)}.risk-steps strong{color:var(--text-primary)}
  .risk-notice{display:flex;gap:.9rem;align-items:flex-start;margin:1rem 0 1.5rem;padding:1rem 1.15rem;border:1px solid color-mix(in srgb,var(--accent-warm) 42%,var(--border));border-radius:1rem;background:color-mix(in srgb,var(--accent-warm) 8%,var(--surface-1))}.risk-notice p{margin:0;color:var(--text-secondary);line-height:1.8}.risk-notice strong{color:var(--text-primary)}.risk-notice__icon{display:grid;flex:0 0 1.6rem;place-items:center;width:1.6rem;height:1.6rem;border-radius:50%;background:var(--accent-warm);color:#1c1303;font-weight:900}
  .risk-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin:1.5rem 0 3rem}.risk-links a{display:grid;grid-template-columns:auto 1fr auto;gap:.2rem .75rem;align-items:center;padding:1rem 1.1rem;border:1px solid var(--border);border-radius:1rem;background:var(--surface-1);color:inherit;text-decoration:none;transition:border-color .2s,transform .2s}.risk-links a:hover{border-color:var(--brand-300);transform:translateY(-2px)}.risk-links span{grid-row:span 2;color:var(--brand-300);font-size:.78rem;font-weight:900}.risk-links strong{font-size:.95rem}.risk-links small{color:var(--text-muted)}.risk-links b{grid-row:span 2;color:var(--brand-300)}
  .risk-section-heading{display:flex;justify-content:space-between;gap:1rem;align-items:end;margin-bottom:1rem}.risk-print-hint{color:var(--text-muted);font-size:.78rem}
  .risk-export{display:flex;flex-wrap:wrap;align-items:center;gap:.7rem;margin:0 0 1rem;padding:.85rem 1rem;border:1px solid color-mix(in srgb,var(--brand-400) 30%,var(--border));border-radius:1rem;background:color-mix(in srgb,var(--brand-500) 6%,var(--surface-1))}.risk-export__label{font-weight:850;color:var(--text-primary)}.risk-export__btn{display:inline-flex;align-items:center;gap:.4rem;min-height:44px;padding:.6rem 1rem;border:1px solid var(--brand-400);border-radius:.75rem;background:var(--surface-2);color:var(--brand-300);font-weight:850;cursor:pointer}.risk-export__btn small{color:var(--text-muted);font-weight:600}.risk-export__btn:hover{border-color:var(--brand-300)}.risk-export__btn:focus-visible{outline:3px solid var(--focus-ring);outline-offset:3px}.risk-export__hint{flex-basis:100%;color:var(--text-muted);font-size:.78rem}.risk-button:focus-visible,.risk-links a:focus-visible,.risk-text-link:focus-visible{outline:3px solid var(--focus-ring);outline-offset:3px}.risk-legend{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin-bottom:.8rem;color:var(--text-secondary);font-size:.82rem}.dot{display:inline-block;width:.65rem;height:.65rem;margin-inline-end:.25rem;border-radius:50%}.dot--low{background:#49c58b}.dot--medium{background:#e4b34d}.dot--high{background:#ee7a69}.legend-note{margin-inline-start:auto;color:var(--text-muted)}
  .risk-table-wrap{overflow:auto;border:1px solid var(--border);border-radius:1rem;background:var(--surface-1)}table{width:100%;min-width:165rem;border-collapse:collapse;table-layout:fixed;font-size:.78rem}caption{padding:1rem;text-align:start;color:var(--text-muted);font-size:.85rem}th,td{padding:.85rem .7rem;border-block-start:1px solid var(--border);vertical-align:top;text-align:start;line-height:1.65}thead th{border-block-start:0;background:var(--surface-2);color:var(--text-primary);font-size:.73rem;font-weight:850}tbody tr:hover{background:color-mix(in srgb,var(--brand-500) 5%,transparent)}td{color:var(--text-secondary)}.risk-badge{display:inline-block;padding:.25rem .5rem;border:1px solid currentColor;border-radius:999px;font-weight:850;white-space:nowrap}.risk-badge--low{color:#2c9b6a;background:color-mix(in srgb,#49c58b 12%,transparent)}.risk-badge--medium{color:#ad7a16;background:color-mix(in srgb,#e4b34d 13%,transparent)}.risk-badge--high{color:#bd5144;background:color-mix(in srgb,#ee7a69 13%,transparent)}.risk-badge--trial{color:var(--brand-300)}.risk-badge--action{color:#bd5144}.risk-table-note{margin:1rem 0 0;color:var(--text-muted);font-size:.9rem;line-height:1.8}.risk-table-note strong{color:var(--text-secondary)}
  .risk-close{margin-top:4rem;padding:clamp(1.5rem,4vw,3rem);border-radius:1.25rem;background:linear-gradient(135deg,color-mix(in srgb,var(--brand-500) 12%,var(--surface-1)),var(--surface-2))}.risk-close>p{margin-block:.75rem 1.3rem}.risk-close>div{display:flex;flex-wrap:wrap;gap:1rem}.risk-text-link{color:var(--brand-300);font-weight:850}
  @media(max-width:850px){.risk-hero{grid-template-columns:1fr}.risk-hero__stamp{width:max-content;min-width:8.5rem}.risk-intro{grid-template-columns:1fr}.risk-links{grid-template-columns:1fr}.legend-note{margin-inline-start:0}.risk-section-heading{align-items:start;flex-direction:column}}
  @media(max-width:680px){.risk-register{padding-inline:.85rem}.risk-hero h1{max-width:14ch}.risk-table-wrap{overflow:visible;border:0;background:transparent}.risk-table-wrap[tabindex]{outline:0}table{display:block;min-width:0}caption{display:block;padding:.75rem 0;text-align:start}thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}tbody,tr,td{display:block}tbody{display:grid;gap:1rem}tr{border:1px solid var(--border);border-radius:1rem;background:var(--surface-1);overflow:hidden}td{display:grid;grid-template-columns:minmax(8rem,.55fr) minmax(0,1fr);gap:.8rem;padding:.7rem .85rem;border-block-start:1px solid var(--border)}td:first-child{border-block-start:0}td::before{content:attr(data-label);color:var(--text-primary);font-size:.72rem;font-weight:850}td .risk-badge{justify-self:start}.risk-table-note{font-size:.85rem}}
  @media print{.risk-register{max-width:none;padding:0;color:#111}.risk-hero{padding:1rem;border:1px solid #777;background:#fff;color:#111}.risk-hero__stamp,.risk-actions,.risk-links,.risk-print-hint,.risk-notice__icon,.risk-export{display:none}.risk-lede,.risk-intro p:not(.risk-label),.risk-close>p,.risk-notice p,.risk-table-note{color:#222}.risk-intro{padding-block:1rem;grid-template-columns:1fr 1fr}.risk-notice{margin-block:1rem;padding:.65rem;background:#fff;border-color:#777}.risk-table-wrap{overflow:visible;border:0}.risk-table-wrap[tabindex]{outline:0}table{min-width:0;font-size:7.5pt;table-layout:auto}caption{padding:.5rem 0;color:#111}th,td{padding:.35rem;border-color:#999;color:#111}thead{position:static;width:auto;height:auto;overflow:visible;clip:auto;white-space:normal}.risk-badge{color:#111!important;background:#fff!important}.risk-close{margin-top:1rem;padding:1rem;border:1px solid #999;background:#fff}.risk-close>div{display:none}tr{break-inside:avoid;page-break-inside:avoid}@page{size:landscape;margin:12mm}}
  @media(prefers-reduced-motion:reduce){.risk-links a{transition:none}}
</style>
