    risk: 'أدوات ظل تتوسع بين الإدارات بدون علم الإدارة أو تقييم.',
    control: 'سجل مركزي لكل حالة: النظام المستخدم، البيانات، المستخدمون المتأثرون، والحالة (تجريبي أو إنتاج).',
    owner: 'مدير التحول الرقمي + ملاك الأعمال',
    evidence: 'سجل الاستخدامات المعتمد مع تاريخ آخر مراجعة',
    capability: { slug: 'ai-use-case-discovery', label: 'AI Use-Case Discovery' },
    reference: 'SDAIA-P145 (توافق عام: تحديد المخاطر)',
  },
  {
    id: 'ownership',
