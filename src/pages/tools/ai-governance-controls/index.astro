    control: 'طبقة فحص على المسارات المهيأة تقرر: سماح، تنقيح، حجب، أو تصعيد حسب السياسة.',
    owner: 'مدير الأمن السيبراني',
    evidence: 'سجل قرارات الفحص + عينات المحتوى المحجوب',
    capability: { slug: 'ai-firewall', label: 'AI Firewall' },
    reference: 'NCA ECC (حيث ينطبق: ضوابط الأمن السيبراني)',
  },
  {
    id: 'logging',
    group: 'assure',
    area: 'التسجيل',
    objective: 'كل تفاعل مهم قابل لإعادة البناء لاحقًا: من طلب، وماذا قرر النظام، ومن اعتمد.',
