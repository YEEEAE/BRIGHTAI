---
import ArabicLayout from '../../../layouts/ArabicLayout.astro';

const canonical = 'https://brightai.live/tools/ai-governance-controls/';

type Group = 'gov' | 'protect' | 'assure' | 'respond';

interface Control {
  id: string;
  group: Group;
  area: string;
  objective: string;
  risk: string;
  control: string;
  owner: string;
  evidence: string;
  capability: { slug: string; label: string };
  reference: string;
}

const groups: Array<{ key: Group | 'all'; label: string; hint: string }> = [
  { key: 'all', label: 'كل الضوابط', hint: '13 مجالًا' },
  { key: 'gov', label: 'أساس الحوكمة', hint: 'المخزون والملكية والتصنيف' },
  { key: 'protect', label: 'الحماية والتشغيل', hint: 'البيانات والموافقات والفحص' },
  { key: 'assure', label: 'الإثبات والمراقبة', hint: 'التسجيل والأدلة والمتابعة' },
  { key: 'respond', label: 'الأطراف والاستجابة', hint: 'الموردون والحوادث والسياسات' },
];

const groupLabel: Record<Group, string> = {
  gov: 'أساس الحوكمة',
  protect: 'الحماية والتشغيل',
  assure: 'الإثبات والمراقبة',
  respond: 'الأطراف والاستجابة',
};

const controls: Control[] = [
  {
    id: 'inventory',
