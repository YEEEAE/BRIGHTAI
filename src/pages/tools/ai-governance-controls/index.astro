    objective: 'كل حالة استخدام لها مالك مساءلة واضح يعرف دوره وقت القرار والحادثة.',
    risk: 'قرارات AI بلا مسؤول محدد عند الخطأ أو الاعتراض.',
    control: 'مالك أعمال ومالك مخاطر مسجل لكل حالة، مع صلاحيات اعتماد موثقة.',
    owner: 'الرئيس التنفيذي للبيانات / مدير المخاطر',
    evidence: 'مصفوفة المسؤوليات + سجل الاعتمادات',
    capability: { slug: 'ai-governance-platform', label: 'AI Governance Platform' },
    reference: 'SDAIA-P145 (توافق عام: الحوكمة والمساءلة)',
  },
  {
    id: 'risk-classification',
    group: 'gov',
    area: 'تصنيف المخاطر',
    objective: 'تصنيف كل حالة حسب أثرها قبل التوسع، عشان الجهد يروح للأعلى خطرًا.',
    risk: 'معاملة الحالات عالية الأثر (توظيف، قرارات مالية) مثل التجارب منخفضة الخطر.',
    control: 'تصنيف منخفض / متوسط / عالٍ بمعيار احتمالية × أثر معتمد داخليًا ومبرر مكتوب.',
    owner: 'مدير المخاطر',
    evidence: 'بطاقة تصنيف لكل حالة + مبرر الدرجة',
    capability: { slug: 'ai-risk-classification', label: 'AI Risk Classification' },
    reference: 'SDAIA-P145 (توافق عام: تقييم المخاطر)',
  },
  {
    id: 'approved-use',
    group: 'gov',
    area: 'الاستخدام المعتمد',
    objective: 'ما يشتغل إلا الاستخدام المعتمد، وللغرض المعتمد فقط.',
    risk: 'توسع الاستخدام خارج النطاق المعتمد أو لأغراض لم تُقيَّم.',
    control: 'قائمة استخدامات مسموحة، وربط كل حالة بسياسة مكتوبة قبل الإطلاق.',
    owner: 'مدير الامتثال + مالك العمل',
    evidence: 'سجل الموافقات + ربط السياسة بالضابط',
    capability: { slug: 'policy-to-control-mapping', label: 'Policy-to-Control Mapping' },
