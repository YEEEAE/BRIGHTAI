    control: 'تسجيل الطلب ونسخة السياسة والقرار والموافقة بطابع زمني وحماية من العبث.',
    owner: 'مدير التقنية + مدير الأمن',
    evidence: 'سجلات محمية من الحذف بفترة احتفاظ معلنة',
    capability: { slug: 'ai-audit-trail', label: 'AI Audit Trail' },
    reference: 'NCA ECC (حيث ينطبق: التسجيل والمراقبة)',
  },
  {
    id: 'audit-evidence',
    group: 'assure',
    area: 'أدلة التدقيق',
    objective: 'الدليل جاهز للمراجعة الداخلية أو الخارجية بدون تجميع يدوي وقت التدقيق.',
    risk: 'أدلة مبعثرة تضيع وقت المراجعة وتضعف الثقة بنتائجها.',
    control: 'ملف دليل لكل حالة عالية الأثر يجمع: السياسة، القرارات، الموافقات، وتقارير المراجعة.',
    owner: 'مدير الامتثال / التدقيق الداخلي',
    evidence: 'ملف الدليل المعتمد لكل حالة عالية الأثر',
    capability: { slug: 'ai-evidence-file', label: 'AI Evidence File' },
    reference: 'ISO/IEC 42001 (توافق عام: التوثيق)',
  },
  {
    id: 'monitoring',
    group: 'assure',
    area: 'المراقبة المستمرة',
    objective: 'انحراف الأداء أو السلوك ينكشف مبكرًا قبل ما يكبر أثره.',
    risk: 'تدهور صامت في الدقة أو ازدياد في البلاغات بدون تنبه.',
    control: 'مؤشرات دورية (معدل التعديل البشري، بلاغات العملاء، الاعتراضات) مع عتبات تنبيه ومراجعة مجدولة.',
    owner: 'مالك العمل + مدير المخاطر',
    evidence: 'تقارير المراقبة الدورية + سجل التنبيهات والإجراءات',
    capability: { slug: 'continuous-ai-governance', label: 'Continuous AI Governance' },
    reference: 'SDAIA-P145 (توافق عام: المراقبة المستمرة)',
  },
  {
    id: 'third-party',
    group: 'respond',
    area: 'ذكاء اصطناعي الطرف الثالث',
    objective: 'أدوات وموردو AI الخارجيون يخضعون لنفس الانضباط قبل الاعتماد وبعده.',
    risk: 'بيانات تخرج لمورد خارجي بدون تقييم أمني أو التزام تعاقدي.',
    control: 'تقييم المورد قبل الاعتماد، بنود حماية بيانات في العقد، ومراجعة دورية للصلاحيات.',
    owner: 'مدير المشتريات + مدير الأمن',
    evidence: 'سجل تقييم الموردين + العقود + مراجعات الصلاحيات',
    capability: { slug: 'ai-governance-platform', label: 'AI Governance Platform' },
    reference: 'مسودة NCA للأمن السيبراني لـAI (توافق عام: نطاق الطرف الثالث — مسودة غير ملزمة)',
  },
  {
    id: 'incident-handling',
    group: 'respond',
    area: 'معالجة الحوادث',
    objective: 'حادثة AI لها مسار استجابة واضح: احتواء، تحقيق، تصحيح، وإغلاق موثق.',
    risk: 'حوادث تُعالج شفهيًا وتتكرر بدون درس موثق أو إجراء تصحيحي.',
    control: 'تصنيف الحادثة، احتواء فوري، تحقيق من السجلات، إجراء تصحيحي، وإغلاق باعتماد.',
    owner: 'مدير الأمن + مالك العمل',
    evidence: 'سجل الحوادث + تقارير التحقيق + الإجراءات التصحيحية',
    capability: { slug: 'ai-audit-trail', label: 'AI Audit Trail' },
    reference: 'NCA ECC (حيث ينطبق: الاستجابة للحوادث)',
  },
  {
    id: 'policy-updates',
    group: 'respond',
    area: 'تحديث السياسات',
    objective: 'السياسة تعيش مع الواقع: تتحدث مع كل درس وتغيير تقني جوهري.',
    risk: 'سياسة مجمدة تتخلف عن الممارسة التشغيلية الفعلية.',
    control: 'مراجعة مجدولة للسياسات بعد الحوادث والتغييرات الجوهرية، مع توثيق النسخ وأسباب التعديل.',
    owner: 'مدير الامتثال + لجنة الحوكمة',
    evidence: 'سجل نسخ السياسات + محاضر المراجعة',
    capability: { slug: 'policy-to-control-mapping', label: 'Policy-to-Control Mapping' },
    reference: 'ISO/IEC 42001 (توافق عام: التحسين المستمر)',
  },
];

const faqs = [
  {
    question: 'وش مصفوفة ضوابط حوكمة الذكاء الاصطناعي؟',
    answer: 'جدول عملي يربط كل مجال من مجالات حوكمة AI — المخزون، الملكية، التصنيف، البيانات، الموافقات، التسجيل، الأدلة، المراقبة، الموردين، الحوادث، والسياسات — بالهدف منه، والخطر الذي يعالجه، ومثال الضابط، والمالك، والدليل المطلوب. تُعرف بالإنجليزية باسم AI governance controls أو Saudi AI governance control matrix.',
  },
  {
    question: 'هل المصفوفة التزام نظامي أو اعتماد رسمي من جهة حكومية؟',
    answer: 'لا. هذه مصفوفة تنفيذية عملية من BrightAI تساعد المنشآت السعودية على تنظيم ضوابطها داخليًا، وليست نصًا نظاميًا ولا شهادة امتثال ولا اعتمادًا من سدايا أو NCA أو أي جهة. المراجع المذكورة إشارات توافق عام فقط، وأي التزام نظامي يرجع لمصدره الرسمي ولمستشاركم القانوني.',
  },
  {
    question: 'كيف أطبق المصفوفة داخل منشأتي؟',
    answer: 'ابدأوا من الأعلى: احصروا الاستخدامات في سجل واحد، عيّنوا مالكًا لكل حالة، صنّفوا المخاطر، ثم فعّلوا ضوابط الحماية والموافقات على الحالات عالية الأثر أولًا. اجمعوا الدليل أولًا بأول بدل تجميعه وقت التدقيق، وراجعوا المصفوفة دوريًا. قالب سجل المخاطر المرافق يساعدكم تبدأون من أول صف.',
  },
  {
    question: 'وش الدليل (evidence) اللي أجمعه لكل ضابط؟',
    answer: 'عمود الدليل في كل صف يعطي مثالًا محددًا: اسم السجل أو المستند أو التقرير وتاريخه. القاعدة الذهبية: لا تترك خانة الدليل عامة — اكتب اسم المستند الفعلي أو السجل أو الرابط الداخلي الذي يثبت أن الضابط اشتغل فعلًا، لأن المراجع يسأل عن الإثبات لا عن النية.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'مصفوفة ضوابط حوكمة الذكاء الاصطناعي للمنشآت السعودية',
  description:
    'مصفوفة تنفيذية عملية من BrightAI تربط 13 مجالًا لضوابط حوكمة AI بالهدف والخطر والمالك والدليل — Saudi AI governance control matrix.',
  url: canonical,
  inLanguage: 'ar-SA',
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

// Client-side payload (CSV export + filtering) — flattened plain-text values so
// the export module never scrapes rendered markup. Files are built locally in
// the browser; nothing leaves the device.
const exportData = {
  note: 'مصفوفة تنفيذية عملية من BrightAI — ليست نصًا نظاميًا ولا شهادة امتثال ولا اعتمادًا رسميًا.',
  groups: groups.filter((g) => g.key !== 'all').map((g) => ({ key: g.key, label: g.label })),
  records: controls.map((c) => ({
    group: groupLabel[c.group],
    area: c.area,
    objective: c.objective,
    risk: c.risk,
    control: c.control,
    owner: c.owner,
    evidence: c.evidence,
    capability: c.capability.label,
    reference: c.reference,
  })),
};

const columns = ['المجموعة', 'مجال الضابط', 'الهدف', 'الخطر المعالج', 'مثال الضابط', 'المالك', 'الدليل المنتج', 'قدرة BrightAI المرتبطة', 'مرجع استرشادي'];
---

<ArabicLayout
  title="مصفوفة ضوابط حوكمة الذكاء الاصطناعي للمنشآت السعودية | BrightAI"
  description="مصفوفة عملية من BrightAI تربط 13 مجالًا لضوابط حوكمة AI بالهدف والخطر والمالك والدليل — Saudi AI governance control matrix للمنشآت السعودية، قابلة للطباعة والتحميل."
  canonical={canonical}
  hreflang={[{ lang: 'ar-SA', href: canonical }, { lang: 'x-default', href: canonical }]}
  jsonLd={[jsonLd, faqJsonLd] as any}
  currentPath="/tools/ai-governance-controls/"
  extraSpeakableSelectors={['.govmx-lede', '.govmx-answer-first']}
  breadcrumbs={[{ name: 'أدوات AI', href: '/tools/ai-governance-controls/' }, { name: 'مصفوفة ضوابط الحوكمة', href: '/tools/ai-governance-controls/' }]}
>
  <main class="govmx">
    <header class="govmx-hero">
      <div>
        <p class="govmx-kicker">أداة مرجعية · للمنشآت السعودية</p>
        <h1>مصفوفة ضوابط حوكمة الذكاء الاصطناعي</h1>
        <p class="govmx-lede govmx-answer-first">مصفوفة ضوابط حوكمة الذكاء الاصطناعي (AI governance controls) هي جدول عملي يربط 13 مجالًا تشغيليًا — من مخزون AI والملكية حتى الحوادث والسياسات — بالهدف والخطر والضابط والمالك والدليل. صممناها للمنشآت السعودية كمرجع تنفيذي واحد يتحول من سياسة ورقية إلى ضوابط قابلة للمراجعة.</p>
        <p class="govmx-en" lang="en" dir="ltr">Known in English as “AI governance controls” and “Saudi AI governance control matrix” — ضوابط حوكمة الذكاء الاصطناعي ومصفوفة الضوابط السعودية.</p>
        <div class="govmx-actions">
          <a class="govmx-button govmx-button--primary" href="#matrix">استعرض المصفوفة <span aria-hidden="true">↓</span></a>
          <a class="govmx-button govmx-button--quiet" href="#how-to-use">طريقة الاستخدام</a>
        </div>
      </div>
      <aside class="govmx-hero__stamp" aria-label="حجم المصفوفة"><span class="stamp-number">13</span><span>مجال ضابط</span><small>8 أعمدة لكل مجال</small></aside>
    </header>

    <section id="how-to-use" class="govmx-intro" aria-labelledby="how-to-use-title">
      <div>
        <p class="govmx-label">قبل ما تبدأ</p>
        <h2 id="how-to-use-title">كيف تستخدم المصفوفة؟</h2>
        <p>امشِ مع الصفوف من الأعلى للأسفل: ابدأ بأساس الحوكمة (المخزون والملكية والتصنيف)، ثم فعّل ضوابط الحماية على الحالات عالية الأثر أولًا، ثم اضمن الإثبات والمراقبة، وأخيرًا اضبط الأطراف والاستجابة. لكل صف عيّن مالكًا واجمع الدليل أولًا بأول — المراجع يسأل عن الإثبات لا عن النية.</p>
      </div>
      <ol class="govmx-steps">
        <li><b>01</b><span><strong>احصر</strong> الاستخدامات وملاكها وصنّف مخاطرها.</span></li>
        <li><b>02</b><span><strong>احمِ</strong> البيانات واشترط الموافقة البشرية للمؤثر.</span></li>
        <li><b>03</b><span><strong>سجّل</strong> كل قرار وجهّز ملف الدليل للمراجعة.</span></li>
        <li><b>04</b><span><strong>راجع</strong> الموردين والحوادث والسياسات دوريًا.</span></li>
      </ol>
    </section>

    <section class="govmx-notice" aria-label="طبيعة المصفوفة وحدودها">
      <span class="govmx-notice__icon" aria-hidden="true">!</span>
      <p><strong>مهم:</strong> هذه <strong>مصفوفة تنفيذية عملية من BrightAI</strong> — تساعدكم تنظمون ضوابطكم داخليًا، وهي <strong>ليست نصًا نظاميًا ولا شهادة امتثال ولا اعتمادًا رسميًا</strong> من سدايا أو NCA أو أي جهة حكومية. لا ننقل نصوص الأنظمة ولا ندعي تأييدًا رسميًا؛ أي التزام نظامي يرجع لمصدره الرسمي ولمستشاركم القانوني.</p>
    </section>

    <section class="govmx-links" aria-label="روابط مرتبطة">
      <a href="/tools/ai-risk-register/"><span>01</span><strong>سجل مخاطر AI</strong><small>ابدأ من أول صف: احصر استخداماتك</small><b aria-hidden="true">←</b></a>
