---
/**
 * Webinar Page — /events/webinar/
 * Monthly Arabic AI-governance webinar registration.
 */
import ArabicLayout from '../../../layouts/ArabicLayout.astro';
import BackgroundGrid from '../../../components/BackgroundGrid.astro';
import LeadForm from '../../../components/LeadForm.astro';

const agenda = [
  { t: '٣٠ دقيقة', title: 'من النظرية للتنفيذ', body: 'كيف تبني حوكمة AI قابلة للتدقيق في ٩٠ يوم.' },
  { t: '٢٠ دقيقة', title: 'demo حي', body: 'جولة في AI Firewall + سجل التدقيق.' },
  { t: '١٠ دقائق', title: 'أسئلة مباشرة', body: 'إجابة على أسئلة الحضور.' },
];

/**
 * BAI-SEO-003-S3 (2026-07-18): the previous Event node lacked `startDate`
 * and a real `location` (required for Google Event rich-results eligibility).
 * Fabricated dates would violate Google spam policies. The page now
 * intentionally emits NO Event node — Organization, BreadcrumbList, and
 * WebPage are emitted by FoundationSchema. When a confirmed start date +
 * platform are set, re-add Event via getEventLd() from schema-helpers.
 */
const jsonLd = null;
---

<ArabicLayout
  title="ويبنار حوكمة الذكاء الاصطناعي | BrightAI"
   description="ويبنار شهري عن حوكمة الذكاء الاصطناعي والامتثال لـ PDPL وضوابط NCA ECC وسدايا. تسجيل مجاني لمؤسسات السعودية. احجز مقعدك وتعلّم من خبراء الحوكمة."
  canonical="https://brightai.live/events/webinar/"
  hreflang={[{ lang: 'ar-SA', href: 'https://brightai.live/events/webinar/' }, { lang: 'x-default', href: 'https://brightai.live/events/webinar/' }]}
  jsonLd={jsonLd as any}
  currentPath="/events/webinar/"
  breadcrumbs={[{ name: 'الفعاليات', href: '/events/' }, { name: 'الويبنار', href: '/events/webinar/' }]}
>

  <section class="page-hero" aria-label="الويبنار">
    <BackgroundGrid />
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="inner-hero__badge">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-video"></use></svg>
        مجاني — بالعربية
      </div>
      <h1 class="page-hero__title"><span class="gradient-text">ويبنار شهري</span> حوكمة AI</h1>
      <p class="page-hero__description">كل شهر نستضيف جلسة حية عن حوكمة الذكاء الاصطناعي في السعودية: من النظرية للتنفيذ، مع demo حي وأسئلة مباشرة. التسجيل مجاني. تابع أيضاً <a href="/events/ai-governance-day/">يوم حوكمة AI الرياض</a> واشترك في <a href="/newsletter/">النشرة الأسبوعية</a> لمتابعة كل جديد.</p>
    </div>
  </section>

  <section class="inner-section" aria-labelledby="wb-agenda">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="wb-agenda" class="inner-section__title">أجندة الويبنار</h2>
      <div class="grid grid--3">
        {
          agenda.map((a) => (
            <article class="card card--feature">
              <span class="assessment-tag">{a.t}</span>
              <h3 class="inner-card__title mt-3">{a.title}</h3>
              <p class="inner-card__text">{a.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="inner-section inner-section--alt" aria-labelledby="wb-form">
    <div class="max-w-3xl mx-auto px-5 lg:px-8">
      <h2 id="wb-form" class="inner-section__title inner-section__title--centered">سجّل مجاناً</h2>
      <p class="inner-section__lead inner-section__lead--centered">نرسل لك الرابط قبل الموعد بيوم.</p>
      <div class="contact-form-card contact-form-card--padded">
        <LeadForm
          formId="webinar-registration"
          title="تسجيل الويبنار"
          intro="عبّي بياناتك ونرسل لك التفاصيل."
          subject="تسجيل ويبنار BrightAI"
          ctaLabel="سجّلني"
          source="website"
          medium="webinar"
          campaign="monthly-webinar"
          fields={[
            { name: 'name', label: 'الاسم الكامل', required: true, autocomplete: 'name' },
            { name: 'email', label: 'البريد الإلكتروني', type: 'email', required: true, autocomplete: 'email' },
            { name: 'company', label: 'الشركة', autocomplete: 'organization' },
            { name: 'role', label: 'دورك', type: 'select', options: ['امتثال', 'أمن معلومات', 'تحول رقمي', 'إدارة', 'غيره'] },
          ]}
        />
      </div>
    </div>
  </section>
</ArabicLayout>

<style>
  .assessment-tag { font-size: var(--text-xs); padding: var(--space-0-5) var(--space-2-5); border-radius: var(--radius-lg); background: rgba(0,212,255,0.08); border: 1px solid rgba(0,212,255,0.25); color: var(--assessment-tag-color); display: inline-block; }
  .mt-3 { margin-block-start: var(--space-3); }
  .contact-form-card { background: var(--bg-surface); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius-lg); padding: var(--space-6); }
</style>
