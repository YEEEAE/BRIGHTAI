---
/**
 * Webinar — /events/webinar/
 */
import ArabicLayout from '../../../layouts/ArabicLayout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import { FORM_TAXONOMY, DEFAULT_CONTACT_FIELDS } from '../../../data/marketing';

const webinarPoints = [
  { title: 'كشف واستبعاد Shadow AI', desc: 'كيف تحدد كافة أدوات ونماذج الذكاء الاصطناعي التي يستخدمها الموظفون دون علم إدارة تقنية المعلومات.' },
  { title: 'الامتثال العملي لنظام PDPL', desc: 'خطوات تطبيق التعمية التلقائية على الهويات الوطنية، والآيبان، والبيانات الصحية قبل وصولها للنماذج.' },
  { title: 'جاهزية تدقيق سدايا وNCA', desc: 'كيف تبني ملف أدلة مشفر بختم زمني يثبت الامتثال للجهات الرقابية في أقل من 3 أسابيع.' },
];

const webinarFaq = [
  {
    question: 'هل الويبنار مجاني ومتاح لعموم المهتمين في السعودية؟',
    answer: 'نعم، الويبنار مجاني بالكامل ويستهدف القيادات التقنية ومسؤولي الامتثال ومطوري الذكاء الاصطناعي في المملكة العربية السعودية.',
  },
  {
    question: 'هل يتوفر تسجيل للويبنار بعد انتهائه؟',
    answer: 'نعم، يتم إرسال رابط التسجيل الكامل والعرض التقديمي وحقيبة السياسات التنفيذية لكافة المسجلين عبر البريد الإلكتروني.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'ويبنار حوكمة الذكاء الاصطناعي في السعودية | BrightAI',
      description: 'ويبنار عملي مباشر يشرح كيفية حوكمة أدوات الذكاء الاصطناعي في منشأتك وتجنب عقوبات نظام حماية البيانات الشخصية PDPL.',
      url: 'https://brightai.live/events/webinar/',
      inLanguage: 'ar-SA',
    },
    {
      '@type': 'FAQPage',
      mainEntity: webinarFaq.map(item => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<ArabicLayout
  title="ويبنار حوكمة الذكاء الاصطناعي | BrightAI"
  description="سجل في ويبنار حوكمة الذكاء الاصطناعي: دليلك العملي للامتثال لنظام PDPL وضوابط NCA ECC وبناء جدار حماية AI في المنشآت السعودية."
  canonical="https://brightai.live/events/webinar/"
  hreflang={[{ lang: 'ar-SA', href: 'https://brightai.live/events/webinar/' }, { lang: 'x-default', href: 'https://brightai.live/events/webinar/' }]}
  jsonLd={jsonLd as any}
  currentPath="/events/webinar/"
  breadcrumbs={[{ name: 'الفعاليات', href: '/events/' }, { name: 'الويبنار', href: '/events/webinar/' }]}
>
  <section class="page-hero" aria-label="ويبنار حوكمة AI">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="inner-hero__badge">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-video"></use></svg>
        ويبنار تفاعلي عبر الإنترنت
      </div>
      <h1 class="page-hero__title"><span class="gradient-text">ويبنار حوكمة الذكاء الاصطناعي</span> للمنشآت السعودية</h1>
      <p class="page-hero__description">دليل عملي وتطبيقي مباشر يشرح لمسؤولي التقنية والأمن السيبراني كيفية إدارة مخاطر الذكاء الاصطناعي، منع تسرب البيانات الحساسة، وتحقيق الامتثال التام لنظام حماية البيانات الشخصية (PDPL) وضوابط سدايا.</p>
    </div>
  </section>

  <!-- محاور الويبنار -->
  <section class="inner-section" aria-labelledby="webinar-points-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="webinar-points-heading" class="inner-section__title">محاور الجلسة التدريبية</h2>
      <p class="inner-section__lead">نقاط مركزة تجيب عن التحديات التشغيلية الفعلية التي تواجه الشركات السعودية.</p>
      <div class="grid grid--3">
        {
          webinarPoints.map(p => (
            <article class="card card--feature">
              <h3 class="inner-card__title" style="margin-bottom: var(--space-2);">{p.title}</h3>
              <p class="inner-card__text">{p.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- تفاصيل حوكمة البيانات في الويبنار -->
  <section class="inner-section inner-section--alt" aria-label="ما ستتعلمه في الويبنار">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="card card--feature" style="padding: var(--space-6);">
        <h2 style="font-size: var(--text-2xl); color: var(--text-primary); margin-bottom: var(--space-3);">مخرجات عملية قابلة للتطبيق الفوري</h2>
        <p style="color: var(--text-secondary); line-height: var(--leading-relaxed); font-size: var(--text-base); margin-bottom: var(--space-4);">
          يهدف الويبنار إلى تزويد الحضور بأدوات عملية وليس مجرد تنظير أكاديمي. ستحصل خلال الجلسة على:
        </p>
        <ul style="color: var(--text-secondary); line-height: 1.8; padding-inline-start: 1.5rem;">
          <li><strong>قالب مصفوفة تصنيف مخاطر الذكاء الاصطناعي:</strong> متوافق مع معايير سدايا ونظام PDPL.</li>
          <li><strong>دليل نشر AI Firewall:</strong> إعداد القواعد البرمجية لحجب الهويات الوطنية والآيبان.</li>
          <li><strong>قائمة تدقيق الجاهزية (Checklist):</strong> 10 خطوات للتحقق من امتثال أي أداة ذكاء اصطناعي قبل اعتمادها رسمياً.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- أسئلة شائعة -->
  <section class="inner-section" aria-labelledby="webinar-faq-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div style="max-width: 48rem; margin: 0 auto var(--space-6); text-align: center;">
        <h2 id="webinar-faq-title" style="font-size: var(--text-2xl); font-weight: var(--font-bold); color: var(--text-primary); margin-bottom: var(--space-2);">الأسئلة الشائعة حول الويبنار</h2>
      </div>
      <div style="display: flex; flex-direction: column; gap: var(--space-3); max-width: 52rem; margin: 0 auto;">
        {
          webinarFaq.map(item => (
            <details class="card card--feature" style="padding: var(--space-4); cursor: pointer;">
              <summary style="font-weight: var(--font-bold); color: var(--text-primary); list-style: none; display: flex; justify-content: space-between; align-items: center;">
                <span>{item.question}</span>
                <span style="color: var(--brand); font-size: 1.25rem;">+</span>
              </summary>
              <div style="margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--border-subtle); color: var(--text-secondary); line-height: var(--leading-relaxed); font-size: var(--text-sm);">
                {item.answer}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- التسجيل في الويبنار -->
  <section class="inner-section inner-section--alt" aria-labelledby="webinar-reg-title">
    <div class="max-w-3xl mx-auto px-5 lg:px-8">
      <h2 id="webinar-reg-title" class="inner-section__title text-center">سجل حضورك في الويبنار القادم</h2>
      <p class="inner-section__lead text-center">احصل على رابط البث المباشر وحقيبة الأدوات التنفيذية فور التسجيل.</p>
      <LeadForm
        formId={FORM_TAXONOMY.EVENT_WEBINAR}
        title="سجل حضورك في الويبنار القادم"
        intro="احصل على رابط البث المباشر وحقيبة الأدوات التنفيذية فور التسجيل."
        subject="تسجيل في ويبنار حوكمة الذكاء الاصطناعي"
        ctaLabel="تأكيد التسجيل المجاني"
        source="events"
        medium="webinar"
        campaign="webinar-series"
        fields={DEFAULT_CONTACT_FIELDS}
      />
    </div>
  </section>
</ArabicLayout>
