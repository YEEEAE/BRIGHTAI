---
/**
 * LEAP 2026 — /events/leap-2026/
 * Booth + speaking at LEAP Riyadh.
 */
import ArabicLayout from '../../../layouts/ArabicLayout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import { FORM_TAXONOMY, DEFAULT_CONTACT_FIELDS } from '../../../data/marketing';

const highlights = [
  { icon: 'mdi-podium', title: 'جلسة رئيسية تنفيذية', body: 'يزيد البديوي يشارك في الجلسة العامة حول: "حوكمة الذكاء الاصطناعي في السعودية: من النظرية للتنفيذ".' },
  { icon: 'mdi-store', title: 'جناح تجريبي تفاعلي', body: 'تجربة حية لجدار حماية AI Firewall وسجل التدقيق المشفر وكشف اختراقات النماذج اللغوية.' },
  { icon: 'mdi-gift', title: 'استشارات وجاهزية فورية', body: 'جلسات استشارية فردية مجانية وتحليل فجوات الامتثال لنظام PDPL وضوابط سدايا لزوار الجناح.' },
];

const leapFaq = [
  {
    question: 'أين يقع جناح BrightAI في مؤتمر LEAP 2026؟',
    answer: 'يتواجد جناح BrightAI في منطقة الابتكار والذكاء الاصطناعي في مركز الرياض للمعارض والمؤتمرات (ملهم)، حيث يقدم الفريق عروضاً تفاعلية حية على مدار أيام المؤتمر.',
  },
  {
    question: 'ما هي الحلول التي سيتم استعراضها بشكل حي في الجناح؟',
    answer: 'سيتم استعراض منصة BrightAI Kernel المتكاملة: جدار حماية الذكاء الاصطناعي (AI Firewall)، واختبارات الفريق الأحمر (Red Teaming)، وسجل التدقيق غير القابل للتعديل، وآليات الرقابة والموافقة البشرية.',
  },
  {
    question: 'كيف يمكن للمنشآت حجز جلسة استشارية خاصة أثناء المؤتمر؟',
    answer: 'يمكنك تعبئة النموذج أسفل الصفحة لتحديد موعد مسبق مع خبرائنا ومؤسس المنصة لمناقشة متطلبات منشأتك واستكشاف فرص التعاون والامتثال.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'BrightAI في مؤتمر LEAP 2026 الرياض | حوكمة الذكاء الاصطناعي',
      description: 'تعرف على مشاركة BrightAI في مؤتمر LEAP الرياض 2026: عروض حية لجدار حماية AI وجلسة عن الامتثال السعودي لـ PDPL وNCA.',
      url: 'https://brightai.live/events/leap-2026/',
      inLanguage: 'ar-SA',
    },
    {
      '@type': 'FAQPage',
      mainEntity: leapFaq.map(item => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<ArabicLayout
  title="BrightAI في LEAP 2026 الرياض | حوكمة الذكاء الاصطناعي"
  description="زور جناح BrightAI في مؤتمر LEAP 2026 بالرياض: demo حي لجدار حماية AI وجلسة حوكمة الذكاء الاصطناعي في السعودية والامتثال لـ PDPL وNCA."
  canonical="https://brightai.live/events/leap-2026/"
  hreflang={[{ lang: 'ar-SA', href: 'https://brightai.live/events/leap-2026/' }, { lang: 'x-default', href: 'https://brightai.live/events/leap-2026/' }]}
  jsonLd={jsonLd as any}
  currentPath="/events/leap-2026/"
  breadcrumbs={[{ name: 'الفعاليات', href: '/events/' }, { name: 'LEAP 2026', href: '/events/leap-2026/' }]}
>
  <section class="page-hero" aria-label="LEAP 2026">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="inner-hero__badge">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-rocket-launch"></use></svg>
        جناح BrightAI — LEAP الرياض 2026
      </div>
      <h1 class="page-hero__title"><span class="gradient-text">BrightAI في LEAP</span> 2026 بالرياض</h1>
      <p class="page-hero__description">انضم إلينا في أكبر حدث تقني عالمي يقام في المملكة العربية السعودية. استكشف كيف تمكّن BRIGHTAI كبرى الشركات والجهات الحكومية من بناء حوكمة سيادية متينة للذكاء الاصطناعي تضمن الامتثال لضوابط سدايا وNCA ونظام حماية البيانات الشخصية.</p>
    </div>
  </section>

  <!-- ماذا يقدم الجناح -->
  <section class="inner-section" aria-labelledby="leap-high">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="leap-high" class="inner-section__title">ماذا ستشاهد في جناح BrightAI؟</h2>
      <p class="inner-section__lead">عروض تقنية وتطبيقية مصممة خصيصاً لقيادات التقنية، مسؤولي الأمن السيبراني، ومدراء الامتثال وحماية البيانات.</p>
      <div class="grid grid--3">
        {
          highlights.map((h) => (
            <article class="card card--feature">
              <div class="avatar-tile avatar-tile--sm avatar-tile--gradient" aria-hidden="true">
                <svg class="avatar-tile__icon avatar-tile__icon--white" aria-hidden="true" width="1.5rem" height="1.5rem"><use href={`/icons.svg#${h.icon}`} /></svg>
              </div>
              <h3 class="inner-card__title mt-3">{h.title}</h3>
              <p class="inner-card__text">{h.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- تفاصيل الجلسة الرئيسية ومحاور المؤتمر -->
  <section class="inner-section inner-section--alt" aria-label="محاور الجلسة الرئيسية">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="card card--feature" style="padding: var(--space-6);">
        <h2 style="font-size: var(--text-2xl); color: var(--text-primary); margin-bottom: var(--space-3);">الجلسة الرئيسية: حوكمة الذكاء الاصطناعي في السعودية</h2>
        <p style="color: var(--text-secondary); line-height: var(--leading-relaxed); font-size: var(--text-base); margin-bottom: var(--space-4);">
          يستعرض الرئيس التنفيذي لـ BRIGHTAI في كلمته الرئيسية التحول الاستراتيجي الذي تعيشه المملكة نحو اقتصاد الذكاء الاصطناعي، وكيفية التغلب على التحديات التي تواجه <strong>شركات الذكاء الاصطناعي في السعودية</strong> والمؤسسات الراغبة في التوسع.
        </p>
        <div class="grid grid--3" style="gap: var(--space-4);">
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <strong style="color: var(--text-primary); display: block; margin-bottom: var(--space-2);">الانتقال من السياسة إلى الكود</strong>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">تحويل لوائح الامتثال المكتوبة إلى فلاتر برمجية تعمل في أجزاء من الثانية (Sub-millisecond Guardrails).</p>
          </div>
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <strong style="color: var(--text-primary); display: block; margin-bottom: var(--space-2);">منع تسرب الهويات والآيبان</strong>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">استراتيجيات فحص وتعصيب PII لحماية قواعد البيانات الحساسة وفق نظام حماية البيانات الشخصية PDPL.</p>
          </div>
          <div style="background: var(--bg-surface-raised); padding: var(--space-4); border-radius: var(--radius-md);">
            <strong style="color: var(--text-primary); display: block; margin-bottom: var(--space-2);">التدقيق السيادي ومسار 2030</strong>
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin: 0;">بناء ثقافة الثقة الرقمية لتسريع اعتماد حلول الذكاء الاصطناعي في الجهات الحكومية والخاصة.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- أسئلة شائعة لزوار LEAP -->
  <section class="inner-section" aria-labelledby="leap-faq-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div style="max-width: 48rem; margin: 0 auto var(--space-6); text-align: center;">
        <h2 id="leap-faq-heading" style="font-size: var(--text-2xl); font-weight: var(--font-bold); color: var(--text-primary); margin-bottom: var(--space-2);">الأسئلة الشائعة لزوار LEAP 2026</h2>
        <p style="color: var(--text-secondary); font-size: var(--text-base);">كل ما تود معرفته عن تواجد فريق BrightAI في المؤتمر.</p>
      </div>

      <div style="display: flex; flex-direction: column; gap: var(--space-3); max-width: 52rem; margin: 0 auto;">
        {
          leapFaq.map((item) => (
            <details class="card card--feature" style="padding: var(--space-4); cursor: pointer;">
              <summary style="font-weight: var(--font-bold); font-size: var(--text-base); color: var(--text-primary); list-style: none; display: flex; justify-content: space-between; align-items: center;">
                <span>{item.question}</span>
                <span style="color: var(--brand); font-size: 1.25rem;">+</span>
              </summary>
              <div style="margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--border-subtle); color: var(--text-secondary); line-height: var(--leading-relaxed); font-size: var(--text-sm);">
                {item.answer}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- نموذج حجز موعد -->
  <section class="inner-section inner-section--alt" aria-labelledby="leap-form-heading">
    <div class="max-w-3xl mx-auto px-5 lg:px-8">
      <h2 id="leap-form-heading" class="inner-section__title text-center">احجز موعداً خاصاً مع فريقنا في LEAP</h2>
      <p class="inner-section__lead text-center">التق بفريق الخبراء وتعرف على حلول حوكمة الذكاء الاصطناعي المناسبة لاحتياجات منشأتك.</p>
      <LeadForm
        formId={FORM_TAXONOMY.EVENT_LEAP}
        title="احجز موعداً خاصاً مع فريقنا في LEAP"
        intro="التق بفريق الخبراء وتعرف على حلول حوكمة الذكاء الاصطناعي المناسبة لاحتياجات منشأتك."
        subject="حجز لقاء في جناح LEAP 2026"
        ctaLabel="تأكيد حجز الموعد"
        source="events"
        medium="leap-2026"
        campaign="leap-2026"
        fields={DEFAULT_CONTACT_FIELDS}
      />
    </div>
  </section>
</ArabicLayout>

<style>
  .avatar-tile--gradient {
    background: linear-gradient(135deg, var(--cyan-bright), var(--accent-purple-deep));
  }
  .avatar-tile--gradient .avatar-tile__icon { color: var(--white); }
</style>
