---
/**
 * Events index — /events/
 *
 * Lists every event landing page under /events/. Fixes the broken
 * breadcrumb link on each event page, which pointed to /events/ while
 * no index page existed (seo:gate broken-links).
 *
 * SEO: emits only a page-specific CollectionPage node. Organization and
 * BreadcrumbList come from the foundation Schema.astro (BAI-SEO-003-S3 —
 * do not re-add duplicates).
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import { SITE } from '../../data/site';

const events = [
  {
    href: '/events/ai-governance-day/',
    title: 'AI Governance Day — الرياض',
    icon: 'mdi-calendar-star',
    badge: 'حدث BrightAI الخاص',
    desc: 'يوم كامل عن حوكمة الذكاء الاصطناعي في السعودية: جلسات تقنية، طاولة نقاش مع خبراء القطاع، وورشة تطبيقية تبني فيها سجل تدقيق خلال ٩٠ دقيقة.',
  },
  {
    href: '/events/leap-2026/',
    title: 'BrightAI في LEAP 2026',
    icon: 'mdi-rocket-launch',
    badge: 'مؤتمر LEAP الرياض',
    desc: 'زور جناحنا في أكبر مؤتمر تقني في الشرق الأوسط: demo حي لحوكمة AI مع PDPL وNCA وجلسة عن الامتثال بالسعودية.',
  },
  {
    href: '/events/webinar/',
    title: 'ويبنار شهري — حوكمة AI',
    icon: 'mdi-video',
    badge: 'مجاني — بالعربية',
    desc: 'جلسة حية كل شهر عن حوكمة الذكاء الاصطناعي في السعودية: من النظرية للتنفيذ، مع demo حي وأسئلة مباشرة.',
  },
];

const eventFaq = [
  {
    question: 'من الفئات المستهدفة بحضور فعاليات BrightAI؟',
    answer: 'تستهدف فعالياتنا القيادات التنفيذية التقنية (CTO / CIO)، مدراء ومسؤولي الامتثال (Compliance Officers)، مسؤولي حماية البيانات (DPO)، مهندسي الذكاء الاصطناعي والأمن السيبراني، وفرق التحول الرقمي بالجهات الحكومية والشركات السعودية.',
  },
  {
    question: 'هل توجد ورش عمل وتدريب تطبيقي مباشر خلال الفعاليات؟',
    answer: 'نعم، تتضمن فعالياتنا الحضورية والافتراضية ورش عمل تطبيقية ومختبرات حية لبناء سجلات التدقيق، وتكوين سياسات جدار حماية الذكاء الاصطناعي، ومحاكاة عمليات التدقيق الرقابي وفق متطلبات سدايا والبنك المركزي السعودي.',
  },
  {
    question: 'هل تتوفر تسجيلات ومواد العرض بعد انتهاء الويبنار؟',
    answer: 'نعم، يحصل جميع المسجلين في الويبنار الشهري على رابط التسجيل الكامل، بالإضافة إلى شرائح العرض التقديمي، وقوائم التحقق (Checklists)، ونماذج الأطر التنظيمية القابلة للتنزيل.',
  },
  {
    question: 'هل يمكن لشركتنا طلب ورشة عمل حوكمة خاصة مغلقة؟',
    answer: 'نعم، يقدم فريق الاستشارات في BrightAI ورش عمل تنفيذية مغلقة مخصصة لفرق العمل الداخلية بالبنوك والمستشفيات والجهات الحكومية لمناقشة حالات الاستخدام الخاصة بها وتصميم خارطة طريق امتثال مخصصة.',
  },
];

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'فعاليات BrightAI',
  description: 'فعاليات BrightAI: يوم حوكمة AI الرياض، جناح LEAP 2026، والويبنار الشهري عن حوكمة الذكاء الاصطناعي والامتثال في السعودية.',
  url: `${SITE.url}/events/`,
  inLanguage: 'ar-SA',
  isPartOf: { '@id': 'https://brightai.live/#website' },
  publisher: { '@id': 'https://brightai.live/#organization' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: eventFaq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [collectionLd, faqLd],
};
---

<ArabicLayout
  title="فعاليات BrightAI | لقاءات وويبنارات حوكمة AI"
  description="تعرف على فعاليات BrightAI: يوم حوكمة AI الرياض، جناح LEAP 2026، والويبنار الشهري عن حوكمة الذكاء الاصطناعي والامتثال في السعودية."
  canonical="https://brightai.live/events/"
  hreflang={[{ lang: 'ar-SA', href: 'https://brightai.live/events/' }, { lang: 'x-default', href: 'https://brightai.live/events/' }]}
  jsonLd={jsonLd as any}
  currentPath="/events/"
  breadcrumbs={[{ name: 'الفعاليات', href: '/events/' }]}
>

  <section class="page-hero" aria-label="فعاليات BrightAI">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="inner-hero__badge">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-calendar-star"></use></svg>
        فعاليات BrightAI
      </div>
      <h1 class="page-hero__title"><span class="gradient-text">لقاءات وويبنارات</span> حوكمة AI</h1>
      <p class="page-hero__description">فعاليات تفاعلية وتطبيقية عن حوكمة الذكاء الاصطناعي والامتثال بالسعودية: من ملتقيات النخبة في الرياض وجناحنا في LEAP 2026 إلى الويبنارات الشهرية المتخصصة لمسؤولي التقنية والامتثال.</p>
    </div>
  </section>

  <section class="inner-section" aria-labelledby="events-list">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="events-list" class="inner-section__title">الفعاليات القادمة والمستمرة</h2>
      <div class="grid grid--3">
        {
          events.map((e) => (
            <a href={e.href} class="card card--feature event-card">
              <div class="avatar-tile avatar-tile--sm avatar-tile--gradient" aria-hidden="true">
                <svg class="avatar-tile__icon avatar-tile__icon--white" aria-hidden="true" width="1.5rem" height="1.5rem"><use href={`/icons.svg#${e.icon}`} /></svg>
              </div>
              <span class="assessment-tag">{e.badge}</span>
              <h3 class="inner-card__title mt-3">{e.title}</h3>
              <p class="inner-card__text">{e.desc}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Deep Value Proposition Section -->
  <section class="inner-section" aria-labelledby="why-attend">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="section-box">
        <h2 id="why-attend" class="inner-section__title">لماذا تشارك المنشآت السعودية في فعاليات BrightAI؟</h2>
        <p class="inner-section__lead">
          تمثل فعالياتنا الحصرية منصة تواصل معرفية تجمع بين قيادات الأعمال، وخبراء الأمن السيبراني، ومسؤولي الامتثال، ومهندسي الذكاء الاصطناعي في بيئة حوارية تفاعلية تناقش التحديات العملية والتشغيلية في السوق السعودي.
        </p>

        <div class="grid grid--2 mt-8">
          <div class="card card--feature">
            <h3 class="inner-card__title">عروض حية وتجارب تطبيقية (Live Demos)</h3>
            <p class="inner-card__text">
              شاهد كيف تعمل جدران حماية الذكاء الاصطناعي لحظياً في كشف محاولات حقن الأوامر وتعمية البيانات الشخصية المصرفية والطبية، وتعرف على كيفية توليد سجلات تدقيق متوافقة مع متطلبات الجهات الرقابية خلال دقائق.
            </p>
          </div>
          <div class="card card--feature">
            <h3 class="inner-card__title">رؤى مباشرة من الميدان التشريعي والتنظيمي</h3>
            <p class="inner-card__text">
              استمع مباشرة لتحليلات معمقة حول تحديثات نظام حماية البيانات الشخصية (PDPL)، وتعاميم البنك المركزي السعودي (SAMA)، وضوابط الهيئة الوطنية للأمن السيبراني (NCA)، وكيفية ترجمتها لسياسات برمجية قابلة للإنفاذ التلقائي.
            </p>
          </div>
          <div class="card card--feature">
            <h3 class="inner-card__title">تواصل استراتيجي مع قادة التحول الرقمي</h3>
            <p class="inner-card__text">
              تبادل الخبرات مع نظرائك من كبرى البنوك، والمستشفيات، والشركات الوطنية، والوزارات الحكومية، واطلع على الدروس المستفادة من مشاريع الذكاء الاصطناعي المنفذة فعلياً على أرض الواقع.
            </p>
          </div>
          <div class="card card--feature">
            <h3 class="inner-card__title">أدوات ونماذج عمل جاهزة للتنفيذ الفوري</h3>
            <p class="inner-card__text">
              يحصل المشاركون على حقائب تدريبية متكاملة تشمل قوائم فحص الجاهزية (Readiness Checklists)، ونماذج سياسات استخدام الذكاء الاصطناعي المؤسسية، ومصفوفات تقييم مخاطر النماذج الذكية.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="inner-section" aria-labelledby="events-faq">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="events-faq" class="inner-section__title">الأسئلة الشائعة حول الفعاليات والورش</h2>
      <div class="grid grid--2 mt-6">
        {eventFaq.map((faq) => (
          <div class="card card--feature">
            <h3 class="inner-card__title">{faq.question}</h3>
            <p class="inner-card__text">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="content-cta-final" aria-labelledby="events-cta">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="card card--cta text-center">
        <h2 id="events-cta">ترغب في استضافة ورشة عمل مغلقة لمنشأتك؟</h2>
        <p>يقدم فريقنا الاستشاري جلسات تشخيصية وورش عمل تنفيذية مخصصة للجهات الحكومية والشركات السعودية لبناء أطر الحوكمة والأمان الداخلي.</p>
        <div class="content-cta-final__actions mt-6">
          <a href="/contact/" class="btn btn--glow">
            <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-email"></use></svg>
            تواصل معنا لحجز ورشة خاصة
          </a>
        </div>
      </div>
    </div>
  </section>
</ArabicLayout>

<style>
  .assessment-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 9999px;
    background: var(--brand-soft, rgba(20,184,166,0.15));
    color: var(--interactive-primary, #14b8a6);
    margin-top: 0.75rem;
  }
  .section-box {
    background: var(--surface-subtle, rgba(255,255,255,0.02));
    border: 1px solid var(--border-subtle, rgba(255,255,255,0.08));
    border-radius: var(--radius-xl, 1rem);
    padding: var(--space-8);
  }
</style>
