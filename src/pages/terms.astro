---
import PageShell from '../components/PageShell.astro';
export const prerender = true;
const sections = [
  ['القبول', 'باستخدامك الموقع أو المنصة فإنك توافق على هذه الشروط. وتحكم العلاقة مع عملاء الباقات المدفوعة اتفاقيةُ الخدمة الموقعة، وتُقدَّم عند التعارض.'],
  ['الخدمة', 'AIGAS أداة تساعد في حوكمة استخدام الذكاء الاصطناعي، ولا تُعد شهادة امتثال ولا استشارة قانونية. وتبقى مسؤولية القرارات النهائية والامتثال على الجهة المستخدمة.'],
  ['الاستخدام المقبول', 'يُمنع استخدام المنصة في أي نشاط مخالف للأنظمة، أو محاولة تجاوز ضوابطها، أو اختبار أنظمة لا تملك تفويضاً كتابياً باختبارها.'],
  ['التجربة المجانية', 'لمدة 14 يوماً وفي حدود 1,000 طلب، دون أي التزام. ويجوز لنا إيقافها عند إساءة الاستخدام.'],
  ['الأسعار والدفع', 'الأسعار بالريال السعودي ولا تشمل ضريبة القيمة المضافة. والاشتراك السنوي يُدفع مقدماً.'],
  ['حدود المسؤولية', 'مخرجات النماذج قد تكون غير دقيقة، ويجب التحقق منها. ولا تتجاوز مسؤوليتنا قيمة ما دفعه العميل خلال الأشهر الاثني عشر السابقة للمطالبة.'],
  ['النظام الحاكم', 'تخضع هذه الشروط لأنظمة المملكة العربية السعودية، وتختص بالنزاعات المحاكم المختصة في مدينة الرياض.'],
];
---
<PageShell title="الشروط والأحكام | BRIGHTAI" description="شروط استخدام موقع BRIGHTAI ومنصة AIGAS." crumbs={[{ name: 'الشروط والأحكام' }]}>
  <p class="note">بنود المنصة أدناه تحتاج مراجعة واعتماداً تعاقدياً قبل تطبيقها على خدمة فعلية. تجربة الموقع الحالية محاكاة فقط ولا تنشئ اشتراكاً.</p>
  <h1>الشروط والأحكام</h1><p class="note">آخر تحديث: 2026-10-30</p>
  {sections.map(([t, d]) => <section class="block"><h2>{t}</h2><p>{d}</p></section>)}
</PageShell>
