---
import EnglishLayout from '../../../layouts/EnglishLayout.astro';
import { getLanguageCounterpart, getLegalAlternates } from '../../../data/i18n-pairs';
import { legal_en_pdpl_statement } from '../../../data/legal-content-en-inline';
import DOMPurify from 'isomorphic-dompurify';
const route = '/en/pdpl-statement/';
const canonical = `https://brightai.site${route}`;
const legalContent = legal_en_pdpl_statement;
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
]};
---
<EnglishLayout title="BrightAI PDPL Statement | Saudi AI" description="BrightAI PDPL compliance statement: data protection and responsible AI governance for Saudi organizations. Read about our audit-ready controls." canonical={canonical} hreflang={getLegalAlternates(route, 'en')} jsonLd={jsonLd} currentPath={route} languageCounterpart={getLanguageCounterpart(route)} breadcrumbs={[{ name: 'PDPL Statement', href: '/en/pdpl-statement/' }]}>
  <div class="legal-page" set:html={DOMPurify.sanitize(legalContent.html)} />

  <section class="legal-related" aria-labelledby="legal-related-heading">
    <h2 id="legal-related-heading">Related documents</h2>
    <ul>
      <li><a href="/en/data-processing-agreement/">Data processing agreement</a></li>
      <li><a href="/en/privacy-policy/">Privacy policy</a></li>
      <li><a href="/en/terms/">Terms of service</a></li>
      <li><a href="/en/cookie-policy/">Cookie policy</a></li>
      <li><a href="/">BrightAI home</a></li>
      <li><a href="/contact/">Contact us</a></li>
    </ul>
  </section>
</EnglishLayout>

<style>
  .legal-related {
    max-width: 720px;
    margin: var(--space-12) auto 0;
    padding: var(--space-6);
    border-top: 1px solid rgba(148, 163, 184, 0.18);
  }
  .legal-related h2 { font-size: 16px; color: var(--text-secondary, #94a3b8); margin-bottom: var(--space-3); }
  .legal-related ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); }
  .legal-related a { color: var(--brand-400, #22d3ee); text-decoration: none; }
  .legal-related a:hover { text-decoration: underline; }
</style>
