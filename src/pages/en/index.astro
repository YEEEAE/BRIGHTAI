---
/**
 * src/pages/en/index.astro — English-language homepage stub.
 *
 * Purpose (REPORTS-SEO-KEYWORDS-2026-07-08):
 *   Anchor for the homepage hreflang en-SA → https://brightai.live/en/ signal
 *   requested by the founder to support the bilingual SERP targeting of the
 *   Arabic homepage ("حوكمة الذكاء الاصطناعي في السعودية" cluster).
 *
 * Scope:
 *   This is a stub. The full BrightAI experience (hero, layers, kernel
 *   showcase, compliance packs, sectors, evidence file, comparison, FAQ,
 *   CTA form, docs grid, etc.) is published only in Arabic — the canonical
 *   site language. The stub exists so the hreflang signal is valid (the
 *   alternate URL must resolve to a 200 page, not a 404).
 *
 * Constraints:
 *   - Mirrors the SEO foundation: FoundationSchema emits Organization +
 *     WebSite + LocalBusiness + WebPage automatically via EnglishLayout.
 *   - Single H1, no duplicate H1s elsewhere.
 *   - hreflang carries ar-SA + x-default back to the Arabic homepage.
 *   - Saudi dialect preserved in the cross-link to the Arabic version.
 */
import EnglishLayout from '../../layouts/EnglishLayout.astro';

const route = '/en/';
const canonical = `https://brightai.live${route}`;

// hreflang: ar-SA points back to the full Arabic homepage, x-default mirrors it.
// en-SA is the current page's self-reference.
const hreflang = [
  { lang: 'en-SA', href: canonical },
  { lang: 'ar-SA', href: 'https://brightai.live/' },
  { lang: 'x-default', href: 'https://brightai.live/' },
];

const title = 'BrightAI — AI Governance & Safety for Saudi Arabia';
const description =
  'BrightAI is a Saudi-built AI Safety OS for PDPL and NCA ECC compliance: AI governance, audit trail, and firewall. Start securing your organization today.';
---

<EnglishLayout
  title={title}
  description={description}
  canonical={canonical}
  hreflang={hreflang}
  currentPath={route}
  languageCounterpart="/"
>
  <section class="en-homepage" aria-labelledby="en-homepage-title">
    <div class="max-w-3xl mx-auto px-5 lg:px-8 py-16 lg:py-24 text-center">
      <span class="section__eyebrow" lang="ar">Saudi AI Safety OS</span>
      <h1 id="en-homepage-title" class="section__title mt-4">
        AI Governance &amp; Safety for Saudi Arabia
      </h1>
      <p class="section__subtitle mt-6">
        BrightAI is a Saudi-built AI Safety OS — the operating layer that sits
        between your employees, your data, and AI models. We deliver AI firewall,
        audit trail, human approval, and compliance packs aligned with PDPL,
        NCA ECC, SFDA, and SAMA.
      </p>

      <div class="mt-12 text-start space-y-12">
        <!-- 5 Protection Layers -->
        <section aria-labelledby="en-layers-title" class="pt-8 border-t border-white/10">
          <h2 id="en-layers-title" class="text-2xl lg:text-3xl font-bold text-white text-center mb-8">
            The 5 Core Pillars of BrightAI Governance OS
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="card card--glass p-6 rounded-2xl">
              <div class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-bold mb-4">1</div>
              <h3 class="text-lg font-bold text-white mb-2">Real-Time AI Firewall &amp; PII Shield</h3>
              <p class="text-sm text-white/70 leading-relaxed">
                Automatically intercepts and inspects all prompt payloads and model responses. Redacts Saudi National IDs, Iqama numbers, IBANs, and health data before queries reach public or proprietary AI models, enforcing complete alignment with Saudi PDPL regulations.
              </p>
            </div>

            <div class="card card--glass p-6 rounded-2xl">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold mb-4">2</div>
              <h3 class="text-lg font-bold text-white mb-2">Tamper-Evident Cryptographic Audit Trail</h3>
              <p class="text-sm text-white/70 leading-relaxed">
                Emits an immutable hash-chained event log for every inference query, decision recommendation, and prompt transaction. Assigns unique Trace IDs to ensure forensic accountability and effortless internal audit readiness.
              </p>
            </div>

            <div class="card card--glass p-6 rounded-2xl">
              <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold mb-4">3</div>
              <h3 class="text-lg font-bold text-white mb-2">Human-in-the-Loop Approval Gateways</h3>
              <p class="text-sm text-white/70 leading-relaxed">
                Prevents automated hallucination and risk exposure by requiring verified supervisor authorization before high-stakes actions—such as credit approvals, medical diagnosis summaries, or contractual amendments—are finalized.
              </p>
            </div>

            <div class="card card--glass p-6 rounded-2xl">
              <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold mb-4">4</div>
              <h3 class="text-lg font-bold text-white mb-2">Saudi Regulatory Compliance Packs</h3>
              <p class="text-sm text-white/70 leading-relaxed">
                Pre-configured compliance control packs matching SDAIA Generative AI Guidelines, National Cybersecurity Authority Essential Cybersecurity Controls (NCA ECC), SAMA Cyber and AI Governance frameworks, and SFDA medical standards.
              </p>
            </div>
          </div>
        </section>

        <!-- Industry Sector Solutions -->
        <section aria-labelledby="en-sectors-title" class="pt-8 border-t border-white/10">
          <h2 id="en-sectors-title" class="text-2xl lg:text-3xl font-bold text-white text-center mb-8">
            Tailored Industry Solutions for Saudi Enterprises
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="card card--glass p-6 rounded-2xl">
              <h3 class="text-base font-bold text-cyan-300 mb-2">Banking &amp; Financial Services</h3>
              <p class="text-sm text-white/70 leading-relaxed">
                Enforce strict SAMA compliance, prevent leakage of confidential financial statements and payment credentials, and govern customer-facing banking chatbots with zero latency penalty.
              </p>
            </div>
            <div class="card card--glass p-6 rounded-2xl">
              <h3 class="text-base font-bold text-emerald-300 mb-2">Healthcare &amp; Pharmaceuticals</h3>
              <p class="text-sm text-white/70 leading-relaxed">
                Safeguard patient medical histories, anonymize clinical research queries, and comply with SFDA digital health standards while deploying AI diagnostic assistants.
              </p>
            </div>
            <div class="card card--glass p-6 rounded-2xl">
              <h3 class="text-base font-bold text-purple-300 mb-2">Government &amp; National Infrastructure</h3>
              <p class="text-sm text-white/70 leading-relaxed">
                Maintain 100% data sovereignty within certified Class C Saudi cloud infrastructure, guaranteeing that sensitive public sector data never leaves the Kingdom.
              </p>
            </div>
          </div>
        </section>

        <!-- Enterprise FAQ in English -->
        <section aria-labelledby="en-faq-title" class="pt-8 border-t border-white/10">
          <h2 id="en-faq-title" class="text-2xl lg:text-3xl font-bold text-white text-center mb-8">
            Frequently Asked Questions
          </h2>
          <div class="space-y-6">
            <div class="card card--glass p-6 rounded-2xl">
              <h3 class="text-base font-bold text-white mb-2">How does BrightAI deploy within an existing corporate architecture?</h3>
              <p class="text-sm text-white/70 leading-relaxed">
                BrightAI operates as a lightweight, intelligent reverse proxy gateway that sits seamlessly between your applications and LLM providers. Deployment requires changing only your base API endpoint URL and authorization header, requiring zero alterations to model weights or client codebases.
              </p>
            </div>
            <div class="card card--glass p-6 rounded-2xl">
              <h3 class="text-base font-bold text-white mb-2">Does BrightAI store our prompts or confidential corporate data?</h3>
              <p class="text-sm text-white/70 leading-relaxed">
                No. BrightAI adheres to a strict zero-retention data architecture. We inspect prompt streams ephemerally in memory to verify security policies and redact sensitive data. Only cryptographic event hashes, token counts, and sanitized metadata are preserved in the immutable audit log.
              </p>
            </div>
            <div class="card card--glass p-6 rounded-2xl">
              <h3 class="text-base font-bold text-white mb-2">Where is the BrightAI platform hosted?</h3>
              <p class="text-sm text-white/70 leading-relaxed">
                All BrightAI production instances and databases are hosted exclusively within Tier-III/IV data centers located inside the Kingdom of Saudi Arabia, fully certified under the Communications, Space &amp; Technology Commission (CST) Class C classification.
              </p>
            </div>
          </div>
        </section>
      </div>

      <div class="mt-12 card card--glass rounded-2xl p-6 lg:p-8 text-start">
        <p class="text-sm text-white/70 leading-loose">
          <strong class="text-white">Full experience in Arabic:</strong> The
          complete BrightAI homepage — including the interactive AI governance framework,
          compliance packs, sector pages, live kernel demo, evidence files, and the
          Riyadh / Dammam / Jeddah / Khobar / Mecca / Madinah regional pages — is
          published in Saudi Arabic.
        </p>
        <a
          href="/"
          hreflang="ar-SA"
          class="home-cta-primary mt-6 inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold"
        >
          <span lang="ar">النسخة العربية الكاملة ←</span>
        </a>
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-3 text-sm">
        <a
          href="/go/whatsapp/"
          target="_blank"
          rel="noopener noreferrer"
          class="wa-btn inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white font-bold"
        >
          Contact us on WhatsApp
        </a>
        <a
          href="/about/"
          class="card card--glass inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white/80 font-bold hover:border-cyan-500/40 transition-all"
        >
          About BrightAI
        </a>
        <a
          href="/solutions/ai-governance-platform/"
          class="card card--glass inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white/80 font-bold hover:border-cyan-500/40 transition-all"
        >
          AI Governance Platform
        </a>
        <a
          href="/pricing/"
          class="card card--glass inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white/80 font-bold hover:border-cyan-500/40 transition-all"
        >
          Pricing
        </a>
        <a
          href="/contact/"
          class="card card--glass inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white/80 font-bold hover:border-cyan-500/40 transition-all"
        >
          Contact
        </a>
        <a
          href="/en/sales-deck/"
          class="card card--glass inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white/80 font-bold hover:border-cyan-500/40 transition-all"
        >
          Sales Deck
        </a>
        <a
          href="/en/terms/"
          class="card card--glass inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white/80 font-bold hover:border-cyan-500/40 transition-all"
        >
          Terms of Service
        </a>
        <a
          href="/en/privacy-policy/"
          class="card card--glass inline-flex items-center gap-2 px-6 py-3 rounded-xl text-white/80 font-bold hover:border-cyan-500/40 transition-all"
        >
          Privacy Policy
        </a>
      </div>
    </div>
  </section>
</EnglishLayout>
