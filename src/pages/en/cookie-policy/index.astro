---
import EnglishLayout from '../../../layouts/EnglishLayout.astro';
import { getLanguageCounterpart, getLegalAlternates } from '../../../data/i18n-pairs';
import { legal_en_cookie_policy } from '../../../data/legal-content-en-inline';
import DOMPurify from 'isomorphic-dompurify';
const route = '/en/cookie-policy/';
const canonical = `https://brightai.site${route}`;
const legalContent = legal_en_cookie_policy;
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
  { '@type': 'LegalDocument', name: legalContent.h1, url: canonical, inLanguage: 'en-SA' },
]};
---
<EnglishLayout title="BrightAI Cookie Policy | Saudi" description="BrightAI cookie policy: how we use cookies and analytics for Saudi organizations. Your privacy choices for AI governance services explained clearly." canonical={canonical} hreflang={getLegalAlternates(route, 'en')} jsonLd={jsonLd} currentPath={route} languageCounterpart={getLanguageCounterpart(route)} breadcrumbs={[{ name: 'Cookie Policy', href: '/en/cookie-policy/' }]}>
  <div class="legal-page" set:html={DOMPurify.sanitize(legalContent.html)} />

  <section class="legal-related" aria-labelledby="legal-related-heading">
    <h2 id="legal-related-heading">Related documents</h2>
    <ul>
      <li><a href="/en/privacy-policy/">Privacy policy</a></li>
      <li><a href="/en/terms/">Terms of service</a></li>
      <li><a href="/en/pdpl-statement/">PDPL statement</a></li>
      <li><a href="/en/data-processing-agreement/">Data processing agreement</a></li>
      <li><a href="/">BrightAI home</a></li>
      <li><a href="/contact/">Contact us</a></li>
    </ul>
  </section>
</EnglishLayout>

<style>
  .legal-related {
    max-width: 720px;
    margin: 48px auto 0;
    padding: 24px;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
  }
  .legal-related h2 {
    font-size: 16px;
    color: var(--text-secondary, #94a3b8);
    margin-bottom: 12px;
  }
  .legal-related ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }
  .legal-related a {
    color: var(--brand-400, #22d3ee);
    text-decoration: none;
  }
  .legal-related a:hover { text-decoration: underline; }
</style>
