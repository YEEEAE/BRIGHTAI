---
/**
 * Sales Deck (EN) — /en/sales-deck/
 * English mirror of the Arabic sales deck.
 */
import EnglishLayout from '../../../layouts/EnglishLayout.astro';
import SalesDeck from '../../../components/SalesDeck.astro';

const slides = [
  { kicker: 'Problem', title: 'AI is spreading — but who governs it?', bullets: ['Teams use scattered tools with no unified log', 'Sensitive data leaks to public tools', 'No operational evidence for regulators'] },
  { kicker: 'Solution', title: 'BrightAI — Saudi AI Safety OS', bullets: ['AI Firewall blocks data leakage', 'Tamper-evident audit trail', 'Evidence file ready for PDPL / NCA'] },
  { kicker: 'Layers', title: '5 protection layers', bullets: ['PII prevention + human approval', 'Audit trail + evidence', 'Risk classification + policies', 'ERP/CRM/HIS integration', '100% local hosting'] },
  { kicker: 'Security', title: 'Full data sovereignty', bullets: ['Hosted inside Saudi Arabia', 'Data never leaves the Kingdom', 'Saudi engineering team'] },
  { kicker: 'ROI', title: 'Proven value', bullets: ['94% reduction in unmonitored Shadow AI', '100% sensitive data covered by audit', '3 weeks to internal audit readiness'], note: 'From anonymized case studies — see /customers/' },
  { kicker: 'Next', title: 'Start with a readiness assessment', bullets: ['Free assessment in days', '90-day roadmap', 'Pricing per scope'], note: 'Contact: +966 538 229 013' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'BrightAI Sales Deck',
      description: 'BrightAI sales deck for AI governance: problem, solution, layers, security, ROI.',
      url: 'https://brightai.live/en/sales-deck/',
      inLanguage: 'en-SA',
    },
  ],
};
---

<EnglishLayout
  title="BrightAI Sales Deck | AI Governance"
  description="BrightAI sales deck: AI governance for Saudi Arabia with 5 protection layers, data sovereignty, and ROI. Get the full overview."
  canonical="https://brightai.live/en/sales-deck/"
  hreflang={[{ lang: 'en-SA', href: 'https://brightai.live/en/sales-deck/' }, { lang: 'ar-SA', href: 'https://brightai.live/sales-deck/' }]}
  jsonLd={jsonLd as any}
  currentPath="/en/sales-deck/"
  breadcrumbs={[{ name: 'Sales Deck', href: '/en/sales-deck/' }]}
>

  <section class="page-hero" aria-label="Sales Deck">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="inner-hero__badge">
        <svg aria-hidden="true" width="1em" height="1em"><use href="/icons.svg#mdi-presentation"></use></svg>
        Sales Deck
      </div>
      <h1 class="page-hero__title"><span class="gradient-text">BrightAI</span> Sales Deck</h1>
      <p class="page-hero__description">A printable slide deck summarizing BrightAI's value in 6 slides. Check our <a href="/customers/">customer success stories</a> and <a href="/partners/">partnership program</a>.</p>
      <div class="about-hero__actions about-hero__actions--centered">
        <a href="/contact/" class="btn btn--glow">Request a demo</a>
      </div>
    </div>
  </section>

  <SalesDeck slides={slides} />

  <!-- Executive Briefing and Deployment Roadmap -->
  <section class="sales-deck-details max-w-5xl mx-auto px-5 lg:px-8 py-16 text-slate-300 space-y-12">
    <div class="card card--glass p-8 rounded-3xl">
      <h2 class="text-2xl font-bold text-white mb-4">Executive Briefing: Enterprise AI Safety OS</h2>
      <p class="text-white/70 text-sm lg:text-base leading-relaxed">
        BrightAI enables enterprises and government entities across Saudi Arabia to accelerate generative AI adoption while maintaining complete control over sensitive data, meeting the statutory requirements of the Personal Data Protection Law (PDPL) and National Cybersecurity Authority Essential Cybersecurity Controls (NCA ECC-1:2018).
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        <div class="card card--glass p-5 rounded-2xl">
          <h3 class="font-bold text-cyan-400 mb-2">Rapid Integration</h3>
          <p class="text-xs text-white/70 leading-relaxed">
            Connect in hours via a standard-compliant reverse proxy gateway without altering model weights or proprietary codebases.
          </p>
        </div>
        <div class="card card--glass p-5 rounded-2xl">
          <h3 class="font-bold text-emerald-400 mb-2">100% Data Sovereignty</h3>
          <p class="text-xs text-white/70 leading-relaxed">
            Hosted exclusively within certified Class C Saudi data centers, guaranteeing all records remain strictly inside the Kingdom.
          </p>
        </div>
        <div class="card card--glass p-5 rounded-2xl">
          <h3 class="font-bold text-purple-400 mb-2">Measurable ROI</h3>
          <p class="text-xs text-white/70 leading-relaxed">
            Cut manual audit review cycles by up to 70% and prevent catastrophic non-compliance fines from unmonitored Shadow AI.
          </p>
        </div>
      </div>
    </div>

    <!-- 90-Day Deployment Roadmap -->
    <div class="card card--glass p-8 rounded-3xl">
      <h2 class="text-2xl font-bold text-white mb-6">90-Day Enterprise Deployment Roadmap</h2>
      <div class="space-y-6 text-sm">
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-bold shrink-0">30</div>
          <div>
            <h3 class="font-bold text-white mb-1">Phase 1: Shadow AI Discovery &amp; Risk Baseline</h3>
            <p class="text-white/70 leading-relaxed">
              Identify all unmanaged AI usage across departments, audit prompt traffic patterns, and benchmark compliance gaps against SDAIA and NCA standards.
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold shrink-0">60</div>
          <div>
            <h3 class="font-bold text-white mb-1">Phase 2: Gateway Enforcement &amp; PII Redaction</h3>
            <p class="text-white/70 leading-relaxed">
              Route inference calls through BrightAI Kernel, enable real-time PII masking for national IDs and financial data, and activate human approval workflows.
            </p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold shrink-0">90</div>
          <div>
            <h3 class="font-bold text-white mb-1">Phase 3: Evidence Automation &amp; Continuous Assurance</h3>
            <p class="text-white/70 leading-relaxed">
              Automate periodic compliance reporting, train governance leads on policy replay simulation, and deliver certified Evidence Files for external regulators.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Enterprise FAQ in English -->
    <div class="card card--glass p-8 rounded-3xl">
      <h2 class="text-2xl font-bold text-white mb-6">Frequently Asked Procurement Questions</h2>
      <div class="space-y-6 text-sm">
        <div>
          <h3 class="font-bold text-white mb-1">What commercial licensing models are available?</h3>
          <p class="text-white/70 leading-relaxed">
            We offer tiered enterprise annual subscriptions based on active employee seat count and monthly token processing volume, including customized government packages with dedicated local engineering support.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-white mb-1">Can BrightAI be deployed on-premises or in private clouds?</h3>
          <p class="text-white/70 leading-relaxed">
            Yes. For defense, banking, and high-security public sector entities, BrightAI Kernel offers dedicated on-premises deployment packages operating in air-gapped or private cloud environments.
          </p>
        </div>
      </div>
    </div>
  </section>
</EnglishLayout>
