---
import AccessBadge from '../../components/AccessBadge.astro';
import AccessSteps from '../../components/AccessSteps.astro';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import '../../styles/variables.css';
import FirewallWorkspace from '../../components/FirewallWorkspace.astro';
import ScenarioContext from '../../components/ScenarioContext.astro';
import SecureChatDemo from '../../components/SecureChatDemo.astro';
import RiskWorkspace from '../../components/RiskWorkspace.astro';
import HumanGateDemo from '../../components/HumanGateDemo.astro';
import LedgerDemo from '../../components/LedgerDemo.astro';
import {products} from '../../demo/engine.mjs';
export const prerender=true;
export function getStaticPaths(){return Object.entries(products).map(([product,config])=>({params:{product},props:{config}}));}
const {config}=Astro.props;
const product=Astro.params.product;
const hasGovernanceView = ['firewall', 'risk-engine', 'human-gate', 'ledger'].includes(product ?? '');
const description=`مختبر ${config.name}: محاكاة تعليمية ببيانات افتراضية لفهم القرارات وحدودها، دون اتصال ببيانات المؤسسات أو إثبات حماية إنتاجية.`;
---
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"/><meta name="robots" content="noindex, follow"/><meta name="description" content={description}/><meta name="viewport" content="width=device-width"/><meta name="referrer" content="no-referrer"/><meta http-equiv="Content-Security-Policy" content="connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; form-action 'none'; object-src 'none'; base-uri 'none'"/><title>مختبر {config.name} | BRIGHTAI</title><GoogleAnalytics /></head><body><header><a href="/products/">BRIGHTAI · المنتجات</a><AccessBadge status={product === "secure-chat" ? "local" : "offline"} /></header><main data-product={product}><AccessSteps current="demo" slug={product} /><nav aria-label="المختبرات">{Object.entries(products).map(([key,p])=><a href={`/demo/${key}/`} aria-current={key===product?'page':undefined}>{p.name}</a>)}</nav><h1>مختبر {config.name}</h1>{hasGovernanceView && <p><a href={`/demo/governance/#${product}`}>افتح المنتج في مختبر الحوكمة الموحّد</a></p>}<ScenarioContext/><details><summary>حدود المختبر</summary><p>استخدم بيانات اصطناعية فقط. المختبر للتعلّم خارج مساحة العمل المؤسسية.</p></details>{product==='secure-chat'? <SecureChatDemo/> : product==='risk-engine'? <RiskWorkspace demo/> : product==='human-gate'? <HumanGateDemo/> : product==='ledger'? <LedgerDemo/> : product==='firewall'? <FirewallWorkspace/> : <div id="generic-demo"><label for="scenario">اختر سيناريو</label><select id="scenario">{config.samples.map((s,i)=><option value={s}>سيناريو {i+1}: {s}</option>)}</select><form><label for="input">{config.field}</label><textarea id="input" maxlength="500" required rows="4">{config.samples[0]}</textarea><div><button type="submit">شغّل المحاكاة</button><button type="reset">إعادة الضبط</button></div></form><section aria-live="polite" aria-atomic="true"><h2>ناتج Demo</h2><p id="result">جاهز للتجربة.</p></section></div>}<p><a href={product === 'kernel' ? '/kernel/' : `/products/${product}/#lab`}>تفاصيل المنتج والتجربة التعليمية</a> · <a href="/status/">حالة النظام</a></p><noscript>فعّل JavaScript لتشغيل المحاكاة المحلية.</noscript></main><script>
import '../../scripts/knowledge-context';
import {startLab,completeLab,resetLab} from '../../scripts/measurement';
import {decide,products} from '../../demo/engine.mjs';
const main=document.querySelector('main')!;
if(!['secure-chat','risk-engine','ledger','human-gate','firewall'].includes(main.dataset.product!)){const key=main.dataset.product!;const form=document.querySelector('form')!;const input=document.querySelector('textarea')!;const select=document.querySelector('select')!;const result=document.querySelector('#result')!;
select.addEventListener('change',()=>{input.value=select.value;result.textContent='تم تحميل السيناريو؛ شغّل المحاكاة.';});
form.addEventListener('submit',e=>{e.preventDefault();try{const r=decide(key,input.value);startLab(main,key);completeLab(main,key);result.textContent=`Demo · ${r.decision} — ${r.explanation}`;}catch(error){result.textContent=error instanceof Error?error.message:'تعذر التقييم.';}});
form.addEventListener('reset',()=>{resetLab(main);select.selectedIndex=0;input.value=products[key].samples[0];result.textContent='جاهز للتجربة.';});
}
</script><style>body{margin:0;background:var(--surface-sunken,#101523);color:var(--color-text,#f2f4ff);font:18px system-ui;line-height:1.8}header,main{max-width:850px;margin:auto;padding:24px}header{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between}.badge,section{background:var(--surface-raised,#202b43);padding:16px;border-radius:12px}nav{display:flex;gap:16px;flex-wrap:wrap}a{color:var(--color-focus,#cbbaff)}a[aria-current]{color:white;text-decoration-thickness:3px}label{display:block;margin-top:24px}textarea,select,button{font:inherit;box-sizing:border-box;padding:12px;border-radius:8px}textarea,select{width:100%;background:var(--surface-raised,#fff);color:var(--color-text,#142035)}button{margin:12px 0 12px 12px;cursor:pointer;min-height:48px}button:focus-visible,a:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid var(--color-focus,#77e7df);outline-offset:4px}section{overflow-wrap:anywhere}</style></body></html>
