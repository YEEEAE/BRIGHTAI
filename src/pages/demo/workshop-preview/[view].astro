---
import BrandLogo from '../../../components/BrandLogo.astro';

const { view } = Astro.params;
if (!import.meta.env.DEV || (view !== 'offer' && view !== 'sample')) {
  return new Response(null, { status: 404 });
}

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'no-store');
const sample = view === 'sample';
const title = sample ? 'تأخرت الشحنة والعميل يطلب استرجاع المبلغ' : 'ورشة استخدام الذكاء الاصطناعي في الرد على شكاوى العملاء';
const agenda = [
  ['٠–١٠', 'تحديد المشكلة', 'نفصل الوقائع المؤكدة عن طلب العميل ونحدد من يملك قرار الاسترجاع.'],
  ['١٠–٢٥', 'تنقيح الشكوى', 'نزيل بيانات الهوية والدفع ونُبقي التفاصيل اللازمة لفهم الحالة.'],
  ['٢٥–٤٥', 'صياغة الرد', 'نولّد مسودة عربية باستخدام السياسة المعتمدة ونراجع الوعود الواردة فيها.'],
  ['٤٥–٦٥', 'تمرين الفريق', 'يعمل المشاركون على شكوى ثانية ويقارنون المسودة بنص السياسة.'],
  ['٦٥–٨٠', 'مراجعة المشرف', 'نقرر اعتماد الرد أو تعديله أو تصعيد الحالة، ونسجل السبب.'],
  ['٨٠–٩٠', 'تطبيق ما تعلمناه', 'نراجع قائمة الفحص ونحدد أين يستخدمها الفريق في سير عمله.'],
];
---

<!doctype html>
<html lang="ar-SA" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} | BRIGHTAI</title>
</head>
<body>
  <main class:list={['sheet', { sample }]}>
    <header class="heading">
      <div class="masthead">
        <BrandLogo />
        <p>{sample ? 'حالة تدريبية ببيانات اصطناعية' : 'ورشة تطبيقية لفريق خدمة العملاء · ٩٠ دقيقة'}</p>
      </div>
      <h1>{title}</h1>
      {sample
        ? <p class="lead">فات موعد التسليم بيومين، وآخر تحديث للشحنة «قيد النقل».</p>
        : <p class="lead">يتدرّب الفريق على تحويل شكوى العميل إلى مسودة عربية واضحة، ثم مراجعتها وفق سياسة المنشأة قبل الإرسال.</p>}
    </header>
    {sample ? (
      <div class="grid">
        <section>
          <h2>النص المنقّح</h2>
          <blockquote>«كان طلبي المفروض يوصل قبل يومين. التتبع للحين يقول قيد النقل. الطلب ما عاد أحتاجه وأبي ألغيه وأسترجع المبلغ.»</blockquote>
        </section>
        <section>
          <h2>مسودة الرد</h2>
          <blockquote>«نعتذر عن تأخر شحنتك. آخر تحديث عندنا يبيّن أنها قيد النقل. بنراجع مع الناقل إمكانية إيقاف التسليم، وبنبلغك عبر هذه المحادثة بخطوة الاسترجاع المتاحة بعد التحقق.»</blockquote>
        </section>
        <section class="decision">
          <h2>قرار المشرف</h2>
          <p>اعتماد إرسال الرد. إحالة طلب الإيقاف لفريق الشحن وتعليق الموافقة على الاسترجاع إلى أن يرد الناقل.</p>
        </section>
        <section>
          <h2>سبب القرار</h2>
          <p>في سياسة التمرين، يبدأ الاسترجاع بعد تأكيد إيقاف التسليم أو عودة الشحنة. حالة «قيد النقل» لا تثبت تحقق أيٍّ منهما.</p>
        </section>
      </div>
    ) : (
      <>
        <div class="grid">
          <section>
            <h2>لمن هذه الورشة؟</h2>
            <p>المشتري مدير خدمة العملاء في متجر إلكتروني. يحضر ممثلو الدعم ومشرف يملك صلاحية مراجعة الردود وتصعيد طلبات الاسترجاع.</p>
          </section>
          <section>
            <h2>المشكلة التي تعالجها</h2>
            <p>تتفاوت الردود على الشكوى نفسها. قد تحمل المسودة وعدًا باسترجاع غير معتمد، أو تُنسخ فيها بيانات العميل إلى أداة الصياغة.</p>
          </section>
        </div>
        <p><a href="../sample/">افتح عينة تأخر الشحنة والاسترجاع</a></p>
        <section class="agenda">
          <h2>أجندة ٩٠ دقيقة</h2>
          <ol>
            {agenda.map(([minutes, label, description]) => (
              <li><bdi>{minutes}</bdi><div><strong>{label}</strong><p>{description}</p></div></li>
            ))}
          </ol>
        </section>
        <div class="grid">
          <section>
            <h2>ما تستلمه خلال يومي عمل من الجلسة</h2>
            <ul>
              <li>قالب قابل للتحرير لتنقيح الشكوى وصياغة الرد بالعربية.</li>
              <li>قائمة فحص للمشرف وسجل قرار يوضح الاعتماد أو التعديل أو التصعيد وأسبابه.</li>
              <li>مثال محلول من التمرين يجمع النص المنقّح والمسودة والقرار وسببه.</li>
            </ul>
          </section>
          <section>
            <h2>ما نحتاجه قبل الجلسة</h2>
            <ul>
              <li>نسخة معتمدة من قواعد التأخير والإلغاء والاسترجاع وصلاحيات الموافقة.</li>
              <li>حالتان منزوعتا البيانات الشخصية، أو موافقة على استخدام الحالتين التدريبيتين خلال الورشة.</li>
              <li>تحديد ممثلي الدعم والمشرف، وتجهيز أداة ذكاء اصطناعي تعتمدها المنشأة إن كان الفريق سيستخدمها مباشرة. يمكن إجراء التمرين بمسودات جاهزة.</li>
            </ul>
          </section>
        </div>
      </>
    )}
  </main>
</body>
</html>

<style>
  @font-face { font-family: Plex Arabic; src: url('/fonts/plex-arabic-400.woff2') format('woff2'); font-display: swap; }
  @font-face { font-family: Plex Arabic; src: url('/fonts/plex-arabic-600.woff2') format('woff2'); font-weight: 600; font-display: swap; }
  body { margin: 0; color: #eaf4f2; background: #101c20; font: 1.125rem/1.65 'Plex Arabic', sans-serif; }
  .sheet { box-sizing: border-box; max-width: 76rem; margin-inline: auto; padding: clamp(1rem, 4vw, 3rem); }
  .heading { padding-block-end: 1.4rem; border-block-end: 1px solid #52716f; margin-block-end: 1.4rem; }
  .masthead { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; color: #a9e0d2; }
  h1 { max-inline-size: 25ch; font-size: clamp(2rem, 4.5vw, 3.8rem); line-height: 1.18; margin: .3em 0; }
  h2 { font-size: 1.3em; line-height: 1.35; margin: 0 0 .45rem; }
  p, blockquote { margin: 0; }
  main > p { margin-block: 1rem; }
  a { color: #a9e0d2; text-underline-offset: .22em; }
  a:focus-visible { outline: 2px solid #a9e0d2; outline-offset: 4px; }
  .lead { color: #bedad6; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  section { background: #17282d; border: 1px solid #405a5e; border-radius: .85rem; padding: clamp(1rem, 2vw, 1.5rem); }
  .sample { padding-block: clamp(1rem, 3vw, 2rem); font-size: clamp(1.125rem, 1.75vw, 1.375rem); }
  .sample .heading { padding-block-end: 1rem; margin-block-end: 1rem; }
  .sample .masthead :global(img) { width: 108px; height: 64px; }
  .sample h1 { max-inline-size: none; }
  .decision { background: #1d3633; border-color: #6ea899; }
  .agenda { margin-block: 1rem; }
  ol, ul { margin-block: .5rem 0; }
  ol { padding: 0; list-style: none; }
  ol li { display: grid; grid-template-columns: 4rem 1fr; gap: .75rem; padding-block: .55rem; }
  ol li + li { border-block-start: 1px solid #405a5e; }
  bdi { color: #a9e0d2; }
  ul { padding-inline-start: 1.25em; }
  @media (max-width: 45rem) { .grid { grid-template-columns: 1fr; } }
  @page { size: A4 landscape; margin: 12mm; }
  @media print {
    body, section, .decision { color: #182825; background: white; }
    .sheet { padding: 0; }
    .masthead, .lead, bdi, a { color: #254a43; }
    .masthead :global(.brand-logo) { display: none; }
    .sample .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    section { break-inside: avoid; }
  }
</style>
