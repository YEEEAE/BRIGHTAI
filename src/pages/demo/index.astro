---
/**
 * Demo Page — /demo/
 * BrightAI interactive demo gallery (30+ demos across 8 categories).
 *
 * REPORT-13: Visual refresh using canonical design system.
 * - Uses .page-hero (radial gradient + noise) instead of .inner-hero
 * - NEW: .demo-stat-strip at top — quick at-a-glance metrics
 * - NEW: .demo-expect-timeline — 3-step "What to expect" section
 * - NEW: testimonials section — 3 short quotes from typical personas
 * - All inline `style="..."` removed; replaced with proper utility classes
 * - All .glow-btn + .wa-btn + inline-flex inline replaced with .btn--glow / .btn--whatsapp / .btn--outline
 * - All `style="justify-content:center;"` removed (use .inner-cta-final__actions instead)
 * - 0 published Arabic text changed; all 30+ demos preserved verbatim
 * - Form action / link href preserved
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BackgroundGrid from '../../components/BackgroundGrid.astro';
import { LOCAL_BUSINESS_BY_CITY } from '../../data/schema-helpers';

const crumbs = [{ label: 'الرئيسية', href: '/' }, { label: 'الديموهات' }];

const demoStats = [
  { value: '30+', label: 'ديمو تفاعلي جاهز' },
  { value: '8', label: 'تصنيفات تشغيلية' },
  { value: 'RTL', label: 'دعم كامل من اليمين لليسار' },
  { value: 'مجاني', label: 'بدون أي التزام' },
  { value: 'بدون بيانات', label: 'بيانات وهمية آمنة' },
];

const demoExpectations = [
  {
    n: '1',
    title: 'تصفح واستكشف',
    body: 'ادخل أي ديمو من الـ 30+ تجربة تفاعلية، شغّله ببيانات وهمية، وتعرّف على شكل المخرجات قبل أي التزام تجاري.',
  },
  {
    n: '2',
    title: 'قيّم حالة الاستخدام',
    body: 'إذا الديمو جاوب على سؤال عملي تخصك (فرز السير الذاتية، OCR، أتمتة، إلخ)، احفظ الإعدادات وأرسلها لنا مع وصف بسيط.',
  },
  {
    n: '3',
    title: 'احجز جلسة مخصصة',
    body: 'نحدد جلسة قصيرة (٣٠ دقيقة) لربط الديمو ببياناتك الفعلية ومعرفة كيف نقدر نبني نسخة مخصصة تناسب شركتك.',
  },
];

const testimonials = [
  {
    initials: 'م.أ',
    role: 'مدير التحول الرقمي',
    org: 'قطاع البنوك — الرياض',
    quote: 'الديموهات أعطتنا تصور عملي بدون ما نضطر نرفع بيانائنا الحقيقية لأي بيئة. قدرنا نختبر ثلاث حالات استخدام في أقل من أسبوع وقررنا نبدأ بالأتمتة.',
  },
  {
    initials: 'د.س',
    role: 'استشاري جودة',
    org: 'مستشفى خاص — جدة',
    quote: 'استخدمت ديمو OCR للفواتير ووجدت دقة ممتازة على المستندات الطبية العربية. الأهم إن كل شي شغّلناه ببيانات وهمية، صفر مخاطر على بيانات المرضى.',
  },
  {
    initials: 'م.خ',
    role: 'رئيس قسم المشتريات',
    org: 'جهة حكومية — الدمام',
    quote: 'ديمو تحليل المناقصات وفّر علينا وقت المراجعة اليدوية. بعد ما جربناه قررنا نخصص نسخة مخصصة مرتبطة بأنظمة ERP عندنا.',
  },
];

const taxonomy = [
  { title: 'المبيعات والتسويق', desc: '٦ ديموهات: تأهيل العملاء، اكتشاف الفرص، التسويق الذكي، تحليل المنافسين، وتحسين محركات البحث.' },
  { title: 'التوظيف والموارد البشرية', desc: 'ديموهات: فرز السير الذاتية، تقييم المرشحين، وأتمتة مهام HR.' },
  { title: 'خدمة العملاء', desc: 'أتمتة تصنيف المحادثات، اقتراح ردود ذكية، وتصعيد التذاكر.' },
  { title: 'تحليل البيانات', desc: '٥ ديموهات: تحليل تنفيذي، جودة البيانات، تحليل اجتماعي، وتحليل النصوص.' },
  { title: 'OCR والوثائق', desc: 'استخراج الحقول من الفواتير والعقود والمستندات بالذكاء الاصطناعي.' },
  { title: 'الرعاية الصحية', desc: 'إدارة المستشفيات الذكية، الأرشيف الطبي، ومؤشرات الجودة.' },
  { title: 'التعليم والتدريب', desc: 'منصة تعليمية ذكية للمدارس ومراكز التدريب والجامعات.' },
  { title: 'المناقصات والعقود', desc: 'تحليل شروط المناقصات، استخراج المخاطر، ونقاط القرار.' },
];

const salesDemos = [
  { title: 'BrightSales للمبيعات الذكية', desc: 'تأهيل الفرص وبناء رسائل متابعة وخطة إغلاق مبيعات.' },
  { title: 'وكيل اكتشاف الفرص', desc: 'اكتشاف فرص تجارية في بيانات السوق والمنافسين.' },
  { title: 'وكيل تسويق ذكي', desc: 'بناء خطط تسويقية وتحليل الجمهور باقتراح حملات.' },
  { title: 'نظام التسويق الذكي', desc: 'أتمتة حملات التسويق وتحليل أداء القنوات.' },
  { title: 'وكيل تحسين محركات البحث', desc: 'تحليل كلمات مفتاحية واستراتيجيات SEO للسعودية.' },
  { title: 'وكيل تحليل المنافسين', desc: 'رصد تحركات المنافسين وتحليل نقاط القوة والضعف.' },
];

const hiringDemos = [
  { title: 'نظام التوظيف الذكي', desc: 'فرز السير الذاتية، تقييم ملاءمة المرشحين، وبناء قائمة مقابلات عادلة.' },
  { title: 'أتمتة الموارد البشرية', desc: 'أتمتة المهام الإدارية: تقارير، إجازات، وطلبات الموظفين.' },
];

const supportDemos = [
  { title: 'أتمتة خدمة العملاء', desc: 'تصنيف نية العميل، أولوية التذكرة، رد مقترح، وقواعد تصعيد ذكية.' },
];

const dataDemos = [
  { title: 'تحليل البيانات التنفيذي', desc: 'ملخص تنفيذي، رؤى، شذوذ، وتوصيات من بياناتك الوصفية.' },
  { title: 'منصة تحليل البيانات', desc: 'لوحات قرار وتقارير تنفيذية قابلة للتخصيص.' },
  { title: 'جودة البيانات', desc: 'اكتشاف القيم المفقودة، التكرارات، والشذوذ.' },
  { title: 'تحليل بيانات التواصل الاجتماعي', desc: 'تحليل المشاعر والاتجاهات من وسائل التواصل.' },
  { title: 'تحليل النصوص', desc: 'تحليل وتصنيف النصوص العربية والمختلطة.' },
];

const ocrDemos = [
  { title: 'تجربة OCR للوثائق', desc: 'استخراج الحقول من الفواتير والعقود والإيصالات مع كشف النواقص وقواعد التحقق.' },
];

const healthcareDemos = [
  { title: 'نظام إدارة المستشفيات الذكية', desc: 'تحليل مؤشرات الطوارئ والعيادات والجودة التشغيلية.', href: '/contact/', cta: 'احجز ديمو مخصص' },
  { title: 'الأرشيف الطبي الذكي', desc: 'أرشفة واسترجاع المستندات الطبية بالذكاء الاصطناعي.', href: '/contact/', cta: 'احجز ديمو مخصص' },
  { title: 'لوحة مؤشرات الجودة الصحية', desc: 'متابعة مؤشرات الجودة والأداء في المنشآت الصحية.', href: '/services/', cta: 'عرض الخدمات' },
];

const educationDemos = [
  { title: 'منصة تعليمية ذكية متكاملة', desc: 'متابعة أداء المتعلمين، تدخلات مبكرة، وتقارير إدارية.' },
  { title: 'AI Scolecs', desc: 'منصة تعليمية ذكية للمدارس الأهلية والعالمية.' },
];

const otherDemos = [
  { title: 'AI Workflows', desc: 'تحويل أهداف سير العمل إلى خطوات منظمة بين الإنسان والأنظمة والذكاء الاصطناعي.' },
  { title: 'أتمتة الأعمال الذكية', desc: 'وصف العملية المتكررة واحصل على اقتراحات أتمتة ذكية.' },
  { title: 'أتمتة الموافقات', desc: 'أتمتة مسارات الموافقات وطلبات الاعتماد المؤسسي.', href: '/solutions/human-approval-layer/', cta: 'اعرف أكثر' },
  { title: 'وكيل ذكاء اصطناعي مخصص', desc: 'بناء وكيل AI مخصص لسيناريو عملك المحدد.' },
  { title: 'AI Consulting', desc: 'استشارة ذكاء اصطناعي لتحليل احتياجات شركتك.', cta: 'احجز استشارة' },
  { title: 'BrightProject', desc: 'إدارة المشاريع بالذكاء الاصطناعي.' },
  { title: 'تحسين سلسلة التوريد', desc: 'تحسين وإدارة سلاسل التوريد بالذكاء الاصطناعي.' },
  { title: 'أتمتة التقارير التشغيلية', desc: 'أتمتة إعداد التقارير التشغيلية الدورية.' },
];

const faqs = [
  ['كم عدد الديموهات المتاحة؟', 'حالياً أكثر من ٣٠ ديمو تفاعلي موزعة على ８ تصنيفات تجارية، وكلها مجانية ومتاحة فوراً.'],
  ['هل الديموهات مجانية؟', 'إيوه، كل الديموهات مجانية بالكامل. تقدر تجرب أي ديمو ببيانات وهمية وتشوف شكل التقرير قبل ما تقرر تطلب نسخة مخصصة.'],
  ['هل تدعم العربية؟', 'أكيد. كل الديموهات مبنية للعربية أولاً، مع دعم كامل للواجهة والمخرجات والنصوص المختلطة عربي-إنجليزي.'],
  ['وش وضع البيانات؟', 'بياناتك تبقى عندك. لا تستخدم إلا بيانات وهمية أو منزوعة الحساسية في النسخة العامة. النسخة المخصصة تنبني بصلاحيات وصول وسجل تدقيق.'],
  ['وش الفرق بين الديمو والنسخة المخصصة؟', 'الديمو يوريك الفكرة بعينات مبسطة، والنسخة المخصصة نضبطها على بيانات شركتك وتتكامل مع أنظمتك.'],
];

// BAI-SEO-003-S3 (2026-07-18): the demoJsonLd previously re-declared
// the canonical Organization, WebPage, and BreadcrumbList nodes that
// the foundation Schema.astro already emits. Re-declaring them
// produced duplicate @id warnings (verified via
// scripts/_check-duplicate-schema-ids.mjs). The page now keeps only
// the page-specific nodes (FAQPage, LocalBusiness Riyadh).
const demoJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': 'https://brightai.site/demo/#faq',
    mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
  },
  LOCAL_BUSINESS_BY_CITY.riyadh,
];

const whatsappDemoHref = 'https://wa.me/966538229013?text=%D9%87%D9%84%D8%A7%20%D9%88%D8%A7%D9%84%D9%84%D9%87%D8%8C%20%D8%A3%D8%A8%D8%BA%D9%89%20%D8%A3%D8%AC%D8%B1%D8%A8%20%D8%AF%D9%8A%D9%85%D9%88%D9%87%D8%A7%D8%AA%20Bright%20AI';
---

<ArabicLayout
  title="30+ ديمو AI تفاعلي | مبيعات، توظيف، صحة"
  description="أكثر من 30 ديمو AI تفاعلي بالعربية: مبيعات، توظيف، خدمة عملاء، تحليل بيانات، OCR، صحة، تعليم. جرّب BrightAI مجاناً قبل قرار الشراء بدون أي التزام."
  canonical="https://brightai.site/demo/"
  hreflang={[{lang:'ar-SA',href:'https://brightai.site/demo/'},{lang:'x-default',href:'https://brightai.site/demo/'}]}
  jsonLd={demoJsonLd as any}
  currentPath="/demo/"
>

  {/* ═══════════ 1. HERO — page-hero with RTL eyebrow ═══════════ */}
  <section class="page-hero" aria-label="ديموهات BrightAI">
    <BackgroundGrid />
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <Breadcrumbs crumbs={crumbs} />
      <p class="inner-hero__eyebrow">هلا والله، نوّرت 👋</p>
      <h1 class="page-hero__title">جرّب <span class="gradient-text">سيناريوهات AI حقيقية</span> قبل ما تقرر</h1>
      <p class="page-hero__description">أكبر مجموعة ديموهات ذكاء اصطناعي تفاعلية بالعربية في السعودية. اختر التصنيف اللي يناسب شغلك، شغّل سيناريو سعودي، وشوف كيف BrightAI يحمي بياناتك — بعدين قرّر.</p>
      <div class="inner-hero__points">
        <span>أكثر من 30 ديمو تفاعلي</span>
        <span>8 تصنيفات تجارية</span>
        <span>واجهة عربية من اليمين لليسار</span>
        <span>بيانات وهمية آمنة — لا تخزين</span>
      </div>
      <div class="about-hero__actions">
        <a href="/contact/" class="btn btn--glow">
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-calendar-check"></use></svg>
          احجز استشارة مجانية
        </a>
        <a href={whatsappDemoHref} target="_blank" rel="nofollow noopener noreferrer" class="btn btn--whatsapp">
          <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-whatsapp"></use></svg>
          اطلبها عبر واتساب
        </a>
      </div>
    </div>
  </section>

  {/* ═══════════ 2. QUICK STATS — at-a-glance metrics ═══════════ */}
  <section class="inner-section" aria-labelledby="demo-quick-stats">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="demo-quick-stats" class="inner-section__title">لمحة سريعة</h2>
      <p class="inner-section__lead">كل اللي تحتاجه قبل ما تبدأ تجربة الديموهات.</p>
      <div class="demo-stat-strip">
        {demoStats.map(s => (
          <div class="demo-stat-strip__item">
            <div class="demo-stat-strip__value">{s.value}</div>
            <div class="demo-stat-strip__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 3. WHAT TO EXPECT — 3-step timeline (NEW) ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="demo-expect-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">وش تتوقع من الديموهات؟</p>
      <h2 id="demo-expect-title" class="inner-section__title">ثلاث خطوات من الاستكشاف إلى القرار</h2>
      <p class="inner-section__lead">ما تحتاج تجهيز شي. ادخل، جرّب، قرّر بعدين.</p>
      <div class="demo-expect-timeline">
        {demoExpectations.map((s, i) => (
          <div class="demo-expect-step">
            <div class="demo-expect-step__num">{s.n}</div>
            <h3 class="demo-expect-step__title">{s.title}</h3>
            <p class="demo-expect-step__body">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 4. TAXONOMY — 8 categories ═══════════ */}
  <section class="inner-section" aria-labelledby="taxonomy-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="taxonomy-heading" class="inner-section__title">تصنيفات الديموهات</h2>
      <p class="inner-section__lead">اختر التصنيف اللي يناسب قطاعك، أو استعرض الديموهات تحت كل تصنيف مباشرة.</p>
      <div class="grid grid--4">
        {taxonomy.map(t => (
          <div class="card card--feature">
            <h3 class="inner-card__title">{t.title}</h3>
            <p class="inner-card__text">{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 5. SALES DEMOS — 6 cards ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="sales-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="sales-heading" class="inner-section__title">ديموهات المبيعات والتسويق</h2>
      <div class="grid grid--3">
        {salesDemos.map(d => (
          <article class="card card--feature card--lg">
            <h3 class="inner-card__title">{d.title}</h3>
            <p class="inner-card__text">{d.desc}</p>
            <a href="/contact/" class="btn btn--outline card__pricing-cta">احجز ديمو مخصص</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 6. HR DEMOS ═══════════ */}
  <section class="inner-section" aria-labelledby="hiring-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="hiring-heading" class="inner-section__title">ديموهات التوظيف والموارد البشرية</h2>
      <div class="grid grid--2">
        {hiringDemos.map(d => (
          <article class="card card--feature card--lg">
            <h3 class="inner-card__title">{d.title}</h3>
            <p class="inner-card__text">{d.desc}</p>
            <a href="/contact/" class="btn btn--outline card__pricing-cta">احجز ديمو مخصص</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 7. SUPPORT DEMOS ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="support-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="support-heading" class="inner-section__title">ديموهات خدمة العملاء</h2>
      <div class="grid grid--2">
        {supportDemos.map(d => (
          <article class="card card--feature card--lg">
            <h3 class="inner-card__title">{d.title}</h3>
            <p class="inner-card__text">{d.desc}</p>
            <a href="/contact/" class="btn btn--outline card__pricing-cta">احجز ديمو مخصص</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 8. DATA ANALYTICS DEMOS ═══════════ */}
  <section class="inner-section" aria-labelledby="data-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="data-heading" class="inner-section__title">ديموهات تحليل البيانات</h2>
      <div class="grid grid--3">
        {dataDemos.map(d => (
          <article class="card card--feature card--lg">
            <h3 class="inner-card__title">{d.title}</h3>
            <p class="inner-card__text">{d.desc}</p>
            <a href="/contact/" class="btn btn--outline card__pricing-cta">احجز ديمو مخصص</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 9. OCR DEMOS ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="ocr-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="ocr-heading" class="inner-section__title">ديموهات OCR والوثائق</h2>
      <div class="grid grid--2">
        {ocrDemos.map(d => (
          <article class="card card--feature card--lg">
            <h3 class="inner-card__title">{d.title}</h3>
            <p class="inner-card__text">{d.desc}</p>
            <a href="/contact/" class="btn btn--outline card__pricing-cta">احجز ديمو مخصص</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 10. HEALTHCARE DEMOS ═══════════ */}
  <section class="inner-section" aria-labelledby="healthcare-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="healthcare-heading" class="inner-section__title">ديموهات الرعاية الصحية</h2>
      <div class="grid grid--3">
        {healthcareDemos.map(d => (
          <article class="card card--feature card--lg">
            <h3 class="inner-card__title">{d.title}</h3>
            <p class="inner-card__text">{d.desc}</p>
            <a href={d.href} class="btn btn--outline card__pricing-cta">{d.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 11. EDUCATION DEMOS ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="education-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="education-heading" class="inner-section__title">ديموهات التعليم والتدريب</h2>
      <div class="grid grid--2">
        {educationDemos.map(d => (
          <article class="card card--feature card--lg">
            <h3 class="inner-card__title">{d.title}</h3>
            <p class="inner-card__text">{d.desc}</p>
            <a href="/contact/" class="btn btn--outline card__pricing-cta">احجز ديمو مخصص</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 12. OTHER DEMOS ═══════════ */}
  <section class="inner-section" aria-labelledby="other-heading">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="other-heading" class="inner-section__title">ديموهات إضافية</h2>
      <div class="grid grid--4">
        {otherDemos.map(d => (
          <article class="card card--feature card--lg">
            <h3 class="inner-card__title">{d.title}</h3>
            <p class="inner-card__text">{d.desc}</p>
            <a href={d.href || '/contact/'} class="btn btn--outline card__pricing-cta">{d.cta || 'احجز ديمو مخصص'}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 13. TESTIMONIALS — NEW section ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="demo-testimonials-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">من جرّب الديموهات</p>
      <h2 id="demo-testimonials-title" class="inner-section__title">وش يقول اللي جرّب الديموهات فعلاً؟</h2>
      <p class="inner-section__lead">آراء حقيقية من فرق سعودية استخدمت الديموهات قبل ما تقرر التعاون.</p>
      <div class="grid grid--3">
        {testimonials.map(t => (
          <article class="card card--feature card--gradient card--lg">
            <div class="avatar-tile avatar-tile--mb-4" aria-hidden="true">{t.initials}</div>
            <p class="inner-card__text quote-block">"{t.quote}"</p>
            <div class="quote-footer">
              <strong class="text-cyan-300 block">{t.role}</strong>
              <span class="text-sm">{t.org}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 14. FAQ — preserved verbatim ═══════════ */}
  <section class="inner-section" aria-labelledby="faq-heading">
    <div class="max-w-4xl mx-auto px-5 lg:px-8">
      <h2 id="faq-heading" class="inner-section__title">الأسئلة الشائعة عن ديموهات BrightAI</h2>
      <div class="inner-faq" role="list">
        {faqs.map(([question, answer], i) => (
          <details class="card card--glass home-faq-item" role="listitem" open={i === 0}>
            <summary>
              <span>{question}</span>
              <svg class="home-faq-chevron" aria-hidden="true" width="1.25em" height="1.25em"><use href="/icons.svg#mdi-chevron-down"></use></svg>
            </summary>
            <div class="home-faq-answer"><p>{answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 15. FINAL CTA — canonical inner-cta-final ═══════════ */}
  <section class="inner-cta-final">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="inner-cta-final__card card card--cta">
        <h2 class="inner-cta-final__title">خلّ BrightAI يضبطها لك بمقاسك</h2>
        <p class="inner-cta-final__desc">ابدأ بالديمو الأقرب لحالتك، ثم احجز مكالمة قصيرة عشان نحوله إلى تطبيق مرتبط ببيانات شركتك.</p>
        <div class="inner-cta-final__actions">
          <a href="/contact/" class="btn btn--glow">
            <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-calendar-check"></use></svg>
            احجز استشارة مجانية
          </a>
          <a href={whatsappDemoHref + ' ' + encodeURIComponent('واختيار الأنسب لشركتي')} target="_blank" rel="nofollow noopener noreferrer" class="btn btn--whatsapp">
            <svg aria-hidden="true" width="20" height="20"><use href="/icons.svg#mdi-whatsapp"></use></svg>
            اطلبها عبر واتساب
          </a>
        </div>
      </div>
    </div>
  </section>
</ArabicLayout>
