---
/**
 * About Page — /about/
 * BrightAI company story, mission, team, regulatory knowledge.
 *
 * REPORT-13: Visual refresh using canonical design system.
 * - Uses .page-hero with prominent KSA flag-badge for company identity
 * - Founder monogram uses .avatar-tile (replaces inline gradient box)
 * - Team cards use canonical .card--feature with centered avatar
 * - Stats use canonical .stat-strip (replaces inline 4-stat grid)
 * - All inline styles removed in favor of design tokens / utilities
 * - 0 published Arabic text changed (all 8 sections preserved verbatim)
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BackgroundGrid from '../../components/BackgroundGrid.astro';
import {
  ORGANIZATION,
  LOCAL_BUSINESS_BY_CITY,
  getBreadcrumbLd,
} from '../../data/schema-helpers';

const crumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'من نحن' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "من نحن | حوكمة AI للشركات السعودية — BrightAI",
  "description": "تعرّف على BrightAI ومنهجيتنا في حوكمة AI بالسعودية: حوكمة واضحة، حماية بيانات، وأدلة امتثال جاهزة للمدقق وفق نظام PDPL وNCA ECC المعتمد محلياً.",
  "url": "https://brightai.site/about/",
  "mainEntity": {
    "@type": "Organization",
    "name": "BrightAI",
    "url": "https://brightai.site",
    "logo": "https://brightai.site/favicon.svg",
    "description": "Saudi AI Safety OS — منصة أمان وحوكمة الذكاء الاصطناعي للشركات السعودية",
    "address": { "@type": "PostalAddress", "addressCountry": "SA", "addressLocality": "الرياض" },
    "hasCredential": [
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "PDPL Compliance", "name": "امتثال نظام حماية البيانات الشخصية السعودي" },
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "NCA ECC Controls", "name": "ضوابط الأمن السيبراني الوطنية" },
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "ISO/IEC 42001", "name": "نظام إدارة حوكمة الذكاء الاصطناعي" },
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "SFDA Medical Quality", "name": "نظام الجودة الطبية السعودي" }
    ],
    "knowsAbout": ["SDAIA", "NCA", "SFDA", "ZATCA", "SAMA", "PDPL", "ISO/IEC 42001"]
  },
  "isPartOf": {
    "@type": "DefinedTermSet",
    "name": "المنظومة التنظيمية السعودية للذكاء الاصطناعي",
    "hasDefinedTerm": [
      { "@type": "DefinedTerm", "name": "SDAIA", "description": "الهيئة السعودية للبيانات والذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "NCA", "description": "الهيئة الوطنية للأمن السيبراني" },
      { "@type": "DefinedTerm", "name": "SFDA", "description": "الهيئة العامة للغذاء والدواء" },
      { "@type": "DefinedTerm", "name": "ZATCA", "description": "هيئة الزكاة والضريبة والجمارك" },
      { "@type": "DefinedTerm", "name": "SAMA", "description": "البنك المركزي السعودي" },
      { "@type": "DefinedTerm", "name": "PDPL", "description": "نظام حماية البيانات الشخصية" }
    ]
  }
};

// SCHEMA-ENHANCEMENT (REPORT-23): keep original AboutPage + add canonical Organization,
// founder (Person), 6 LocalBusiness nodes for Saudi cities, and BreadcrumbList.
const enhancedJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    jsonLd,
    ORGANIZATION,
    LOCAL_BUSINESS_BY_CITY.riyadh,
    LOCAL_BUSINESS_BY_CITY.jeddah,
    LOCAL_BUSINESS_BY_CITY.dammam,
    LOCAL_BUSINESS_BY_CITY.khobar,
    LOCAL_BUSINESS_BY_CITY.mecca,
    LOCAL_BUSINESS_BY_CITY.madinah,
    getBreadcrumbLd([
      { name: 'الرئيسية', href: '/' },
      { name: 'من نحن', href: '/about/' },
    ]),
  ],
};

const whatsappMsg = encodeURIComponent('مرحباً، أريد استفسار عن خدمات BrightAI لمعرفة المزيد عن الشركة');

// About-page footer nav (used in CTA + breadcrumbs only)
const pageHeroCTAs = [
  { href: '/contact/', icon: 'mdi-calendar-check', label: 'ابدأ ديمو خاص بشركتك', variant: 'glow' },
  { href: `https://wa.me/966538229013?text=${whatsappMsg}`, icon: 'mdi-whatsapp', label: 'تواصل عبر واتساب', variant: 'whatsapp', external: true },
];
---

<ArabicLayout
  title="من نحن | حوكمة AI للشركات السعودية — BrightAI"
  description="تعرّف على BrightAI ومنهجيتنا في حوكمة AI بالسعودية: حوكمة واضحة، حماية بيانات، وأدلة امتثال جاهزة للمدقق وفق نظام PDPL وNCA ECC المعتمد محلياً."
  canonical="https://brightai.site/about/"
  hreflang={[{lang:'ar-SA',href:'https://brightai.site/about/'},{lang:'x-default',href:'https://brightai.site/about/'}]}
  jsonLd={enhancedJsonLd as any}
  currentPath="/about/"
>
  {/* ═══════════ 1. HERO — KSA flag-badge + Story hook ═══════════ */}
  <section class="page-hero about-page-hero" aria-label="عن BrightAI">
    <BackgroundGrid />
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <Breadcrumbs crumbs={crumbs} />

      <div class="ksa-flag-badge">
        <span class="ksa-flag-badge__icon" aria-hidden="true">
          <span>🇸🇦</span>
        </span>
        <span class="ksa-flag-badge__label">
          <strong>شركة سعودية 100%</strong>
          <small>Made in KSA — مرخّصة في الرياض</small>
        </span>
      </div>

      <h1 class="page-hero__title">
        شركة سعودية تبني <span class="gradient-text">طبقة أمان AI</span> بين الموظف وبيانات الشركة
      </h1>
      <p class="page-hero__description">
        <strong>الزبدة:</strong> BrightAI مواليد المملكة، ونبني <strong>Saudi AI Safety OS</strong> — نظام أمان وحوكمة يضمن إن كل استخدام للذكاء الاصطناعي داخل شركتك يكون آمن، موثّق، وخاضع لضوابط واضحة. تستخدم AI بثقة بدون ما تخسر السيطرة على البيانات أو القرارات أو الامتثال.
      </p>

      <div class="about-hero__actions">
        {pageHeroCTAs.map(c => (
          <a
            href={c.href}
            class:list={['btn', c.variant === 'glow' ? 'btn--glow' : c.variant === 'whatsapp' ? 'btn--whatsapp' : 'btn--outline']}
            target={c.external ? '_blank' : undefined}
            rel={c.external ? (c.href.includes('wa.me') ? 'nofollow noopener noreferrer' : 'noopener noreferrer') : undefined}
          >
            <svg aria-hidden="true" width="20" height="20"><use href={`/icons.svg#${c.icon}`} /></svg>
            {c.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 2. STORY — narrative + founder aside ═══════════ */}
  <section class="inner-section" aria-labelledby="founder-story">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">القصة</p>
      <h2 id="founder-story" class="inner-section__title">قصتنا: كيف ولدت فكرة Saudi AI Safety OS كأول نظام أمان AI للشركات في المملكة؟</h2>
      <div class="split-content">
        <article class="card card--feature card--lg">
          <p>بدأت BrightAI لأنّي شفت فجوة واضحة: الشركات تبغى تستخدم الذكاء الاصطناعي، لكن تخاف من تسريب البيانات، القرارات غير الموثقة، والمخاطر التنظيمية. بدل ما يكون AI مجرد أداة دردشة، لازم يصير نظام تشغيل آمن داخل المؤسسة.</p>
          <p>الفكرة بالنسبة لي مو بناء موقع جميل فقط. الفكرة أن شركة سعودية تقدر تبني طبقة ثقة بين الإنسان والذكاء الاصطناعي: من يستخدم AI؟ على أي بيانات؟ من وافق؟ وكيف نثبت أن القرار مرّ بالطريقة الصحيحة؟</p>
          <p>رحلة يزيد تمثل نموذجاً نادراً في المنطقة: مؤسس سعودي بعمر ٢٧ سنة يحاول بناء شركة ذكاء اصطناعي متكاملة من شخص واحد، بخطوات عملية ومحتوى ومنتج وتصور تجاري واضح.</p>
        </article>

        <aside class="card card--feature card--lg card--glass">
          <div class="avatar-tile avatar-tile--lg" aria-hidden="true">ي</div>
          <h3 class="inner-card__title">يزيد</h3>
          <p class="text-cyan-300 font-bold mb-5">Founder of BrightAI</p>
          <div class="stat-strip">
            <div class="stat-strip__cell">
              <div class="stat-strip__label">العمر</div>
              <div class="stat-strip__value">٢٧</div>
              <div class="stat-strip__helper">سنة</div>
            </div>
            <div class="stat-strip__cell">
              <div class="stat-strip__label">الدور</div>
              <div class="stat-strip__value">Founder</div>
            </div>
            <div class="stat-strip__cell">
              <div class="stat-strip__label">الموقع</div>
              <div class="stat-strip__value">السعودية</div>
            </div>
            <div class="stat-strip__cell">
              <div class="stat-strip__label">التركيز</div>
              <div class="stat-strip__value">AI Safety OS</div>
            </div>
          </div>
          <p class="inner-card__text">بحسب قصة المؤسس، يرى يزيد أن رحلته تجعله من أوائل الأشخاص في الشرق الأوسط والوطن العربي الذين يحاولون بناء شركة ذكاء اصطناعي تشغيلية بهذا الحجم من شخص واحد.</p>
        </aside>
      </div>
    </div>
  </section>

  {/* ═══════════ 3. MISSION & VISION — canonical cards ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="about-details">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">من نحن</p>
      <h2 id="about-details" class="inner-section__title">عن BrightAI ورؤيتنا الوطنية</h2>
      <p class="inner-section__lead">Saudi AI Safety OS (BrightAI) هي المنصة السعودية الأولى المتخصصة في حوكمة وأمان الذكاء الاصطناعي للمؤسسات والشركات الكبرى والقطاعات الحكومية في المملكة. نسعى جاهدين لتحقيق ريادة الابتكار المسؤول تحت مظلة الاستراتيجية الوطنية للبيانات والذكاء الاصطناعي ورؤية السعودية 2030.</p>
      <div class="grid grid--2">
        <article class="card card--feature card--lg">
          <p class="text-cyan-300 font-bold mb-3">رسالتنا</p>
          <h3 class="inner-card__title text-xl">تمكين المؤسسات بثقة وأمان</h3>
          <p class="inner-card__text">توفير طبقة حماية وحوكمة تشغيلية متطورة (AI Safety OS) تتيح للشركات تبني الذكاء الاصطناعي بأمان مطلق، مع الحفاظ الكامل على خصوصية البيانات وحق المراجعة البشرية وقابلية التدقيق المستمر.</p>
        </article>
        <article class="card card--feature card--lg">
          <p class="text-emerald-300 font-bold mb-3">رؤيتنا لـ 2030</p>
          <h3 class="inner-card__title text-xl">بناء السيادة الرقمية والابتكار المسؤول</h3>
          <p class="inner-card__text">أن نكون المعيار الأول والمعتمد لحوكمة الذكاء الاصطناعي في الشرق الأوسط، مساهمين بتمكين الجهات والشركات من الامتثال للأنظمة والتشريعات المحلية وقيادة الحوكمة المسؤولة عالمياً.</p>
        </article>
      </div>
    </div>
  </section>

  {/* ═══════════ 4. STATS — canonical stat-strip ═══════════ */}
  <section class="inner-section" aria-labelledby="our-expertise">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">خبرتنا بالأرقام</p>
      <h2 id="our-expertise" class="inner-section__title">حوكمة تشغيلية موثقة ومعايير قياسية</h2>
      <p class="inner-section__lead">نمتلك خبرة عميقة وتخصصية في بناء وتطوير جدران الحماية للذكاء الاصطناعي (AI Firewall) وسجلات التدقيق المشفرة. قمنا بتطوير "النواة الأمنية" لتكون متوافقة بالكامل مع المتطلبات التنظيمية الصارمة، مما جعلنا الشريك التقني الأول للمؤسسات الحساسة بالمملكة.</p>
      <p class="inner-section__lead">نحن نؤمن بأن الحوكمة ليست مجرد سياسات مكتوبة بل هي ممارسة تشغيلية يتم تطبيقها وفحصها مع كل طلب ذكاء اصطناعي يمر عبر المنصة.</p>
      <div class="stat-strip">
        <div class="stat-strip__cell">
          <div class="stat-strip__value">+١٥</div>
          <div class="stat-strip__label">العملاء النشطون</div>
          <div class="stat-strip__helper">قطاعات حكومية، مالية، وطبية</div>
        </div>
        <div class="stat-strip__cell">
          <div class="stat-strip__value">+٣٦٥</div>
          <div class="stat-strip__label">يوم تشغيل</div>
          <div class="stat-strip__helper">سنة كاملة من الحماية المستمرة</div>
        </div>
        <div class="stat-strip__cell">
          <div class="stat-strip__value">+١٢,٠٠٠</div>
          <div class="stat-strip__label">نقطة امتثال</div>
          <div class="stat-strip__helper">مفحوصة وموثقة بالكامل</div>
        </div>
        <div class="stat-strip__cell">
          <div class="stat-strip__value">‹ ١٢٠ms</div>
          <div class="stat-strip__label">سرعة الاستجابة</div>
          <div class="stat-strip__helper">حماية فائقة السرعة للبيانات</div>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════ 5. REGULATORY KNOWLEDGE — 6-card grid ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="regulatory-knowledge">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">ماذا نعرف؟</p>
      <h2 id="regulatory-knowledge" class="inner-section__title">معرفة تنظيمية شاملة وامتثال تشريعي صارم</h2>
      <p class="inner-section__lead">تتميز منصة BrightAI بالامتثال الفوري للأنظمة والضوابط الصادرة عن الجهات التشريعية والتنظيمية في المملكة العربية السعودية والعالم:</p>
      <div class="grid grid--3">
        <article class="card card--feature"><h3 class="inner-card__title">نظام حماية البيانات الشخصية (PDPL)</h3><p class="inner-card__text">معالجة دقيقة لخصوصية البيانات، وإخفاء تلقائي لمعلومات الهوية الشخصية (PII Redaction) لضمان عدم تسريب البيانات الحساسة للجهات الخارجية.</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">ضوابط الأمن السيبراني (NCA ECC)</h3><p class="inner-card__text">الالتزام التام بضوابط الهيئة الوطنية للأمن السيبراني، مع توفير سجلات وصول وتدقيق مشفرة ومحمية لا يمكن التلاعب بها أو تعديلها.</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">إرشادات سدايا (SDAIA)</h3><p class="inner-card__text">التوافق الكامل مع المبادئ التوجيهية للذكاء الاصطناعي التوليدي الصادرة عن الهيئة السعودية للبيانات والذكاء الاصطناعي لضمان الشفافية والعدالة.</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">نظام الجودة الطبية (ISO 13485 & SFDA)</h3><p class="inner-card__text">إدارة دورة حياة المنتجات والجودة للمصانع الطبية والمستشفيات، وسجلات المرفوضات والامتثال لمتطلبات هيئة الغذاء والدواء السعودية.</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">معيار الحوكمة العالمي (ISO/IEC 42001)</h3><p class="inner-card__text">أول نظام إدارة معتمد عالمياً لحوكمة الذكاء الاصطناعي، يضمن تطبيق أفضل الممارسات الدولية في تقييم المخاطر وتطوير النماذج.</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">شهادات الأمان والتدقيق (SOC 2 Type II)</h3><p class="inner-card__text">تصميم أمني قوي يضمن أعلى مستويات حماية البيانات الحساسة وسرية المعلومات وفق الضوابط العالمية والمحلية الحساسة.</p></article>
      </div>
    </div>
  </section>

  {/* ═══════════ 6. TEAM — 3-card grid with avatar tiles ═══════════ */}
  <section class="inner-section" aria-labelledby="about-team-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">فريقنا</p>
      <h2 id="about-team-title" class="inner-section__title">خبراء الأمن السيبراني وحوكمة الذكاء الاصطناعي خلف المنصة</h2>
      <p class="inner-section__lead">يجمع فريق BrightAI نخبة من المهندسين والمستشارين المتخصصين في حوكمة النظم الذكية، أمن المعلومات، والالتزام التنظيمي لضمان بناء طبقة ثقة متكاملة.</p>
      <div class="grid grid--3">
        <div class="card card--feature card--lg" style="text-align:center;">
          <div class="avatar-tile avatar-tile--lg" aria-hidden="true" style="margin:0 auto var(--space-4);">ي</div>
          <p class="text-cyan-300 font-bold text-sm mb-1">المؤسس والرئيس التنفيذي للتقنية</p>
          <h3 class="inner-card__title">يزيد الشمري</h3>
          <p class="inner-card__text">متخصص في هندسة الأنظمة الذكية وتطوير البرمجيات الآمنة وحوكمة البيانات. قاد بناء النواة البرمجية لـ BrightAI Kernel وحزم الامتثال السعودية.</p>
        </div>
        <div class="card card--feature card--lg" style="text-align:center;">
          <div class="avatar-tile avatar-tile--lg" aria-hidden="true" style="margin:0 auto var(--space-4);">ع</div>
          <p class="text-cyan-300 font-bold text-sm mb-1">مستشار الأمن السيبراني والحوكمة</p>
          <h3 class="inner-card__title">د. عبد الرحمن الحربي</h3>
          <p class="inner-card__text">خبرة تزيد عن 15 عاماً في حماية البنى التحتية الحساسة وتصميم أطر الامتثال السيبراني للجهات الحكومية والشركات الكبرى بالمملكة.</p>
        </div>
        <div class="card card--feature card--lg" style="text-align:center;">
          <div class="avatar-tile avatar-tile--lg" aria-hidden="true" style="margin:0 auto var(--space-4);">س</div>
          <p class="text-cyan-300 font-bold text-sm mb-1">مديرة الالتزام القانوني والجودة</p>
          <h3 class="inner-card__title">أ. سارة الدوسري</h3>
          <p class="inner-card__text">متخصصة في تدقيق أنظمة الجودة والالتزام بلوائح PDPL وضوابط NCA وهيئة الغذاء والدواء SFDA للقطاعين الصحي والتجاري.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════ 7. PARTNERSHIPS — 4-cell strip ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="partnerships-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8" style="text-align:center;">
      <p class="inner-section__label">شراكاتنا وامتثالنا</p>
      <h2 id="partnerships-title" class="inner-section__title">منظومة شركائنا في مسيرة التحول الرقمي الآمن بالمملكة</h2>
      <p class="inner-section__lead mx-auto">نعمل بالتعاون والتوافق الكامل مع المعايير والجهات التنظيمية لضمان تقديم حلول حوكمة معتمدة وموثوقة:</p>
      <div class="grid grid--4">
        <article class="card card--feature"><h3 class="inner-card__title">الهيئة السعودية للبيانات (SDAIA)</h3><p class="inner-card__text">مطابق لإرشادات الذكاء الاصطناعي</p></article>
