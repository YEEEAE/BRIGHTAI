---
/**
 * About Page — /about/
 * BrightAI company story, mission, team, regulatory knowledge.
 *
 * REPORT-13: Visual refresh using canonical design system.
 * - Uses .page-hero with prominent KSA flag-badge for company identity
 * - Founder monogram uses .avatar-tile (replaces inline gradient box)
 * - Team cards use canonical .card--feature with centered avatar
 * - Stats use canonical .stat-strip (replaces inline 4-stat grid)
 * - All inline styles removed in favor of design tokens / utilities
 * - 0 published Arabic text changed (all 8 sections preserved verbatim)
 */
import ArabicLayout from '../../layouts/ArabicLayout.astro';
import BackgroundGrid from '../../components/BackgroundGrid.astro';
import { LOCAL_BUSINESS_BY_CITY } from '../../data/schema-helpers';
import { SITE } from '../../data/site';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "من نحن | حوكمة AI للشركات السعودية — BrightAI",
  "description": "تعرّف على BrightAI ومنهجيتنا العملية في حوكمة وأمان الذكاء الاصطناعي للمؤسسات في السعودية.",
  "url": "https://brightai.site/about/",
  "mainEntity": {
    "@id": `${SITE.url}/#organization`,
    "@type": "Organization"
  },
  "isPartOf": {
    "@type": "DefinedTermSet",
    "name": "المنظومة التنظيمية السعودية للذكاء الاصطناعي",
    "hasDefinedTerm": [
      { "@type": "DefinedTerm", "name": "SDAIA", "description": "الهيئة السعودية للبيانات والذكاء الاصطناعي" },
      { "@type": "DefinedTerm", "name": "NCA", "description": "الهيئة الوطنية للأمن السيبراني" },
      { "@type": "DefinedTerm", "name": "SFDA", "description": "الهيئة العامة للغذاء والدواء" },
      { "@type": "DefinedTerm", "name": "ZATCA", "description": "هيئة الزكاة والضريبة والجمارك" },
      { "@type": "DefinedTerm", "name": "SAMA", "description": "البنك المركزي السعودي" },
      { "@type": "DefinedTerm", "name": "PDPL", "description": "نظام حماية البيانات الشخصية" }
    ]
  }
};

// SCHEMA-ENHANCEMENT (REPORT-23): keep original AboutPage + 6 LocalBusiness
// nodes for Saudi cities. Organization, BreadcrumbList, and WebSite are
// emitted by the foundation Schema.astro — adding them here would create
// duplicate @id warnings (verified via scripts/_check-duplicate-schema-ids.mjs).
const enhancedJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    jsonLd,
    LOCAL_BUSINESS_BY_CITY.riyadh,
    LOCAL_BUSINESS_BY_CITY.jeddah,
    LOCAL_BUSINESS_BY_CITY.dammam,
    LOCAL_BUSINESS_BY_CITY.khobar,
    LOCAL_BUSINESS_BY_CITY.mecca,
    LOCAL_BUSINESS_BY_CITY.madinah,
  ],
};

const whatsappMsg = encodeURIComponent('مرحباً، أريد استفسار عن خدمات BrightAI لمعرفة المزيد عن الشركة');

// About-page footer nav (used in CTA + breadcrumbs only)
const pageHeroCTAs = [
  { href: '/contact/', icon: 'mdi-calendar-check', label: 'ابدأ ديمو خاص بشركتك', variant: 'glow' },
  { href: `https://wa.me/966538229013?text=${whatsappMsg}`, icon: 'mdi-whatsapp', label: 'تواصل عبر واتساب', variant: 'whatsapp', external: true },
];
---

<ArabicLayout
  title="من نحن | حوكمة AI للشركات السعودية — BrightAI"
  description="تعرّف على BrightAI ومنهجيتنا العملية في حوكمة وأمان الذكاء الاصطناعي للمؤسسات في السعودية."
  canonical="https://brightai.site/about/"
  hreflang={[{lang:'ar-SA',href:'https://brightai.site/about/'},{lang:'x-default',href:'https://brightai.site/about/'}]}
  jsonLd={enhancedJsonLd as any}
  currentPath="/about/"
  breadcrumbs={[{ name: 'من نحن', href: 'https://brightai.site/about/' }]}
>
  {/* ═══════════ 1. HERO — KSA flag-badge + Story hook ═══════════ */}
  <section class="page-hero about-page-hero" aria-label="عن BrightAI">
    <BackgroundGrid />
    <div class="max-w-7xl mx-auto px-5 lg:px-8">

      <div class="ksa-flag-badge">
        <span class="ksa-flag-badge__icon" aria-hidden="true">
          <span>🇸🇦</span>
        </span>
        <span class="ksa-flag-badge__label">
        <strong>شركة سعودية</strong>
          <small>Made in KSA — مقر التواصل في الرياض</small>
        </span>
      </div>

      <h1 class="page-hero__title">
        شركة سعودية تبني <span class="gradient-text">طبقة أمان AI</span> بين الموظف وبيانات الشركة
      </h1>
      <p class="page-hero__description">
        <strong>الزبدة:</strong> BrightAI مواليد المملكة، ونبني <strong>Saudi AI Safety OS</strong> — نظام أمان وحوكمة يضمن إن كل استخدام للذكاء الاصطناعي داخل شركتك يكون آمن، موثّق، وخاضع لضوابط واضحة. تستخدم AI بثقة بدون ما تخسر السيطرة على البيانات أو القرارات أو الامتثال.
      </p>
      <p class="page-hero__meta">آخر تحديث: <time datetime="2026-08-24">24 أغسطس 2026</time> · نوضح المنهجية والمصادر وحدود ما تدّعيه المنصة.</p>

      <div class="about-hero__actions">
        {pageHeroCTAs.map(c => (
          <a
            href={c.href}
            class:list={['btn', c.variant === 'glow' ? 'btn--glow' : c.variant === 'whatsapp' ? 'btn--whatsapp' : 'btn--outline']}
            target={c.external ? '_blank' : undefined}
            rel={c.external ? (c.href.includes('wa.me') ? 'nofollow noopener noreferrer' : 'noopener noreferrer') : undefined}
          >
            <svg aria-hidden="true" width="20" height="20"><use href={`/icons.svg#${c.icon}`} /></svg>
            {c.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════ 2. STORY — narrative + founder aside ═══════════ */}
  <section class="inner-section" aria-labelledby="founder-story">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">القصة</p>
      <h2 id="founder-story" class="inner-section__title">قصتنا: كيف ولدت فكرة Saudi AI Safety OS كنظام أمان AI للشركات في المملكة؟</h2>
      <div class="split-content">
        <article class="card card--feature card--lg">
          <p>بدأت BrightAI لأنّي شفت فجوة واضحة: الشركات تبغى تستخدم الذكاء الاصطناعي، لكن تخاف من تسريب البيانات، القرارات غير الموثقة، والمخاطر التنظيمية. بدل ما يكون AI مجرد أداة دردشة، لازم يصير نظام تشغيل آمن داخل المؤسسة.</p>
          <p>الفكرة بالنسبة لي مو بناء موقع جميل فقط. الفكرة أن شركة سعودية تقدر تبني طبقة ثقة بين الإنسان والذكاء الاصطناعي: من يستخدم AI؟ على أي بيانات؟ من وافق؟ وكيف نثبت أن القرار مرّ بالطريقة الصحيحة؟</p>
          <p>يقود يزيد بناء المنتج والمحتوى التشغيلي من السعودية، مع تركيز واضح على تحويل حوكمة الذكاء الاصطناعي من سياسة مكتوبة إلى ضوابط ومسارات وأدلة قابلة للمراجعة.</p>
        </article>

        <aside class="card card--feature card--lg card--glass">
          <div class="avatar-tile avatar-tile--lg about-founder__avatar" aria-hidden="true">ي</div>
          <h3 class="inner-card__title">يزيد البديوي</h3>
          <p class="text-cyan-300 font-bold mb-5">Founder of BrightAI</p>
          <div class="stat-strip">
            <div class="stat-strip__cell">
              <div class="stat-strip__label">بداية BrightAI</div>
              <div class="stat-strip__value">٢٠٢٥</div>
              <div class="stat-strip__helper">سنة التأسيس المنشورة</div>
            </div>
            <div class="stat-strip__cell">
              <div class="stat-strip__label">الدور</div>
              <div class="stat-strip__value">Founder</div>
            </div>
            <div class="stat-strip__cell">
              <div class="stat-strip__label">الموقع</div>
              <div class="stat-strip__value">السعودية</div>
            </div>
            <div class="stat-strip__cell">
              <div class="stat-strip__label">التركيز</div>
              <div class="stat-strip__value">AI Safety OS</div>
            </div>
          </div>
          <p class="inner-card__text">تركيز المؤسس هو بناء طبقة تشغيل سعودية تربط الاستخدامات والسياسات والمخاطر والموافقات والأدلة داخل مسار واحد قابل للمراجعة.</p>
        </aside>
      </div>
    </div>
  </section>

  {/* ═══════════ 3. MISSION & VISION — canonical cards ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="about-details">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">من نحن</p>
      <h2 id="about-details" class="inner-section__title">عن BrightAI ورؤيتنا الوطنية</h2>
      <p class="inner-section__lead">Saudi AI Safety OS (BrightAI) هي منصة سعودية متخصصة في حوكمة وأمان الذكاء الاصطناعي للمؤسسات والشركات الكبرى والقطاعات الحكومية في المملكة. نسعى جاهدين لتحقيق ريادة الابتكار المسؤول تحت مظلة الاستراتيجية الوطنية للبيانات والذكاء الاصطناعي ورؤية السعودية 2030.</p>
      <div class="grid grid--2">
        <article class="card card--feature card--lg">
          <p class="text-cyan-300 font-bold mb-3">رسالتنا</p>
          <h3 class="inner-card__title text-xl">تمكين المؤسسات بثقة وأمان</h3>
          <p class="inner-card__text">توفير طبقة حماية وحوكمة تشغيلية متطورة (AI Safety OS) تتيح للشركات تبني الذكاء الاصطناعي بأمان موثّق وقابل للمراجعة، مع الحفاظ على خصوصية البيانات وحق المراجعة البشرية وقابلية التدقيق المستمر.</p>
        </article>
        <article class="card card--feature card--lg">
          <p class="text-emerald-300 font-bold mb-3">رؤيتنا لـ 2030</p>
          <h3 class="inner-card__title text-xl">بناء السيادة الرقمية والابتكار المسؤول</h3>
          <p class="inner-card__text">أن نكون المعيار الأول والمعتمد لحوكمة الذكاء الاصطناعي في الشرق الأوسط، مساهمين بتمكين الجهات والشركات من الامتثال للأنظمة والتشريعات المحلية وقيادة الحوكمة المسؤولة عالمياً.</p>
        </article>
      </div>
    </div>
  </section>

  {/* ═══════════ 4. STATS — canonical stat-strip ═══════════ */}
  <section class="inner-section" aria-labelledby="our-expertise">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">خبرتنا بالأرقام</p>
      <h2 id="our-expertise" class="inner-section__title">حوكمة تشغيلية موثقة ومعايير قياسية</h2>
      <p class="inner-section__lead">نحوّل الحوكمة إلى مسار عملي: فحص للطلبات، تصنيف للمخاطر، سياسات، موافقات بشرية، وسجل أدلة يوضح ما حدث. هذه مخرجات يمكن للفريق مراجعتها وتطويرها مع تغيّر الاستخدامات والمتطلبات.</p>
      <p class="inner-section__lead">نحن نؤمن بأن الحوكمة ليست مجرد سياسات مكتوبة بل هي ممارسة تشغيلية يتم تطبيقها وفحصها مع كل طلب ذكاء اصطناعي يمر عبر المنصة.</p>
      <div class="stat-strip">
        <div class="stat-strip__cell">
          <div class="stat-strip__value">+٩</div>
          <div class="stat-strip__label">حلول حوكمة وتشغيل</div>
          <div class="stat-strip__helper">متكاملة ضمن منصة واحدة</div>
        </div>
        <div class="stat-strip__cell">
          <div class="stat-strip__value">+٣٠</div>
          <div class="stat-strip__label">دليلًا ووثيقة</div>
          <div class="stat-strip__helper">معرفية سعودية متخصصة</div>
        </div>
        <div class="stat-strip__cell">
          <div class="stat-strip__value">٣</div>
          <div class="stat-strip__label">أوضاع نشر</div>
          <div class="stat-strip__helper">SaaS · Hybrid · Air-Gapped</div>
        </div>
        <div class="stat-strip__cell">
          <div class="stat-strip__value">١٠٠٪</div>
          <div class="stat-strip__label">توثيق طلبات AI</div>
          <div class="stat-strip__helper">سجل تدقيق غير قابل للتعديل</div>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════ 5. REGULATORY KNOWLEDGE — 6-card grid ═══════════ */}
  <section class="inner-section inner-section--alt" aria-labelledby="regulatory-knowledge">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">ماذا نعرف؟</p>
      <h2 id="regulatory-knowledge" class="inner-section__title">مصادر تنظيمية ومنهجية تشغيل واضحة</h2>
      <p class="inner-section__lead">نستخدم المصادر الرسمية والمعايير ذات الصلة كسياق لتصميم الضوابط، ثم نفصل بينها وبين إرشادات BrightAI التنفيذية. المنصة تدعم الجاهزية ولا تمنح شهادة أو رأياً قانونياً.</p>
      <div class="grid grid--3">
        <article class="card card--feature"><h3 class="inner-card__title">نظام حماية البيانات الشخصية (PDPL)</h3><p class="inner-card__text">معالجة دقيقة لخصوصية البيانات، وإخفاء تلقائي لمعلومات الهوية الشخصية (PII Redaction) لضمان عدم تسريب البيانات الحساسة للجهات الخارجية.</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">ضوابط الأمن السيبراني (NCA ECC)</h3><p class="inner-card__text">دعم الالتزام بضوابط الهيئة الوطنية للأمن السيبراني، مع توفير سجلات وصول وتدقيق مشفرة ومحمية لا يمكن التلاعب بها أو تعديلها.</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">إرشادات سدايا (SDAIA)</h3><p class="inner-card__text">العمل وفق المبادئ التوجيهية للذكاء الاصطناعي التوليدي الصادرة عن الهيئة السعودية للبيانات والذكاء الاصطناعي لضمان الشفافية والعدالة.</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">نظام الجودة الطبية (ISO 13485 & SFDA)</h3><p class="inner-card__text">إدارة دورة حياة المنتجات والجودة للمصانع الطبية والمستشفيات، وسجلات المرفوضات والامتثال لمتطلبات هيئة الغذاء والدواء السعودية.</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">معيار إدارة AI (ISO/IEC 42001)</h3><p class="inner-card__text">نستخدمه كسياق للمفاهيم والأدوار والمخاطر، مع التحقق من النص الرسمي وتحديد ما ينطبق على كل مؤسسة.</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">ممارسات الأمان والتدقيق المؤسسية</h3><p class="inner-card__text">تصميم أمني قوي لحماية البيانات الحساسة وسرية المعلومات وفق ممارسات الضوابط العالمية والمحلية، مع أدلة تدقيق جاهزة للمراجعة.</p></article>
      </div>
    </div>
  </section>

  {/* ═══════════ 6. TEAM — 3-card grid with avatar tiles ═══════════ */}
  <section class="inner-section" aria-labelledby="about-team-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">أدوار العمل</p>
      <h2 id="about-team-title" class="inner-section__title">أدوار واضحة لبناء وتشغيل طبقة الحوكمة</h2>
      <p class="inner-section__lead">نعرض الأدوار المتاحة بوضوح بدل استخدام شارات ثقة أو أسماء لا توجد لها صفحات تعريف منشورة. التفاصيل العملية والمصادر وتاريخ التحديث هي أساس الثقة هنا.</p>
      <div class="grid grid--3">
        <div class="card card--feature card--lg about-team__card">
          <div class="avatar-tile avatar-tile--lg about-team__avatar" aria-hidden="true">ي</div>
          <p class="text-cyan-300 font-bold text-sm mb-1">المؤسس وباني المنتج</p>
          <h3 class="inner-card__title">يزيد البديوي</h3>
          <p class="inner-card__text">مسؤول عن اتجاه المنتج وبناء BrightAI Kernel وصياغة المنهجية المنشورة لحوكمة وأمان الذكاء الاصطناعي.</p>
        </div>
        <div class="card card--feature card--lg about-team__card">
          <div class="avatar-tile avatar-tile--lg about-team__avatar" aria-hidden="true">أ</div>
          <p class="text-cyan-300 font-bold text-sm mb-1">مراجعة هندسية</p>
          <h3 class="inner-card__title">دور تقني موثّق</h3>
          <p class="inner-card__text">يراجع تدفق البيانات، حدود التكامل، الفحص، التسجيل، ومسارات الفشل الآمن قبل اعتماد أي تغيير تشغيلي.</p>
        </div>
        <div class="card card--feature card--lg about-team__card">
          <div class="avatar-tile avatar-tile--lg about-team__avatar" aria-hidden="true">م</div>
          <p class="text-cyan-300 font-bold text-sm mb-1">مراجعة امتثال ومنهجية</p>
          <h3 class="inner-card__title">دور مراجعة موثّق</h3>
          <p class="inner-card__text">يربط المصادر الرسمية بالسياسات والضوابط والأدلة، ويحدد ما هو إرشاد BrightAI وما يحتاج قراراً قانونياً أو تنظيمياً من الجهة.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════ 7. PARTNERSHIPS — 4-cell strip ═══════════ */}
  <section class="inner-section inner-section--alt inner-section--centered" aria-labelledby="partnerships-title">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">المعايير والجهات التنظيمية</p>
      <h2 id="partnerships-title" class="inner-section__title">نعمل وفق ضوابط الجهات التنظيمية في مسيرة التحول الرقمي الآمن بالمملكة</h2>
      <p class="inner-section__lead">نلتزم بالعمل وفق مبادئ المعايير والجهات التنظيمية لتقديم حلول حوكمة موثوقة وقابلة للتدقيق — بدون ادعاء شراكة أو اعتماد تنظيمي:</p>
      <div class="grid grid--4">
        <article class="card card--feature"><h3 class="inner-card__title">الهيئة السعودية للبيانات (SDAIA)</h3><p class="inner-card__text">نعمل وفق إرشادات الذكاء الاصطناعي التوليدي</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">الأمن السيبراني (NCA ECC)</h3><p class="inner-card__text">ندعم جاهزية ضوابط الأمن السيبراني 2-2024</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">هيئة الغذاء والدواء (SFDA)</h3><p class="inner-card__text">مهيأ لمتطلبات نظام الجودة الطبية</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">الزكاة والضريبة (ZATCA)</h3><p class="inner-card__text">تكامل متوافق مع معايير الفوترة</p></article>
      </div>
    </div>
  </section>

  {/* ═══════════ 8. AUDIENCE — 8 audience cards ═══════════ */}
  <section class="inner-section" aria-labelledby="audience">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <p class="inner-section__label">لمن نبني BrightAI؟</p>
      <h2 id="audience" class="inner-section__title">للفرق التي تريد AI عملي بدون فوضى تشغيلية.</h2>
      <div class="grid grid--4">
        <article class="card card--feature"><h3 class="inner-card__title">الجهات الحكومية</h3><p class="inner-card__text">حوكمة، توثيق، ومسارات مراجعة واضحة.</p></article>
        <article class="card card--feature"><h3 class="inner-card__title">الشركات السعودية</h3><p class="inner-card__text">تبني AI داخل التشغيل مع حدود وصلاحيات.</p></article>
