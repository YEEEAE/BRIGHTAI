---
import Alert from '../../../components/design-system/Alert.astro';
import Button from '../../../components/design-system/Button.astro';
import Card from '../../../components/design-system/Card.astro';
import Input from '../../../components/design-system/Input.astro';
import Select from '../../../components/design-system/Select.astro';
import Toast from '../../../components/design-system/Toast.astro';
import Textarea from '../../../components/design-system/Textarea.astro';
import { productEntryPath } from '../../../shared/product-navigation.mjs';
import AppLayout from '../../../layouts/AppLayout.astro';
import { authConfig } from '../../../server/kernel/auth.mjs';
import '../../../styles/firewall.css';
export const prerender = false;
const config = authConfig();
---
<AppLayout title="جدار حماية AI — سياسات وفحص">
 <section class="kernel firewall" data-firewall data-auth-configured={!!config}>
  <div class="page-heading"><div><p class="overline">02 / AIGAS FIREWALL</p><h1>اضبط السياسة.<span>واحكم مسار الطلب.</span></h1><p class="intro">قواعد حرفية محفوظة وتقييم من الخادم بخمس حالات: ALLOW وWARN وREDACT وESCALATE وDENY، مع مسار تنفيذ مستقل يفرض الحجب والتصعيد والتنقيح قبل أي اتصال بمزود معتمد. النصوص الاصطناعية فقط في هذه النسخة.</p></div><span class="connection">تنفيذ محلي · غير منشور</span></div>
  <Alert as="section" tone="warning" class="notice"><div><h2>حالة الوصول</h2><p data-status role="status" aria-live="polite">{config ? 'جارٍ التحقق من الدخول…' : 'يلزم إعداد الدخول عبر Neon Auth.'}</p><a href={productEntryPath('firewall')}>الدخول وإدارة مساحة العمل عبر Kernel ←</a></div><Button variant="secondary" type="button" data-reload>تحديث</Button></Alert>
  <noscript><p class="notice">يلزم JavaScript لاستعادة جلسة Kernel؛ لا تُعرض بيانات خاصة بدونه.</p></noscript>
  <Alert as="section" tone="warning" class="notice" data-setup-panel hidden><div><h2>التهيئة غير مكتملة</h2><p data-setup-message role="alert"></p><p>لم تُعرض أي بيانات ولم يصدر أي قرار. طبّق ترحيل Firewall المعتمد في بيئة معتمدة ثم أعد التحميل؛ غياب البيانات ليس سماحًا.</p></div></Alert>
  <div data-private hidden>
   <Toast id="fw-confirmation" />
   <Card class="panel"><Select label="المؤسسة" id="fw-workspace" data-workspace></Select><p data-scope></p></Card>
   <Card class="panel fw-integration"><p class="overline">INTEGRATION / INPUT + OUTPUT</p><h2>حالة مسار التنفيذ</h2><p data-provider role="status">جارٍ تحميل حالة المزود…</p><p>التكامل داخل <bdi>/app/api/firewall/guarded-executions/</bdi> فقط. يختار الخادم المؤسسة من العضويات، ويحفظ القرار قبل الإرسال. لا يسمح العميل باختيار عنوان وجهة أو تجاوز القرار.</p><details><summary>عقد الاستدعاء للتطبيقات</summary><p>أرسل POST بهوية مستخدم Neon Auth في Authorization: Bearer، ومعرّف المؤسسة في workspace. JSON: <bdi>{'{"text":"نص اصطناعي","synthetic":true,"request_id":"UUID جديد"}'}</bdi>. لا تعِد العملية تلقائيًا؛ المعرف مخصص لطلب واحد ويُربط ببصمة قرار محفوظة وبنسخة السياسة. لا مفاتيح خدمة أو وجهات حرة أو دعم بث في هذه النسخة.</p><p>DENY: رفض قبل المزود. ESCALATE: يتوقف قبل المزود؛ عند تفعيل سياسة التكامل يُنشأ طلب PENDING في Human Gate ببيانات وصفية فقط؛ تعطيله يعيد HUMAN_GATE_NOT_CONFIGURED. الاعتماد لا ينفذ إرسالًا تلقائيًا. WARN: تحذير لا يمرر تلقائيًا. REDACT: النص المنقّح وحده. ALLOW: تمرير للمزود المعتمد فقط. غياب سياسة Kernel أو بصمة الربط يحجب التنفيذ؛ غياب المزود يرجع PROVIDER_NOT_CONFIGURED. تُفحص المخرجات بقواعد المؤسسة وحماية البيانات قبل عرضها. التفسير الاستشاري لا يغيّر القرار الحتمي. نجاح التقييم وحده لا يثبت إرسالًا.</p></details></Card>
   <div class="fw-counts" aria-label="عدادات القرارات المحفوظة"><article class="panel fw-count-allow"><bdi>ALLOW</bdi><strong data-count="ALLOW">—</strong></article><article class="panel fw-count-warn"><bdi>WARN</bdi><strong data-count="WARN">—</strong></article><article class="panel fw-count-redact"><bdi>REDACT</bdi><strong data-count="REDACT">—</strong></article><article class="panel fw-count-escalate"><bdi>ESCALATE</bdi><strong data-count="ESCALATE">—</strong></article><article class="panel fw-count-deny"><bdi>DENY</bdi><strong data-count="DENY">—</strong></article></div>
   <div class="fw-columns">
    <Card class="panel">
     <p class="overline">01 / POLICY</p><h2>قواعد المؤسسة</h2>
     <p>الترتيب الدفاعي: DENY يتقدّم على ESCALATE ثم REDACT ثم WARN ثم ALLOW، ولا تسمح قاعدة ALLOW أو WARN بتجاوز قاعدة أعلى منها. رقم الأولوية الأقل يُعرض أولًا ويُذكر في القرار عند تعدد القواعد المطابقة للإجراء نفسه.</p>
     <p class="fw-hint">النمط نص حرفي يُطابق احتواءً دون اعتبار حالة الأحرف اللاتينية؛ لا يُقبل تعبير نمطي (RegExp) ولا رموز تحكم. الحفظ يتحقق في الخادم فقط.</p>
     <p class="fw-meta"><span data-rule-count>0</span> قاعدة مسجلة؛ الحد يشمل القواعد المعطّلة أيضًا، ويمكن تعديل قاعدة قائمة عند بلوغه. النسخة المنسوخة تُنشأ معطّلة حتى تُراجع.</p>
     <div data-rules></div>
     <div data-empty-rules hidden class="fw-empty">لا توجد قواعد بعد. أضف قاعدة مخصصة أو قالبًا جاهزًا؛ بلا قاعدة مفعّلة يحجب الفحص ولا يصدر سماح.</div>
     <form data-create-rule hidden>
      <fieldset><legend>إضافة قاعدة حرفية</legend>
       <Input label="اسم القاعدة" id="fw-name" name="name" type="text" maxlength="60" required autocomplete="off" />
       <Input label="النمط الحرفي" id="fw-pattern" name="pattern" type="text" maxlength="80" required autocomplete="off" spellcheck="false" />
       <Select label="الإجراء" id="fw-action" name="action"><option value="DENY">DENY — حجب</option><option value="ESCALATE">ESCALATE — تصعيد للموافقة البشرية</option><option value="REDACT">REDACT — تنقيح</option><option value="WARN">WARN — تحذير لا يمرر تلقائيًا</option><option value="ALLOW">ALLOW — سماح</option></Select>
       <Input label="الأولوية (1–999، الأقل أولًا)" id="fw-priority" name="priority" type="number" min="1" max="999" step="1" value="100" required />
       <p data-create-error class="fw-error" role="alert"></p>
       <Button type="submit">حفظ القاعدة</Button>
      </fieldset>
     </form>
     <div data-templates hidden class="fw-templates"><p>قوالب خادم محمية، للتفعيل والتعطيل أو النسخ فقط؛ القاعدة المخصصة تتيح تغيير الاسم والنمط والإجراء والأولوية. القاعدة المنسوخة تُنشأ معطّلة وقابلة للتعديل:</p><div class="fw-examples"><Button variant="secondary" type="button" data-template="public">سماح: معلومة عامة</Button><Button variant="secondary" type="button" data-template="identifier">تنقيح: DEMO-ID-1234</Button><Button variant="secondary" type="button" data-template="prohibited">حجب: DEMO-BLOCK</Button></div></div>
     <p data-role></p>
    </Card>
    <Card class="panel">
     <p class="overline">02 / EVALUATE OR ENFORCE</p><h2>جرب فحصًا — تقييم النص أو طلب تنفيذه</h2>
     <p>استخدم بيانات مصطنعة فقط. النص لا يُحفظ في سجل القرارات؛ يُحفظ القرار وسببه ومرجع القاعدة ونسختها ووقته فقط. تعرض النتيجة المدخل والقرار والسبب ووقت التقييم وحالة التنفيذ بصدق.</p>
     <div class="fw-examples"><Button variant="secondary" type="button" data-example="معلومة عامة عن حوكمة الذكاء الاصطناعي">بيانات عامة</Button><Button variant="secondary" type="button" data-example="معرّف اختباري DEMO-ID-1234 فقط">معرّف افتراضي</Button><Button variant="secondary" type="button" data-example="محتوى اختباري DEMO-BLOCK">محتوى محظور</Button></div>
     <form data-evaluate>
      <Textarea label="النص الاصطناعي" id="fw-text" name="text" rows="5" maxlength="4000" required autocomplete="off" spellcheck="false" />
      <label class="fw-check"><input type="checkbox" data-synthetic> أؤكد أن النص اصطناعي ولا يحتوي بيانات عميل أو أسرارًا.</label>
      <Select label="المسار" id="fw-eval-mode" data-eval-mode><option value="LAB">تقييم تجريبي فقط — دون إرسال</option><option value="GUARD">مسار التنفيذ — يتطلب مزودًا معتمدًا</option></Select>
      <p data-eval-error class="fw-error" role="alert"></p>
      <Button type="submit" data-eval-submit disabled>فحص من الخادم</Button>
     </form>
     <div class="fw-result" data-result role="status" aria-live="polite">اختر مثالًا، أكّد أنه اصطناعي، ثم افحصه.</div>
     <p class="fw-hint">التقييم <bdi>/app/api/firewall/evaluate/</bdi> لا ينفذ طلب AI؛ عدم المطابقة فيه ALLOW تجريبي وليس إثبات سلامة. مسار التنفيذ يحجب عدم المطابقة، ويتوقف عند WARN وESCALATE بدل تمريرهما. لا حماية لتطبيقات تستدعي مزودًا مباشرة ولا فحص للمخرجات هنا.</p>
    </Card>
   </div>
   <Card class="panel">
    <div class="section-heading"><div><p class="overline">03 / DECISION LOG</p><h2>سجل قرارات المؤسسة</h2></div><div class="fw-filters"><div><Select label="الإجراء" id="fw-filter" data-filter><option value="">كل الإجراءات</option><option>ALLOW</option><option>WARN</option><option>REDACT</option><option>ESCALATE</option><option>DENY</option></Select></div><div><Select label="السبب" id="fw-reason" data-reason><option value="">كل الأسباب</option><option value="RULE_DENY">حجب بقاعدة</option><option value="RULE_ESCALATE">تصعيد بقاعدة</option><option value="RULE_REDACT">تنقيح بقاعدة</option><option value="RULE_WARN">تحذير بقاعدة</option><option value="RULE_ALLOW">سماح بقاعدة</option><option value="NO_MATCH_LAB_ONLY">دون مطابقة تجريبية</option><option value="NO_MATCH_ENFORCED">حجب التنفيذ دون مطابقة</option><option value="NO_ACTIVE_POLICY">لا سياسة مفعّلة</option><option value="INVALID_POLICY">سياسة غير صالحة</option><option value="KERNEL_POLICY_DENIED">منعت سياسة Kernel العليا</option></Select></div><div><Select label="المسار" id="fw-log-mode" data-log-mode><option value="">كل المسارات</option><option value="LAB">تقييم تجريبي</option><option value="GUARD">مسار التنفيذ</option></Select></div><div><Input label="من تاريخ (UTC)" type="date" id="fw-from" data-from /></div><div><Input label="إلى تاريخ (UTC)" type="date" id="fw-to" data-to /></div></div></div>
    <p>12 قرارًا في الصفحة؛ الوقت معروض بتوقيت الرياض والتصفية حسب أيام UTC. معرّف القرار وإجراؤه وسببه ومرجع القاعدة ونسختها فقط، دون النص أو قيمة المطابقة. سجل قرار السياسة لا يثبت وصول الطلب للمزود ولا يُعد Ledger موقّعًا. تدقيق Kernel الأساسي لا يتطلب شراء Ledger.</p>
    <ol class="fw-decisions" data-decisions></ol>
    <nav class="fw-pagination" aria-label="صفحات سجل القرارات"><Button variant="secondary" type="button" data-prev disabled>الأحدث</Button><span data-page>الصفحة 1</span><Button variant="secondary" type="button" data-next disabled>الأقدم</Button></nav>
   </Card>
  </div>
  <p class="notice">النطاق قواعد حرفية على المدخل في مسار التنفيذ المحدد فقط؛ لا Proxy عام أو DLP شامل أو كشف دلالي لحقن التعليمات. ESCALATE يوقف التنفيذ ولا ينشئ طلب موافقة لأن تكامل Human Gate غير مهيأ. لا مزود معتمد حاليًا ولا إرسال بيانات حقيقية أو تدريب عليها. الاشتراك وتجربة 48 ساعة غير مهيأين.</p>
 </section>
</AppLayout>
<script src="../../../scripts/firewall.ts"></script>
