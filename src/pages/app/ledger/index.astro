---
import AppLayout from '../../../layouts/AppLayout.astro';
import { authConfig } from '../../../server/kernel/auth.mjs';
import '../../../styles/ledger.css';
export const prerender = false;
const config = authConfig();
---
<AppLayout title="سجل أدلة Ledger">
 <section class="kernel ledger" data-ledger data-auth-url={config?.base ?? ''}>
  <div class="page-heading"><div><p class="overline">03 / AIGAS LEDGER</p><h1>أثر واضح.<span>وسلامة قابلة للفحص.</span></h1><p class="intro">أحداث مسارات AIGAS الخادمية المربوطة بالسجل عند تفعيله. أحداث Firewall وHuman Gate الحالية تجريبية موسومة؛ لا تعني إرسالًا لمزود أو عملية خارجية.</p></div><span class="connection">سجل أدلة المؤسسة</span></div>
  <section class="notice"><div><h2>حالة الوصول</h2><p data-status role="status" aria-live="polite">{config ? 'جارٍ التحقق من الدخول…' : 'يلزم إعداد الدخول عبر Neon Auth.'}</p><a href="/app/kernel/">الدخول وإدارة المؤسسة عبر Kernel ←</a><a href="/products/ledger/">التعريف العام بـLedger وحدود الدليل ←</a></div><button type="button" data-reload>تحديث السجل</button></section>
  <noscript><p class="notice">يلزم JavaScript لاستعادة جلسة Kernel وعرض البيانات الخاصة.</p></noscript>
  <div data-private hidden>
   <section class="panel ledger-controls"><div><label for="ld-workspace">المؤسسة</label><select id="ld-workspace" data-workspace></select><p data-role></p></div><div><label for="ld-search">بحث بمعرّف الحدث أو مرجع العملية</label><input id="ld-search" data-search-input type="search" maxlength="80" autocomplete="off" placeholder="اكتب جزءًا من المعرّف" /></div><button type="button" data-search>بحث</button><div><label for="ld-type">نوع الحدث</label><select id="ld-type" data-type><option value="">كل الأنواع</option><option value="firewall.decision.recorded">قرار Firewall</option><option value="human_gate.request.created">طلب Human Gate</option><option value="human_gate.decision.recorded">قرار Human Gate</option><option value="human_gate.demo_note.completed">تنفيذ ملاحظة تجريبية</option><option value="risk_engine.asset.created">إنشاء أصل</option><option value="risk_engine.asset.updated">تحديث أصل</option><option value="risk_engine.assessment.created">تقييم مخاطر</option><option value="kernel.audit.recorded">إجراء Kernel</option><option value="synthetic.test.created">اختبار اصطناعي</option><option value="synthetic.review.recorded">مراجعة اصطناعية</option></select></div><div><label for="ld-source">المصدر</label><select id="ld-source" data-source><option value="">كل المصادر</option><option value="firewall">Firewall</option><option value="human-gate">Human Gate</option><option value="risk-engine">Risk Engine</option><option value="kernel">Kernel</option><option value="ledger.synthetic-lab">مختبر Ledger</option></select></div><div><label for="ld-classification">طبيعة الحدث</label><select id="ld-classification" data-classification><option value="">كل الأحداث</option><option value="operational">تشغيلي داخل التطبيق</option><option value="synthetic">اصطناعي / مسار تجريبي</option></select></div><div><label for="ld-period">الفترة</label><select id="ld-period" data-period><option value="all">كل الفترات</option><option value="1">آخر 24 ساعة</option><option value="7">آخر 7 أيام</option><option value="30">آخر 30 يومًا</option></select></div></section>
   <section class="panel" data-create-panel hidden><h2>إضافة حدث تجريبي منظم</h2><p>الخادم ينشئ الوقت وهوية الفاعل ومرجع قرار اصطناعي والبصمة. القيم محصورة؛ لا يوجد حقل لحفظ محادثات أو أسرار.</p><form data-create class="ledger-controls"><div><label for="ld-event-type">النوع الاصطناعي</label><select id="ld-event-type" name="event_type"><option value="synthetic.test.created">اختبار اصطناعي</option><option value="synthetic.review.recorded">مراجعة اصطناعية</option></select></div><div><label for="ld-scenario">سيناريو الاختبار</label><select id="ld-scenario" name="scenario"><option value="integrity-check">فحص السلامة</option><option value="access-check">فحص الوصول</option></select></div><button type="submit">حفظ حدث تجريبي</button></form></section>
   <section class="panel"><div class="section-heading"><h2>أحداث المؤسسة</h2><span data-page></span></div><p>25 حدثًا لكل صفحة، بحد أقصى 100 صفحة. فحص السلسلة يشمل بادئتها كاملة حتى الحدث المعروض، حتى 10000 حدث، بصرف النظر عن التصفية.</p><p data-chain role="status" aria-live="polite"></p><p data-empty role="status" hidden>لا توجد أحداث ضمن هذه التصفية. لا تُنشأ أحداث تلقائية لملء السجل.</p><div class="ledger-table" tabindex="0" role="region" aria-label="جدول الأحداث، يمكن تمريره أفقيًا"><table><caption class="sr-only">أحداث المؤسسة المحفوظة</caption><thead><tr><th scope="col">الوقت</th><th scope="col">النوع / المصدر</th><th scope="col">مرجع العملية</th><th scope="col">الفاعل</th><th scope="col">سلامة الحدث / حزمة الصفحة</th><th scope="col">التفاصيل</th></tr></thead><tbody data-events></tbody></table></div><div class="ledger-pagination"><button type="button" data-prev>السابق</button><button type="button" data-next>التالي</button></div></section>
  </div>
  <dialog data-detail aria-labelledby="ld-detail-title"><div class="ledger-detail"><div class="section-heading"><h2 id="ld-detail-title">تفاصيل الحدث</h2><button type="button" data-close>إغلاق</button></div><p data-event-classification></p><dl data-fields></dl><div class="ledger-actions"><button type="button" data-verify>تحقق من سلامة الحدث</button><button type="button" data-export hidden>تنزيل حزمة JSON</button></div><p data-integrity role="status" aria-live="polite">لم يُفحص بعد.</p></div></dialog>
  <p class="notice">البصمة SHA-256 تربط الأحداث بتسلسل داخل المؤسسة. الحزمة تضم الأحداث من بداية السجل إلى الحدث المحدد، دون إثبات أن هذا آخر حدث أو أن الواقعة صحيحة؛ إعادة كتابة السلسلة كاملة من مسؤول قاعدة البيانات ليست محمية بتوقيع أو مرساة خارجية. لا أرشفة قانونية أو احتفاظ أبدي أو Legal Hold. تدقيق Kernel الأساسي مستقل عن شراء Ledger؛ لا تُستخدم الأدلة لتدريب النماذج.</p>
  <section class="notice"><div><h2>فحص الحزمة خارج التطبيق</h2><p>نزّل ملف JSON والفاحص المستقل، ثم شغّله محليًا باستخدام Node 22 دون اتصال بخادم التطبيق. MATCH يعني اتساق الحزمة الموردة فقط؛ لا يثبت صحة المصدر أو شهادة امتثال.</p><a href="/downloads/aigas-ledger-verifier.mjs" download>تنزيل الفاحص المستقل</a><pre dir="ltr"><code>node aigas-ledger-verifier.mjs ledger-EVENT_ID.json</code></pre><p>أي فشل في المطابقة أو نقص في الروابط يظهر صراحةً في نتيجة الفاحص. حد الحزمة الأساسية 10000 حدث؛ لا يجري تنزيل حزمة مبتورة.</p></div></section>
 </section>
</AppLayout>
<script src="../../../scripts/ledger.ts"></script>
