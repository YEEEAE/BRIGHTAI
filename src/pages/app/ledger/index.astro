---
import Alert from '../../../components/design-system/Alert.astro';
import Button from '../../../components/design-system/Button.astro';
import Card from '../../../components/design-system/Card.astro';
import EmptyState from '../../../components/design-system/EmptyState.astro';
import Modal from '../../../components/design-system/Modal.astro';
import Table from '../../../components/design-system/Table.astro';
import Input from '../../../components/design-system/Input.astro';
import Select from '../../../components/design-system/Select.astro';
import { productEntryPath } from '../../../shared/product-navigation.mjs';
import AppLayout from '../../../layouts/AppLayout.astro';
import { authConfig } from '../../../server/kernel/auth.mjs';
import '../../../styles/ledger.css';
export const prerender = false;
const config = authConfig();
---
<AppLayout title="سجل أدلة Ledger">
 <section class="kernel ledger" data-ledger data-auth-configured={!!config}>
  <div class="page-heading"><div><p class="overline">03 / AIGAS LEDGER</p><h1>أثر واضح.<span>وسلامة قابلة للفحص.</span></h1><p class="intro">أحداث مسارات AIGAS الخادمية المربوطة بالسجل عند تفعيله. أحداث Firewall وHuman Gate الحالية تجريبية موسومة؛ لا تعني إرسالًا لمزود أو عملية خارجية.</p></div><span class="connection">سجل أدلة المؤسسة</span></div>
  <Alert as="section" tone="warning" class="notice"><div><h2>حالة الوصول</h2><p data-status role="status" aria-live="polite">{config ? 'جارٍ التحقق من الدخول…' : 'يلزم إعداد الدخول عبر Neon Auth.'}</p><a href={productEntryPath('ledger')}>الدخول وإدارة المؤسسة عبر Kernel ←</a><a href="/products/ledger/">التعريف العام بـLedger وحدود الدليل ←</a></div><Button variant="secondary" type="button" data-reload>تحديث السجل</Button></Alert>
  <noscript><p class="notice">يلزم JavaScript لاستعادة جلسة Kernel وعرض البيانات الخاصة.</p></noscript>
  <div data-private hidden>
   <Card class="panel ledger-controls"><div><Select label="المؤسسة" id="ld-workspace" data-workspace></Select><p data-role></p></div><div><Input label="بحث بمعرّف الحدث أو مرجع العملية" id="ld-search" data-search-input type="search" maxlength="80" autocomplete="off" placeholder="اكتب جزءًا من المعرّف" /></div><Button variant="secondary" type="button" data-search>بحث</Button><div><Select label="نوع الحدث" id="ld-type" data-type><option value="">كل الأنواع</option><option value="firewall.decision.recorded">قرار Firewall</option><option value="human_gate.request.created">طلب Human Gate</option><option value="human_gate.decision.recorded">قرار Human Gate</option><option value="human_gate.demo_note.completed">تنفيذ ملاحظة تجريبية</option><option value="risk_engine.asset.created">إنشاء أصل</option><option value="risk_engine.asset.updated">تحديث أصل</option><option value="risk_engine.assessment.created">تقييم مخاطر</option><option value="kernel.audit.recorded">إجراء Kernel</option><option value="synthetic.test.created">اختبار اصطناعي</option><option value="synthetic.review.recorded">مراجعة اصطناعية</option></Select></div><div><Select label="المصدر" id="ld-source" data-source><option value="">كل المصادر</option><option value="firewall">Firewall</option><option value="human-gate">Human Gate</option><option value="risk-engine">Risk Engine</option><option value="kernel">Kernel</option><option value="ledger.synthetic-lab">مختبر Ledger</option></Select></div><div><Select label="الحالة / طبيعة الحدث" id="ld-classification" data-classification><option value="">كل الأحداث</option><option value="operational">تشغيلي داخل التطبيق</option><option value="synthetic">اصطناعي / مسار تجريبي</option></Select></div><div><Select label="الفترة" id="ld-period" data-period><option value="all">كل الفترات</option><option value="1">آخر 24 ساعة</option><option value="7">آخر 7 أيام</option><option value="30">آخر 30 يومًا</option></Select></div></Card>
   <Card class="panel" data-create-panel hidden><h2>إضافة حدث تجريبي منظم</h2><p>الخادم ينشئ الوقت وهوية الفاعل ومرجع قرار اصطناعي والبصمة. القيم محصورة؛ لا يوجد حقل لحفظ محادثات أو أسرار.</p><form data-create class="ledger-controls"><div><Select label="النوع الاصطناعي" id="ld-event-type" name="event_type"><option value="synthetic.test.created">اختبار اصطناعي</option><option value="synthetic.review.recorded">مراجعة اصطناعية</option></Select></div><div><Select label="سيناريو الاختبار" id="ld-scenario" name="scenario"><option value="integrity-check">فحص السلامة</option><option value="access-check">فحص الوصول</option></Select></div><Button type="submit">حفظ حدث تجريبي</Button></form></Card>
   <Card class="panel"><div class="section-heading"><h2>أحداث المؤسسة</h2><span data-page></span></div><p>25 حدثًا لكل صفحة، بحد أقصى 100 صفحة. فحص السلسلة يشمل بادئتها كاملة حتى الحدث المعروض، حتى 10000 حدث، بصرف النظر عن التصفية.</p><p data-chain role="status" aria-live="polite"></p><EmptyState data-empty role="status" hidden>لا توجد أحداث ضمن هذه التصفية. لا تُنشأ أحداث تلقائية لملء السجل.</EmptyState><Table scrollClass="ledger-table" caption="أحداث المؤسسة المحفوظة" captionVisible={false} scrollLabel="جدول الأحداث، يمكن تمريره أفقيًا"><thead><tr><th scope="col">الوقت</th><th scope="col">النوع / المصدر</th><th scope="col">مرجع العملية</th><th scope="col">الفاعل</th><th scope="col">سلامة الحدث / حزمة الصفحة</th><th scope="col">التفاصيل</th></tr></thead><tbody data-events></tbody></Table><div class="ledger-pagination"><Button variant="secondary" type="button" data-prev>السابق</Button><Button variant="secondary" type="button" data-next>التالي</Button></div></Card>
  </div>
  <Modal data-detail aria-labelledby="ld-detail-title"><div class="ledger-detail"><div class="section-heading"><h2 id="ld-detail-title">تفاصيل الحدث</h2><Button variant="secondary" type="button" data-close autofocus>إغلاق</Button></div><p data-event-classification></p><dl data-fields></dl><div class="ledger-actions"><Button variant="secondary" type="button" data-verify>تحقق من سلامة الحدث</Button><Button variant="secondary" type="button" data-export hidden>تنزيل حزمة JSON</Button><Button variant="secondary" type="button" data-export-redacted hidden>تنزيل حزمة منقّحة</Button></div><p data-integrity role="status" aria-live="polite">لم يُفحص بعد.</p></div></Modal>
  <p class="notice">البصمة SHA-256 تربط الأحداث بتسلسل داخل المؤسسة. الحزمة تضم الأحداث من بداية السجل إلى الحدث المحدد، دون إثبات أن هذا آخر حدث أو أن الواقعة صحيحة؛ إعادة كتابة السلسلة كاملة من مسؤول قاعدة البيانات ليست محمية بتوقيع أو مرساة خارجية. لا أرشفة قانونية أو احتفاظ أبدي أو Legal Hold. تدقيق Kernel الأساسي مستقل عن شراء Ledger؛ لا تُستخدم الأدلة لتدريب النماذج.</p>
  <Alert as="section" tone="warning" class="notice"><div><h2>فحص الحزمة خارج التطبيق</h2><p>نزّل ملف JSON والفاحص المستقل، ثم شغّله محليًا باستخدام Node 22 دون اتصال بخادم التطبيق. MATCH يعني اتساق الحزمة الموردة فقط؛ لا يثبت صحة المصدر أو شهادة امتثال. تسجّل الحزمة إصدار الفاحص، وإن اختلف إصدار الفاحص عن المسجل تُرجع النتيجة غير محسومة بدل المطابقة.</p><a href="/downloads/aigas-ledger-signed-verifier.mjs" download>تنزيل فاحص التوقيع</a> و<a href="/downloads/aigas-ledger-verifier.mjs" download>فاحص السلسلة المطلوب بجواره</a><pre dir="ltr"><code>node aigas-ledger-signed-verifier.mjs ledger-EVENT_ID.json trusted-public-key.pem EXPECTED_KEY_ID</code></pre><p>احصل على المفتاح العام ومعرّفه من المشغّل عبر قناة موثوقة مستقلة. يتحقق الفاحص من توقيعات الأحداث أيضًا؛ لا يثبت ذلك اكتمال ذيل السجل.</p><p>أي فشل في المطابقة أو نقص في الروابط يظهر صراحةً في نتيجة الفاحص: <bdi>VERIFIED_WITHIN_SCOPE</bdi> تعني اتساق البادئة الموردة فقط، و<bdi>TAMPERED</bdi> تعني تعارضًا مرصودًا، و<bdi>UNVERIFIED</bdi> تعني أن الدليل غير كافٍ للحسم. حد الحزمة الأساسية 10000 حدث؛ لا يجري تنزيل حزمة مبتورة. عند تعديل الدليل أو سلسلته تعرض الواجهة حالة محجوبة أو غير متحققة، لا نجاحًا ضمنيًا.</p><p>تُعرض حالة <bdi>UNVERIFIED</bdi> إذا غاب توقيع حدث أو مفتاح التحقق، حتى عند تطابق بصمة البادئة. تشير <bdi>BLOCKED</bdi> إلى تعارض أو بنية تمنع الفحص. لا تُعرض أي حالة نجاح عند تحميل الصفحة قبل أن يفحص الخادم البادئة فعلًا.</p></div></Alert>
 </section>
</AppLayout>
<script src="../../../scripts/ledger.ts"></script>
