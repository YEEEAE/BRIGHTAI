---
import AppLayout from '../../../layouts/AppLayout.astro';
import { authConfig } from '../../../server/kernel/auth.mjs';
import { products } from '../../../server/kernel/core.mjs';
export const prerender = false;
const config = authConfig();
---
<AppLayout title="نواة المنظومة">
  <section class="kernel" data-kernel data-auth-url={config?.base ?? ''}>
    <div class="page-heading"><div><p class="overline">01 / SHARED FOUNDATION</p><h1>نواة المنظومة<span>مساحتك، ومنها تبدأ.</span></h1><p class="intro">مؤسستك ومنتجاتك في مساحة عمل واحدة، بصلاحيات مرتبطة بعضويتك.</p></div><span class="connection" data-connection>لم يُتحقق من الربط</span></div>

    <section class="health" aria-labelledby="health-title"><div class="section-heading"><div><p class="overline">00 / RUNTIME</p><h2 id="health-title">حالة التشغيل</h2></div><button type="button" data-health-refresh>إعادة الفحص</button></div><ul class="health-list" data-health-list role="status" aria-live="polite"><li>جارٍ فحص الدخول والقاعدة…</li></ul><p class="health-meta" data-health-updated>لم يكتمل الفحص بعد.</p><p class="health-error" data-health-error hidden>نوع الخطأ: <bdi data-health-error-type></bdi></p><p class="health-note">الحالة تعرض إعداد الخادم واتصال قاعدة البيانات ومخطط Kernel؛ إعداد Auth لا يثبت نجاح تسجيل الدخول. لا تعرض أي إعداد سري.</p></section>

    <section class="notice" aria-labelledby="session-title"><div><p class="overline">حالة الوصول</p><h2 id="session-title" data-state-title>{config ? 'تحقق من جلسة الدخول' : 'يلزم إعداد الدخول'}</h2><p role="status" aria-live="polite" data-status>{config ? 'جارٍ التحقق من الجلسة…' : 'لم يُهيأ Neon Auth لهذا التشغيل.'}</p><p class="health-meta" data-dashboard-updated hidden></p><p class="health-error" data-dashboard-error hidden>نوع الخطأ: <bdi data-dashboard-error-type></bdi></p></div><button type="button" data-retry hidden>إعادة المحاولة</button><button type="button" data-sign-out hidden>تسجيل الخروج</button></section>

    {config && <form class="panel login-form" data-login hidden><h2>دخول مساحة العمل</h2><p>استخدم حساب Neon Auth الخاص بك.</p><label for="email">البريد الإلكتروني</label><input id="email" name="email" type="email" autocomplete="username" dir="ltr" required maxlength="254" aria-describedby="login-email-error" /><p id="login-email-error" class="field-error" data-login-email-error hidden></p><label for="password">كلمة المرور</label><div class="password-control"><input id="password" name="password" type="password" autocomplete="current-password" dir="ltr" required maxlength="128" aria-describedby="login-password-error" /><button type="button" data-login-password-toggle aria-pressed="false" aria-controls="password">إظهار كلمة المرور</button></div><p id="login-password-error" class="field-error" data-login-password-error hidden></p><button type="submit" data-login-submit>تسجيل الدخول</button><p><a href="/auth/sign-up/">إنشاء حساب</a> · هذه البوابة لا تتضمن أي تتبع.</p></form>}

    <section class="panel incoming" data-incoming-panel hidden aria-labelledby="incoming-title"><h2 id="incoming-title">دعوات الانضمام</h2><p>تظهر الدعوات المسجلة لبريدك الموثّق. قبول Auth وحده لا يمنح صلاحية Kernel حتى يعتمدها الخادم.</p><ul class="member-list" data-incoming></ul><p data-incoming-state role="status"></p></section>
    <p class="admin-status" data-admin-status role="status" aria-live="polite"></p>
    <div class="workspace-row"><section class="panel institution"><p class="overline">المؤسسة</p><h2 data-tenant-name>لا توجد مساحة محمّلة</h2><p data-tenant-detail>تظهر بيانات المؤسسة بعد توثيق الهوية والتحقق من العضوية في الخادم.</p><div data-selector hidden><label for="workspace">اختر مؤسستك</label><select id="workspace" data-workspace dir="auto"></select><p data-selector-note></p></div><form data-create hidden><label for="workspace-name">اسم المؤسسة</label><input id="workspace-name" name="name" dir="auto" required minlength="2" maxlength="100" /><button type="submit">إنشاء مؤسسة</button><p>يمكن لحسابك إنشاء أكثر من مؤسسة. المؤسسة الجديدة تبدأ بعضويتك كمالك وحيد فقط، ولا تنسخ أعضاء أو سياسات أو دعوات أو قرارات إتاحة من مؤسسة أخرى، ولا تفعّل اشتراكًا أو تجربة مدفوعة.</p></form></section>
    <section class="panel system-diagram" aria-label="Kernel يربط الهوية والمؤسسة والوصول بالمنتجات الخمسة"><p class="overline">خريطة المنظومة</p><div class="diagram-core"><span aria-hidden="true">◈</span><bdi>Kernel</bdi><small>هوية · مؤسسة · وصول</small></div><svg viewBox="0 0 480 48" aria-hidden="true"><path d="M240 0V20M40 48V20H440V48M140 48V20M240 48V20M340 48V20" fill="none" stroke="currentColor" /></svg><div class="diagram-products">{products.map(p => <bdi>{p.name}</bdi>)}</div><p>أساس واحد، وخمسة منتجات مستقلة.</p></section></div>

    <section class="metrics" data-metrics hidden aria-label="ملخص المؤسسة">
      <article class="panel metric"><p class="overline">MEMBERS</p><strong data-metric="members">—</strong><span>أعضاء المؤسسة</span></article>
      <article class="panel metric"><p class="overline">PRODUCT COVERAGE</p><strong data-metric="coverage">—</strong><span>منتجات بقرار إتاحة ساري من خمسة</span></article>
      <article class="panel metric"><p class="overline">AUDIT EVENTS</p><strong data-metric="events">—</strong><span>أحداث التدقيق</span></article>
    </section>

    <section aria-labelledby="products-title"><div class="section-heading"><div><p class="overline">02 / YOUR PRODUCTS</p><h2 id="products-title">المنتجات</h2></div><p>الإتاحة من سجل وصول المؤسسة، لا من الواجهة.</p></div><div class="product-grid">{products.map((p, i) => <article class="product-card" data-product={p.slug}><div class="card-top"><span class="product-number">0{i + 1}</span><span class="wave">الموجة {p.wave === 1 ? 'الأولى' : 'الثانية'}</span></div><h3><bdi>{p.name}</bdi></h3><p>{p.benefit}</p><span class="availability" data-product-status>يلزم تسجيل الدخول لمعرفة الإتاحة</span><p class="product-setup" data-product-setup>حالة الإعداد غير محمّلة.</p><details><summary>شروط الإتاحة والتجربة</summary><p class="product-terms" data-product-terms>الاشتراك والترخيص وتجربة 48 ساعة غير مهيّأة.</p><p class="product-terms" data-product-commercial>تظهر الحالة والأوقات بعد التحقق من العضوية؛ لا يبدأ عدّاد من تسجيل الدخول.</p></details><div data-product-admin hidden></div><div data-product-action><button type="button" disabled>لم يجهز بعد</button></div></article>)}</div></section>
    <section class="panel commercial-policy" aria-labelledby="trial-title"><h2 id="trial-title">التجربة والاشتراك والترخيص</h2><p><bdi>Kernel</bdi> أساس مشترك دون رسم ترخيص منفصل؛ المنتجات الخمسة مستقلة، ولا تُشترط إضافة مدفوعة لتنفيذ أمان <bdi>Kernel</bdi> الأساسي. التمكين أعلاه قرار وصول إداري فقط، وليس شراءً أو تفعيل تجربة.</p><p>تجربة 48 ساعة غير مهيأة للتفعيل الذاتي. عند اعتماد تشغيلها تبدأ فقط من <bdi>activated_at</bdi> بعد موافقة وتهيئة صالحة، وتنتهي بعد <bdi>172800</bdi> ثانية بالضبط. لا تحويل لمدفوع ولا خصم تلقائي ولا تجديد دون إذن مستقل. إثبات القيمة <bdi>Proof of Value</bdi> نتيجة تقييم؛ أما <bdi>Pilot</bdi> فله عقد ونطاق مستقلان.</p><p>بيانات اصطناعية افتراضيًا. بيانات العميل الحقيقية غير مؤهلة دون موافقة مكتوبة وبيئة معالجة معتمدة؛ قرار الإتاحة الإداري لا يحقق هذين الشرطين. ممنوع استخدام بيانات العميل للتدريب لدى <bdi>BRIGHT AI</bdi> أو أي مزود؛ موافقة التشغيل ليست موافقة تدريب.</p><ul><li><bdi>SaaS</bdi> / اشتراك: غير مهيأ تجاريًا؛ يلزم اعتماد العرض ومعالجة البيانات وتهيئة الخدمة.</li><li><bdi>On-Prem</bdi> / ترخيص: غير متحقق تشغيليًا؛ يلزم اعتماد البنية والهوية والترخيص والتحديثات المحلية.</li><li><bdi>Air-Gapped</bdi> / ترخيص محلي: غير متحقق؛ يلزم هوية ونماذج وتحقق رخصة وتحديثات دون اعتماد إلزامي على الإنترنت. بوابة <bdi>Neon</bdi> الحالية ليست دليلًا على جاهزيته.</li></ul><p class="health-note">الأسعار والحصص التجارية وأعداد المستخدمين و<bdi>SLA</bdi> غير مقررة هنا. حدود الحماية التقنية ليست باقات أو أسعارًا. لا توجد بوابة دفع في هذه اللوحة.</p></section>
    <section class="panel policy-status" aria-labelledby="policy-status-title"><div><p class="overline">POLICY MODEL</p><h2 id="policy-status-title">سياسات Kernel</h2><span class="availability" data-policy-state>غير مهيأ</span><p class="health-meta" data-policy-count>لم تُحمّل حالة السياسات.</p></div><div><p>الترتيب: <bdi>Enterprise → Department → Product → User</bdi>. لا يخفف المستوى الأدنى منعًا أعلى، ولا ترفع موافقة بشرية منعًا إلزاميًا. يلزم معتمد مختلف عن منشئ النسخة، ويمكن اشتراط مراجعين مختلفين؛ النشر لمالك ثالث لا ينشئ النسخة ولا يعتمدها.</p><p data-policy-detail>حالة مخطط السياسات غير محمّلة؛ لا يُدّعى تفعيل الهرمية. تحقق الوصول يظل مستقلًا: العضوية، وتمكين المنتج، والمنحة الإدارية السارية، ومخطط المنتج.</p></div></section>

    <section class="panel policy-console" data-policy-console hidden aria-labelledby="policy-console-title">
      <div class="section-heading"><div><p class="overline">POLICY WORKSPACE</p><h2 id="policy-console-title">إدارة السياسات</h2></div><button type="button" data-policy-refresh>تحديث القائمة</button></div>
      <p data-policy-console-state role="status" aria-live="polite">تُحمّل السياسات بعد التحقق من صلاحيتك.</p>
      <ul class="member-list" data-policy-list></ul>
      <details class="policy-editor"><summary>إنشاء نسخة مسودة</summary><form data-policy-create>
        <label for="policy-scope">المستوى</label><select id="policy-scope" name="scope"><option value="ENTERPRISE">المؤسسة</option><option value="DEPARTMENT">الإدارة</option><option value="PRODUCT">المنتج</option><option value="USER">المستخدم</option></select>
        <div data-policy-department-field hidden><label for="policy-department">الإدارة</label><select id="policy-department" name="departmentId" data-policy-department><option value="">حمّل الإدارات أولًا</option></select></div>
        <div data-policy-product-field hidden><label for="policy-product">المنتج</label><select id="policy-product" name="productSlug" data-policy-product><option value="firewall">Firewall</option><option value="ledger">Ledger</option><option value="human-gate">Human Gate</option><option value="risk-engine">Risk Engine</option><option value="secure-chat">Secure Chat</option></select></div>
        <div data-policy-user-field hidden><label for="policy-user">عضو المؤسسة</label><select id="policy-user" name="userId" data-policy-user><option value="">حمّل الأعضاء أولًا</option></select></div>
        <label for="policy-family">مجال السياسة</label><input id="policy-family" name="family" required minlength="2" maxlength="80" />
        <label for="policy-rule-key">مفتاح القاعدة</label><input id="policy-rule-key" name="ruleKey" required minlength="2" maxlength="100" dir="ltr" />
        <label for="policy-effect">الأثر</label><select id="policy-effect" name="effect"><option>ALLOW</option><option>BLOCK</option><option>HARD_DENY</option><option>REDACT</option><option>REQUEST_APPROVAL</option><option>WARN</option></select>
        <label for="policy-required-approvals">عدد المراجعين المستقلين المطلوب</label><select id="policy-required-approvals" name="requiredApprovals"><option value="1">مراجع واحد</option><option value="2">مراجعان مختلفان (يلزم ترحيل 0020)</option></select>
        <label for="policy-operation">العملية (اختياري)</label><input id="policy-operation" name="operation" maxlength="120" dir="ltr" />
        <label for="policy-reason">سبب التغيير</label><textarea id="policy-reason" name="reason" required minlength="3" maxlength="500"></textarea>
        <button type="submit">حفظ كمسودة</button><p>التغيير لا يسري قبل مراجعة منفصلة ونشر نسخة جديدة. شروط التنفيذ تقبل نصوص سياق محددة فقط.</p>
      </form></details>
      <details class="policy-editor" data-policy-department-tools><summary>إدارة الأقسام والتفويض المحدود</summary>
        <form data-department-create><label for="department-name">اسم الإدارة</label><input id="department-name" name="name" required minlength="2" maxlength="100" /><label for="department-reason">سبب الإنشاء</label><textarea id="department-reason" name="reason" required minlength="3" maxlength="500"></textarea><button type="submit">إنشاء إدارة</button></form>
        <form data-department-member><label for="department-member-ref">الإدارة</label><select id="department-member-ref" name="departmentId" data-department-member-ref></select><label for="department-user-id">عضو المؤسسة</label><select id="department-user-id" name="userId" data-department-user required></select><label for="department-member-reason">السبب</label><textarea id="department-member-reason" name="reason" required minlength="3" maxlength="500"></textarea><button type="submit">إضافة للعضوية</button><button type="button" data-department-member-remove>إيقاف العضوية</button></form>
        <form data-policy-delegate><label for="policy-delegate-user">عضو بدور ADMIN</label><select id="policy-delegate-user" name="userId" data-policy-delegate-user required></select><label for="policy-delegate-expiry">ينتهي التفويض</label><input id="policy-delegate-expiry" name="expiresAt" type="datetime-local" required /><label for="policy-delegate-reason">سبب التفويض</label><textarea id="policy-delegate-reason" name="reason" required minlength="3" maxlength="500"></textarea><button type="submit">تفويض المراجعة</button></form>
      </details>
    </section>

    <div class="ops-row">
      <section class="panel members" aria-labelledby="members-title">
        <div class="section-heading"><div><p class="overline">03 / MEMBERS</p><h2 id="members-title">أعضاء المؤسسة</h2></div><span class="count" data-member-count></span></div>
        <p data-members-state role="status" aria-live="polite">تُحمّل الأعضاء بعد التحقق من العضوية.</p>
        <ul class="member-list" data-members></ul>
        <div class="member-actions"><p id="invite-note" data-invite-note>تظهر إمكانية الدعوة بعد التحقق من المؤسسة وصلاحيتك.</p>
          <div data-auth-link hidden><h3>ربط مؤسسة الدخول</h3><label for="auth-organization">مؤسسة Auth تملكها بحسابك</label><select id="auth-organization" data-auth-organizations dir="auto"></select><button type="button" data-link-existing>ربط المؤسسة المختارة</button><button type="button" data-create-auth>إنشاء مؤسسة Auth وربطها</button><p>الربط لا يستورد أعضاء أو أدوارًا تلقائيًا، ولا ينقل ملكية.</p></div>
          <form data-invite hidden><label for="invite-email">بريد العضو المدعو</label><input id="invite-email" name="email" type="email" autocomplete="off" dir="ltr" required maxlength="254" /><button type="submit">دعوة بدور عضو</button><p>العضوية تُمنح بعد قبول دعوة صحيحة ببريد موثّق. لا ترقيات أو نقل ملكية.</p></form>
          <button type="button" data-register-invite hidden>إكمال تسجيل الدعوة المعلقة</button>
          <ul class="member-list" data-invitations></ul>
          <div class="departments" data-departments-panel hidden>
            <h3>الإدارات</h3>
            <p data-departments-state role="status" aria-live="polite">تُحمّل الإدارات بعد التحقق من العضوية.</p>
            <ul class="member-list" data-departments></ul>
            <p class="health-note">إدارة الإدارات وعضوياتها من لوحة السياسات للمالك. العضو يرى الإدارات التي ينتمي إليها فقط؛ ولا يكفي إخفاء الواجهة لعزل سياسات إدارة أخرى.</p>
          </div>
        </div>
      </section>
      <section class="panel" aria-labelledby="activity-title">
        <div class="section-heading"><div><p class="overline">04 / ACTIVITY</p><h2 id="activity-title">آخر أنشطة المؤسسة</h2></div></div>
        <p data-activity-state role="status" aria-live="polite">تُحمّل الأنشطة بعد التحقق من العضوية.</p>
        <p class="health-meta" data-evidence-summary>ملخص السجلات غير محمّل.</p><ol class="activity" data-activity></ol>
        <p class="health-note">المصدر: سجل تدقيق Kernel لهذه المؤسسة فقط، بلا نصوص طلبات أو بيانات شخصية. العدد والأوقات لجميع السجلات المحتفظ بها، وليست فترة تجربة. تقرير <bdi>Proof of Value</bdi> غير مهيأ: لا توجد بداية ونهاية تجربة مسجلتان، ولا يثبت عدد الأحداث نجاح منتج أو وفرًا أو امتثالًا. الأنشطة المعروضة آخر ثمانية فقط.</p>
      </section>
    </div>

    <noscript><p class="notice">يلزم JavaScript للتحقق من جلسة Neon Auth وتحميل بيانات المؤسسة. لا تُعرض أي بيانات خاصة بدونه.</p></noscript>
  </section>
</AppLayout>
<script src="../../../scripts/kernel.ts"></script>
