---
import { trialAccountPath } from '../../../shared/access-journey.mjs';
import { productForSlug } from '../../../shared/product-navigation.mjs';
import AppLayout from '../../../layouts/AppLayout.astro';
import {authConfig} from '../../../server/kernel/auth.mjs';
export const prerender=false;
const config=authConfig();
const product = productForSlug(Astro.url.searchParams.get('product'));
---
<AppLayout title="استكشافك المحدود">
 <section data-trial-home data-auth-configured={!!config} data-trial-product={product?.slug}>
  <h1>تجربة BRIGHTAI لمدة 48 ساعة</h1>
  {product && <p>المنتج المختار <bdi dir="ltr">{product.name}</bdi></p>}
  <details><summary>نطاق التجربة</summary><p>لكل حساب موثّق تجربة واحدة للقراءة في مساحة ببيانات اصطناعية. يبدأ العدّ عند التفعيل.</p></details>
  <p data-trial-status role="status" aria-live="polite">{config ? 'جارٍ التحقق من الجلسة…' : 'خدمة الدخول غير مهيأة حاليًا.'}</p>
  <a data-trial-signin href={trialAccountPath(product?.slug)} hidden>إنشاء حساب أو تسجيل الدخول</a>
  <button type="button" data-trial-start hidden>ابدأ تجربة 48 ساعة</button>
  <button type="button" data-trial-refresh hidden>تحديث الحالة</button>
  <section data-trial-summary hidden><h2>مدة التجربة</h2><p data-trial-clock></p></section>
  <p data-trial-empty hidden>لا توجد منتجات متاحة للقراءة في هذه المساحة الآن.</p>
  <div class="trial-grid" data-trial-products></div>
  <noscript><p>فعّل JavaScript للتحقق من الجلسة والإتاحة.</p></noscript>
  <p><a href="/products/">المختبرات العامة</a> · <a href="/request-access/?track=production">طلب تشغيل مؤسسي</a></p>
 </section>
</AppLayout>
<script>import '../../../scripts/trial-home';</script>
<style>
 [data-trial-home]{max-width:1100px;margin:auto;padding:24px;overflow-wrap:anywhere}
 h1{font-size:clamp(28px,5vw,48px)}p{line-height:1.9;margin-block:18px}
 .trial-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:20px;margin-block:24px}
 [data-trial-home] :global(article),[data-trial-summary]{padding:24px;border:1px solid var(--border-strong, #494151);border-radius:16px}
 summary { cursor:pointer; line-height:44px; }
 [data-trial-home] :global(button),[data-trial-home] :global(a){display:inline-flex;align-items:center;min-height:44px;margin:6px;padding:8px;color:inherit}
 [data-trial-home] :global(button){background:var(--surface-raised, #21192e);border:1px solid #93809d;border-radius:8px;font:inherit;cursor:pointer}
 [data-trial-home] :global(:focus-visible){outline:3px solid var(--color-focus, #f5b544);outline-offset:3px}
 [data-trial-home] :global(button:disabled){opacity:.6;cursor:not-allowed}
 [hidden]{display:none!important}
</style>
