---
import AppLayout from '../../../layouts/AppLayout.astro';
import {authConfig} from '../../../server/kernel/auth.mjs';
export const prerender=false;
const config=authConfig();
---
<AppLayout title="استكشافك المحدود">
 <section data-trial-home data-auth-url={config?.base??''}>
  <p>TRIAL HOME · SYNTHETIC ONLY</p><h1>استكشافك المحدود — 48 ساعة</h1>
  <p>خمسة منتجات وKernel. بلا بطاقة، بلا خصم أو تحويل مالي تلقائي. تبدأ المدة عند إنشاء المساحة من الخادم، ولا تتجدد بإعادة تسجيل الدخول.</p>
  <p>المرحلة الحالية: تصفح محدود فقط. عمليات الكتابة والتنفيذ تتطلب جاهزية واعتمادًا مستقلًا؛ مزود AI محجوب حتى اعتماد السياسة والمنطقة والتكلفة والمزود.</p>
  <p data-trial-status role="status" aria-live="polite">جارٍ التحقق من الجلسة…</p>
  <a data-trial-signin href="/auth/sign-up/?trial=48h">إنشاء حساب أو تسجيل الدخول</a>
  <button type="button" data-trial-start>ابدأ استكشافًا محدودًا 48 ساعة</button>
  <button type="button" data-trial-refresh>تحديث حالة الخادم</button>
  <section data-trial-summary hidden><h2>Kernel — الهوية والعزل والمنح</h2><p data-trial-clock></p><p>العضوية: مشارك MEMBER، دون صلاحيات إدارة أو منح أو تشغيل مزود.</p><p data-trial-dataset></p><a data-trial-kernel href="/app/kernel/">فتح Kernel</a></section>
  <div class="trial-grid" data-trial-products></div>
  <p><a href="/products/">المختبرات العامة — 5/5</a> · <a href="/contact/?topic=ترخيص%20تجربة%20تشغيلية">تواصل اختياري بشأن الترخيص</a></p>
 </section>
</AppLayout>
<script>import '../../../scripts/trial-home';</script>
<style>
 [data-trial-home]{max-width:1100px;margin:auto;padding:24px;overflow-wrap:anywhere}
 h1{font-size:clamp(28px,5vw,48px)}p{line-height:1.9;margin-block:18px}
 .trial-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:20px;margin-block:24px}
 [data-trial-home] :global(article),[data-trial-summary]{padding:24px;border:1px solid var(--border-strong, #494151);border-radius:16px}
 [data-trial-home] :global(button),[data-trial-home] :global(a){display:inline-flex;align-items:center;min-height:44px;margin:6px;padding:8px;color:inherit}
 [data-trial-home] :global(button){background:var(--surface-raised, #21192e);border:1px solid #93809d;border-radius:8px;font:inherit;cursor:pointer}
 [data-trial-home] :global(:focus-visible){outline:3px solid var(--color-focus, #f5b544);outline-offset:3px}
 [data-trial-home] :global(button:disabled){opacity:.6;cursor:not-allowed}
 [hidden]{display:none!important}
</style>
