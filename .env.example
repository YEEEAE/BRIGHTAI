# Server only; copy to ignored .env and supply actual approved development values.
NEON_PROJECT_ID=
NEON_BRANCH=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Optional hard-limited Secure Chat input size (1-4000 characters).
AIGAS_SC_MAX_MESSAGE_CHARS=
# Optional explicit aliases accepted by Kernel: NEON_AUTH_URL, NEON_JWKS_URL.
# Not used by Kernel yet. Do not provision services just to fill these:
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
NEON_DATA_API_URL=

# Server-only Groq; exact model and prices must also be approved in the registry.
AIGAS_SC_GROQ_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
AIGAS_GROQ_TIMEOUT_MS=
AIGAS_GROQ_MAX_CONCURRENCY=
AIGAS_GROQ_DAILY_BUDGET_USD=
AIGAS_GROQ_MONTHLY_BUDGET_USD=
# Required existing durable shared ledger; see groq-gateway.mjs provisioning contract.
AIGAS_GROQ_BUDGET_FILE=
