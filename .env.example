# BrightAI server environment example. Keep real secrets in hosting/server env only.

NODE_ENV=development
PORT=3000

# Authentication and session signing. Generate unique values with:
# openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

# AI provider keys. Leave blank here; never commit real keys.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DATABASE_URL=postgresql://brightai:brightai@localhost:5432/brightai_dev
GEMINI_MODEL=gemini-2.5-flash

# NVIDIA kernel proxy configuration.
NVIDIA_MODEL=minimaxai/minimax-m2.7
NVIDIA_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ENDPOINT=
NVIDIA_REGION=global
NVIDIA_DATA_RESIDENCY=NVIDIA configured region
NVIDIA_KERNEL_TIMEOUT_MS=30000
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ENDPOINT=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1/chat/completions

# Optional gateway controls.
AI_GATEWAY_TIMEOUT_MS=30000
AI_GATEWAY_MOCK_MODE=0
RATE_LIMIT_REQUESTS_PER_MINUTE=30
MAX_BODY_BYTES=10240

# CHAT-SESSION-2026-07-15: Redis URL for /api/ai/chat/ session context store.
# Stores the last 8 messages per sessionId (TTL 10 minutes). Local dev: leave
# unset — the endpoint degrades to single-turn mode. Production: set in Render
# dashboard (e.g. rediss://default:<password>@<host>:<port>).
REDIS_URL=

# BAI-004 / 2026-07-15: Stripe billing. Server-side keys only.
# Same values as apps/dashboard/.env (the dashboard is the only consumer).
# Get from https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
OCR_MAX_BODY_BYTES=8388608
MAX_UPLOAD_BODY_BYTES=41943040

# Optional analytics.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
ANALYTICS_WEBHOOK_KEY=

# Application runtime.
EXCEL_FILE_PATH=
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_STORAGE=memory
CHAT_SESSION_TTL_MS=600000
CHAT_SESSION_MAX_ITEMS=8
CHAT_SESSION_MAX_CHARS=600

# Optional administrative integrations. Leave secrets blank.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
DASHBOARD_TOKEN=
DASHBOARD_PASSWORD_HASH=
FOCUS_API_URL=
FOCUS_API_TOKEN=
