# BrightAI server environment example. Keep real secrets in hosting/server env only.

NODE_ENV=development
PORT=3000

# Authentication and session signing. Generate unique values with:
# openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

# AI provider keys. Leave blank here; never commit real keys.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DATABASE_URL=postgresql://brightai:brightai@localhost:5432/brightai_dev
GEMINI_MODEL=gemini-2.5-flash

# NVIDIA kernel proxy configuration.
NVIDIA_MODEL=minimaxai/minimax-m2.7
NVIDIA_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ENDPOINT=
NVIDIA_REGION=global
NVIDIA_DATA_RESIDENCY=NVIDIA configured region
NVIDIA_KERNEL_TIMEOUT_MS=30000
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ENDPOINT=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1/chat/completions

# Optional gateway controls.
AI_GATEWAY_TIMEOUT_MS=30000
AI_GATEWAY_MOCK_MODE=0
RATE_LIMIT_REQUESTS_PER_MINUTE=30
MAX_BODY_BYTES=10240

# CHAT-SESSION-2026-07-15: Redis URL for /api/ai/chat/ session context store.
# BAI-005 / CHAT-SESSION-2026-07-15: Redis URL — used by THREE systems:
#   1. Chat session store (src/lib/redis.ts) — last 8 messages / 10 min TTL
#   2. Public API rate limiter (src/lib/ratelimit.ts) — chat (10 req/min/IP)
#      and lead (5 req/min/IP); shared across all Render instances so the
#      quota is enforced uniformly (BAI-005 acceptance criteria).
#   3. Firewall rate limiter (apps/dashboard/lib/firewall/ratelimit/redis-bucket.ts)
#      — 60 req/min/org for chat/completions, redact, and transcribe.
# Local dev: leave unset — all three degrade gracefully to in-memory.
# Production: set in Render dashboard (e.g. rediss://default:<pwd>@<host>:<port>).
REDIS_URL=

# BAI-004 / 2026-07-15: Stripe billing. Server-side keys only.
# Same values as apps/dashboard/.env (the dashboard is the only consumer).
# Get from https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
OCR_MAX_BODY_BYTES=8388608
MAX_UPLOAD_BODY_BYTES=41943040

# Optional analytics.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
ANALYTICS_WEBHOOK_KEY=

# Application runtime.
EXCEL_FILE_PATH=
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_STORAGE=memory
CHAT_SESSION_TTL_MS=600000
CHAT_SESSION_MAX_ITEMS=8
CHAT_SESSION_MAX_CHARS=600

# P0-3 (2026-07-19): observability. Sentry is no-op when SENTRY_DSN
# is empty (dev + CI). In production set both dashboard + Astro DSN.
# SENTRY_RELEASE is the git SHA (set by CI from $GITHUB_SHA).
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional administrative integrations. Leave secrets blank.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
DASHBOARD_TOKEN=
DASHBOARD_PASSWORD_HASH=
FOCUS_API_URL=
FOCUS_API_TOKEN=
